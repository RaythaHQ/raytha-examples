{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Literature</li></ol><p class="kick">Literature library</p><h1>Datasheets, manuals, certificates and bulletins</h1><p class="lede">Datasheets, manuals and certificates are open to everyone. Price sheets and CAD packages are for distributors; service bulletins and repair procedures are for service partners.</p></div></div><section class="sec tight"><div class="w"><div class="tscroll"><table class="tbl"><thead><tr><th>Document</th><th>Number</th><th>Kind</th><th>Series</th><th>Audience</th><th>Updated</th></tr></thead><tbody>{% for d in Target.Items %}{%- assign x=d.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "distributors" and in_dist == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "service" and in_svc == false -%}{%- assign ok=false -%}{%- endif -%}<tr><td><a href="{{ PathBase }}/{{ d.RoutePath }}">{{ d.PrimaryField }}</a></td><td class="mono" style="font-size:.88rem">{{ x.number }} · {{ x.revision }}</td><td>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "datasheet","Datasheet" | replace: "iom","Install and maintenance" | replace: "price","Price sheet" | replace: "cad","CAD package" | replace: "cert","Certificate" | replace: "bulletin","Service bulletin" | replace: "guide","Guide" }}</td><td class="mono">{{ x.product }}</td><td><span class="aud {{ au }}">{% unless ok %}🔒 {% endunless %}{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }}</span></td><td>{{ x.updated_label }}</td></tr>{% endfor %}</tbody></table></div></div></section>
