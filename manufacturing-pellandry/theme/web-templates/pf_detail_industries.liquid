{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}{%- assign x=Target.PublishedContent -%}{%- capture ic -%}{{ x.code }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/industries">Industries</a></li></ol><p class="kick">Industry · {{ x.stat }} {{ x.stat_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><aside class="panel k"><p class="kick">What they ask for</p><ul style="margin:0;padding-left:18px">{%- assign nd = x.needs | split: "|" -%}{% for n in nd %}<li>{{ n }}</li>{% endfor %}</ul></aside></div><h2 style="margin:36px 0 18px">Series used in {{ Target.PrimaryField | downcase }}</h2><div class="grid3">{% for p in prods.Items %}{%- assign iz = p.PublishedContent.industries | split: "|" -%}{% if iz contains ic %}{%- assign z=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><div class="im"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated line drawing of the {{ p.PrimaryField }}" loading="lazy"></div><div class="bd"><span class="code">{{ z.code }} · {% capture fl -%}{{ z.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</span><h3>{{ p.PrimaryField }}</h3><p>{{ z.summary }}</p><div class="meta"><span>{{ z.sizes | split: " (" | first }}</span><span>{{ z.lead_weeks }} wk</span></div></div></a>{% endif %}{% endfor %}</div></div></section>
