<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Plants</li></ol><p class="kick">Plants and capacity</p><h1>Three plants, loaded cell by cell</h1><p class="lede">Where each series is made, how busy each cell is this week, and what that means for lead times.</p></div></div><section class="sec dark tight"><div class="w"><h2 style="margin-bottom:20px">Lead-time board</h2>{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}<div class="tscroll"><table class="board"><thead><tr><th>Series</th><th class="hm">Product</th><th>Plant</th><th>Standard lead</th><th style="width:34%">Weeks</th></tr></thead><tbody>{% for p in prods.Items %}{%- assign z=p.PublishedContent -%}{%- capture lw -%}{{ z.lead_weeks }}{%- endcapture -%}{%- assign lwn = lw | plus: 0 -%}{%- assign pct = lwn | times: 8 -%}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ z.code }}</a></td><td class="hm pn2">{{ p.PrimaryField }}</td><td>{% capture pl -%}{{ z.plant }}{%- endcapture %}{{ pl | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}</td><td class="lw">{{ lwn }} <small>weeks</small></td><td><div class="bar"><i class="{% if lwn > 8 %}hot{% endif %}" style="width:{{ pct }}%"></i></div></td></tr>{% endfor %}</tbody></table></div></div></section><section class="sec tight lightb"><div class="w"><div class="grid3">{% for pl in Target.Items %}{%- assign y=pl.PublishedContent -%}{%- capture ps -%}{{ y.status }}{%- endcapture -%}<div class="panel k"><p class="kick">{{ y.city }}</p><h3><a href="{{ PathBase }}/{{ pl.RoutePath }}">{{ pl.PrimaryField }}</a></h3><p class="muted" style="margin:6px 0 12px;font-size:.94rem">{{ y.role }}</p><p><span class="st {{ ps }}">{% capture psl -%}{{ y.status }}{%- endcapture %}{{ psl | replace: "normal","Normal" | replace: "busy","Running hot" | replace: "shutdown","Planned shutdown" }}</span></p>{%- assign cl = y.cells | split: "||" -%}<div class="cells">{% for c in cl %}{%- assign cp = c | split: " :: " -%}{%- assign ld = cp[1] | plus: 0 -%}<div class="cell"><b>{{ cp[0] }}</b><div class="bar"><i class="{% if ld > 85 %}hot{% endif %}" style="width:{{ ld }}%"></i></div><span class="mono">{{ ld }}%</span>{% if cp[2] and cp[2] != "" %}<em>{{ cp[2] }}</em>{% endif %}</div>{% endfor %}</div></div>{% endfor %}</div></div></section>
