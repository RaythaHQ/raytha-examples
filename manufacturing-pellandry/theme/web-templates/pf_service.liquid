{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign lib = get_content_items(ContentType="literature", OrderBy="sort_order asc", PageSize=60) -%}{%- assign plts = get_content_items(ContentType="plants", OrderBy="sort_order asc", PageSize=10) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Service desk</li></ol><p class="kick">Members only · service partners</p><h1>Service desk</h1><p class="lede">Service bulletins, field repair procedures, test checklists and repair center status.</p></div></div><section class="sec tight"><div class="w">{% unless CurrentUser.IsAuthenticated %}<div class="lock"><span class="pill">Sign in required</span><h2>The service desk is for Pellandry service partners.</h2><p>Signed-in service partners see bulletins, torque updates, repair procedures and test checklists. Accounts are created by your regional sales manager, so there is no sign-up form.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/service-desk">Partner sign-in</a><a class="btn line" href="{{ PathBase }}/literature">Public literature</a></p></div>{% else %}{% unless in_svc %}<div class="lock"><span class="pill">Not in this group</span><h2>Your account does not have access here.</h2><p>You are signed in as {{ CurrentUser.FirstName }}. Ask your regional sales manager to add your account to the right partner group.</p></div>{% endunless %}{% endunless %}{% if in_svc %}<div class="dg"><div><h2 style="margin-bottom:6px">Bulletins and procedures</h2>{% for d in lib.Items %}{%- assign x=d.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "distributors" and in_dist == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "service" and in_svc == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "service" and ok %}<a class="hit" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="mono muted" style="font-size:.82rem">{{ x.number }} rev {{ x.revision }} · {{ x.updated_label }}</span><br><b>{{ d.PrimaryField }}</b><p>{{ x.summary }}</p></a>{% endif %}{% endfor %}</div><aside>{% for pl in plts.Items %}{%- assign y=pl.PublishedContent -%}{%- capture ps -%}{{ y.status }}{%- endcapture -%}<div class="panel k"><p class="kick">{{ y.city }}</p><b>{{ pl.PrimaryField }}</b><p style="margin:10px 0 0"><span class="st {{ ps }}">{% capture psl -%}{{ y.status }}{%- endcapture %}{{ psl | replace: "normal","Normal" | replace: "busy","Running hot" | replace: "shutdown","Planned shutdown" }}</span></p>{%- capture _c2 -%}{{ y.status_note }}{%- endcapture -%}{% if _c2 != "" %}<p class="muted" style="margin:8px 0 0;font-size:.92rem">{{ y.status_note }}</p>{% endif %}</div>{% endfor %}<div class="panel"><p class="kick">Field service dispatch</p><p style="margin:0">(555) 017-4800, 24 hours · Hesketh</p></div></aside></div>{% endif %}</div></section>
