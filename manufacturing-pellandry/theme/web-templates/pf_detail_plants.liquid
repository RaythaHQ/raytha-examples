{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}{%- assign x=Target.PublishedContent -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{%- capture ps -%}{{ x.status }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/plants">Plants</a></li></ol><p class="kick">{{ x.city }} · {{ x.sqft }} · {{ x.staff }} people</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin-top:16px"><span class="st {{ ps }}">{% capture psl -%}{{ x.status }}{%- endcapture %}{{ psl | replace: "normal","Normal" | replace: "busy","Running hot" | replace: "shutdown","Planned shutdown" }}</span> {%- capture _c0 -%}{{ x.status_note }}{%- endcapture -%}{% if _c0 != "" %}<b style="margin-left:8px">{{ x.status_note }}</b>{% endif %}</p></div></div><section class="sec tight lightb"><div class="w"><div class="dg"><div><h2 style="margin-bottom:18px">Cell load this week</h2>{%- assign cl = x.cells | split: "||" -%}<div class="cells">{% for c in cl %}{%- assign cp = c | split: " :: " -%}{%- assign ld = cp[1] | plus: 0 -%}<div class="cell"><b>{{ cp[0] }}</b><div class="bar"><i class="{% if ld > 85 %}hot{% endif %}" style="width:{{ ld }}%"></i></div><span class="mono">{{ ld }}%</span>{% if cp[2] and cp[2] != "" %}<em>{{ cp[2] }}</em>{% endif %}</div>{% endfor %}</div><div class="prose" style="margin-top:34px">{{ x.body }}</div><h2 style="margin:34px 0 16px">Made here</h2><div class="grid3">{% for p in prods.Items %}{%- capture pp -%}{{ p.PublishedContent.plant }}{%- endcapture -%}{% if pp == pc %}{%- assign z=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><div class="im"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated line drawing of the {{ p.PrimaryField }}" loading="lazy"></div><div class="bd"><span class="code">{{ z.code }} · {% capture fl -%}{{ z.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</span><h3>{{ p.PrimaryField }}</h3><p>{{ z.summary }}</p><div class="meta"><span>{{ z.sizes | split: " (" | first }}</span><span>{{ z.lead_weeks }} wk</span></div></div></a>{% endif %}{% endfor %}</div></div><aside class="panel k"><dl class="facts"><dt>Role</dt><dd>{{ x.role }}</dd><dt>Floor</dt><dd>{{ x.sqft }}</dd><dt>People</dt><dd>{{ x.staff }}</dd><dt>Certified</dt><dd>{{ x.certs | replace: "|", "<br>" }}</dd></dl></aside></div></div></section>
