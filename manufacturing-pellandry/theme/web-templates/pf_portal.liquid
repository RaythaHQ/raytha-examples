{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign lib = get_content_items(ContentType="literature", OrderBy="sort_order asc", PageSize=60) -%}{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Distributor portal</li></ol><p class="kick">Members only · distributors</p><h1>{% if CurrentUser.IsAuthenticated %}Welcome back, {{ CurrentUser.FirstName }}{% else %}Distributor portal{% endif %}</h1><p class="lede">Price sheets and multipliers, CAD packages, stocking terms and the lead-time board with price bands.</p>{% if CurrentUser.IsAuthenticated %}<p style="margin-top:14px"><span class="aud {% if in_dist %}public{% else %}service{% endif %}">{% if in_dist %}✓{% else %}✕{% endif %} Distributors</span> <span class="aud {% if in_svc %}public{% else %}service{% endif %}">{% if in_svc %}✓{% else %}✕{% endif %} Service partners</span></p>{% endif %}</div></div><section class="sec tight"><div class="w">{% unless CurrentUser.IsAuthenticated %}<div class="lock"><span class="pill">Sign in required</span><h2>The distributor portal is for Pellandry distributors.</h2><p>Signed-in distributors see 2027 price sheets, multipliers by band, CAD packages and stocking terms. Accounts are created by your regional sales manager, so there is no sign-up form.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/portal">Partner sign-in</a><a class="btn line" href="{{ PathBase }}/literature">Public literature</a></p></div>{% else %}{% unless in_dist %}<div class="lock"><span class="pill">Not in this group</span><h2>Your account does not have access here.</h2><p>You are signed in as {{ CurrentUser.FirstName }}. Ask your regional sales manager to add your account to the right partner group.</p></div>{% endunless %}{% endunless %}{% if in_dist %}<div class="notice"><b>Order cut-off:</b> orders entered before December 18 ship at 2026 prices. 2027 list prices take effect January 4, 2027.</div>
<div class="dg"><div><h2 style="margin-bottom:16px">Lead time and price band by series</h2><div class="tscroll"><table class="tbl"><thead><tr><th>Series</th><th>Product</th><th>Band</th><th>Lead</th><th>Plant</th></tr></thead><tbody>{% for p in prods.Items %}{%- assign z=p.PublishedContent -%}<tr><td class="mono"><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ z.code }}</a></td><td>{{ p.PrimaryField }}</td><td class="mono"><b>{{ z.price_band }}</b></td><td class="mono">{{ z.lead_weeks }} wk</td><td>{% capture pl -%}{{ z.plant }}{%- endcapture %}{{ pl | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}</td></tr>{% endfor %}</tbody></table></div>
<h2 style="margin:36px 0 6px">Price sheets, CAD and terms</h2>{% for d in lib.Items %}{%- assign x=d.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "distributors" and in_dist == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "service" and in_svc == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "distributors" and ok %}<a class="hit" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="mono muted" style="font-size:.82rem">{{ x.number }} rev {{ x.revision }} · {{ x.updated_label }}</span><br><b>{{ d.PrimaryField }}</b><p>{{ x.summary }}</p></a>{% endif %}{% endfor %}</div>
<aside><div class="panel k"><p class="kick">2027 multipliers</p><table class="tbl" style="border:0"><tbody><tr><th>Band A</th><td class="mono">0.52</td></tr><tr><th>Band B</th><td class="mono">0.55</td></tr><tr><th>Band C</th><td class="mono">0.58</td></tr><tr><th>Band D</th><td>Quote</td></tr></tbody></table></div><div class="panel"><p class="kick">Your regional manager</p><p style="margin:0"><b>Teodor Halvik</b> (fictional)<br>Midwest region · (555) 017-4210</p></div><div class="panel"><p class="kick">Orders</p><p style="margin:0">Orders go through your ERP or inside sales. This site has no order or payment forms, on purpose.</p></div></aside></div>{% endif %}</div></section>
