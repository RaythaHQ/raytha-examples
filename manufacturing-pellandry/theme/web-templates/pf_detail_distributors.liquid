{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/distributors">Distributors</a></li><li>{% capture rl -%}{{ x.region }}{%- endcapture %}{{ rl | replace: "northeast","Northeast" | replace: "southeast","Southeast" | replace: "midwest","Midwest" | replace: "gulf","Gulf Coast" | replace: "west","West" | replace: "canada","Canada" }}</li></ol><p class="kick">{% capture tl -%}{{ x.tier }}{%- endcapture %}{{ tl | replace: "stocking","Stocking distributor" | replace: "authorized","Authorized distributor" | replace: "service","Service center" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div><h2 style="margin-bottom:16px">Series this partner carries</h2><div class="grid3">{%- assign dl = x.lines | split: "|" -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if dl contains pf %}{%- assign z=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><div class="im"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated line drawing of the {{ p.PrimaryField }}" loading="lazy"></div><div class="bd"><span class="code">{{ z.code }} · {% capture fl -%}{{ z.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</span><h3>{{ p.PrimaryField }}</h3><p>{{ z.summary }}</p><div class="meta"><span>{{ z.sizes | split: " (" | first }}</span><span>{{ z.lead_weeks }} wk</span></div></div></a>{% endif %}{% endfor %}</div></div><aside class="panel k"><dl class="facts"><dt>Territory</dt><dd>{{ x.territory }}</dd><dt>City</dt><dd>{{ x.city }}</dd><dt>Phone</dt><dd class="mono">{{ x.phone }}</dd><dt>Tier</dt><dd>{% capture tl2 -%}{{ x.tier }}{%- endcapture %}{{ tl2 | replace: "stocking","Stocking distributor" | replace: "authorized","Authorized distributor" | replace: "service","Service center" }}</dd></dl></aside></div></div></section>
