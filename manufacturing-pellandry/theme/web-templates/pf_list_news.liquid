<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>News</li></ol><p class="kick">News</p><h1>From the plants</h1><p class="lede">Product releases, plant updates and quality news.</p></div></div><section class="sec tight"><div class="w"><div class="grid3">{% for n in Target.Items %}{%- assign z=n.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ n.RoutePath }}"><div class="im"><img src="{{ z.image.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="bd"><span class="code">{{ z.date_label }} · {% capture nk -%}{{ z.kind }}{%- endcapture %}{{ nk | replace: "product","Product" | replace: "plant","Plant" | replace: "quality","Quality" | replace: "people","People" | replace: "company","Company" }}</span><h3>{{ n.PrimaryField }}</h3><p>{{ z.summary }}</p></div></a>{% endfor %}</div></div></section>
