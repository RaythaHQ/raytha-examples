{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}{%- assign hero = get_content_items(ContentType="products", Filter="code eq 'B140'", PageSize=1) -%}{%- assign h = hero.Items | first -%}{%- assign hz = h.PublishedContent -%}
{%- assign plants = get_content_items(ContentType="plants", OrderBy="sort_order asc", PageSize=10) -%}{%- assign inds = get_content_items(ContentType="industries", OrderBy="sort_order asc", PageSize=10) -%}{%- assign nws = get_content_items(ContentType="news", OrderBy="sort_order asc", PageSize=3) -%}
<section class="hero"><div class="w g"><div><p class="kick">Industrial valves · actuators · pumps</p><h1>Valves you can service in line, built and tested in our own plants.</h1><p class="lede">Pellandry Fluid Controls makes ball, butterfly, check and control valves, actuators and pumps for water, chemical, food, energy and building services. Datasheets and manuals are open to everyone; distributors and service partners sign in for pricing, CAD and bulletins.</p>
<ul class="tick"><li>Every unit pressure-tested or loop-tested, record kept by serial number</li><li>Lead times published weekly, by series and by plant</li><li>Spare parts for 20 years after a series ends</li></ul>
<p class="cta"><a class="btn o" href="{{ PathBase }}/products">Browse 12 product series</a><a class="btn line" href="{{ PathBase }}/distributors">Find a distributor</a></p></div>
<figure class="sheet" style="margin:0"><img src="{{ hz.art.Value | attachment_redirect_url }}" alt="Generated general-arrangement drawing of the Series 140 ball valve"><span class="call" style="left:16px;top:16px">FULL PORT</span><span class="call" style="right:16px;top:16px">ISO 5211 PAD</span>
<figcaption class="tb"><div><span>Title</span>{{ h.PrimaryField }}</div><div><span>Rating</span>{{ hz.pressure | split: " /" | first }}</div><div><span>Plant</span>{% capture hpl -%}{{ hz.plant }}{%- endcapture %}{{ hpl | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}</div><div><span>Lead</span>{{ hz.lead_weeks }} wk</div></figcaption></figure></div></section>
<section class="sec tight"><div class="w"><div class="shead"><div><p class="kick">Read a part number</p><h2>Every Pellandry part number says what it is.</h2><p>The segments map to the options on each product page, so a distributor, a buyer and a maintenance planner read the same thing. Example: a 2 in stainless Series 140 with socket-weld ends and PEEK seats.</p></div><a class="btn sm line" href="{{ PathBase }}/{{ h.RoutePath }}">See the Series 140 →</a></div>
<div class="pn">{%- assign seg = hz.pn | split: "||" -%}{% for s in seg %}{%- assign sp = s | split: " :: " -%}<div><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></div>{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Product line</p><h2>Six families, twelve series</h2></div><a class="btn sm line" href="{{ PathBase }}/products">All products →</a></div>
<div class="fams"><a href="{{ PathBase }}/products#ball"><b>Ball valves</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "ball" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a><a href="{{ PathBase }}/products#butterfly"><b>Butterfly valves</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "butterfly" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a><a href="{{ PathBase }}/products#check"><b>Check valves</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "check" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a><a href="{{ PathBase }}/products#control"><b>Control valves</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "control" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a><a href="{{ PathBase }}/products#actuator"><b>Actuators</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "actuator" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a><a href="{{ PathBase }}/products#pump"><b>Pumps</b><span>{%- assign n=0 -%}{% for p in prods.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "pump" %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}{{ n }} series</span></a></div>
<div class="grid4" style="margin-top:22px">{% for p in prods.Items limit:8 %}{%- assign z=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><div class="im"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated line drawing of the {{ p.PrimaryField }}" loading="lazy"></div><div class="bd"><span class="code">{{ z.code }} · {% capture fl -%}{{ z.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</span><h3>{{ p.PrimaryField }}</h3><p>{{ z.summary }}</p><div class="meta"><span>{{ z.sizes | split: " (" | first }}</span><span>{{ z.lead_weeks }} wk</span></div></div></a>{% endfor %}</div></div></section>
<section class="sec dark" id="leadtimes"><div class="w"><div class="shead"><div><p class="kick">Lead-time board · updated weekly</p><h2>How long it takes, by series</h2><p>Standard lead times for configured-to-order units, from order entry to ship. Stock sizes held by distributors ship faster. Bars over eight weeks are flagged in orange.</p></div></div>
<div class="lt">{%- assign prods = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=60) -%}<div class="tscroll"><table class="board"><thead><tr><th>Series</th><th class="hm">Product</th><th>Plant</th><th>Standard lead</th><th style="width:34%">Weeks</th></tr></thead><tbody>{% for p in prods.Items %}{%- assign z=p.PublishedContent -%}{%- capture lw -%}{{ z.lead_weeks }}{%- endcapture -%}{%- assign lwn = lw | plus: 0 -%}{%- assign pct = lwn | times: 8 -%}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ z.code }}</a></td><td class="hm pn2">{{ p.PrimaryField }}</td><td>{% capture pl -%}{{ z.plant }}{%- endcapture %}{{ pl | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}</td><td class="lw">{{ lwn }} <small>weeks</small></td><td><div class="bar"><i class="{% if lwn > 8 %}hot{% endif %}" style="width:{{ pct }}%"></i></div></td></tr>{% endfor %}</tbody></table></div><div class="side">{% for pl in plants.Items %}{%- assign y=pl.PublishedContent -%}{%- capture ps -%}{{ y.status }}{%- endcapture -%}<div style="border:1px solid #33506e;padding:18px;margin-bottom:14px"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px"><a href="{{ PathBase }}/{{ pl.RoutePath }}" style="color:#fff;font-weight:600;text-decoration:none">{{ pl.PrimaryField }}</a><span class="st {{ ps }}">{% capture psl -%}{{ y.status }}{%- endcapture %}{{ psl | replace: "normal","Normal" | replace: "busy","Running hot" | replace: "shutdown","Planned shutdown" }}</span></div>{%- assign cl = y.cells | split: "||" -%}<div class="cells">{% for c in cl %}{%- assign cp = c | split: " :: " -%}{%- assign ld = cp[1] | plus: 0 -%}<div class="cell"><b>{{ cp[0] }}</b><div class="bar"><i class="{% if ld > 85 %}hot{% endif %}" style="width:{{ ld }}%"></i></div><span class="mono">{{ ld }}%</span>{% if cp[2] and cp[2] != "" %}<em>{{ cp[2] }}</em>{% endif %}</div>{% endfor %}</div></div>{% endfor %}</div></div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Industries</p><h2>Where our valves work</h2></div><a class="btn sm line" href="{{ PathBase }}/industries">All industries →</a></div><div class="ind">{% for i in inds.Items limit:4 %}<a href="{{ PathBase }}/{{ i.RoutePath }}"><img src="{{ i.PublishedContent.art.Value | attachment_redirect_url }}" alt=""><div><span>{{ i.PublishedContent.stat }} · {{ i.PublishedContent.stat_label }}</span><b>{{ i.PrimaryField }}</b></div></a>{% endfor %}</div></div></section>
<section class="sec tight"><div class="w"><div class="dg"><div><p class="kick">For partners</p><h2>Open literature, members-only pricing</h2><p class="muted" style="margin-top:12px;max-width:640px">Datasheets, manuals and certificates are public pages. Price sheets, CAD packages and service bulletins are sent only to signed-in distributors and service partners; the server never sends that content to anyone else.</p><p class="cta"><a class="btn" href="{{ PathBase }}/portal">Distributor portal</a><a class="btn line" href="{{ PathBase }}/service-desk">Service desk</a><a class="btn line" href="{{ PathBase }}/literature">Literature</a></p></div>
<div class="panel k"><p class="kick">Latest</p>{% for n in nws.Items %}<a class="hit" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="mono muted" style="font-size:.8rem">{{ n.PublishedContent.date_label }}</span><br><b>{{ n.PrimaryField }}</b></a>{% endfor %}</div></div></div></section>
