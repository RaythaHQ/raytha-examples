{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture code -%}{{ x.code }}{%- endcapture -%}{%- capture fam -%}{{ x.family }}{%- endcapture -%}{%- capture plc -%}{{ x.plant }}{%- endcapture -%}{%- assign lit = get_content_items(ContentType="literature", OrderBy="sort_order asc", PageSize=60) -%}{%- assign inds = get_content_items(ContentType="industries", OrderBy="sort_order asc", PageSize=20) -%}{%- assign dists = get_content_items(ContentType="distributors", OrderBy="sort_order asc", PageSize=40) -%}{%- assign plts = get_content_items(ContentType="plants", OrderBy="sort_order asc", PageSize=10) -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/products">Products</a></li><li><a href="{{ PathBase }}/products#{{ fam }}">{% capture fl -%}{{ x.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</a></li></ol>
<div class="dg" style="grid-template-columns:1fr 1.1fr;align-items:center"><div><p class="kick">{{ code }} · {% capture fl2 -%}{{ x.family }}{%- endcapture %}{{ fl2 | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</p><h1 style="font-size:clamp(2rem,3.4vw,3rem)">{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><div class="chips" style="margin-top:18px">{%- assign cs = x.certs | split: "|" -%}{% for c in cs %}<span class="chip">{{ c }}</span>{% endfor %}</div></div>
<figure class="sheet" style="margin:0"><img src="{{ x.art.Value | attachment_redirect_url }}" alt="Generated drawing of the {{ Target.PrimaryField }}"><figcaption class="tb"><div><span>Series</span>{{ code }}</div><div><span>Sizes</span>{{ x.sizes | split: " (" | first }}</div><div><span>Plant</span>{% capture pl -%}{{ x.plant }}{%- endcapture %}{{ pl | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}</div><div><span>Lead</span>{{ x.lead_weeks }} wk</div></figcaption></figure></div></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><h2 style="margin-bottom:16px">Specifications</h2><table class="tbl"><tbody><tr><th>Sizes</th><td>{{ x.sizes }}</td></tr><tr><th>Pressure</th><td>{{ x.pressure }}</td></tr><tr><th>Body materials</th><td>{{ x.materials }}</td></tr><tr><th>Temperature</th><td>{{ x.temp }}</td></tr><tr><th>End connections</th><td>{{ x.ends }}</td></tr>{%- assign sr = x.specs | split: "||" -%}{% for r in sr %}{%- assign kv = r | split: " :: " -%}<tr><th>{{ kv[0] }}</th><td>{{ kv[1] }}</td></tr>{% endfor %}</tbody></table>
<h2 style="margin:40px 0 14px">Reading the part number</h2><div class="pn">{%- assign seg = x.pn | split: "||" -%}{% for s in seg %}{%- assign sp = s | split: " :: " -%}<div><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></div>{% endfor %}</div>
<div class="prose" style="margin-top:36px">{{ x.body }}</div>
<h2 style="margin:36px 0 10px">Literature for this series</h2>{%- assign hl=0 -%}{% for d in lit.Items %}{%- assign y=d.PublishedContent -%}{%- capture dp -%}{{ y.product }}{%- endcapture -%}{% if dp == code %}{%- assign hl=1 -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ d.RoutePath }}"><b>{{ d.PrimaryField }}</b> <span class="mono muted" style="font-size:.82rem">{{ y.number }} rev {{ y.revision }}</span> {% if au != "public" %}<span class="aud {{ au }}">🔒 {% capture al -%}{{ y.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }}</span>{% endif %}<p>{{ y.summary }}</p></a>{% endif %}{% endfor %}{% if hl == 0 %}<p class="muted">Datasheet on request from inside sales.</p>{% endif %}</div>
<aside><div class="panel k"><p class="kick">Standard lead time</p><p style="font:600 2.6rem var(--mono);margin:0;letter-spacing:-.03em">{{ x.lead_weeks }} <span style="font-size:1rem;color:var(--ink2)">weeks</span></p><p class="muted" style="margin:6px 0 0;font-size:.92rem">Configured to order, from {% capture pl2 -%}{{ x.plant }}{%- endcapture %}{{ pl2 | replace: "bf","Brask Ford" | replace: "lm","Linnmoor" | replace: "hs","Hesketh" }}. Stock sizes ship sooner from distributors.</p></div>
<div class="panel">{% if in_dist %}<p class="kick">Distributor price band</p><p style="font:600 2rem var(--mono);margin:0">Band {{ x.price_band }}</p><p class="muted" style="margin:6px 0 0;font-size:.92rem">Multipliers are on the <a href="{{ PathBase }}/portal">2027 price sheet</a>.</p>{% else %}<p class="kick">Pricing</p><p style="margin:0">Pricing comes from your distributor. Distributors see price bands and multipliers after signing in.</p><p style="margin:12px 0 0"><a href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Distributor sign-in →</a></p>{% endif %}</div>
<div class="panel"><p class="kick">Industries</p><div class="chips">{%- assign iz = x.industries | split: "|" -%}{% for i in inds.Items %}{%- capture ic -%}{{ i.PublishedContent.code }}{%- endcapture -%}{% if iz contains ic %}<a class="chip" style="text-decoration:none" href="{{ PathBase }}/{{ i.RoutePath }}">{{ i.PrimaryField }}</a>{% endif %}{% endfor %}</div></div>
<div class="panel"><p class="kick">Distributors carrying {% capture fl3 -%}{{ x.family }}{%- endcapture %}{{ fl3 | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</p>{%- assign dn=0 -%}{% for d in dists.Items %}{%- assign dl = d.PublishedContent.lines | split: "|" -%}{% if dl contains fam and dn < 5 %}{%- assign dn = dn | plus: 1 -%}<a class="hit" style="padding:8px 0" href="{{ PathBase }}/{{ d.RoutePath }}"><b>{{ d.PrimaryField }}</b><p>{{ d.PublishedContent.territory }}</p></a>{% endif %}{% endfor %}<p style="margin:12px 0 0"><a href="{{ PathBase }}/distributors">All distributors →</a></p></div></aside></div></div></section>
