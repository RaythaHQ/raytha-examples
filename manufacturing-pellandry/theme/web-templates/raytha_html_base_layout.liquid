<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Pellandry Fluid Controls" %}{{ Target.Title }} | {% endif %}Pellandry Fluid Controls — industrial valves, actuators and pumps</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Pellandry Fluid Controls (fictional) makes industrial ball, butterfly, check and control valves, actuators and pumps. A manufacturing company website built on Raytha, a self-hosted, open-source .NET CMS for manufacturers, with a members-only distributor portal and service desk.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><style>
:root{--paper:#f2f0ea;--card:#fbfaf7;--ink:#121c28;--ink2:#46525f;--ink3:#6d7884;--rule:#d9d5cb;--bp:#0f2a44;--bp2:#1c3d5e;--line:#e8f1fa;--or:#ff6a1a;--or2:#ffe2d1;--ok:#1d7a46;--warn:#b25b00;--sans:"IBM Plex Sans",system-ui,sans-serif;--mono:"IBM Plex Mono",ui-monospace,monospace}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.6 var(--sans)}
a{color:inherit}img{max-width:100%;display:block}:focus-visible{outline:3px solid var(--or);outline-offset:3px}
.skip{position:absolute;left:-999px;top:8px;background:var(--or);color:#000;padding:10px 16px;font-weight:700;z-index:9}.skip:focus{left:12px}
.w{max-width:1260px;margin:0 auto;padding:0 32px}
h1,h2,h3{font-weight:600;letter-spacing:-.02em;line-height:1.08;margin:0}h1{font-size:clamp(2.2rem,4.2vw,3.7rem)}h2{font-size:clamp(1.5rem,2.4vw,2.15rem)}h3{font-size:1.18rem}
p{margin:0 0 1em}.mono{font-family:var(--mono)}.muted{color:var(--ink2)}
.kick{font:500 12.5px/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink2);display:flex;align-items:center;gap:10px;margin:0 0 14px}
.kick::before{content:"";width:10px;height:10px;background:var(--or);transform:rotate(45deg)}
.dark .kick{color:#9fb3c8}
.btn{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;text-decoration:none;font:600 .98rem var(--sans);padding:13px 20px;border:2px solid var(--ink);cursor:pointer;border-radius:2px}
.btn:hover{background:#000}.btn.o{background:var(--or);border-color:var(--or);color:#140800}.btn.line{background:transparent;color:inherit;border-color:currentColor}.btn.sm{padding:8px 14px;font-size:.9rem}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.util{background:var(--ink);color:#c9d3de;font-size:.86rem}.util .w{display:flex;justify-content:space-between;align-items:center;gap:18px;padding-top:7px;padding-bottom:7px}
.util a{color:#fff;text-decoration:none;font-weight:500}.util a:hover{text-decoration:underline}.util .r{display:flex;gap:18px;align-items:center}
.util input{background:#1f2c3b;border:1px solid #33465b;color:#fff;padding:5px 12px;font:inherit;width:210px;border-radius:2px}
.fict{font:500 11.5px var(--mono);letter-spacing:.08em;color:var(--or)}
.hdr{background:var(--card);border-bottom:2px solid var(--ink)}.hdr .w{display:flex;align-items:center;justify-content:space-between;gap:28px;padding-top:16px;padding-bottom:16px}
.brand{display:flex;align-items:center;gap:13px;text-decoration:none}.brand b{display:block;font-size:1.25rem;font-weight:700;letter-spacing:-.01em;line-height:1}.brand small{display:block;font:500 11.5px var(--mono);color:var(--ink2);margin-top:5px;letter-spacing:.06em;text-transform:uppercase}
.nav ol{list-style:none;margin:0;padding:0;display:flex;gap:2px}.nav a{display:block;padding:8px 12px;text-decoration:none;font-weight:500;font-size:.97rem;border-bottom:3px solid transparent}.nav a:hover{border-color:var(--or)}
.sec{padding:70px 0;border-top:1px solid var(--rule)}.sec.tight{padding:44px 0}.sec.dark{background:var(--bp);color:var(--line);border:0}
.shead{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:28px}.shead p{color:var(--ink2);max-width:640px;margin:10px 0 0}.dark .shead p{color:#a9bdd1}
.phead{padding:50px 0 38px;background:var(--card);border-bottom:1px solid var(--rule)}.phead .lede{font-size:1.15rem;color:var(--ink2);max-width:780px;margin-top:16px}
.crumbs{list-style:none;padding:0;margin:0 0 18px;display:flex;gap:8px;flex-wrap:wrap;font:500 13px var(--mono);color:var(--ink2)}.crumbs li+li::before{content:"/ ";color:var(--or)}.crumbs a{color:var(--ink2)}
/* hero */
.hero{background:var(--card);padding:46px 0 64px;border-bottom:1px solid var(--rule)}.hero .g{display:grid;grid-template-columns:1fr 1.05fr;gap:54px;align-items:center}
.hero h1{font-size:clamp(2.1rem,3.5vw,3.2rem)}.hero .lede{font-size:1.18rem;color:var(--ink2);max-width:560px;margin-top:20px}
.hero ul.tick{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:8px;font-size:.98rem}.hero ul.tick li::before{content:"✓ ";color:var(--or);font-weight:700}
.sheet{background:var(--bp);border:2px solid var(--ink);position:relative;box-shadow:12px 12px 0 var(--or2)}
.sheet img{width:100%}
.sheet .tb{display:grid;grid-template-columns:1.4fr 1fr 1fr .7fr;border-top:2px solid var(--line);color:var(--line);font:500 12px var(--mono)}
.sheet .tb div{padding:8px 12px;border-right:1px solid var(--bp2)}.sheet .tb div:last-child{border:0}.sheet .tb span{display:block;color:#8ea6bf;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase}
.call{position:absolute;background:var(--or);color:#140800;font:600 12px var(--mono);padding:4px 8px}
/* part number decoder */
.pn{display:flex;flex-wrap:wrap;gap:0;margin-top:6px;border:2px solid var(--ink);background:var(--card)}
.pn div{flex:1 1 140px;padding:16px 18px;border-right:1px solid var(--rule)}.pn div:last-child{border:0}
.pn b{display:block;font:600 1.6rem var(--mono);letter-spacing:-.02em}.pn div:first-child b{color:var(--or)}.pn span{display:block;font-size:.9rem;color:var(--ink2);margin-top:4px}
/* cards */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.pcard{background:var(--card);border:1px solid var(--rule);text-decoration:none;display:flex;flex-direction:column;transition:border-color .15s}.pcard:hover{border-color:var(--ink)}
.pcard .im{background:var(--bp);aspect-ratio:16/10;overflow:hidden}.pcard .bd{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px;flex:1}
.pcard .code{font:600 12.5px var(--mono);color:var(--or);letter-spacing:.06em}.pcard p{margin:0;color:var(--ink2);font-size:.95rem}
.pcard .meta{margin-top:auto;padding-top:10px;display:flex;justify-content:space-between;font:500 12.5px var(--mono);color:var(--ink3);border-top:1px dashed var(--rule)}
.fams{display:grid;grid-template-columns:repeat(6,1fr);border:2px solid var(--ink);background:var(--card)}.fams a{padding:18px 16px;border-right:1px solid var(--rule);text-decoration:none}.fams a:last-child{border:0}.fams a:hover{background:var(--or2)}
.fams b{display:block;font-weight:600}.fams span{font:500 12.5px var(--mono);color:var(--ink2)}
.chips{display:flex;flex-wrap:wrap;gap:8px}.chip{font:500 13px var(--mono);padding:5px 10px;border:1px solid var(--ink);background:var(--card)}
/* board */
.board{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:.93rem}.board th{text-align:left;font-weight:500;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:#8ea6bf;padding:10px 12px;border-bottom:1px solid #33506e}
.board td{padding:10px 12px;white-space:nowrap;border-bottom:1px solid #22425f;vertical-align:middle}.board td.pn2{white-space:normal;font-family:var(--sans);font-size:.92rem;color:#c9d6e3}.board a{text-decoration:none;color:#fff}.board a:hover{text-decoration:underline}
.bar{height:12px;background:#22425f;position:relative;min-width:120px}.bar i{position:absolute;left:0;top:0;bottom:0;background:var(--line)}.bar i.hot{background:var(--or)}
.lw{font-weight:600;color:#fff}.lw small{color:#8ea6bf;font-weight:400}
.cells{display:grid;gap:12px}.cell{display:grid;grid-template-columns:220px 1fr 60px;gap:16px;align-items:center;font-size:.95rem}.cell .bar{height:16px}.side .cell{grid-template-columns:1fr 110px 44px;gap:10px;font-size:.9rem}.cell em{grid-column:1/-1;font-style:normal;color:#a9bdd1;font-size:.85rem;margin-top:-8px}
.lightb .bar{background:#e6e2d8}.lightb .bar i{background:var(--bp)}.lightb .bar i.hot{background:var(--or)}.lightb .cell em{color:var(--ink2)}
.st{display:inline-flex;gap:6px;align-items:center;font:600 12px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border:1px solid}.st::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor}
.st.normal{color:var(--ok)}.st.busy{color:var(--warn)}.st.shutdown{color:#5a4bb0}.dark .st.normal{color:#6fd39b}.dark .st.busy{color:#ffb27a}.dark .st.shutdown{color:#b9adff}
/* tables, panels */
.tbl{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--rule);font-size:.96rem}.tbl th,.tbl td{text-align:left;padding:11px 14px;border-bottom:1px solid var(--rule);vertical-align:top}.tbl thead th{font:500 11.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);background:#ece9e1}
.tbl tbody th{font-weight:600;width:38%}.tbl a{text-decoration:none;font-weight:600}.tbl a:hover{text-decoration:underline}
.lt{display:grid;grid-template-columns:1.5fr 1fr;gap:44px;align-items:start}.tscroll{overflow-x:auto}
.panel{background:var(--card);border:1px solid var(--rule);padding:22px;margin-bottom:18px}.panel.k{border:2px solid var(--ink)}
.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 18px;margin:0;font-size:.95rem}.facts dt{font:500 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);padding-top:3px}.facts dd{margin:0}
.dg{display:grid;grid-template-columns:1fr 360px;gap:44px;align-items:start}.prose{max-width:720px}.prose p{font-size:1.06rem}
.aud{font:600 11.5px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:3px 8px;border:1px solid}.aud.public{color:var(--ok)}.aud.distributors{color:var(--warn)}.aud.service{color:#5a4bb0}
.lock{border:2px dashed var(--ink);background:repeating-linear-gradient(135deg,var(--card) 0 14px,#f0ece3 14px 28px);padding:34px}.lock .pill{font:600 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;background:var(--ink);color:var(--or);padding:5px 10px}.lock h2{margin:16px 0 10px}
.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none}.hit b{font-weight:600}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.95rem}.hit:hover b{text-decoration:underline}
.figs{display:grid;grid-template-columns:repeat(4,1fr);border:2px solid var(--ink);background:var(--card)}.figs div{padding:24px;border-right:1px solid var(--rule)}.figs div:last-child{border:0}.figs b{display:block;font:600 2.2rem var(--mono);letter-spacing:-.03em}.figs span{color:var(--ink2);font-size:.95rem}
.ol2{list-style:none;counter-reset:s;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(5,1fr);border:2px solid var(--ink);background:var(--card)}.ol2 li{counter-increment:s;padding:22px 20px;border-right:1px solid var(--rule)}.ol2 li:last-child{border:0}.ol2 li::before{content:"0" counter(s);font:600 13px var(--mono);color:var(--or);display:block;margin-bottom:10px}.ol2 p{margin:8px 0 0;color:var(--ink2);font-size:.94rem}
.ind{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.ind a{position:relative;text-decoration:none;color:#fff;background:var(--bp);min-height:200px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;border:1px solid var(--ink)}.ind a img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55}.ind a div{position:relative;padding:18px}.ind b{font-size:1.15rem;font-weight:600;display:block}.ind span{font:500 12.5px var(--mono);color:var(--or)}
.strip2{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.searchbar{display:flex;gap:10px;margin-top:22px;max-width:640px}.searchbar input{flex:1;padding:13px 16px;border:2px solid var(--ink);font:inherit;background:#fff;border-radius:2px}
label{display:block;font-weight:600;margin-bottom:6px}input[type=email],input[type=password]{width:100%;padding:12px 14px;border:2px solid var(--ink);font:inherit;border-radius:2px}
.notice{background:var(--or2);border-left:6px solid var(--or);padding:14px 18px;margin:0 0 22px}
.foot{background:var(--ink);color:#b5c1cd;padding:56px 0 30px;margin-top:0;font-size:.94rem}.foot .fg{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:34px}.foot h4{color:#fff;font:500 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;margin:0 0 12px}.foot ul{list-style:none;padding:0;margin:0;display:grid;gap:7px}.foot a{color:#e4ebf2;text-decoration:none}.foot a:hover{text-decoration:underline}
.disc{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;border-top:1px solid #2b3a4b;margin-top:40px;padding-top:20px;font:500 12px var(--mono);color:#8796a6}
@media(max-width:1100px){.nav{display:none}.hero .g,.dg{grid-template-columns:1fr}.grid4,.ind{grid-template-columns:repeat(2,1fr)}.lt{grid-template-columns:1fr}.fams{grid-template-columns:repeat(3,1fr)}.ol2{grid-template-columns:1fr 1fr}.figs{grid-template-columns:1fr 1fr}}
@media(max-width:720px){body{font-size:16px}.grid4 .pcard:nth-child(n+5){display:none}.w{padding:0 18px}.util .fict,.util .hm{display:none}.util input{width:130px}.grid3,.grid4,.ind,.ol2,.figs{grid-template-columns:1fr}.fams{grid-template-columns:1fr 1fr}.foot .fg{grid-template-columns:1fr}.cell,.side .cell{grid-template-columns:1fr 50px}.cell .bar{grid-column:1/3;grid-row:2}.cell em{grid-column:1/3}.pn div{flex-basis:45%}.shead{display:block}.sheet .tb{grid-template-columns:1fr 1fr}.board .hm{display:none}.sec{padding:46px 0}.hero{padding-top:28px}.figs div,.ol2 li,.fams a{border-right:0;border-bottom:1px solid var(--rule)}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="util"><div class="w"><span class="fict">FICTIONAL MANUFACTURER · RAYTHA EXAMPLE SITE</span><div class="r"><a class="hm" href="{{ PathBase }}/news">News</a>{% if CurrentUser.IsAuthenticated %}<span>Signed in as <b style="color:#fff">{{ CurrentUser.FirstName }}</b></span><a href="{{ PathBase }}/portal">Portal</a><a href="{{ PathBase }}/account/logout">Sign out</a>{% else %}<a href="{{ PathBase }}/account/login?returnUrl=/portal">Distributor &amp; service sign-in</a>{% endif %}<form action="{{ PathBase }}/search" role="search"><input name="q" aria-label="Search the site" placeholder="Search: B140, torque, PTFE…"></form></div></div></div>
<header class="hdr"><div class="w"><a class="brand" href="{{ PathBase }}/"><svg width="42" height="42" viewBox="0 0 42 42" aria-hidden="true"><rect x="1.5" y="1.5" width="39" height="39" fill="#121c28"/><path d="M8 12 L21 21 L8 30Z M34 12 L21 21 L34 30Z" fill="#ff6a1a"/><path d="M21 21 V8 M15 8 H27" stroke="#e8f1fa" stroke-width="3"/></svg><span><b>Pellandry Fluid Controls</b><small>Valves · actuators · pumps · since 1957</small></span></a>
<nav class="nav" aria-label="Main"><ol>{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ol></nav></div></header>
<main id="main">{% renderbody %}</main>
<footer class="foot"><div class="w"><div class="fg"><div><div style="display:flex;gap:12px;align-items:center"><svg width="42" height="42" viewBox="0 0 42 42" aria-hidden="true"><rect x="1.5" y="1.5" width="39" height="39" fill="#121c28"/><path d="M8 12 L21 21 L8 30Z M34 12 L21 21 L34 30Z" fill="#ff6a1a"/><path d="M21 21 V8 M15 8 H27" stroke="#e8f1fa" stroke-width="3"/></svg><b style="color:#fff;font-size:1.15rem">Pellandry Fluid Controls</b></div><p style="margin-top:14px;max-width:400px">1 Foundry Row, Brask Ford (fictional). Inside sales (555) 017-4000, 7 am to 6 pm Central. The company, products, people and figures are fictional; this is a Raytha example site.</p></div>
<div><h4>Products</h4><ul><li><a href="{{ PathBase }}/products">All series</a></li><li><a href="{{ PathBase }}/industries">Industries</a></li><li><a href="{{ PathBase }}/literature">Datasheets and manuals</a></li></ul></div>
<div><h4>Company</h4><ul><li><a href="{{ PathBase }}/plants">Plants and lead times</a></li><li><a href="{{ PathBase }}/quality">Quality</a></li><li><a href="{{ PathBase }}/distributors">Find a distributor</a></li><li><a href="{{ PathBase }}/company">About</a></li></ul></div>
<div><h4>Partners</h4><ul>{%- assign fm = get_menu("footer") -%}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div></div>
<div class="disc"><span>© 2026 Pellandry Fluid Controls (fictional) · 555 phone numbers · no quote, order, payment or registration forms on this site.</span><span>Server-rendered with Raytha · works without JavaScript</span></div></div></footer></body></html>
