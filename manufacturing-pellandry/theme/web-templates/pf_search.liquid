{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search Pellandry</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="B140, butterfly, torque, PTFE"><button class="btn">Search</button></form></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "products:Products:name:summary,literature:Literature:title:summary,industries:Industries:name:summary,plants:Plants:name:summary,distributors:Distributors:name:territory,news:News:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "distributors" or au == "service" %} <span class="aud {{ au }}">🔒 {{ au | replace: "distributors","Distributors" | replace: "service","Service partners" }}</span>{% endif %}<p>{% if x.summary %}{{ x.summary | strip_html | truncate: 150 }}{% else %}{{ x.territory }}{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a series code like B140, or a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=butterfly">butterfly</a>, <a href="?q=torque">torque</a>, <a href="?q=sanitary">sanitary</a> or <a href="?q=pump">pump</a>.</p>{% endif %}</div></div></section>
