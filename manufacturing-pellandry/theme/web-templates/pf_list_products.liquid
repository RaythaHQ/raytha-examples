<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Products</li></ol><p class="kick">Product line</p><h1>Valves, actuators and pumps</h1><p class="lede">Twelve series in six families. Every product page lists sizes, ratings, materials, certifications and how to read the part number. Datasheets and manuals are linked without a login.</p></div></div><section class="sec tight"><div class="w"><div class="chips" style="margin-bottom:30px"><a class="chip" href="#ball" style="text-decoration:none">Ball valves</a><a class="chip" href="#butterfly" style="text-decoration:none">Butterfly valves</a><a class="chip" href="#check" style="text-decoration:none">Check valves</a><a class="chip" href="#control" style="text-decoration:none">Control valves</a><a class="chip" href="#actuator" style="text-decoration:none">Actuators</a><a class="chip" href="#pump" style="text-decoration:none">Pumps</a></div><h2 id="ball" style="margin:34px 0 16px;padding-bottom:10px;border-bottom:2px solid var(--ink)">Ball valves</h2><div class="grid3">{% for p in Target.Items %}{%- capture pf -%}{{ p.PublishedContent.family }}{%- endcapture -%}{% if pf == "ball" %}{%- assign z=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><div class="im"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated line drawing of the {{ p.PrimaryField }}" loading="lazy"></div><div class="bd"><span class="code">{{ z.code }} · {% capture fl -%}{{ z.family }}{%- endcapture %}{{ fl | replace: "butterfly","Butterfly valves" | replace: "ball","Ball valves" | replace: "check","Check valves" | replace: "control","Control valves" | replace: "actuator","Actuators" | replace: "pump","Pumps" }}</span><h3>{{ p.PrimaryField }}</h3><p>{{ z.summary }}</p><div class="meta"><span>{{ z.sizes | split: " (" | first }}</span><span>{{ z.lead_weeks }} wk</span></div></div></a>{% endif %}{% endfor %}</div><h2 id="butterfly" style="margin:34px 0 16px;padding-