{%- assign in_dist=false -%}{%- assign in_svc=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "distributors" -%}{%- assign in_dist=true -%}{%- endif -%}{%- if g == "service" -%}{%- assign in_svc=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_dist=true -%}{%- assign in_svc=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "distributors" and in_dist == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "service" and in_svc == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/literature">Literature</a></li><li>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "datasheet","Datasheet" | replace: "iom","Install and maintenance" | replace: "price","Price sheet" | replace: "cad","CAD package" | replace: "cert","Certificate" | replace: "bulletin","Service bulletin" | replace: "guide","Guide" }}</li></ol><p class="kick"><span class="aud {{ au }}">{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }}</span> · {{ x.number }} rev {{ x.revision }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div>{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}<div class="lock"><span class="pill">{% capture al2 -%}{{ x.audience }}{%- endcapture %}{{ al2 | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }} only</span><h2>Sign in to read this document.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but your account is not in the {% capture al3 -%}{{ x.audience }}{%- endcapture %}{{ al3 | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }} group.{% else %}This document is shared with {% capture al4 -%}{{ x.audience }}{%- endcapture %}{{ al4 | replace: "public","Everyone" | replace: "distributors","Distributors" | replace: "service","Service partners" }} accounts.{% endif %} The body of this page is only sent to the browser when the signed-in account is in the right group.</p><p class="cta">{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Partner sign-in</a>{% endunless %}<a class="btn line" href="{{ PathBase }}/literature">All literature</a></p></div>{% endif %}</div><aside class="panel k"><dl class="facts"><dt>Number</dt><dd class="mono">{{ x.number }}</dd><dt>Revision</dt><dd class="mono">{{ x.revision }}</dd><dt>Kind</dt><dd>{% capture kl2 -%}{{ x.kind }}{%- endcapture %}{{ kl2 | replace: "datasheet","Datasheet" | replace: "iom","Install and maintenance" | replace: "price","Price sheet" | replace: "cad","CAD package" | replace: "cert","Certificate" | replace: "bulletin","Service bulletin" | replace: "guide","Guide" }}</dd><dt>Series</dt><dd class="mono">{%- capture _c1 -%}{{ x.product }}{%- endcapture -%}{% if _c1 != "" %}{{ x.product }}{% else %}All{% endif %}</dd><dt>Updated</dt><dd>{{ x.updated_label }}</dd></dl></aside></div></div></section>
