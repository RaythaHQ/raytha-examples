{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li></ol><p class="kick">{{ x.date_label }} · {% capture nk -%}{{ x.kind }}{%- endcapture %}{{ nk | replace: "product","Product" | replace: "plant","Plant" | replace: "quality","Quality" | replace: "people","People" | replace: "company","Company" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="margin-bottom:24px;border:1px solid var(--ink)">{{ x.body }}</div><aside class="panel k"><p class="kick">Inside sales</p><p style="margin:0">(555) 017-4000 · 7 am to 6 pm Central</p></aside></div></div></section>
