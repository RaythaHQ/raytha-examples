{%- comment -%} My learning. Only members of the "students" group see the dashboard; the HTML is never sent to anyone else. Progress comes from this browser (localStorage). {%- endcomment -%}
{%- assign is_member = false -%}
{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" -%}{%- assign is_member = true -%}{%- endif -%}{%- endfor -%}
{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- endif -%}
{% if is_member %}
  {%- assign cs = get_content_items(ContentType="courses", OrderBy="sort_order asc", PageSize=50) -%}
  {%- assign all = get_content_items(ContentType="lessons", PageSize=1) -%}
  <section style="padding:48px 0 0"><div class="wrap">
    <div class="welcome reveal">
      <span class="avatar">{{ CurrentUser.FirstName | slice: 0 }}{{ CurrentUser.LastName | slice: 0 }}</span>
      <div><span class="label" style="color:#a79f90">My learning</span><h1 style="font-size:clamp(1.8rem,3.4vw,2.6rem);margin-top:6px">Welcome back, {{ CurrentUser.FirstName }}.</h1></div>
      <div data-last hidden style="margin-left:auto"><a class="btn btn-sun" href="#"><i class="bi bi-play-fill"></i> Resume: <b style="font-weight:700"></b></a></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px" id="mstats">
      <div class="card" style="padding:22px"><span class="label">Courses open to you</span><b style="display:block;font:700 2.4rem/1.1 var(--display);margin-top:8px">{{ cs.TotalCount }}</b></div>
      <div class="card" style="padding:22px"><span class="label">Lessons in the catalog</span><b style="display:block;font:700 2.4rem/1.1 var(--display);margin-top:8px">{{ all.TotalCount }}</b></div>
      <div class="card" style="padding:22px"><span class="label">Membership</span><b style="display:block;font:700 1.5rem/1.2 var(--display);margin-top:12px">Students <i class="bi bi-patch-check-fill" style="color:var(--forest)"></i></b><small class="muted">{{ CurrentUser.EmailAddress }}</small></div>
    </div>
    <style>@media(max-width:800px){#mstats{grid-template-columns:1fr!important}}</style>
  </div></section>
  <section class="section" style="padding-top:56px"><div class="wrap">
    <div class="shead"><div><span class="label dot">Your courses</span><h2>Pick up where you left off</h2><p>Mark lessons complete as you go. Progress is saved in this browser.</p></div></div>
    <div style="display:flex;flex-direction:column;gap:14px">
    {%- for c in cs.Items %}{% capture lf %}course eq '{{ c.Id | append: "" }}'{% endcapture %}{% assign ls = get_content_items(ContentType="lessons", Filter=lf, OrderBy="lesson_number asc", PageSize=100) %}
      {%- assign routes = "" -%}{%- for l in ls.Items -%}{%- assign routes = routes | append: "/" | append: l.RoutePath | append: "," -%}{%- endfor -%}
      <div class="card mcourse reveal" data-progress="{{ routes }}">
        <img src="{{ c.PublishedContent.cover.Value | attachment_redirect_url }}" alt="">
        <div><span class="label" style="font-size:.66rem">{{ c.PublishedContent.instructor.PrimaryField }} · {{ ls.TotalCount }} lessons</span><h3 style="margin-top:6px">{{ c.PrimaryField }}</h3><div class="pbar"><i></i></div><small class="muted" data-pct>Not started</small></div>
        <a class="btn btn-ink" href="{{ PathBase }}/{{ ls.Items[0].RoutePath }}">Open <i class="bi bi-arrow-right"></i></a>
      </div>
    {%- endfor %}
    </div>
  </div></section>
{% else %}
  <section class="section"><div class="wrap">
    <div class="locked" style="padding:80px 40px">
      <div class="in">
        <div class="lk"><i class="bi bi-mortarboard-fill"></i></div>
        <h2>My learning is for members.</h2>
        <p>Members get every lesson in every course, a personal dashboard and progress tracking. Sign in to see yours.</p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
          <a class="btn btn-sun" href="{{ PathBase }}/account/login?returnUrl={{ PathBase }}/my-learning">Sign in <i class="bi bi-arrow-right"></i></a>
          <a class="btn btn-ghost" href="{{ PathBase }}/free-lessons">Try a free lesson</a>
        </div>
        {% if CurrentUser.IsAuthenticated %}<p style="font-size:.82rem;margin-top:18px">You are signed in as {{ CurrentUser.EmailAddress }}, but this account does not have a membership yet.</p>{% endif %}
      </div>
    </div>
  </div></section>
{% endif %}
