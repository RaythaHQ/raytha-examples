<h3>Sign in</h3>
{% if Target.ValidationFailures["__ValidationSummary"] %}
  <div class="alert">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>
{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
  <label for="email">Email address</label>
  <input id="email" type="email" name="EmailAddress" autocomplete="email">
  <label for="password">Password</label>
  <input id="password" type="password" name="Password" autocomplete="current-password">
  <button type="submit" class="btn btn-primary">Sign in</button>
  <input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form>
<p style="margin:14px 0 0"><a class="link-secondary" href="{{ PathBase }}/account/login/forgot-password/begin">Forgot password?</a></p>
<p class="muted" style="font-size:.9rem;margin-top:14px">New here? <a href="{{ PathBase }}/membership" style="text-decoration:underline">See how membership works</a>, or start with a <a href="{{ PathBase }}/free-lessons" style="text-decoration:underline">free lesson</a>.</p>
{% if Target.ShowOrLoginWithSection %}
  <p class="lead">or sign in with</p>
  {% if Target.HasLoginByMagicLink %}<a href="{{ PathBase }}/account/login/magic-link" class="btn btn-line" style="width:100%;justify-content:center;margin:6px 0">{{ Target.MagicLink.LoginButtonText }}</a>{% endif %}
  {% if Target.HasLoginBySingleSignOn %}{% for sso in Target.SingleSignOns %}<a href="{{ PathBase }}/account/login/sso/{{ sso.DeveloperName }}" class="btn btn-line" style="width:100%;justify-content:center;margin:6px 0">{{ sso.LoginButtonText }}</a>{% endfor %}{% endif %}
{% endif %}
