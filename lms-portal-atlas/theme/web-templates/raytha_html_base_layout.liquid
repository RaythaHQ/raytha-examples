<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} · {% elsif Target.Label %}{{ Target.Label }} · {% elsif Target.Title %}{{ Target.Title }} · {% endif %}Atlas Learning</title>
  <meta name="description" content="Atlas Learning: practical online courses in data, design, product and leadership, taught by people who do the work.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400..700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2317140f'/%3E%3Ccircle cx='32' cy='32' r='17' fill='none' stroke='%23f2a20c' stroke-width='5'/%3E%3Cpath d='M32 15v34M15 32h34' stroke='%23f4efe6' stroke-width='3'/%3E%3C/svg%3E">
  <style>
    :root{--paper:#f4efe6;--paper2:#ebe4d6;--card:#fffdf8;--ink:#17140f;--ink2:#3a352c;--muted:#776f62;--line:#e0d7c5;--saffron:#f2a20c;--tomato:#e8553d;--forest:#1f4d3a;--blue:#3d5af1;--r:20px;
      --display:"Bricolage Grotesque",system-ui,sans-serif;--sans:"Figtree",system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;--ease:cubic-bezier(.2,.7,.2,1)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
    a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
    h1,h2,h3,h4{font-family:var(--display);font-weight:700;letter-spacing:-.03em;line-height:1.05;margin:0;font-optical-sizing:auto}
    .wrap{width:min(1200px,100% - 56px);margin-inline:auto}
    @media(max-width:600px){.wrap{width:calc(100% - 32px)}}
    .label{font:600 .72rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .label.dot::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--saffron);margin-right:8px;vertical-align:1px}
    .muted{color:var(--muted)}
    .btn{display:inline-flex;align-items:center;gap:.55rem;padding:.85rem 1.35rem;border-radius:999px;font:600 .98rem var(--sans);border:1.5px solid transparent;transition:.25s var(--ease);cursor:pointer;white-space:nowrap}
    .btn-ink{background:var(--ink);color:var(--paper)}.btn-ink:hover{background:#000;transform:translateY(-2px)}
    .btn-sun{background:var(--saffron);color:var(--ink)}.btn-sun:hover{background:#ffb627;transform:translateY(-2px)}
    .btn-line{border-color:var(--ink);color:var(--ink)}.btn-line:hover{background:var(--ink);color:var(--paper)}
    .btn-ghost{border-color:rgba(244,239,230,.35);color:var(--paper)}.btn-ghost:hover{background:var(--paper);color:var(--ink)}
    .chip{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .7rem;border-radius:999px;font:600 .74rem var(--sans);background:var(--paper2);color:var(--ink2);white-space:nowrap}
    .chip.free{background:#dff3e6;color:#17633a}.chip.lock{background:#2a251d;color:#f4efe6}.chip.sun{background:#fde7b8;color:#7a4c00}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r)}
    .lift{transition:transform .35s var(--ease),box-shadow .35s}.lift:hover{transform:translateY(-5px);box-shadow:0 26px 50px -28px rgba(23,20,15,.45)}
    /* nav */
    .nav{position:sticky;top:0;z-index:40;background:rgba(244,239,230,.86);backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:.3s}
    .nav.scrolled{border-color:var(--line)}
    .nav-in{display:flex;align-items:center;gap:28px;height:74px}
    .brand{display:flex;align-items:center;gap:.6rem;font:750 1.3rem var(--display);letter-spacing:-.03em}
    .nav ul{display:flex;gap:4px;list-style:none;margin:0 auto 0 12px;padding:0}
    .nav ul a{display:block;padding:.5rem .85rem;border-radius:999px;font-size:.96rem;font-weight:550;color:var(--ink2)}
    .nav ul a:hover{background:var(--paper2)}.nav ul a.on{background:var(--ink);color:var(--paper)}
    .nav .me{display:flex;align-items:center;gap:10px}
    .avatar{width:38px;height:38px;border-radius:50%;background:var(--saffron);color:var(--ink);display:grid;place-items:center;font:700 .85rem var(--sans);flex:none}
    .nav .tog{display:none;background:none;border:0;color:inherit;font-size:1.6rem;margin-left:auto}
    @media(max-width:900px){.nav ul{display:none;position:absolute;top:74px;left:0;right:0;margin:0;flex-direction:column;background:var(--paper);padding:12px 16px 20px;border-bottom:1px solid var(--line)}.nav.open ul{display:flex}.nav .tog{display:block}.nav .me .btn{display:none}}
    /* sections */
    .section{padding:96px 0}.section.tight{padding:56px 0}
    .shead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:36px;flex-wrap:wrap}
    .shead h2{font-size:clamp(2rem,4vw,3.1rem);margin-top:12px;max-width:720px}
    .shead p{margin:10px 0 0;color:var(--muted);max-width:560px}
    /* hero */
    .hero{padding:56px 0 88px;position:relative}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
    .hero h1{font-size:clamp(2.9rem,6.4vw,5.6rem);margin:20px 0 22px;letter-spacing:-.045em;line-height:.98}
    .hero h1 em{font-style:normal;position:relative;white-space:nowrap}
    .hero h1 em::after{content:"";position:absolute;left:-2%;right:-2%;bottom:.06em;height:.3em;background:var(--saffron);z-index:-1;border-radius:4px;transform:skew(-8deg)}
    .hero p.lead{font-size:1.2rem;color:var(--ink2);max-width:540px;margin:0 0 30px}
    .hero .ctas{display:flex;gap:12px;flex-wrap:wrap}
    .stats{display:flex;gap:40px;margin-top:44px;padding-top:28px;border-top:1px solid var(--line);flex-wrap:wrap}
    .stats b{display:block;font:700 2rem/1 var(--display);letter-spacing:-.03em}.stats span{font-size:.88rem;color:var(--muted)}
    .stack{position:relative;height:540px}
    .stack .cv{position:absolute;width:62%;border-radius:22px;overflow:hidden;box-shadow:0 40px 70px -40px rgba(23,20,15,.6);border:6px solid var(--card);background:var(--card)}
    .stack .cv img{aspect-ratio:16/10;object-fit:cover;width:100%}
    .stack .cv .cap{padding:12px 14px 14px}.stack .cv .cap b{display:block;font:700 1.02rem/1.2 var(--display);letter-spacing:-.02em}.stack .cv .cap span{font-size:.8rem;color:var(--muted)}
    .stack .c1{left:0;top:40px;transform:rotate(-6deg);z-index:1}
    .stack .c2{right:0;top:0;transform:rotate(5deg);z-index:2}
    .stack .c3{left:18%;top:230px;transform:rotate(-1deg);z-index:3}
    .float{position:absolute;z-index:5;background:var(--ink);color:var(--paper);border-radius:18px;padding:16px 18px;box-shadow:0 30px 60px -30px rgba(0,0,0,.7);animation:bob 6s ease-in-out infinite}
    .float.p{right:-6px;bottom:44px;width:250px}.float.q{left:-18px;top:6px;background:var(--saffron);color:var(--ink);animation-delay:-3s;padding:12px 16px;font-weight:600;font-size:.9rem}
    .float .bar{height:8px;border-radius:9px;background:rgba(244,239,230,.18);margin-top:10px;overflow:hidden}.float .bar i{display:block;height:100%;width:64%;background:var(--saffron);border-radius:9px}
    @keyframes bob{50%{transform:translateY(-10px)}}
    @media(max-width:980px){.hero-grid{grid-template-columns:1fr}.stack{height:440px;max-width:560px;width:100%;margin:0 auto}}
    @media(max-width:600px){.float.q{left:0}.hero{padding:28px 0 56px}.stack{height:330px}.stack .c3{top:160px}.float.p{width:210px;bottom:0}.stats{gap:24px}.stats b{font-size:1.6rem}}
    /* course cards */
    .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    @media(max-width:980px){.grid3{grid-template-columns:1fr 1fr}}@media(max-width:640px){.grid3{grid-template-columns:1fr}}
    .course{display:flex;flex-direction:column;overflow:hidden}
    .course .cv{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--c)}
    .course .cv img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}.course:hover .cv img{transform:scale(1.05)}
    .course .cv .chip{position:absolute;left:14px;top:14px;background:rgba(255,253,248,.92)}
    .course .body{padding:20px 22px 22px;display:flex;flex-direction:column;gap:10px;flex:1}
    .course h3{font-size:1.45rem;line-height:1.1}
    .course p{margin:0;color:var(--muted);font-size:.95rem;line-height:1.55}
    .course .meta{display:flex;gap:14px;flex-wrap:wrap;font-size:.84rem;color:var(--ink2);margin-top:auto;padding-top:14px;border-top:1px dashed var(--line);align-items:center}
    .course .meta i{color:var(--muted)}.course .meta i.star{color:var(--saffron)}
    .course .who{display:flex;align-items:center;gap:8px;font-size:.86rem;font-weight:600}
    .course .who img{width:28px;height:28px;border-radius:50%;object-fit:cover}
    .star{color:var(--saffron)}
    /* categories */
    .cats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
    @media(max-width:900px){.cats{grid-template-columns:1fr 1fr}}
    .cat{padding:26px 24px;border-radius:var(--r);background:var(--c);color:var(--fg,#17140f);min-height:200px;display:flex;flex-direction:column;position:relative;overflow:hidden}
    .cat h3{font-size:1.6rem;margin-top:auto}.cat span{font:600 .74rem var(--mono);letter-spacing:.1em;text-transform:uppercase;opacity:.75}
    .cat i.bi{font-size:1.7rem}
    .cat::after{content:"";position:absolute;right:-50px;bottom:-50px;width:160px;height:160px;border-radius:50%;border:26px solid currentColor;opacity:.1;transition:.5s var(--ease)}
    .cat:hover::after{transform:scale(1.4)}
    /* steps */
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1.5px solid var(--ink)}
    .steps>div{padding:28px 28px 8px 0}.steps>div+div{padding-left:28px;border-left:1px solid var(--line)}
    .steps b{font:700 3.2rem/1 var(--display);color:var(--saffron);letter-spacing:-.04em}
    .steps h3{font-size:1.4rem;margin:14px 0 8px}.steps p{margin:0;color:var(--muted)}
    @media(max-width:800px){.steps{grid-template-columns:1fr}.steps>div+div{padding-left:0;border-left:0;border-top:1px solid var(--line)}}
    /* dark band */
    .band{background:var(--ink);color:var(--paper);border-radius:32px;padding:64px;position:relative;overflow:hidden}
    .band h2{font-size:clamp(2rem,4.4vw,3.4rem);max-width:640px}.band p{color:#c9c1b2;max-width:520px;font-size:1.08rem}
    .band .rings{position:absolute;right:-120px;top:50%;transform:translateY(-50%);width:520px;height:520px;opacity:.9}
    @media(max-width:700px){.band{padding:36px 26px;border-radius:24px}.band .rings{opacity:.25}}
    /* instructors */
    .people{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
    @media(max-width:900px){.people{grid-template-columns:1fr 1fr}}
    .person{overflow:hidden}.person img{aspect-ratio:4/5;object-fit:cover;width:100%;transition:transform .6s var(--ease)}.person:hover img{transform:scale(1.04)}
    .person .pi{padding:16px 18px 18px}.person h3{font-size:1.25rem}.person p{margin:4px 0 0;font-size:.88rem;color:var(--muted);line-height:1.45}
    /* page head */
    .phead{padding:64px 0 44px}
    .phead h1{font-size:clamp(2.6rem,5.4vw,4.4rem);margin:16px 0 12px;letter-spacing:-.04em}
    .phead p{font-size:1.15rem;color:var(--ink2);max-width:620px;margin:0}
    .crumbs{display:flex;gap:.5rem;align-items:center;font-size:.88rem;color:var(--muted);flex-wrap:wrap}.crumbs a:hover{color:var(--ink)}
    /* filters */
    .filters{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:30px}
    .filters a{padding:.5rem 1rem;border-radius:999px;border:1.5px solid var(--line);font-size:.92rem;font-weight:600;background:var(--card)}
    .filters a:hover{border-color:var(--ink)}.filters a.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}
    .filters form{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--card);border:1.5px solid var(--line);border-radius:999px;padding:6px 6px 6px 16px}
    .filters input{border:0;outline:0;background:transparent;font:inherit;font-size:.95rem;width:200px}
    .filters form button{border:0;background:var(--ink);color:var(--paper);border-radius:999px;width:34px;height:34px;cursor:pointer}
    @media(max-width:700px){.filters form{margin-left:0;width:100%}.filters input{flex:1}}
    /* course detail */
    .chero{padding:40px 0 64px;background:linear-gradient(180deg,var(--paper) 0,var(--paper2) 100%);border-bottom:1px solid var(--line)}
    .chero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
    .chero h1{font-size:clamp(2.5rem,5vw,4.2rem);margin:18px 0 14px;letter-spacing:-.04em}
    .chero .tag{font-size:1.25rem;color:var(--ink2);margin:0 0 22px;max-width:560px}
    .chero .cvbig{border-radius:26px;overflow:hidden;box-shadow:0 40px 80px -45px rgba(23,20,15,.7);transform:rotate(1.5deg);border:8px solid var(--card)}
    .facts{display:flex;gap:26px;flex-wrap:wrap;margin:22px 0 28px;font-size:.95rem}
    .facts div{display:flex;flex-direction:column}.facts b{font:700 1.4rem var(--display);letter-spacing:-.02em}.facts span{color:var(--muted);font-size:.82rem}
    @media(max-width:900px){.chero-grid{grid-template-columns:1fr}.chero .cvbig{transform:none}}
    .cgrid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:56px;align-items:start}
    @media(max-width:980px){.cgrid{grid-template-columns:1fr}}
    .prose{font-size:1.08rem;color:var(--ink2);line-height:1.75}
    .prose h2{font-size:1.7rem;color:var(--ink);margin:2.2rem 0 .8rem}
    .prose p{margin:0 0 1.1rem}.prose ul{padding-left:0;list-style:none;margin:0 0 1.3rem}
    .prose ul li{position:relative;padding-left:1.8rem;margin:.45rem 0}
    .prose ul li::before{content:"";position:absolute;left:.2rem;top:.62em;width:10px;height:10px;border-radius:3px;background:var(--saffron);transform:rotate(45deg)}
    .prose blockquote{margin:1.6rem 0;padding:20px 22px 20px 58px;border-radius:16px;background:var(--ink);color:var(--paper);position:relative}
    .prose blockquote::before{content:"\F4CA";font-family:bootstrap-icons;position:absolute;left:22px;top:19px;font-size:1.2rem;color:var(--saffron)}
    .prose blockquote p{margin:0}.prose strong{color:inherit}
    .outcomes{display:grid;grid-template-columns:1fr 1fr;gap:12px 28px;padding:28px;margin:0 0 40px}
    .outcomes div{display:flex;gap:12px;font-size:.98rem;line-height:1.5}.outcomes i{color:var(--forest);font-size:1.15rem;margin-top:1px}
    @media(max-width:700px){.outcomes{grid-template-columns:1fr}}
    .module{margin-bottom:18px;overflow:hidden}
    .module>header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:var(--paper2);gap:12px}
    .module>header h3{font-size:1.15rem;letter-spacing:-.02em}.module>header span{font-size:.84rem;color:var(--muted)}
    .lrow{display:flex;align-items:center;gap:14px;padding:15px 22px;border-top:1px solid var(--line);transition:background .2s}
    .lrow:hover{background:#fbf7ee}
    .lrow .n{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--line);display:grid;place-items:center;font:600 .78rem var(--mono);flex:none;color:var(--muted)}
    .lrow.done .n{background:var(--forest);border-color:var(--forest);color:#fff}
    .lrow .t{flex:1;min-width:0}.lrow .t b{display:block;font-weight:600;font-size:1rem}.lrow .t small{color:var(--muted);font-size:.84rem}
    .lrow .r{display:flex;align-items:center;gap:10px;font-size:.84rem;color:var(--muted);white-space:nowrap}
    .side-card{position:sticky;top:96px;padding:26px}
    .side-card .pbar{height:10px;border-radius:9px;background:var(--paper2);overflow:hidden;margin:10px 0 6px}.side-card .pbar i{display:block;height:100%;width:0;background:var(--forest);border-radius:9px;transition:width .8s var(--ease)}
    .tutor{display:flex;gap:14px;align-items:center;margin-top:22px;padding-top:22px;border-top:1px dashed var(--line)}
    .tutor img{width:56px;height:56px;border-radius:50%;object-fit:cover}
    /* lesson */
    .lesson-grid{display:grid;grid-template-columns:320px minmax(0,1fr);gap:48px;align-items:start;padding:36px 0 96px}
    .lside{position:sticky;top:96px;max-height:calc(100vh - 120px);overflow:auto;padding:20px}
    .lside h4{font:600 .72rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:16px 0 8px}
    .lside a{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:12px;font-size:.92rem;line-height:1.35;color:var(--ink2)}
    .lside a:hover{background:var(--paper2)}.lside a.on{background:var(--ink);color:var(--paper)}
    .lside a i{margin-top:2px;flex:none}.lside a .tick{color:var(--forest)}.lside a.on .tick{color:var(--saffron)}
    .player{position:relative;aspect-ratio:16/9;border-radius:24px;overflow:hidden;background:var(--c);display:grid;place-items:center;margin:22px 0 30px}
    .player img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.55;filter:saturate(.9)}
    .player .play{position:relative;width:92px;height:92px;border-radius:50%;background:var(--paper);display:grid;place-items:center;font-size:2.4rem;color:var(--ink);box-shadow:0 20px 50px -10px rgba(0,0,0,.5)}
    .player .play::after{content:"";position:absolute;inset:-12px;border-radius:50%;border:2px solid rgba(255,255,255,.6);animation:ring 2.4s infinite}
    @keyframes ring{to{inset:-34px;opacity:0}}
    .player .bar{position:absolute;left:22px;right:22px;bottom:20px;display:flex;align-items:center;gap:12px;color:#fff;font:600 .8rem var(--mono)}
    .player .bar span.track{flex:1;height:6px;border-radius:6px;background:rgba(255,255,255,.35);overflow:hidden}.player .bar span.track i{display:block;width:0;height:100%;background:var(--saffron)}
    .readhead{display:flex;align-items:center;gap:16px;padding:22px 24px;border-radius:20px;background:var(--card);border:1px solid var(--line);margin:22px 0 30px}
    .readhead .ico{width:56px;height:56px;border-radius:16px;background:var(--c);display:grid;place-items:center;color:#fff;font-size:1.5rem;flex:none}
    .locked{position:relative;border-radius:26px;padding:56px 40px;text-align:center;background:var(--ink);color:var(--paper);overflow:hidden;margin-top:26px}
    .locked .ghost{position:absolute;inset:0;padding:40px;text-align:left;filter:blur(6px);opacity:.14;font-size:1.05rem;line-height:1.8;pointer-events:none}
    .locked .in{position:relative}
    .locked .lk{width:74px;height:74px;border-radius:22px;background:var(--saffron);color:var(--ink);display:grid;place-items:center;font-size:2rem;margin:0 auto 20px}
    .locked h2{font-size:clamp(1.8rem,3.4vw,2.5rem)}.locked p{color:#cfc7b8;max-width:500px;margin:12px auto 26px}
    .pn{display:flex;justify-content:space-between;gap:16px;margin-top:40px;padding-top:26px;border-top:1px solid var(--line);flex-wrap:wrap}
    .pn a{display:flex;flex-direction:column;gap:2px;max-width:48%}.pn a span{font:600 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.pn a b{font:700 1.15rem var(--display);letter-spacing:-.02em}
    .pn a.next{text-align:right;margin-left:auto}
    .donebtn.is-done{background:var(--forest);color:#fff;border-color:var(--forest)}
    @media(max-width:980px){.lesson-grid{grid-template-columns:1fr}.lside{position:static;max-height:none;order:2}}
    /* members */
    .welcome{display:flex;align-items:center;gap:20px;padding:26px 28px;background:var(--ink);color:var(--paper);border-radius:24px;flex-wrap:wrap}
    .welcome .avatar{width:58px;height:58px;font-size:1.15rem}
    .mcourse{display:grid;grid-template-columns:200px 1fr auto;gap:24px;align-items:center;padding:14px;overflow:hidden}
    .mcourse img{border-radius:14px;aspect-ratio:16/10;object-fit:cover;width:100%}
    .mcourse h3{font-size:1.3rem}.mcourse .pbar{height:8px;border-radius:9px;background:var(--paper2);overflow:hidden;margin-top:12px;max-width:380px}.mcourse .pbar i{display:block;height:100%;width:0;background:var(--forest);transition:width .8s var(--ease)}
    @media(max-width:700px){.mcourse{grid-template-columns:1fr}.mcourse .btn{justify-self:start}}
    /* auth */
    .auth{padding:56px 0 110px}.auth-grid{display:grid;grid-template-columns:1fr 440px;gap:64px;align-items:center}
    .auth h1{font-size:clamp(2.6rem,5vw,4.2rem);letter-spacing:-.04em;margin:16px 0 16px}
    .auth-card{padding:34px}.auth-card h3{font-size:1.6rem;margin-bottom:18px}
    .auth-card label{display:block;font-weight:600;font-size:.9rem;margin-bottom:6px}
    .auth-card input[type=email],.auth-card input[type=password],.auth-card input[type=text]{width:100%;padding:.8rem 1rem;border-radius:14px;border:1.5px solid var(--line);font:inherit;background:var(--paper);margin-bottom:16px;outline:0}
    .auth-card input:focus{border-color:var(--ink)}
    .auth-card .btn-primary{width:100%;justify-content:center;background:var(--ink);color:var(--paper);border:0;padding:.95rem;border-radius:999px;font:600 1rem var(--sans);cursor:pointer}
    .auth-card .alert{padding:.8rem 1rem;border-radius:12px;background:#fde4dc;color:#8a2a17;margin-bottom:14px;font-size:.92rem}
    .auth-card .link-secondary{font-size:.9rem;color:var(--muted);text-decoration:underline}
    .auth-card .list-group{list-style:none;padding:0;margin:0}.auth-card .lead{font-size:.95rem;color:var(--muted);margin:10px 0 4px}
    @media(max-width:900px){.auth-grid{grid-template-columns:1fr;gap:32px}}
    /* footer */
    .foot{background:var(--ink);color:#bdb5a6;padding:72px 0 36px;margin-top:40px}
    .foot .cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px}
    .foot h4{font:600 .74rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--paper);margin-bottom:14px}
    .foot ul{list-style:none;margin:0;padding:0}.foot li{margin:8px 0}.foot a:hover{color:var(--paper)}
    .foot .brand{color:var(--paper)}
    .foot .big{font:700 clamp(3rem,10vw,8.5rem)/.9 var(--display);letter-spacing:-.05em;color:#2a251d;margin:56px 0 20px;white-space:nowrap;overflow:hidden}
    .foot .bottom{display:flex;justify-content:space-between;gap:16px;font-size:.86rem;flex-wrap:wrap;border-top:1px solid #2e2920;padding-top:22px}
    @media(max-width:800px){.foot .cols{grid-template-columns:1fr 1fr}.foot .cols>div:first-child{grid-column:1/-1}}
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease)}.reveal.in{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}.float,.player .play::after{animation:none}}
  </style>
</head>
<body>
{%- assign is_member = false -%}
{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" -%}{%- assign is_member = true -%}{%- endif -%}{%- endfor -%}
{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- endif -%}
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand" href="{{ PathBase }}/"><svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#17140f"/><circle cx="32" cy="32" r="17" fill="none" stroke="#f2a20c" stroke-width="5"/><path d="M32 15v34M15 32h34" stroke="#f4efe6" stroke-width="3"/></svg>Atlas<span style="font-weight:500;color:var(--muted)">Learning</span></a>
    {%- assign menu = get_main_menu() %}
    <ul>
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}" class="{% if u != '' and Target.RoutePath contains u %}on{% endif %}">{{ mi.Label }}</a></li>
      {%- endfor %}
    </ul>
    <div class="me">
    {% if CurrentUser.IsAuthenticated %}
      <a class="btn btn-line" href="{{ PathBase }}/my-learning" style="padding:.6rem 1.1rem">My learning</a>
      <a class="avatar" href="{{ PathBase }}/account/logout" title="Sign out {{ CurrentUser.EmailAddress }}">{{ CurrentUser.FirstName | slice: 0 }}{{ CurrentUser.LastName | slice: 0 }}</a>
    {% else %}
      <a class="btn btn-line" href="{{ PathBase }}/account/login" style="padding:.6rem 1.1rem">Sign in</a>
      <a class="btn btn-ink" href="{{ PathBase }}/membership" style="padding:.6rem 1.1rem">Join Atlas</a>
    {% endif %}
    </div>
    <button class="tog" aria-label="Menu" onclick="document.getElementById('nav').classList.toggle('open')"><i class="bi bi-list"></i></button>
  </div>
</header>
<main>{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div><a class="brand" href="{{ PathBase }}/">Atlas Learning</a><p style="max-width:360px">Practical courses in data, design, product and leadership, taught by people who do the work. Atlas is a fictional school, built as a demo with Raytha.</p></div>
      {%- assign fm = get_menu("footer") %}
      <div><h4>Learn</h4><ul>{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
      <div><h4>Topics</h4><ul><li><a href="{{ PathBase }}/courses?category=data">Data and analytics</a></li><li><a href="{{ PathBase }}/courses?category=design">Design</a></li><li><a href="{{ PathBase }}/courses?category=product">Product</a></li><li><a href="{{ PathBase }}/courses?category=leadership">Leadership</a></li></ul></div>
      <div><h4>Account</h4><ul>{% if CurrentUser.IsAuthenticated %}<li><a href="{{ PathBase }}/my-learning">My learning</a></li><li><a href="{{ PathBase }}/account/logout">Sign out</a></li>{% else %}<li><a href="{{ PathBase }}/account/login">Sign in</a></li><li><a href="{{ PathBase }}/membership">Membership</a></li>{% endif %}<li><a href="mailto:hello@example.com">hello@example.com</a></li></ul></div>
    </div>
    <div class="big" aria-hidden="true">Keep learning.</div>
    <div class="bottom"><span>&copy; 2026 Atlas Learning. A fictional school.</span><span>Built with <a href="https://raytha.com" style="color:var(--paper)">Raytha</a></span></div>
  </div>
</footer>
<script>
(function(){
  var nav=document.getElementById('nav');var f=function(){nav.classList.toggle('scrolled',scrollY>8)};f();addEventListener('scroll',f,{passive:true});
  var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.06}):null;
  document.querySelectorAll('.reveal').forEach(function(el){io?io.observe(el):el.classList.add('in')});
  // Progress is kept in this browser only (localStorage): a list of completed lesson paths.
  var KEY='atlas:done',done=[];try{done=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){}
  var save=function(){localStorage.setItem(KEY,JSON.stringify(done))};
  document.querySelectorAll('[data-lesson]').forEach(function(el){if(done.indexOf(el.getAttribute('data-lesson'))>-1)el.classList.add('done')});
  document.querySelectorAll('[data-progress]').forEach(function(el){var ls=el.getAttribute('data-progress').split(',').filter(Boolean),n=ls.filter(function(l){return done.indexOf(l)>-1}).length,p=ls.length?Math.round(n*100/ls.length):0;
    var bar=el.querySelector('.pbar i');if(bar)setTimeout(function(){bar.style.width=p+'%'},150);var t=el.querySelector('[data-pct]');if(t)t.textContent=n+' of '+ls.length+' lessons complete · '+p+'%';});
  document.querySelectorAll('[data-mark]').forEach(function(b){var id=b.getAttribute('data-mark');var paint=function(){var on=done.indexOf(id)>-1;b.classList.toggle('is-done',on);b.innerHTML=on?'<i class="bi bi-check2-circle"></i> Completed':'<i class="bi bi-circle"></i> Mark as complete'};paint();
    b.addEventListener('click',function(){var i=done.indexOf(id);if(i>-1)done.splice(i,1);else done.push(id);save();paint();document.querySelectorAll('[data-lesson="'+id+'"]').forEach(function(el){el.classList.toggle('done',i<0)})})});
  var last=localStorage.getItem('atlas:last');document.querySelectorAll('[data-last]').forEach(function(el){if(last){try{var o=JSON.parse(last);el.querySelector('a').href=o.u;el.querySelector('b').textContent=o.t;el.hidden=false}catch(e){}}});
  var cur=document.querySelector('[data-current]');if(cur)localStorage.setItem('atlas:last',JSON.stringify({u:location.pathname,t:cur.getAttribute('data-current')}));
})();
</script>
</body>
</html>
