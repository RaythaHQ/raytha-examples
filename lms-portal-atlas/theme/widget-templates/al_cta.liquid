<section class="section tight">
  <div class="wrap">
    <div class="band reveal">
      <svg class="rings" viewBox="0 0 520 520" aria-hidden="true"><g fill="none" stroke-width="22"><circle cx="260" cy="260" r="240" stroke="#2a251d"/><circle cx="260" cy="260" r="180" stroke="#3a3226"/><circle cx="260" cy="260" r="120" stroke="#f2a20c" stroke-dasharray="500 260"/></g><circle cx="260" cy="260" r="52" fill="#e8553d"/></svg>
      <span class="label" style="color:#a79f90">Membership</span>
      <h2 style="margin:14px 0 14px">{{ widget.settings.headline }}</h2>
      <p>{{ widget.settings.subtitle }}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px;position:relative">
        <a class="btn btn-sun" href="{{ widget.settings.primary_url }}">{{ widget.settings.primary_label }} <i class="bi bi-arrow-right"></i></a>
        <a class="btn btn-ghost" href="{{ widget.settings.secondary_url }}">{{ widget.settings.secondary_label }}</a>
      </div>
    </div>
  </div>
</section>
