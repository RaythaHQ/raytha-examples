<section class="sec"><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2></div></div><div class="grid g3">{% for it in widget.settings.items %}<div class="card pad" style="display:flex;gap:14px;align-items:flex-start"><span style="width:46px;height:46px;flex:none;border-radius:12px;background:var(--gold2);color:var(--ox);display:grid;place-items:center;font-size:1.25rem" aria-hidden="true"><i class="bi bi-{{ it.icon }}"></i></span><div><b style="color:var(--ink)">{{ it.name }}</b><div style="margin:4px 0"><a href="tel:{{ it.phone | remove: " " | remove: "(" | remove: ")" | remove: "-" }}">{{ it.phone }}</a></div><div style="font-size:.92rem"><a href="mailto:{{ it.email }}">{{ it.email }}</a></div><p class="muted" style="margin:6px 0 0;font-size:.9rem">{{ it.note }}</p></div></div>{% endfor %}</div></div></section>
