<section class="sec alt"{% if widget.settings.anchor != blank %} id="{{ widget.settings.anchor }}"{% endif %}><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2><p>{{ widget.settings.intro }}</p></div></div><div class="card" style="overflow:hidden"><table class="t"><thead><tr><th scope="col">Plan</th><th scope="col">Deadline</th><th scope="col">What to know</th></tr></thead><tbody>{% for it in widget.settings.items %}<tr><th scope="row" style="font-weight:700;color:var(--ink)">{{ it.label }}</th><td class="res">{{ it.date }}</td><td class="muted">{{ it.note }}</td></tr>{% endfor %}</tbody></table></div></div></section>
