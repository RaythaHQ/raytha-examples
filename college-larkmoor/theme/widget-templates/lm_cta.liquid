<section class="sec"><div class="wrap"><div class="cta" style="padding:40px;display:flex;justify-content:space-between;gap:24px;align-items:center;flex-wrap:wrap"><div style="max-width:680px"><span class="kicker" style="color:var(--gold)">{{ widget.settings.kicker }}</span><h2 style="margin:6px 0 8px">{{ widget.settings.headline }}</h2><p style="margin:0">{{ widget.settings.text }}</p></div><div style="display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}{{ widget.settings.link }}">{{ widget.settings.button }}</a>{% if widget.settings.button2 != blank %}<a class="btn btn-ghost" href="{{ PathBase }}{{ widget.settings.link2 }}">{{ widget.settings.button2 }}</a>{% endif %}</div></div></div></section>
