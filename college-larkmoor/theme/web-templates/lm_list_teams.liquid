{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
<div class="phead colored" style="--c:#2f5d4e"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Athletics</li></ol></nav><span class="kicker" style="color:var(--gold)">Go Larks</span><h1 style="margin-top:6px">Larkmoor Athletics</h1><p>Varsity teams of the Larkmoor Larks in the fictional Calder Valley Athletic Conference. Home games are free with any college ID.</p></div></div>
<div class="body"><div class="wrap">
{% for pair in ses %}{% assign kv = pair | split: ":" %}{%- assign n = 0 -%}{%- capture cards -%}{% for t in Target.Items %}{%- capture tsk -%}{{ t.PublishedContent.season }}{%- endcapture -%}{% if tsk == kv[0] %}{%- assign n = n | plus: 1 -%}{%- assign x = t.PublishedContent -%}{%- capture sek -%}{{ x.season }}{%- endcapture -%}{%- for pair in ses -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sek -%}{%- assign sel = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="card tcard" href="{{ PathBase }}/{{ t.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill green"><i class="bi bi-{{ x.icon }}" aria-hidden="true"></i> {{ sel }}</span><h3>{{ t.PrimaryField }}</h3><p>{{ x.record }}</p><p style="font-size:.84rem;margin-top:4px">{{ x.coach }}</p></div></a>{% endif %}{% endfor %}{%- endcapture -%}
{% if n > 0 %}<section style="margin-bottom:34px"><div class="shead"><div><span class="kicker">{{ kv[1] }} season</span><h2>{{ kv[1] }} sports</h2></div></div><div class="grid g4">{{ cards }}</div></section>{% endif %}{% endfor %}
<div class="split"><div class="card pad prose" style="padding:30px"><h2>Student first, athlete second</h2><p>Larkmoor student-athletes take the same courses as every other student. Practices start after 3:30 pm so labs and seminars come first, and every team has a faculty mentor.</p></div>
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:8px">Venues</h2><p class="muted" style="margin:0">Kessler Fieldhouse hosts indoor sports and the fitness center. Riverside Field hosts soccer, football, lacrosse and cross country meets. Both are on the <a href="{{ PathBase }}/campus">campus map</a>.</p></div></div>
</div></div>
