{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture ck -%}{{ p.category }}{%- endcapture -%}{%- for pair in ncs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {{ cc }}" style="margin-bottom:10px">{{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<article class="card prose" style="overflow:hidden"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;aspect-ratio:1200/630;object-fit:cover"><div style="padding:32px"><p class="muted" style="font-size:.92rem">{{ p.posted_on.Value | date: "%B %-d, %Y" }} &middot; {{ p.author }}</p>{{ p.body }}<p class="disc">This story is fictional and part of the Larkmoor College example site.</p></div></article>
<aside class="grid" style="gap:20px">{%- assign rec = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=6) -%}
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:12px">More news</h2>{% for a in rec.Items %}{% if a.RoutePath != Target.RoutePath %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d" }}</small></span></a>{% endif %}{% endfor %}</div>
<p><a href="{{ PathBase }}/news"><i class="bi bi-arrow-left" aria-hidden="true"></i> All news</a></p></aside>
</div></div>
