{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
{%- assign qk = "" -%}{%- for pair in eks %}{% assign kv = pair | split: ":" %}{% if QueryParams.kind == kv[0] %}{% assign qk = kv[0] %}{% endif %}{% endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Events</li></ol></nav><h1>Events</h1><p>Lectures, performances, visit days, games and campus traditions. Most events are free and open to the public.</p></div></div>
<div class="body"><div class="wrap split">
<div><div class="chips" aria-label="Kinds of events"><a href="{{ PathBase }}/events"{% if qk == "" %} aria-current="true"{% endif %}>Everything</a>{% for pair in eks %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/events?kind={{ kv[0] }}"{% if qk == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</div>
<div class="card">{% for e in Target.Items %}{%- capture ekk -%}{{ e.PublishedContent.kind }}{%- endcapture -%}{% if qk == "" or qk == ekk %}{%- assign x = e.PublishedContent -%}{%- capture ek -%}{{ x.kind }}{%- endcapture -%}{%- for pair in eks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ek -%}{%- assign el = kv[1] -%}{%- assign ei = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%a" }}</small></div><span><span class="pill ox"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }}{% if x.venue %} &middot; {{ x.venue.PrimaryField }}{% endif %}</p></span></a>{% endif %}{% endfor %}</div></div>
<aside class="grid" style="gap:20px"><div class="cta"><h2 style="font-size:1.25rem">Visiting for an event?</h2><p style="margin:8px 0 16px;font-size:.95rem">Visitor parking is free in Lot C on weekends and after 5:00 pm. The campus map shows every venue.</p><a class="btn btn-g" href="{{ PathBase }}/campus">Campus map</a></div>
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">No sign-ups here</h2><p style="font-size:.94rem;margin:0" class="muted">This demo site has no registration or ticket forms. Each event lists how to attend.</p></div></aside>
</div></div>
