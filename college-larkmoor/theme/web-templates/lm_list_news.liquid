{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
{%- assign qc = "" -%}{%- for pair in ncs %}{% assign kv = pair | split: ":" %}{% if QueryParams.category == kv[0] %}{% assign qc = kv[0] %}{% endif %}{% endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">News</li></ol></nav><h1>News</h1><p>Research, student life, the arts, athletics and alumni stories from a fictional college.</p></div></div>
<div class="body"><div class="wrap">
<div class="chips" aria-label="Categories"><a href="{{ PathBase }}/news"{% if qc == "" %} aria-current="true"{% endif %}>All news</a>{% for pair in ncs %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/news?category={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}>{{ kv[1] }}</a>{% endfor %}</div>
{%- assign first = true -%}{%- assign n = 0 -%}{%- capture cards -%}{% for a in Target.Items %}{%- capture ack -%}{{ a.PublishedContent.category }}{%- endcapture -%}{% if qc == "" or qc == ack %}{% if first and qc == "" %}{% assign first = false %}{% else %}{% assign n = n | plus: 1 %}{%- assign x = a.PublishedContent -%}{%- capture ck -%}{{ x.category }}{%- endcapture -%}{%- for pair in ncs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.summary }}</p><p style="margin-top:10px;font-size:.82rem">{{ x.posted_on.Value | date: "%B %-d, %Y" }}</p></div></a>{% endif %}{% endif %}{% endfor %}{%- endcapture -%}
{% if qc == "" %}{% assign a = Target.Items | first %}{% if a %}{% assign x = a.PublishedContent %}{%- capture ck -%}{{ x.category }}{%- endcapture -%}{%- for pair in ncs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="card feat" href="{{ PathBase }}/{{ a.RoutePath }}" style="margin-bottom:24px"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ a.PrimaryField }}</h3><p class="muted">{{ x.summary }}</p><p class="muted" style="font-size:.86rem">{{ x.posted_on.Value | date: "%B %-d, %Y" }} &middot; {{ x.author }}</p><span class="more">Read the story <i class="bi bi-arrow-right" aria-hidden="true"></i></span></div></a>{% endif %}{% endif %}
{% if n > 0 %}<div class="grid g3">{{ cards }}</div>{% elsif qc != "" %}<div class="card pad"><p style="margin:0">No stories in this category yet.</p></div>{% endif %}
</div></div>
