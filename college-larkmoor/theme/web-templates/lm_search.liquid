{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign is_member = false -%}{%- assign is_faculty = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" or g == "faculty" -%}{%- assign is_member = true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign is_faculty = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- assign is_faculty = true -%}{%- endif -%}
{%- assign q = QueryParams.q | strip | remove: "'" | remove: '"' | remove: "<" | remove: ">" | truncate: 60, "" -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Search</li></ol></nav><h1>{% if q != "" %}Search results for &ldquo;{{ q }}&rdquo;{% else %}Search{% endif %}</h1><p>Programs, faculty, news, events, campus places, teams and resources.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/search" role="search"><div class="grow"><label for="sq">Search for</label><input id="sq" name="q" value="{{ q }}" placeholder="Try nursing, river or concert"></div><button class="btn btn-p" type="submit">Search</button></form>
{%- if q != "" -%}
{%- capture f1 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}') or contains(tagline,'{{ q }}'){% endcapture -%}
{%- capture f2 %}contains(name,'{{ q }}') or contains(research,'{{ q }}') or contains(title,'{{ q }}'){% endcapture -%}
{%- capture f3 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f4 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}'){% endcapture -%}
{%- assign rp = get_content_items(ContentType="programs", Filter=f1, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rf = get_content_items(ContentType="faculty", Filter=f2, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rn = get_content_items(ContentType="news", Filter=f3, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign re = get_content_items(ContentType="events", Filter=f3, OrderBy="starts_on asc", PageSize=12) -%}
{%- assign rl = get_content_items(ContentType="places", Filter=f4, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rt = get_content_items(ContentType="teams", Filter=f4, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rr = get_content_items(ContentType="resources", Filter=f3, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign nr = 0 -%}{%- capture rcards -%}{% for r in rr.Items %}{%- capture rak -%}{{ r.PublishedContent.audience }}{%- endcapture -%}{%- assign show = false -%}{%- if rak == "public" or is_faculty -%}{%- assign show = true -%}{%- endif -%}{%- if rak == "students" and is_member -%}{%- assign show = true -%}{%- endif -%}{% if show %}{% assign nr = nr | plus: 1 %}{%- assign x = r.PublishedContent -%}{%- capture ak -%}{{ x.audience }}{%- endcapture -%}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- assign ri = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="svc{% if ak == "faculty" %} locked{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if ak == "faculty" %}shield-lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if ak == "faculty" %} <span class="pill plum" style="margin-left:6px">Faculty</span>{% elsif ak == "students" %} <span class="pill gold" style="margin-left:6px">Portal</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endif %}{% endfor %}{%- endcapture -%}
{%- assign total = rp.TotalCount | plus: rf.TotalCount | plus: rn.TotalCount | plus: re.TotalCount | plus: rl.TotalCount | plus: rt.TotalCount | plus: nr -%}
<p class="count" role="status">{{ total }} result{% if total != 1 %}s{% endif %}</p>
<div class="grid g2" style="align-items:start">
{% if rp.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Programs</h2></div>{% for p in rp.Items %}{% assign x = p.PublishedContent %}{% capture sk %}{{ x.school }}{% endcapture %}{% capture dk %}{{ x.degree }}{% endcapture %}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}{%- for pair in degs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="prow" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ sc }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ p.PrimaryField }}</b><small>{{ dl }} &middot; {{ sl }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endfor %}</div>{% endif %}
{% if rf.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Faculty</h2></div><div class="pad grid" style="gap:12px">{% for f in rf.Items %}{%- assign x = f.PublishedContent -%}{%- capture sk -%}{{ x.school }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}<a class="card fac" href="{{ PathBase }}/{{ f.RoutePath }}"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt="" loading="lazy"><span><b>{{ f.PrimaryField }}</b><span class="meta">{{ x.title }}</span><span class="pill" style="background:color-mix(in srgb,{{ sc }} 14%,#fff);color:{{ sc }}">{{ sl }}</span></span></a>{% endfor %}</div></div>{% endif %}
{% if rn.TotalCount > 0 %}<div class="card pad"><h2 style="font-size:1.3rem;margin-bottom:12px">News</h2>{% for a in rn.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div>{% endif %}
{% if re.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Events</h2></div>{% for e in re.Items %}{%- assign x = e.PublishedContent -%}{%- capture ek -%}{{ x.kind }}{%- endcapture -%}{%- for pair in eks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ek -%}{%- assign el = kv[1] -%}{%- assign ei = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%a" }}</small></div><span><span class="pill ox"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }}{% if x.venue %} &middot; {{ x.venue.PrimaryField }}{% endif %}</p></span></a>{% endfor %}</div>{% endif %}
{% if rl.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Campus places</h2></div>{% for b in rl.Items %}<a class="svc" href="{{ PathBase }}/{{ b.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-geo-alt"></i></span><span><b>{{ b.PrimaryField }}</b><small>{{ b.PublishedContent.summary }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rt.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Athletics</h2></div>{% for t in rt.Items %}<a class="svc" href="{{ PathBase }}/{{ t.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ t.PublishedContent.icon }}"></i></span><span><b>{{ t.PrimaryField }}</b><small>{{ t.PublishedContent.record }}</small></span></a>{% endfor %}</div>{% endif %}
{% if nr > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Resources</h2></div>{{ rcards }}</div>{% endif %}
</div>
{% if total == 0 %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nothing matched &ldquo;{{ q }}&rdquo;</h2><p class="muted">Try a shorter word, or browse <a href="{{ PathBase }}/programs">programs</a>.</p></div>{% endif %}
{%- else -%}
<h2 style="font-size:1.2rem;margin-bottom:12px">Popular searches</h2><div class="chips">{% assign sug = "nursing,river,concert,soccer,library,advising" | split: "," %}{% for s in sug %}<a href="{{ PathBase }}/search?q={{ s | url_encode }}">{{ s }}</a>{% endfor %}</div>
{%- endif -%}
</div></div>
