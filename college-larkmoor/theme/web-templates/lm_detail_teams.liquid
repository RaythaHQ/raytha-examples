{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture sek -%}{{ p.season }}{%- endcapture -%}{%- for pair in ses -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sek -%}{%- assign sel = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="phead colored" style="--c:#2f5d4e"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/athletics">Athletics</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill" style="background:var(--gold);color:var(--ink);margin-bottom:10px"><i class="bi bi-{{ p.icon }}" aria-hidden="true"></i> {{ sel }} season</span><h1>Larks {{ Target.PrimaryField | downcase }}</h1><p>{{ p.record }}</p></div></div>
<div class="body"><div class="wrap art">
<div class="grid" style="gap:22px">
<div class="card" style="overflow:hidden"><table class="t"><caption>Schedule and results</caption><thead><tr><th scope="col">Date</th><th scope="col">Opponent</th><th scope="col">Where</th><th scope="col">Result or time</th></tr></thead><tbody>
{% assign rows = p.schedule | newline_to_br | split: "<br />" %}{% for r in rows %}{% assign c = r | strip | split: "|" %}{% if c.size > 3 %}<tr><td style="white-space:nowrap">{{ c[0] | date: "%b %-d" }}</td><th scope="row" style="font-weight:600;color:var(--ink)">{{ c[1] }}</th><td>{{ c[2] }}</td><td class="res">{{ c[3] }}</td></tr>{% endif %}{% endfor %}
</tbody></table></div>
<article class="card pad prose" style="padding:32px">{{ p.body }}<p class="disc">Teams, coaches and results are fictional.</p></article>
</div>
<aside class="grid" style="gap:20px"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="Illustration of a playing field" style="width:100%;border-radius:16px;box-shadow:var(--sh)">
<div class="card pad"><dl class="facts"><div><dt>Record</dt><dd>{{ p.record }}</dd></div><div><dt>Head coach</dt><dd>{{ p.coach }}</dd></div>{% if p.venue %}<div><dt>Home venue</dt><dd><a href="{{ PathBase }}/{{ p.venue.RoutePath }}">{{ p.venue.PrimaryField }}</a></dd></div>{% endif %}<div><dt>Season</dt><dd>{{ sel }}</dd></div></dl></div>
<p><a href="{{ PathBase }}/athletics"><i class="bi bi-arrow-left" aria-hidden="true"></i> All teams</a></p></aside>
</div></div>
