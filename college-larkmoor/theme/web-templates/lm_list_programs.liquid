{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
{%- assign qs = "" -%}{%- for pair in schs %}{% assign kv = pair | split: ":" %}{% if QueryParams.school == kv[0] %}{% assign qs = kv[0] %}{% assign qsl = kv[1] %}{% endif %}{% endfor -%}
{%- assign qd = "" -%}{%- for pair in degs %}{% assign kv = pair | split: ":" %}{% if QueryParams.degree == kv[0] %}{% assign qd = kv[0] %}{% endif %}{% endfor -%}
{%- assign qq = QueryParams.q | default: "" | strip | downcase | remove: "<" | remove: ">" | remove: '"' | truncate: 40, "" -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Academics</li></ol></nav><h1>Academic programs</h1><p>Majors, minors, a graduate program and more across six schools. Filter by school or degree, or search by name.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/programs" method="get">
  <div class="grow"><label for="pq">Program name</label><input id="pq" name="q" value="{{ qq }}" placeholder="Try biology or data"></div>
  <div><label for="ps">School</label><select id="ps" name="school"><option value="">All schools</option>{% for pair in schs %}{% assign kv = pair | split: ":" %}<option value="{{ kv[0] }}"{% if qs == kv[0] %} selected{% endif %}>{{ kv[1] }}</option>{% endfor %}</select></div>
  <div><label for="pd">Degree</label><select id="pd" name="degree"><option value="">Any degree</option>{% for pair in degs %}{% assign kv = pair | split: ":" %}<option value="{{ kv[0] }}"{% if qd == kv[0] %} selected{% endif %}>{{ kv[1] }}</option>{% endfor %}</select></div>
  <button class="btn btn-p" type="submit">Apply filters</button>{% if qs != "" or qd != "" or qq != "" %}<a class="btn btn-o" href="{{ PathBase }}/programs">Clear</a>{% endif %}
</form>
<div class="chips" aria-label="Schools"><a href="{{ PathBase }}/programs"{% if qs == "" %} aria-current="true"{% endif %}>All schools</a>{% for pair in schs %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/programs?school={{ kv[0] }}"{% if qs == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[3] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</div>
{%- assign n = 0 -%}{%- capture cards -%}{%- for p in Target.Items -%}{%- capture psk -%}{{ p.PublishedContent.school }}{%- endcapture -%}{%- capture pdk -%}{{ p.PublishedContent.degree }}{%- endcapture -%}{%- assign pnm = p.PrimaryField | downcase -%}{%- assign ptg = p.PublishedContent.tagline | downcase -%}
{%- assign ok = true -%}{%- if qs != "" and qs != psk -%}{%- assign ok = false -%}{%- endif -%}{%- if qd != "" and qd != pdk -%}{%- assign ok = false -%}{%- endif -%}
{%- if qq != "" -%}{%- unless pnm contains qq or ptg contains qq -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}
{%- if ok -%}{%- assign n = n | plus: 1 -%}{%- assign x = p.PublishedContent -%}{%- capture sk -%}{{ x.school }}{%- endcapture -%}{%- capture dk -%}{{ x.degree }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}{%- for pair in degs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="card prog" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ sc }}"><div class="top"><i class="bi bi-{{ x.icon }}" aria-hidden="true"></i><span class="deg">{{ dl }}</span></div><div class="bd"><h3>{{ p.PrimaryField }}</h3><p>{{ x.tagline }}</p><span class="sch">{{ sl }}</span></div></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
<p class="count" role="status">{{ n }} program{% if n != 1 %}s{% endif %}{% if qs != "" %} in {{ qsl }}{% endif %}{% if qq != "" %} matching &ldquo;{{ qq }}&rdquo;{% endif %}</p>
{% if n > 0 %}<div class="grid g3">{{ cards }}</div>{% else %}<div class="card pad" style="padding:34px;text-align:center"><h2>No programs match those filters</h2><p class="muted">Try a different school or a shorter word.</p><a class="btn btn-o" href="{{ PathBase }}/programs">Show all programs</a></div>{% endif %}
<p class="disc" style="margin-top:28px">Larkmoor College is fictional. Programs, credits and outcomes are illustrative and do not describe a real institution.</p>
</div></div>
