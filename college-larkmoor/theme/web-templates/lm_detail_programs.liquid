{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture sk -%}{{ p.school }}{%- endcapture -%}{%- capture dk -%}{{ p.degree }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}{%- for pair in degs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="phead colored" style="--c:{{ sc }}"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/programs">Academics</a></li><li><a href="{{ PathBase }}/programs?school={{ sk }}">{{ sl }}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:12px;position:relative;z-index:1"><span class="pill" style="background:rgba(255,255,255,.18);color:#fff">{{ dl }}</span><span class="pill" style="background:rgba(255,255,255,.18);color:#fff"><i class="bi bi-{{ si }}" aria-hidden="true"></i> {{ sl }}</span></div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<div class="grid" style="gap:22px">
  <article class="card pad prose" style="padding:32px">{{ p.body }}</article>
  <div class="grid g2">
    <div class="card pad"><h2 style="font-size:1.3rem;margin-bottom:10px">Highlights</h2><ul class="ticks">{% assign hl = p.highlights | newline_to_br | split: "<br />" %}{% for h in hl %}{% assign hs = h | strip %}{% if hs != "" %}<li>{{ hs }}</li>{% endif %}{% endfor %}</ul></div>
    <div class="card pad"><h2 style="font-size:1.3rem;margin-bottom:10px">Sample courses</h2><ul class="ticks">{% assign cs = p.courses | newline_to_br | split: "<br />" %}{% for c in cs %}{% assign c2 = c | strip %}{% if c2 != "" %}<li>{{ c2 }}</li>{% endif %}{% endfor %}</ul></div>
  </div>
  {%- assign fac = get_content_items(ContentType="faculty", OrderBy="sort_order asc", PageSize=100) -%}{%- assign nf = 0 -%}
  {%- capture fc -%}{%- for f in fac.Items -%}{%- if f.PublishedContent.program.RoutePath == Target.RoutePath -%}{%- assign nf = nf | plus: 1 -%}{%- assign x = f.PublishedContent -%}{%- capture sk -%}{{ x.school }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}<a class="card fac" href="{{ PathBase }}/{{ f.RoutePath }}"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt="" loading="lazy"><span><b>{{ f.PrimaryField }}</b><span class="meta">{{ x.title }}</span><span class="pill" style="background:color-mix(in srgb,{{ sc }} 14%,#fff);color:{{ sc }}">{{ sl }}</span></span></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {% if nf > 0 %}<div><h2 style="font-size:1.4rem;margin-bottom:14px">Faculty in {{ Target.PrimaryField }}</h2><div class="grid g2">{{ fc }}</div></div>{% endif %}
</div>
<aside class="grid" style="gap:20px">
  <div class="card pad"><dl class="facts"><div><dt>Degree</dt><dd>{{ dl }}</dd></div><div><dt>School</dt><dd><a href="{{ PathBase }}/programs?school={{ sk }}">{{ sl }}</a></dd></div><div><dt>Credits</dt><dd>{{ p.credits }}</dd></div><div><dt>Format</dt><dd>{{ p.format }}</dd></div>{% if p.home %}<div><dt>Home base</dt><dd><a href="{{ PathBase }}/{{ p.home.RoutePath }}">{{ p.home.PrimaryField }}</a></dd></div>{% endif %}</dl></div>
  <div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:8px">Where graduates go</h2><ul class="ticks">{% assign oc = p.outcomes | newline_to_br | split: "<br />" %}{% for o in oc %}{% assign o2 = o | strip %}{% if o2 != "" %}<li>{{ o2 }}</li>{% endif %}{% endfor %}</ul></div>
  <div class="cta"><h2 style="font-size:1.2rem">See it in person</h2><p style="margin:8px 0 16px;font-size:.95rem">Sit in on a class, meet faculty and tour {% if p.home %}{{ p.home.PrimaryField }}{% else %}campus{% endif %} on a visit day. There are no sign-up forms on this demo site.</p><a class="btn btn-g" href="{{ PathBase }}/admissions#visit">Plan a visit</a></div>
  {%- capture sf %}school eq '{{ sk }}'{% endcapture -%}{%- assign rel = get_content_items(ContentType="programs", Filter=sf, OrderBy="sort_order asc", PageSize=6) -%}
  <div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.15rem">More in {{ sl }}</h2></div>{% for r in rel.Items %}{% if r.RoutePath != Target.RoutePath %}{% assign rx = r.PublishedContent %}{% capture rdk %}{{ rx.degree }}{% endcapture %}{%- for pair in degs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rdk -%}{%- assign rdl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="prow" href="{{ PathBase }}/{{ r.RoutePath }}" style="--c:{{ sc }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ rx.icon }}"></i></span><span><b>{{ r.PrimaryField }}</b><small>{{ rdl }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endif %}{% endfor %}</div>
</aside>
</div></div>
