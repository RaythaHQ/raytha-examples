{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture sk -%}{{ p.school }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/faculty">Faculty directory</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><h1>{{ Target.PrimaryField }}</h1><p>{{ p.title }}</p></div></div>
<div class="body"><div class="wrap">
<div class="card phero" style="margin-bottom:24px"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="Illustrated portrait of {{ Target.PrimaryField }}"><div>
  <span class="pill" style="background:color-mix(in srgb,{{ sc }} 14%,#fff);color:{{ sc }};margin-bottom:12px"><i class="bi bi-{{ si }}" aria-hidden="true"></i> {{ sl }}</span>
  <dl class="facts">{% if p.program %}<div><dt>Program</dt><dd><a href="{{ PathBase }}/{{ p.program.RoutePath }}">{{ p.program.PrimaryField }}</a></dd></div>{% endif %}<div><dt>Interests</dt><dd>{{ p.research }}</dd></div><div><dt>Office</dt><dd>{{ p.office }}</dd></div><div><dt>Office hours</dt><dd>{{ p.office_hours }}</dd></div><div><dt>Email</dt><dd><a href="mailto:{{ p.email }}">{{ p.email }}</a></dd></div><div><dt>Phone</dt><dd>{{ p.phone }}</dd></div></dl>
</div></div>
<div class="art"><article class="card pad prose" style="padding:32px"><h2>About {{ Target.PrimaryField | split: " " | first }}</h2>{{ p.bio }}<p class="disc">This faculty member is fictional. Larkmoor College is a Raytha example site.</p></article>
<aside class="grid" style="gap:20px">{%- capture sf %}school eq '{{ sk }}'{% endcapture -%}{%- assign same = get_content_items(ContentType="faculty", Filter=sf, OrderBy="sort_order asc", PageSize=6) -%}
<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.15rem">Also in {{ sl }}</h2></div>{% for f in same.Items %}{% if f.RoutePath != Target.RoutePath %}<a class="svc" href="{{ PathBase }}/{{ f.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-person"></i></span><span><b>{{ f.PrimaryField }}</b><small>{{ f.PublishedContent.title }}</small></span></a>{% endif %}{% endfor %}</div>
<p><a href="{{ PathBase }}/faculty"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to the directory</a></p></aside></div>
</div></div>
