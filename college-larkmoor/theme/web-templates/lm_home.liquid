{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
{%- assign allp = get_content_items(ContentType="programs", OrderBy="sort_order asc", PageSize=100) -%}
{%- assign fp = get_content_items(ContentType="programs", Filter="featured eq 'true'", OrderBy="sort_order asc", PageSize=6) -%}
{%- assign fn = get_content_items(ContentType="news", Filter="featured eq 'true'", OrderBy="posted_on desc", PageSize=3) -%}
{%- assign fe = get_content_items(ContentType="events", Filter="featured eq 'true'", OrderBy="starts_on asc", PageSize=4) -%}
{%- assign ft = get_content_items(ContentType="teams", Filter="featured eq 'true'", OrderBy="sort_order asc", PageSize=3) -%}
{%- assign pl = get_content_items(ContentType="places", OrderBy="sort_order asc", PageSize=20) -%}
<section class="hero"><svg class="skyline" viewBox="0 0 1440 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true"><path d="M0 170 Q 240 120 480 150 T 960 140 T 1440 130 V260 H0Z" fill="#fff" opacity=".05"/><g fill="#fff" opacity=".1"><rect x="150" y="120" width="160" height="90"/><path d="M140 122 L230 80 L320 122Z"/><rect x="640" y="40" width="54" height="170"/><path d="M632 42 L667 0 L702 42Z"/><rect x="540" y="110" width="250" height="100"/><path d="M530 112 L665 70 L800 112Z"/><rect x="980" y="105" width="210" height="105"/><path d="M970 108 Q1085 60 1200 108Z"/><rect x="1240" y="130" width="120" height="80"/></g><circle cx="667" cy="68" r="11" fill="none" stroke="#c99a3b" stroke-width="3" opacity=".55"/><g fill="#fff" opacity=".07"><circle cx="70" cy="185" r="34"/><circle cx="110" cy="195" r="26"/><circle cx="400" cy="180" r="30"/><circle cx="450" cy="190" r="22"/><circle cx="880" cy="186" r="32"/><circle cx="925" cy="194" r="24"/><circle cx="1400" cy="182" r="30"/><circle cx="1370" cy="195" r="22"/></g><path d="M0 214 Q 360 190 720 206 T 1440 200 V260 H0Z" fill="#faf7f2"/></svg><div class="wrap hgrid">
  <div><span class="kicker">A fictional liberal arts and sciences college</span>
  <h1>Learn by doing, with people who know your name</h1>
  <p class="lead">Larkmoor College is a residential college of 3,400 students on the Calder River. Find a program, meet the faculty, and plan a visit to campus.</p>
  <form class="finder" action="{{ PathBase }}/programs" method="get" role="search"><label for="fs">School</label><select id="fs" name="school"><option value="">All schools</option>{% for pair in schs %}{% assign kv = pair | split: ":" %}<option value="{{ kv[0] }}">{{ kv[1] }}</option>{% endfor %}</select><label for="fq">Program name</label><input id="fq" name="q" placeholder="Try biology, nursing or data"><button class="btn btn-p" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Find a program</button></form>
  <div class="pop"><span>Popular:</span><a href="{{ PathBase }}/programs/nursing">Nursing</a><a href="{{ PathBase }}/programs/computer-science">Computer Science</a><a href="{{ PathBase }}/programs/biology">Biology</a><a href="{{ PathBase }}/admissions">Admissions</a></div></div>
  <aside class="glance" aria-label="Larkmoor at a glance"><h2>Larkmoor at a glance</h2><div class="gs"><div><b>3,400</b><span>students</span></div><div><b>11:1</b><span>student to faculty</span></div><div><b>{{ allp.TotalCount }}</b><span>programs on this site</span></div><div><b>19</b><span>average class size</span></div></div><p class="nt">Numbers are part of the fictional story.</p></aside>
</div></section>
<section class="tasks"><div class="wrap"><div class="tgrid">
  <a class="task" href="{{ PathBase }}/programs"><span class="ic" aria-hidden="true"><i class="bi bi-mortarboard"></i></span><span><b>Academics</b><span>Majors, minors and graduate programs</span></span></a>
  <a class="task" href="{{ PathBase }}/admissions"><span class="ic" aria-hidden="true"><i class="bi bi-envelope-open"></i></span><span><b>Admissions</b><span>How to apply, deadlines, cost and aid</span></span></a>
  <a class="task" href="{{ PathBase }}/campus"><span class="ic" aria-hidden="true"><i class="bi bi-map"></i></span><span><b>Campus life</b><span>Halls, dining, the arts and a campus map</span></span></a>
  <a class="task" href="{{ PathBase }}/faculty"><span class="ic" aria-hidden="true"><i class="bi bi-person-lines-fill"></i></span><span><b>Faculty directory</b><span>Find a professor by school or interest</span></span></a>
</div></div></section>
<section class="sec"><div class="wrap">
  <div class="shead"><div><span class="kicker">Academics</span><h2>Six schools, one small campus</h2><p>Every program is taught by faculty, with research, internships or a studio project built in.</p></div><a class="more" href="{{ PathBase }}/programs">All programs <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3" style="margin-bottom:26px">{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- assign n = 0 -%}{%- for p in allp.Items -%}{%- capture pk -%}{{ p.PublishedContent.school }}{%- endcapture -%}{%- if pk == kv[0] -%}{%- assign n = n | plus: 1 -%}{%- endif -%}{%- endfor -%}<a class="card school" href="{{ PathBase }}/programs?school={{ kv[0] }}" style="--c:{{ kv[2] }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ kv[3] }}"></i></span><span><b>{{ kv[1] }}</b><small>{{ n }} program{% if n != 1 %}s{% endif %}</small></span></a>{%- endfor -%}</div>
  <div class="grid g3">{% for p in fp.Items %}{%- assign x = p.PublishedContent -%}{%- capture sk -%}{{ x.school }}{%- endcapture -%}{%- capture dk -%}{{ x.degree }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}{%- for pair in degs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="card prog" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ sc }}"><div class="top"><i class="bi bi-{{ x.icon }}" aria-hidden="true"></i><span class="deg">{{ dl }}</span></div><div class="bd"><h3>{{ p.PrimaryField }}</h3><p>{{ x.tagline }}</p><span class="sch">{{ sl }}</span></div></a>{% endfor %}</div>
</div></section>
{{ render_section("story", wrap=false) }}
<section class="sec alt"><div class="wrap split">
  <div><div class="shead"><div><span class="kicker">Events</span><h2>Coming up on campus</h2></div><a class="more" href="{{ PathBase }}/events">Full calendar <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="card">{% for e in fe.Items %}{%- assign x = e.PublishedContent -%}{%- capture ek -%}{{ x.kind }}{%- endcapture -%}{%- for pair in eks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ek -%}{%- assign el = kv[1] -%}{%- assign ei = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%a" }}</small></div><span><span class="pill ox"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }}{% if x.venue %} &middot; {{ x.venue.PrimaryField }}{% endif %}</p></span></a>{% endfor %}</div></div>
  <div><div class="shead"><div><span class="kicker">News</span><h2>From the college</h2></div><a class="more" href="{{ PathBase }}/news">All news <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="card pad">{% for a in fn.Items %}{% assign x = a.PublishedContent %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ x.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div></div>
</div></section>
<section class="sec"><div class="wrap">
  <div class="shead"><div><span class="kicker">Campus</span><h2>Explore the campus</h2><p>A walkable campus between the old quad and the Calder River. Select a building to learn more.</p></div><a class="more" href="{{ PathBase }}/campus">Campus life <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="cmap"><svg viewBox="0 0 1200 700" role="img" aria-label="Illustrated map of the fictional Larkmoor College campus"><rect width="1200" height="700" fill="#e6eedc"/><path d="M1200 0 L1060 0 C 1020 160, 1150 260, 1080 400 S 1010 600, 1060 700 L1200 700Z" fill="#9cc5d6"/><path d="M1060 0 C 1020 160, 1150 260, 1080 400 S 1010 600, 1060 700" fill="none" stroke="#7fb0c4" stroke-width="6"/><text x="1120" y="250" font-family="Public Sans,Arial" font-size="18" font-weight="700" fill="#3b6f86" transform="rotate(78 1120 250)">Calder River</text><rect x="380" y="260" width="420" height="250" rx="24" fill="#d3e4c4"/><text x="590" y="400" text-anchor="middle" font-family="Newsreader,Georgia" font-size="22" fill="#5d7f55" font-style="italic">Main Quad</text><path d="M60 380 H1040 M590 40 V680 M200 180 L590 390 L980 600 M220 520 L590 390 L960 220" stroke="#f6efe2" stroke-width="12" stroke-linecap="round" fill="none"/><circle cx="120" cy="90" r="16" fill="#86ad7a" opacity=".85"/><circle cx="150" cy="110" r="12" fill="#86ad7a" opacity=".85"/><circle cx="330" cy="120" r="14" fill="#86ad7a" opacity=".85"/><circle cx="380" cy="520" r="18" fill="#86ad7a" opacity=".85"/><circle cx="420" cy="540" r="12" fill="#86ad7a" opacity=".85"/><circle cx="640" cy="640" r="16" fill="#86ad7a" opacity=".85"/><circle cx="700" cy="620" r="12" fill="#86ad7a" opacity=".85"/><circle cx="980" cy="180" r="14" fill="#86ad7a" opacity=".85"/><circle cx="860" cy="300" r="12" fill="#86ad7a" opacity=".85"/><circle cx="140" cy="600" r="18" fill="#86ad7a" opacity=".85"/><circle cx="180" cy="640" r="12" fill="#86ad7a" opacity=".85"/><circle cx="520" cy="250" r="10" fill="#86ad7a" opacity=".85"/><circle cx="740" cy="250" r="10" fill="#86ad7a" opacity=".85"/><circle cx="560" cy="140" r="12" fill="#86ad7a" opacity=".85"/><rect x="508" y="212" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="796" y="240" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="316" y="324" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="580" y="408" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="172" y="184" width="88" height="38" rx="7" fill="#d8c3ad" stroke="#a88565" stroke-width="2"/><rect x="964" y="436" width="88" height="38" rx="7" fill="#d8c3ad" stroke="#a88565" stroke-width="2"/><rect x="244" y="492" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="892" y="576" width="88" height="46" rx="7" fill="#c9a98a" stroke="#a88565" stroke-width="2"/><rect x="1034" y="270" width="140" height="84" rx="8" fill="#5e9a5c" stroke="#fff" stroke-width="3"/><ellipse cx="1104" cy="312" rx="18" ry="12" fill="none" stroke="#fff" stroke-width="2"/><rect x="676" y="114" width="88" height="38" rx="7" fill="#d8c3ad" stroke="#a88565" stroke-width="2"/><g transform="translate(70 70)"><circle r="26" fill="#fff" stroke="#a88565" stroke-width="2"/><path d="M0 -18 L7 4 L0 0 L-7 4Z" fill="#6d1f2b"/><text y="20" text-anchor="middle" font-size="11" font-weight="700" font-family="Public Sans,Arial" fill="#6d1f2b">N</text></g></svg>{% for b in pl.Items %}{% assign x = b.PublishedContent %}<a class="pin k-{{ x.kind }}" href="{{ PathBase }}/{{ b.RoutePath }}" style="left:{{ x.map_x }}%;top:{{ x.map_y }}%" aria-label="{{ b.PrimaryField }}"><span aria-hidden="true">{{ b.PrimaryField }}</span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></a>{% endfor %}</div>
</div></section>
<section class="sec band"><div class="wrap">
  <div class="shead"><div><span class="kicker">Go Larks</span><h2>Athletics</h2><p>Varsity teams in the fictional Calder Valley Athletic Conference.</p></div><a class="more" href="{{ PathBase }}/athletics">All teams <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3">{% for t in ft.Items %}{% assign x = t.PublishedContent %}<a class="team" href="{{ PathBase }}/{{ t.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><b>{{ t.PrimaryField }}</b><span>{{ x.record }}</span><small>{{ x.coach }}{% if x.venue %} &middot; {{ x.venue.PrimaryField }}{% endif %}</small></a>{% endfor %}</div>
</div></section>
{{ render_section("main", wrap=false) }}
