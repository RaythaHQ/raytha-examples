{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture ek -%}{{ p.kind }}{%- endcapture -%}{%- for pair in eks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ek -%}{%- assign el = kv[1] -%}{%- assign ei = kv[2] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/events">Events</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill ox" style="margin-bottom:10px"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<article class="card pad prose" style="padding:32px">{{ p.body }}<h2>How to attend</h2><p>{{ p.attend }}</p><p class="disc">This event is fictional and part of the Larkmoor College example site.</p></article>
<aside class="grid" style="gap:20px"><div class="card pad" style="display:flex;gap:16px;align-items:flex-start"><div class="date"><span>{{ p.starts_on.Value | date: "%b" }}</span><b>{{ p.starts_on.Value | date: "%-d" }}</b><small>{{ p.starts_on.Value | date: "%Y" }}</small></div>
<dl class="facts" style="flex:1"><div><dt>When</dt><dd>{{ p.starts_on.Value | date: "%A, %B %-d" }}<br>{{ p.time }}</dd></div>{% if p.venue %}<div><dt>Where</dt><dd><a href="{{ PathBase }}/{{ p.venue.RoutePath }}">{{ p.venue.PrimaryField }}</a><br><span class="muted" style="font-weight:400">{{ p.room }}</span></dd></div>{% endif %}<div><dt>Cost</dt><dd>{{ p.cost }}</dd></div></dl></div>
<p><a href="{{ PathBase }}/events"><i class="bi bi-arrow-left" aria-hidden="true"></i> All events</a></p></aside>
</div></div>
