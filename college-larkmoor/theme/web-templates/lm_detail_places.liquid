{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture bk -%}{{ p.kind }}{%- endcapture -%}{%- for pair in pks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == bk -%}{%- assign bl = kv[1] -%}{%- assign bi = kv[2] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/campus">Campus life</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill dark" style="margin-bottom:10px"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<div class="grid" style="gap:22px">
  <img src="{{ p.image.Value | attachment_redirect_url }}" alt="Illustration of {{ Target.PrimaryField }}" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;box-shadow:var(--sh)">
  <article class="card pad prose" style="padding:32px">{{ p.body }}
  {% assign fs = p.features | split: "," %}{% if fs.size > 0 %}<h2>Inside</h2><p style="display:flex;gap:8px;flex-wrap:wrap">{% for f in fs %}<span class="pill gold">{{ f | strip }}</span>{% endfor %}</p>{% endif %}</article>
  {%- assign evs = get_content_items(ContentType="events", OrderBy="starts_on asc", PageSize=50) -%}{%- assign ne = 0 -%}
  {%- capture ec -%}{%- for e in evs.Items -%}{%- if e.PublishedContent.venue.RoutePath == Target.RoutePath -%}{%- assign ne = ne | plus: 1 -%}{%- assign x = e.PublishedContent -%}{%- capture ek -%}{{ x.kind }}{%- endcapture -%}{%- for pair in eks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ek -%}{%- assign el = kv[1] -%}{%- assign ei = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%a" }}</small></div><span><span class="pill ox"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }}{% if x.venue %} &middot; {{ x.venue.PrimaryField }}{% endif %}</p></span></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {% if ne > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Events here</h2></div>{{ ec }}</div>{% endif %}
</div>
<aside class="grid" style="gap:20px">
  <div class="card pad"><dl class="facts"><div><dt>Kind</dt><dd>{{ bl }}</dd></div><div><dt>Opened</dt><dd>{{ p.built }}</dd></div><div><dt>Hours</dt><dd class="hours">{{ p.hours }}</dd></div></dl></div>
  {%- assign progs = get_content_items(ContentType="programs", OrderBy="sort_order asc", PageSize=100) -%}{%- assign np = 0 -%}
  {%- capture pc -%}{%- for r in progs.Items -%}{%- if r.PublishedContent.home.RoutePath == Target.RoutePath -%}{%- assign np = np | plus: 1 -%}<a class="svc" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ r.PublishedContent.icon }}"></i></span><span><b>{{ r.PrimaryField }}</b><small>{{ r.PublishedContent.tagline }}</small></span></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {% if np > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.15rem">Programs based here</h2></div>{{ pc }}</div>{% endif %}
  <p><a href="{{ PathBase }}/campus"><i class="bi bi-arrow-left" aria-hidden="true"></i> Campus map</a></p>
</aside>
</div></div>
