{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign is_member = false -%}{%- assign is_faculty = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" or g == "faculty" -%}{%- assign is_member = true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign is_faculty = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- assign is_faculty = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Portal</li></ol></nav><span class="pill plum" style="margin-bottom:10px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>Student and faculty portal</h1><p>Advising, tutoring, technology and wellbeing resources for students, plus teaching and policy materials for faculty and staff.</p></div></div>
<div class="body"><div class="wrap">
{% if is_member == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>The portal is for Larkmoor students and faculty.</h2><p style="max-width:620px">Sign in with your portal account to see advising checklists, tutoring hours, the technology guide and, for faculty and staff, teaching and policy materials. This is a website account for the portal, not the student records system or email.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the college</a></div></div>
<div class="grid g3" style="margin-top:24px"><div class="card pad"><h3><i class="bi bi-compass" aria-hidden="true" style="color:var(--ox)"></i> Advising</h3><p class="muted" style="margin:6px 0 0">Checklists and tutoring hours for students.</p></div><div class="card pad"><h3><i class="bi bi-laptop" aria-hidden="true" style="color:var(--ox)"></i> Technology and wellbeing</h3><p class="muted" style="margin:6px 0 0">The technology guide, counseling and health services.</p></div><div class="card pad"><h3><i class="bi bi-easel" aria-hidden="true" style="color:var(--ox)"></i> Faculty and staff</h3><p class="muted" style="margin:6px 0 0">The handbook digest, grade deadlines and teaching workshops.</p></div></div>
{% else %}
<div class="member" style="margin-bottom:22px"><i class="bi bi-person-check" style="font-size:1.5rem;color:var(--ox)" aria-hidden="true"></i><p style="margin:0">Signed in as <strong>{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</strong> &middot; {% if is_faculty %}<span class="pill plum">Faculty and staff</span>{% else %}<span class="pill gold">Student</span>{% endif %} <span class="muted" style="font-size:.9rem">These resources are for members of this fictional college.</span></p></div>
<div class="embed">{{ render_section("main", wrap=false) }}</div>
{%- assign rs = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=50) -%}
<div class="grid g2" style="margin-top:22px;align-items:start">
<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.35rem">For students</h2><p class="muted" style="margin:4px 0 0;font-size:.92rem">Visible to the students and faculty groups.</p></div>{% for r in rs.Items %}{%- capture rak -%}{{ r.PublishedContent.audience }}{%- endcapture -%}{% if rak == "students" %}{%- assign x = r.PublishedContent -%}{%- capture ak -%}{{ x.audience }}{%- endcapture -%}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- assign ri = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="svc{% if ak == "faculty" %} locked{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if ak == "faculty" %}shield-lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if ak == "faculty" %} <span class="pill plum" style="margin-left:6px">Faculty</span>{% elsif ak == "students" %} <span class="pill gold" style="margin-left:6px">Portal</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endif %}{% endfor %}</div>
<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.35rem">For faculty and staff</h2><p class="muted" style="margin:4px 0 0;font-size:.92rem">Visible to the faculty group only.</p></div>{% if is_faculty %}{% for r in rs.Items %}{%- capture rak -%}{{ r.PublishedContent.audience }}{%- endcapture -%}{% if rak == "faculty" %}{%- assign x = r.PublishedContent -%}{%- capture ak -%}{{ x.audience }}{%- endcapture -%}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- assign ri = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="svc{% if ak == "faculty" %} locked{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if ak == "faculty" %}shield-lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if ak == "faculty" %} <span class="pill plum" style="margin-left:6px">Faculty</span>{% elsif ak == "students" %} <span class="pill gold" style="margin-left:6px">Portal</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endif %}{% endfor %}{% else %}<div class="pad"><div class="lock" style="padding:26px"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2 style="font-size:1.25rem">Limited to faculty and staff</h2><p style="margin:0">Your account is in the students group, so faculty materials stay hidden. The template checks group membership on the server before it renders them.</p></div></div>{% endif %}</div>
</div>
{% endif %}
</div></div>
