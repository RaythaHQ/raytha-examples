{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign is_member = false -%}{%- assign is_faculty = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" or g == "faculty" -%}{%- assign is_member = true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign is_faculty = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- assign is_faculty = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Resources</li></ol></nav><h1>Campus resources</h1><p>The academic calendar, safety information, accessibility services and visitor guides. Student and faculty materials live in the portal.</p></div></div>
<div class="body"><div class="wrap split">
<div class="card">{% for r in Target.Items %}{%- capture rak -%}{{ r.PublishedContent.audience }}{%- endcapture -%}{% if rak == "public" %}{%- assign x = r.PublishedContent -%}{%- capture ak -%}{{ x.audience }}{%- endcapture -%}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- assign ri = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="svc{% if ak == "faculty" %} locked{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if ak == "faculty" %}shield-lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if ak == "faculty" %} <span class="pill plum" style="margin-left:6px">Faculty</span>{% elsif ak == "students" %} <span class="pill gold" style="margin-left:6px">Portal</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endif %}{% endfor %}</div>
<aside class="grid" style="gap:20px">
{% if is_member %}<div class="member"><i class="bi bi-person-check" style="font-size:1.4rem;color:var(--ox)" aria-hidden="true"></i><p style="margin:0;font-size:.95rem">You are signed in as {{ CurrentUser.FirstName }}. Open the <a href="{{ PathBase }}/portal">portal</a> for advising, technology and {% if is_faculty %}faculty {% endif %}resources.</p></div>{% else %}<div class="cta"><h2 style="font-size:1.25rem">Student and faculty portal</h2><p style="margin:8px 0 16px;font-size:.95rem">Advising checklists, tutoring hours, the technology guide and faculty materials are behind a portal sign-in.</p><a class="btn btn-g" href="{{ PathBase }}/portal">Go to the portal</a></div>{% endif %}
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Need help now?</h2><p style="font-size:.94rem;margin:0">Campus safety, 24 hours: <a href="tel:+15550142911">(555) 014-2911</a><br>Main number: <a href="tel:+15550142000">(555) 014-2000</a></p></div>
</aside></div></div>
