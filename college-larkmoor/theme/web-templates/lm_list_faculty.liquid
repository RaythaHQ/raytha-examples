{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}
{%- assign qs = "" -%}{%- for pair in schs %}{% assign kv = pair | split: ":" %}{% if QueryParams.school == kv[0] %}{% assign qs = kv[0] %}{% endif %}{% endfor -%}
{%- assign qq = QueryParams.q | default: "" | strip | downcase | remove: "<" | remove: ">" | remove: '"' | truncate: 40, "" -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/programs">Academics</a></li><li aria-current="page">Faculty directory</li></ol></nav><h1>Faculty directory</h1><p>Find a professor by school, name or teaching interest. Every person here is fictional.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/faculty" method="get">
  <div class="grow"><label for="fq2">Name or interest</label><input id="fq2" name="q" value="{{ qq }}" placeholder="Try ecology, fiction or polling"></div>
  <div><label for="fs2">School</label><select id="fs2" name="school"><option value="">All schools</option>{% for pair in schs %}{% assign kv = pair | split: ":" %}<option value="{{ kv[0] }}"{% if qs == kv[0] %} selected{% endif %}>{{ kv[1] }}</option>{% endfor %}</select></div>
  <button class="btn btn-p" type="submit">Search the directory</button>{% if qs != "" or qq != "" %}<a class="btn btn-o" href="{{ PathBase }}/faculty">Clear</a>{% endif %}
</form>
{%- assign n = 0 -%}{%- capture cards -%}{%- for f in Target.Items -%}{%- capture fsk -%}{{ f.PublishedContent.school }}{%- endcapture -%}{%- assign fnm = f.PrimaryField | downcase -%}{%- assign frs = f.PublishedContent.research | downcase -%}{%- assign ftl = f.PublishedContent.title | downcase -%}
{%- assign ok = true -%}{%- if qs != "" and qs != fsk -%}{%- assign ok = false -%}{%- endif -%}{%- if qq != "" -%}{%- unless fnm contains qq or frs contains qq or ftl contains qq -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}
{%- if ok -%}{%- assign n = n | plus: 1 -%}{%- assign x = f.PublishedContent -%}{%- capture sk -%}{{ x.school }}{%- endcapture -%}{%- for pair in schs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- assign sc = kv[2] -%}{%- assign si = kv[3] -%}{%- endif -%}{%- endfor -%}<a class="card fac" href="{{ PathBase }}/{{ f.RoutePath }}"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt="" loading="lazy"><span><b>{{ f.PrimaryField }}</b><span class="meta">{{ x.title }}</span><span class="pill" style="background:color-mix(in srgb,{{ sc }} 14%,#fff);color:{{ sc }}">{{ sl }}</span></span></a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
<p class="count" role="status">{{ n }} faculty member{% if n != 1 %}s{% endif %}</p>
{% if n > 0 %}<div class="fgrid">{{ cards }}</div>{% else %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nobody matches that search</h2><p class="muted">Try a shorter word or another school.</p></div>{% endif %}
<p class="disc" style="margin-top:28px">Every faculty member on this page is fictional. Email addresses use the reserved .example domain and do not reach anyone.</p>
</div></div>
