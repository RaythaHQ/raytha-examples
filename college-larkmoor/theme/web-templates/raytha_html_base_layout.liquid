<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Larkmoor College" %}{{ Target.Title }} | {% endif %}Larkmoor College</title>
  <meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Larkmoor College (a fictional liberal arts and sciences college): academic programs, admissions, campus life, athletics, news, events and a student and faculty portal.{% endif %}">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 52'%3E%3Cpath d='M4 3h40v21c0 13.5-9.2 22.6-20 26.6C13.2 46.6 4 37.5 4 24z' fill='%236d1f2b'/%3E%3Cpath d='M11.5 20.5c4.2-1.7 8.4-1.7 12.5.6 4.1-2.3 8.3-2.3 12.5-.6v13.4c-4.2-1.7-8.4-1.7-12.5.6-4.1-2.3-8.3-2.3-12.5-.6z' fill='%23f6ecd6'/%3E%3C/svg%3E">
  <style>
:root{--ox:#6d1f2b;--ox2:#8a2a38;--ox3:#3d0f18;--gold:#c99a3b;--gold2:#f6ecd6;--green:#2f5d4e;--green2:#e3eee8;--slate:#3b4f6b;--plum:#5b3b66;--ink:#1d1a21;--text:#2e2a33;--muted:#6a6470;--line:#e7dfd2;--paper:#faf7f2;--card:#fff;--r:14px;--sh:0 1px 2px rgba(61,15,24,.05),0 12px 30px -18px rgba(61,15,24,.28)}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-size:17px;line-height:1.62;color:var(--text);background:var(--paper)}
a{color:var(--ox)}a:hover{color:var(--ox3)}img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px;border-radius:4px}
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--gold);color:var(--ink);padding:10px 16px;border-radius:8px;font-weight:700}.skip:focus{left:12px}
h1,h2,h3,h4{color:var(--ink);line-height:1.15;margin:0}
h1,h2{font-family:"Newsreader",Georgia,serif;font-weight:600;letter-spacing:-.012em}
h1{font-size:clamp(2.1rem,4vw,3.2rem)}h2{font-size:clamp(1.55rem,2.5vw,2.1rem)}h3{font-size:1.08rem;font-weight:700}
p{margin:0 0 .9em}.muted{color:var(--muted)}.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.kicker{display:inline-block;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ox2)}
/* utility bar + header */
.ubar{background:var(--ox3);color:#ecd9dc;font-size:.82rem}.ubar .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:7px;padding-bottom:7px;flex-wrap:wrap;align-items:center}
.ubar a{color:#fff;text-decoration:none;margin-left:18px}.ubar a:hover{text-decoration:underline}
.fict{display:inline-block;background:var(--gold);color:var(--ink);font-weight:800;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:4px;margin-right:8px}
.hdr{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}.hdr .wrap{display:flex;align-items:center;gap:22px;height:84px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);flex:none}.brand .crest{width:48px;height:52px;flex:none}
.brand b{display:block;font-family:"Newsreader",serif;font-size:1.5rem;line-height:1;font-weight:600}.brand small{display:block;font-size:.7rem;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin-top:4px}
.nav{display:flex;gap:2px;list-style:none;margin:0 0 0 6px;padding:0}.nav a{display:block;white-space:nowrap;padding:10px 12px;border-radius:9px;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem}
.nav a:hover{background:var(--gold2)}.nav a[aria-current=page]{color:var(--ox);box-shadow:inset 0 -3px 0 var(--gold)}
.hacts{margin-left:auto;display:flex;gap:10px;align-items:center}
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 .95rem "Public Sans",sans-serif;border-radius:10px;padding:11px 18px;text-decoration:none;border:2px solid transparent;cursor:pointer;line-height:1.2;transition:background .15s,transform .15s}
.btn:hover{transform:translateY(-1px)}.btn-p{background:var(--ox);color:#fff}.btn-p:hover{background:var(--ox3);color:#fff}.btn-g{background:var(--gold);color:var(--ink)}.btn-g:hover{background:#b6872c;color:var(--ink)}
.btn-o{border-color:var(--line);background:#fff;color:var(--ink)}.btn-o:hover{border-color:var(--ox);color:var(--ox)}.btn-w{background:#fff;color:var(--ox3)}.btn-ghost{border-color:rgba(255,255,255,.45);color:#fff;background:transparent}.btn-ghost:hover{background:rgba(255,255,255,.1);color:#fff}
.tog{display:none;background:none;border:2px solid var(--line);border-radius:10px;padding:6px 10px;font-size:1.3rem;color:var(--ink)}
.nav .mob{display:none}
.embed .sec{padding:0}.embed .sec .wrap{padding-left:0;padding-right:0;max-width:none}
/* hero */
.hero{position:relative;background:radial-gradient(1200px 500px at 85% -10%,rgba(201,154,59,.28),transparent 60%),linear-gradient(165deg,#4a1220 0%,#6d1f2b 55%,#7d2a36 100%);color:#fff;overflow:hidden;padding:64px 0 230px}
.hero .skyline{position:absolute;left:0;right:0;bottom:0;width:100%;height:260px;pointer-events:none}
.hgrid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:48px;align-items:center;position:relative;z-index:1}
.hero h1{color:#fff;font-size:clamp(2.4rem,4.8vw,3.9rem);max-width:780px;font-weight:600}.hero .kicker{color:var(--gold)}
.hero p.lead{font-size:1.2rem;color:#f1dfe2;max-width:640px;margin:16px 0 26px}
.finder{display:flex;gap:8px;max-width:700px;background:#fff;border-radius:14px;padding:7px;box-shadow:0 24px 50px -20px rgba(0,0,0,.55);flex-wrap:wrap}
.finder label{position:absolute;left:-9999px}.finder select,.finder input{border:0;outline:0;font:inherit;font-size:1rem;padding:12px 14px;color:var(--ink);border-radius:10px;background:#f6f1ea;min-width:0}
.finder input{flex:1;min-width:180px;background:#fff}.finder select:focus-visible,.finder input:focus-visible{outline:3px solid var(--gold)}
.pop{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:.9rem;align-items:center}.pop span{color:#e2c3c8}
.pop a{color:#fff;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);padding:5px 12px;border-radius:30px;text-decoration:none}.pop a:hover{background:rgba(255,255,255,.2)}
.glance{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:26px;backdrop-filter:blur(4px)}
.glance h2{color:#fff;font-size:1.25rem;margin-bottom:14px}.glance .gs{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.glance .gs div{background:rgba(0,0,0,.18);border-radius:14px;padding:14px 16px}.glance b{display:block;font-family:"Newsreader",serif;font-size:2.1rem;line-height:1;color:#fff;font-weight:600}.glance span{font-size:.85rem;color:#ecd2d6}
.glance .nt{font-size:.78rem;color:#d9b9be;margin:12px 0 0}
.tasks{margin-top:-78px;position:relative;z-index:2}
.tgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.task{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:20px;text-decoration:none;color:var(--text);box-shadow:var(--sh);transition:transform .15s,border-color .15s}
.task:hover{transform:translateY(-2px);border-color:var(--ox);color:var(--text)}
.task .ic{width:48px;height:48px;flex:none;border-radius:12px;background:var(--gold2);color:var(--ox);display:grid;place-items:center;font-size:1.35rem}
.task b{display:block;color:var(--ink);font-size:1.02rem;line-height:1.3}.task span{display:block;font-size:.86rem;color:var(--muted);margin-top:3px;line-height:1.4}
/* sections */
.sec{padding:60px 0}.sec.alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.shead{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:24px;flex-wrap:wrap}.shead p{margin:6px 0 0;color:var(--muted);max-width:640px}
.more{font-weight:700;text-decoration:none;white-space:nowrap}.more:hover{text-decoration:underline}
.grid{display:grid;gap:20px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
.split{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:30px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}.pad{padding:22px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:30px;background:#f1ece4;color:#4a4350;white-space:nowrap}
.pill.ox{background:#f6e3e6;color:#6d1f2b}.pill.green{background:var(--green2);color:#24493d}.pill.slate{background:#e4eaf3;color:#2f4260}.pill.plum{background:#eee5f2;color:#4a3157}.pill.gold{background:var(--gold2);color:#6f4f12}.pill.dark{background:var(--ox3);color:#fff}
/* schools */
.school{display:flex;gap:14px;align-items:center;padding:18px;text-decoration:none;color:var(--text);border-left:5px solid var(--c);transition:transform .15s}.school:hover{transform:translateY(-2px)}
.school .ic{width:46px;height:46px;flex:none;border-radius:50%;display:grid;place-items:center;font-size:1.25rem;color:#fff;background:var(--c)}
.school b{display:block;color:var(--ink);line-height:1.25}.school:hover b{color:var(--ox)}.school small{color:var(--muted);font-size:.85rem}
/* programs */
.prog{display:flex;flex-direction:column;overflow:hidden;text-decoration:none;color:var(--text);transition:transform .15s,box-shadow .15s}.prog:hover{transform:translateY(-3px);color:var(--text)}
.prog .top{background:linear-gradient(135deg,var(--c),color-mix(in srgb,var(--c) 70%,#000));color:#fff;padding:20px 20px 18px;position:relative;overflow:hidden}
.prog .top::after{content:"";position:absolute;right:-30px;top:-30px;width:120px;height:120px;border-radius:50%;border:18px solid rgba(255,255,255,.1)}
.prog .top i{font-size:1.6rem}.prog .top .deg{position:absolute;right:16px;bottom:14px;font-size:.78rem;font-weight:800;letter-spacing:.06em;background:rgba(255,255,255,.18);padding:3px 9px;border-radius:20px}
.prog .bd{padding:18px 20px 20px;display:flex;flex-direction:column;flex:1}.prog h3{font-family:"Newsreader",serif;font-size:1.35rem;font-weight:600;line-height:1.2}.prog:hover h3{color:var(--ox)}
.prog p{font-size:.92rem;color:var(--muted);margin:6px 0 12px}.prog .sch{margin-top:auto;font-size:.8rem;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
.prow{display:flex;gap:16px;align-items:center;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.prow:first-child{border-top:0}.prow:hover{background:#fcfaf6}
.prow .ic{width:44px;height:44px;flex:none;border-radius:12px;display:grid;place-items:center;font-size:1.2rem;color:#fff;background:var(--c)}.prow b{display:block;color:var(--ink);font-size:1.05rem}.prow:hover b{color:var(--ox);text-decoration:underline}.prow small{display:block;color:var(--muted);font-size:.88rem}.prow .go{margin-left:auto;color:var(--muted)}
/* filter bar */
.fbar{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;margin-bottom:22px;box-shadow:var(--sh)}
.fbar label{display:block;font-size:.76rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.fbar select,.fbar input{font:inherit;padding:10px 12px;border:2px solid var(--line);border-radius:9px;min-width:170px;background:#fff;color:var(--ink);min-height:46px}.fbar .grow{flex:1;min-width:200px}.fbar .grow input{width:100%}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.chips a{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:30px;border:1px solid var(--line);background:#fff;text-decoration:none;color:var(--ink);font-weight:600;font-size:.9rem}
.chips a:hover,.chips a[aria-current=true]{background:var(--ox);color:#fff;border-color:var(--ox)}
.count{color:var(--muted);margin:-6px 0 18px;font-size:.95rem}
/* faculty */
.fgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.fac{display:flex;gap:14px;padding:18px;text-decoration:none;color:var(--text);align-items:flex-start;transition:transform .15s,border-color .15s}.fac:hover{transform:translateY(-2px);border-color:var(--ox)}
.fac img{width:82px;height:82px;border-radius:50%;object-fit:cover;flex:none;border:3px solid #fff;box-shadow:0 4px 12px rgba(61,15,24,.18)}
.fac b{display:block;color:var(--ink);font-size:1.05rem;line-height:1.25}.fac:hover b{color:var(--ox)}.fac .meta{display:block;font-size:.87rem;color:var(--muted);margin-top:3px;line-height:1.4}.fac .pill{margin-top:8px}
.phero{display:grid;grid-template-columns:200px 1fr;gap:28px;align-items:center;padding:28px}.phero img{width:200px;height:200px;border-radius:20px;object-fit:cover}
/* events + news */
.ev{display:flex;gap:16px;padding:18px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text);align-items:flex-start}.ev:first-child{border-top:0}.ev:hover{background:#fcfaf6}
.ev h3{margin:6px 0 4px;font-size:1.04rem;line-height:1.35}.ev:hover h3{color:var(--ox)}.ev p{margin:0;font-size:.9rem;color:var(--muted)}
.date{width:66px;flex:none;text-align:center;border:2px solid var(--ox);border-radius:12px;overflow:hidden;background:#fff}.date span{display:block;background:var(--ox);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 0}
.date b{display:block;font-family:"Newsreader",serif;font-size:1.7rem;color:var(--ink);line-height:1.2;padding:4px 0 2px;font-weight:600}.date small{display:block;font-size:.68rem;color:var(--muted);padding-bottom:4px}
.ncard{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column;transition:transform .15s}.ncard:hover{transform:translateY(-3px);color:var(--text)}
.ncard .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.ncard .bd{padding:18px 20px 22px}.ncard h3{margin:8px 0 6px;line-height:1.3;font-size:1.08rem}.ncard:hover h3{color:var(--ox)}.ncard p{font-size:.92rem;color:var(--muted);margin:0}
.feat{display:grid;grid-template-columns:1.15fr 1fr;overflow:hidden;text-decoration:none;color:var(--text)}.feat .img{min-height:320px;background-size:cover;background-position:center}.feat .bd{padding:30px}
.feat h3{font-family:"Newsreader",serif;font-size:1.8rem;font-weight:600;margin:10px 0;line-height:1.2}.feat:hover h3{color:var(--ox)}
.nli{display:flex;gap:14px;padding:14px 0;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.nli:first-child{border-top:0;padding-top:0}.nli .th{width:96px;height:64px;flex:none;border-radius:10px;background-size:cover;background-position:center}.nli b{display:block;color:var(--ink);line-height:1.35;font-size:.98rem}.nli:hover b{color:var(--ox);text-decoration:underline}.nli small{color:var(--muted);font-size:.82rem}
/* campus map */
.cmap{position:relative;border-radius:20px;overflow:hidden;border:1px solid var(--line);box-shadow:var(--sh);background:#e8efe2}.cmap svg{display:block;width:100%;height:auto}
.pin{position:absolute;transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;text-decoration:none;z-index:2}
.pin span{background:var(--ox);color:#fff;font-size:.74rem;font-weight:700;padding:4px 9px;border-radius:20px;white-space:nowrap;box-shadow:0 6px 14px -6px rgba(0,0,0,.5)}.pin i{color:var(--ox);font-size:1.5rem;line-height:1;margin-top:-3px}
.pin.k-athletics span,.pin.k-residence span{background:#fff;color:var(--ox3);border:1px solid var(--line)}.pin:hover span,.pin:focus-visible span{background:var(--gold);color:var(--ink)}
.place{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column;transition:transform .15s}.place:hover{transform:translateY(-3px);color:var(--text)}
.place .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.place .bd{padding:16px 18px 20px}.place h3{margin:8px 0 4px;font-size:1.12rem}.place:hover h3{color:var(--ox)}.place p{margin:0;font-size:.9rem;color:var(--muted)}
/* athletics */
.band{background:linear-gradient(160deg,#1c3a30,#2f5d4e);color:#d8e9e1;position:relative;overflow:hidden}.band h2{color:#fff}.band .kicker{color:var(--gold)}.band .shead p{color:#bcd6ca}.band .more{color:#fff}
.band::after{content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;border:60px solid rgba(201,154,59,.12)}
.team{display:flex;flex-direction:column;gap:6px;padding:20px;text-decoration:none;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);border-radius:16px;color:#d8e9e1;position:relative;z-index:1}.team:hover{background:rgba(255,255,255,.13);color:#fff}
.team .ic{width:44px;height:44px;border-radius:12px;background:var(--gold);color:var(--ink);display:grid;place-items:center;font-size:1.25rem;margin-bottom:6px}.team b{color:#fff;font-size:1.1rem}.team small{font-size:.86rem}
.tcard{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column}.tcard .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.tcard .bd{padding:16px 18px 20px}.tcard h3{font-size:1.15rem;margin:8px 0 4px}.tcard:hover h3{color:var(--ox)}.tcard p{margin:0;font-size:.9rem;color:var(--muted)}
table.t{width:100%;border-collapse:collapse;font-size:.96rem}table.t caption{text-align:left;padding:18px 22px 8px;font-family:"Newsreader",serif;font-size:1.35rem;font-weight:600;color:var(--ink)}
table.t th,table.t td{padding:12px 22px;border-top:1px solid var(--line);text-align:left;vertical-align:top}table.t thead th{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);border-top:0;background:#fbf8f3}
table.t td.res{font-weight:700;color:var(--ink);white-space:nowrap}
/* page */
.phead{background:#fff;border-bottom:1px solid var(--line);padding:36px 0 32px;position:relative;overflow:hidden}.phead p{color:var(--muted);font-size:1.08rem;max-width:780px;margin:10px 0 0}
.phead.colored{background:linear-gradient(135deg,var(--c),color-mix(in srgb,var(--c) 65%,#000));border:0}.phead.colored h1,.phead.colored .crumbs,.phead.colored .crumbs a{color:#fff}.phead.colored p{color:rgba(255,255,255,.85)}.phead.colored .crumbs li+li::before{color:rgba(255,255,255,.6)}
.phead.colored::after{content:"";position:absolute;right:-60px;top:-60px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(255,255,255,.08)}
.crumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:.88rem;color:var(--muted);margin:0 0 12px;list-style:none;padding:0}.crumbs a{color:var(--ox)}.crumbs li+li::before{content:"/";margin-right:8px;color:#a59ca8}
.body{padding:38px 0 64px}.art{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.7fr);gap:28px;align-items:start}
.prose{font-size:1.05rem;line-height:1.72}.prose h2{font-size:1.45rem;margin:1.4em 0 .5em}.prose h2:first-child{margin-top:0}.prose ul,.prose ol{padding-left:1.3em}.prose li{margin:.35em 0}.prose a{font-weight:600}
.facts{display:grid;gap:0;margin:0}.facts>div{display:grid;grid-template-columns:120px 1fr;gap:10px;padding:10px 0;border-top:1px solid var(--line)}.facts>div:first-child{border-top:0;padding-top:0}
.facts dt{font-size:.76rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding-top:2px}.facts dd{margin:0;color:var(--ink);font-weight:600}
.ticks{list-style:none;margin:0;padding:0}.ticks li{position:relative;padding:8px 0 8px 30px;border-top:1px solid var(--line)}.ticks li:first-child{border-top:0}.ticks li::before{content:"\F26A";font-family:bootstrap-icons;position:absolute;left:0;top:8px;color:var(--green);font-size:1.05rem}
.cta{background:linear-gradient(160deg,#4a1220,#6d1f2b);color:#f1dfe2;border-radius:16px;padding:26px;position:relative;overflow:hidden}.cta h2,.cta h3{color:#fff}.cta p{color:#ecd2d6}
.cta::after{content:"";position:absolute;right:-50px;bottom:-50px;width:170px;height:170px;border-radius:50%;border:28px solid rgba(201,154,59,.22);pointer-events:none}.cta .btn{position:relative;z-index:1}
.disc{font-size:.85rem;color:var(--muted);border-left:4px solid var(--gold);background:#fff;padding:12px 16px;border-radius:0 10px 10px 0;margin:18px 0 0}
.hours{white-space:pre-line}
.svc{display:flex;gap:14px;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text);align-items:flex-start}.svc:first-child{border-top:0}.svc:hover{background:#fcfaf6}
.svc .ic{width:42px;height:42px;flex:none;border-radius:11px;display:grid;place-items:center;font-size:1.15rem;background:var(--gold2);color:var(--ox)}.svc b{display:block;color:var(--ink)}.svc:hover b{color:var(--ox);text-decoration:underline}.svc small{display:block;color:var(--muted);font-size:.87rem;margin-top:2px}
.svc.locked .ic{background:#efe9f2;color:var(--plum)}
.lock{background:linear-gradient(150deg,#3d0f18,#6d1f2b);color:#f1dfe2;border-radius:18px;padding:44px;position:relative;overflow:hidden}.lock h2{color:#fff;margin:14px 0 10px}
.lock .ic{width:58px;height:58px;border-radius:16px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:1.65rem;color:var(--gold)}
.lock::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(201,154,59,.16)}
.member{display:flex;gap:14px;align-items:center;background:var(--gold2);border:1px solid #ead9b2;border-radius:14px;padding:16px 20px}
.qt{display:grid;grid-template-columns:120px 1fr;gap:28px;align-items:center}.qt img{width:120px;height:120px;border-radius:50%}
.qt blockquote{margin:0;font-family:"Newsreader",serif;font-size:clamp(1.35rem,2.2vw,1.8rem);line-height:1.35;color:var(--ink);font-weight:500}.qt cite{display:block;margin-top:12px;font-style:normal;color:var(--muted);font-size:.95rem}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stats>div{padding:22px;border-left:4px solid var(--gold);background:#fff;border-radius:0 12px 12px 0;box-shadow:var(--sh)}
.stats b{display:block;font-family:"Newsreader",serif;font-size:2.3rem;color:var(--ox);line-height:1.1;font-weight:600}.stats span{color:var(--muted);font-size:.92rem}
.steps{counter-reset:s;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.steps>div{padding:24px}.steps>div::before{counter-increment:s;content:counter(s);width:40px;height:40px;border-radius:50%;background:var(--ox);color:#fff;font-weight:800;display:grid;place-items:center;margin-bottom:12px}
.tl{position:relative;padding-left:28px;border-left:3px solid var(--gold);margin-left:8px}.tl>div{position:relative;padding:0 0 22px}.tl>div::before{content:"";position:absolute;left:-38px;top:4px;width:17px;height:17px;border-radius:50%;background:#fff;border:4px solid var(--ox)}
.tl b{font-family:"Newsreader",serif;font-size:1.3rem;color:var(--ox);font-weight:600}.tl h3{margin:2px 0 4px}.tl p{margin:0;color:var(--muted)}
.faq details{border-top:1px solid var(--line);padding:14px 0}.faq details:first-of-type{border-top:0}.faq summary{cursor:pointer;font-weight:700;color:var(--ink)}.faq p{margin:10px 0 0;color:var(--muted)}
/* footer */
.foot{background:#2a0a12;color:#d9c3c7;padding:58px 0 26px}.foot a{color:#fff;text-decoration:none}.foot a:hover{text-decoration:underline}
.foot h2{color:#fff;font-family:"Public Sans",sans-serif;font-size:.84rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin:0 0 12px}.foot ul{list-style:none;margin:0;padding:0}.foot li{margin:0 0 8px;font-size:.95rem}
.fcols{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:28px}.fbot{margin-top:36px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);font-size:.86rem;color:#bfa4a9}
@media (max-width:1140px){.nav a{padding:10px 8px;font-size:.9rem}.hacts .btn-o{display:none}}
@media (max-width:980px){
.hdr .wrap{height:72px}.nav{display:none}.hdr.open .nav{display:flex;flex-direction:column;position:absolute;left:0;right:0;top:72px;background:#fff;border-bottom:1px solid var(--line);padding:12px 28px 18px;box-shadow:var(--sh)}.hdr.open .nav .mob{display:list-item}.nav a{padding:13px 10px;font-size:1rem}
.tog{display:inline-flex}.hacts .btn-p{display:none}.hgrid,.split,.art,.feat,.phero,.qt{grid-template-columns:1fr}.tgrid,.g3,.g4,.fgrid,.stats,.fcols{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr}.hero{padding-bottom:150px}.tasks{margin-top:-50px}}
@media (max-width:640px){body{font-size:16px}.wrap{padding:0 16px}.ubar .r{display:none}.brand b{font-size:1.25rem}.brand .crest{width:40px;height:44px}.brand small{font-size:.62rem}.hacts .btn-g{padding:9px 12px;font-size:.86rem}
.hero{padding:40px 0 120px}.hero .skyline{height:150px}.tgrid,.g2,.g3,.g4,.fgrid,.stats,.fcols{grid-template-columns:1fr}.finder select{width:100%}.task{padding:15px}.phero{text-align:center}.phero img{margin:0 auto;width:150px;height:150px}.fac img{width:66px;height:66px}
.pin span{display:none}.lock{padding:28px}table.t th,table.t td{padding:10px 12px}.glance .gs b{font-size:1.7rem}.qt img{width:90px;height:90px}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{%- assign path = Target.RoutePath | default: "" -%}{%- assign seg = path | split: "/" | first -%}
{%- if seg == "faculty" -%}{%- assign seg = "programs" -%}{%- endif -%}
<div class="ubar"><div class="wrap"><span><span class="fict">Fictional</span>Larkmoor College is a made-up college for a Raytha example site. People and places are invented.</span><span class="r"><a href="{{ PathBase }}/faculty"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Directory</a><a href="{{ PathBase }}/events"><i class="bi bi-calendar3" aria-hidden="true"></i> Calendar</a><a href="{{ PathBase }}/resources"><i class="bi bi-journal-text" aria-hidden="true"></i> Resources</a><a href="{{ PathBase }}/search"><i class="bi bi-search" aria-hidden="true"></i> Search</a></span></div></div>
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="brand" href="{{ PathBase }}/" aria-label="Larkmoor College home"><svg class="crest" viewBox="0 0 48 52" aria-hidden="true"><path d="M4 3h40v21c0 13.5-9.2 22.6-20 26.6C13.2 46.6 4 37.5 4 24z" fill="#6d1f2b"/><path d="M7.2 6.2h33.6v17.6c0 11.4-7.6 19.2-16.8 22.9C14.8 43 7.2 35.2 7.2 23.8z" fill="none" stroke="#c99a3b" stroke-width="1.4"/><path d="M11.5 20.5c4.2-1.7 8.4-1.7 12.5.6 4.1-2.3 8.3-2.3 12.5-.6v13.4c-4.2-1.7-8.4-1.7-12.5.6-4.1-2.3-8.3-2.3-12.5-.6z" fill="#f6ecd6"/><path d="M24 21.1v13.8" stroke="#6d1f2b" stroke-width="1.3"/><path d="M17.5 14.2q3.2-2.8 6.5 0q3.3-2.8 6.5 0" fill="none" stroke="#c99a3b" stroke-width="1.7" stroke-linecap="round"/></svg><span><b>Larkmoor College</b><small>Est. 1891 &middot; On the Calder River</small></span></a>
    <nav aria-label="Main"><ul class="nav" id="nav">
      {%- assign menu = get_main_menu() %}
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}"{% if u == seg and u != "" %} aria-current="page"{% endif %}>{{ mi.Label }}</a></li>
      {%- endfor %}
      <li class="mob"><a href="{{ PathBase }}/portal"><i class="bi bi-shield-lock" aria-hidden="true"></i> Student and faculty portal</a></li>
      <li class="mob"><a href="{{ PathBase }}/faculty"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Faculty directory</a></li>
      <li class="mob"><a href="{{ PathBase }}/search"><i class="bi bi-search" aria-hidden="true"></i> Search</a></li>
    </ul></nav>
    <div class="hacts"><a class="btn btn-o" href="{{ PathBase }}/portal"><i class="bi bi-shield-lock" aria-hidden="true"></i> Portal</a><a class="btn btn-p" href="{{ PathBase }}/admissions#visit"><i class="bi bi-signpost-2" aria-hidden="true"></i> Plan a visit</a>
      <button class="tog" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu" onclick="var h=document.getElementById('hdr');var o=h.classList.toggle('open');this.setAttribute('aria-expanded',o)"><i class="bi bi-list" aria-hidden="true"></i></button></div>
  </div>
</header>
<main id="main" tabindex="-1">{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <div class="fcols">
      <div><a class="brand" href="{{ PathBase }}/" style="color:#fff;margin-bottom:16px"><svg class="crest" viewBox="0 0 48 52" aria-hidden="true"><path d="M4 3h40v21c0 13.5-9.2 22.6-20 26.6C13.2 46.6 4 37.5 4 24z" fill="#6d1f2b"/><path d="M7.2 6.2h33.6v17.6c0 11.4-7.6 19.2-16.8 22.9C14.8 43 7.2 35.2 7.2 23.8z" fill="none" stroke="#c99a3b" stroke-width="1.4"/><path d="M11.5 20.5c4.2-1.7 8.4-1.7 12.5.6 4.1-2.3 8.3-2.3 12.5-.6v13.4c-4.2-1.7-8.4-1.7-12.5.6-4.1-2.3-8.3-2.3-12.5-.6z" fill="#f6ecd6"/><path d="M24 21.1v13.8" stroke="#6d1f2b" stroke-width="1.3"/><path d="M17.5 14.2q3.2-2.8 6.5 0q3.3-2.8 6.5 0" fill="none" stroke="#c99a3b" stroke-width="1.7" stroke-linecap="round"/></svg><span><b style="color:#fff">Larkmoor College</b><small style="color:#c9a8ae">Est. 1891 &middot; On the Calder River</small></span></a>
        <p style="font-size:.94rem;margin:0">1 Thornbury Quad, Larkmoor<br>Main: (555) 014-2000 &middot; Admissions: (555) 014-2100</p>
        <p style="font-size:.94rem;margin:12px 0 0"><a href="mailto:hello@larkmoor.example">hello@larkmoor.example</a></p></div>
      <div><h2>Academics</h2><ul><li><a href="{{ PathBase }}/programs">Programs</a></li><li><a href="{{ PathBase }}/faculty">Faculty directory</a></li><li><a href="{{ PathBase }}/resources">Resources</a></li><li><a href="{{ PathBase }}/search">Search</a></li></ul></div>
      <div><h2>Campus</h2><ul><li><a href="{{ PathBase }}/campus">Campus life and map</a></li><li><a href="{{ PathBase }}/athletics">Athletics</a></li><li><a href="{{ PathBase }}/events">Events</a></li><li><a href="{{ PathBase }}/news">News</a></li></ul></div>
      <div><h2>College</h2><ul>{% assign fm = get_menu("footer") %}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
    </div>
    <div class="fbot"><p style="margin:0 0 8px;color:#e2cdd1">Larkmoor College is fictional and is not a real college or university. Its students, faculty, buildings and teams are invented, and this site does not take applications or payments.</p><span>&copy; 2026 Larkmoor College (fictional). Built with <a href="https://raytha.com" style="text-decoration:underline">Raytha</a>.</span></div>
  </div>
</footer>
<script>
document.addEventListener('keydown',function(e){if(e.key==='Escape'){var h=document.getElementById('hdr');if(h&&h.classList.contains('open')){h.classList.remove('open');var t=h.querySelector('.tog');t.setAttribute('aria-expanded','false');t.focus()}}});
</script>
</body>
</html>
