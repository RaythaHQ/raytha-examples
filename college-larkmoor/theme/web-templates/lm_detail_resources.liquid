{%- assign schs = "arts:Arts and Humanities:#7a2433:book,sciences:Natural Sciences:#2f5d4e:tree,social:Social Sciences:#3b4f6b:people,business:Business and Economics:#8a6420:graph-up,computing:Engineering and Computing:#1f6470:cpu,health:Health and Education:#5b3b66:heart-pulse" | split: "," -%}{%- assign degs = "ba:B.A.,bs:B.S.,bfa:B.F.A.,ms:M.S.,minor:Minor,cert:Certificate" | split: "," -%}{%- assign pks = "academic:Academic building:building,library:Library:book,residence:Residence hall:house-door,dining:Dining:cup-hot,arts:Arts venue:music-note-beamed,athletics:Athletics:trophy,student:Student life:heart" | split: "," -%}{%- assign ncs = "campus:Campus:ox,research:Research:green,students:Student life:slate,arts:Arts:plum,athletics:Athletics:gold,alumni:Alumni:ox" | split: "," -%}{%- assign eks = "lecture:Lecture:mic,arts:Arts and performance:music-note-beamed,admissions:Admissions visit:signpost-2,athletics:Athletics:trophy,campus:Campus life:people,alumni:Alumni:stars" | split: "," -%}{%- assign ses = "fall:Fall,winter:Winter,spring:Spring" | split: "," -%}{%- assign aus = "public:Everyone:globe,students:Students and faculty:mortarboard,faculty:Faculty and staff only:shield-lock" | split: "," -%}{%- assign rks = "calendar:Calendar:calendar3,advising:Advising:compass,technology:Technology:laptop,wellbeing:Health and wellbeing:heart-pulse,policy:Policy:journal-text,library:Library:book,teaching:Teaching:easel,safety:Safety:shield-check" | split: "," -%}{%- assign is_member = false -%}{%- assign is_faculty = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "students" or g == "faculty" -%}{%- assign is_member = true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign is_faculty = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- assign is_faculty = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{%- capture ak -%}{{ p.audience }}{%- endcapture -%}{%- capture rk -%}{{ p.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- assign ri = kv[2] -%}{%- endif -%}{%- endfor -%}{%- for pair in aus -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ak -%}{%- assign al = kv[1] -%}{%- assign ai = kv[2] -%}{%- endif -%}{%- endfor -%}
{%- assign allowed = true -%}{%- if ak == "students" and is_member == false -%}{%- assign allowed = false -%}{%- endif -%}{%- if ak == "faculty" and is_faculty == false -%}{%- assign allowed = false -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/{% if ak == "public" %}resources{% else %}portal{% endif %}">{% if ak == "public" %}Resources{% else %}Portal{% endif %}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap"><span class="pill gold"><i class="bi bi-{{ ri }}" aria-hidden="true"></i> {{ rl }}</span>{% if ak != "public" %}<span class="pill plum"><i class="bi bi-{{ ai }}" aria-hidden="true"></i> {{ al }}</span>{% endif %}</div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap">{% if allowed == false %}{% if ak == "faculty" and is_member %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This resource is for faculty and staff.</h2><p style="max-width:620px">You are signed in, but your account is in the students group. Faculty materials are limited to the faculty and staff group.</p><div style="margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/portal">Back to the portal</a></div></div>{% else %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>{% if ak == "faculty" %}This resource is for faculty and staff.{% else %}This resource is for students and faculty.{% endif %}</h2><p style="max-width:620px">Sign in to the Larkmoor portal to see it. This is a website account for the portal, not the student records system or email.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the college</a></div></div>{% endif %}{% else %}<div class="art">
  <article class="card pad prose" style="padding:32px">{{ p.body }}{% if p.file %}<p style="margin-top:20px"><a class="btn btn-p" style="text-decoration:none" href="{{ p.file.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download the PDF</a></p>{% endif %}</article>
  <aside class="grid" style="gap:20px"><div class="card pad"><dl class="facts"><div><dt>Kind</dt><dd>{{ rl }}</dd></div><div><dt>Posted</dt><dd>{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></div><div><dt>Who can see it</dt><dd>{{ al }}</dd></div></dl></div>
  <p><a href="{{ PathBase }}/{% if ak == "public" %}resources{% else %}portal{% endif %}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a></p></aside></div>{% endif %}
</div></div>
