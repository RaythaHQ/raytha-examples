{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li>Client desk</li></ol><p class="kick">Client desk · buyers</p><h1>{% if in_cl %}Hello, {{ CurrentUser.FirstName }}.{% else %}Client desk{% endif %}</h1><p class="lede">{% if in_cl %}Your shortlist, this weekend's tours, and the private market notes Priya leaves for signed-in buyers. Demo account: names and figures are fictional.{% else %}Showing notes and a shortlist, for signed-in buyer clients.{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_cl %}<div class="badge"><div class="t">GABLEFEN REALTY · BUYER CLIENT</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">DEMO ACCOUNT · THIS WEEKEND: FERRY GREEN AT 1:00, THEN MILLRACE ROW AT 3:15</div></div>{%- assign sh = get_content_items(ContentType="showings", Filter="audience eq 'clients'", OrderBy="sort_order asc", PageSize=10) -%}{%- assign nb = get_content_items(ContentType="bulletins", Filter="audience eq 'clients'", OrderBy="sort_order asc", PageSize=10) -%}<div class="dg"><div><h2>Your tours</h2>{% for p in sh.Items %}{%- assign y=p.PublishedContent -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b><p>{{ y.date_label }} · {{ y.time_label }} · {{ y.listing_name }}</p></a>{% endfor %}<h2 style="margin-top:32px">Notes for buyers</h2>{% for p in nb.Items %}{%- assign y=p.PublishedContent -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b><p>{{ y.summary }}</p></a>{% endfor %}</div><aside class="card side"><p class="kick">This weekend</p><p>19 Ferry Green at 1:00 pm, then 14 Millrace Row at 3:15 with Ned. Call Priya at (555) 014-1862 if you need to shift either time.</p><p class="muted" style="margin-bottom:0">The office does not take offers through this site. When you are ready, we write them on paper or by email at the office.</p></aside></div>{% else %}<div class="lockp"><p class="kick">🔒 Client desk</p><h2>Sign in to see your shortlist and showing notes.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the office opens a client account after a first meeting, and the broker opens accounts for agents.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/clients">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the firm</a></p></div>{% endif %}</div></section>
