{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li>Bulletins</li></ol><p class="kick">From the office</p><h1>Market notes and desk papers</h1><p class="lede">Public notes are for everyone. Notes for buyer clients and for agents are listed by title, but their contents stay on the server unless you are signed in to the right desk.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cl == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "agents" and in_ag == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b> {% if au == "clients" %}<span class="tg">🔒 Clients</span>{% elsif au == "agents" %}<span class="tg">🔒 Agents</span>{% endif %}<p>{% if ok %}{{ y.summary }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}</div></section>
