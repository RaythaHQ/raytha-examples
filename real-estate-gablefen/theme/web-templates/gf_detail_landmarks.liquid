{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li><a href="{{ PathBase }}/town">Landmarks</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv29 -%}{{ x.kind }}{%- endcapture %}{% case lv29 %}{% when "mill" %}Mill{% when "bridge" %}Bridge{% when "office" %}Office{% when "school" %}School{% when "ferry" %}Ferry landing{% when "park" %}Green{% when "civic" %}Civic{% else %}{{ lv29 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><div class="mapcard"><svg class="plat" viewBox="0 0 1200 760" role="img" aria-label="Town plat of Gablefen">{%- assign hoods = get_content_items(ContentType="neighborhoods", OrderBy="sort_order asc", PageSize=10) -%}{%- assign homes = get_content_items(ContentType="listings", OrderBy="sort_order asc", PageSize=40) -%}{%- assign marks = get_content_items(ContentType="landmarks", OrderBy="sort_order asc", PageSize=20) -%}<rect width="1200" height="760" fill="#f3ead8"/><path d="M0,200 C80,240 120,320 80,420 C40,520 40,620 120,700 L0,760 L0,200Z" fill="#c5d4c8"/><path d="M0,300 C90,280 150,340 130,430 C110,530 60,600 40,760 L0,760 L0,520Z" fill="#8aa4b0"/><path d="M40,250 C90,240 130,260 140,300 C150,340 120,360 80,350 C50,342 30,300 40,250Z" fill="#6e8b96"/><rect x="100" y="200" width="86" height="70" fill="#7a4a3c" stroke="#2c261e" stroke-width="1.5"/><rect x="100" y="188" width="86" height="14" fill="#3f332c"/><rect x="170" y="160" width="8" height="40" fill="#3f332c"/><rect x="560" y="320" width="110" height="80" fill="#c5d0b8" stroke="#5a6a58"/><rect x="590" y="335" width="50" height="50" fill="#d9cbb3" stroke="#2c261e"/><g fill="none" stroke="#d2c4a8" stroke-width="10"><path d="M360,40 V520"/><path d="M500,40 V560"/><path d="M760,20 V560"/><path d="M40,200 H400"/><path d="M200,80 H820"/><path d="M380,260 H800"/><path d="M80,430 C240,400 500,430 800,400"/><path d="M80,540 H500"/><path d="M800,60 C900,80 1100,60 1180,140"/></g><path d="M220,300 C250,310 270,330 250,350" fill="none" stroke="#5a4033" stroke-width="4"/><text x="30" y="740" font-family="IBM Plex Mono" font-size="11" fill="#5c564c">FENWATER</text><text x="20" y="20" font-family="IBM Plex Mono" font-size="11" fill="#5c564c">N ↑</text><rect x="1080" y="700" width="80" height="3" fill="#2c261e"/><text x="1080" y="720" font-family="IBM Plex Mono" font-size="10" fill="#5c564c">¼ mile</text>{% for h in hoods.Items %}{%- assign y=h.PublishedContent -%}{%- capture hc -%}{{ y.code }}{%- endcapture -%}{% case hc %}{% when "millreach" %}{%- assign hcol = "#8b3a32" -%}{% when "westcommon" %}{%- assign hcol = "#3d5c55" -%}{% when "ridge" %}{%- assign hcol = "#2f4a58" -%}{% when "ferry" %}{%- assign hcol = "#9a7b3c" -%}{% when "square" %}{%- assign hcol = "#6e2e28" -%}{% else %}{%- assign hcol = "#8b3a32" -%}{% endcase %}<path d="{{ y.patch }}" fill="{{ hcol }}" opacity=".18" stroke="{{ hcol }}" stroke-width="2"/><text x="{{ y.label_x }}" y="{{ y.label_y }}" font-family="Newsreader,serif" font-size="22" fill="{{ hcol }}" font-weight="600">{{ h.PrimaryField }}</text>{% endfor %}{% for m in marks.Items %}{%- assign y=m.PublishedContent -%}<g transform="translate({{ y.x }},{{ y.y }})"><rect x="-6" y="-6" width="12" height="12" transform="rotate(45)" fill="#2c261e"/></g>{% endfor %}{% for p in homes.Items %}{%- assign y=p.PublishedContent -%}{%- assign ishl=false -%}{%- capture lst -%}{{ y.status }}{%- endcapture -%}{% case lst %}{% when "active" %}{%- assign pcol = "#2f4a58" -%}{% when "coming" %}{%- assign pcol = "#9a7b3c" -%}{% when "contract" %}{%- assign pcol = "#6e2e28" -%}{% when "sold" %}{%- assign pcol = "#5c564c" -%}{% else %}{%- assign pcol = "#2f4a58" -%}{% endcase %}<a href="{{ PathBase }}/{{ p.RoutePath }}" class="pin"><circle cx="{{ y.x }}" cy="{{ y.y }}" r="{% if ishl %}16{% elsif lst == "sold" %}8{% else %}11{% endif %}" fill="{{ pcol }}" stroke="#fbf7ef" stroke-width="{% if ishl %}4{% else %}2{% endif %}"/><text x="{{ y.x }}" y="{%- capture _py -%}{{ y.y }}{%- endcapture -%}{{ _py | plus: 4 }}" text-anchor="middle" font-family="IBM Plex Mono" font-size="9" fill="#fbf7ef">{{ y.street_no }}</text></a>{% endfor %}</svg></div></div></div></section>
