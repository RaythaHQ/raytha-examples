{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li><a href="{{ PathBase }}/agents">Agents</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ x.title }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose">{{ x.body }}<h2 style="margin-top:28px">Listings with this agent</h2>{%- capture af -%}agent eq '{{ Target.PrimaryField | remove: "'" }}'{%- endcapture -%}{%- assign hs = get_content_items(ContentType="listings", Filter=af, OrderBy="sort_order asc", PageSize=20) -%}{% if hs.TotalCount > 0 %}<div class="board">{% for p in hs.Items %}{%- assign y=p.PublishedContent -%}{%- capture lst -%}{{ y.status }}{%- endcapture -%}{%- capture ldt -%}{{ y.listed_date }}{%- endcapture -%}{%- assign ly = ldt | slice: 0,4 | plus: 0 -%}{%- assign lm = ldt | slice: 5,2 | plus: 0 -%}{%- assign ld = ldt | slice: 8,2 | plus: 0 -%}{%- assign domk = nowy | minus: ly | times: 365 -%}{%- assign domk = mon | minus: lm | times: 30 | plus: domk -%}{%- assign domk = dom | minus: ld | plus: domk -%}{% if domk < 0 %}{%- assign domk = 0 -%}{% endif %}{%- assign isnew = false -%}{% if domk <= 14 %}{%- assign isnew = true -%}{% endif %}<a class="lcard" href="{{ PathBase }}/{{ p.RoutePath }}">{%- capture hst -%}{{ y.style }}{%- endcapture -%}{%- capture sid -%}{{ y.siding_hex }}{%- endcapture -%}{%- capture rf -%}{{ y.roof_hex }}{%- endcapture -%}{%- capture hrf -%}{{ y.roof }}{%- endcapture -%}{%- capture hsto -%}{{ y.stories }}{%- endcapture -%}<svg class="elev" viewBox="0 0 200 170" role="img" aria-label="Elevation of {{ p.PrimaryField }}"><rect width="200" height="170" fill="#efe8db"/><rect x="0" y="148" width="200" height="22" fill="#d7ccb8"/><line x1="0" y1="148" x2="200" y2="148" stroke="#c4b69a" stroke-width="1"/>{% case hst %}{% when "bungalow" %}<polygon points="22,92 100,58 178,92" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="36" y="92" width="128" height="56" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="36" y="118" width="128" height="30" fill="none" stroke="#2c261e" stroke-width="1.1"/><rect x="36" y="118" width="128" height="4" fill="#c4a574"/><rect x="44" y="118" width="5" height="30" fill="#5a4033"/><rect x="151" y="118" width="5" height="30" fill="#5a4033"/><rect x="90" y="112" width="20" height="36" fill="#3a2c22" stroke="#2c261e"/><rect x="52" y="100" width="26" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="100" width="26" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "foursquare" %}<polygon points="48,58 100,28 152,58 152,68 48,68" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="52" y="66" width="96" height="82" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="52" y="118" width="96" height="30" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="52" y="118" width="96" height="4" fill="#c4a574"/><rect x="60" y="118" width="5" height="30" fill="#5a4033"/><rect x="135" y="118" width="5" height="30" fill="#5a4033"/><rect x="90" y="122" width="20" height="26" fill="#3a2c22"/><rect x="64" y="78" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="114" y="78" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="64" y="100" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="114" y="100" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "millcottage" %}{% if hsto == "2" %}<polygon points="40,70 100,36 160,70" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="48" y="70" width="104" height="78" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="56" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="88" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="120" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="56" y="110" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="120" y="110" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="114" width="16" height="34" fill="#3a2c22"/>{% else %}<polygon points="62,86 100,26 138,86" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="70" y="84" width="60" height="64" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="88" y="44" width="24" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="76" y="96" width="16" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="108" y="96" width="16" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="116" width="16" height="32" fill="#3a2c22"/>{% endif %}{% when "townhouse" %}<rect x="66" y="22" width="68" height="126" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.2"/><rect x="62" y="18" width="76" height="10" fill="{{ rf }}" stroke="#2c261e"/><rect x="70" y="36" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="36" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="70" y="64" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="64" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="70" y="92" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="92" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="116" width="16" height="32" fill="#3a2c22"/><polygon points="88,148 100,138 112,148" fill="#c4b69a" stroke="#2c261e"/>{% when "farmhouse" %}<polygon points="30,70 100,22 170,70" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="44" y="70" width="112" height="78" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="44" y="118" width="80" height="30" fill="none" stroke="#2c261e"/><rect x="44" y="118" width="80" height="4" fill="#c4a574"/><rect x="52" y="118" width="5" height="30" fill="#5a4033"/><rect x="112" y="118" width="5" height="30" fill="#5a4033"/><rect x="86" y="112" width="18" height="36" fill="#3a2c22"/><rect x="56" y="82" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="82" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="56" y="104" width="18" height="12" fill="#d7e4ea" stroke="#2c261e"/>{% when "cape" %}<polygon points="28,96 100,28 172,96" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="40" y="96" width="120" height="52" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="60" y="52" width="22" height="28" fill="{{ sid }}" stroke="#2c261e"/><polygon points="60,52 71,40 82,52" fill="{{ rf }}" stroke="#2c261e"/><rect x="118" y="52" width="22" height="28" fill="{{ sid }}" stroke="#2c261e"/><polygon points="118,52 129,40 140,52" fill="{{ rf }}" stroke="#2c261e"/><rect x="64" y="58" width="14" height="14" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="58" width="14" height="14" fill="#d7e4ea" stroke="#2c261e"/><rect x="91" y="112" width="18" height="36" fill="#3a2c22"/><rect x="52" y="108" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="126" y="108" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "midcentury" %}<polygon points="12,100 150,78 188,100 188,108 12,108" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.1"/><rect x="16" y="108" width="128" height="40" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="148" y="108" width="36" height="40" fill="none" stroke="#2c261e" stroke-width="1.1"/><rect x="154" y="114" width="8" height="34" fill="#5a4033"/><rect x="170" y="114" width="8" height="34" fill="#5a4033"/><rect x="24" y="116" width="72" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="104" y="118" width="16" height="30" fill="#3a2c22"/>{% else %}<rect x="50" y="70" width="100" height="78" fill="{{ sid }}" stroke="#2c261e"/><polygon points="46,70 100,30 154,70" fill="{{ rf }}" stroke="#2c261e"/>{% endcase %}</svg><div class="b"><span class="st {{ lst }}">{% capture lv18 -%}{{ y.status }}{%- endcapture %}{% case lv18 %}{% when "active" %}For sale{% when "coming" %}Coming soon{% when "contract" %}Under contract{% when "sold" %}Sold{% else %}{{ lv18 }}{% endcase %}{% if isnew and lst == "active" %} · New{% endif %}</span><h3>{{ p.PrimaryField }}</h3>{%- capture _nspd -%}{{ y.sold_price }}{%- endcapture -%}{%- assign spd = _nspd | plus: 0 -%}{%- capture _nprx -%}{{ y.price }}{%- endcapture -%}{%- assign prx = _nprx | plus: 0 -%}{%- capture _nsqx -%}{{ y.sqft }}{%- endcapture -%}{%- assign sqx = _nsqx | plus: 0 -%}<div class="pr">{% if lst == "sold" and spd > 0 %}${{ spd | format_number: "N0" }} <small>sold</small>{% else %}${{ prx | format_number: "N0" }}{% endif %}</div><small>{{ y.beds }} bd · {{ y.baths }} ba · {{ sqx | format_number: "N0" }} sq ft · {% capture lv19 -%}{{ y.neighborhood }}{%- endcapture %}{% case lv19 %}{% when "millreach" %}Mill Reach{% when "westcommon" %}West Common{% when "ridge" %}Ridge Lane{% when "ferry" %}Ferry Green{% when "square" %}Courthouse Square{% else %}{{ lv19 }}{% endcase %}</small></div></a>{% endfor %}</div>{% else %}<p class="muted">No current listings under this name.</p>{% endif %}</div><aside class="card side"><div class="ini" style="--c:{{ x.accent }};margin-bottom:12px">{{ x.initials }}</div><dl class="kv"><dt>Title</dt><dd>{{ x.title }}</dd><dt>Phone</dt><dd>{{ x.phone }}</dd><dt>Email</dt><dd>{{ x.email }}</dd><dt>With the firm</dt><dd>{{ x.years }} years</dd><dt>Specialty</dt><dd>{{ x.specialty }}</dd></dl></aside></div></div></section>
