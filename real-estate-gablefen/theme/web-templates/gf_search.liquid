{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the office</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="foursquare, ferry, mill"><button class="btn">Search</button></form><p class="lede" style="margin-top:12px;font-size:1rem">Searches homes, neighborhoods, agents, open houses, house styles, landmarks and public notes. Members-only notes are listed by title; their contents stay hidden unless you are signed in.</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "listings:Homes:name:summary,neighborhoods:Neighborhoods:name:summary,agents:Agents:name:summary,open_houses:Open houses:title:notes,styles:House styles:name:summary,landmarks:Landmarks:name:summary,bulletins:Bulletins:title:summary,showings:Showings:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--frame)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "clients" %} <span class="tg">🔒 Clients</span>{% elsif au == "agents" %} <span class="tg">🔒 Agents</span>{% endif %}{% if au == "clients" and in_cl == false %}<p>Sign in to read.</p>{% elsif au == "agents" and in_ag == false %}<p>Sign in to read.</p>{% else %}<p>{{ x.summary | default: x.notes | strip_html | truncate: 150 }}</p>{% endif %}</a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=foursquare">foursquare</a>, <a href="?q=ferry">ferry</a>, <a href="?q=mill">mill</a> or <a href="?q=bungalow">bungalow</a>.</p>{% endif %}</div></div></section>
