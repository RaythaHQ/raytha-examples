" %}Coming soon{% when "contract" %}Under contract{% when "sold" %}Sold{% else %}{{ lv10 }}{% endcase %}</span> {% if isnew and lst == "active" %}<span class="sbadge st-coming">New this fortnight</span>{% endif %} {% if lst != "coming" and lst != "sold" %}<span class="muted" style="font:500 .78rem 'IBM Plex Mono',monospace;margin-left:8px">{{ domk }} days on the market</span>{% endif %}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div><div class="mapcard" style="margin-bottom:22px">{%- capture hst -%}{{ x.style }}{%- endcapture -%}{%- capture sid -%}{{ x.siding_hex }}{%- endcapture -%}{%- capture rf -%}{{ x.roof_hex }}{%- endcapture -%}{%- capture hrf -%}{{ x.roof }}{%- endcapture -%}{%- capture hsto -%}{{ x.stories }}{%- endcapture -%}<svg class="elev" viewBox="0 0 200 170" role="img" aria-label="Elevation of {{ Target.PrimaryField }}"><rect width="200" height="170" fill="#efe8db"/><rect x="0" y="148" width="200" height="22" fill="#d7ccb8"/><line x1="0" y1="148" x2="200" y2="148" stroke="#c4b69a" stroke-width="1"/>{% case hst %}{% when "bungalow" %}<polygon points="22,92 100,58 178,92" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="36" y="92" width="128" height="56" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="36" y="118" width="128" height="30" fill="none" stroke="#2c261e" stroke-width="1.1"/><rect x="36" y="118" width="128" height="4" fill="#c4a574"/><rect x="44" y="118" width="5" height="30" fill="#5a4033"/><rect x="151" y="118" width="5" height="30" fill="#5a4033"/><rect x="90" y="112" width="20" height="36" fill="#3a2c22" stroke="#2c261e"/><rect x="52" y="100" width="26" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="100" width="26" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "foursquare" %}<polygon points="48,58 100,28 152,58 152,68 48,68" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="52" y="66" width="96" height="82" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="52" y="118" width="96" height="30" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="52" y="118" width="96" height="4" fill="#c4a574"/><rect x="60" y="118" width="5" height="30" fill="#5a4033"/><rect x="135" y="118" width="5" height="30" fill="#5a4033"/><rect x="90" y="122" width="20" height="26" fill="#3a2c22"/><rect x="64" y="78" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="114" y="78" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="64" y="100" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="114" y="100" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "millcottage" %}{% if hsto == "2" %}<polygon points="40,70 100,36 160,70" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="48" y="70" width="104" height="78" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="56" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="88" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="120" y="80" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="56" y="110" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="120" y="110" width="24" height="22" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="114" width="16" height="34" fill="#3a2c22"/>{% else %}<polygon points="62,86 100,26 138,86" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="70" y="84" width="60" height="64" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="88" y="44" width="24" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="76" y="96" width="16" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="108" y="96" width="16" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="116" width="16" height="32" fill="#3a2c22"/>{% endif %}{% when "townhouse" %}<rect x="66" y="22" width="68" height="126" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.2"/><rect x="62" y="18" width="76" height="10" fill="{{ rf }}" stroke="#2c261e"/><rect x="70" y="36" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="36" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="70" y="64" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="64" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="70" y="92" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="112" y="92" width="18" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="92" y="116" width="16" height="32" fill="#3a2c22"/><polygon points="88,148 100,138 112,148" fill="#c4b69a" stroke="#2c261e"/>{% when "farmhouse" %}<polygon points="30,70 100,22 170,70" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="44" y="70" width="112" height="78" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="44" y="118" width="80" height="30" fill="none" stroke="#2c261e"/><rect x="44" y="118" width="80" height="4" fill="#c4a574"/><rect x="52" y="118" width="5" height="30" fill="#5a4033"/><rect x="112" y="118" width="5" height="30" fill="#5a4033"/><rect x="86" y="112" width="18" height="36" fill="#3a2c22"/><rect x="56" y="82" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="82" width="22" height="18" fill="#d7e4ea" stroke="#2c261e"/><rect x="56" y="104" width="18" height="12" fill="#d7e4ea" stroke="#2c261e"/>{% when "cape" %}<polygon points="28,96 100,28 172,96" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.2"/><rect x="40" y="96" width="120" height="52" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="60" y="52" width="22" height="28" fill="{{ sid }}" stroke="#2c261e"/><polygon points="60,52 71,40 82,52" fill="{{ rf }}" stroke="#2c261e"/><rect x="118" y="52" width="22" height="28" fill="{{ sid }}" stroke="#2c261e"/><polygon points="118,52 129,40 140,52" fill="{{ rf }}" stroke="#2c261e"/><rect x="64" y="58" width="14" height="14" fill="#d7e4ea" stroke="#2c261e"/><rect x="122" y="58" width="14" height="14" fill="#d7e4ea" stroke="#2c261e"/><rect x="91" y="112" width="18" height="36" fill="#3a2c22"/><rect x="52" y="108" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="126" y="108" width="22" height="16" fill="#d7e4ea" stroke="#2c261e"/>{% when "midcentury" %}<polygon points="12,100 150,78 188,100 188,108 12,108" fill="{{ rf }}" stroke="#2c261e" stroke-width="1.1"/><rect x="16" y="108" width="128" height="40" fill="{{ sid }}" stroke="#2c261e" stroke-width="1.1"/><rect x="148" y="108" width="36" height="40" fill="none" stroke="#2c261e" stroke-width="1.1"/><rect x="154" y="114" width="8" height="34" fill="#5a4033"/><rect x="170" y="114" width="8" height="34" fill="#5a4033"/><rect x="24" y="116" width="72" height="16" fill="#d7e4ea" stroke="#2c261e"/><rect x="104" y="118" width="16" height="30" fill="#3a2c22"/>{% else %}<rect x="50" y="70" width="100" height="78" fill="{{ sid }}" stroke="#2c261e"/><polygon points="46,70 100,30 154,70" fill="{{ rf }}" stroke="#2c261e"/>{% endcase %}</svg></div><div class="figs"><div><b>{%- capture pv1 -%}{{ x.price }}{%- endcapture -%}${{ pv1 | plus: 0 | format_number: "N0" }}</b><span>{% if lst == "sold" %}Listed at{% else %}List price{% endif %}</span></div>{%- capture _nxspd -%}{{ x.sold_price }}{%- endcapture -%}{%- assign xspd = _nxspd | plus: 0 -%}{% if lst == "sold" and xspd > 0 %}<div><b>${{ xspd | format_number: "N0" }}</b><span>Sold {{ x.sold_date }}</span></div>{% endif %}<div><b>{{ x.beds }} / {{ x.baths }}</b><span>Beds / baths</span></div>{%- capture _nxsq -%}{{ x.sqft }}{%- endcapture -%}{%- assign xsq = _nxsq | plus: 0 -%}<div><b>{{ xsq | format_number: "N0" }}</b><span>Interior sq ft</span></div><div><b>{{ x.year_built }}</b><span>Year built</span></div><div><b>{% capture lv11 -%}{{ x.style }}{%- endcapture %}{% case lv11 %}{% when "bungalow" %}Bungalow{% when "foursquare" %}American Foursquare{% when "millcottage" %}Mill cottage{% when "townhouse" %}Brick townhouse{% when "farmhouse" %}Farmhouse{% when "cape" %}Cape{% when "midcentury" %}Mid-century{% else %}{{ lv11 }}{% endcase %}</b><span>{% capture lv12 -%}{{ x.stories }}{%- endcapture %}{% case lv12 %}{% when "1" %}One story{% when "15" %}One and a half{% when "2" %}Two stories{% when "3" %}Three stories{% else %}{{ lv12 }}{% endcase %}</span></div></div><h2 style="margin-top:32px">Floor plan</h2><p class="muted">Drawn on the server from the rooms field stored with the listing.</p>{%- capture rmsraw -%}{{ x.rooms }}{%- endcapture -%}{%- assign rma = rmsraw | split: "|" -%}<div class="plan" role="img" aria-label="Floor plan from the rooms field">{% for fl in (1..3) %}{%- assign fls = fl | append: "" -%}{%- assign has = false -%}{%- assign tw = 0 -%}{% for rm in rma %}{%- assign bit = rm | split: ":" -%}{%- assign flr = bit[0] | strip -%}{% if flr == fls %}{%- assign has = true -%}{%- assign rest = bit[1] | default: rm | strip -%}{%- assign dim = rest | split: " " | last | split: "x" -%}{%- assign rw = dim[0] | plus: 0 -%}{% if rw < 1 %}{%- assign rw = 10 -%}{% endif %}{%- assign tw = tw | plus: rw -%}{% endif %}{% endfor %}{% if has %}<div class="fl"><span class="flab">Floor {{ fl }}</span><div class="frow">{% for rm in rma %}{%- assign bit = rm | split: ":" -%}{%- assign flr = bit[0] | strip -%}{% if flr == fls %}{%- assign rest = bit[1] | default: rm | strip -%}{%- assign rname = rest | split: " " | first -%}{%- assign dim = rest | split: " " | last | split: "x" -%}{%- assign rw = dim[0] | plus: 0 -%}{%- assign rh = dim[1] | plus: 0 -%}{% if rw < 1 %}{%- assign rw = 10 -%}{% endif %}{%- assign pct = rw | times: 100 | divided_by: tw -%}<div class="rm" style="width:{{ pct }}%"><b>{{ rname }}</b><small>{{ dim[0] }}×{{ dim[1] }}</small></div>{% endif %}{% endfor %}</div></div>{% endif %}{% endfor %}</div><div class="prose" style="margin-top:28px">{{ x.body }}</div>{%- capture _c0 -%}{{ x.amenities }}{%- endcapture -%}{% if _c0 != "" %}<h2 style="font-size:1.3rem;margin-top:26px">Features</h2>{%- assign am = x.amenities | split: "|" -%}<ul class="amen">{% for a in am %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}<h2 style="font-size:1.3rem;margin-top:30px">On the plat</h2><div class="mapcard"><svg class="plat" viewBox="0 0 1200 760" role="img" aria-label="Town plat of Gablefen">{%- assign hoods = get_content_items(ContentType="neighborhoods", OrderBy="sort_order asc", PageSize=10) -%}{%- assign homes = get_content_items(ContentType="listings", OrderBy="sort_order asc", PageSize=40) -%}{%- assign marks = get_content_items(ContentType="landmarks", OrderBy="sort_order asc", PageSize=20) -%}<rect width="1200" height="760" fill="#f3ead8"/><path d="M0,200 C80,240 120,320 80,420 C40,520 40,620 120,700 L0,760 L0,200Z" fill="#c5d4c8"/><path d="M0,300 C90,280 150,340 130,430 C110,530 60,600 40,760 L0,760 L0,520Z" fill="#8aa4b0"/><path d="M40,250 C90,240 130,260 140,300 C150,340 120,360 80,350 C50,342 30,300 40,250Z" fill="#6e8b96"/><rect x="100" y="200" width="86" height="70" fill="#7a4a3c" stroke="#2c261e" stroke-width="1.5"/><rect x="100" y="188" width="86" height="14" fill="#3f332c"/><rect x="170" y="160" width="8" height="40" fill="#3f332c"/><rect x="560" y="320" width="110" height="80" fill="#c5d0b8" stroke="#5a6a58"/><rect x="590" y="335" width="50" height="50" fill="#d9cbb3" stroke="#2c261e"/><g fill="none" stroke="#d2c4a8" stroke-width="10"><path d="M360,40 V520"/><path d="M500,40 V560"/><path d="M760,20 V560"/><path d="M40,200 H400"/><path d="M200,80 H820"/><path d="M380,260 H800"/><path d="M80,430 C240,400 500,430 800,400"/><path d="M80,540 H500"/><path d="M800,60 C900,80 1100,60 1180,140"/></g><path d="M220,300 C250,310 270,330 250,350" fill="none" stroke="#5a4033" stroke-width="4"/><text x="30" y="740" font-family="IBM Plex Mono" font-size="11" fill="#5c564c">FENWATER</text><text x="20" y="20" font-family="IBM Plex Mono" font-size="11" fill="#5c564c">N ↑</text><rect x="1080" y="700" width="80" height="3" fill="#2c261e"/><text x="1080" y="720" font-family="IBM Plex Mono" font-size="10" fill="#5c564c">¼ mile</text>{% for h in hoods.Items %}{%- assign y=h.PublishedContent -%}{%- capture hc -%}{{ y.code }}{%- endcapture -%}{% case hc %}{% when "millreach" %}{%- assign hcol = "#8b3a32" -%}{% when "westcommon" %}{%- assign hcol = "#3d5c55" -%}{% when "ridge" %}{%- assign hcol = "#2f4a58" -%}{% when "ferry" %}{%- assign hcol = "#9a7b3c" -%}{% when "square" %}{%- assign hcol = "#6e2e28" -%}{% else %}{%- assign hcol = "#8b3a32" -%}{% endcase %}<path d="{{ y.patch }}" fill="{{ hcol }}" opacity=".18" stroke="{{ hcol }}" stroke-width="2"/><text x="{{ y.label_x }}" y="{{ y.label_y }}" font-family="Newsreader,serif" font-size="22" fill="{{ hcol }}" font-weight="600">{{ h.PrimaryField }}</text>{% endfor %}{% for m in marks.Items %}{%- assign y=m.PublishedContent -%}<g transform="translate({{ y.x }},{{ y.y }})"><rect x="-6" y="-6" width="12" height="12" transform="rotate(45)" fill="#2c261e"/></g>{% endfor %}{% for p in homes.Items %}{%- assign y=p.PublishedContent -%}{%- assign ishl=false -%}{%- capture lst -%}{{ y.status }}{%- endcapture -%}{% case lst %}{% when "active" %}{%- assign pcol = "#2f4a58" -%}{% when "coming" %}{%- assign pcol = "#9a7b3c" -%}{% when "contract" %}{%- assign pcol = "#6e2e28" -%}{% when "sold" %}{%- assign pcol = "#5c564c" -%}{% else %}{%- assign pcol = "#2f4a58" -%}{% endcase %}{%- assign ishl = false -%}{% if p.PrimaryField == x.name or p.Id == x.Id %}{%- assign ishl = true -%}{% endif %}<a href="{{ PathBase }}/{{ p.RoutePath }}" class="pin{% if ishl %} hl{% endif %}"><circle cx="{{ y.x }}" cy="{{ y.y }}" r="{% if ishl %}16{% elsif lst == "sold" %}8{% else %}11{% endif %}" fill="{{ pcol }}" stroke="#fbf7ef" stroke-width="{% if ishl %}4{% else %}2{% endif %}"/><text x="{{ y.x }}" y="{%- capture _py -%}{{ y.y }}{%- endcapture -%}{{ _py | plus: 4 }}" text-anchor="middle" font-family="IBM Plex Mono" font-size="9" fill="#fbf7ef">{{ y.street_no }}</text></a>{% endfor %}</svg></div></div><aside class="side" style="display:grid;gap:18px"><div class="card"><dl class="kv"><dt>Status</dt><dd><b>{% capture lv13 -%}{{ x.status }}{%- endcapture %}{% case lv13 %}{% when "active" %}For sale{% when "coming" %}Coming soon{% when "contract" %}Under contract{% when "sold" %}Sold{% else %}{{ lv13 }}{% endcase %}</b></dd><dt>File</dt><dd>{{ x.mls }}</dd><dt>Listed</dt><dd>{{ x.listed_date }}</dd><dt>Neighborhood</dt><dd><a href="{{ PathBase }}/neighborhoods">{% capture lv14 -%}{{ x.neighborhood }}{%- endcapture %}{% case lv14 %}{% when "millreach" %}Mill Reach{% when "westcommon" %}West Common{% when "ridge" %}Ridge Lane{% when "ferry" %}Ferry Green{% when "square" %}Courthouse Square{% else %}{{ lv14 }}{% endcase %}</a></dd>{%- capture _nxlot -%}{{ x.lot_sqft }}{%- endcapture -%}{%- assign xlot = _nxlot | plus: 0 -%}<dt>Lot</dt><dd>{% if xlot > 0 %}{{ xlot | format_number: "N0" }} sq ft{% else %}No separate lot (flat or loft){% endif %}</dd><dt>Taxes</dt><dd>{{ x.taxes }}</dd><dt>Association</dt><dd>{{ x.hoa }}</dd><dt>Agent</dt><dd>{{ x.agent }}</dd></dl><p class="muted" style="font-size:.86rem;margin:16px 0 0">To see this house, call the office at (555) 014-1860. There is no request form on this site.</p></div>{%- assign ohs2 = get_content_items(ContentType="open_houses", PageSize=20) -%}{%- assign hasoh=false -%}{% for o in ohs2.Items %}{%- assign oy=o.PublishedContent -%}{%- capture _c1 -%}{{ oy.listing_name }}{%- endcapture -%}{% if _c1 == Target.PrimaryField %}{%- assign hasoh=true -%}{% endif %}{% endfor %}{% if hasoh %}<div class="card"><p class="kick">Open house</p><ul class="amen">{% for o in ohs2.Items %}{%- assign oy=o.PublishedContent -%}{%- capture _c2 -%}{{ oy.listing_name }}{%- endcapture -%}{% if _c2 == Target.PrimaryField %}{%- capture _nosm -%}{{ oy.start_min }}{%- endcapture -%}{%- assign osm = _nosm | plus: 0 -%}{%- capture _noem -%}{{ oy.end_min }}{%- endcapture -%}{%- assign oem = _noem | plus: 0 -%}{%- capture od -%}{{ oy.dow }}{%- endcapture -%}{%- assign ohs = "later" -%}{% if od == today_dow %}{% if nowm >= osm and nowm < oem %}{%- assign ohs = "now" -%}{% elsif nowm < osm %}{%- assign ohs = "today" -%}{% else %}{%- assign ohs = "ended" -%}{% endif %}{% elsif od == "sat" or od == "sun" %}{%- assign ohs = "weekend" -%}{% endif %}{%- capture ohmsg -%}{% case ohs %}{% when "now" %}Happening now{% when "today" %}Today · opens {% assign _h2 = osm | divided_by: 60 | floor -%}{%- assign _m2 = osm | modulo: 60 -%}{%- assign _a2 = "am" -%}{% if _h2 >= 24 %}{%- assign _h2 = _h2 | minus: 24 -%}{% endif %}{% if _h2 >= 12 %}{%- assign _a2 = "pm" -%}{% endif %}{% if _h2 > 12 %}{%- assign _h2 = _h2 | minus: 12 -%}{% endif %}{% if _h2 == 0 %}{%- assign _h2 = 12 -%}{% endif %}{{ _h2 }}:{% if _m2 < 10 %}0{% endif %}{{ _m2 }} {{ _a2 }}{% when "ended" %}Ended today{% when "weekend" %}This weekend{% else %}{% capture lv15 -%}{{ oy.dow }}{%- endcapture %}{% case lv15 %}{% when "wed" %}Wednesday{% when "fri" %}Friday{% when "sat" %}Saturday{% when "sun" %}Sunday{% else %}{{ lv15 }}{% endcase %}{% endcase %}{%- endcapture -%}<li><b>{{ oy.date_label }}</b> · {{ ohmsg }}</li>{% endif %}{% endfor %}</ul></div>{% endif %}{% if in_ag and x.private_remarks != "" %}<div class="card" style="border-color:var(--brick)"><p class="kick">Private remarks · agents</p><p style="margin:0">{{ x.private_remarks }}</p></div>{% endif %}</aside></div></div></section><div style="height:40px"></div>
