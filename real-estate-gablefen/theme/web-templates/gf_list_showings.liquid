{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li>Showings</li></ol><p class="kick">Showings</p><h1>Tours and feedback</h1><p class="lede">Showing notes are never public. Signed-in buyer clients see their own tours; agents see the desk copies.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_cl or in_ag %}{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cl == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "agents" and in_ag == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b> {% if au == "agents" %}<span class="tg">🔒 Agents</span>{% else %}<span class="tg">🔒 Clients</span>{% endif %}<p>{% if ok %}{{ y.date_label }} · {{ y.time_label }} · {{ y.listing_name }}{% else %}Sign in as an agent to read this desk note.{% endif %}</p></a>{% endfor %}{% else %}<div class="lockp"><p class="kick">🔒 Showings</p><h2>Sign in to see tours and feedback.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the office opens a client account after a first meeting, and the broker opens accounts for agents.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/showings">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the firm</a></p></div>{% endif %}</div></section>
