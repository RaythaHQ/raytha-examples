{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li>Agent desk</li></ol><p class="kick">Agent desk</p><h1>{% if in_ag %}Hello, {{ CurrentUser.FirstName }}.{% else %}Agent desk{% endif %}</h1><p class="lede">{% if in_ag %}Expiring listings, private remarks, broker tours and desk notes. Signed-in agents only.{% else %}The deal board, for signed-in agents.{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_ag %}<div class="badge staff"><div class="t">GABLEFEN REALTY · AGENT DESK</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">DEMO ACCOUNT · BROKER TOUR TODAY 10:00–12:00 AT 8 LINTEL STREET, IF TODAY IS WEDNESDAY</div></div>{%- assign allh = get_content_items(ContentType="listings", OrderBy="sort_order asc", PageSize=40) -%}{%- assign db = get_content_items(ContentType="bulletins", Filter="audience eq 'agents'", OrderBy="sort_order asc", PageSize=10) -%}{%- assign dsh = get_content_items(ContentType="showings", Filter="audience eq 'agents'", OrderBy="sort_order asc", PageSize=10) -%}<div class="dg"><div><h2>Active and coming</h2><table class="table"><thead><tr><th>House</th><th>Status</th><th>Price</th><th>Days</th><th>Agent</th></tr></thead><tbody>{% for p in allh.Items %}{%- assign y=p.PublishedContent -%}{%- capture lst -%}{{ y.status }}{%- endcapture -%}{%- capture ldt -%}{{ y.listed_date }}{%- endcapture -%}{%- assign ly = ldt | slice: 0,4 | plus: 0 -%}{%- assign lm = ldt | slice: 5,2 | plus: 0 -%}{%- assign ld = ldt | slice: 8,2 | plus: 0 -%}{%- assign domk = nowy | minus: ly | times: 365 -%}{%- assign domk = mon | minus: lm | times: 30 | plus: domk -%}{%- assign domk = dom | minus: ld | plus: domk -%}{% if domk < 0 %}{%- assign domk = 0 -%}{% endif %}{%- assign isnew = false -%}{% if domk <= 14 %}{%- assign isnew = true -%}{% endif %}{% if lst == "sold" %}{% else %}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a>{%- capture _c6 -%}{{ y.private_remarks }}{%- endcapture -%}{% if _c6 != "" %}<div class="muted" style="font-size:.85rem">{{ y.private_remarks | truncate: 140 }}</div>{% endif %}</td><td>{% capture lv34 -%}{{ y.status }}{%- endcapture %}{% case lv34 %}{% when "active" %}For sale{% when "coming" %}Coming soon{% when "contract" %}Under contract{% when "sold" %}Sold{% else %}{{ lv34 }}{% endcase %}</td><td>{%- capture pv2 -%}{{ y.price }}{%- endcapture -%}${{ pv2 | plus: 0 | format_number: "N0" }}</td><td>{% if lst == "coming" %}—{% else %}{{ domk }}{% endif %}</td><td>{{ y.agent }}</td></tr>{% endif %}{% endfor %}</tbody></table><h2 style="margin-top:32px">Desk notes</h2>{% for p in db.Items %}{%- assign y=p.PublishedContent -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b><p>{{ y.summary }}</p></a>{% endfor %}<h2 style="margin-top:32px">Agent-only showings</h2>{% for p in dsh.Items %}{%- assign y=p.PublishedContent -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b><p>{{ y.date_label }} · {{ y.time_label }}</p></a>{% endfor %}</div><aside class="card side"><p class="kick">Remember</p><p>Private remarks stay on this desk and on the listing page, and only after sign-in. Do not read them aloud in a living room.</p><p class="muted" style="margin-bottom:0">Broker tour at 8 Lintel Street is Wednesday, 10 am–12 pm, this week only.</p></aside></div>{% else %}<div class="lockp"><p class="kick">🔒 Agent desk</p><h2>Sign in as an agent to see the desk.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the office opens a client account after a first meeting, and the broker opens accounts for agents.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the firm</a></p></div>{% endif %}</div></section>
