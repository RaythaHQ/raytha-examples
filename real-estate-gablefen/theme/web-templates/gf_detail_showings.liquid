{%- assign in_cl=false -%}{%- assign in_ag=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cl=true -%}{%- endif -%}{%- if g == "agents" -%}{%- assign in_ag=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cl=true -%}{%- assign in_ag=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cl == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "agents" and in_ag == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Gablefen Realty</a></li><li><a href="{{ PathBase }}/showings">Showings</a></li><li>{% if ok %}{{ Target.PrimaryField }}{% else %}Members only{% endif %}</li></ol><p class="kick">{% capture lv33 -%}{{ x.kind }}{%- endcapture %}{% case lv33 %}{% when "feedback" %}Showing feedback{% when "tour" %}Upcoming showing{% when "offer" %}Offer note{% else %}{{ lv33 }}{% endcase %}</p><h1>{% if ok %}{{ Target.PrimaryField }}{% else %}Members only{% endif %}</h1><p class="lede">{% if ok %}{{ x.summary }}{% else %}This showing note is not public.{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}{%- capture _c4 -%}{{ x.feedback }}{%- endcapture -%}{% if _c4 != "" %}<h2>Feedback</h2><p>{{ x.feedback }}</p>{% endif %}</div><aside class="card side"><dl class="kv"><dt>Listing</dt><dd>{{ x.listing_name }}</dd><dt>When</dt><dd>{{ x.date_label }} · {{ x.time_label }}</dd>{%- capture _c5 -%}{{ x.client_name }}{%- endcapture -%}{% if _c5 != "" %}<dt>Client</dt><dd>{{ x.client_name }}</dd>{% endif %}</dl></aside></div>{% else %}<div class="lockp"><p class="kick">🔒 Members only</p><h2>This showing note is not public.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the office opens a client account after a first meeting, and the broker opens accounts for agents.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/showings">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the firm</a></p></div>{% endif %}</div></section>
