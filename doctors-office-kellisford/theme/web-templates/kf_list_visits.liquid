<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Visit types</li></ol><p class="kick">Visit types</p><h1>Choose the visit that fits</h1><p class="lede">How long each visit takes, whether same-day slots are held, what to bring and what happens afterwards.</p></div></div><section class="sec tight"><div class="w"><div class="vgrid">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture vc -%}{{ y.color }}{%- endcapture -%}{%- capture vm -%}{{ y.minutes }}{%- endcapture -%}{%- capture vs -%}{{ y.same_day }}{%- endcapture -%}<a class="vtile" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ vc }}"><img src="{{ y.art.Value | attachment_redirect_url }}" alt="" loading="lazy"><div class="b"><div><span class="tag">{{ vm }} MIN</span>{% if vs == "yes" %}<span class="tag sd">SAME-DAY</span>{% endif %}</div><h3>{{ p.PrimaryField }}</h3><p>{{ y.summary }}</p><div class="mbar" aria-hidden="true"><i style="width:{{ vm | times: 2.2 | at_most: 100 }}%"></i></div></div></a>{% endfor %}</div></div></section>
