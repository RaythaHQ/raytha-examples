{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign tname = "now" | date: "%A" -%}{%- assign provs = get_content_items(ContentType="providers", OrderBy="sort_order asc", PageSize=20) -%}{%- assign vis = get_content_items(ContentType="visits", OrderBy="sort_order asc", PageSize=8) -%}{%- assign sess = get_content_items(ContentType="sessions", OrderBy="sort_order asc", PageSize=8) -%}{%- assign nws = get_content_items(ContentType="updates", OrderBy="sort_order asc", PageSize=3) -%}
<section class="hero chart"><div class="w g"><div><p class="kick">Family medicine · Kellisford</p><h1>See who is in today, and pick the visit that fits.</h1><p class="lede">Kellisford Family Medicine is a fictional independent practice. The site shows today's hours and who is in the office, what each kind of visit takes and what to bring, and when a symptom needs a call or a 911.</p>
<p class="cta"><a class="btn" href="{{ PathBase }}/visits">Choose a visit</a><a class="btn line" href="{{ PathBase }}/when-to-call">When to call</a></p>
<p class="er"><b>Emergency?</b> Call 911 for chest pain, trouble breathing, signs of a stroke or severe bleeding.</p></div>
<aside class="slip" aria-label="Today at the office"><div class="sh"><b>Today · {{ tname }}</b><span>DAY BOARD</span></div><div class="sb"><div class="hrs"><div><small>Office hours</small><br><b>{% case tdow %}{% when "fri" %}8:00 am – 2:00 pm{% when "sat" %}9:00 am – 12:00 pm{% when "sun" %}Closed{% else %}8:00 am – 5:00 pm{% endcase %}</b></div><small style="text-align:right">(555) 018-2200<br>same-day: call 8:00 am</small></div>
<ul class="in">{%- assign nin=0 -%}{% for p in provs.Items %}{%- assign y=p.PublishedContent -%}{%- capture dd -%}{{ y.days }}{%- endcapture -%}{%- assign dl = dd | split: "|" -%}{% if dl contains tdow %}{%- assign nin = nin | plus: 1 -%}<li><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt=""><span><b>{{ p.PrimaryField }}</b><small>{% capture lv1 -%}{{ y.role }}{%- endcapture %}{% case lv1 %}{% when "md" %}Physician{% when "np" %}Nurse practitioner{% when "pa" %}Physician assistant{% when "rn" %}Nurse{% when "lead" %}Office lead{% else %}{{ lv1 }}{% endcase %} · {{ y.focus | truncate: 44 }}</small></span></li>{% endif %}{% endfor %}</ul>{% if nin == 0 %}<p class="muted" style="margin:0">The office is closed today. Use the after-hours line for urgent questions.</p>{% endif %}</div>
<div class="sf"><b>{{ nin }}</b> in the office today · <a href="{{ PathBase }}/week">see the week board</a></div></aside></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">What kind of visit?</p><h2>Six visit types, each with a time and a prep list</h2><p>Every visit page lists how long it takes, whether same-day slots are held, what to bring and what happens afterwards.</p></div><a class="btn sm line" href="{{ PathBase }}/visits">All visit types →</a></div>
<div class="vgrid">{% for p in vis.Items %}{%- assign y=p.PublishedContent -%}{%- capture vc -%}{{ y.color }}{%- endcapture -%}{%- capture vm -%}{{ y.minutes }}{%- endcapture -%}{%- capture vs -%}{{ y.same_day }}{%- endcapture -%}<a class="vtile" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ vc }}"><img src="{{ y.art.Value | attachment_redirect_url }}" alt="" loading="lazy"><div class="b"><div><span class="tag">{{ vm }} MIN</span>{% if vs == "yes" %}<span class="tag sd">SAME-DAY</span>{% endif %}</div><h3>{{ p.PrimaryField }}</h3><p>{{ y.summary }}</p><div class="mbar" aria-hidden="true"><i style="width:{{ vm | times: 2.2 | at_most: 100 }}%"></i></div></div></a>{% endfor %}</div></div></section>
<section class="sec tight" style="background:#fff;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)"><div class="w"><div class="shead"><div><p class="kick">The week board</p><h2>Who is in, day by day</h2><p>Today is highlighted from the server clock. Hours: Mon–Thu 8–5, Fri 8–2, Sat 9–12.</p></div><a class="btn sm line" href="{{ PathBase }}/week">Full week board →</a></div>{%- assign cols = "mon,tue,wed,thu,fri,sat" | split: "," -%}<div class="tscroll"><table class="week"><thead><tr><th>Provider</th>{% for c in cols %}<th class="{% if c == tdow %}today{% endif %}">{% case c %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% else %}Sat{% endcase %}{% if c == tdow %} · today{% endif %}</th>{% endfor %}</tr></thead><tbody>{% for p in provs.Items %}{%- assign y=p.PublishedContent -%}{%- capture dd -%}{{ y.days }}{%- endcapture -%}{%- capture pc -%}{{ y.color }}{%- endcapture -%}{%- assign dl = dd | split: "|" -%}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv2 -%}{{ y.role }}{%- endcapture %}{% case lv2 %}{% when "md" %}Physician{% when "np" %}Nurse practitioner{% when "pa" %}Physician assistant{% when "rn" %}Nurse{% when "lead" %}Office lead{% else %}{{ lv2 }}{% endcase %} · {{ y.focus | truncate: 46 }}</small></td>{% for c in cols %}<td class="{% if c == tdow %}today{% endif %}">{% if dl contains c %}<span class="pill" style="--c:{{ pc }}">{% case c %}{% when "fri" %}8–2{% when "sat" %}9–12{% else %}8–5{% endcase %}</span>{% else %}<span class="off">–</span>{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div></div></section>
<section class="sec dark"><div class="w"><div class="shead"><div><p class="kick">Not sure whether to call?</p><h2>The four-step ladder</h2><p>Every care guide places a symptom on the same ladder: care at home, call the office, same-day visit, emergency.</p></div><a class="btn sm line" href="{{ PathBase }}/when-to-call">When to call →</a></div><div class="ladder"><div class="rung" style="--c:#58773a"><span class="n">STEP 1</span><h3>Care at home</h3><p>Rest, fluids and the steps in the guide.</p></div><div class="rung" style="--c:#2f6f9f"><span class="n">STEP 2</span><h3>Call the office</h3><p>Call us; a nurse asks a few questions.</p></div><div class="rung" style="--c:#c98a12"><span class="n">STEP 3</span><h3>Same-day visit</h3><p>Call at 8:00 am for a held slot.</p></div><div class="rung" style="--c:#d9503a"><span class="n">STEP 4</span><h3>Emergency</h3><p>Call 911. Do not wait for a call back.</p></div></div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">A visit, step by step</p><h2>Before, arrive, in the room, after</h2></div></div><div class="tl"><div><h3>Before</h3><p>Book, read the prep sheet, gather medicines and questions.</p></div><div><h3>Arrive</h3><p>Check in at the desk; the nurse takes vitals.</p></div><div><h3>In the room</h3><p>Your provider reviews, examines and agrees a plan with you.</p></div><div><h3>After</h3><p>A written summary appears in the patient area within two days.</p></div></div></div></section>
<section class="sec tight"><div class="w"><div class="shead"><div><p class="kick">Providers</p><h2>The team you will see</h2></div><a class="btn sm line" href="{{ PathBase }}/providers">All providers →</a></div><div class="pgrid">{% for p in provs.Items limit:4 %}{%- assign y=p.PublishedContent -%}{%- capture pc -%}{{ y.color }}{%- endcapture -%}{%- capture pn -%}{{ y.new_patients }}{%- endcapture -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ pc }}"><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt="Generated portrait for {{ p.PrimaryField }}" loading="lazy"><div class="b"><h3>{{ p.PrimaryField }}</h3><small>{{ y.credentials }}</small><small style="margin-top:6px">{% if pn == "yes" %}<span class="tag on">NEW PATIENTS</span>{% else %}<span class="tag">ESTABLISHED ONLY</span>{% endif %}</small></div></a>{% endfor %}</div></div></section>
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,1fr) minmax(0,1fr)"><div><div class="shead"><div><p class="kick">Clinic sessions</p><h2>Flu clinics and talks</h2></div><a class="btn sm line" href="{{ PathBase }}/sessions">All sessions →</a></div><ul class="rowlist">{% for p in sess.Items limit:6 %}{%- capture sa0 -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{% if sa0 == "public" %}{%- assign y=p.PublishedContent -%}{%- capture sa -%}{{ y.audience }}{%- endcapture -%}<li><span class="when">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv3 -%}{{ y.kind }}{%- endcapture %}{% case lv3 %}{% when "vaccine" %}Vaccine clinic{% when "talk" %}Talk{% when "group" %}Group visit{% when "huddle" %}Team huddle{% else %}{{ lv3 }}{% endcase %} · {{ y.where_label }} · {% if sa == "patients" %}<span class="tag lock">🔒 PATIENTS</span>{% elsif sa == "staff" %}<span class="tag on">STAFF</span>{% else %}{{ y.note }}{% endif %}</small></div></li>{% endif %}{% endfor %}</ul></div>
<div><div class="shead"><div><p class="kick">Notices</p><h2>From the front desk</h2></div><a class="btn sm line" href="{{ PathBase }}/notices">All notices →</a></div><div class="nlist" style="grid-template-columns:1fr">{% for n in nws.Items limit:2 %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><div class="b"><small>{{ y.date_label }} · {% capture lv4 -%}{{ y.kind }}{%- endcapture %}{% case lv4 %}{% when "hours" %}Hours{% when "clinic" %}Clinic days{% when "team" %}Team{% when "season" %}Seasonal{% else %}{{ lv4 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span>{{ y.summary }}</span></div></a>{% endfor %}</div></div></div></div></section>
<section class="band"><div class="w"><div><h2>Patients read their prep sheets here.</h2><p>Visit prep, after-visit notes and portal guides sit behind sign-in. Staff see the phone script and same-day rules in the staff room. Demo accounts only.</p></div><a class="btn" href="{{ PathBase }}/new-patients">New patients</a></div></section>
