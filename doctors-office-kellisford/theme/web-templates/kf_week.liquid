{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign tname = "now" | date: "%A" -%}{%- assign provs = get_content_items(ContentType="providers", OrderBy="sort_order asc", PageSize=20) -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Week board</li></ol><p class="kick">Week board</p><h1>Who is in, day by day</h1><p class="lede">Each provider and the days they are in the office. Today is highlighted from the server clock. Hours: Mon–Thu 8–5, Fri 8–2, Sat 9–12.</p></div></div><section class="sec tight"><div class="w">{%- assign cols = "mon,tue,wed,thu,fri,sat" | split: "," -%}<div class="tscroll"><table class="week"><thead><tr><th>Provider</th>{% for c in cols %}<th class="{% if c == tdow %}today{% endif %}">{% case c %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% else %}Sat{% endcase %}{% if c == tdow %} · today{% endif %}</th>{% endfor %}</tr></thead><tbody>{% for p in provs.Items %}{%- assign y=p.PublishedContent -%}{%- capture dd -%}{{ y.days }}{%- endcapture -%}{%- capture pc -%}{{ y.color }}{%- endcapture -%}{%- assign dl = dd | split: "|" -%}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv5 -%}{{ y.role }}{%- endcapture %}{% case lv5 %}{% when "md" %}Physician{% when "np" %}Nurse practitioner{% when "pa" %}Physician assistant{% when "rn" %}Nurse{% when "lead" %}Office lead{% else %}{{ lv5 }}{% endcase %} · {{ y.focus | truncate: 46 }}</small></td>{% for c in cols %}<td class="{% if c == tdow %}today{% endif %}">{% if dl contains c %}<span class="pill" style="--c:{{ pc }}">{% case c %}{% when "fri" %}8–2{% when "sat" %}9–12{% else %}8–5{% endcase %}</span>{% else %}<span class="off">–</span>{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><p class="muted" style="margin-top:16px;font-size:.92rem">Schedules change; call (555) 018-2200 to confirm. Fictional practice.</p></div></section>
