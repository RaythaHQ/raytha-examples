{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Clinic sessions</li></ol><p class="kick">Clinic sessions</p><h1>Flu clinics, group visits and talks</h1><p class="lede">Public sessions are open to everyone; patient group visits need a patient account; staff huddles stay in the staff room.</p></div></div><section class="sec tight"><div class="w"><ul class="rowlist">{% for p in Target.Items %}{%- capture sa1 -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{%- assign sok=true -%}{% if sa1 == "patients" and in_patients == false %}{%- assign sok=false -%}{% endif %}{% if sa1 == "staff" and in_staff == false %}{%- assign sok=false -%}{% endif %}{% if sok %}{%- assign y=p.PublishedContent -%}{%- capture sa -%}{{ y.audience }}{%- endcapture -%}<li><span class="when">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv17 -%}{{ y.kind }}{%- endcapture %}{% case lv17 %}{% when "vaccine" %}Vaccine clinic{% when "talk" %}Talk{% when "group" %}Group visit{% when "huddle" %}Team huddle{% else %}{{ lv17 }}{% endcase %} · {{ y.where_label }} · {% if sa == "patients" %}<span class="tag lock">🔒 PATIENTS</span>{% elsif sa == "staff" %}<span class="tag on">STAFF</span>{% else %}{{ y.note }}{% endif %}</small></div></li>{% endif %}{% endfor %}</ul></div></section>
