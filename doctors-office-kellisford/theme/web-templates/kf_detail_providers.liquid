{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign tname = "now" | date: "%A" -%}{%- assign x=Target.PublishedContent -%}{%- capture dd -%}{{ x.days }}{%- endcapture -%}{%- capture pc -%}{{ x.color }}{%- endcapture -%}{%- capture pn -%}{{ x.new_patients }}{%- endcapture -%}{%- assign dl = dd | split: "|" -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/providers">Providers</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv8 -%}{{ x.role }}{%- endcapture %}{% case lv8 %}{% when "md" %}Physician{% when "np" %}Nurse practitioner{% when "pa" %}Physician assistant{% when "rn" %}Nurse{% when "lead" %}Office lead{% else %}{{ lv8 }}{% endcase %} · {{ x.credentials }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><div class="card" style="margin-bottom:24px"><p class="kick">Days in the office</p><div class="daystrip" style="--c:{{ pc }}">{% assign cols = "mon,tue,wed,thu,fri,sat" | split: "," %}{% for c in cols %}<span class="{% if dl contains c %}on{% endif %}">{% case c %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% else %}Sat{% endcase %}{% if c == tdow %}<br>today{% endif %}</span>{% endfor %}</div><p class="muted" style="margin:12px 0 0;font-size:.92rem">Hours: {{ x.hours }}</p></div><div class="prose">{{ x.body }}</div></div>
<aside class="card side" style="border-top:6px solid {{ pc }}"><img src="{{ x.portrait.Value | attachment_redirect_url }}" alt="Generated portrait" style="border-radius:10px;margin-bottom:16px"><dl class="kv"><dt>Focus</dt><dd>{{ x.focus }}</dd><dt>Languages</dt><dd>{{ x.languages }}</dd><dt>New patients</dt><dd>{% capture lv9 -%}{{ x.new_patients }}{%- endcapture %}{% case lv9 %}{% when "yes" %}Accepting new patients{% when "no" %}Not accepting new patients{% else %}{{ lv9 }}{% endcase %}</dd></dl></aside></div></div></section>
