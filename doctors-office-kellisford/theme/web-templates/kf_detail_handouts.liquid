{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "patients" and in_patients == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/handouts">Handouts</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv19 -%}{{ x.kind }}{%- endcapture %}{% case lv19 %}{% when "prep" %}Visit prep{% when "after" %}After your visit{% when "portal" %}Portal guide{% when "policy" %}Policy{% when "checklist" %}Checklist{% when "script" %}Phone script{% when "procedure" %}Procedure{% else %}{{ lv19 }}{% endcase %} · updated {{ x.updated }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:16px 0 0">{% if au == "patients" %}<span class="tag lock">🔒 PATIENTS</span>{% elsif au == "staff" %}<span class="tag on">STAFF</span>{% else %}<span class="tag">PUBLIC</span>{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="card side" style="border-top:6px solid var(--teal)"><dl class="kv"><dt>Kind</dt><dd>{% capture lv20 -%}{{ x.kind }}{%- endcapture %}{% case lv20 %}{% when "prep" %}Visit prep{% when "after" %}After your visit{% when "portal" %}Portal guide{% when "policy" %}Policy{% when "checklist" %}Checklist{% when "script" %}Phone script{% when "procedure" %}Procedure{% else %}{{ lv20 }}{% endcase %}</dd><dt>Audience</dt><dd>{% capture lv21 -%}{{ x.audience }}{%- endcapture %}{% case lv21 %}{% when "public" %}Everyone{% when "patients" %}Patients{% when "staff" %}Staff{% else %}{{ lv21 }}{% endcase %}</dd><dt>Updated</dt><dd>{{ x.updated }}</dd></dl></aside></div>
{% else %}{% if au == "staff" %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Signed-in staff see this handout.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the front desk after a first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/new-patients">New patients</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Patients</p><h2>Sign in with a patient account to read this handout.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the front desk after a first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/new-patients">New patients</a></p></div>{% endif %}{% endif %}</div></section>
