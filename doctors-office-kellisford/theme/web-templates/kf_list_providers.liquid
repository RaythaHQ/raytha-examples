<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Providers</li></ol><p class="kick">Providers</p><h1>The team you will see</h1><p class="lede">Physicians, nurse practitioners, a physician assistant and nurses. Each profile shows the days they are in the office.</p></div></div><section class="sec tight"><div class="w"><div class="pgrid">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture pc -%}{{ y.color }}{%- endcapture -%}{%- capture pn -%}{{ y.new_patients }}{%- endcapture -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ pc }}"><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt="Generated portrait for {{ p.PrimaryField }}" loading="lazy"><div class="b"><h3>{{ p.PrimaryField }}</h3><small>{{ y.credentials }}</small><small style="margin-top:6px">{% if pn == "yes" %}<span class="tag on">NEW PATIENTS</span>{% else %}<span class="tag">ESTABLISHED ONLY</span>{% endif %}</small></div></a>{% endfor %}</div></div></section>
