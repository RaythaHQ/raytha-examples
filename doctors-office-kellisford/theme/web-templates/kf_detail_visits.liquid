{%- assign x=Target.PublishedContent -%}{%- capture vc -%}{{ x.color }}{%- endcapture -%}{%- capture vm -%}{{ x.minutes }}{%- endcapture -%}{%- capture vs -%}{{ x.same_day }}{%- endcapture -%}{%- assign provs = get_content_items(ContentType="providers", OrderBy="sort_order asc", PageSize=20) -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/visits">Visit types</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ vm }} minutes · {% capture lv10 -%}{{ x.kind }}{%- endcapture %}{% case lv10 %}{% when "checkup" %}Checkup{% when "sick" %}Sick visit{% when "chronic" %}Ongoing care{% when "labs" %}Lab draw{% when "vaccine" %}Vaccine{% when "virtual" %}Video visit{% else %}{{ lv10 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:16px 0 0"><span class="tag">{{ vm }} MIN</span>{% if vs == "yes" %}<span class="tag sd">SAME-DAY SLOTS HELD</span>{% else %}<span class="tag">BOOK AHEAD</span>{% endif %}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><div class="prose">{{ x.body }}</div><h2 style="margin:32px 0 16px;font-size:1.4rem">Your visit, in three lists</h2><div class="cols3" style="--c:{{ vc }}"><div class="card"><h3>Before you come</h3>{%- assign li = x.before | split: "|" -%}<ul class="chk">{% for s in li %}<li>{{ s | strip }}</li>{% endfor %}</ul></div><div class="card"><h3>What to bring</h3>{%- assign li = x.bring | split: "|" -%}<ul class="chk">{% for s in li %}<li>{{ s | strip }}</li>{% endfor %}</ul></div><div class="card"><h3>After the visit</h3>{%- assign li = x.after | split: "|" -%}<ul class="chk">{% for s in li %}<li>{{ s | strip }}</li>{% endfor %}</ul></div></div></div>
<aside class="card side" style="border-top:6px solid {{ vc }}"><img src="{{ x.art.Value | attachment_redirect_url }}" alt="" style="border-radius:10px;margin-bottom:16px"><dl class="kv"><dt>Length</dt><dd>{{ vm }} minutes</dd><dt>Booking</dt><dd>{% capture lv11 -%}{{ x.same_day }}{%- endcapture %}{% case lv11 %}{% when "yes" %}Same-day slots held{% when "no" %}Book ahead{% else %}{{ lv11 }}{% endcase %}</dd><dt>Phone</dt><dd>(555) 018-2200<br>weekdays from 8:00 am</dd></dl><p class="muted" style="margin:14px 0 0;font-size:.9rem">No online booking on this site; call the front desk.</p></aside></div></div></section>
