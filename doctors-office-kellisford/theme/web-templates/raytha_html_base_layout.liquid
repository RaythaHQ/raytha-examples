<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Kellisford Family Medicine" %}{{ Target.Title }} | {% endif %}Kellisford Family Medicine</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Kellisford Family Medicine (fictional): a family practice website with a week board of who is in, visit types with what to bring, care guides with a four-step triage ladder, and a patient area behind sign-in. Built on Raytha, a self-hosted, open-source .NET CMS for medical practices.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Figtree:wght@400;500;600;700&family=Schibsted+Grotesk:wght@600;700;800&display=swap" rel="stylesheet"><style>
:root{--paper:#f6f5ef;--card:#fff;--ink:#12303a;--ink2:#46606a;--rule:#d6dfdb;--teal:#0f6b66;--tealD:#0a4f4b;--mint:#e2efec;--coral:#d9503a;--sun:#c98a12;--sky:#2f6f9f;--moss:#58773a;--plum:#6a4c93;--r:14px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:400 1.02rem/1.6 "Figtree",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:"Schibsted Grotesk","Figtree",sans-serif;letter-spacing:-.015em;line-height:1.12;margin:0 0 .5em;font-weight:700;color:var(--ink)}
h1{font-size:clamp(2.1rem,4.6vw,3.4rem);font-weight:800}h2{font-size:clamp(1.55rem,2.6vw,2.1rem)}h3{font-size:1.2rem}
a{color:var(--tealD);text-underline-offset:3px}a:hover{color:var(--coral)}img{max-width:100%;display:block}
.w{max-width:1200px;margin:0 auto;padding:0 28px}.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px 12px;z-index:99}
.mono{font-family:"DM Mono",monospace}.muted{color:var(--ink2)}.kick{font:500 .76rem/1 "DM Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--teal);margin:0 0 12px}
.top{background:var(--ink);color:#cfe2de;font-size:.8rem}.top .w{display:flex;justify-content:space-between;align-items:center;gap:14px;min-height:38px;flex-wrap:wrap}.top a{color:#fff;margin-left:16px;text-decoration:none}.top .fict{font:500 .7rem/1 "DM Mono",monospace;letter-spacing:.1em}.top input{background:#1d4450;border:1px solid #31606c;color:#fff;border-radius:99px;padding:5px 12px;font:inherit;font-size:.8rem;width:170px;margin-left:16px}.top input::placeholder{color:#9fbab4}
.hdr{background:#fff;border-bottom:1px solid var(--rule)}.hdr .w{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding-top:16px;flex-wrap:wrap}.brand{display:flex;gap:12px;align-items:center;text-decoration:none;color:var(--ink);padding-bottom:12px}.brand b{display:block;font:800 1.28rem/1.1 "Schibsted Grotesk",sans-serif}.brand small{font:500 .68rem/1.3 "DM Mono",monospace;letter-spacing:.1em;color:var(--ink2);text-transform:uppercase}
.tabs ul{list-style:none;margin:0;padding:0;display:flex;gap:4px;flex-wrap:wrap}.tabs a{display:block;padding:10px 15px 11px;border:1px solid var(--rule);border-bottom:0;border-radius:10px 10px 0 0;background:var(--mint);color:var(--ink);text-decoration:none;font-weight:600;font-size:.93rem;position:relative;top:1px}.tabs a:hover{background:#fff;color:var(--coral)}.tabs li:last-child a{background:var(--teal);color:#fff;border-color:var(--teal)}
