.slip .sb{padding:18px 20px}.slip .hrs{display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-bottom:1px dashed var(--rule);padding-bottom:12px;margin-bottom:12px}.slip .hrs b{font:500 1.5rem/1 "DM Mono",monospace;color:var(--tealD)}.slip .hrs small{color:var(--ink2)}
.in{list-style:none;margin:0;padding:0;display:grid;gap:8px}.in li{display:flex;gap:12px;align-items:center}.in img{width:42px;height:50px;object-fit:cover;border-radius:8px;border:1px solid var(--rule)}.in b{display:block;font-size:.97rem;line-height:1.2}.in small{color:var(--ink2);font-size:.84rem}
.slip .sf{background:var(--mint);padding:12px 20px;font-size:.9rem;display:flex;gap:10px;align-items:center;border-top:1px solid var(--rule)}.slip .sf b{color:var(--coral)}
.er{background:#fdeceb;border:1px solid #f0b7ae;color:#7a2418;border-radius:10px;padding:10px 14px;font-size:.92rem;margin-top:18px}.er b{font-weight:700}
.sec{padding:64px 0}.sec.tight{padding:40px 0}.shead{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:26px;flex-wrap:wrap}.shead p{margin:0;color:var(--ink2);max-width:640px}
.vgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.vtile{background:#fff;border:1px solid var(--rule);border-radius:var(--r);overflow:hidden;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s}.vtile:hover{transform:translateY(-3px);box-shadow:0 14px 28px -18px rgba(18,48,58,.55);color:var(--ink)}.vtile img{aspect-ratio:16/9;object-fit:cover;width:100%;border-bottom:1px solid var(--rule)}.vtile .b{padding:16px 18px 18px;display:flex;flex-direction:column;gap:8px;flex:1}.vtile h3{margin:0}.vtile p{margin:0;color:var(--ink2);font-size:.93rem}
.mbar{height:10px;border-radius:99px;background:var(--rule);overflow:hidden}.mbar i{display:block;height:100%;background:var(--c,var(--teal));border-radius:99px}.tag{display:inline-block;font:500 .7rem/1 "DM Mono",monospace;letter-spacing:.06em;padding:5px 9px;border-radius:99px;background:var(--mint);color:var(--tealD);margin-right:6px;white-space:nowrap}.tag.sd{background:#fff3d6;color:#7a5200}.tag.lock{background:#ecdff7;color:#4b2b76}.tag.on{background:#d5ecd0;color:#2d5a21}.tag.er{background:#fdeceb;color:#7a2418;border:0;padding:5px 9px;margin:0}
.week{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--rule);border-radius:var(--r);overflow:hidden}.week th,.week td{padding:12px 10px;text-align:center;border-bottom:1px solid var(--rule);border-left:1px solid var(--rule);font-size:.9rem}.week th:first-child,.week td:first-child{text-align:left;border-left:0;padding-left:18px;min-width:230px}.week thead th{background:var(--ink);color:#fff;font:500 .76rem/1 "DM Mono",monospace;letter-spacing:.08em;text-transform:uppercase;border-left-color:#27505c}.week tr:last-child td{border-bottom:0}.week .today{background:#fff6dc}.week thead .today{background:var(--sun);color:#fff}.week .pill{display:inline-block;min-width:54px;padding:5px 8px;border-radius:99px;background:var(--c,var(--teal));color:#fff;font:500 .74rem/1 "DM Mono",monospace}.week .off{color:#a9b9b6}.week td:first-child a{font-weight:700;text-decoration:none;color:var(--ink)}.week td:first-child small{display:block;color:var(--ink2);font-size:.8rem}.tscroll{overflow-x:auto}
.ladder{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-radius:var(--r);overflow:hidden;border:2px solid var(--ink);background:#fff}.rung{padding:22px 20px 24px;border-left:1px solid var(--rule);position:relative}.rung:first-child{border-left:0}.rung:before{content:"";position:absolute;left:0;right:0;top:0;height:10px;background:var(--c)}.rung .n{font:500 .72rem/1 "DM Mono",monospace;letter-spacing:.1em;color:var(--c);display:block;margin:6px 0 8px}.rung h3{font-size:1.15rem;color:var(--ink)!important}.rung ul{margin:10px 0 0;padding:0;list-style:none;display:grid;gap:7px;font-size:.92rem}.rung li{padding-left:18px;position:relative}.rung li:before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--c)}.rung.on{background:#fffaf0;box-shadow:inset 0 0 0 3px var(--c)}.rung.on .n:after{content:" · USUAL FIRST STEP"}.rung p{margin:0;font-size:.92rem;color:var(--ink2)}
.dark{background:var(--ink);color:#d7e8e4}.dark h2,.dark h3{color:#fff}.dark .kick{color:#8fd1c8}.dark .shead p{color:#b4cdc8}.dark a.btn.line{color:#fff;border-color:#8fd1c8}
.tl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;counter-reset:s;position:relative}.tl>div{padding:0 22px 0 0;position:relative}.tl>div:before{counter-increment:s;content:counter(s);width:40px;height:40px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;font:700 1.05rem "Schibsted Grotesk",sans-serif;position:relative;z-index:1;margin-bottom:14px}.tl>div:after{content:"";position:absolute;top:19px;left:40px;right:0;height:2px;background:repeating-linear-gradient(90deg,var(--teal) 0 8px,transparent 8px 14px)}.tl>div:last-child:after{display:none}.tl p{margin:0;color:var(--ink2);font-size:.95rem}
.pgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.pcard{background:#fff;border:1px solid var(--rule);border-radius:var(--r);overflow:hidden;text-decoration:none;color:var(--ink);display:block}.pcard:hover{box-shadow:0 14px 28px -18px rgba(18,48,58,.55);color:var(--ink)}.pcard img{width:100%;aspect-ratio:5/6;object-fit:cover;border-bottom:1px solid var(--rule)}.pcard .b{padding:14px 16px 16px}.pcard h3{margin:0 0 4px;font-size:1.05rem}.pcard small{color:var(--ink2);display:block;line-height:1.4}
.dg{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,380px);gap:44px;align-items:start}.side{position:sticky;top:20px}.card{background:#fff;border:1px solid var(--rule);border-radius:var(--r);padding:22px 24px}.prose h2{margin-top:1.4em;font-size:1.5rem}.prose p{max-width:70ch}
.phead{padding:44px 0 36px;border-bottom:1px solid var(--rule)}.crumbs{list-style:none;display:flex;gap:8px;padding:0;margin:0 0 16px;font-size:.82rem;color:var(--ink2);flex-wrap:wrap}.crumbs li+li:before{content:"/";margin-right:8px;color:var(--rule)}.crumbs a{color:var(--ink2)}
.chk{list-style:none;margin:0;padding:0;display:grid;gap:9px}.chk li{padding-left:30px;position:relative}.chk li:before{content:"";position:absolute;left:0;top:.28em;width:17px;height:17px;border:2px solid var(--teal);border-radius:5px;background:#fff}.cols3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.cols3 .card h3{font-size:1.05rem;border-bottom:2px solid var(--c,var(--teal));padding-bottom:10px;margin-bottom:14px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.filters a{padding:8px 15px;border-radius:99px;border:1px solid var(--rule);background:#fff;text-decoration:none;font-weight:600;font-size:.9rem;color:var(--ink)}.filters a.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.rowlist{list-style:none;margin:0;padding:0;display:grid;gap:10px}.rowlist li{display:grid;grid-template-columns:200px 1fr;gap:18px;background:#fff;border:1px solid var(--rule);border-radius:12px;padding:14px 18px;align-items:center}.rowlist .when{font:500 .84rem/1.3 "DM Mono",monospace;color:var(--tealD)}.rowlist a{font-weight:700;text-decoration:none;color:var(--ink)}.rowlist small{color:var(--ink2);display:block}
.nlist{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.nitem{background:#fff;border:1px solid var(--rule);border-radius:var(--r);overflow:hidden;text-decoration:none;color:var(--ink);display:flex;flex-direction:column}.nitem img{aspect-ratio:16/9;object-fit:cover;width:100%;border-bottom:1px solid var(--rule)}.nitem .b{padding:14px 18px 18px}.nitem small{font:500 .72rem/1.3 "DM Mono",monospace;color:var(--teal);letter-spacing:.06em;text-transform:uppercase}.nitem b{display:block;font:700 1.05rem/1.25 "Schibsted Grotesk",sans-serif;margin:6px 0}.nitem span{color:var(--ink2);font-size:.92rem}
.pk{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pk a{background:#fff;border:1px solid var(--rule);border-radius:var(--r);padding:18px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:8px}.pk a:hover{border-color:var(--teal)}.pk b{font:700 1.05rem/1.25 "Schibsted Grotesk",sans-serif}.pk span.s{color:var(--ink2);font-size:.92rem}
.lockp{background:#fff;border:2px dashed #a58bc7;border-radius:var(--r);padding:32px;max-width:760px}.lockp .kick{color:#4b2b76}
.pcardx{background:linear-gradient(135deg,var(--teal),var(--tealD));color:#fff;border-radius:16px;padding:22px 24px;box-shadow:8px 8px 0 var(--ink)}.pcardx .nm{font:700 .8rem/1 "DM Mono",monospace;letter-spacing:.12em;color:#a9e0d8}.pcardx .who{font:800 1.7rem/1.1 "Schibsted Grotesk",sans-serif;margin:22px 0 6px}.pcardx .bc{font:500 .8rem/1.5 "DM Mono",monospace;color:#d3efeb}
details.q{background:#fff;border:1px solid var(--rule);border-radius:12px;margin-bottom:10px}details.q summary{cursor:pointer;padding:16px 20px;font:700 1.05rem "Schibsted Grotesk",sans-serif;list-style:none;display:flex;justify-content:space-between;gap:12px}details.q summary:after{content:"+";font-size:1.4rem;line-height:1;color:var(--teal)}details.q[open] summary:after{content:"–"}details.q .a{padding:0 20px 16px;color:var(--ink2)}
.band{background:var(--mint);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}.band .w{display:flex;justify-content:space-between;align-items:center;gap:28px;padding-top:36px;padding-bottom:36px;flex-wrap:wrap}.band h2{margin:0 0 6px}.band p{margin:0;max-width:640px}
.sched{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--rule)}.sched th{text-align:left;background:var(--ink);color:#fff;padding:12px 14px;font:500 .78rem/1 "DM Mono",monospace;letter-spacing:.08em;text-transform:uppercase}.sched td{padding:12px 14px;border-top:1px solid var(--rule)}
.ol2{list-style:none;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;counter-reset:o}.ol2 li{background:#fff;border:1px solid var(--rule);border-radius:var(--r);padding:20px;counter-increment:o}.ol2 li:before{content:counter(o);display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--teal);color:#fff;font-weight:700;margin-bottom:10px}.ol2 h3{margin-bottom:6px}.ol2 p{margin:0;color:var(--ink2);font-size:.95rem}
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}.note{background:#fff;border:1px solid var(--rule);border-radius:var(--r);padding:20px}.note h3{margin:10px 0 6px}
.searchbar{display:flex;gap:10px;max-width:620px;margin-top:20px}.searchbar input{flex:1;padding:12px 16px;border:2px solid var(--ink);border-radius:99px;font:inherit}.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.hit b{font-size:1.05rem}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.93rem}
.daystrip{display:flex;gap:8px;flex-wrap:wrap}.daystrip span{min-width:62px;text-align:center;padding:10px 6px;border-radius:10px;border:1px solid var(--rule);background:#fff;font:500 .78rem/1.2 "DM Mono",monospace;color:#9bb0ac}.daystrip span.on{background:var(--c,var(--teal));color:#fff;border-color:var(--c,var(--teal))}
.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 18px;margin:0}.kv dt{font:500 .74rem/1.6 "DM Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}.kv dd{margin:0}
.foot{background:var(--ink);color:#b9d1cc;padding:50px 0 24px;margin-top:0}.foot h4{color:#fff;font:600 .8rem "DM Mono",monospace;letter-spacing:.1em;text-transform:uppercase}.foot a{color:#d7e8e4;text-decoration:none}.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:7px}.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:34px}.disc{border-top:1px solid #27505c;margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.84rem;color:#8fb1aa}
.notice{background:#fdeceb;border:1px solid #f0b7ae;border-radius:10px;padding:12px 14px;margin-bottom:14px}label{display:block;font-weight:600;margin:0 0 6px}input[type=email],input[type=password]{width:100%;padding:12px 14px;border:2px solid var(--ink);border-radius:10px;font:inherit}
@media (max-width:980px){.hero .g,.dg{grid-template-columns:1fr}.side{position:static}.vgrid,.nlist,.pk,.cols3{grid-template-columns:repeat(2,minmax(0,1fr))}.pgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.ladder{grid-template-columns:repeat(2,minmax(0,1fr))}.rung:nth-child(3){border-left:0}.rung:nth-child(n+3){border-top:1px solid var(--rule)}.tl{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:26px}.tl>div:nth-child(2):after{display:none}.fg{grid-template-columns:1fr 1fr}}
@media (max-width:620px){.w{padding:0 18px}.hdr .w{padding-top:12px}.slip .hrs{flex-wrap:wrap}.slip .hrs b{font-size:1.2rem}.tabs{width:100%;overflow-x:auto;margin:0 -18px;padding:0 18px;width:calc(100% + 36px)}.tabs ul{flex-wrap:nowrap}.tabs a{white-space:nowrap}.brand small{display:none}.top .fict{font-size:.6rem}.top input{display:none}.vgrid,.nlist,.pk,.cols3,.ladder,.pgrid{grid-template-columns:1fr}.rung{border-left:0;border-top:1px solid var(--rule)}.rung:first-child{border-top:0}.tl{grid-template-columns:1fr}.tl>div:after{display:none}.rowlist li{grid-template-columns:1fr;gap:4px}.hero{padding:34px 0 44px}.slip{box-shadow:5px 5px 0 var(--teal)}.tabs a{padding:8px 11px;font-size:.84rem}.fg{grid-template-columns:1fr}.sec{padding:44px 0}.week th:first-child,.week td:first-child{min-width:170px}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="top"><div class="w"><span class="fict">FICTIONAL PRACTICE · RAYTHA EXAMPLE SITE</span><div>{% if CurrentUser.IsAuthenticated %}<span>Signed in as <b style="color:#fff">{{ CurrentUser.FirstName }}</b></span><a href="{{ PathBase }}/patients">Patient area</a><a href="{{ PathBase }}/account/logout">Sign out</a>{% else %}<a href="{{ PathBase }}/account/login?returnUrl=/patients">Patient sign-in</a><a href="{{ PathBase }}/account/login?returnUrl=/staff-room">Staff</a>{% endif %}<form action="{{ PathBase }}/search" role="search" style="display:inline"><input name="q" aria-label="Search the site" placeholder="Search visits, guides…"></form></div></div></div>
<header class="hdr"><div class="w"><a class="brand" href="{{ PathBase }}/"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect width="46" height="46" rx="12" fill="#0f6b66"/><path d="M19 9h8v10h10v8H27v10h-8V27H9v-8h10z" fill="#fff"/><path d="M6 24h8l3-5 4 11 3-8 2 2h14" fill="none" stroke="#d9503a" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" opacity=".95"/></svg><span><b>Kellisford Family Medicine</b><small>Family practice · Kellisford · since 2009</small></span></a>
<nav class="tabs" aria-label="Main"><ul>{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></nav></div></header>
