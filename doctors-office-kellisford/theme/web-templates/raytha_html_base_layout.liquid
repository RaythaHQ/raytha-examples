.btn{display:inline-flex;align-items:center;gap:8px;background:var(--teal);color:#fff;text-decoration:none;font-weight:700;padding:13px 20px;border-radius:99px;border:2px solid var(--teal);font-size:.98rem}.btn:hover{background:var(--tealD);color:#fff}.btn.line{background:transparent;color:var(--tealD)}.btn.line:hover{background:#fff;color:var(--coral);border-color:var(--coral)}.btn.sm{padding:8px 15px;font-size:.88rem}.btn.coral{background:var(--coral);border-color:var(--coral)}
