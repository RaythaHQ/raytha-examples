{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign tname = "now" | date: "%A" -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Patient area</li></ol><p class="kick">Patient area</p><h1>{% if in_patients %}Hello, {{ CurrentUser.FirstName }}.{% else %}Patient area{% endif %}</h1><p class="lede">{% if in_patients %}Your prep sheets, after-visit notes and portal guides. Demo account: no real health information.{% else %}Visit prep sheets, after-visit notes and portal guides, for signed-in patients.{% endif %}</p></div></div>
{% if in_patients %}{%- assign hds = get_content_items(ContentType="handouts", OrderBy="sort_order asc", PageSize=40) -%}{%- assign pse = get_content_items(ContentType="sessions", Filter="audience eq 'patients'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,400px) minmax(0,1fr)"><div><div class="pcardx"><div class="nm">KELLISFORD FAMILY MEDICINE · PATIENT CARD</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">DEMO ACCOUNT · NO REAL RECORDS<br>CARE TEAM: DR. CORRICK · JOAN WHITLOCK, RN</div></div><p class="muted" style="margin-top:18px;font-size:.92rem">Your card is a demo. A real practice would show visit summaries and results here, behind the same server-side checks.</p></div>
<div><h2 style="margin-bottom:14px">Patient group visits</h2><ul class="rowlist">{% for p in pse.Items %}{%- assign y=p.PublishedContent -%}{%- capture sa -%}{{ y.audience }}{%- endcapture -%}<li><span class="when">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv23 -%}{{ y.kind }}{%- endcapture %}{% case lv23 %}{% when "vaccine" %}Vaccine clinic{% when "talk" %}Talk{% when "group" %}Group visit{% when "huddle" %}Team huddle{% else %}{{ lv23 }}{% endcase %} · {{ y.where_label }} · {% if sa == "patients" %}<span class="tag lock">🔒 PATIENTS</span>{% elsif sa == "staff" %}<span class="tag on">STAFF</span>{% else %}{{ y.note }}{% endif %}</small></div></li>{% endfor %}</ul></div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:18px">Your handouts</h2><div class="pk">{% for r in hds.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au == "patients" or au == "public" %}<a href="{{ PathBase }}/{{ r.RoutePath }}"><span><span class="tag">{% capture lv24 -%}{{ x.kind }}{%- endcapture %}{% case lv24 %}{% when "prep" %}Visit prep{% when "after" %}After your visit{% when "portal" %}Portal guide{% when "policy" %}Policy{% when "checklist" %}Checklist{% when "script" %}Phone script{% when "procedure" %}Procedure{% else %}{{ lv24 }}{% endcase %}</span></span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
{% else %}<section class="sec tight"><div class="w"><div class="lockp"><p class="kick">🔒 Patients</p><h2>Sign in to see your prep sheets and after-visit notes.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the front desk after a first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/patients">Sign in</a><a class="btn line" href="{{ PathBase }}/new-patients">New patients</a></p></div></div></section>{% endif %}
