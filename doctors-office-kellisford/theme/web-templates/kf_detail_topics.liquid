{%- assign x=Target.PublishedContent -%}{%- capture lvl -%}{{ x.level }}{%- endcapture -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/care">Care guides</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv14 -%}{{ x.area }}{%- endcapture %}{% case lv14 %}{% when "colds" %}Colds and flu{% when "injury" %}Injuries{% when "skin" %}Skin{% when "chronic" %}Ongoing conditions{% when "kids" %}Children{% when "mind" %}Sleep and mood{% else %}{{ lv14 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="ladder"><div class="rung{% if lvl == "home" %} on{% endif %}" style="--c:#58773a"><span class="n">STEP 1</span><h3>Care at home</h3>{%- assign sg = x.home_signs | split: "|" -%}{% if sg.size > 0 %}<ul>{% for s in sg %}<li>{{ s | strip }}</li>{% endfor %}</ul>{% endif %}</div><div class="rung{% if lvl == "call" %} on{% endif %}" style="--c:#2f6f9f"><span class="n">STEP 2</span><h3>Call the office</h3>{%- assign sg = x.call_signs | split: "|" -%}{% if sg.size > 0 %}<ul>{% for s in sg %}<li>{{ s | strip }}</li>{% endfor %}</ul>{% endif %}</div><div class="rung{% if lvl == "sameday" %} on{% endif %}" style="--c:#c98a12"><span class="n">STEP 3</span><h3>Same-day visit</h3>{%- assign sg = x.sameday_signs | split: "|" -%}{% if sg.size > 0 %}<ul>{% for s in sg %}<li>{{ s | strip }}</li>{% endfor %}</ul>{% endif %}</div><div class="rung{% if lvl == "now" %} on{% endif %}" style="--c:#d9503a"><span class="n">STEP 4</span><h3>Emergency</h3>{%- assign sg = x.now_signs | split: "|" -%}{% if sg.size > 0 %}<ul>{% for s in sg %}<li>{{ s | strip }}</li>{% endfor %}</ul>{% endif %}</div></div><div class="dg" style="margin-top:34px;grid-template-columns:minmax(0,1fr) minmax(0,380px)"><div class="prose">{{ x.body }}</div><aside class="card" style="border-top:6px solid var(--coral)"><p class="kick" style="color:var(--coral)">Emergency</p><p style="margin:0">Call 911 for chest pain, trouble breathing, signs of a stroke or severe bleeding. For thoughts of harming yourself, call or text 988.</p></aside></div></div></section>
