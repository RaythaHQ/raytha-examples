{%- assign fa = QueryParams.area | strip | downcase -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Care guides</li></ol><p class="kick">Care guides</p><h1>Plain-language guides with a four-step ladder</h1><p class="lede">Each guide places a symptom on the same ladder: care at home, call the office, same-day visit, emergency. General information, not medical advice.</p><div class="filters"><a href="{{ PathBase }}/care" class="{% if fa == "" %}on{% endif %}">All</a><a href="{{ PathBase }}/care?area=colds" class="{% if fa == "colds" %}on{% endif %}">Colds and flu</a><a href="{{ PathBase }}/care?area=injury" class="{% if fa == "injury" %}on{% endif %}">Injuries</a><a href="{{ PathBase }}/care?area=skin" class="{% if fa == "skin" %}on{% endif %}">Skin</a><a href="{{ PathBase }}/care?area=chronic" class="{% if fa == "chronic" %}on{% endif %}">Ongoing</a><a href="{{ PathBase }}/care?area=kids" class="{% if fa == "kids" %}on{% endif %}">Children</a><a href="{{ PathBase }}/care?area=mind" class="{% if fa == "mind" %}on{% endif %}">Sleep and mood</a></div></div></div>
<section class="sec tight"><div class="w"><ul class="rowlist">{% for t in Target.Items %}{%- assign y=t.PublishedContent -%}{%- capture ta -%}{{ y.area }}{%- endcapture -%}{% if fa == "" or fa == ta %}<li><span class="when">{% capture lv12 -%}{{ y.area }}{%- endcapture %}{% case lv12 %}{% when "colds" %}Colds and flu{% when "injury" %}Injuries{% when "skin" %}Skin{% when "chronic" %}Ongoing conditions{% when "kids" %}Children{% when "mind" %}Sleep and mood{% else %}{{ lv12 }}{% endcase %}</span><div><a href="{{ PathBase }}/{{ t.RoutePath }}">{{ t.PrimaryField }}</a><small>{{ y.summary }} · usual first step: {% capture lv13 -%}{{ y.level }}{%- endcapture %}{% case lv13 %}{% when "home" %}Care at home{% when "call" %}Call the office{% when "sameday" %}Same-day visit{% when "now" %}Emergency{% else %}{{ lv13 }}{% endcase %}</small></div></li>{% endif %}{% endfor %}</ul></div></section>
