{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead chart"><div class="w"><p class="kick">Search</p><h1>Search the practice site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="flu, physical, sore throat"><button class="btn">Search</button></form><p class="muted" style="margin-top:12px;font-size:.95rem">Searches visit types, care guides, providers, notices, sessions, handouts and questions.</p></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "visits:Visit types:title:summary,topics:Care guides:title:summary,providers:Providers:name:summary,updates:Notices:title:summary,sessions:Sessions:title:summary,handouts:Handouts:name:summary,faq:Questions:question:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au != "staff" or in_staff %}{% if au != "patients" or in_patients %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "patients" %} <span class="tag lock">🔒 PATIENTS</span>{% elsif au == "staff" %} <span class="tag on">STAFF</span>{% endif %}<p>{{ x.summary | strip_html | truncate: 150 }}</p></a>{% endif %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=flu">flu</a>, <a href="?q=physical">physical</a>, <a href="?q=fever">fever</a> or <a href="?q=lab">lab</a>.</p>{% endif %}</div></div></section>
