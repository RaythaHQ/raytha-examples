{%- assign x=Target.PublishedContent -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/notices">Notices</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{{ x.date_label }} · {% capture lv16 -%}{{ x.kind }}{%- endcapture %}{% case lv16 %}{% when "hours" %}Hours{% when "clinic" %}Clinic days{% when "team" %}Team{% when "season" %}Seasonal{% else %}{{ lv16 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="margin-bottom:24px;border:1px solid var(--rule);border-radius:12px">{{ x.body }}<p class="muted" style="margin-top:24px">— {{ x.author }}</p></div><aside class="card side" style="border-top:6px solid var(--teal)"><p class="kick">Front desk</p><p style="margin:0">(555) 018-2200<br>Mon–Thu 8–5 · Fri 8–2 · Sat 9–12<br>Same-day: call at 8:00 am</p></aside></div></div></section>
