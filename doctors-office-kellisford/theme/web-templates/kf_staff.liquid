{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff room</li></ol><p class="kick">Staff room · staff only</p><h1>Staff room</h1><p class="lede">{% if in_staff %}Coverage, the phone script and same-day rules. Names are fictional.{% else %}Schedules and procedures for signed-in staff.{% endif %}</p></div></div>
{% if in_staff %}{{ render_section("main", wrap=false) }}{%- assign sh = get_content_items(ContentType="handouts", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=20) -%}{%- assign ssn = get_content_items(ContentType="sessions", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><h2 style="margin-bottom:18px">Team sessions</h2><ul class="rowlist">{% for p in ssn.Items %}{%- assign y=p.PublishedContent -%}{%- capture sa -%}{{ y.audience }}{%- endcapture -%}<li><span class="when">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv25 -%}{{ y.kind }}{%- endcapture %}{% case lv25 %}{% when "vaccine" %}Vaccine clinic{% when "talk" %}Talk{% when "group" %}Group visit{% when "huddle" %}Team huddle{% else %}{{ lv25 }}{% endcase %} · {{ y.where_label }} · {% if sa == "patients" %}<span class="tag lock">🔒 PATIENTS</span>{% elsif sa == "staff" %}<span class="tag on">STAFF</span>{% else %}{{ y.note }}{% endif %}</small></div></li>{% endfor %}</ul></div></section>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:18px">Staff handouts and procedures</h2><div class="pk">{% for r in sh.Items %}{%- assign x=r.PublishedContent -%}<a href="{{ PathBase }}/{{ r.RoutePath }}"><span><span class="tag on">STAFF</span></span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endfor %}</div></div></section>
{% else %}<section class="sec tight"><div class="w">{% if in_patients %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>You are signed in as a patient.</h2><p class="muted">The staff room is only for staff accounts. Your handouts are in the <a href="{{ PathBase }}/patients">patient area</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Staff sign in to see the staff room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the front desk after a first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Sign in</a><a class="btn line" href="{{ PathBase }}/new-patients">New patients</a></p></div>{% endif %}</div></section>{% endif %}
