{%- assign in_patients=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_patients=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_patients=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_patients=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Handouts</li></ol><p class="kick">Patient handouts</p><h1>Prep sheets, after-visit notes and guides</h1><p class="lede">Some handouts are public; prep and after-visit sheets need a patient account; the phone script and procedures are for staff.</p></div></div><section class="sec tight"><div class="w"><div class="pk">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "patients" and in_patients == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}<a href="{{ PathBase }}/{{ r.RoutePath }}">{% if au == "patients" %}<span><span class="tag lock">🔒 PATIENTS</span></span>{% elsif au == "staff" %}<span><span class="tag on">STAFF</span></span>{% else %}<span><span class="tag">PUBLIC</span></span>{% endif %}<b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
