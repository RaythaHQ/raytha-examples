<div class="phead chart"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Notices</li></ol><p class="kick">Notices</p><h1>From the front desk</h1><p class="lede">Hours changes, clinic days and team news.</p></div></div><section class="sec tight"><div class="w"><div class="nlist">{% for n in Target.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><div class="b"><small>{{ y.date_label }} · {% capture lv15 -%}{{ y.kind }}{%- endcapture %}{% case lv15 %}{% when "hours" %}Hours{% when "clinic" %}Clinic days{% when "team" %}Team{% when "season" %}Seasonal{% else %}{{ lv15 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span>{{ y.summary }}</span></div></a>{% endfor %}</div></div></section>
