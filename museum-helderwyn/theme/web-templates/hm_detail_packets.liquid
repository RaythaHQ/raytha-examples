{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_members == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/packets">Packets</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv30 -%}{{ x.kind }}{%- endcapture %}{% case lv30 %}{% when "packet" %}Exhibition packet{% when "favorites" %}Favorites list{% when "event" %}Member event{% when "checklist" %}Loan checklist{% when "notes" %}Gallery notes{% when "procedure" %}Procedure{% else %}{{ lv30 }}{% endcase %} · updated {{ x.updated }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:16px 0 0">{% if au == "members" %}<span class="chip lock">🔒 Members</span>{% elsif au == "staff" %}<span class="chip on">Staff only</span>{% else %}<span class="chip">Public</span>{% endif %}</p></div></div>
<section class="sec tight"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="wlabel" style="--c:var(--moss)"><div class="acc">PACKET</div><h2 style="font-size:1.15rem">{{ Target.PrimaryField }}</h2><p class="meta">Kind: {% capture lv31 -%}{{ x.kind }}{%- endcapture %}{% case lv31 %}{% when "packet" %}Exhibition packet{% when "favorites" %}Favorites list{% when "event" %}Member event{% when "checklist" %}Loan checklist{% when "notes" %}Gallery notes{% when "procedure" %}Procedure{% else %}{{ lv31 }}{% endcase %}<br>Audience: {% capture lv32 -%}{{ x.audience }}{%- endcapture %}{% case lv32 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv32 }}{% endcase %}<br>Updated: {{ x.updated }}</p></aside></div>
{% else %}{% if au == "staff" %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Signed-in museum staff see this packet.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Members</p><h2>Sign in with a member account to read this packet.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div>{% endif %}{% endif %}</div></section>
