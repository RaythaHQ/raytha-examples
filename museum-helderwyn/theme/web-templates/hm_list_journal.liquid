<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Journal</li></ol><p class="kick">Journal</p><h1>From the building</h1><p class="lede">Exhibition installs, new labels, school desk changes and Vault notes.</p></div></div>
<section class="sec tight"><div class="w"><div class="nlist">{% for n in Target.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv27 -%}{{ y.kind }}{%- endcapture %}{% case lv27 %}{% when "exhibitions" %}Exhibitions{% when "collections" %}Collections{% when "programs" %}Programs{% when "building" %}Building{% when "community" %}Community{% else %}{{ lv27 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span class="muted">{{ y.summary }}</span></a>{% endfor %}</div></div></section>
