<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Helderwyn Museum of Making" %}{{ Target.Title }} | {% endif %}Helderwyn Museum of Making</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Helderwyn Museum of Making (fictional): a craft, tools and industrial-design museum in Rookwater. Exhibitions, a floor-plan of galleries, collection objects with accession labels, programs, and members-only packets. Built on Raytha, a self-hosted, open-source .NET CMS for museum websites.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Public+Sans:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet"><style>
:root{--ink:#1c1916;--paper:#f3efe6;--wall:#ebe4d6;--rule:#c9bda8;--red:#8b3a2a;--brass:#a07840;--moss:#2f4a3c;--clay:#6b5a3a;--muted:#6a6258;--card:#fffaf0;--shadow:rgba(28,25,22,.12)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.55 "Public Sans",system-ui,sans-serif}
a{color:var(--red);text-decoration-thickness:1px;text-underline-offset:3px}a:hover{color:var(--ink)}
img{max-width:100%;height:auto;display:block}h1,h2,h3,h4{font-family:"Source Serif 4",Georgia,serif;font-weight:600;line-height:1.2;margin:0}
.w{width:min(1120px,calc(100% - 40px));margin:0 auto}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;padding:8px 12px;z-index:9}
.top{background:var(--ink);color:#d8d0c4;font-size:.78rem;letter-spacing:.04em}.top .w{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:8px 0;flex-wrap:wrap}
.top a{color:#f3efe6;margin-left:14px;text-decoration:none}.top a:hover{text-decoration:underline}.top .fict{opacity:.75}.top .hm{opacity:.7;margin-left:10px}
.top input{background:#2a2622;border:1px solid #4a443c;color:#f3efe6;padding:6px 10px;border-radius:2px;width:min(220px,40vw);font:inherit}
.hdr{border-bottom:1px solid var(--rule);background:var(--wall)}.hdr .w{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px 0;flex-wrap:wrap}
.brand{display:flex;gap:14px;align-items:center;text-decoration:none;color:var(--ink)}.brand b{display:block;font:600 1.15rem/1.15 "Source Serif 4",serif}.brand small{display:block;font:700 .68rem/1.3 "Courier Prime",monospace;letter-spacing:.12em;color:var(--muted);margin-top:4px}
.drawers ol{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:4px 18px}.drawers a{color:var(--ink);text-decoration:none;font-weight:600;font-size:.92rem}.drawers a:hover{color:var(--red)}
.kick{font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin:0 0 10px}
.lede{font-size:1.12rem;color:var(--muted);max-width:40rem;margin:12px 0 0}.cta{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#f3efe6;padding:11px 18px;border:0;border-radius:2px;font:600 .95rem/1 "Public Sans",sans-serif;text-decoration:none;cursor:pointer}
.btn:hover{background:var(--red);color:#fff}.btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}.btn.line:hover{background:var(--ink);color:#f3efe6}.btn.sm{padding:8px 12px;font-size:.85rem}
.phead{padding:42px 0 28px;background:linear-gradient(180deg,var(--wall),var(--paper));border-bottom:1px solid var(--rule)}
.crumbs{list-style:none;margin:0 0 14px;padding:0;display:flex;flex-wrap:wrap;gap:8px;font-size:.85rem;color:var(--muted)}.crumbs a{color:var(--muted)}.crumbs li:not(:last-child)::after{content:"/";margin-left:8px;opacity:.5}
.sec{padding:48px 0}.sec.tight{padding:36px 0}.muted{color:var(--muted)}.tw{font-family:"Courier Prime",monospace}
.hero{padding:48px 0 56px;background:var(--wall);border-bottom:1px solid var(--rule)}.hero .g{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:40px;align-items:start}
.hero h1{font-size:clamp(2rem,4vw,3rem);max-width:16ch}.today-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.today-strip span{background:var(--ink);color:#f3efe6;font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.1em;padding:8px 12px}
.wall{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.ocard{background:var(--card);border:1px solid var(--rule);padding:0;text-decoration:none;color:inherit;display:flex;flex-direction:column;box-shadow:0 1px 0 var(--shadow);transition:transform .15s}
.ocard:hover{transform:translateY(-3px)}.ocard img{aspect-ratio:4/5;object-fit:cover;background:#ddd}.ocard .lab{padding:14px 16px 18px;border-top:3px solid var(--c,var(--moss));font-size:.92rem}
.ocard .acc{font:700 .72rem/1.3 "Courier Prime",monospace;letter-spacing:.06em;color:var(--red);margin-bottom:6px}.ocard b{font-family:"Source Serif 4",serif;font-size:1.05rem;display:block;margin-bottom:4px}.ocard small{color:var(--muted);display:block;line-height:1.4}
.plan{background:var(--card);border:1px solid var(--rule);position:relative;aspect-ratio:16/10;margin-top:18px;overflow:hidden}
.plan .room{position:absolute;border:2px solid var(--ink);background:color-mix(in srgb,var(--c,#aaa) 28%,var(--card));display:flex;align-items:flex-end;padding:10px 12px;text-decoration:none;color:var(--ink);font:700 .78rem/1.2 "Courier Prime",monospace;letter-spacing:.04em}
.plan .room:hover{background:color-mix(in srgb,var(--c,#aaa) 48%,var(--card));z-index:2}.plan .room span{background:rgba(243,239,230,.9);padding:2px 6px}
.shead{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:22px}.shead p{margin:8px 0 0;max-width:40rem;color:var(--muted)}
.exgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.excard{background:var(--card);border:1px solid var(--rule);text-decoration:none;color:inherit;display:flex;flex-direction:column}
.excard img{aspect-ratio:16/10;object-fit:cover}.excard .b{padding:16px 18px 20px;border-top:4px solid var(--c,var(--red))}.excard .st{font:700 .7rem/1 "Courier Prime",monospace;letter-spacing:.12em;color:var(--red)}.excard h3{margin:8px 0 6px;font-size:1.25rem}.excard .sub{color:var(--muted);font-size:.95rem}
.evlist{list-style:none;margin:0;padding:0;display:grid;gap:10px}.evlist li,.ev{display:grid;grid-template-columns:140px 1fr;gap:14px;padding:14px 16px;background:var(--card);border:1px solid var(--rule);align-items:start;text-decoration:none;color:inherit}
.evlist .stamp,.ev i{font:700 .78rem/1.3 "Courier Prime",monospace;letter-spacing:.04em;color:var(--red);font-style:normal}.evlist b,.ev b{font-family:"Source Serif 4",serif;display:block}.evlist small,.ev small{color:var(--muted)}
.chip{display:inline-block;font:700 .68rem/1 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase;padding:4px 8px;border:1px solid var(--rule);margin-right:6px;background:var(--wall)}.chip.lock{border-color:var(--red);color:var(--red)}.chip.on{background:var(--ink);color:#f3efe6;border-color:var(--ink)}
.chip.members{border-color:var(--brass);color:#6a4e20}.chip.staff{background:var(--moss);color:#fff;border-color:var(--moss)}.chip.public{border-color:var(--rule)}
.nlist{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.nitem{text-decoration:none;color:inherit;background:var(--card);border:1px solid var(--rule)}.nitem img{aspect-ratio:16/9;object-fit:cover}.nitem small{display:block;padding:12px 14px 0;font:700 .7rem/1 "Courier Prime",monospace;letter-spacing:.1em;color:var(--red)}.nitem b{display:block;padding:8px 14px 0;font-family:"Source Serif 4",serif;font-size:1.15rem}.nitem span{display:block;padding:8px 14px 16px;color:var(--muted);font-size:.95rem}
.band{background:var(--moss);color:#f3efe6;padding:36px 0}.band .w{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}.band h2{color:#fff;font-size:1.6rem;max-width:20ch}.band p{margin:8px 0 0;max-width:36rem;opacity:.9}.band .btn{background:#f3efe6;color:var(--moss)}.band .btn:hover{background:#fff}
.foot{background:#171411;color:#bdb4a6;padding:48px 0 28px;margin-top:0}.foot a{color:#e8e0d4;text-decoration:none}.foot a:hover{text-decoration:underline}.fg{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:28px}.fg h4{color:#fff;font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.12em;text-transform:uppercase;margin:0 0 14px}.fg ul{list-style:none;margin:0;padding:0}.fg li{margin:0 0 8px}.disc{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid #2e2924;margin-top:36px;padding-top:18px;font-size:.82rem;opacity:.75}
.dg{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,.7fr);gap:36px;align-items:start}.prose p{margin:0 0 1em}.prose h2{margin:1.4em 0 .5em;font-size:1.4rem}
.panel,.wlabel{background:var(--card);border:1px solid var(--rule);padding:20px 22px}.wlabel{border-top:4px solid var(--c,var(--moss))}.wlabel .acc{font:700 .78rem/1.3 "Courier Prime",monospace;letter-spacing:.06em;color:var(--red)}.wlabel h2{margin:8px 0 6px;font-size:1.5rem}.wlabel .meta{font-size:.95rem;color:var(--muted);margin-top:10px;line-height:1.5}
.kv{display:grid;grid-template-columns:120px 1fr;gap:8px 14px;margin:0}.kv dt{font:700 .72rem/1.4 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.kv dd{margin:0}
.lockp{background:var(--wall);border:1px dashed var(--rule);padding:32px 28px;max-width:560px}.lockp h2{margin:8px 0 12px;font-size:1.5rem}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.filters a{text-decoration:none;color:var(--ink);border:1px solid var(--rule);padding:7px 12px;font-size:.88rem;background:var(--card)}.filters a.on,.filters a:hover{background:var(--ink);color:#f3efe6;border-color:var(--ink)}
.gcard{display:grid;grid-template-columns:200px 1fr;gap:22px;padding:18px 0;border-bottom:1px solid var(--rule);align-items:center}.gcard img{border:1px solid var(--rule);background:var(--wall)}.gcard h2{font-size:1.4rem;margin-bottom:6px}
.plist{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.pcard{text-decoration:none;color:inherit;background:var(--card);border:1px solid var(--rule);padding:22px;border-top:4px solid var(--c,var(--moss))}.pcard .r{font:700 .7rem/1 "Courier Prime",monospace;letter-spacing:.1em;color:var(--red)}.pcard h3{margin:10px 0 6px}.pcard p{margin:0;color:var(--muted);font-size:.95rem}
.pkgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.pk{display:block;text-decoration:none;color:inherit;background:var(--card);border:1px solid var(--rule);padding:18px 20px}.pk b{font-family:"Source Serif 4",serif;display:block;margin:8px 0 6px}.pk .s{color:var(--muted);font-size:.95rem}
.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.note{background:var(--card);border:1px solid var(--rule);padding:18px}.note h3{margin:10px 0 8px;font-size:1.1rem}
.ol2{list-style:none;margin:22px 0 0;padding:0;counter-reset:s;display:grid;gap:14px}.ol2 li{background:var(--card);border:1px solid var(--rule);padding:18px 20px 18px 64px;position:relative}.ol2 li::before{counter-increment:s;content:counter(s, decimal-leading-zero);position:absolute;left:16px;top:18px;font:700 .9rem/1 "Courier Prime",monospace;color:var(--red)}.ol2 h3{margin:0 0 6px}.ol2 p{margin:0;color:var(--muted)}
.sched{width:100%;border-collapse:collapse}.sched th,.sched td{border-bottom:1px solid var(--rule);padding:10px 12px;text-align:left}.sched th{font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.tscroll{overflow-x:auto}.htable{width:100%;border-collapse:collapse}.htable td{padding:8px 0;border-bottom:1px solid var(--rule)}.htable tr.now td{font-weight:700;color:var(--red)}
.status{font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.1em;padding:6px 10px;border:1px solid var(--rule)}.status.now{background:var(--moss);color:#fff;border-color:var(--moss)}.status.soon{background:var(--brass);color:#fff;border-color:var(--brass)}.status.past{opacity:.7}
.bigstamp{display:inline-block;font:700 1rem/1.3 "Courier Prime",monospace;letter-spacing:.06em;color:var(--red);border:2px solid var(--red);padding:10px 14px;margin-bottom:22px}
.searchbar{display:flex;gap:8px;margin-top:18px;max-width:560px}.searchbar input{flex:1;padding:12px 14px;border:1px solid var(--rule);font:inherit;background:var(--card)}.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit}.hit b{font-family:"Source Serif 4",serif;font-size:1.15rem}.hit p{margin:6px 0 0;color:var(--muted);font-size:.95rem}
.mcard{background:linear-gradient(135deg,#2f4a3c,#1c1916);color:#f3efe6;padding:28px;border-radius:2px;position:relative;overflow:hidden}.mcard .nm{font:600 1.1rem/1 "Source Serif 4",serif}.mcard .sub{font:700 .68rem/1 "Courier Prime",monospace;letter-spacing:.14em;opacity:.7;margin-top:8px}.mcard .who{font:600 1.6rem/1.2 "Source Serif 4",serif;margin-top:28px}.mcard .bc{margin-top:24px;font:700 .85rem/1.4 "Courier Prime",monospace;letter-spacing:.08em;opacity:.85}
.feat{list-style:none;margin:0;padding:0;display:grid;gap:8px}.feat li{padding:10px 14px;background:var(--wall);border-left:3px solid var(--moss)}
.notice{background:#f7e8d8;border:1px solid #e0c9a8;padding:14px 16px;margin:0 0 18px}
label{display:block;font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.1em;text-transform:uppercase;margin-bottom:6px}
input[type=email],input[type=password],input[type=text]{width:100%;padding:12px 14px;border:1px solid var(--rule);font:inherit;background:var(--card)}
@media(max-width:900px){.hero .g,.dg,.fg,.wall,.exgrid,.nlist,.plist,.pkgrid,.notes,.gcard{grid-template-columns:1fr}.wall{grid-template-columns:1fr 1fr}.evlist li,.ev{grid-template-columns:1fr}.plan{aspect-ratio:1/1.1}.hdr .w{align-items:flex-start}}
@media(max-width:560px){.wall{grid-template-columns:1fr}.today-strip span{width:100%}.w{width:calc(100% - 28px)}}
</style></head><body>
