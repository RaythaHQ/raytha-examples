<main id="main">{% renderbody %}</main>
<footer class="foot"><div class="w"><div class="fg"><div><div style="display:flex;gap:12px;align-items:center"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect x="1" y="1" width="44" height="44" rx="2" fill="#2f4a3c"/><rect x="8" y="10" width="30" height="22" fill="#f3efe6"/><path d="M10 16H36" stroke="#8b3a2a" stroke-width="2"/><text x="23" y="28" text-anchor="middle" font-family="Courier New,monospace" font-size="7" fill="#1c1916">HMM</text><rect x="14" y="36" width="18" height="3" fill="#a07840"/></svg><b style="color:#fff;font:600 1.2rem 'Source Serif 4',serif">Helderwyn Museum of Making</b></div><p style="margin-top:14px;max-width:380px">12 Mill Reach, Rookwater (fictional). Desk: (555) 014-8800. The museum, its galleries, people and figures are fictional; this is a Raytha example site.</p></div>
<div><h4>Visit</h4><ul><li><a href="{{ PathBase }}/visit">Hours and admission</a></li><li><a href="{{ PathBase }}/galleries">Floor plan</a></li><li><a href="{{ PathBase }}/programs">Programs</a></li><li><a href="{{ PathBase }}/membership">Membership</a></li></ul></div>
