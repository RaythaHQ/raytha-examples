<div class="top"><div class="w"><span class="fict">FICTIONAL MUSEUM · RAYTHA EXAMPLE SITE</span><div>{% if CurrentUser.IsAuthenticated %}<span class="hm">Signed in as <b style="color:#fff">{{ CurrentUser.FirstName }}</b></span><a href="{{ PathBase }}/members">Members</a><a href="{{ PathBase }}/account/logout">Sign out</a>{% else %}<a href="{{ PathBase }}/account/login?returnUrl=/members">Member sign-in</a><a class="hm" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Staff</a>{% endif %}<form action="{{ PathBase }}/search" role="search" style="display:inline"><input name="q" aria-label="Search the site" placeholder="Search collection, shows…"></form></div></div></div>
<header class="hdr"><div class="w"><a class="brand" href="{{ PathBase }}/"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect x="1" y="1" width="44" height="44" rx="2" fill="#2f4a3c"/><rect x="8" y="10" width="30" height="22" fill="#f3efe6"/><path d="M10 16H36" stroke="#8b3a2a" stroke-width="2"/><text x="23" y="28" text-anchor="middle" font-family="Courier New,monospace" font-size="7" fill="#1c1916">HMM</text><rect x="14" y="36" width="18" height="3" fill="#a07840"/></svg><span><b>Helderwyn Museum of Making</b><small>ROOKWATER · ACCESSION WALL · SINCE 1884</small></span></a>
