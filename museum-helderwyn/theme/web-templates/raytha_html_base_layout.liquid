<div><h4>Museum</h4><ul>{%- assign fm = get_menu("footer") -%}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div></div>
<div class="disc"><span>© 2026 Helderwyn Museum of Making (fictional) · 555 phone numbers · no payment or registration forms on this site.</span><span>Server-rendered with Raytha · works without JavaScript</span></div></div></footer></body></html>
