{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign fa = QueryParams.for | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Programs</li></ol><p class="kick">Programs</p><h1>Tours, demos, talks and member evenings</h1><p class="lede">Public programs are open with admission. Member and staff programs appear when you are signed in.</p><div class="filters"><a href="{{ PathBase }}/programs" class="{% if fa == "" %}on{% endif %}">Everyone</a><a href="{{ PathBase }}/programs?for=public" class="{% if fa == "public" %}on{% endif %}">Public</a><a href="{{ PathBase }}/programs?for=members" class="{% if fa == "members" %}on{% endif %}">Members</a><a href="{{ PathBase }}/programs?for=staff" class="{% if fa == "staff" %}on{% endif %}">Staff</a></div></div></div>
<section class="sec tight"><div class="w"><ul class="evlist">{% for p in Target.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_members == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}{% if fa == "" or fa == au or fa == "everyone" %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv19 -%}{{ y.audience }}{%- endcapture %}{% case lv19 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv19 }}{% endcase %}</span><small>{% capture lv20 -%}{{ y.kind }}{%- endcapture %}{% case lv20 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv20 }}{% endcase %} · {{ y.where_label }}</small></div></li>{% endif %}{% endif %}{% endfor %}</ul>
<p class="muted" style="margin-top:22px">Member and staff programs stay hidden when you are signed out. There are no registration forms on this site.</p></div></section>
