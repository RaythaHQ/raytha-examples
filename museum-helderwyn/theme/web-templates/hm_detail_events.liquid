{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_members == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{%- capture gc -%}{{ x.gallery }}{%- endcapture -%}{%- capture f -%}code eq '{{ gc }}'{%- endcapture -%}{%- assign gq = get_content_items(ContentType="galleries", Filter=f, PageSize=1) -%}{%- assign g = gq.Items | first -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/programs">Programs</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv21 -%}{{ x.kind }}{%- endcapture %}{% case lv21 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv21 }}{% endcase %} · {% capture lv22 -%}{{ x.audience }}{%- endcapture %}{% case lv22 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv22 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:16px 0 0"><span class="chip {{ au }}">{% capture lv23 -%}{{ x.audience }}{%- endcapture %}{% case lv23 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv23 }}{% endcase %}</span><span class="chip">{{ x.when_label }}</span></p></div></div>
<section class="sec tight"><div class="w">{% if ok %}<div class="dg"><div><span class="bigstamp">{{ x.when_label }}</span><div class="prose">{{ x.body }}</div>
<div class="panel" style="margin-top:24px"><dl class="kv"><dt>Where</dt><dd>{{ x.where_label }}{% if g %} · <a href="{{ PathBase }}/{{ g.RoutePath }}">{{ g.PrimaryField }}</a>{% endif %}</dd><dt>Host</dt><dd>{{ x.host }}</dd><dt>Seats</dt><dd>{{ x.seats }}</dd><dt>Kind</dt><dd>{% capture lv24 -%}{{ x.kind }}{%- endcapture %}{% case lv24 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv24 }}{% endcase %}</dd></dl></div></div>
<aside class="wlabel" style="--c:var(--moss)"><div class="acc">PROGRAM LABEL</div><h2 style="font-size:1.2rem">{{ Target.PrimaryField }}</h2><p class="meta">{{ x.summary }}</p></aside></div>
{% else %}{% if au == "staff" %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Signed-in museum staff see this program.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Members</p><h2>Sign in with a member account to see this program.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div>{% endif %}{% endif %}</div></section>
