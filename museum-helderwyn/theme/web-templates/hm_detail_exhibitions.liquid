{%- assign x=Target.PublishedContent -%}{%- capture es -%}{{ x.status }}{%- endcapture -%}{%- capture gc -%}{{ x.gallery }}{%- endcapture -%}{%- capture ol -%}{{ x.objects }}{%- endcapture -%}{%- assign objs = get_content_items(ContentType="objects", OrderBy="sort_order asc", PageSize=40) -%}{%- capture f -%}code eq '{{ gc }}'{%- endcapture -%}{%- assign gq = get_content_items(ContentType="galleries", Filter=f, PageSize=1) -%}{%- assign g = gq.Items | first -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/exhibitions">Exhibitions</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv8 -%}{{ x.kind }}{%- endcapture %}{% case lv8 %}{% when "solo" %}Solo exhibition{% when "group" %}Group exhibition{% when "permanent" %}Permanent gallery{% when "loan" %}Loan exhibition{% else %}{{ lv8 }}{% endcase %} · {% capture lv9 -%}{{ x.status }}{%- endcapture %}{% case lv9 %}{% when "now" %}On view{% when "soon" %}Upcoming{% when "past" %}Closed{% else %}{{ lv9 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.subtitle }}</p><p style="margin:16px 0 0"><span class="status {{ es }}">{% capture lv10 -%}{{ x.status }}{%- endcapture %}{% case lv10 %}{% when "now" %}On view{% when "soon" %}Upcoming{% when "past" %}Closed{% else %}{{ lv10 }}{% endcase %}</span> <span class="chip">{{ x.dates }}</span> <span class="chip">{% capture lv11 -%}{{ x.gallery }}{%- endcapture %}{% case lv11 %}{% when "entry" %}Entry Hall{% when "tools" %}Tool Hall{% when "textiles" %}Textile Wing{% when "ceramics" %}Ceramic Court{% when "workshop" %}Workshop Gallery{% when "vault" %}Study Vault{% else %}{{ lv11 }}{% endcase %}</span></p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.art.Value | attachment_redirect_url }}" alt="" style="border:1px solid var(--rule);margin-bottom:24px"><div class="prose">{{ x.body }}</div>
<h2 style="margin:32px 0 14px;font-size:1.4rem">Featured objects</h2><div class="wall" style="grid-template-columns:repeat(3,1fr)">{%- assign accs = ol | split: "|" -%}{% for p in objs.Items %}{%- assign y=p.PublishedContent -%}{% if accs contains y.accession %}{%- assign y=p.PublishedContent -%}{%- capture oc -%}{{ y.color }}{%- endcapture -%}<a class="ocard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ oc }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="Generated image for {{ p.PrimaryField }}" loading="lazy"><div class="lab"><div class="acc">{{ y.accession }}</div><b>{{ p.PrimaryField }}</b><small>{{ y.maker }} · {{ y.date_label }}</small></div></a>{% endif %}{% endfor %}</div></div>
<aside><div class="wlabel" style="--c:{{ x.color }}"><div class="acc">WALL TEXT</div><h2 style="font-size:1.25rem">{{ Target.PrimaryField }}</h2><p class="meta">{{ x.wall_text }}</p><p class="meta" style="margin-top:16px"><b>Curator</b> — {{ x.curator }}<br><b>Gallery</b> — {% if g %}<a href="{{ PathBase }}/{{ g.RoutePath }}">{{ g.PrimaryField }}</a>{% else %}{% capture lv12 -%}{{ x.gallery }}{%- endcapture %}{% case lv12 %}{% when "entry" %}Entry Hall{% when "tools" %}Tool Hall{% when "textiles" %}Textile Wing{% when "ceramics" %}Ceramic Court{% when "workshop" %}Workshop Gallery{% when "vault" %}Study Vault{% else %}{{ lv12 }}{% endcase %}{% endif %}<br><b>Dates</b> — {{ x.dates }}</p></div></aside></div></div></section>
