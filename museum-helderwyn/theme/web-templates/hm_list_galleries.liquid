<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Galleries</li></ol><p class="kick">Floor plan · galleries</p><h1>Six rooms on the plan</h1><p class="lede">Public galleries on the ground and upper floors; the Study Vault is for members and researchers.</p></div></div>
<section class="sec tight"><div class="w">{%- assign gals = Target.Items -%}<div class="plan" style="margin-bottom:36px" role="img" aria-label="Museum floor plan">{% for g in gals %}{%- assign z=g.PublishedContent -%}<a class="room" href="{{ PathBase }}/{{ g.RoutePath }}" style="left:{{ z.plan_x }}%;top:{{ z.plan_y }}%;width:{{ z.plan_w }}%;height:{{ z.plan_h }}%;--c:{{ z.color }}"><span>{{ g.PrimaryField }}</span></a>{% endfor %}</div>
{% for g in Target.Items %}{%- assign z=g.PublishedContent -%}<div class="gcard"><a href="{{ PathBase }}/{{ g.RoutePath }}"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="" loading="lazy"></a><div><p class="kick">{{ z.floor }} · {{ z.wing }}</p><h2><a href="{{ PathBase }}/{{ g.RoutePath }}">{{ g.PrimaryField }}</a></h2><p class="muted">{{ z.summary }}</p><p class="muted" style="margin-top:8px;font-size:.9rem">{{ z.hours }}</p></div></div>{% endfor %}</div></section>
