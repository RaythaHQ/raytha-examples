{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Packets</li></ol><p class="kick">Packets</p><h1>Exhibition packets and checklists</h1><p class="lede">Some packets are public; exhibition packets and favorites need a member account; loan checklists need staff.</p></div></div>
<section class="sec tight"><div class="w"><div class="pkgrid">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_members == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if au != "staff" or in_staff %}{% if au != "members" or in_members or au == "public" %}<a class="pk" href="{{ PathBase }}/{{ r.RoutePath }}">{% if au == "members" %}<span class="chip lock">🔒 Members</span>{% elsif au == "staff" %}<span class="chip on">Staff</span>{% else %}<span class="chip">Public</span>{% endif %}<span class="chip">{% capture lv29 -%}{{ x.kind }}{%- endcapture %}{% case lv29 %}{% when "packet" %}Exhibition packet{% when "favorites" %}Favorites list{% when "event" %}Member event{% when "checklist" %}Loan checklist{% when "notes" %}Gallery notes{% when "procedure" %}Procedure{% else %}{{ lv29 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endif %}{% endfor %}</div></div></section>
