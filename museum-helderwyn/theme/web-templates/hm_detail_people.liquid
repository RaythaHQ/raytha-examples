{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/people">People</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv26 -%}{{ x.role }}{%- endcapture %}{% case lv26 %}{% when "director" %}Director{% when "curator" %}Curator{% when "educator" %}Educator{% when "registrar" %}Registrar{% when "docent" %}Docent lead{% else %}{{ lv26 }}{% endcase %} · since {{ x.since }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.title_line }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="prose"><p class="muted">{{ x.summary }}</p>{{ x.body }}</div>
<aside class="wlabel" style="--c:{{ x.color }}"><div class="acc">STAFF LABEL</div><h2>{{ Target.PrimaryField }}</h2><p class="meta">{{ x.title_line }}<br>Focus: {{ x.focus }}<br>At Helderwyn since {{ x.since }}</p><img src="{{ x.portrait.Value | attachment_redirect_url }}" alt="" style="margin-top:16px;border:1px solid var(--rule)"></aside></div></div></section>
