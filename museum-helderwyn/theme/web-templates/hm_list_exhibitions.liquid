{%- assign fs = QueryParams.status | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Exhibitions</li></ol><p class="kick">Exhibitions</p><h1>On the wall and on the calendar</h1><p class="lede">Current shows, permanent galleries and upcoming openings. Each exhibition page includes wall text and featured accession numbers.</p><div class="filters"><a href="{{ PathBase }}/exhibitions" class="{% if fs == "" %}on{% endif %}">All</a><a href="{{ PathBase }}/exhibitions?status=now" class="{% if fs == "now" %}on{% endif %}">On view</a><a href="{{ PathBase }}/exhibitions?status=soon" class="{% if fs == "soon" %}on{% endif %}">Upcoming</a><a href="{{ PathBase }}/exhibitions?status=past" class="{% if fs == "past" %}on{% endif %}">Closed</a></div></div></div>
<section class="sec tight"><div class="w"><div class="exgrid">{% for e in Target.Items %}{%- capture st -%}{{ e.PublishedContent.status }}{%- endcapture -%}{% if fs == "" or fs == st %}{%- assign y=e.PublishedContent -%}{%- capture ec -%}{{ y.color }}{%- endcapture -%}{%- capture es -%}{{ y.status }}{%- endcapture -%}<a class="excard" href="{{ PathBase }}/{{ e.RoutePath }}" style="--c:{{ ec }}"><img src="{{ y.art.Value | attachment_redirect_url }}" alt="" loading="lazy"><div class="b"><span class="st">{% capture lv6 -%}{{ y.status }}{%- endcapture %}{% case lv6 %}{% when "now" %}On view{% when "soon" %}Upcoming{% when "past" %}Closed{% else %}{{ lv6 }}{% endcase %} · {% capture lv7 -%}{{ y.gallery }}{%- endcapture %}{% case lv7 %}{% when "entry" %}Entry Hall{% when "tools" %}Tool Hall{% when "textiles" %}Textile Wing{% when "ceramics" %}Ceramic Court{% when "workshop" %}Workshop Gallery{% when "vault" %}Study Vault{% else %}{{ lv7 }}{% endcase %}</span><h3>{{ e.PrimaryField }}</h3><p class="sub">{{ y.subtitle }}</p><p class="muted" style="margin:10px 0 0;font-size:.9rem">{{ y.dates }}</p></div></a>{% endif %}{% endfor %}</div></div></section>
