{%- assign x=Target.PublishedContent -%}{%- capture gc -%}{{ x.code }}{%- endcapture -%}{%- capture f -%}gallery eq '{{ gc }}'{%- endcapture -%}{%- assign objs = get_content_items(ContentType="objects", Filter=f, OrderBy="sort_order asc", PageSize=12) -%}{%- assign exs = get_content_items(ContentType="exhibitions", Filter=f, OrderBy="sort_order asc", PageSize=6) -%}{%- assign evs = get_content_items(ContentType="events", Filter=f, OrderBy="sort_order asc", PageSize=8) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/galleries">Galleries</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ x.floor }} · {{ x.wing }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.art.Value | attachment_redirect_url }}" alt="" style="border:1px solid var(--rule);margin-bottom:24px"><div class="prose">{{ x.body }}</div>
<h2 style="margin:28px 0 12px;font-size:1.35rem">Highlights</h2>{%- assign hs = x.highlights | split: "|" -%}<ul class="feat">{% for i in hs %}<li>{{ i }}</li>{% endfor %}</ul></div>
<aside class="panel"><p class="kick">On the plan</p><dl class="kv"><dt>Floor</dt><dd>{{ x.floor }}</dd><dt>Wing</dt><dd>{{ x.wing }}</dd><dt>Hours</dt><dd>{{ x.hours }}</dd><dt>Code</dt><dd class="tw">{{ x.code }}</dd></dl>
{% if exs.TotalCount > 0 %}<p class="kick" style="margin-top:22px">Exhibitions here</p>{% for e in exs.Items %}<p style="margin:0 0 8px"><a href="{{ PathBase }}/{{ e.RoutePath }}">{{ e.PrimaryField }}</a></p>{% endfor %}{% endif %}</aside></div>
{% if objs.TotalCount > 0 %}<h2 style="margin:36px 0 18px;font-size:1.4rem">Objects in this gallery</h2><div class="wall">{% for p in objs.Items %}{%- assign y=p.PublishedContent -%}{%- capture oc -%}{{ y.color }}{%- endcapture -%}<a class="ocard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ oc }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="Generated image for {{ p.PrimaryField }}" loading="lazy"><div class="lab"><div class="acc">{{ y.accession }}</div><b>{{ p.PrimaryField }}</b><small>{{ y.maker }} · {{ y.date_label }}</small></div></a>{% endfor %}</div>{% endif %}
{% if evs.TotalCount > 0 %}<h2 style="margin:36px 0 18px;font-size:1.4rem">Programs here</h2><ul class="evlist">{% for p in evs.Items %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv17 -%}{{ y.audience }}{%- endcapture %}{% case lv17 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv17 }}{% endcase %}</span><small>{% capture lv18 -%}{{ y.kind }}{%- endcapture %}{% case lv18 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv18 }}{% endcase %} · {{ y.where_label }}</small></div></li>{% endfor %}</ul>{% endif %}</div></section>
