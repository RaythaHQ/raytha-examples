<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>People</li></ol><p class="kick">People</p><h1>Curators, educators and staff</h1><p class="lede">The fictional team behind Helderwyn's galleries, loans and school programs.</p></div></div>
<section class="sec tight"><div class="w"><div class="plist">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ y.color }}"><span class="r">{% capture lv25 -%}{{ y.role }}{%- endcapture %}{% case lv25 %}{% when "director" %}Director{% when "curator" %}Curator{% when "educator" %}Educator{% when "registrar" %}Registrar{% when "docent" %}Docent lead{% else %}{{ lv25 }}{% endcase %}</span><h3>{{ p.PrimaryField }}</h3><p>{{ y.title_line }} · {{ y.focus }}</p></a>{% endfor %}</div></div></section>
