{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/journal">Journal</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{{ x.date_label }} · {% capture lv28 -%}{{ x.kind }}{%- endcapture %}{% case lv28 %}{% when "exhibitions" %}Exhibitions{% when "collections" %}Collections{% when "programs" %}Programs{% when "building" %}Building{% when "community" %}Community{% else %}{{ lv28 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="prose"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="margin-bottom:24px;border:1px solid var(--rule)">{{ x.body }}<p class="muted" style="margin-top:24px">— {{ x.author }}</p></div>
<aside class="wlabel" style="--c:var(--moss)"><div class="acc">JOURNAL</div><h2 style="font-size:1.15rem">Ask the desk</h2><p class="meta">(555) 014-8800<br>Tue–Sun 10 am – 5 pm<br>School desk weekdays from 9 am</p></aside></div></div></section>
