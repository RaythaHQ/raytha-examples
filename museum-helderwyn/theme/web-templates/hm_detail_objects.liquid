{%- assign x=Target.PublishedContent -%}{%- capture gc -%}{{ x.gallery }}{%- endcapture -%}{%- capture ok -%}{{ x.kind }}{%- endcapture -%}{%- capture ov -%}{{ x.on_view }}{%- endcapture -%}{%- capture f -%}gallery eq '{{ gc }}'{%- endcapture -%}{%- assign more = get_content_items(ContentType="objects", Filter=f, OrderBy="sort_order asc", PageSize=8) -%}{%- capture f2 -%}code eq '{{ gc }}'{%- endcapture -%}{%- assign gq = get_content_items(ContentType="galleries", Filter=f2, PageSize=1) -%}{%- assign g = gq.Items | first -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/collection">Collection</a></li><li>{{ x.accession }}</li></ol><p class="kick">{% capture lv13 -%}{{ x.kind }}{%- endcapture %}{% case lv13 %}{% when "tool" %}Tool{% when "textile" %}Textile{% when "ceramic" %}Ceramic{% when "drawing" %}Drawing{% when "furniture" %}Furniture{% when "machine" %}Machine{% else %}{{ lv13 }}{% endcase %} · {% capture lv14 -%}{{ x.on_view }}{%- endcapture %}{% case lv14 %}{% when "yes" %}On view{% when "no" %}In storage{% else %}{{ lv14 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.maker }} · {{ x.date_label }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt="Generated image for {{ Target.PrimaryField }}" style="border:1px solid var(--rule);margin-bottom:24px"><div class="prose">{{ x.body }}</div></div>
<aside class="wlabel" style="--c:{{ x.color }}"><div class="acc">{{ x.accession }}</div><h2>{{ Target.PrimaryField }}</h2><p class="meta">{{ x.label_text }}</p>
<dl class="kv" style="margin-top:18px"><dt>Maker</dt><dd>{{ x.maker }}</dd><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Materials</dt><dd>{{ x.materials }}</dd><dt>Dimensions</dt><dd>{{ x.dims }}</dd><dt>Gallery</dt><dd>{% if g %}<a href="{{ PathBase }}/{{ g.RoutePath }}">{{ g.PrimaryField }}</a>{% else %}{% capture lv15 -%}{{ x.gallery }}{%- endcapture %}{% case lv15 %}{% when "entry" %}Entry Hall{% when "tools" %}Tool Hall{% when "textiles" %}Textile Wing{% when "ceramics" %}Ceramic Court{% when "workshop" %}Workshop Gallery{% when "vault" %}Study Vault{% else %}{{ lv15 }}{% endcase %}{% endif %}</dd><dt>Credit</dt><dd>{{ x.credit }}</dd><dt>Status</dt><dd>{% capture lv16 -%}{{ x.on_view }}{%- endcapture %}{% case lv16 %}{% when "yes" %}On view{% when "no" %}In storage{% else %}{{ lv16 }}{% endcase %}</dd></dl></aside></div>
<h2 style="margin:40px 0 18px;font-size:1.4rem">Also in this gallery</h2><div class="wall">{% for p in more.Items %}{% if p.RoutePath != Target.RoutePath %}{%- assign y=p.PublishedContent -%}{%- capture oc -%}{{ y.color }}{%- endcapture -%}<a class="ocard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ oc }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="Generated image for {{ p.PrimaryField }}" loading="lazy"><div class="lab"><div class="acc">{{ y.accession }}</div><b>{{ p.PrimaryField }}</b><small>{{ y.maker }} · {{ y.date_label }}</small></div></a>{% endif %}{% endfor %}</div></div></section>
