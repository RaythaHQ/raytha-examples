{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign objs = get_content_items(ContentType="objects", OrderBy="sort_order asc", PageSize=8) -%}
{%- assign exs = get_content_items(ContentType="exhibitions", OrderBy="sort_order asc", PageSize=10) -%}
{%- assign gals = get_content_items(ContentType="galleries", OrderBy="sort_order asc", PageSize=10) -%}
{%- assign evs = get_content_items(ContentType="events", OrderBy="sort_order asc", PageSize=8) -%}
{%- assign nws = get_content_items(ContentType="journal", OrderBy="sort_order asc", PageSize=3) -%}
{%- assign nonview=0 -%}{% for e in exs.Items %}{%- capture st -%}{{ e.PublishedContent.status }}{%- endcapture -%}{% if st == "now" %}{%- assign nonview = nonview | plus: 1 -%}{% endif %}{% endfor %}
<section class="hero"><div class="w g"><div><p class="kick">Rookwater · museum of making</p><h1>Objects on the wall, numbered like a ledger.</h1><p class="lede">Helderwyn is a fictional museum of craft, tools and industrial design. Walk the floor plan, read the accession labels, and sign in as a member for exhibition packets and the Study Vault.</p>
<div class="today-strip"><span>{{ nonview }} ON VIEW</span><span>{{ objs.TotalCount }} OBJECTS LABELED</span><span>{{ gals.TotalCount }} GALLERIES</span></div>
<p class="cta"><a class="btn" href="{{ PathBase }}/exhibitions">Current exhibitions</a><a class="btn line" href="{{ PathBase }}/galleries">Floor plan</a></p></div>
<aside class="wlabel" style="--c:#2f4a3c"><div class="acc">HMM.WALL.001</div><h2 style="font-size:1.35rem">How to read a wall label</h2><p class="meta"><b>Accession number</b> — HMM.year.sequence<br><b>Maker and date</b> — who made it, when<br><b>Materials</b> — what it is made of<br><b>Credit line</b> — gift, purchase or loan<br><br>Every object on this site carries one. Tap a card on the accession wall below.</p></aside></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Accession wall · collection highlights</p><h2>On the wall this season</h2><p>Featured objects with museum wall labels. Each card shows the accession number, maker and date — the same fields on the label in the gallery.</p></div><a class="btn sm line" href="{{ PathBase }}/collection">Full collection →</a></div>
<div class="wall">{% for p in objs.Items limit:8 %}{%- assign y=p.PublishedContent -%}{%- capture oc -%}{{ y.color }}{%- endcapture -%}<a class="ocard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ oc }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="Generated image for {{ p.PrimaryField }}" loading="lazy"><div class="lab"><div class="acc">{{ y.accession }}</div><b>{{ p.PrimaryField }}</b><small>{{ y.maker }} · {{ y.date_label }}</small></div></a>{% endfor %}</div></div></section>
<section class="sec tight" style="background:var(--wall);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)"><div class="w"><div class="shead"><div><p class="kick">Floor plan · galleries</p><h2>Find a gallery on the plan</h2><p>Each room is a link. Public galleries are on the ground and upper floors; the Study Vault is for members and researchers.</p></div><a class="btn sm line" href="{{ PathBase }}/galleries">All galleries →</a></div>
<div class="plan" role="img" aria-label="Museum floor plan">{% for g in gals.Items %}{%- assign z=g.PublishedContent -%}<a class="room" href="{{ PathBase }}/{{ g.RoutePath }}" style="left:{{ z.plan_x }}%;top:{{ z.plan_y }}%;width:{{ z.plan_w }}%;height:{{ z.plan_h }}%;--c:{{ z.color }}"><span>{{ g.PrimaryField }}</span></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Exhibitions</p><h2>On view and upcoming</h2></div><a class="btn sm line" href="{{ PathBase }}/exhibitions">All exhibitions →</a></div>
<div class="exgrid">{%- assign ne=0 -%}{% for e in exs.Items %}{%- capture st -%}{{ e.PublishedContent.status }}{%- endcapture -%}{% if st != "past" and ne < 3 %}{%- assign ne = ne | plus: 1 -%}{%- assign y=e.PublishedContent -%}{%- capture ec -%}{{ y.color }}{%- endcapture -%}{%- capture es -%}{{ y.status }}{%- endcapture -%}<a class="excard" href="{{ PathBase }}/{{ e.RoutePath }}" style="--c:{{ ec }}"><img src="{{ y.art.Value | attachment_redirect_url }}" alt="" loading="lazy"><div class="b"><span class="st">{% capture lv1 -%}{{ y.status }}{%- endcapture %}{% case lv1 %}{% when "now" %}On view{% when "soon" %}Upcoming{% when "past" %}Closed{% else %}{{ lv1 }}{% endcase %} · {% capture lv2 -%}{{ y.gallery }}{%- endcapture %}{% case lv2 %}{% when "entry" %}Entry Hall{% when "tools" %}Tool Hall{% when "textiles" %}Textile Wing{% when "ceramics" %}Ceramic Court{% when "workshop" %}Workshop Gallery{% when "vault" %}Study Vault{% else %}{{ lv2 }}{% endcase %}</span><h3>{{ e.PrimaryField }}</h3><p class="sub">{{ y.subtitle }}</p><p class="muted" style="margin:10px 0 0;font-size:.9rem">{{ y.dates }}</p></div></a>{% endif %}{% endfor %}</div></div></section>
<section class="sec tight"><div class="w"><div class="dg"><div><div class="shead"><div><p class="kick">Programs</p><h2>Tours, demos and talks</h2></div><a class="btn sm line" href="{{ PathBase }}/programs">All programs →</a></div>
<ul class="evlist">{% for p in evs.Items limit:6 %}{%- capture pa -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{% if pa == "public" %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv3 -%}{{ y.audience }}{%- endcapture %}{% case lv3 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv3 }}{% endcase %}</span><small>{% capture lv4 -%}{{ y.kind }}{%- endcapture %}{% case lv4 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv4 }}{% endcase %} · {{ y.where_label }}</small></div></li>{% endif %}{% endfor %}</ul></div>
<div><div class="shead"><div><p class="kick">Journal</p><h2>From the building</h2></div><a class="btn sm line" href="{{ PathBase }}/journal">All journal →</a></div>
<div class="nlist" style="grid-template-columns:1fr">{% for n in nws.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv5 -%}{{ y.kind }}{%- endcapture %}{% case lv5 %}{% when "exhibitions" %}Exhibitions{% when "collections" %}Collections{% when "programs" %}Programs{% when "building" %}Building{% when "community" %}Community{% else %}{{ lv5 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span class="muted">{{ y.summary }}</span></a>{% endfor %}</div></div></div></div></section>
<section class="band"><div class="w"><div><h2>Members read the packets.</h2><p>Exhibition object lists, Vault booking notes and previews sit behind member sign-in. Staff see loan checklists and gallery notes in the staff room.</p></div><a class="btn" href="{{ PathBase }}/membership">About membership</a></div></section>
