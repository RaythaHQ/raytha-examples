{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff room</li></ol><p class="kick">Staff room · museum staff only</p><h1>Staff room</h1><p class="lede">{% if in_staff %}Desk coverage, loan checklists and gallery notes for Helderwyn staff. Names are fictional.{% else %}Schedules and procedures for signed-in museum staff.{% endif %}</p></div></div>
{% if in_staff %}{{ render_section("main", wrap=false) }}{%- assign sp = get_content_items(ContentType="packets", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=20) -%}{%- assign sev = get_content_items(ContentType="events", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><h2 style="margin-bottom:18px">Staff programs</h2><ul class="evlist">{% for p in sev.Items %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv36 -%}{{ y.audience }}{%- endcapture %}{% case lv36 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv36 }}{% endcase %}</span><small>{% capture lv37 -%}{{ y.kind }}{%- endcapture %}{% case lv37 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv37 }}{% endcase %} · {{ y.where_label }}</small></div></li>{% endfor %}</ul></div></section>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:18px">Staff packets</h2><div class="pkgrid">{% for r in sp.Items %}{%- assign x=r.PublishedContent -%}<a class="pk" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="chip on">Staff</span><span class="chip">{% capture lv38 -%}{{ x.kind }}{%- endcapture %}{% case lv38 %}{% when "packet" %}Exhibition packet{% when "favorites" %}Favorites list{% when "event" %}Member event{% when "checklist" %}Loan checklist{% when "notes" %}Gallery notes{% when "procedure" %}Procedure{% else %}{{ lv38 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endfor %}</div></div></section>
{% else %}<section class="sec tight"><div class="w">{% if in_members %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>You are signed in as a member.</h2><p class="muted">The staff room is only for museum staff accounts. Your packets are in <a href="{{ PathBase }}/members">Members</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Museum staff sign in to see the staff room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div>{% endif %}</div></section>{% endif %}
