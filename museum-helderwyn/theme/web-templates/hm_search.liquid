{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the museum site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="calipers, textile, Open Bench"><button class="btn">Search</button></form><p class="muted" style="margin-top:12px;font-size:.95rem">Searches exhibitions, collection objects, galleries, programs, people, journal and packets.</p></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "exhibitions:Exhibitions:title:summary,objects:Collection:title:accession,galleries:Galleries:name:summary,events:Programs:title:summary,people:People:name:summary,journal:Journal:title:summary,packets:Packets:name:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au != "staff" or in_staff %}{% if au != "members" or in_members or au == "public" or au == "" %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "members" %} <span class="chip lock">🔒 Members</span>{% elsif au == "staff" %} <span class="chip on">Staff</span>{% endif %}<p>{% if x.summary %}{{ x.summary | strip_html | truncate: 150 }}{% elsif x.accession %}{{ x.accession }} · {{ x.maker }}{% else %}{{ x.subtitle }}{% endif %}</p></a>{% endif %}{% endif %}{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=calipers">calipers</a>, <a href="?q=textile">textile</a>, <a href="?q=Open">Open Bench</a> or <a href="?q=Vault">Vault</a>.</p>{% endif %}</div></div></section>
