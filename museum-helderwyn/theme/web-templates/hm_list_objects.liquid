{%- assign fk = QueryParams.kind | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Collection</li></ol><p class="kick">Collection · accession file</p><h1>Objects with wall labels</h1><p class="lede">Every object has an accession number (HMM.year.sequence), materials, credit line and a gallery location.</p><div class="filters"><a href="{{ PathBase }}/collection" class="{% if fk == "" %}on{% endif %}">Everything</a><a href="{{ PathBase }}/collection?kind=tool" class="{% if fk == "tool" %}on{% endif %}">Tools</a><a href="{{ PathBase }}/collection?kind=textile" class="{% if fk == "textile" %}on{% endif %}">Textiles</a><a href="{{ PathBase }}/collection?kind=ceramic" class="{% if fk == "ceramic" %}on{% endif %}">Ceramics</a><a href="{{ PathBase }}/collection?kind=furniture" class="{% if fk == "furniture" %}on{% endif %}">Furniture</a></div></div></div>
<section class="sec tight"><div class="w"><div class="wall">{% for p in Target.Items %}{%- capture pk -%}{{ p.PublishedContent.kind }}{%- endcapture -%}{% if fk == "" or fk == pk %}{%- assign y=p.PublishedContent -%}{%- capture oc -%}{{ y.color }}{%- endcapture -%}<a class="ocard" href="{{ PathBase }}/{{ p.RoutePath }}" style="--c:{{ oc }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="Generated image for {{ p.PrimaryField }}" loading="lazy"><div class="lab"><div class="acc">{{ y.accession }}</div><b>{{ p.PrimaryField }}</b><small>{{ y.maker }} · {{ y.date_label }}</small></div></a>{% endif %}{% endfor %}</div></div></section>
