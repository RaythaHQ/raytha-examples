{%- assign in_members=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_members=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_members=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_members=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Members</li></ol><p class="kick">Members room</p><h1>{% if in_members %}Hello, {{ CurrentUser.FirstName }}.{% else %}Members room{% endif %}</h1><p class="lede">{% if in_members %}Your member card, exhibition packets, favorites lists and member events.{% else %}Exhibition packets, Vault booking notes and member events, for signed-in members.{% endif %}</p></div></div>
{% if in_members %}{%- assign pks = get_content_items(ContentType="packets", OrderBy="sort_order asc", PageSize=40) -%}{%- assign mev = get_content_items(ContentType="events", Filter="audience eq 'members'", OrderBy="sort_order asc", PageSize=20) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,400px) minmax(0,1fr)"><div><div class="mcard"><div class="nm">Helderwyn Museum of Making</div><div class="sub">MEMBER CARD · FICTIONAL DEMO</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">HMM-M-{{ CurrentUser.EmailAddress | size | plus: 2200 }} · {% if in_staff %}STAFF{% else %}MEMBER{% endif %}<br>ROOKWATER · STUDY VAULT ACCESS</div></div><p class="muted" style="margin-top:16px;font-size:.92rem">Show this at the Entry Hall desk or the Vault. The card number is fictional.</p></div>
<div><h2 style="margin-bottom:14px">Member programs</h2><ul class="evlist">{% for p in mev.Items %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{{ y.when_label }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv33 -%}{{ y.audience }}{%- endcapture %}{% case lv33 %}{% when "public" %}Everyone{% when "members" %}Members{% when "staff" %}Staff{% else %}{{ lv33 }}{% endcase %}</span><small>{% capture lv34 -%}{{ y.kind }}{%- endcapture %}{% case lv34 %}{% when "tour" %}Tour{% when "talk" %}Talk{% when "workshop" %}Workshop{% when "family" %}Family{% when "member" %}Members{% when "school" %}School group{% else %}{{ lv34 }}{% endcase %} · {{ y.where_label }}</small></div></li>{% endfor %}</ul></div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:18px">Packets for members</h2><div class="pkgrid">{% for r in pks.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au == "members" or au == "public" %}<a class="pk" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="chip">{% capture lv35 -%}{{ x.kind }}{%- endcapture %}{% case lv35 %}{% when "packet" %}Exhibition packet{% when "favorites" %}Favorites list{% when "event" %}Member event{% when "checklist" %}Loan checklist{% when "notes" %}Gallery notes{% when "procedure" %}Procedure{% else %}{{ lv35 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
{% else %}<section class="sec tight"><div class="w"><div class="lockp"><p class="kick">🔒 Members</p><h2>Sign in to see your member card and packets.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you join.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/members">Sign in</a><a class="btn line" href="{{ PathBase }}/membership">About membership</a></p></div></div></section>{% endif %}
