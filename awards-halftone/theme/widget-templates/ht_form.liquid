{%- comment -%} A plain HTML form that posts to a Raytha Function (forms/apply or forms/nominate). The function checks the fields, saves a draft item and redirects to /thanks. "website" is a honeypot: people never see it, bots fill it in. {%- endcomment -%}
{%- assign s = widget.settings -%}{%- capture kind %}{{ s.kind | strip | downcase }}{% endcapture -%}
{%- assign cats = get_content_items(ContentType="categories", OrderBy="sort_order asc", PageSize=12) -%}
<section class="section" style="padding-top:56px"><div class="wrap fgrid">
  <form class="form reveal" method="post" action="{{ PathBase }}/forms/{{ kind }}">
    <span class="label acc">{% if kind == "nominate" %}Nomination{% else %}Entry form{% endif %}</span>
    <h2 style="font-size:2.6rem;margin:10px 0 8px">{{ s.headline }}</h2><p class="muted" style="margin:0 0 26px">{{ s.intro }}</p>
    <div class="alert" role="alert"></div>
    <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
    {%- if kind == "nominate" %}
    <div class="two"><div class="fld"><label for="nominee">Who are you nominating?</label><input id="nominee" name="nominee" required maxlength="120" placeholder="Name of the person or studio"></div>
      <div class="fld"><label for="nominee_link">Link to their work <small>optional</small></label><input id="nominee_link" name="nominee_link" type="url" maxlength="300" placeholder="https://"></div></div>
    <div class="fld"><label for="category">Category</label><select id="category" name="category" required data-preselect><option value="">Choose a category</option>{% for c in cats.Items %}<option value="{{ c.PrimaryField }}" data-slug="{{ c.RoutePath | remove: 'categories/' }}">{{ c.PrimaryField }}</option>{% endfor %}</select></div>
    <div class="fld"><label for="reason">Why do they deserve it?</label><textarea id="reason" name="reason" required maxlength="1500" placeholder="A few sentences about the work and why it matters"></textarea><span class="hint">Up to 1,500 characters. We contact nominees before anything is published.</span></div>
    <div class="two"><div class="fld"><label for="nominator_name">Your name</label><input id="nominator_name" name="nominator_name" required maxlength="120" autocomplete="name"></div>
      <div class="fld"><label for="nominator_email">Your email</label><input id="nominator_email" name="nominator_email" type="email" required maxlength="160" autocomplete="email"></div></div>
    <button class="btn btn-acc" type="submit" style="margin-top:6px">Send nomination <i class="bi bi-arrow-right"></i></button>
    {%- else %}
    <div class="two"><div class="fld"><label for="entrant_name">Your name</label><input id="entrant_name" name="entrant_name" required maxlength="120" autocomplete="name"></div>
      <div class="fld"><label for="email">Email</label><input id="email" name="email" type="email" required maxlength="160" autocomplete="email"></div></div>
    <div class="two"><div class="fld"><label for="studio">Studio or school <small>optional</small></label><input id="studio" name="studio" maxlength="120" autocomplete="organization"></div>
      <div class="fld"><label for="category">Category</label><select id="category" name="category" required data-preselect><option value="">Choose a category</option>{% for c in cats.Items %}<option value="{{ c.PrimaryField }}" data-slug="{{ c.RoutePath | remove: 'categories/' }}">{{ c.PrimaryField }}</option>{% endfor %}</select></div></div>
    <div class="fld"><label for="title">Title of the work</label><input id="title" name="title" required maxlength="140"></div>
    <div class="fld"><label for="link">Link to the work</label><input id="link" name="link" type="url" required maxlength="300" placeholder="https://"><span class="hint">A portfolio page, shared folder or PDF. Make sure the jury can open it without logging in.</span></div>
    <div class="fld"><label for="statement">Statement</label><textarea id="statement" name="statement" required maxlength="1200" placeholder="What is it, who was it for, and what were you trying to do?"></textarea><span class="hint">Up to 1,200 characters. The jury reads this next to your work.</span></div>
    <label class="check"><input type="checkbox" name="consent" value="yes" required> <span>I made this work (or have permission to enter it) and I agree to the <a href="{{ PathBase }}/rules" style="color:var(--ink);border-bottom:1px solid var(--accent)">rules</a>.</span></label>
    <button class="btn btn-acc" type="submit">Send my entry <i class="bi bi-arrow-right"></i></button>
    {%- endif %}
  </form>
  <aside class="aside">
    <div class="box" style="background:var(--panel)"><h3>{{ s.aside_title }}</h3><div class="prose" style="font-size:.96rem">{{ s.aside }}</div></div>
    <div class="box"><span class="label">What happens next</span>{% for st in s.steps %}<div style="display:grid;grid-template-columns:34px 1fr;gap:8px;padding:14px 0;{% unless forloop.first %}border-top:1px solid var(--line){% endunless %}"><span style="font:400 1.5rem/1 var(--serif);color:var(--accent)">{{ forloop.index }}</span><div><b style="font-weight:600">{{ st.title }}</b><p class="muted" style="margin:4px 0 0;font-size:.9rem">{{ st.text }}</p></div></div>{% endfor %}</div>
  </aside>
</div></section>
