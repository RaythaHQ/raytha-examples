{%- assign s = widget.settings -%}
{%- assign fe = get_content_items(ContentType="entries", Filter="featured eq 'true' and year eq '2026'", OrderBy="sort_order asc", PageSize=3) -%}
<section class="hero"><div class="wrap hero-grid">
  <div>
    <span class="label acc">{{ s.kicker }}</span>
    <h1>{{ s.headline }} <em>{{ s.accent }}</em></h1>
    <p class="lead">{{ s.subtitle }}</p>
    <div class="row"><a class="btn btn-acc" href="{{ s.primary_url }}">{{ s.primary_label }} <i class="bi bi-arrow-right"></i></a><a class="btn btn-line" href="{{ s.secondary_url }}">{{ s.secondary_label }}</a></div>
    <div class="stats">{% for st in s.stats %}<div><b>{{ st.value }}</b><span>{{ st.label }}</span></div>{% endfor %}</div>
  </div>
  <div class="stack">{% for e in fe.Items %}{% assign q = e.PublishedContent %}<a href="{{ PathBase }}/{{ e.RoutePath }}"><img src="{{ q.image.Value | attachment_redirect_url }}" alt="{{ e.PrimaryField }} by {{ q.entrant }}"><span class="cap">{{ e.PrimaryField }} · {{ q.entrant }}</span></a>{% endfor %}</div>
</div></section>
