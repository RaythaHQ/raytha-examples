<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} · {% elsif Target.Label %}{{ Target.Label }} · {% elsif Target.Title %}{{ Target.Title }} · {% endif %}Halftone Awards 2026</title>
  <meta name="description" content="The Halftone Awards: an international prize for illustration, poster and editorial design, photography and type. Enter your work or nominate someone for 2026.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230c0c0d'/%3E%3Cg fill='%23ff5a36'%3E%3Ccircle cx='18' cy='18' r='9'/%3E%3Ccircle cx='40' cy='18' r='6'/%3E%3Ccircle cx='18' cy='40' r='6'/%3E%3Ccircle cx='40' cy='40' r='4'/%3E%3Ccircle cx='54' cy='54' r='2.5'/%3E%3C/g%3E%3C/svg%3E">
  <style>
    :root{--bg:#0c0c0d;--bg2:#121214;--panel:#17171a;--line:#2a2a2f;--line2:#3a3a40;--ink:#f3efe7;--ink2:#cfc9bd;--muted:#8f8a80;--accent:#ff5a36;--accentD:#e4441f;--gold:#d9b45a;--silver:#c4c7cc;--bronze:#c98a5a;
      --serif:"Instrument Serif",Georgia,serif;--sans:"Inter",system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;--ease:cubic-bezier(.2,.7,.2,1)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
    a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
    h1,h2,h3{font-family:var(--serif);font-weight:400;letter-spacing:-.01em;line-height:1.02;margin:0}
    h1 em,h2 em,h3 em{color:var(--accent)}
    h4{margin:0;font-weight:600}
    .wrap{width:min(1240px,100% - 56px);margin-inline:auto}
    @media(max-width:600px){.wrap{width:calc(100% - 32px)}}
    .label{font:500 .74rem/1.4 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
    .label.acc{color:var(--accent)}
    .muted{color:var(--muted)}
    .btn{display:inline-flex;align-items:center;gap:.55rem;padding:.85rem 1.35rem;border-radius:999px;font:600 .94rem var(--sans);border:1px solid transparent;transition:.2s var(--ease);cursor:pointer;white-space:nowrap}
    .btn-acc{background:var(--accent);color:#120804}.btn-acc:hover{background:#ff7656}
    .btn-line{border-color:var(--line2);color:var(--ink)}.btn-line:hover{border-color:var(--ink)}
    .btn-ink{background:var(--ink);color:var(--bg)}.btn-ink:hover{background:#fff}
    .tag{display:inline-flex;align-items:center;gap:.4rem;padding:.28rem .62rem;border-radius:999px;font:500 .7rem var(--mono);letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line2);color:var(--ink2);white-space:nowrap}
    .tag.grand_prix{background:var(--accent);border-color:var(--accent);color:#120804}.tag.gold{border-color:var(--gold);color:var(--gold)}.tag.silver{border-color:var(--silver);color:var(--silver)}.tag.merit{border-color:var(--bronze);color:var(--bronze)}
    .tag .dot{width:7px;height:7px;border-radius:50%;background:currentColor}
    .dots-bg{background-image:radial-gradient(circle,rgba(243,239,231,.09) 1.2px,transparent 1.6px);background-size:14px 14px}
    /* ribbon + nav */
    .ribbon{border-bottom:1px solid var(--line);font:500 .74rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
    .ribbon .wrap{display:flex;gap:18px;align-items:center;height:38px;justify-content:center}
    .ribbon b{color:var(--accent);font-weight:500}.ribbon a{border-bottom:1px solid var(--line2)}.ribbon a:hover{border-color:var(--ink)}
    @media(max-width:700px){.ribbon .hide{display:none}}
    .nav{position:sticky;top:0;z-index:40;background:rgba(12,12,13,.86);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
    .nav-in{display:flex;align-items:center;gap:28px;height:74px}
    .brand{display:flex;align-items:center;gap:.7rem;line-height:1}
    .brand b{font:400 1.75rem var(--serif);letter-spacing:-.01em}
    .brand small{display:block;font:500 .62rem var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:4px}
    .nav ul{display:flex;gap:4px;list-style:none;margin:0 auto 0 12px;padding:0}
    .nav ul a{display:block;padding:.5rem .85rem;border-radius:999px;font-size:.93rem;font-weight:500;color:var(--ink2)}
    .nav ul a:hover{color:var(--ink);background:var(--panel)}.nav ul a.on{color:var(--ink);background:var(--panel);box-shadow:inset 0 0 0 1px var(--line2)}
    .nav .tog{display:none;background:none;border:0;color:inherit;font-size:1.7rem;margin-left:auto;cursor:pointer}
    .nav .acts{display:flex;gap:8px}.nav .acts .btn{padding:.6rem 1.1rem}
    @media(max-width:1060px){.nav ul{display:none;position:absolute;top:74px;left:0;right:0;margin:0;flex-direction:column;background:var(--bg);padding:12px 16px 20px;border-bottom:1px solid var(--line)}.nav.open ul{display:flex}.nav .tog{display:block}.nav .acts .btn-line{display:none}}
    @media(max-width:480px){.nav .acts{display:none}}
    /* sections */
    .section{padding:110px 0}.section.tight{padding:70px 0}.section.band{background:var(--bg2);border-block:1px solid var(--line)}
    .shead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:44px;flex-wrap:wrap}
    .shead h2{font-size:clamp(2.4rem,4.6vw,3.9rem);margin-top:14px;max-width:780px}
    .shead p{margin:14px 0 0;color:var(--ink2);max-width:560px;font-size:1.04rem}
    .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
    @media(max-width:1000px){.grid3,.grid4{grid-template-columns:1fr 1fr}}@media(max-width:640px){.grid3,.grid4,.grid2{grid-template-columns:1fr}}
    /* hero */
    .hero{position:relative;padding:84px 0 110px;overflow:hidden}
    .hero::before{content:"";position:absolute;inset:0;background:radial-gradient(800px 520px at 78% 30%,rgba(255,90,54,.16),transparent 65%)}
    .hero-grid{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
    .hero h1{font-size:clamp(3.3rem,7.4vw,6.6rem);line-height:.95;margin:22px 0 26px}
    .hero h1 em{font-style:italic}
    .hero .lead{font-size:1.18rem;color:var(--ink2);max-width:540px;margin:0 0 32px}
    .hero .row{display:flex;gap:12px;flex-wrap:wrap}
    .stats{display:flex;gap:40px;margin-top:48px;padding-top:28px;border-top:1px solid var(--line);flex-wrap:wrap}
    .stats b{display:block;font:400 2.6rem/1 var(--serif)}.stats span{font:500 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
    .stack{position:relative;height:600px}
    .stack a{position:absolute;width:62%;border-radius:6px;overflow:hidden;box-shadow:0 40px 80px -30px rgba(0,0,0,.9);border:1px solid var(--line2);transition:transform .5s var(--ease)}
    .stack a:nth-child(1){left:0;top:70px;transform:rotate(-7deg)}.stack a:nth-child(2){right:0;top:0;transform:rotate(5deg);z-index:2}.stack a:nth-child(3){left:20%;bottom:0;transform:rotate(-1deg);z-index:3}
    .stack a:hover{transform:rotate(0) scale(1.03);z-index:5}
    .stack .cap{position:absolute;left:0;right:0;bottom:0;padding:26px 14px 12px;background:linear-gradient(transparent,rgba(0,0,0,.75));font:500 .68rem var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#fff}
    @media(max-width:980px){.hero-grid{grid-template-columns:1fr}.stack{height:520px;max-width:560px;width:100%;margin:0 auto}}
    @media(max-width:600px){.hero{padding:44px 0 70px}.stack{height:400px}.stats{gap:26px}.stats b{font-size:2.1rem}}
    /* category cards */
    .cat{position:relative;display:flex;flex-direction:column;gap:14px;padding:28px;border:1px solid var(--line);border-radius:18px;background:var(--panel);overflow:hidden;transition:border-color .3s,transform .3s var(--ease)}
    .cat::after{content:"";position:absolute;right:-40px;top:-40px;width:170px;height:170px;background-image:radial-gradient(circle,var(--c) 2.2px,transparent 2.6px);background-size:12px 12px;opacity:.55;-webkit-mask:radial-gradient(circle at 70% 30%,#000,transparent 70%);mask:radial-gradient(circle at 70% 30%,#000,transparent 70%)}
    .cat:hover{border-color:var(--line2);transform:translateY(-4px)}
    .cat h3{font-size:2.1rem}.cat p{margin:0;color:var(--ink2);font-size:.95rem;line-height:1.55;max-width:92%}
    .cat .meta{margin-top:auto;padding-top:18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}
    .cat .meta .label b{color:var(--ink);font-weight:500}
    .status{font:500 .7rem var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:.3rem .62rem;border-radius:999px;background:rgba(46,204,113,.12);color:#6ee7a1}
    .status.soon{background:rgba(255,90,54,.14);color:#ff8a6e}.status.closed{background:var(--line);color:var(--muted)}
    /* gallery */
    .gal{columns:3 300px;column-gap:22px}
    .work{display:block;break-inside:avoid;margin-bottom:22px;border-radius:10px;overflow:hidden;background:var(--panel);border:1px solid var(--line);transition:border-color .3s}
    .work .im{position:relative;overflow:hidden;aspect-ratio:4/5}
    .work .im img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease)}.work:hover .im img{transform:scale(1.04)}
    .work .im .tag{position:absolute;left:12px;top:12px;background:rgba(12,12,13,.72);backdrop-filter:blur(6px)}
    .work .bd{padding:16px 18px 18px}
    .work h3{font-size:1.65rem;line-height:1.05}
    .work .by{margin-top:6px;color:var(--ink2);font-size:.9rem}
    .work .ft{display:flex;justify-content:space-between;margin-top:12px;gap:10px}
    .work:hover{border-color:var(--line2)}
    .strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(260px,1fr);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px;scrollbar-width:thin;scrollbar-color:var(--line2) transparent}
    .strip .work{scroll-snap-align:start;margin:0}
    /* filters */
    .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:32px}
    .filters a{padding:.5rem 1rem;border-radius:999px;border:1px solid var(--line);font-size:.9rem;font-weight:500;color:var(--ink2)}
    .filters a.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}.filters a:not(.on):hover{border-color:var(--line2);color:var(--ink)}
    .filters a i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--c);margin-right:7px;vertical-align:1px}
    /* page header */
    .phead{position:relative;padding:72px 0 56px;border-bottom:1px solid var(--line);overflow:hidden}
    .phead::after{content:"";position:absolute;right:-80px;top:-60px;width:520px;height:420px;background-image:radial-gradient(circle,rgba(255,90,54,.55) 2px,transparent 2.4px);background-size:14px 14px;-webkit-mask:radial-gradient(closest-side,#000,transparent);mask:radial-gradient(closest-side,#000,transparent);opacity:.5;pointer-events:none}
    .phead h1{font-size:clamp(2.9rem,6.2vw,5.4rem);line-height:.98;margin:18px 0 18px;max-width:900px}
    .phead p{font-size:1.14rem;color:var(--ink2);max-width:660px;margin:0}
    .crumbs{display:flex;gap:10px;flex-wrap:wrap;font:500 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}.crumbs a:hover{color:var(--ink)}
    /* timeline */
    .tl{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line2)}
    .tl div{padding:26px 22px 0 0;position:relative}
    .tl div::before{content:"";position:absolute;top:-6px;left:0;width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid var(--accent)}
    .tl div.past::before{background:var(--accent)}
    .tl b{display:block;font:400 1.9rem/1.1 var(--serif);margin:10px 0 8px}.tl p{margin:0;color:var(--ink2);font-size:.93rem}
    @media(max-width:900px){.tl{grid-template-columns:1fr 1fr;row-gap:34px}}@media(max-width:520px){.tl{grid-template-columns:1fr}}
    /* feature (grand prix) */
    .feature{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;align-items:center}
    .feature .im{border-radius:10px;overflow:hidden;border:1px solid var(--line2);box-shadow:0 50px 90px -40px rgba(0,0,0,.9)}
    .feature h3{font-size:clamp(2.6rem,5vw,4.4rem);margin:18px 0 14px}
    .feature blockquote{margin:24px 0;padding-left:20px;border-left:2px solid var(--accent);font:italic 400 1.5rem/1.35 var(--serif);color:var(--ink2)}
    @media(max-width:900px){.feature{grid-template-columns:1fr;gap:36px}}
    /* judges */
    .judge{padding:24px;border:1px solid var(--line);border-radius:18px;background:var(--panel);display:flex;flex-direction:column;gap:10px}
    .judge .av{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;font:400 1.9rem var(--serif);color:var(--ink);position:relative;overflow:hidden;border:1px solid var(--line2)}
    .judge .av::before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,var(--c) 2.6px,transparent 3px);background-size:9px 9px;opacity:.7;-webkit-mask:linear-gradient(135deg,#000 10%,transparent 85%);mask:linear-gradient(135deg,#000 10%,transparent 85%)}
    .judge .av span{position:relative}
    .judge h3{font-size:1.7rem;margin-top:6px}.judge p{margin:0;color:var(--ink2);font-size:.93rem}
    /* cta */
    .cta{position:relative;border:1px solid var(--line2);border-radius:28px;padding:64px;overflow:hidden;background:linear-gradient(120deg,#1a0f0b,var(--panel) 60%)}
    .cta::after{content:"";position:absolute;right:-60px;bottom:-80px;width:460px;height:360px;background-image:radial-gradient(circle,var(--accent) 2.4px,transparent 2.8px);background-size:13px 13px;-webkit-mask:radial-gradient(closest-side,#000,transparent);mask:radial-gradient(closest-side,#000,transparent);opacity:.8}
    .cta h2{position:relative;font-size:clamp(2.4rem,5vw,4.2rem);max-width:720px}.cta p{position:relative;color:var(--ink2);max-width:560px;font-size:1.08rem;margin:16px 0 28px}
    .cta .row{position:relative;display:flex;gap:12px;flex-wrap:wrap}
    @media(max-width:600px){.cta{padding:36px 24px}}
    /* entry page */
    .ed{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:start}
    .ed .frame{border-radius:10px;overflow:hidden;border:1px solid var(--line2);box-shadow:0 50px 100px -50px rgba(0,0,0,.95);background:var(--panel)}
    .ed h1{font-size:clamp(2.8rem,5vw,4.6rem);margin:16px 0 10px}
    .ed .by{font-size:1.1rem;color:var(--ink2)}
    .facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin:28px 0}
    .facts div{padding:16px 0;border-bottom:1px solid var(--line)}.facts div:nth-child(odd){padding-right:16px}
    .facts span{display:block}.facts b{font-weight:500}
    .prose{font-size:1.06rem;color:var(--ink2)}
    .prose p{margin:0 0 16px}.prose h2{font-size:2rem;color:var(--ink);margin:30px 0 12px}.prose ul{padding-left:0;list-style:none;margin:0 0 18px}.prose li{position:relative;padding-left:24px;margin:9px 0}
    .prose li::before{content:"";position:absolute;left:2px;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--accent)}
    .prose strong{color:var(--ink)}.prose a{color:var(--ink);border-bottom:1px solid var(--accent)}
    .pn{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:70px}
    .pn a{padding:22px 24px;border:1px solid var(--line);border-radius:16px;display:flex;flex-direction:column;gap:4px}.pn a:hover{border-color:var(--line2)}
    .pn a b{font:400 1.6rem var(--serif)}.pn a:last-child{text-align:right}
    @media(max-width:900px){.ed{grid-template-columns:1fr;gap:34px}}
    /* forms */
    .fgrid{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:start}
    .form{padding:36px;border:1px solid var(--line2);border-radius:22px;background:var(--panel)}
    .form .two{display:grid;grid-template-columns:1fr 1fr;gap:18px}
    .fld{display:flex;flex-direction:column;gap:7px;margin-bottom:20px}
    .fld label{font-weight:600;font-size:.92rem}.fld label small{font-weight:400;color:var(--muted);margin-left:6px}
    .fld input,.fld select,.fld textarea{font:inherit;font-size:.98rem;color:var(--ink);background:var(--bg);border:1px solid var(--line2);border-radius:12px;padding:.8rem .95rem;outline:0;transition:border-color .2s,box-shadow .2s;width:100%}
    .fld select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 20px) 50%,calc(100% - 14px) 50%;background-size:6px 6px;background-repeat:no-repeat}
    .fld textarea{min-height:140px;resize:vertical}
    .fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(255,90,54,.15)}
    .fld .hint{font-size:.8rem;color:var(--muted)}
    .check{display:flex;gap:12px;align-items:flex-start;font-size:.92rem;color:var(--ink2);margin:6px 0 24px}
    .check input{width:20px;height:20px;accent-color:var(--accent);margin-top:2px;flex:none}
    .hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;overflow:hidden}
    .alert{display:none;padding:14px 18px;border-radius:12px;background:rgba(255,90,54,.12);border:1px solid rgba(255,90,54,.4);color:#ffb3a1;margin-bottom:22px;font-size:.94rem}
    .alert.show{display:block}
    .aside{position:sticky;top:110px;display:grid;gap:16px}
    .aside .box{padding:26px;border:1px solid var(--line);border-radius:18px}
    .aside .box h3{font-size:1.6rem;margin-bottom:10px}
    @media(max-width:960px){.fgrid{grid-template-columns:1fr}.aside{position:static}}
    @media(max-width:560px){.form{padding:22px}.form .two{grid-template-columns:1fr;gap:0}}
    /* rules */
    .rules{display:grid;grid-template-columns:260px 1fr;gap:64px;align-items:start}
    .rules nav{position:sticky;top:110px;display:flex;flex-direction:column;gap:2px}
    .rules nav a{padding:.45rem 0;color:var(--muted);font-size:.92rem;border-left:2px solid var(--line);padding-left:14px}.rules nav a:hover{color:var(--ink);border-color:var(--accent)}
    .rule{padding:30px 0;border-top:1px solid var(--line);display:grid;grid-template-columns:64px 1fr;gap:10px;scroll-margin-top:110px}
    .rule .n{font:400 2.2rem/1 var(--serif);color:var(--accent)}.rule h3{font-size:2rem;margin-bottom:10px}
    @media(max-width:900px){.rules{grid-template-columns:1fr}.rules nav{display:none}}
    /* winners */
    .year{display:grid;grid-template-columns:200px 1fr;gap:40px;padding:60px 0;border-top:1px solid var(--line)}
    .year>h2{font-size:5.4rem;line-height:.9;position:sticky;top:110px;align-self:start}
    @media(max-width:900px){.year{grid-template-columns:1fr;gap:20px}.year>h2{position:static;font-size:4rem}}
    /* footer */
    .foot{border-top:1px solid var(--line);padding:72px 0 30px;margin-top:40px;color:var(--ink2)}
    .foot .cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1.1fr;gap:40px}
    .foot h4{font:500 .72rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:16px}
    .foot ul{list-style:none;margin:0;padding:0}.foot li{margin:9px 0;font-size:.94rem}.foot a:hover{color:var(--ink)}
    .foot .big{font:400 clamp(2.4rem,5vw,3.6rem)/1 var(--serif);color:var(--ink);margin:0 0 18px}
    .foot .bottom{display:flex;justify-content:space-between;gap:16px;font-size:.82rem;color:var(--muted);flex-wrap:wrap;border-top:1px solid var(--line);padding-top:24px;margin-top:56px}
    @media(max-width:860px){.foot .cols{grid-template-columns:1fr 1fr}.foot .cols>div:first-child{grid-column:1/-1}}
    .reveal{opacity:0;transform:translateY(18px);transition:opacity .8s var(--ease),transform .8s var(--ease)}.reveal.in{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
{%- assign rcats = get_content_items(ContentType="categories", OrderBy="deadline asc", PageSize=20) -%}
<div class="ribbon"><div class="wrap">
  <span class="dl-ribbon" data-deadlines="{% for c in rcats.Items %}{{ c.PublishedContent.deadline.Value | date: '%Y-%m-%d' }}{% unless forloop.last %},{% endunless %}{% endfor %}"><b>&#9679;</b> 2026 entries are open</span>
  <span class="hide dl-next">Next deadline {{ rcats.Items[0].PublishedContent.deadline.Value | date: "%-d %b %Y" }}</span>
  <a class="hide" href="{{ PathBase }}/rules">Read the rules</a>
</div></div>
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand" href="{{ PathBase }}/"><svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true"><g fill="#ff5a36"><circle cx="14" cy="14" r="11"/><circle cx="40" cy="14" r="8"/><circle cx="14" cy="40" r="8"/><circle cx="40" cy="40" r="5.5"/><circle cx="58" cy="40" r="3"/><circle cx="40" cy="58" r="3"/><circle cx="58" cy="58" r="2"/></g></svg><span><b>Halftone</b><small>Awards 2026</small></span></a>
    {%- assign menu = get_main_menu() %}{% assign seg = Target.RoutePath | split: "/" | first %}
    <ul>
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}" class="{% if u != '' and u == seg %}on{% endif %}">{{ mi.Label }}</a></li>
      {%- endfor %}
    </ul>
    <div class="acts"><a class="btn btn-line" href="{{ PathBase }}/nominate">Nominate</a><a class="btn btn-acc" href="{{ PathBase }}/apply">Enter your work</a></div>
    <button class="tog" aria-label="Menu" onclick="document.getElementById('nav').classList.toggle('open')"><i class="bi bi-list"></i></button>
  </div>
</header>
<main>{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div><p class="big">Good work deserves <em style="color:var(--accent)">a wider room.</em></p><p style="max-width:420px">The Halftone Awards celebrate illustration, design, photography and type from around the world. Halftone is a fictional prize, built as a demo with Raytha.</p></div>
      {%- assign fm = get_menu("footer") %}
      <div><h4>The awards</h4><ul>{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
      <div><h4>Categories</h4><ul>{% assign fcats = get_content_items(ContentType="categories", OrderBy="sort_order asc", PageSize=12) %}{% for c in fcats.Items %}<li><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a></li>{% endfor %}</ul></div>
      <div><h4>Get in touch</h4><ul><li><a href="mailto:entries@example.com">entries@example.com</a></li><li><a href="mailto:press@example.com">press@example.com</a></li><li>Ceremony: 24 April 2027, Lisbon</li></ul></div>
    </div>
    <div class="bottom"><span>&copy; 2026 Halftone Awards. A fictional prize. All artwork on this site is generated.</span><span>Built with <a href="https://raytha.com" style="color:var(--ink)">Raytha</a></span></div>
  </div>
</footer>
<script>
(function(){
  var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.06}):null;
  document.querySelectorAll('.reveal').forEach(function(el){io?io.observe(el):el.classList.add('in')});
  var today=new Date();today.setHours(0,0,0,0);
  function daysTo(s){var p=s.split('-');var d=new Date(+p[0],+p[1]-1,+p[2]);return Math.round((d-today)/864e5)}
  // Deadline badges: <span class="status" data-deadline="2026-12-11">
  document.querySelectorAll('[data-deadline]').forEach(function(el){var n=daysTo(el.getAttribute('data-deadline'));
    if(n<0){el.textContent='Closed';el.classList.add('closed')}else if(n<=30){el.textContent=n===0?'Closes today':n+(n===1?' day':' days')+' left';el.classList.add('soon')}else{el.textContent='Open · '+n+' days left'}});
  // Ribbon: the next deadline still ahead
  var r=document.querySelector('.dl-ribbon');if(r){var next=r.getAttribute('data-deadlines').split(',').filter(function(s){return s&&daysTo(s)>=0})[0],nx=document.querySelector('.dl-next');
    if(!next){r.innerHTML='<b>&#9679;</b> 2026 entries are closed. Judging is under way';if(nx)nx.style.display='none'}
    else if(nx){var n=daysTo(next);nx.textContent='Next deadline in '+n+(n===1?' day':' days')}}
  // Forms: preselect ?category= and show ?error= messages
  var qs=new URLSearchParams(location.search);
  document.querySelectorAll('select[data-preselect]').forEach(function(s){var c=qs.get('category');if(c){for(var i=0;i<s.options.length;i++){if(s.options[i].getAttribute('data-slug')===c)s.selectedIndex=i}}});
  var al=document.querySelector('.alert');if(al&&qs.get('error')){var m={missing:'Please fill in every required field.',email:'Please check the email address.',category:'Please choose a category.',consent:'Please confirm that you agree to the rules.',link:'Links must start with http:// or https://.',failed:'Something went wrong on our side. Please try again in a minute.'};al.textContent=m[qs.get('error')]||m.missing;al.classList.add('show')}
  var th=document.querySelector('[data-thanks]');if(th){var f=qs.get('f')==='nominate'?'nominate':'apply';document.querySelectorAll('[data-for]').forEach(function(el){el.style.display=el.getAttribute('data-for')===f?'':'none'})}
})();
</script>
</body>
</html>
