{%- assign ps = get_content_items(ContentType="projects", OrderBy="sort_order asc", PageSize=20) -%}{%- assign ns = get_content_items(ContentType="fieldnotes", OrderBy="posted_on desc", PageSize=3) -%}
<section class="hero"><div class="wrap"><p class="coords">DWG SET JC · HIGH DESERT · RAMMED EARTH</p><h1 style="margin:14px 0">Thick walls.<br>Deep shade.<br>No wasted rooms.</h1><p class="lead">I'm June Calloway. I design and draw rammed-earth and desert-modern houses around Marfa — myself, start to finish. If you hire me, there is no team to be handed off to. There is me, a builder I trust, and the desert doing half the climate work if we let it.</p><p><a class="btn orange" href="{{ PathBase }}/start">Start a project →</a> <a class="btn o" href="{{ PathBase }}/work">See the drawing sets</a></p><p class="avail"><span class="dot"></span> CURRENTLY: ON THE BOARDS — 1 HOUSE. BOOKING SPRING 2027 · 2 SLOTS. <a href="{{ PathBase }}/currently">See currently →</a></p>
<div style="background:#fff;color:#111;border:3px solid #111;padding:0;margin:28px 0 0">{% for p in ps.Items limit:1 %}<a href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ p.PublishedContent.image.Value | attachment_redirect_url }}" alt="Blueprint drawing for {{ p.PrimaryField }}"></a>{% endfor %}</div><p style="font-size:.8rem;margin:10px 0 28px">FIG. 01 — LATEST DRAWING SET. EVERY PROJECT BELOW IS A SET OF DRAWINGS FIRST, A HOUSE SECOND.</p></div></section>
<section class="sec"><div class="wrap"><p class="kick">Index · by year</p><h2 style="margin:10px 0 18px">Every house, in order</h2>
{% for p in ps.Items %}{%- assign x=p.PublishedContent -%}<a class="row" href="{{ PathBase }}/{{ p.RoutePath }}"><div><b>{{ x.drawing_no }}</b><br>{{ x.year }}</div><div><b style="font-size:1.1rem">{{ p.PrimaryField }}</b><br><span class="meta">{{ x.location }} · {{ x.kind }}</span><p style="margin:6px 0 0">{{ x.summary }}</p></div><div>{%- capture st -%}{{ x.status }}{%- endcapture -%}{% if st contains "on_boards" %}ON THE BOARDS{% elsif st contains "drawing" %}DRAWING SET{% else %}BUILT{% endif %}<br><span class="meta">Budget (story)</span><br>{{ x.budget }}</div><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""></div></a>{% endfor %}
<p style="margin-top:16px"><a href="{{ PathBase }}/work">Full index with notes →</a></p></div></section>
<section class="sec white"><div class="wrap"><p class="kick">Field notes</p><h2 style="margin:10px 0 18px">Notes from site, not a blog</h2><div class="cards">{% for n in ns.Items %}<article class="card"><p class="meta">{{ n.PublishedContent.date_label }} · {{ n.PublishedContent.location }}</p><h3 style="margin:8px 0"><a href="{{ PathBase }}/{{ n.RoutePath }}">{{ n.PrimaryField }}</a></h3><p>{{ n.PublishedContent.summary }}</p></article>{% endfor %}</div></div></section>
<section class="sec"><div class="wrap grid2"><div><p class="kick">How I work</p><h2 style="margin:10px 0">Fees on the page. No mystery.</h2><p>I charge a fixed fee by phase, quoted after we walk the land. You will know what design costs before you commit to building. If your budget and your brief don't match, I will tell you on the first call.</p><p><a class="btn" href="{{ PathBase }}/process">Process &amp; fees →</a></p></div><aside class="card"><h3>Not for everyone</h3><p>I don't do: houses over 3,500 sq ft, spec houses, or projects that need to start next month. I do: small, thick-walled houses for people who will live in them.</p></aside></div></section>
