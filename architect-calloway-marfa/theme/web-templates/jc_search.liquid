{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="wrap"><h1>Search the sets</h1><form action="{{ PathBase }}/search" role="search" style="display:flex;gap:10px;margin-top:16px"><input name="q" value="{{ q }}" aria-label="Search"><button class="btn">Search</button></form></div></div><section class="sec"><div class="wrap">{% if q != "" %}{%- capture f %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(materials,'{{ q }}'){% endcapture -%}{%- assign r=get_content_items(ContentType="projects",Filter=f,PageSize=12)-%}<p>{{ r.TotalCount }} project(s)</p>{% for p in r.Items %}<p><a href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b></a> — {{ p.PublishedContent.summary }}</p>{% endfor %}{% endif %}</div></section>
