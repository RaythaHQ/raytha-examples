{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/work">Index</a></li><li aria-current="page">{{ x.drawing_no }}</li></ol><p class="kick">{{ x.drawing_no }} · {{ x.year }} · {{ x.location }} · {%- capture st -%}{{ x.status }}{%- endcapture -%}{% if st contains "on_boards" %}ON THE BOARDS{% elsif st contains "drawing" %}DRAWING SET{% else %}BUILT{% endif %}</p><h1 style="margin:10px 0">{{ Target.PrimaryField }}</h1><p>{{ x.summary }}</p></div></div><section class="sec"><div class="wrap"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="Blueprint-style drawing for {{ Target.PrimaryField }}" style="border:3px solid #111;background:#fff"><div class="grid2" style="margin-top:28px"><div class="prose">{{ x.story }}<h2>One regret</h2><p>{{ x.regret }}</p></div><aside class="card"><h3>Sheet data</h3><p><b>Kind:</b> {{ x.kind }}<br><b>Location:</b> {{ x.location }}<br><b>Budget (story):</b> {{ x.budget }}<br><b>Materials:</b> {{ x.materials }}<br><b>Status:</b> {%- capture st -%}{{ x.status }}{%- endcapture -%}{% if st contains "on_boards" %}ON THE BOARDS{% elsif st contains "drawing" %}DRAWING SET{% else %}BUILT{% endif %}</p><p><a class="btn" href="{{ PathBase }}/start">Ask about a house like this</a></p></aside></div></div></section>
