<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post"><label>Email<input type="email" name="EmailAddress"></label><label>Password<input type="password" name="Password"></label><button class="btn" type="submit" style="margin-top:14px">Sign in</button><input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}"></form>
