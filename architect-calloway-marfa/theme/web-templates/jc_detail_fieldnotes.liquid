{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/notes">Field notes</a></li></ol><p class="kick">{{ x.date_label }} · {{ x.location }}</p><h1 style="margin:10px 0">{{ Target.PrimaryField }}</h1><p>{{ x.summary }}</p></div></div><section class="sec"><div class="wrap grid2"><div class="prose">{{ x.body }}</div><aside><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="border:3px solid #111"></aside></div></section>
