{%- assign s = widget.settings -%}{%- assign st = get_content_items(ContentType="authors", OrderBy="sort_order asc", PageSize=20) -%}
<section class="wrap" style="padding-top:44px"><div class="shd"><h2>{{ s.headline }}</h2><a href="{{ PathBase }}/staff">Full masthead</a></div><div class="ssg">{% for a in st.Items %}{% assign ws = a.PrimaryField | split: " " %}<a href="{{ PathBase }}/{{ a.RoutePath }}"><span class="av" style="background:{{ a.PublishedContent.color }}">{{ ws[0] | slice: 0 }}{{ ws[1] | slice: 0 }}</span><span><b class="hd">{{ a.PrimaryField }}</b><small class="mut" style="display:block">{{ a.PublishedContent.role }}</small></span></a>{% endfor %}</div></section>
<style>.ssg{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.ssg a{display:flex;gap:12px;align-items:center}@media(max-width:860px){.ssg{grid-template-columns:1fr 1fr}}@media(max-width:520px){.ssg{grid-template-columns:1fr}}</style>
