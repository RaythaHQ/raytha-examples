{%- assign s = widget.settings -%}{% assign lim = s.count | append: "" | plus: 0 %}{% if lim == 0 %}{% assign lim = 4 %}{% endif %}
{%- assign secs = get_content_items(ContentType="sections", PageSize=20) %}{% for x in secs.Items %}{% if x.PrimaryField == s.section %}{% assign sec = x %}{% endif %}{% endfor -%}
{%- assign all = get_content_items(ContentType="articles", OrderBy="published_on desc", PageSize=200) -%}
{%- if sec %}<section class="wrap" style="margin-top:46px"><div class="shd" style="border-top-color:{{ sec.PublishedContent.color }}"><h2>{{ sec.PrimaryField }}</h2><a href="{{ PathBase }}/{{ sec.RoutePath }}">More {{ sec.PrimaryField }} <i class="bi bi-arrow-right"></i></a></div>
<div class="srow">{% assign k = 0 %}
{%- for x in all.Items %}{% assign q = x.PublishedContent %}{% capture ft %}{{ q.featured }}{% endcapture %}{% if q.section.PrimaryField == sec.PrimaryField and ft != "True" and k < lim %}{% assign k = k | plus: 1 %}
  {%- if k == 1 %}<a class="s1" href="{{ PathBase }}/{{ x.RoutePath }}"><img class="thumb" src="{{ q.image.Value | attachment_redirect_url }}" alt=""><span>{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h3 class="h-l hd" style="margin:8px 0 0">{{ x.PrimaryField }}</h3><p class="dek">{{ q.dek }}</p><span style="display:block;margin-top:10px"><span class="meta"><b>{{ q.author.PrimaryField }}</b><span>&middot;</span><span>{{ q.published_on.Value | date: "%b %-d, %Y" }}</span>{% if q.read_minutes %}<span>&middot;</span><span>{{ q.read_minutes }} min read</span>{% endif %}</span></span></span></a><div class="sx">
  {%- else %}<a href="{{ PathBase }}/{{ x.RoutePath }}" class="sxi">{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h3 class="h-s hd" style="margin:5px 0 0">{{ x.PrimaryField }}</h3><span class="meta" style="margin-top:6px">{{ q.author.PrimaryField }}</span></a>{% endif %}
{%- endif %}{% endfor %}{% if k > 0 %}</div>{% endif %}
</div></section>{% endif %}
<style>.srow{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:30px}.s1{display:grid;grid-template-columns:1.1fr 1fr;gap:22px;align-items:start}.sx{border-left:1px solid var(--line);padding-left:26px}.sxi{display:block;padding:14px 0;border-top:1px solid var(--line)}.sxi:first-child{border-top:0;padding-top:0}
@media(max-width:900px){.srow{grid-template-columns:1fr}.sx{border:0;padding:0}}@media(max-width:600px){.s1{grid-template-columns:1fr;gap:12px}}</style>
