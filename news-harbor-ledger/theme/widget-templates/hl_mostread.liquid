{%- assign s = widget.settings -%}{%- assign mr = get_content_items(ContentType="articles", OrderBy="reads desc", PageSize=5) -%}
<section class="mrb"><div class="wrap"><div style="display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap"><h2 style="font:800 1.6rem/1 var(--serif)">{{ s.headline }}</h2><a href="{{ PathBase }}/most-read" style="font:600 .84rem/1 var(--sans);color:#c9ccd1">Top 10 <i class="bi bi-arrow-right"></i></a></div>
<ol>{% for x in mr.Items %}<li><a href="{{ PathBase }}/{{ x.RoutePath }}"><span class="n">{{ forloop.index }}</span><span class="hd">{{ x.PrimaryField }}</span><small>{{ x.PublishedContent.reads | append: "" | plus: 0 | format_number: "N0" }} reads</small></a></li>{% endfor %}</ol>
{% if s.note != "" %}<p class="sm">{{ s.note }}</p>{% endif %}</div></section>
<style>.mrb{background:var(--ink);color:#fff;padding:34px 0 30px;margin-top:56px}.mrb ol{list-style:none;padding:0;margin:22px 0 0;display:grid;grid-template-columns:repeat(5,1fr);gap:24px}
.mrb li a{display:block;border-top:1px solid #3a3f46;padding-top:14px;font:600 1.05rem/1.3 var(--serif)}.mrb .n{display:block;font:800 2.2rem/1 var(--serif);color:#ff5a5f;margin-bottom:8px}.mrb small{display:block;margin-top:8px;font:500 .74rem/1 var(--sans);color:#9aa0a8}
.mrb .sm{font-size:.78rem;color:#9aa0a8;margin:22px 0 0;max-width:760px}@media(max-width:900px){.mrb ol{grid-template-columns:1fr 1fr}}@media(max-width:560px){.mrb ol{grid-template-columns:1fr}}</style>
