{%- assign s = widget.settings -%}{% assign lim = s.count | append: "" | plus: 0 %}{% if lim == 0 %}{% assign lim = 3 %}{% endif %}
{%- assign op = get_content_items(ContentType="articles", Filter="kind eq 'opinion'", OrderBy="published_on desc", PageSize=lim) -%}
<section class="wrap" style="margin-top:46px"><div class="shd"><h2>{{ s.headline }}</h2><a href="{{ PathBase }}/news?type=opinion">All opinion</a></div>
<div class="opg">{% for x in op.Items %}{% assign q = x.PublishedContent %}{% assign ws = q.author.PrimaryField | split: " " %}<a href="{{ PathBase }}/{{ x.RoutePath }}" class="opi"><span class="q">&ldquo;</span><h3 class="h-m hd" style="font-style:italic;font-weight:600">{{ x.PrimaryField }}</h3><p class="dek" style="font-size:.95rem">{{ q.dek | truncatewords: 24 }}</p><span class="meta" style="margin-top:10px"><b>{{ q.author.PrimaryField }}</b></span></a>{% endfor %}
<div class="opi" style="background:var(--paper2);border:0;padding:22px"><h3 class="h-m">Write to us</h3><p class="dek" style="font-size:.95rem">Letters of up to 250 words, with your name and neighborhood, go to <a href="mailto:letters@harborledger.example" class="red" style="text-decoration:underline">letters@harborledger.example</a>.</p></div></div></section>
<style>.opg{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.opi{display:block;border-left:3px solid var(--ink);padding-left:18px}.opi .q{display:block;font:800 3rem/.6 var(--serif);color:var(--red);height:22px}@media(max-width:900px){.opg{grid-template-columns:1fr}}</style>
