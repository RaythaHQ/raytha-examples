{%- assign s = widget.settings -%}
<section class="wrap" style="margin-top:56px"><div class="fdb"><div><h2 class="h-l">{{ s.headline }}</h2><p class="dek">{{ s.text }}</p></div>
<div class="fdl"><a href="{{ PathBase }}/feeds/latest.rss"><i class="bi bi-rss-fill" style="color:#e8731a"></i><b>RSS</b><span>/feeds/latest.rss</span></a><a href="{{ PathBase }}/feeds/latest.json"><i class="bi bi-braces" style="color:var(--navy)"></i><b>JSON Feed</b><span>/feeds/latest.json</span></a><a href="{{ PathBase }}/feeds/latest.rss?section=harbor-climate"><i class="bi bi-water" style="color:#0f7c7a"></i><b>One section</b><span>?section=harbor-climate</span></a><a href="mailto:tips@harborledger.example"><i class="bi bi-envelope-paper" style="color:var(--red)"></i><b>Send a tip</b><span>tips@harborledger.example</span></a></div></div></section>
<style>.fdb{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:center;border:1px solid var(--ink);background:#fff;padding:30px}.fdl{display:grid;grid-template-columns:1fr 1fr;gap:12px}.fdl a{display:grid;grid-template-columns:30px 1fr;column-gap:8px;padding:14px;border:1px solid var(--line)}.fdl a:hover{border-color:var(--ink)}.fdl i{grid-row:span 2;font-size:1.3rem}.fdl span{font-size:.78rem;color:var(--mut);font-family:ui-monospace,monospace}@media(max-width:860px){.fdb{grid-template-columns:1fr}.fdl{grid-template-columns:1fr}}</style>
