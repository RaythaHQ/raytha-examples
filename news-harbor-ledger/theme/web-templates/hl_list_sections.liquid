{%- assign all = get_content_items(ContentType="articles", OrderBy="published_on desc", PageSize=200) -%}
<section class="ph"><div class="wrap"><span class="kick">The Harbor Ledger</span><h1>Sections</h1><p>Seven desks, one city. Each section has its own front page, and every story is also in <a href="{{ PathBase }}/news" style="text-decoration:underline">the latest news</a>.</p></div></section>
<section class="wrap" style="padding-top:30px"><div class="sgrid">
{%- for s in Target.Items %}{% assign c = s.PublishedContent %}{% assign n = 0 %}{% for x in all.Items %}{% if x.PublishedContent.section.PrimaryField == s.PrimaryField %}{% assign n = n | plus: 1 %}{% if n == 1 %}{% assign top = x %}{% endif %}{% endif %}{% endfor %}
  <a class="sc" href="{{ PathBase }}/{{ s.RoutePath }}" style="--c:{{ c.color }}"><span class="ic"><i class="bi bi-{{ c.icon }}"></i></span><h2 class="h-l hd">{{ s.PrimaryField }}</h2><p class="mut" style="margin:6px 0 14px">{{ c.blurb }}</p>{% if n > 0 %}<span class="kick" style="color:var(--mut)">Latest</span><span class="h-s" style="display:block;font-family:var(--serif);font-weight:600;margin-top:6px">{{ top.PrimaryField }}</span>{% endif %}<span class="mut" style="display:block;font-size:.8rem;margin-top:12px">{{ n }} {% if n == 1 %}story{% else %}stories{% endif %}</span></a>
{%- endfor %}
</div></section>
<style>.sgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.sc{background:#fff;border:1px solid var(--line);border-top:5px solid var(--c);padding:24px}.sc:hover{border-color:var(--ink);border-top-color:var(--c)}.sc .ic{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--c);color:#fff;margin-bottom:14px}@media(max-width:900px){.sgrid{grid-template-columns:1fr}}</style>
