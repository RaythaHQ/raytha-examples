<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title %}{% if Target.Title != "The Harbor Ledger" %}{{ Target.Title }} | {% endif %}{% endif %}The Harbor Ledger</title>
  <meta name="description" content="{% if Target.PublishedContent.dek %}{{ Target.PublishedContent.dek | strip_html | escape }}{% else %}Nonprofit local news for Port Merrow: city hall, the harbor, schools, business, sports and arts.{% endif %}">
  <link rel="alternate" type="application/rss+xml" title="The Harbor Ledger: latest stories" href="{{ PathBase }}/feeds/latest.rss">
  <link rel="alternate" type="application/feed+json" title="The Harbor Ledger: latest stories (JSON Feed)" href="{{ PathBase }}/feeds/latest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,800;1,8..60,400;1,8..60,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='10' fill='%23121417'/%3E%3Ctext x='32' y='45' text-anchor='middle' font-family='Georgia,serif' font-weight='700' font-size='36' fill='%23f7f4ee'%3EL%3C/text%3E%3Crect x='14' y='50' width='36' height='4' fill='%23c4161c'/%3E%3C/svg%3E">
  <style>
    :root{--paper:#f7f4ee;--paper2:#efeae0;--ink:#121417;--ink2:#2b2f35;--mut:#646a72;--line:#d9d3c7;--line2:#121417;--red:#c4161c;--red2:#a10f14;--navy:#12355b;--serif:"Source Serif 4",Georgia,serif;--sans:"Inter",system-ui,sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font:400 16px/1.55 var(--sans);-webkit-font-smoothing:antialiased}
    a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
    h1,h2,h3,h4{font-family:var(--serif);font-weight:700;letter-spacing:-.01em;line-height:1.12;margin:0}
    .wrap{max-width:1280px;margin:0 auto;padding:0 28px}.narrow{max-width:720px;margin:0 auto}
    .util{border-bottom:1px solid var(--line);font-size:.8rem;color:var(--mut)}
    .util .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:9px;padding-bottom:9px}.util a:hover{color:var(--ink)}.util .r{display:flex;gap:18px}
    .mast{text-align:center;padding:26px 0 18px}
    .mast .name{display:inline-block;font:800 clamp(2.4rem,5.4vw,4.1rem)/1 var(--serif);letter-spacing:-.025em}
    .mast .tag{display:block;margin-top:10px;font:italic 400 1rem/1.2 var(--serif);color:var(--mut)}
    .snav{border-top:3px double var(--line2);border-bottom:1px solid var(--line2);background:var(--paper);position:sticky;top:0;z-index:40}
    .snav ul{display:flex;justify-content:center;gap:4px;list-style:none;margin:0;padding:0;overflow-x:auto;scrollbar-width:none}.snav ul::-webkit-scrollbar{display:none}
    .snav a{display:block;padding:12px 14px;font:600 .86rem/1 var(--sans);white-space:nowrap;color:var(--ink2);border-bottom:3px solid transparent}
    .snav a:hover{color:var(--red)}.snav a.on{border-bottom-color:var(--red);color:var(--ink)}
    .breaking{background:var(--red);color:#fff}
    .breaking a{display:flex;align-items:center;gap:14px;padding:11px 0;font-weight:500}
    .breaking .lbl{flex:none;font:800 .72rem/1 var(--sans);letter-spacing:.14em;background:#fff;color:var(--red);padding:6px 9px;border-radius:3px}
    .breaking .hl{font:700 1.06rem/1.3 var(--serif)}.breaking .go{margin-left:auto;flex:none;font-size:.84rem;opacity:.9;white-space:nowrap}
    .livedot{display:inline-flex;align-items:center;gap:7px;font:700 .72rem/1 var(--sans);letter-spacing:.12em;text-transform:uppercase}
    .livedot::before{content:"";width:9px;height:9px;border-radius:50%;background:currentColor;animation:pulse 1.4s infinite}
    @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,255,255,.7)}70%{box-shadow:0 0 0 9px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}
    .red{color:var(--red)}.mut{color:var(--mut)}
    .kick{display:inline-block;font:700 .72rem/1 var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--red)}
    .kick.k-opinion,.k-opinion{color:#3c3c3c}
    .meta{font-size:.8rem;color:var(--mut);display:flex;gap:6px;flex-wrap:wrap;align-items:center}.meta b{color:var(--ink2);font-weight:600}
    .h-xl{font-size:clamp(2rem,3.6vw,3.15rem);line-height:1.06;letter-spacing:-.02em}.h-l{font-size:1.6rem}.h-m{font-size:1.25rem}.h-s{font-size:1.05rem;line-height:1.25}
    a:hover .hd{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
    .dek{font:400 1.06rem/1.5 var(--serif);color:var(--ink2);margin:8px 0 0}
    .rule{border:0;border-top:1px solid var(--line);margin:0}
    .shd{display:flex;justify-content:space-between;align-items:baseline;gap:14px;border-top:3px solid var(--ink);padding-top:10px;margin-bottom:18px}
    .shd h2{font:800 1.35rem/1 var(--serif)}.shd a{font:600 .82rem/1 var(--sans);color:var(--mut)}.shd a:hover{color:var(--red)}
    .thumb{aspect-ratio:16/10;object-fit:cover;width:100%;background:var(--paper2)}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:3px;font:700 .7rem/1.1 var(--sans);letter-spacing:.06em;text-transform:uppercase;background:var(--paper2);color:var(--ink2)}
    .chips{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
    .chips a{padding:8px 12px;border:1px solid var(--line);border-radius:4px;font:600 .82rem/1 var(--sans);background:#fff;display:inline-flex;gap:7px;align-items:center}
    .chips a:hover{border-color:var(--ink)}.chips a.on{background:var(--ink);color:#fff;border-color:var(--ink)}
    .chips .lbl{font:700 .68rem/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--mut);width:70px}
    .dot{width:9px;height:9px;border-radius:50%;display:inline-block;flex:none}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border-radius:4px;font:600 .9rem/1 var(--sans);border:1px solid var(--ink);background:#fff;cursor:pointer}
    .btn:hover{background:var(--ink);color:#fff}.btn-dark{background:var(--ink);color:#fff}.btn-dark:hover{background:var(--red);border-color:var(--red)}
    .ph{padding:34px 0 24px;border-bottom:1px solid var(--line)}.ph h1{font-size:clamp(2.2rem,4.4vw,3.4rem);letter-spacing:-.02em;margin-top:8px}.ph p{font:400 1.12rem/1.5 var(--serif);color:var(--ink2);max-width:720px;margin:10px 0 0}
    .row{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:20px 0;border-top:1px solid var(--line)}.row:first-child{border-top:0}
    .row .when{font-size:.8rem;color:var(--mut)}.row .when b{display:block;color:var(--ink);font-size:.9rem}
    .av{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font:700 .95rem/1 var(--sans);color:#fff;flex:none}
    .prose{font:400 1.2rem/1.68 var(--serif);color:#1d2025}.prose p{margin:0 0 1.1em}.prose h3{font:700 1.45rem/1.25 var(--serif);margin:1.6em 0 .5em}.prose a{color:var(--red);text-decoration:underline}
    .foot{border-top:3px double var(--ink);margin-top:70px;padding:44px 0 30px;font-size:.88rem}
    .foot .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:36px}
    .foot h4{font:700 .7rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px;color:var(--mut)}
    .foot ul{list-style:none;margin:0;padding:0;display:grid;gap:8px}.foot a:hover{color:var(--red)}
    .foot .name{font:800 1.9rem/1 var(--serif);letter-spacing:-.02em}
    .foot .bottom{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:34px;padding-top:18px;color:var(--mut);font-size:.8rem}
    @media(max-width:1000px){.foot .cols{grid-template-columns:1fr 1fr}}
    @media(max-width:760px){.wrap{padding:0 18px}.util .hide-sm{display:none}.snav ul{justify-content:flex-start}.breaking .go{display:none}.row{grid-template-columns:1fr;gap:6px}.foot .cols{grid-template-columns:1fr}.mast{padding:18px 0 12px}}
    @media print{.util,.snav,.breaking,.foot,.noprint{display:none!important}body{background:#fff}}
  </style>
</head>
<body>
<div class="util"><div class="wrap"><span>{{ "now" | date: "%A, %B %-d, %Y" }}<span class="hide-sm"> &middot; Port Merrow</span></span><span class="r"><a href="{{ PathBase }}/feeds/latest.rss"><i class="bi bi-rss"></i> RSS</a><a class="hide-sm" href="{{ PathBase }}/about">About us</a><a href="mailto:tips@harborledger.example"><i class="bi bi-envelope"></i> Send a tip</a></span></div></div>
<header class="mast"><a href="{{ PathBase }}/" class="name">The Harbor Ledger</a><span class="tag">Nonprofit news for Port Merrow since 1884</span></header>
{%- assign menu = get_main_menu() %}{% assign rp = Target.RoutePath | default: "" %}{% assign isec = "" %}{% if Target.PublishedContent.section %}{% assign isec = Target.PublishedContent.section.RoutePath %}{% endif %}
<nav class="snav" aria-label="Sections"><div class="wrap"><ul>
  {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}{% assign on = false %}{% if u != "" %}{% if u == rp or u == isec %}{% assign on = true %}{% endif %}{% elsif rp == "" or rp == "home" %}{% assign on = true %}{% endif %}
  <li><a href="{{ mi.Url }}" class="{% if on %}on{% endif %}">{{ mi.Label }}</a></li>
  {%- endfor %}
</ul></div></nav>
{%- assign brk = get_content_items(ContentType="articles", Filter="breaking eq 'true'", OrderBy="published_on desc", PageSize=1) -%}
{%- for b in brk.Items %}{% capture bl %}{{ b.PublishedContent.is_live }}{% endcapture %}{% if b.RoutePath != Target.RoutePath %}
<div class="breaking"><div class="wrap"><a href="{{ PathBase }}/{{ b.RoutePath }}"><span class="lbl">BREAKING</span>{% if bl == "True" %}<span class="livedot">Live</span>{% endif %}<span class="hl">{{ b.PrimaryField }}</span><span class="go">Latest updates <i class="bi bi-arrow-right"></i></span></a></div></div>
{%- endif %}{% endfor %}
<main>{% renderbody %}</main>
<footer class="foot"><div class="wrap">
  <div class="cols">
    <div><div class="name">The Harbor Ledger</div><p class="mut" style="max-width:340px;margin:12px 0 0">Independent, nonprofit news for Port Merrow. The Harbor Ledger and Port Merrow are fictional, built as a demo with Raytha.</p></div>
    <div><h4>Sections</h4><ul>{% assign fs = get_content_items(ContentType="sections", OrderBy="sort_order asc", PageSize=12) %}{% for s in fs.Items %}<li><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a></li>{% endfor %}</ul></div>
    {%- assign fm = get_menu("footer") %}
    <div><h4>The Ledger</h4><ul>{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
    <div><h4>Follow</h4><ul><li><a href="{{ PathBase }}/feeds/latest.rss"><i class="bi bi-rss"></i> RSS feed</a></li><li><a href="{{ PathBase }}/feeds/latest.json"><i class="bi bi-braces"></i> JSON Feed</a></li><li><a href="mailto:tips@harborledger.example">tips@harborledger.example</a></li><li>(555) 018-1884</li></ul></div>
  </div>
  <div class="bottom"><span>&copy; 2026 The Harbor Ledger (fictional), a nonprofit newsroom.</span><span>Built with <a href="https://raytha.com" style="text-decoration:underline">Raytha</a></span></div>
</div></footer>
<script>(function(){var a=document.querySelector('.snav a.on');if(a){var u=a.closest('ul');u.scrollLeft=a.offsetLeft-(u.clientWidth-a.offsetWidth)/2}})();</script>
</body>
</html>
