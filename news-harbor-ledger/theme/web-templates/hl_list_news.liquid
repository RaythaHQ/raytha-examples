{%- assign kinds = "news:News,analysis:Analysis,feature:Feature,opinion:Opinion,explainer:Explainer" | split: "," -%}
{%- assign secs = get_content_items(ContentType="sections", OrderBy="sort_order asc", PageSize=20) -%}
{%- assign qs = "" %}{% for s in secs.Items %}{% assign sl = s.RoutePath | split: "/" | last %}{% if QueryParams.section == sl %}{% assign qs = sl %}{% assign qsn = s.PrimaryField %}{% endif %}{% endfor -%}
{%- assign qk = "" %}{% for d in kinds %}{% assign kv = d | split: ":" %}{% if QueryParams.type == kv[0] %}{% assign qk = kv[0] %}{% assign qkn = kv[1] %}{% endif %}{% endfor -%}
{%- capture bs %}{% if qk != "" %}&type={{ qk }}{% endif %}{% endcapture -%}{%- capture bk %}{% if qs != "" %}&section={{ qs }}{% endif %}{% endcapture -%}
<section class="ph"><div class="wrap"><span class="kick">The Harbor Ledger</span><h1>{% if qsn %}{{ qsn }}{% else %}Latest news{% endif %}{% if qkn %}: {{ qkn }}{% endif %}</h1><p>Every story we have published, newest first. Filter by section or story type, or follow along with the <a href="{{ PathBase }}/feeds/latest.rss" style="text-decoration:underline">RSS feed</a>.</p></div></section>
<section class="wrap" style="padding-top:22px">
  <div class="chips" style="margin-bottom:8px"><span class="lbl">Section</span><a href="{{ PathBase }}/news{% if bs != '' %}?{{ bs | remove_first: '&' }}{% endif %}" class="{% if qs == '' %}on{% endif %}">All</a>{% for s in secs.Items %}{% assign sl = s.RoutePath | split: "/" | last %}<a href="{{ PathBase }}/news?section={{ sl }}{{ bs }}" class="{% if qs == sl %}on{% endif %}"><span class="dot" style="background:{{ s.PublishedContent.color }}"></span>{{ s.PrimaryField }}</a>{% endfor %}</div>
  <div class="chips"><span class="lbl">Type</span><a href="{{ PathBase }}/news{% if bk != '' %}?{{ bk | remove_first: '&' }}{% endif %}" class="{% if qk == '' %}on{% endif %}">All</a>{% for d in kinds %}{% assign kv = d | split: ":" %}<a href="{{ PathBase }}/news?type={{ kv[0] }}{{ bk }}" class="{% if qk == kv[0] %}on{% endif %}">{{ kv[1] }}</a>{% endfor %}</div>
</section>
<section class="wrap" style="display:grid;grid-template-columns:1fr 300px;gap:50px;padding-top:26px" id="nl">
  <div>{% assign n = 0 %}{% assign lastd = "" %}
  {%- for x in Target.Items %}{% assign q = x.PublishedContent %}{% assign sl = q.section.RoutePath | split: "/" | last %}{% capture kd %}{{ q.kind }}{% endcapture %}{% assign ok = true %}{% if qs != "" and qs != sl %}{% assign ok = false %}{% endif %}{% if qk != "" and qk != kd %}{% assign ok = false %}{% endif %}{% if ok %}{% assign n = n | plus: 1 %}{% assign dd = q.published_on.Value | date: "%A, %B %-d" %}
    {%- if dd != lastd %}<h2 class="dayh">{{ dd }}</h2>{% assign lastd = dd %}{% endif %}
    <a class="lr" href="{{ PathBase }}/{{ x.RoutePath }}"><span>{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h3 class="h-m hd" style="margin:6px 0 0">{{ x.PrimaryField }}</h3><p class="dek" style="font-size:1rem">{{ q.dek }}</p><span style="display:block;margin-top:10px"><span class="meta"><b>{{ q.author.PrimaryField }}</b><span>&middot;</span><span>{{ q.published_on.Value | date: "%b %-d, %Y" }}</span>{% if q.read_minutes %}<span>&middot;</span><span>{{ q.read_minutes }} min read</span>{% endif %}</span></span></span><img class="thumb" src="{{ q.image.Value | attachment_redirect_url }}" alt=""></a>
  {%- endif %}{% endfor %}
  {% if n == 0 %}<div style="padding:50px 0;text-align:center"><h3 class="h-l">No stories match those filters</h3><p><a href="{{ PathBase }}/news" class="red" style="text-decoration:underline">Show all stories</a></p></div>{% endif %}
  </div>
  <aside>{% assign mr = get_content_items(ContentType="articles", OrderBy="reads desc", PageSize=5) %}<div class="shd"><h2>Most read</h2><a href="{{ PathBase }}/most-read">Top 10</a></div><ol class="mr">{% for x in mr.Items %}<li><a href="{{ PathBase }}/{{ x.RoutePath }}" class="hd">{{ x.PrimaryField }}</a></li>{% endfor %}</ol></aside>
</section>
<style>.lr{display:grid;grid-template-columns:1fr 260px;gap:26px;padding:22px 0;border-top:1px solid var(--line);align-items:start}@media(max-width:700px){.lr{grid-template-columns:1fr 110px;gap:14px}.lr .dek{display:none}.lr h3{font-size:1.08rem}}</style><style>.dayh{font:700 .74rem/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--mut);padding:26px 0 4px}.dayh:first-child{padding-top:0}
.mr{list-style:none;counter-reset:m;margin:0;padding:0}.mr li{counter-increment:m;display:grid;grid-template-columns:36px 1fr;gap:6px;padding:12px 0;border-top:1px solid var(--line);font:600 1rem/1.3 var(--serif)}.mr li:first-child{border-top:0}.mr li::before{content:counter(m);font:800 1.5rem/1 var(--serif);color:var(--red)}
@media(max-width:900px){#nl{grid-template-columns:1fr!important}}</style>
