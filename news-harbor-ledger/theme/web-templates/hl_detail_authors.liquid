{%- assign c = Target.PublishedContent -%}{% assign ws = Target.PrimaryField | split: " " %}
{%- assign all = get_content_items(ContentType="articles", OrderBy="published_on desc", PageSize=200) -%}
<section class="ph"><div class="wrap" style="display:flex;gap:26px;align-items:center;flex-wrap:wrap"><span class="av" style="background:{{ c.color }};width:110px;height:110px;font-size:2.2rem">{{ ws[0] | slice: 0 }}{{ ws[1] | slice: 0 }}</span>
  <div style="flex:1;min-width:260px"><a class="kick" href="{{ PathBase }}/staff">Our newsroom</a><h1 style="margin-top:6px">{{ Target.PrimaryField }}</h1><p style="margin-top:6px"><b>{{ c.role }}</b> &middot; {{ c.beat }}</p></div></div></section>
<section class="wrap" style="display:grid;grid-template-columns:300px 1fr;gap:56px;padding-top:30px" id="ag">
  <aside><p class="dek" style="margin:0 0 18px">{{ c.bio }}</p><a class="btn" href="mailto:{{ c.email }}"><i class="bi bi-envelope"></i> {{ c.email }}</a></aside>
  <div><div class="shd"><h2>Recent stories</h2></div>{% assign n = 0 %}
  {%- for x in all.Items %}{% if x.PublishedContent.author.PrimaryField == Target.PrimaryField %}{% assign n = n | plus: 1 %}{% assign q = x.PublishedContent %}<a class="lr" href="{{ PathBase }}/{{ x.RoutePath }}"><span>{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h3 class="h-m hd" style="margin:6px 0 0">{{ x.PrimaryField }}</h3><p class="dek" style="font-size:1rem">{{ q.dek }}</p><span style="display:block;margin-top:10px"><span class="meta"><b>{{ q.author.PrimaryField }}</b><span>&middot;</span><span>{{ q.published_on.Value | date: "%b %-d, %Y" }}</span>{% if q.read_minutes %}<span>&middot;</span><span>{{ q.read_minutes }} min read</span>{% endif %}</span></span></span><img class="thumb" src="{{ q.image.Value | attachment_redirect_url }}" alt=""></a>{% endif %}{% endfor %}
  {% if n == 0 %}<p class="mut">No stories yet.</p>{% endif %}</div>
</section>
<style>.lr{display:grid;grid-template-columns:1fr 260px;gap:26px;padding:22px 0;border-top:1px solid var(--line);align-items:start}@media(max-width:700px){.lr{grid-template-columns:1fr 110px;gap:14px}.lr .dek{display:none}.lr h3{font-size:1.08rem}}</style><style>@media(max-width:860px){#ag{grid-template-columns:1fr!important;gap:24px!important}}</style>
