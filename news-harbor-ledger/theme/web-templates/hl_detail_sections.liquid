{%- assign s = Target.PublishedContent -%}
{%- assign all = get_content_items(ContentType="articles", OrderBy="published_on desc", PageSize=200) -%}
<section class="ph" style="border-bottom:0"><div class="wrap"><span class="kick" style="color:{{ s.color }}"><i class="bi bi-{{ s.icon }}"></i> Section</span><h1>{{ Target.PrimaryField }}</h1><p>{{ s.blurb }}.</p></div></section>
<section class="wrap"><div style="border-top:4px solid {{ s.color }}"></div>
  {%- assign n = 0 %}{% for x in all.Items %}{% if x.PublishedContent.section.PrimaryField == Target.PrimaryField %}{% assign n = n | plus: 1 %}{% assign q = x.PublishedContent %}
  {%- if n == 1 %}<a class="slead" href="{{ PathBase }}/{{ x.RoutePath }}"><img class="thumb" src="{{ q.image.Value | attachment_redirect_url }}" alt=""><span>{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h2 class="h-xl hd" style="margin:10px 0 0">{{ x.PrimaryField }}</h2><p class="dek" style="font-size:1.15rem">{{ q.dek }}</p><span style="display:block;margin-top:14px"><span class="meta"><b>{{ q.author.PrimaryField }}</b><span>&middot;</span><span>{{ q.published_on.Value | date: "%b %-d, %Y" }}</span>{% if q.read_minutes %}<span>&middot;</span><span>{{ q.read_minutes }} min read</span>{% endif %}</span></span></span></a>
  {%- else %}<a class="lr" href="{{ PathBase }}/{{ x.RoutePath }}"><span>{% capture kd %}{{ q.kind }}{% endcapture %}{% capture lv %}{{ q.is_live }}{% endcapture %}{% if lv == "True" %}<span class="kick">&#9679; Live</span>{% elsif kd == "analysis" %}<span class="kick">Analysis</span>{% elsif kd == "opinion" %}<span class="kick k-opinion">Opinion</span>{% elsif kd == "explainer" %}<span class="kick">Explainer</span>{% else %}<span class="kick" style="color:{{ q.section.PublishedContent.color }}">{{ q.section.PrimaryField }}</span>{% endif %}<h3 class="h-m hd" style="margin:6px 0 0">{{ x.PrimaryField }}</h3><p class="dek" style="font-size:1rem">{{ q.dek }}</p><span style="display:block;margin-top:10px"><span class="meta"><b>{{ q.author.PrimaryField }}</b><span>&middot;</span><span>{{ q.published_on.Value | date: "%b %-d, %Y" }}</span>{% if q.read_minutes %}<span>&middot;</span><span>{{ q.read_minutes }} min read</span>{% endif %}</span></span></span><img class="thumb" src="{{ q.image.Value | attachment_redirect_url }}" alt=""></a>{% endif %}{% endif %}{% endfor %}
  {% if n == 0 %}<p class="mut" style="padding:40px 0">No stories in this section yet.</p>{% endif %}
  <p style="margin-top:30px"><a class="btn" href="{{ PathBase }}/news?section={{ Target.RoutePath | split: '/' | last }}">Filter {{ Target.PrimaryField }} by story type <i class="bi bi-arrow-right"></i></a></p>
</section>
<style>.lr{display:grid;grid-template-columns:1fr 260px;gap:26px;padding:22px 0;border-top:1px solid var(--line);align-items:start}@media(max-width:700px){.lr{grid-template-columns:1fr 110px;gap:14px}.lr .dek{display:none}.lr h3{font-size:1.08rem}}</style><style>.slead{display:grid;grid-template-columns:1.25fr 1fr;gap:34px;padding:26px 0 30px;align-items:center}@media(max-width:800px){.slead{grid-template-columns:1fr;gap:16px}}</style>
