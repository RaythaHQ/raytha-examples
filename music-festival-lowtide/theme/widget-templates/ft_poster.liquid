{%- assign s = widget.settings -%}
{%- assign all = get_content_items(ContentType="artists", OrderBy="tier asc", PageSize=100) -%}
{%- assign days = "fri:Friday:July 16,sat:Saturday:July 17,sun:Sunday:July 18" | split: "," -%}
<section class="section light poster-s"><div class="wrap">
  <div class="shead"><div><span class="eyebrow">{{ s.kicker }}</span><h2>{{ s.headline }} <span style="color:#c2410c">{{ s.accent }}</span></h2></div>{% if s.subtitle %}<p>{{ s.subtitle }}</p>{% endif %}</div>
  <div class="poster">
  {%- for d in days %}{% assign kv = d | split: ":" %}
    <div class="pday reveal"><div class="ph"><b>{{ kv[1] }}</b><span>{{ kv[2] }}</span></div>
      {%- for t in (1..3) %}<p class="t{{ t }}">{% assign first = true %}{% for a in all.Items %}{% assign q = a.PublishedContent %}{% capture dy %}{{ q.day }}{% endcapture %}{% assign tr = q.tier | append: "" | plus: 0 %}{% if dy == kv[0] and tr == t %}{% unless first %}<i>&bull;</i>{% endunless %}<a href="{{ PathBase }}/{{ a.RoutePath }}">{{ a.PrimaryField }}</a>{% assign first = false %}{% endif %}{% endfor %}</p>{% endfor %}
      <a class="btn btn-dark" href="{{ PathBase }}/schedule?day={{ kv[0] }}" style="margin-top:14px;padding:.6rem 1rem;font-size:.85rem">{{ kv[1] }} schedule <i class="bi bi-arrow-right"></i></a>
    </div>
  {%- endfor %}
  </div>
  <div style="text-align:center;margin-top:40px"><a class="btn btn-dark" href="{{ PathBase }}/lineup">Explore the full lineup <i class="bi bi-arrow-right"></i></a></div>
</div></section>
<style>
  .poster{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .pday{background:var(--night);color:var(--sand);border-radius:24px;padding:30px 28px;text-align:center;position:relative;overflow:hidden}
  .pday::before{content:"";position:absolute;left:-20%;right:-20%;top:-60%;height:100%;background:radial-gradient(circle,rgba(255,107,74,.35),transparent 60%)}
  .pday .ph{position:relative;margin-bottom:18px}.pday .ph b{display:block;font:700 1rem/1 var(--disp);letter-spacing:.2em;text-transform:uppercase;color:var(--tang)}.pday .ph span{font-size:.85rem;color:var(--mut)}
  .pday p{margin:0 0 12px;position:relative;line-height:1.15}.pday p a:hover{color:var(--coral)}.pday p i{font-style:normal;color:var(--coral);margin:0 .4em;opacity:.8}
  .pday .t1{font:700 clamp(2rem,3.4vw,2.9rem)/1 var(--disp);letter-spacing:-.04em}
  .pday .t2{font:600 1.18rem/1.4 var(--disp)}.pday .t3{font:500 .92rem/1.5 var(--sans);color:#b8c5d2}
  .pday .btn{background:var(--sand);color:var(--night)}
  @media(max-width:900px){.poster{grid-template-columns:1fr}}
</style>
