{%- assign p = Target.PublishedContent -%}{% assign pc = p.program.PublishedContent.color %}
{%- assign ss = get_content_items(ContentType="stories", OrderBy="published_on desc", PageSize=4) -%}
<article>
<header class="wrap narrow" style="padding:80px 32px 40px;text-align:center">
  <div class="crumbs" style="justify-content:center"><a href="{{ PathBase }}/stories">Impact stories</a><span>/</span><a href="{{ PathBase }}/{{ p.program.RoutePath }}">{{ p.program.PrimaryField }}</a></div>
  <h1 style="font-size:clamp(2.8rem,6vw,5rem);margin:22px 0 22px">{{ Target.PrimaryField }}</h1>
  <p style="font:400 1.4rem/1.5 var(--serif);color:#454d47;margin:0 auto;max-width:680px"><em>{{ p.dek }}</em></p>
  <p class="mut" style="margin-top:24px;font-size:.92rem">By {{ p.author }} &middot; {{ p.published_on.Value | date: "%B %-d, %Y" }}</p>
</header>
<div class="wrap" style="max-width:1320px"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="Illustration for {{ Target.PrimaryField }}" style="width:100%;border-radius:20px;aspect-ratio:16/8;object-fit:cover"></div>
<div class="wrap" style="display:grid;grid-template-columns:1fr 300px;gap:80px;padding-top:64px;padding-bottom:40px" id="sd">
  <div class="prose dropcap">{{ p.body }}</div>
  <aside><div style="position:sticky;top:110px;display:grid;gap:20px">
    <div class="card" style="border-top:4px solid {{ pc }}"><div class="num" style="color:var(--rust)">{{ p.stat_value }}</div><p style="margin-top:8px">{{ p.stat_label }}</p></div>
    <a class="card" href="{{ PathBase }}/{{ p.grantee.RoutePath }}"><span class="eyebrow">The grantee</span><h3 style="font-size:1.35rem;margin:12px 0 6px">{{ p.grantee.PrimaryField }}</h3><p style="font-size:.95rem">{{ p.grantee.PublishedContent.amount | append: "" | plus: 0 | format_number: "N0" | prepend: "$" }} &middot; {{ p.program.PrimaryField }}</p></a>
    <button class="btn btn-line noprint" type="button" onclick="navigator.clipboard&&navigator.clipboard.writeText(location.href);this.querySelector('span').textContent='Link copied'"><i class="bi bi-link-45deg"></i> <span>Copy link</span></button>
  </div></aside>
</div>
<section class="wrap narrow" style="padding:30px 32px 90px"><blockquote class="pq"><p>&ldquo;{{ p.quote }}&rdquo;</p><cite>{{ p.quote_by }}</cite></blockquote></section>
</article>
<section class="section alt"><div class="wrap"><div class="shead"><div><span class="eyebrow">Keep reading</span><h2>More <em>stories</em></h2></div><a class="btn btn-line" href="{{ PathBase }}/stories">All stories</a></div><div class="grid3">
{%- assign k = 0 %}{% for s in ss.Items %}{% if s.Id != Target.Id and k < 3 %}{% assign k = k | plus: 1 %}{% assign q = s.PublishedContent %}<a class="card" href="{{ PathBase }}/{{ s.RoutePath }}" style="padding:0;overflow:hidden"><img src="{{ q.image.Value | attachment_redirect_url }}" alt="" loading="lazy" style="aspect-ratio:16/10;object-fit:cover;width:100%"><div style="padding:24px"><h3>{{ s.PrimaryField }}</h3><p>{{ q.dek | truncatewords: 18 }}</p></div></a>{% endif %}{% endfor %}
</div></div></section>
<style>.dropcap>p:first-child::first-letter{float:left;font:500 5.2rem/.8 var(--serif);color:var(--rust);margin:.08em .1em 0 0}
.pq{margin:0;padding:40px 0 0;border-top:3px solid var(--rust);text-align:center}.pq p{font:400 italic clamp(1.8rem,3.4vw,2.6rem)/1.3 var(--serif);margin:0 0 18px;color:var(--forest)}.pq cite{font:600 .82rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-style:normal}
@media(max-width:900px){#sd{grid-template-columns:1fr!important;gap:30px!important}#sd aside>div{position:static!important}}</style>
