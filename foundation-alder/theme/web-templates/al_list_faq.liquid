{%- assign cats = "eligibility:Eligibility,process:Applying,after:After you apply" | split: "," -%}
<section class="phead"><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/apply">How to apply</a><span>/</span><span>FAQ</span></div><h1>Applicant <em>questions.</em></h1><p class="lead">Can't find your answer? Book a call with a program officer, or write to <a href="mailto:grants@alder.example" style="text-decoration:underline">grants@alder.example</a>.</p></div></section>
<section style="padding:50px 0 100px"><div class="wrap narrow">{% for c in cats %}{% assign kv = c | split: ":" %}<h2 style="font-size:2rem;margin:40px 0 12px">{{ kv[1] }}</h2><div class="faq">{% for f in Target.Items %}{% capture fc %}{{ f.PublishedContent.category }}{% endcapture %}{% if fc == kv[0] %}<details id="{{ f.RoutePath | split: '/' | last }}"><summary>{{ f.PrimaryField }}</summary><p>{{ f.PublishedContent.answer }}</p></details>{% endif %}{% endfor %}</div>{% endfor %}
<a class="btn btn-forest" href="{{ PathBase }}/apply" style="margin-top:40px"><i class="bi bi-arrow-left"></i> Back to How to apply</a></div></section>
