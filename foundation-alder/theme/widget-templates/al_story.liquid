{%- assign s = widget.settings -%}{%- assign fs = get_content_items(ContentType="stories", Filter="featured eq 'true'", OrderBy="published_on desc", PageSize=1) -%}
{%- for x in fs.Items %}{% assign p = x.PublishedContent %}
<section class="section"><div class="wrap"><a class="fst reveal" href="{{ PathBase }}/{{ x.RoutePath }}"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="">
  <div><span class="eyebrow">{{ s.kicker }}</span><h2>{{ x.PrimaryField }}</h2><p>{{ p.dek }}</p><blockquote>&ldquo;{{ p.quote }}&rdquo;<cite>{{ p.quote_by }}</cite></blockquote><span class="btn btn-forest">Read the story <i class="bi bi-arrow-right"></i></span></div></a></div></section>{% endfor %}
<style>.fst{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center}.fst img{border-radius:20px;width:100%;aspect-ratio:4/3;object-fit:cover}.fst h2{font-size:clamp(2.4rem,4.4vw,3.8rem);margin:16px 0 14px}.fst:hover h2{color:var(--rust2)}
.fst p{font:400 1.22rem/1.55 var(--serif);color:#454d47;margin:0 0 22px}.fst blockquote{margin:0 0 28px;padding-left:20px;border-left:3px solid var(--rust);font:italic 400 1.3rem/1.45 var(--serif);color:var(--forest)}.fst cite{display:block;font:600 .78rem/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--mut);font-style:normal;margin-top:12px}
@media(max-width:900px){.fst{grid-template-columns:1fr;gap:26px}}</style>
