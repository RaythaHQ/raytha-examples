{%- assign s = widget.settings -%}{%- assign lim = s.count | append: "" | plus: 0 -%}{% if lim == 0 %}{% assign lim = 6 %}{% endif %}
{%- assign gs = get_content_items(ContentType="grantees", Filter="year eq 'y2026'", OrderBy="amount desc", PageSize=lim) -%}
<section class="section alt"><div class="wrap" style="display:grid;grid-template-columns:1fr 1.6fr;gap:70px" id="rcg">
  <div><span class="eyebrow">{{ s.kicker }}</span><h2 style="font-size:clamp(2.3rem,4vw,3.4rem);margin:14px 0 16px">{{ s.headline }} <em>{{ s.accent }}</em></h2><p class="mut">{{ s.subtitle }}</p><a class="btn btn-line" href="{{ PathBase }}/grantees" style="margin-top:12px">All grantees <i class="bi bi-arrow-right"></i></a></div>
  <div>{% for g in gs.Items %}{% assign q = g.PublishedContent %}{% assign ws = g.PrimaryField | split: " " %}<a class="gt reveal" href="{{ PathBase }}/{{ g.RoutePath }}"><span class="mono" style="background:{{ q.program.PublishedContent.color }}">{{ ws[0] | slice: 0 }}{{ ws[1] | slice: 0 }}</span><span><b style="font:500 1.25rem/1.2 var(--serif)">{{ g.PrimaryField }}</b><span class="mut" style="display:block;font-size:.93rem;margin-top:3px">{{ q.program.PrimaryField }} &middot; {{ q.purpose | truncatewords: 12 }}</span></span><span class="amt">{{ q.amount | append: "" | plus: 0 | format_number: "N0" | prepend: "$" }}</span></a>{% endfor %}</div>
</div></section><style>@media(max-width:900px){#rcg{grid-template-columns:1fr!important;gap:26px!important}}</style>
