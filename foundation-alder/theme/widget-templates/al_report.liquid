{%- assign s = widget.settings -%}{%- assign rs = get_content_items(ContentType="reports", OrderBy="year desc", PageSize=1) -%}
{%- for r in rs.Items %}{% assign q = r.PublishedContent %}{% assign hl = q.highlights | newline_to_br | split: "<br />" %}
<section class="section"><div class="wrap" style="display:grid;grid-template-columns:340px 1fr;gap:80px;align-items:center" id="lrp">
  <a class="cv reveal" href="{{ PathBase }}/{{ r.RoutePath }}" style="--c:{{ q.cover_color }}"><span class="cy">{{ q.year }}</span><svg viewBox="0 0 200 200" aria-hidden="true">{% for i in (1..7) %}<circle cx="150" cy="150" r="{{ i | times: 22 }}" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="1.5"/>{% endfor %}</svg><span class="ct">Annual Report</span></a>
  <div><span class="eyebrow">{{ s.kicker }}</span><h2 style="font-size:clamp(2.3rem,4vw,3.4rem);margin:14px 0 16px">{{ s.headline }} <em>{{ s.accent }}</em></h2><p style="font:400 1.2rem/1.55 var(--serif);color:#454d47;margin:0 0 18px">{{ q.summary }}</p>
    <ul class="lst">{% for h in hl limit: 4 %}{% assign hs = h | strip %}{% if hs != "" %}<li><i class="bi bi-check2"></i> {{ hs }}</li>{% endif %}{% endfor %}</ul>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px"><a class="btn btn-forest" href="{{ PathBase }}/{{ r.RoutePath }}">Read the {{ q.year }} report</a><a class="btn btn-line" href="{{ PathBase }}/reports">All reports</a></div></div>
</div></section>{% endfor %}
<style>.cv{position:relative;aspect-ratio:3/4;border-radius:10px 18px 18px 10px;background:var(--c);color:#fff;padding:30px;display:flex;flex-direction:column;overflow:hidden;box-shadow:inset 10px 0 0 rgba(0,0,0,.14),0 30px 60px rgba(22,48,42,.2);transform:rotate(-3deg);transition:transform .3s}.cv:hover{transform:rotate(0)}
.cv svg{position:absolute;right:-30px;bottom:-30px;width:90%}.cv .cy{font:500 5rem/1 var(--serif);letter-spacing:-.04em}.cv .ct{margin-top:auto;font:600 .8rem/1 var(--sans);letter-spacing:.18em;text-transform:uppercase}
.lst{list-style:none;padding:0;margin:0;display:grid;gap:10px}.lst i{color:var(--moss);margin-right:6px}
@media(max-width:900px){#lrp{grid-template-columns:1fr!important;gap:30px!important}#lrp .cv{max-width:260px}}</style>
