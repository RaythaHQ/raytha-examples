{%- assign s = widget.settings -%}{%- assign ps = get_content_items(ContentType="programs", OrderBy="sort_order asc", PageSize=10) -%}
{%- assign yl = s.yes_list | newline_to_br | split: "<br />" -%}{%- assign nl = s.no_list | newline_to_br | split: "<br />" -%}
<section class="section alt"><div class="wrap"><div class="shead"><div><span class="eyebrow">{{ s.kicker }}</span><h2>{{ s.headline }} <em>{{ s.accent }}</em></h2></div>{% if s.subtitle != "" %}<p>{{ s.subtitle }}</p>{% endif %}</div>
  <div class="grid2"><div class="card"><h3><i class="bi bi-check-circle-fill" style="color:var(--moss)"></i> {{ s.yes_title }}</h3><ul class="el">{% for l in yl %}{% assign t = l | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></div>
  <div class="card"><h3><i class="bi bi-x-circle-fill" style="color:#b5453a"></i> {{ s.no_title }}</h3><ul class="el no">{% for l in nl %}{% assign t = l | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></div></div>
  <div class="card" style="margin-top:26px;padding:10px 30px 20px;overflow-x:auto"><table class="dl"><thead><tr><th>Program</th><th>Grant size</th><th>Length</th><th>Status</th><th>Next deadline</th></tr></thead><tbody>
  {% for x in ps.Items %}{% assign p = x.PublishedContent %}{% capture st %}{{ p.status }}{% endcapture %}<tr><td><a href="{{ PathBase }}/{{ x.RoutePath }}" style="display:inline-flex;gap:10px;align-items:center;font:500 1.15rem/1.2 var(--serif)"><span class="dot" style="background:{{ p.color }}"></span>{{ x.PrimaryField }}</a></td><td>{{ p.grant_range }}</td><td>{{ p.term }}</td><td>{% if st == "open" %}<span class="pill" style="background:#dfe9d6;color:#2f4d22">Open</span>{% elsif st == "rolling" %}<span class="pill" style="background:#d9e8ef;color:#1d4a5e">Rolling</span>{% elsif st == "invite" %}<span class="pill" style="background:#ece0f2;color:#4f3470">By invitation</span>{% else %}<span class="pill">Closed</span>{% endif %}</td><td><b>{{ p.deadline.Value | date: "%b %-d, %Y" }}</b></td></tr>{% endfor %}
  </tbody></table></div>
</div></section>
<style>.el{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:12px}.el li{padding-left:28px;position:relative;color:#38403a}.el li::before{content:"\F26E";font-family:bootstrap-icons;position:absolute;left:0;color:var(--moss)}.el.no li::before{content:"\F62A";color:#b5453a}
.dl{width:100%;border-collapse:collapse;min-width:640px}.dl th{text-align:left;font:600 .72rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--mut);padding:18px 12px 14px 0}.dl td{padding:16px 12px 16px 0;border-top:1px solid var(--line)}</style>
