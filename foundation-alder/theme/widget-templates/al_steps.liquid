{%- assign s = widget.settings -%}
<section class="section"><div class="wrap"><div class="shead"><div><span class="eyebrow">{{ s.kicker }}</span><h2>{{ s.headline }} <em>{{ s.accent }}</em></h2></div>{% if s.subtitle != "" %}<p>{{ s.subtitle }}</p>{% endif %}</div>
  <ol class="steps">{% for st in s.steps %}<li class="reveal"><span class="sn">{{ forloop.index }}</span><span class="sw">{{ st.when }}</span><h3>{{ st.title }}</h3><p>{{ st.text }}</p></li>{% endfor %}</ol>
</div></section>
<style>.steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,1fr);gap:0;position:relative}.steps::before{content:"";position:absolute;left:24px;right:24px;top:24px;height:2px;background:repeating-linear-gradient(90deg,var(--forest) 0 8px,transparent 8px 14px)}
.steps li{position:relative;padding-right:24px}.sn{display:grid;place-items:center;width:50px;height:50px;border-radius:50%;background:var(--forest);color:var(--paper);font:500 1.3rem/1 var(--serif);position:relative;margin-bottom:20px}.steps li:last-child .sn{background:var(--rust)}
.sw{display:block;font:600 .74rem/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--rust2);margin-bottom:8px}.steps h3{font-size:1.4rem;margin-bottom:8px}.steps p{margin:0;color:var(--mut);font-size:.96rem}
@media(max-width:1000px){.steps{grid-template-columns:1fr;gap:26px}.steps::before{left:24px;right:auto;top:24px;bottom:24px;width:2px;height:auto;background:repeating-linear-gradient(180deg,var(--forest) 0 8px,transparent 8px 14px)}.steps li{padding-left:74px;padding-right:0}.sn{position:absolute;left:0;top:0}}</style>
