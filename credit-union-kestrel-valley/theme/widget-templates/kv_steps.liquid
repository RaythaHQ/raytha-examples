{%- assign s = widget.settings -%}<section class="sec" style="padding-top:30px;padding-bottom:20px;scroll-margin-top:90px"{% if s.anchor %} id="{{ s.anchor }}"{% endif %}><div class="wrap"><div class="shead"><div><span class="kicker">{{ s.kicker }}</span><h2>{{ s.headline }}</h2>{% if s.intro %}<p>{{ s.intro }}</p>{% endif %}</div></div>
<div class="steps">{% for x in s.items %}<div class="card"><h3 style="font-size:1.1rem">{{ x.title }}</h3><p class="muted" style="margin:8px 0 0;font-size:.95rem">{{ x.text }}</p></div>{% endfor %}</div></div></section>
