{%- assign s = widget.settings -%}<section class="sec" style="padding-top:10px"><div class="wrap own"><div><span class="kicker">{{ s.kicker }}</span><h2 style="margin:8px 0 12px">{{ s.headline }}</h2><div class="prose" style="font-size:1rem">{{ s.body }}</div></div>
<div class="stats" style="grid-template-columns:repeat(2,1fr)">{% for x in s.items %}<div><b>{{ x.value }}</b><span>{{ x.label }}</span></div>{% endfor %}</div></div></section>
