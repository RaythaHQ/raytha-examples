{%- assign s = widget.settings -%}<section class="body" style="padding-bottom:10px"><div class="wrap"><div class="card pad" style="padding:32px"><h2 style="margin-top:0">{{ s.headline }}</h2><p class="muted">{{ s.intro }}</p>
<div class="calc"><div><label for="ca">Loan amount ($)</label><input id="ca" type="number" min="500" step="100" value="{{ s.default_amount }}" inputmode="decimal">
<label for="cr">Rate (APR, %)</label><input id="cr" type="number" min="0" step="0.01" value="{{ s.default_rate }}" inputmode="decimal">
<label for="cm">Term</label><select id="cm">{% assign ts = "24,36,48,60,72,84,180,360" | split: "," %}{% for t in ts %}<option value="{{ t }}"{% if t == s.default_months %} selected{% endif %}>{{ t }} months</option>{% endfor %}</select></div>
<div class="out" aria-live="polite"><span>Estimated monthly payment</span><b id="cp">$0</b><span id="ct" style="font-size:.9rem"></span></div></div>
<p class="disc" style="margin-top:18px">An estimate only, for a fictional credit union. It does not include taxes, insurance or fees, and it is not an offer of credit.</p></div></div></section>
<script>(function(){var a=document.getElementById('ca'),r=document.getElementById('cr'),m=document.getElementById('cm'),p=document.getElementById('cp'),t=document.getElementById('ct');function f(){var P=+a.value||0,i=(+r.value||0)/1200,n=+m.value,x=i?P*i/(1-Math.pow(1+i,-n)):P/n;p.textContent='$'+x.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});t.textContent='Total interest: $'+Math.max(0,x*n-P).toLocaleString('en-US',{maximumFractionDigits:0})}[a,r,m].forEach(function(e){e.addEventListener('input',f)});f()})();</script>
