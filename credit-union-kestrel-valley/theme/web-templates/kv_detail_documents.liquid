{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture dk %}{{ p.kind }}{% endcapture %}{% capture mo %}{{ p.members_only | downcase }}{% endcapture %}{% for pair in dks %}{% assign kv = pair | split: ":" %}{% if kv[0] == dk %}{% assign dl = kv[1] %}{% assign di = kv[2] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/documents">Documents</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:10px"><span class="pill blue"><i class="bi bi-{{ di }}" aria-hidden="true"></i> {{ dl }}</span>{% if mo == "true" %}<span class="pill gold"><i class="bi bi-lock" aria-hidden="true"></i> Members only</span>{% endif %}</div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap">{% if mo == "true" and is_mem == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This document is for members.</h2><p style="max-width:600px">Sign in to the member area of this website to see annual meeting materials, minutes and other member documents. This is a website account, not online banking.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the member area</a><a class="btn btn-w" href="{{ PathBase }}/about#join">Become a member</a></div></div>{% else %}<div class="art">
  <article class="card pad prose" style="padding:32px">{{ p.body }}<p style="margin-top:20px"><a class="btn btn-p" style="text-decoration:none" href="{{ p.file.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download the PDF</a></p></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px"><div class="card pad"><dl class="facts"><div><dt>Kind</dt><dd>{{ dl }}</dd></div><div><dt>Year</dt><dd>{{ p.year }}</dd></div><div><dt>Posted</dt><dd>{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></div><div><dt>Access</dt><dd>{% if mo == "true" %}Members{% else %}Public{% endif %}</dd></div></dl></div>
  <p><a href="{{ PathBase }}/documents"><i class="bi bi-arrow-left" aria-hidden="true"></i> All documents</a></p></aside></div>{% endif %}
</div></div>
