{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}
{%- assign qt = "" -%}{%- for pair in tps %}{% assign kv = pair | split: ":" %}{% if QueryParams.topic == kv[0] %}{% assign qt = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Learning center</li></ol></nav><h1>Learning center</h1><p>Short, plain-language guides on budgeting, credit, buying a home and avoiding scams. Free for everyone, member or not.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter by topic"><a href="{{ PathBase }}/learn"{% if qt == "" %} aria-current="true"{% endif %}>All topics</a>{% for pair in tps %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/learn?topic={{ kv[0] }}"{% if qt == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="grid g3">{% for a in Target.Items %}{% capture k %}{{ a.PublishedContent.topic }}{% endcapture %}{% if qt == "" or qt == k %}{% assign x = a.PublishedContent %}{% capture tk %}{{ x.topic }}{% endcapture %}{% for pair in tps %}{% assign kv = pair | split: ":" %}{% if kv[0] == tk %}{% assign tl = kv[1] %}{% assign ti = kv[2] %}{% endif %}{% endfor %}<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill blue"><i class="bi bi-{{ ti }}" aria-hidden="true"></i> {{ tl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.minutes }} minute read</p></div></a>{% endif %}{% endfor %}</div>
</div></div>
