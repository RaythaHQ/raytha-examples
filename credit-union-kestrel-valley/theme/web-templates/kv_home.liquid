{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}
{%- assign fr = get_content_items(ContentType="rates", Filter="featured eq 'true'", OrderBy="sort_order asc", PageSize=6) -%}
<section class="hero" aria-labelledby="hh"><div class="wrap hgrid">
  <div>{{ render_section("hero", wrap=false) }}</div>
  <aside class="rateboard" aria-labelledby="rbh"><div class="rh"><b id="rbh">Today's rates</b><small>Effective {{ fr.Items[0].PublishedContent.effective.Value | date: "%B %-d, %Y" }}</small></div>
    {% for r in fr.Items %}{% assign x = r.PublishedContent %}{% capture rk %}{{ x.rate_type }}{% endcapture %}{% capture lo %}{{ x.as_low_as | downcase }}{% endcapture %}<a class="rrow" href="{{ PathBase }}/rates#{{ x.table }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.product.PublishedContent.icon }}"></i></span><span><b>{{ r.PrimaryField }}</b><small>{% capture c_x_minimum %}{{ x.minimum | strip }}{% endcapture %}{% if c_x_minimum != "" %}Min. {{ x.minimum }}{% else %}{{ x.term }}{% endif %}</small></span><span class="rv">{% if lo == "true" %}<em>AS LOW AS</em>{% endif %}<strong>{{ x.rate }}%</strong><em>{{ rk | upcase }}*</em></span></a>{% endfor %}
    <div class="rf">*Fictional rates for a demo site. APY = annual percentage yield, APR = annual percentage rate. <a href="{{ PathBase }}/rates">All rates</a></div></aside>
</div><svg class="sky" viewBox="0 0 1440 260" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false"><circle cx="1210" cy="70" r="40" fill="#d08a3c" opacity=".85"/><circle cx="1210" cy="70" r="72" fill="#d08a3c" opacity=".12"/><path d="M0 150 L120 96 L230 140 L360 70 L470 130 L600 90 L740 150 L860 84 L1000 140 L1120 100 L1260 150 L1360 110 L1440 130 V260 H0Z" fill="#0f4d49" opacity=".55"/><path d="M0 190 Q 240 140 480 176 T 960 168 T 1440 160 V260 H0Z" fill="#1d6e66" opacity=".75"/><path d="M0 220 Q 360 186 720 210 T 1440 204 V260 H0Z" fill="#2f8a7d" opacity=".85"/><path d="M560 260 C 620 230 700 222 760 214 S 880 200 940 206" stroke="#a9d8cf" stroke-width="7" fill="none" opacity=".7"/><rect x="180" y="204" width="34" height="22" fill="#0c3b3a" opacity=".85"/><path d="M176 206 L197.0 190 L218 206Z" fill="#0c3b3a" opacity=".85"/><rect x="224" y="210" width="22" height="16" fill="#0c3b3a" opacity=".85"/><path d="M220 212 L235.0 196 L250 212Z" fill="#0c3b3a" opacity=".85"/><rect x="1020" y="200" width="40" height="26" fill="#0c3b3a" opacity=".85"/><path d="M1016 202 L1040.0 186 L1064 202Z" fill="#0c3b3a" opacity=".85"/><rect x="1070" y="208" width="26" height="18" fill="#0c3b3a" opacity=".85"/><path d="M1066 210 L1083.0 194 L1100 210Z" fill="#0c3b3a" opacity=".85"/><rect x="1110" y="206" width="30" height="20" fill="#0c3b3a" opacity=".85"/><path d="M1106 208 L1125.0 192 L1144 208Z" fill="#0c3b3a" opacity=".85"/><path d="M300 60c22-12 44-12 66 0c-22-4-44-4-66 0z" fill="#f3e3cf" opacity=".85"/><path d="M332 60l-8 16 16-16z" fill="#f3e3cf" opacity=".85"/><path d="M0 244 Q 720 222 1440 244 V260 H0Z" fill="#f6f4ef"/></svg></section>
{{ render_section("tasks", wrap=false) }}
{%- assign fp = get_content_items(ContentType="products", Filter="featured eq 'true'", OrderBy="sort_order asc", PageSize=6) -%}
<section class="sec" aria-labelledby="ph"><div class="wrap">
  <div class="shead"><div><span class="kicker">Accounts and loans</span><h2 id="ph">Banking that stays in the valley</h2><p>Every loan we make is decided by people who live here, and deposits are lent back to neighbors.</p></div><a class="more" href="{{ PathBase }}/products">Everything we offer <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3">{% for p in fp.Items %}{% assign x = p.PublishedContent %}<a class="card prod" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span class="kicker" style="font-size:.72rem">{{ x.tagline }}</span><h3 style="margin-top:4px">{{ p.PrimaryField }}</h3><p>{{ x.summary }}</p><span class="rn">{{ x.rate_note }} <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>{% endfor %}</div>
</div></section>
{{ render_section("main", wrap=false) }}
{%- assign aq = get_content_items(ContentType="articles", OrderBy="posted_on desc", PageSize=2) -%}
{%- assign sq = get_content_items(ContentType="alerts", OrderBy="posted_on desc", PageSize=3) -%}
<section class="sec alt" aria-labelledby="lh"><div class="wrap split">
  <div><div class="shead"><div><span class="kicker">Learning center</span><h2 id="lh">Money questions, plainly answered</h2></div><a class="more" href="{{ PathBase }}/learn">All articles <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="grid g2">{% for a in aq.Items %}{% assign x = a.PublishedContent %}{% capture tk %}{{ x.topic }}{% endcapture %}{% for pair in tps %}{% assign kv = pair | split: ":" %}{% if kv[0] == tk %}{% assign tl = kv[1] %}{% assign ti = kv[2] %}{% endif %}{% endfor %}<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill blue"><i class="bi bi-{{ ti }}" aria-hidden="true"></i> {{ tl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.minutes }} minute read</p></div></a>{% endfor %}</div></div>
  <div><div class="shead"><div><span class="kicker">Security center</span><h2>Scams and service notices</h2></div><a class="more" href="{{ PathBase }}/security">Security center <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="card">{% for a in sq.Items %}{% assign x = a.PublishedContent %}{% capture lv %}{{ x.level }}{% endcapture %}{% capture on %}{{ x.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% assign lc = kv[3] %}{% endif %}{% endfor %}<a class="ntc" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="ic" aria-hidden="true" style="{% if lv == 'scam' %}background:#fde8e6;color:var(--red){% elsif lv == 'info' %}background:var(--blue2);color:var(--blue){% endif %}"><i class="bi bi-{{ li }}"></i></span><span><small>{{ ll }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if on == "true" %} &middot; <b style="display:inline;color:var(--green);font-size:.82rem">Active</b>{% endif %}</small><b>{{ a.PrimaryField }}</b></span></a>{% endfor %}</div>
    <div class="card pad" style="margin-top:16px;display:flex;gap:14px;align-items:center"><i class="bi bi-shield-check" style="font-size:1.8rem;color:var(--blue)" aria-hidden="true"></i><p style="margin:0;font-size:.95rem"><b style="color:var(--ink)">We will never ask for your password, PIN or a one-time code.</b> If someone does, hang up and call (555) 014-2000.</p></div></div>
</div></section>
<section class="sec" aria-labelledby="mh2"><div class="wrap split">
  <div><div class="shead"><div><span class="kicker">Branches and ATMs</span><h2 id="mh2">Four branches and 30,000 ATMs</h2><p>Use our ATMs, and 30,000 more in the network, without a surcharge.</p></div></div>{%- assign bq = get_content_items(ContentType="branches", OrderBy="sort_order asc", PageSize=40) -%}<div class="vmap"><svg viewBox="0 0 1000 560" role="img" aria-label="Map of the Kestrel Valley showing our branches and ATMs"><rect width="1000" height="560" fill="#e9f0e6"/><path d="M0 0H1000V120C860 90 760 150 640 120S420 40 300 80 80 60 0 90Z" fill="#d7e4d2"/><path d="M0 470C140 440 260 500 400 480S700 420 820 460 960 520 1000 500V560H0Z" fill="#d7e4d2"/><path d="M-10 300 C 120 280 220 340 330 320 S 520 230 620 260 S 780 360 860 330 S 960 300 1010 310" stroke="#9cc9de" stroke-width="16" fill="none" stroke-linecap="round"/><ellipse cx="800" cy="340" rx="80" ry="44" fill="#9cc9de"/><path d="M40 520 L 380 240 L 700 170 L 960 90" stroke="#fff" stroke-width="10" fill="none"/><path d="M40 520 L 380 240 L 700 170 L 960 90" stroke="#e7c9a2" stroke-width="3" fill="none" stroke-dasharray="14 10"/><path d="M200 60 L 260 380 L 500 450 L 900 380" stroke="#fff" stroke-width="7" fill="none"/><text x="300" y="290" font-family="Figtree,Arial,sans-serif" font-size="18" font-weight="700" fill="#5b6f6a" letter-spacing="2">HARLOW</text><text x="560" y="222" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">MILLBROOK SPRINGS</text><text x="120" y="410" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">COPPER FLATS</text><text x="735" y="410" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">WREN LAKE</text><text x="450" y="470" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">ASHBY</text><text x="890" y="530" font-family="Figtree,Arial,sans-serif" font-size="12" fill="#7a8c87">Fictional map</text></svg>{% for b in bq.Items %}{% capture bk %}{{ b.PublishedContent.kind }}{% endcapture %}<a class="pin {{ bk }}" style="left:{{ b.PublishedContent.map_x }}%;top:{{ b.PublishedContent.map_y }}%" href="{{ PathBase }}/{{ b.RoutePath }}"><span>{{ b.PrimaryField }}</span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></a>{% endfor %}</div></div>
  <div><div class="shead"><div><h2 style="font-size:1.3rem">Branches</h2></div><a class="more" href="{{ PathBase }}/locations">All locations <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="card">{% for b in bq.Items %}{% capture bk %}{{ b.PublishedContent.kind }}{% endcapture %}{% if bk == "branch" %}{% assign x = b.PublishedContent %}{% capture bk %}{{ x.kind }}{% endcapture %}{% for pair in bks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<a class="loc" href="{{ PathBase }}/{{ b.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ bi }}"></i></span><span><b>{{ b.PrimaryField }}</b><small>{{ x.address }}, {{ x.town }} &middot; {{ bl }}</small><small class="hours" style="margin-top:2px">{{ x.lobby_hours }}</small></span></a>{% endif %}{% endfor %}</div></div>
</div></section>
{%- assign nq = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=3) -%}
<section class="sec alt" aria-labelledby="nh"><div class="wrap">
  <div class="shead"><div><span class="kicker">News</span><h2 id="nh">From the credit union</h2></div><a class="more" href="{{ PathBase }}/news">All news <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3">{% for a in nq.Items %}{% assign x = a.PublishedContent %}{% capture ck %}{{ x.category }}{% endcapture %}{% for pair in ncs %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.posted_on.Value | date: "%B %-d, %Y" }}</p></div></a>{% endfor %}</div>
</div></section>
<section class="sec"><div class="wrap"><div class="cta subband" style="padding:34px"><div><span class="kicker" style="color:var(--gold)">Member owned since 1958</span><h2 style="margin-top:8px">The 2027 annual meeting is March 18</h2><p style="margin:10px 0 0">Every member gets one vote, whatever their balance. Three board seats are open, and nominations close December 1.</p></div>
<div style="display:flex;gap:12px;flex-wrap:wrap;position:relative;z-index:1;justify-content:flex-end"><a class="btn btn-g" href="{{ PathBase }}/members"><i class="bi bi-person-badge" aria-hidden="true"></i> Member area</a><a class="btn btn-w" href="{{ PathBase }}/board">Meet the board</a></div></div></div></section>
