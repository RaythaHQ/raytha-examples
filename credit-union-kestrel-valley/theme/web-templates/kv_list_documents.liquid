{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/about">About us</a></li><li aria-current="page">Documents</li></ol></nav><h1>Reports and documents</h1><p>Annual reports, disclosures and the fee schedule are public. Annual meeting materials and minutes are in the member area.</p></div></div>
<div class="body"><div class="wrap split">
<div class="card">{% for d in Target.Items %}{% assign x = d.PublishedContent %}{% capture dk %}{{ x.kind }}{% endcapture %}{% capture mo %}{{ x.members_only | downcase }}{% endcapture %}{% for pair in dks %}{% assign kv = pair | split: ":" %}{% if kv[0] == dk %}{% assign dl = kv[1] %}{% assign di = kv[2] %}{% endif %}{% endfor %}<a class="doc" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-file-earmark-pdf"></i></span><span><b>{{ d.PrimaryField }}</b><small>{{ dl }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if mo == "true" %} &middot; <span class="pill gold" style="font-size:.7rem"><i class="bi bi-lock" aria-hidden="true"></i> Members</span>{% endif %}</small></span>{% if mo == "true" and is_mem == false %}<i class="bi bi-lock lk" aria-hidden="true"></i>{% else %}<i class="bi bi-chevron-right lk" aria-hidden="true"></i>{% endif %}</a>{% endfor %}</div>
<aside class="grid" style="gap:20px">{% if is_mem %}<div class="member"><i class="bi bi-person-check" style="font-size:1.4rem;color:#8a4a1c" aria-hidden="true"></i><p style="margin:0;font-size:.95rem">You are signed in, so members-only documents are open to you.</p></div>{% else %}<div class="cta"><h2 style="font-size:1.2rem">Members-only documents</h2><p style="margin:8px 0 16px;font-size:.95rem">Annual meeting materials, minutes and the board nomination packet are for members. Sign in to the member area of this website to read them.</p><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/documents">Sign in</a></div>{% endif %}
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Need a paper copy?</h2><p style="font-size:.94rem;margin:0">Any branch can print a document for you, free.</p></div></aside>
</div></div>
