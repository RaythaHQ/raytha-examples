{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Member area</li></ol></nav><span class="pill gold" style="margin-bottom:10px"><i class="bi bi-person-badge" aria-hidden="true"></i> Members only</span><h1>Member area</h1><p>Annual meeting materials, minutes, board elections and member documents.</p></div></div>
<div class="body"><div class="wrap">
{% if is_mem %}
<div class="member" style="margin-bottom:24px"><i class="bi bi-person-check" style="font-size:1.6rem;color:#8a4a1c" aria-hidden="true"></i><p style="margin:0">Welcome back{% if CurrentUser.FirstName %}, {{ CurrentUser.FirstName }}{% endif %}. You are signed in to the member area of this website. <a href="{{ PathBase }}/account/logout">Sign out</a></p></div>
{{ render_section("main", wrap=false) }}
{%- assign mq = get_content_items(ContentType="documents", Filter="members_only eq 'true'", OrderBy="posted_on desc", PageSize=20) -%}
<div class="split" style="margin-top:24px"><div><h2 style="font-size:1.4rem;margin-bottom:14px">Members-only documents</h2><div class="card">{% for d in mq.Items %}{% assign x = d.PublishedContent %}{% capture dk %}{{ x.kind }}{% endcapture %}{% capture mo %}{{ x.members_only | downcase }}{% endcapture %}{% for pair in dks %}{% assign kv = pair | split: ":" %}{% if kv[0] == dk %}{% assign dl = kv[1] %}{% assign di = kv[2] %}{% endif %}{% endfor %}<a class="doc" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-file-earmark-pdf"></i></span><span><b>{{ d.PrimaryField }}</b><small>{{ dl }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if mo == "true" %} &middot; <span class="pill gold" style="font-size:.7rem"><i class="bi bi-lock" aria-hidden="true"></i> Members</span>{% endif %}</small></span>{% if mo == "true" and is_mem == false %}<i class="bi bi-lock lk" aria-hidden="true"></i>{% else %}<i class="bi bi-chevron-right lk" aria-hidden="true"></i>{% endif %}</a>{% endfor %}</div></div>
<aside class="grid" style="gap:20px"><div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:8px">Ask the board a question</h2><p style="font-size:.95rem;margin:0">Send questions for the annual meeting to the board secretary at <a href="mailto:board@kestrelvalley.example">board@kestrelvalley.example</a> by March 11, 2027. We answer as many as we can during the meeting.</p></div>
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:8px">Public documents</h2><p style="font-size:.95rem;margin:0 0 10px">The annual report, fee schedule and privacy notice are open to everyone.</p><a class="more" href="{{ PathBase }}/documents">All documents <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></aside></div>
{% else %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>The member area is for members.</h2><p style="max-width:600px">Sign in to the member area of this website to see annual meeting materials, minutes and other member documents. This is a website account, not online banking.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the member area</a><a class="btn btn-w" href="{{ PathBase }}/about#join">Become a member</a></div></div>
<div class="grid g3" style="margin-top:24px"><div class="card pad"><h2 style="font-size:1.15rem">Annual meeting</h2><p class="muted" style="margin:6px 0 0">Thursday, March 18, 2027, 6 pm, Harlow Civic Center and online.</p></div><div class="card pad"><h2 style="font-size:1.15rem">Board elections</h2><p class="muted" style="margin:6px 0 0">Three seats open. Nominations close December 1, 2026.</p></div><div class="card pad"><h2 style="font-size:1.15rem">Public reports</h2><p class="muted" style="margin:6px 0 0">The annual report and disclosures are on the <a href="{{ PathBase }}/documents">documents page</a>.</p></div></div>
{% endif %}
</div></div>
