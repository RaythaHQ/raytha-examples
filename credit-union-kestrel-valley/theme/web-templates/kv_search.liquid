{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}
{%- assign q = QueryParams.q | strip | remove: "'" | remove: '"' | remove: "<" | remove: ">" | truncate: 60, "" -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Search</li></ol></nav><h1>{% if q != "" %}Search results for “{{ q }}”{% else %}Search{% endif %}</h1><p>Accounts, loans, branches, articles, news and security alerts.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/search" role="search"><div class="grow"><label for="sq">Search for</label><input id="sq" name="q" value="{{ q }}" placeholder="Try “certificate”, “scam” or “mortgage”"></div><button class="btn btn-p" type="submit">Search</button></form>
{%- if q != "" -%}
{%- capture f1 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f2 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f3 %}contains(name,'{{ q }}') or contains(town,'{{ q }}') or contains(services,'{{ q }}'){% endcapture -%}
{%- capture f4 %}contains(title,'{{ q }}') or contains(message,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- assign rp = get_content_items(ContentType="products", Filter=f1, OrderBy="sort_order asc", PageSize=12) -%}{%- assign ra = get_content_items(ContentType="articles", Filter=f2, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign rn = get_content_items(ContentType="news", Filter=f2, OrderBy="posted_on desc", PageSize=12) -%}{%- assign rb = get_content_items(ContentType="branches", Filter=f3, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rs = get_content_items(ContentType="alerts", Filter=f4, OrderBy="posted_on desc", PageSize=12) -%}{%- assign rd = get_content_items(ContentType="documents", Filter=f2, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign total = rp.TotalCount | plus: ra.TotalCount | plus: rn.TotalCount | plus: rb.TotalCount | plus: rs.TotalCount | plus: rd.TotalCount -%}
<p class="muted" role="status" style="margin:-6px 0 20px">{{ total }} result{% if total != 1 %}s{% endif %}</p>
<div class="grid g2">
{% if rp.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Accounts and loans</h2></div>{% for p in rp.Items %}<a class="svc" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ p.PublishedContent.icon }}"></i></span><span><b>{{ p.PrimaryField }}</b><small>{{ p.PublishedContent.summary }}</small></span></a>{% endfor %}</div>{% endif %}
{% if ra.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Learning center</h2></div><div class="pad" style="padding-top:8px">{% for a in ra.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.minutes }} minute read</small></span></a>{% endfor %}</div></div>{% endif %}
{% if rs.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Security center</h2></div>{% for a in rs.Items %}{% assign x = a.PublishedContent %}{% capture lv %}{{ x.level }}{% endcapture %}{% capture on %}{{ x.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% assign lc = kv[3] %}{% endif %}{% endfor %}<a class="ntc" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="ic" aria-hidden="true" style="{% if lv == 'scam' %}background:#fde8e6;color:var(--red){% elsif lv == 'info' %}background:var(--blue2);color:var(--blue){% endif %}"><i class="bi bi-{{ li }}"></i></span><span><small>{{ ll }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if on == "true" %} &middot; <b style="display:inline;color:var(--green);font-size:.82rem">Active</b>{% endif %}</small><b>{{ a.PrimaryField }}</b></span></a>{% endfor %}</div>{% endif %}
{% if rb.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Branches and ATMs</h2></div>{% for b in rb.Items %}{% assign x = b.PublishedContent %}{% capture bk %}{{ x.kind }}{% endcapture %}{% for pair in bks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<a class="loc" href="{{ PathBase }}/{{ b.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ bi }}"></i></span><span><b>{{ b.PrimaryField }}</b><small>{{ x.address }}, {{ x.town }} &middot; {{ bl }}</small><small class="hours" style="margin-top:2px">{{ x.lobby_hours }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rn.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">News</h2></div><div class="pad" style="padding-top:8px">{% for a in rn.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div></div>{% endif %}
{% if rd.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Documents</h2></div>{% for d in rd.Items %}{% assign x = d.PublishedContent %}{% capture dk %}{{ x.kind }}{% endcapture %}{% capture mo %}{{ x.members_only | downcase }}{% endcapture %}{% for pair in dks %}{% assign kv = pair | split: ":" %}{% if kv[0] == dk %}{% assign dl = kv[1] %}{% assign di = kv[2] %}{% endif %}{% endfor %}<a class="doc" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-file-earmark-pdf"></i></span><span><b>{{ d.PrimaryField }}</b><small>{{ dl }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if mo == "true" %} &middot; <span class="pill gold" style="font-size:.7rem"><i class="bi bi-lock" aria-hidden="true"></i> Members</span>{% endif %}</small></span>{% if mo == "true" and is_mem == false %}<i class="bi bi-lock lk" aria-hidden="true"></i>{% else %}<i class="bi bi-chevron-right lk" aria-hidden="true"></i>{% endif %}</a>{% endfor %}</div>{% endif %}
</div>
{% if total == 0 %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nothing matched “{{ q }}”</h2><p class="muted">Try a shorter word, or call member service at (555) 014-2000.</p></div>{% endif %}
{%- else -%}
<h2 style="font-size:1.2rem;margin-bottom:12px">Popular searches</h2><div class="chips">{% assign sug = "certificate,auto loan,mortgage,scam,ATM,annual meeting" | split: "," %}{% for s in sug %}<a href="{{ PathBase }}/search?q={{ s | url_encode }}">{{ s }}</a>{% endfor %}</div>
{%- endif -%}
</div></div>
