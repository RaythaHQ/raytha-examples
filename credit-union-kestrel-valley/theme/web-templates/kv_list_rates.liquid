{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Rates</li></ol></nav><h1>Rates</h1><p>Dividend rates on savings and certificates, and loan rates, in one place. Updated whenever the board’s asset-liability committee changes them.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Jump to a rate table">{% for pair in rts %}{% assign kv = pair | split: ":" %}<a href="#{{ kv[0] }}">{{ kv[1] }}</a>{% endfor %}<a href="{{ PathBase }}/feeds/rates.json"><i class="bi bi-braces" aria-hidden="true"></i> JSON feed</a></nav>
<div class="art"><div class="grid" style="gap:22px">
{%- for pair in rts %}{% assign kv = pair | split: ":" %}
<div class="card" id="{{ kv[0] }}" style="overflow-x:auto;scroll-margin-top:110px"><table class="rt"><caption>{{ kv[1] }}</caption><thead><tr><th scope="col">Account or loan</th><th scope="col">Term</th><th scope="col">Minimum</th><th scope="col">{{ kv[2] }}*</th></tr></thead><tbody>
{% for r in Target.Items %}{% capture rt %}{{ r.PublishedContent.table }}{% endcapture %}{% if rt == kv[0] %}{% assign x = r.PublishedContent %}{% capture rk %}{{ x.rate_type }}{% endcapture %}{% capture lo %}{{ x.as_low_as | downcase }}{% endcapture %}{% capture ft %}{{ x.featured | downcase }}{% endcapture %}<tr{% if ft == "true" %} class="hl"{% endif %}><th scope="row" style="font-weight:600;color:var(--ink)"><a href="{{ PathBase }}/{{ x.product.RoutePath }}" style="color:var(--ink)">{{ r.PrimaryField }}</a>{% capture c_x_note %}{{ x.note | strip }}{% endcapture %}{% if c_x_note != "" %}<small>{{ x.note }}</small>{% endif %}</th><td>{% capture c_x_term %}{{ x.term | strip }}{% endcapture %}{% if c_x_term != "" %}{{ x.term }}{% else %}&ndash;{% endif %}</td><td>{% capture c_x_minimum %}{{ x.minimum | strip }}{% endcapture %}{% if c_x_minimum != "" %}{{ x.minimum }}{% else %}&ndash;{% endif %}</td><td class="num">{% if lo == "true" %}<small style="font-family:Figtree;font-size:.7rem;font-weight:700">AS LOW AS</small>{% endif %}{{ x.rate }}%</td></tr>{% endif %}{% endfor %}
</tbody></table></div>{% endfor %}
</div>
<aside class="grid" style="gap:20px;position:sticky;top:100px"><div class="cta"><h2 style="font-size:1.25rem">Estimate a payment</h2><p style="margin:8px 0 16px;font-size:.95rem">See what a loan would cost each month at these rates.</p><a class="btn btn-g" href="{{ PathBase }}/loan-calculator">Loan calculator</a></div>
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:8px">About these rates</h2><p style="font-size:.92rem;margin:0">Rates effective {{ Target.Items[0].PublishedContent.effective.Value | date: "%B %-d, %Y" }}. APY is the annual percentage yield; APR is the annual percentage rate. Loan rates marked “as low as” depend on credit, term and collateral.</p></div>
<p class="disc" style="margin:0">*Every rate on this page is fictional, made up for a Raytha example site. Kestrel Valley Credit Union does not exist and does not take deposits or make loans.</p></aside></div>
</div></div>
