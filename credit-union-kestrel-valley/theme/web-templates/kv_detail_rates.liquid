{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture rk %}{{ p.rate_type }}{% endcapture %}{% capture lo %}{{ p.as_low_as | downcase }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/rates">Rates</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><h1>{{ Target.PrimaryField }}</h1><p>{{ p.note }}</p></div></div>
<div class="body"><div class="wrap" style="max-width:900px"><div class="card pad" style="padding:34px;display:flex;gap:30px;align-items:center;flex-wrap:wrap"><div><span class="kicker">{% if lo == "true" %}As low as{% else %}Current rate{% endif %}</span><div style="font-family:'Source Serif 4',serif;font-size:4rem;color:var(--navy);line-height:1;font-weight:650">{{ p.rate }}%</div><b>{{ rk | upcase }}*</b></div>
<dl class="facts" style="flex:1;min-width:240px"><div><dt>Product</dt><dd><a href="{{ PathBase }}/{{ p.product.RoutePath }}">{{ p.product.PrimaryField }}</a></dd></div>{% capture c_p_term %}{{ p.term | strip }}{% endcapture %}{% if c_p_term != "" %}<div><dt>Term</dt><dd>{{ p.term }}</dd></div>{% endif %}{% capture c_p_minimum %}{{ p.minimum | strip }}{% endcapture %}{% if c_p_minimum != "" %}<div><dt>Minimum</dt><dd>{{ p.minimum }}</dd></div>{% endif %}<div><dt>Effective</dt><dd>{{ p.effective.Value | date: "%B %-d, %Y" }}</dd></div></dl></div>
<p class="disc" style="margin-top:18px">*Fictional rate for a Raytha example site.</p><p><a href="{{ PathBase }}/rates"><i class="bi bi-arrow-left" aria-hidden="true"></i> All rates</a></p></div></div>
