{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture lv %}{{ p.level }}{% endcapture %}{% capture on %}{{ p.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% assign lc = kv[3] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/security">Security center</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {% if lv == "scam" %}red{% elsif lv == "service" %}gold{% else %}blue{% endif %}" style="margin-bottom:10px"><i class="bi bi-{{ li }}" aria-hidden="true"></i> {{ ll }} &middot; {% if on == "true" %}Active{% else %}Ended{% endif %}</span><h1>{{ Target.PrimaryField }}</h1></div></div>
<div class="body"><div class="wrap art"><div class="grid" style="gap:20px"><div class="alert {{ lc }}" style="border-radius:14px"><div style="display:flex;gap:14px;padding:22px;align-items:flex-start"><span class="ic" aria-hidden="true"><i class="bi bi-{{ li }}"></i></span><div><p style="font-size:1.08rem">{{ p.message }}</p><p class="muted" style="margin-top:8px;font-size:.9rem">Posted {{ p.posted_on.Value | date: "%A, %B %-d, %Y" }}</p></div></div></div>
<div class="card pad prose" style="padding:30px">{{ p.body }}</div></div>
<aside class="grid" style="gap:20px"><div class="cta"><h2 style="font-size:1.2rem">Think you were targeted?</h2><p style="margin:8px 0 16px;font-size:.95rem">Call us right away. The sooner we know, the more we can do.</p><a class="btn btn-g" href="tel:+15550142911">(555) 014-2911, 24 hours</a></div><p><a href="{{ PathBase }}/security"><i class="bi bi-arrow-left" aria-hidden="true"></i> Security center</a></p></aside></div></div>
