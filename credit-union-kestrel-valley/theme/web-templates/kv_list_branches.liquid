{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Branches and ATMs</li></ol></nav><h1>Branches and ATMs</h1><p>Four branches, three of our own ATMs and 30,000 surcharge-free network ATMs. Lobby and drive-thru hours for every location.</p></div></div>
<div class="body"><div class="wrap">{%- assign bq = get_content_items(ContentType="branches", OrderBy="sort_order asc", PageSize=40) -%}<div class="vmap"><svg viewBox="0 0 1000 560" role="img" aria-label="Map of the Kestrel Valley showing our branches and ATMs"><rect width="1000" height="560" fill="#e9f0e6"/><path d="M0 0H1000V120C860 90 760 150 640 120S420 40 300 80 80 60 0 90Z" fill="#d7e4d2"/><path d="M0 470C140 440 260 500 400 480S700 420 820 460 960 520 1000 500V560H0Z" fill="#d7e4d2"/><path d="M-10 300 C 120 280 220 340 330 320 S 520 230 620 260 S 780 360 860 330 S 960 300 1010 310" stroke="#9cc9de" stroke-width="16" fill="none" stroke-linecap="round"/><ellipse cx="800" cy="340" rx="80" ry="44" fill="#9cc9de"/><path d="M40 520 L 380 240 L 700 170 L 960 90" stroke="#fff" stroke-width="10" fill="none"/><path d="M40 520 L 380 240 L 700 170 L 960 90" stroke="#e7c9a2" stroke-width="3" fill="none" stroke-dasharray="14 10"/><path d="M200 60 L 260 380 L 500 450 L 900 380" stroke="#fff" stroke-width="7" fill="none"/><text x="300" y="290" font-family="Figtree,Arial,sans-serif" font-size="18" font-weight="700" fill="#5b6f6a" letter-spacing="2">HARLOW</text><text x="560" y="222" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">MILLBROOK SPRINGS</text><text x="120" y="410" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">COPPER FLATS</text><text x="735" y="410" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">WREN LAKE</text><text x="450" y="470" font-family="Figtree,Arial,sans-serif" font-size="16" font-weight="700" fill="#5b6f6a" letter-spacing="2">ASHBY</text><text x="890" y="530" font-family="Figtree,Arial,sans-serif" font-size="12" fill="#7a8c87">Fictional map</text></svg>{% for b in bq.Items %}{% capture bk %}{{ b.PublishedContent.kind }}{% endcapture %}<a class="pin {{ bk }}" style="left:{{ b.PublishedContent.map_x }}%;top:{{ b.PublishedContent.map_y }}%" href="{{ PathBase }}/{{ b.RoutePath }}"><span>{{ b.PrimaryField }}</span><i class="bi bi-geo-alt-fill" aria-hidden="true"></i></a>{% endfor %}</div>
<div class="grid g3" style="margin-top:26px">{% for b in Target.Items %}{% assign x = b.PublishedContent %}{% capture bk %}{{ x.kind }}{% endcapture %}{% for pair in bks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<a class="card bcard" href="{{ PathBase }}/{{ b.RoutePath }}">{% if bk == "branch" %}<div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div>{% endif %}<div class="bd"><span class="pill {% if bk == 'branch' %}navy{% else %}gold{% endif %}"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h3 style="margin:8px 0 4px;font-size:1.15rem">{{ b.PrimaryField }}</h3><p class="muted" style="margin:0 0 8px;font-size:.92rem">{{ x.address }}, {{ x.town }}</p><p class="hours" style="margin:0;font-size:.9rem"><b style="color:var(--ink)">Lobby:</b> {{ x.lobby_hours }}</p></div></a>{% endfor %}</div>
<div class="card pad" style="margin-top:26px;display:flex;gap:18px;align-items:center;flex-wrap:wrap"><i class="bi bi-share" style="font-size:1.8rem;color:var(--blue)" aria-hidden="true"></i><div style="flex:1;min-width:240px"><h3>Traveling?</h3><p class="muted" style="margin:4px 0 0">Use 30,000 surcharge-free ATMs in the network, and add a travel notice in the mobile app so your card keeps working.</p></div><a class="btn btn-o" href="{{ PathBase }}/contact">Call member service</a></div>
</div></div>
