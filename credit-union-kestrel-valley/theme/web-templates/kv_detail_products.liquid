{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture pc %}{{ p.category }}{% endcapture %}{% for pair in pcs %}{% assign kv = pair | split: ":" %}{% if kv[0] == pc %}{% assign pl = kv[1] %}{% assign pi = kv[2] %}{% endif %}{% endfor %}
{%- capture f %}product eq '{{ Target.Id }}'{% endcapture %}{%- assign rq = get_content_items(ContentType="rates", Filter=f, OrderBy="sort_order asc", PageSize=10) -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/products">Accounts and loans</a></li><li><a href="{{ PathBase }}/products?category={{ pc }}">{{ pl }}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill gold" style="margin-bottom:10px"><i class="bi bi-{{ pi }}" aria-hidden="true"></i> {{ pl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px">
    <article class="card pad prose" style="padding:32px">{{ p.body }}</article>
    {% if rq.TotalCount > 0 %}<div class="card" style="overflow-x:auto"><table class="rt"><caption>Current rates</caption><thead><tr><th scope="col">Option</th><th scope="col">Term</th><th scope="col">Rate*</th></tr></thead><tbody>{% for r in rq.Items %}{% assign x = r.PublishedContent %}{% capture rk %}{{ x.rate_type }}{% endcapture %}{% capture lo %}{{ x.as_low_as | downcase }}{% endcapture %}<tr><th scope="row" style="font-weight:600;color:var(--ink)">{{ r.PrimaryField }}{% capture c_x_note %}{{ x.note | strip }}{% endcapture %}{% if c_x_note != "" %}<small>{{ x.note }}</small>{% endif %}</th><td>{% capture c_x_term %}{{ x.term | strip }}{% endcapture %}{% if c_x_term != "" %}{{ x.term }}{% else %}&ndash;{% endif %}</td><td class="num">{% if lo == "true" %}<small style="font-family:Figtree;font-size:.7rem;font-weight:700">AS LOW AS</small>{% endif %}{{ x.rate }}% <small style="display:inline;font-family:Figtree">{{ rk | upcase }}</small></td></tr>{% endfor %}</tbody></table></div>{% endif %}
    <p class="disc">*Fictional rates and terms for a Raytha example site. Not an offer of credit or a real account.</p>
  </div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:10px">At a glance</h2><ul class="ticks" style="font-size:.95rem">{% assign hs = p.highlights | newline_to_br | split: "<br />" %}{% for h in hs %}{% assign t = h | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></div>
    <div class="cta"><h2 style="font-size:1.2rem">Talk to us</h2><p style="margin:8px 0 16px;font-size:.95rem">Stop by any branch, or call member service. We will explain the options and the fine print, with no pressure.</p><div style="display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/locations">Find a branch</a><a class="btn btn-w" href="tel:+15550142000">(555) 014-2000</a></div></div>
  </aside>
</div></div>
