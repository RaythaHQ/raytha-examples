{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}
{%- assign qc = "" -%}{%- for pair in pcs %}{% assign kv = pair | split: ":" %}{% if QueryParams.category == kv[0] %}{% assign qc = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Accounts and loans</li></ol></nav><h1>Accounts and loans</h1><p>Checking, savings, certificates, auto and home loans, cards and business banking. Plain terms, and every fee listed on one page.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter by category"><a href="{{ PathBase }}/products"{% if qc == "" %} aria-current="true"{% endif %}>Everything</a>{% for pair in pcs %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/products?category={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
{%- for pair in pcs %}{% assign kv = pair | split: ":" %}{% if qc == "" or qc == kv[0] %}{% assign n = 0 %}{% for p in Target.Items %}{% capture pc %}{{ p.PublishedContent.category }}{% endcapture %}{% if pc == kv[0] %}{% assign n = n | plus: 1 %}{% endif %}{% endfor %}
{% if n > 0 %}<section aria-labelledby="c-{{ kv[0] }}" style="margin-bottom:34px"><h2 id="c-{{ kv[0] }}" style="font-size:1.5rem;margin-bottom:14px"><i class="bi bi-{{ kv[2] }}" style="color:var(--gold);margin-right:8px" aria-hidden="true"></i>{{ kv[1] }}</h2><div class="grid g3">
{% for p in Target.Items %}{% capture pc %}{{ p.PublishedContent.category }}{% endcapture %}{% if pc == kv[0] %}{% assign x = p.PublishedContent %}<a class="card prod" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span class="kicker" style="font-size:.72rem">{{ x.tagline }}</span><h3 style="margin-top:4px">{{ p.PrimaryField }}</h3><p>{{ x.summary }}</p><span class="rn">{{ x.rate_note }} <i class="bi bi-arrow-right" aria-hidden="true"></i></span></a>{% endif %}{% endfor %}</div></section>{% endif %}
{%- endif %}{% endfor %}
<p class="disc">*Rates on this site are fictional. Kestrel Valley Credit Union is not a real institution and does not offer any of these products.</p>
</div></div>
