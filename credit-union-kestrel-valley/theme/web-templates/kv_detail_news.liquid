{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture ck %}{{ p.category }}{% endcapture %}{% for pair in ncs %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {{ cc }}" style="margin-bottom:10px">{{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;margin-bottom:22px">
    <div class="card pad prose" style="padding:32px"><p class="muted" style="font-size:.92rem">{{ p.posted_on.Value | date: "%A, %B %-d, %Y" }}</p>{{ p.body }}</div></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">Media contact</h2><p style="margin:0;font-size:.95rem">Marketing and communications<br><a href="mailto:news@kestrelvalley.example">news@kestrelvalley.example</a><br>(555) 014-2050</p></div>
    {%- assign more = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=5) -%}
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">More news</h2>{% for a in more.Items %}{% if a.Id != Target.Id %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span><b style="font-size:.95rem">{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d" }}</small></span></a>{% endif %}{% endfor %}</div>
  </aside>
</div></div>
