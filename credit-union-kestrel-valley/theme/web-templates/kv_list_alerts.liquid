{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Security center</li></ol></nav><h1>Security center</h1><p>Current scam warnings and service notices, and what we will and will not ever ask you for.</p></div></div>
<div class="body"><div class="wrap split">
<div><div class="card">{% for a in Target.Items %}{% assign x = a.PublishedContent %}{% capture lv %}{{ x.level }}{% endcapture %}{% capture on %}{{ x.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% assign lc = kv[3] %}{% endif %}{% endfor %}<a class="ntc" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="ic" aria-hidden="true" style="{% if lv == 'scam' %}background:#fde8e6;color:var(--red){% elsif lv == 'info' %}background:var(--blue2);color:var(--blue){% endif %}"><i class="bi bi-{{ li }}"></i></span><span><small>{{ ll }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }}{% if on == "true" %} &middot; <b style="display:inline;color:var(--green);font-size:.82rem">Active</b>{% endif %}</small><b>{{ a.PrimaryField }}</b></span></a>{% endfor %}</div>
<div class="grid g2" style="margin-top:22px"><div class="card pad"><h2 style="font-size:1.2rem;margin-bottom:10px"><i class="bi bi-x-octagon" style="color:var(--red)" aria-hidden="true"></i> We will never</h2><ul class="ticks" style="font-size:.95rem"><li>Ask for your password, PIN or a one-time code</li><li>Ask you to move money to “keep it safe”</li><li>Text you a link to unlock your account</li><li>Ask you to pay with gift cards or crypto</li></ul></div>
<div class="card pad"><h2 style="font-size:1.2rem;margin-bottom:10px"><i class="bi bi-check2-circle" style="color:var(--green)" aria-hidden="true"></i> You can always</h2><ul class="ticks" style="font-size:.95rem"><li>Hang up and call (555) 014-2000</li><li>Lock your card in the mobile app</li><li>Visit any branch and ask</li><li>Report fraud 24 hours a day at (555) 014-2911</li></ul></div></div></div>
<aside class="grid" style="gap:20px;position:sticky;top:100px"><div class="cta"><h2 style="font-size:1.2rem">Lost or stolen card?</h2><p style="margin:8px 0 16px;font-size:.95rem">Call any time, day or night. We will lock the card and send a new one.</p><a class="btn btn-g" href="tel:+15550142911"><i class="bi bi-telephone" aria-hidden="true"></i> (555) 014-2911</a></div>
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Follow security alerts</h2><p style="font-size:.94rem">New alerts as they are posted, in any feed reader.</p><a class="btn btn-o" href="{{ PathBase }}/feeds/security.rss"><i class="bi bi-rss" aria-hidden="true"></i> RSS feed</a></div>
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Learn more</h2>{% assign fq = get_content_items(ContentType="articles", Filter="topic eq 'fraud'", OrderBy="posted_on desc", PageSize=3) %}{% for a in fq.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}" style="padding:10px 0"><span><b style="font-size:.95rem">{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.minutes }} minute read</small></span></a>{% endfor %}</div></aside>
</div></div>
