<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Kestrel Valley Credit Union" %}{{ Target.Title }} | {% endif %}Kestrel Valley Credit Union</title>
  <meta name="description" content="Kestrel Valley Credit Union (a fictional, member-owned credit union): checking, savings, certificates, auto and home loans, rates, branches and ATMs, financial education and member resources.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,650;8..60,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="alternate" type="application/rss+xml" title="Kestrel Valley Credit Union: security alerts" href="{{ PathBase }}/feeds/security.rss">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Ccircle cx='24' cy='24' r='23' fill='%230c3b3a'/%3E%3Cpath d='M8 33c5-4 10-6 16-6s11 2 16 6v4H8z' fill='%232a8076'/%3E%3Cpath d='M11 21c4-3 8-4 12-2 2-3 5-5 9-5-2 2-3 3-3 5 3 0 6 1 8 3-4-1-7 0-9 1l-3 6-2-5c-4-1-8-1-12 1z' fill='%23f3e3cf'/%3E%3C/svg%3E">
  <style>:root{--navy:#0c3b3a;--navy2:#124e4b;--blue:#13706a;--blue2:#e3f2ef;--gold:#d08a3c;--gold2:#fbefe1;--green:#2f6f4f;--ink:#132423;--text:#273634;--muted:#586a67;--line:#dde5e2;--paper:#f6f4ef;--card:#fff;--red:#b42318;--r:14px;--sh:0 1px 2px rgba(12,59,58,.06),0 10px 28px -16px rgba(12,59,58,.22)}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Figtree",system-ui,sans-serif;font-size:17px;line-height:1.6;color:var(--text);background:var(--paper)}
a{color:var(--blue)}a:hover{color:var(--navy)}img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px;border-radius:4px}
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--gold);color:var(--ink);padding:10px 16px;border-radius:8px;font-weight:700}.skip:focus{left:12px}
h1,h2,h3,h4{color:var(--ink);line-height:1.18;margin:0;letter-spacing:-.01em}
h1{font-family:"Source Serif 4",Georgia,serif;font-weight:650;font-size:clamp(2rem,3.6vw,3rem)}h2{font-family:"Source Serif 4",Georgia,serif;font-weight:650;font-size:clamp(1.5rem,2.4vw,2rem)}h3{font-size:1.08rem;font-weight:700}
p{margin:0 0 .9em}.muted{color:var(--muted)}.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.kicker{display:inline-block;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
/* gov bar + header */
.govbar{background:var(--navy);color:#cfe3de;font-size:.82rem}.govbar .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:7px;padding-bottom:7px;flex-wrap:wrap}.govbar a{color:#fff;text-decoration:none;margin-left:18px}.govbar a:hover{text-decoration:underline}
.hdr{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}.hdr .wrap{display:flex;align-items:center;gap:24px;height:82px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);flex:none}.brand b{display:block;font-family:"Source Serif 4",serif;font-size:1.32rem;line-height:1.05;font-weight:700}.brand small{display:block;font-size:.76rem;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;font-weight:600}
.nav{display:flex;gap:2px;list-style:none;margin:0 0 0 8px;padding:0}.nav a{display:block;padding:10px 13px;border-radius:9px;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem}.nav a:hover{background:var(--blue2)}.nav a[aria-current=page]{color:var(--blue);box-shadow:inset 0 -3px 0 var(--gold)}
.hacts{margin-left:auto;display:flex;gap:10px;align-items:center}
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 .95rem "Figtree";border-radius:10px;padding:11px 18px;text-decoration:none;border:2px solid transparent;cursor:pointer;line-height:1.2;transition:background .15s,transform .15s}
.btn:hover{transform:translateY(-1px)}.btn-p{background:var(--blue);color:#fff}.btn-p:hover{background:var(--navy);color:#fff}.btn-g{background:var(--gold);color:var(--ink)}.btn-g:hover{background:#b8732a;color:var(--ink)}.btn-o{border-color:var(--line);background:#fff;color:var(--ink)}.btn-o:hover{border-color:var(--blue);color:var(--blue)}.btn-w{background:#fff;color:var(--navy)}
.ext::after{content:"\F1C5";font-family:bootstrap-icons;font-size:.8em;margin-left:2px}
.tog{display:none;background:none;border:2px solid var(--line);border-radius:10px;padding:6px 10px;font-size:1.3rem;color:var(--ink)}
/* alerts */
.alert{border-bottom:1px solid rgba(0,0,0,.08)}.alert .wrap{display:flex;gap:14px;align-items:center;padding-top:12px;padding-bottom:12px}.alert .ic{width:36px;height:36px;flex:none;border-radius:50%;display:grid;place-items:center;font-size:1.1rem}
.alert.advisory{background:var(--gold2)}.alert.advisory .ic{background:var(--gold);color:var(--ink)}.alert.emergency{background:#fde8e6}.alert.emergency .ic{background:var(--red);color:#fff}.alert.info{background:var(--blue2)}.alert.info .ic{background:var(--blue);color:#fff}
.alert b{color:var(--ink)}.alert p{margin:0;font-size:.94rem}.alert a.more{margin-left:auto;font-weight:700;white-space:nowrap}
/* hero */
.hero{position:relative;background:linear-gradient(170deg,#0c3b3a 0%,#13615c 58%,#2a8076 100%);color:#fff;overflow:hidden;padding:56px 0 210px}
.hero h1{color:#fff;font-size:clamp(2.3rem,4.6vw,3.7rem);max-width:760px}.hero p.lead{font-size:1.18rem;color:#d6ebe6;max-width:640px;margin:14px 0 26px}.hero .kicker{color:var(--gold)}
.hsearch{display:flex;max-width:680px;background:#fff;border-radius:14px;padding:6px;box-shadow:0 24px 50px -20px rgba(0,0,0,.5)}.hsearch label{position:absolute;left:-9999px}.hsearch input{flex:1;border:0;outline:0;font:inherit;font-size:1.05rem;padding:12px 16px;min-width:0;color:var(--ink);border-radius:10px}.hsearch input:focus-visible{outline:3px solid var(--gold)}
.pop{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:.9rem;align-items:center}.pop span{color:#b5d3cc}.pop a{color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);padding:5px 12px;border-radius:30px;text-decoration:none}.pop a:hover{background:rgba(255,255,255,.22)}
.sky{position:absolute;left:0;right:0;bottom:0;width:100%;height:300px;pointer-events:none}
.tasks{margin-top:-64px;position:relative;z-index:2}
.tgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.task{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:18px;text-decoration:none;color:var(--text);box-shadow:var(--sh);transition:transform .15s,border-color .15s}.task:hover{transform:translateY(-2px);border-color:var(--blue);color:var(--text)}
.task .ic{width:46px;height:46px;flex:none;border-radius:12px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;font-size:1.3rem}.task b{display:block;color:var(--ink);font-size:1rem;line-height:1.3}.task span{display:block;font-size:.86rem;color:var(--muted);margin-top:3px;line-height:1.4}.task span span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* sections */
.sec{padding:56px 0}.sec.alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.shead{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:22px;flex-wrap:wrap}.shead p{margin:6px 0 0;color:var(--muted)}
.more{font-weight:700;text-decoration:none;white-space:nowrap}.more:hover{text-decoration:underline}
.grid{display:grid;gap:20px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.split{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:28px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}.pad{padding:22px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:.76rem;font-weight:700;padding:3px 10px;border-radius:30px;background:#eef2f6;color:#334155;white-space:nowrap}.pill.blue{background:var(--blue2);color:#0f5a54}.pill.gold{background:var(--gold2);color:#7a4511}.pill.green{background:#e3f1e9;color:#1f5138}.pill.red{background:#fde8e6;color:#8f1d14}.pill.navy{background:var(--navy);color:#fff}
/* meetings */
.mtg{display:flex;gap:18px;padding:18px 20px;border-top:1px solid var(--line);align-items:flex-start}.mtg:first-child{border-top:0}
.date{width:66px;flex:none;text-align:center;border:2px solid var(--navy);border-radius:12px;overflow:hidden;background:#fff}.date span{display:block;background:var(--navy);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 0}.date b{display:block;font-family:"Source Serif 4",serif;font-size:1.65rem;color:var(--ink);line-height:1.2;padding:4px 0 2px}.date small{display:block;font-size:.68rem;color:var(--muted);padding-bottom:4px}
.mtg h3 a{color:var(--ink);text-decoration:none}.mtg h3 a:hover{color:var(--blue);text-decoration:underline}.mtg p{margin:4px 0 8px;font-size:.92rem;color:var(--muted)}.docs{display:flex;gap:8px;flex-wrap:wrap}.docs a,.docs span{font-size:.84rem;font-weight:700;padding:6px 11px;border-radius:8px;border:1px solid var(--line);text-decoration:none;display:inline-flex;gap:6px;align-items:center;background:#fff}.docs a:hover{border-color:var(--blue)}.docs span{color:var(--muted);font-weight:600;background:#f6f7f9}
/* notices */
.ntc{display:flex;gap:14px;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.ntc:first-child{border-top:0}.ntc:hover{background:#fafbfc}.ntc .ic{width:40px;height:40px;flex:none;border-radius:10px;display:grid;place-items:center;font-size:1.1rem;background:var(--gold2);color:#8a5a00}.ntc b{display:block;color:var(--ink);line-height:1.35;font-size:.98rem}.ntc small{color:var(--muted);font-size:.82rem}
/* news */
.feat{display:grid;grid-template-columns:1.1fr 1fr;overflow:hidden;text-decoration:none;color:var(--text)}.feat .img{min-height:300px;background-size:cover;background-position:center}.feat .bd{padding:28px}.feat h3{font-family:"Source Serif 4",serif;font-size:1.6rem;font-weight:650;margin:10px 0}.feat:hover h3{color:var(--blue)}
.nli{display:flex;gap:14px;padding:14px 0;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.nli:first-child{border-top:0;padding-top:0}.nli .th{width:96px;height:66px;flex:none;border-radius:10px;background-size:cover;background-position:center}.nli b{display:block;color:var(--ink);line-height:1.35}.nli:hover b{color:var(--blue);text-decoration:underline}.nli small{color:var(--muted);font-size:.82rem}
.ncard{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column;transition:transform .15s}.ncard:hover{transform:translateY(-3px)}.ncard .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.ncard .bd{padding:18px 20px 22px}.ncard h3{margin:8px 0 6px;line-height:1.3}.ncard:hover h3{color:var(--blue)}.ncard p{font-size:.92rem;color:var(--muted);margin:0}
/* council */
.cm{text-align:center;text-decoration:none;color:var(--text);padding:20px 14px}.cm img{width:104px;height:104px;border-radius:50%;margin:0 auto 12px;border:4px solid #fff;box-shadow:0 6px 16px rgba(12,59,58,.18)}.cm b{display:block;color:var(--ink)}.cm span{font-size:.86rem;color:var(--muted)}.cm:hover b{color:var(--blue)}
.mayor{display:grid;grid-template-columns:220px 1fr;gap:28px;align-items:center;padding:28px}.mayor img{width:220px;height:220px;border-radius:18px}
/* stats */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stats>div{padding:22px;border-left:4px solid var(--gold);background:#fff;border-radius:0 12px 12px 0;box-shadow:var(--sh)}.stats b{display:block;font-family:"Source Serif 4",serif;font-size:2.2rem;color:var(--navy);line-height:1.1}.stats span{color:var(--muted);font-size:.92rem}
/* page */
.phead{background:#fff;border-bottom:1px solid var(--line);padding:34px 0 30px}.phead p{color:var(--muted);font-size:1.08rem;max-width:760px;margin:10px 0 0}
.crumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:.88rem;color:var(--muted);margin-bottom:12px;list-style:none;padding:0}.crumbs a{color:var(--blue)}.crumbs li+li::before{content:"/";margin-right:8px;color:#9aa6b2}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.chips a{font-size:.9rem;font-weight:700;padding:8px 15px;border-radius:30px;background:#fff;border:2px solid var(--line);color:var(--ink);text-decoration:none}.chips a:hover{border-color:var(--blue)}.chips a[aria-current=true]{background:var(--navy);border-color:var(--navy);color:#fff}
.body{padding:40px 0 70px}.art{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:30px;align-items:start}
.prose{font-size:1.05rem;line-height:1.72}.prose h2{font-size:1.4rem;margin:1.4em 0 .5em}.prose ul,.prose ol{padding-left:1.3em}.prose li{margin:.35em 0}
.facts{margin:0}.facts>div{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-top:1px solid var(--line);font-size:.94rem}.facts>div:first-child{border-top:0;padding-top:0}.facts dt{color:var(--muted);margin:0}.facts dd{margin:0;color:var(--ink);font-weight:600;text-align:right}
.cta{background:var(--navy);color:#d6ebe6;border-radius:16px;padding:26px;position:relative;overflow:hidden}.cta h2,.cta h3{color:#fff}.cta::after{content:"";position:absolute;right:-60px;bottom:-60px;width:180px;height:180px;border-radius:50%;border:30px solid rgba(224,165,38,.25)}
.svc{display:flex;gap:16px;padding:18px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text);align-items:center}.svc:first-child{border-top:0}.svc:hover{background:#fafbfc}.svc .ic{width:44px;height:44px;flex:none;border-radius:11px;display:grid;place-items:center;font-size:1.2rem;background:var(--blue2);color:var(--blue)}.svc b{display:block;color:var(--ink)}.svc:hover b{color:var(--blue);text-decoration:underline}.svc small{display:block;color:var(--muted);font-size:.88rem}.svc .go{margin-left:auto;color:var(--muted)}
.dept{padding:22px;text-decoration:none;color:var(--text);display:flex;flex-direction:column;border-top:5px solid var(--c)}.dept:hover h3{color:var(--blue);text-decoration:underline}.dept .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font-size:1.3rem;color:#fff;background:var(--c);margin-bottom:14px}.dept p{font-size:.92rem;color:var(--muted);margin:6px 0 14px}.dept .ph{margin-top:auto;font-size:.88rem;font-weight:700;color:var(--ink)}
.fbar{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:22px;padding:16px;background:#fff;border:1px solid var(--line);border-radius:12px}.fbar label{display:block;font-size:.82rem;font-weight:700;color:var(--ink);margin-bottom:4px}.fbar input,.fbar select{border:2px solid var(--line);border-radius:9px;padding:9px 12px;font:inherit;font-size:.95rem;background:#fff;color:var(--ink);min-height:44px}.fbar .grow{flex:1;min-width:220px}.fbar input{width:100%}
.zone{padding:22px;border-top:5px solid var(--c)}.zone .day{font-family:"Source Serif 4",serif;font-size:1.7rem;color:var(--ink);margin:4px 0}.zone p{font-size:.92rem;color:var(--muted);margin:0}
table.t{width:100%;border-collapse:collapse;font-size:.95rem}table.t th,table.t td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left}table.t th{font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.faq details{border-top:1px solid var(--line);padding:14px 0}.faq details:first-child{border-top:0}.faq summary{cursor:pointer;font-weight:700;color:var(--ink)}.faq p{margin:10px 0 0;color:var(--muted)}
.sub{display:flex;gap:14px;align-items:center;padding:16px 18px;border:1px solid rgba(255,255,255,.18);border-radius:12px;color:#fff;text-decoration:none;background:rgba(255,255,255,.06)}.sub:hover{background:rgba(255,255,255,.12);color:#fff}.sub i{font-size:1.4rem;color:var(--gold)}.sub small{display:block;color:#b5d3cc}
/* footer */
.foot{background:var(--navy);color:#c5dbd6;padding:54px 0 0;margin-top:0}.foot h2{color:#fff;font-size:1.06rem;font-family:"Figtree";font-weight:700;margin-bottom:12px}.foot a{color:#fff;text-decoration:none}.foot a:hover{text-decoration:underline}.foot ul{list-style:none;padding:0;margin:0}.foot li{margin:7px 0;font-size:.94rem}.fcols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px}.fbot{border-top:1px solid rgba(255,255,255,.12);margin-top:40px;padding:18px 0;font-size:.84rem;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
@media (max-width:1100px){.nav a{padding:10px 9px;font-size:.9rem}.hacts .btn-o{display:none}}
.subband{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:28px;align-items:center}
@media (max-width:980px){.subband{grid-template-columns:1fr}.council{grid-template-columns:repeat(4,minmax(0,1fr))!important}.hdr .wrap{height:70px}.nav{display:none;position:absolute;left:0;right:0;top:70px;background:#fff;flex-direction:column;padding:10px 20px 18px;border-bottom:1px solid var(--line);box-shadow:0 20px 30px -20px rgba(0,0,0,.3)}.hdr.open .nav{display:flex}.nav a{padding:13px 10px;font-size:1rem}.tog{display:block}.hacts{margin-left:auto}.tgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.split,.art,.feat{grid-template-columns:1fr}.g3,.g4{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,1fr)}.fcols{grid-template-columns:1fr 1fr}.mayor{grid-template-columns:1fr}.mayor img{width:160px;height:160px}}
@media (max-width:620px){body{font-size:16px}.hacts .btn-g{display:none}.hero{padding:40px 0 190px}.sky{height:220px}.wrap{padding:0 18px}.govbar .r{display:none}.brand b{font-size:1.12rem}.brand svg{width:42px;height:42px}.hacts .btn-g{padding:9px 12px;font-size:.88rem}.tasks{margin-top:-50px}.tgrid,.g2,.g3,.g4{grid-template-columns:1fr}.task{padding:14px}.mtg{padding:16px}.date{width:58px}.fcols{grid-template-columns:1fr}.alert a.more{display:none}.stats b{font-size:1.7rem}.cm img{width:84px;height:84px}.council{grid-template-columns:repeat(2,minmax(0,1fr))!important}}

/* kestrel additions */
h1,h2{font-family:"Source Serif 4",Georgia,serif}
.govbar .fict{background:rgba(208,138,60,.22);color:#fff;border-radius:20px;padding:1px 9px;font-weight:700;margin-right:6px;font-size:.74rem;letter-spacing:.04em;text-transform:uppercase}
.brand .logo{width:46px;height:46px;flex:none}
.hgrid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:44px;align-items:center;position:relative;z-index:1}
.hero .btns{display:flex;gap:12px;flex-wrap:wrap}
.hero .assure{display:flex;gap:18px;flex-wrap:wrap;margin-top:22px;font-size:.9rem;color:#cfe5df}.hero .assure i{color:var(--gold);margin-right:6px}
.rateboard{background:#fff;color:var(--text);border-radius:18px;box-shadow:0 30px 60px -25px rgba(0,0,0,.55);overflow:hidden}
.rateboard .rh{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}.rateboard .rh b{font-family:"Source Serif 4",serif;font-size:1.15rem;color:var(--ink)}.rateboard .rh small{color:var(--muted);font-size:.78rem}
.rrow{display:flex;align-items:center;gap:14px;padding:13px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.rrow:first-of-type{border-top:0}.rrow:hover{background:#f7faf9}
.rrow .ic{width:40px;height:40px;border-radius:11px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;flex:none;font-size:1.1rem}
.rrow b{display:block;color:var(--ink);font-size:.95rem;line-height:1.25}.rrow small{color:var(--muted);font-size:.8rem}
.rrow .rv{margin-left:auto;text-align:right;white-space:nowrap}.rrow .rv strong{display:block;font-family:"Source Serif 4",serif;font-size:1.55rem;color:var(--navy);line-height:1}.rrow .rv em{font-style:normal;font-size:.72rem;font-weight:700;color:var(--muted);letter-spacing:.06em}
.rateboard .rf{padding:12px 20px;background:#f7faf9;font-size:.78rem;color:var(--muted);border-top:1px solid var(--line)}
.prod{padding:24px;text-decoration:none;color:var(--text);display:flex;flex-direction:column;transition:transform .15s,border-color .15s}.prod:hover{transform:translateY(-3px);border-color:var(--blue);color:var(--text)}
.prod .ic{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;font-size:1.35rem;background:var(--navy);color:#fff;margin-bottom:16px}
.prod h3{font-size:1.2rem;font-family:"Source Serif 4",serif;font-weight:650}.prod p{font-size:.93rem;color:var(--muted);margin:8px 0 16px}.prod .rn{margin-top:auto;font-weight:700;color:var(--blue);font-size:.95rem}
.ticks{list-style:none;padding:0;margin:0}.ticks li{padding:7px 0 7px 30px;position:relative;border-top:1px solid var(--line)}.ticks li:first-child{border-top:0}.ticks li::before{content:"\F26E";font-family:bootstrap-icons;position:absolute;left:0;top:6px;color:var(--blue);font-size:1.1rem}
.own{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:40px;align-items:center}
.vmap{position:relative;border-radius:18px;overflow:hidden;background:#e9f0e6;border:1px solid var(--line);box-shadow:var(--sh)}.vmap svg{display:block;width:100%;height:auto}
.pin{position:absolute;transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;text-decoration:none;z-index:2}
.pin span{background:var(--navy);color:#fff;font-size:.74rem;font-weight:700;padding:4px 9px;border-radius:20px;white-space:nowrap;box-shadow:0 6px 14px -6px rgba(0,0,0,.5)}.pin i{color:var(--navy);font-size:1.5rem;line-height:1;margin-top:-3px}
.pin.atm span{background:#fff;color:var(--navy);border:1px solid var(--line)}.pin.atm i{color:var(--gold)}.pin:hover span,.pin:focus-visible span{background:var(--gold);color:var(--ink)}
.loc{display:flex;gap:14px;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.loc:first-child{border-top:0}.loc:hover{background:#fafcfb}.loc .ic{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;background:var(--blue2);color:var(--blue);flex:none;font-size:1.15rem}.loc b{display:block;color:var(--ink)}.loc small{display:block;color:var(--muted);font-size:.86rem}
.bcard{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column}.bcard .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.bcard .bd{padding:18px 20px 22px}.bcard:hover h3{color:var(--blue)}
.hours{white-space:pre-line}
table.rt{width:100%;border-collapse:collapse;font-size:.97rem}table.rt caption{text-align:left;padding:18px 22px 8px;font-family:"Source Serif 4",serif;font-size:1.35rem;font-weight:650;color:var(--ink)}
table.rt th,table.rt td{padding:13px 22px;border-top:1px solid var(--line);text-align:left;vertical-align:top}table.rt thead th{font-size:.76rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);border-top:0;background:#f7faf9}
table.rt td.num{font-family:"Source Serif 4",serif;font-size:1.3rem;color:var(--navy);font-weight:650;white-space:nowrap}table.rt td small,table.rt th small{display:block;color:var(--muted);font-size:.82rem;font-weight:400;margin-top:2px}table.rt tr.hl td,table.rt tr.hl th{background:#fffaf2}table.rt th a{text-decoration:none}table.rt th a:hover{text-decoration:underline}
.disc{font-size:.85rem;color:var(--muted);border-left:4px solid var(--gold);background:#fff;padding:14px 18px;border-radius:0 10px 10px 0}
.lock{background:linear-gradient(150deg,#0c3b3a,#13615c);color:#d6ebe6;border-radius:18px;padding:44px;position:relative;overflow:hidden}.lock h2{color:#fff;margin:14px 0 10px}.lock .ic{width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:1.6rem;color:var(--gold)}
.lock::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(208,138,60,.18)}
.doc{display:flex;gap:14px;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text);align-items:center}.doc:first-child{border-top:0}.doc:hover{background:#fafcfb}.doc .ic{width:42px;height:48px;border-radius:8px;display:grid;place-items:center;background:#fdeee6;color:#b4471c;flex:none;font-size:1.2rem}.doc b{display:block;color:var(--ink)}.doc small{color:var(--muted);font-size:.84rem}.doc .lk{margin-left:auto;color:var(--muted)}
.vol{display:flex;gap:16px;align-items:center;padding:18px;text-decoration:none;color:var(--text)}.vol img{width:78px;height:78px;border-radius:50%;flex:none}.vol b{display:block;color:var(--ink);font-size:1.05rem}.vol small{color:var(--muted)}.vol:hover b{color:var(--blue)}
.calc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:26px;align-items:center}.calc label{display:block;font-weight:700;color:var(--ink);font-size:.9rem;margin:0 0 6px}.calc input,.calc select{width:100%;border:2px solid var(--line);border-radius:10px;padding:11px 13px;font:inherit;min-height:46px;margin-bottom:14px;color:var(--ink);background:#fff}
.calc .out{background:var(--navy);color:#d6ebe6;border-radius:16px;padding:28px;text-align:center}.calc .out b{display:block;font-family:"Source Serif 4",serif;font-size:3rem;color:#fff;line-height:1.1;margin:6px 0}
.member{display:flex;gap:16px;align-items:center;background:var(--gold2);border:1px solid #f1d6b5;border-radius:14px;padding:16px 20px}
.steps{counter-reset:s;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.steps>div{padding:24px;position:relative}.steps>div::before{counter-increment:s;content:counter(s);width:38px;height:38px;border-radius:50%;background:var(--gold);color:var(--ink);font-weight:800;display:grid;place-items:center;margin-bottom:12px}
@media (max-width:980px){.hgrid,.own,.calc{grid-template-columns:1fr}.steps{grid-template-columns:1fr}.rateboard{max-width:560px}}
.nav .mob{display:none}
@media (max-width:980px){.nav .mob{display:block}.nav .mob a{color:var(--blue)}}
@media (max-width:620px){.hacts .btn-p{display:none}.hero{padding:34px 0 140px}.lock{padding:28px}.rrow{padding:12px 16px}.rrow .rv strong{font-size:1.3rem}table.rt th,table.rt td{padding:11px 14px}.pin span{display:none}.govbar .wrap{font-size:.76rem}}</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}
{%- assign path = Target.RoutePath | default: "" -%}{%- assign seg = path | split: "/" | first -%}
{%- if seg == "documents" or seg == "board" or seg == "news" -%}{%- assign seg = "about" -%}{%- endif -%}
<div class="govbar"><div class="wrap"><span><span class="fict">Fictional</span> Kestrel Valley Credit Union is a made-up credit union for a Raytha example site. Rates and people are invented.</span><span class="r"><a href="{{ PathBase }}/locations"><i class="bi bi-geo-alt" aria-hidden="true"></i> Branches and ATMs</a><a href="tel:+15550142000"><i class="bi bi-telephone" aria-hidden="true"></i> (555) 014-2000</a><a href="{{ PathBase }}/contact">Contact</a></span></div></div>
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="brand" href="{{ PathBase }}/" aria-label="Kestrel Valley Credit Union home"><svg class="logo" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#0c3b3a"/><circle cx="24" cy="24" r="19.5" fill="none" stroke="#d08a3c" stroke-width="1.4"/><path d="M8 33c5-4 10-6 16-6s11 2 16 6v4H8z" fill="#2a8076"/><path d="M8 36c6-3 11-4 16-4s10 1 16 4v2H8z" fill="#4fa59a"/><path d="M11 21c4-3 8-4 12-2 2-3 5-5 9-5-2 2-3 3-3 5 3 0 6 1 8 3-4-1-7 0-9 1l-3 6-2-5c-4-1-8-1-12 1z" fill="#f3e3cf"/><circle cx="31.3" cy="16.8" r=".9" fill="#0c3b3a"/></svg><span><b>Kestrel Valley</b><small>Credit Union</small></span></a>
    <nav aria-label="Main"><ul class="nav" id="nav">
      {%- assign menu = get_main_menu() %}
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}"{% if u == seg and u != "" %} aria-current="page"{% endif %}>{{ mi.Label }}</a></li>
      {%- endfor %}
      <li class="mob"><a href="{{ PathBase }}/members"><i class="bi bi-person-badge" aria-hidden="true"></i> Member area</a></li><li class="mob"><a class="ext" href="https://online.kestrelvalley.example" rel="noopener">Online banking</a></li>
    </ul></nav>
    <div class="hacts"><a class="btn btn-o" href="{{ PathBase }}/members"><i class="bi bi-person-badge" aria-hidden="true"></i> Member area</a><a class="btn btn-p ext" href="https://online.kestrelvalley.example" rel="noopener">Online banking</a>
      <button class="tog" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu" onclick="var h=document.getElementById('hdr');var o=h.classList.toggle('open');this.setAttribute('aria-expanded',o)"><i class="bi bi-list" aria-hidden="true"></i></button></div>
  </div>
</header>
{%- assign al = get_content_items(ContentType="alerts", Filter="active eq 'true'", OrderBy="posted_on desc", PageSize=2) -%}
{%- if seg != "security" %}{% for a in al.Items %}{% capture lv %}{{ a.PublishedContent.level }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% assign lc = kv[3] %}{% endif %}{% endfor %}
<div class="alert {{ lc }}" role="region" aria-label="{{ ll }}"><div class="wrap"><span class="ic" aria-hidden="true"><i class="bi bi-{{ li }}"></i></span><p><b>{{ ll }}: {{ a.PrimaryField }}.</b> {{ a.PublishedContent.message }}</p><a class="more" href="{{ PathBase }}/{{ a.RoutePath }}">Details <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></div>
{%- endfor %}{% endif %}
<main id="main" tabindex="-1">{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <div class="fcols">
      <div><a class="brand" href="{{ PathBase }}/" style="color:#fff;margin-bottom:16px"><svg class="logo" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#0c3b3a"/><circle cx="24" cy="24" r="19.5" fill="none" stroke="#d08a3c" stroke-width="1.4"/><path d="M8 33c5-4 10-6 16-6s11 2 16 6v4H8z" fill="#2a8076"/><path d="M8 36c6-3 11-4 16-4s10 1 16 4v2H8z" fill="#4fa59a"/><path d="M11 21c4-3 8-4 12-2 2-3 5-5 9-5-2 2-3 3-3 5 3 0 6 1 8 3-4-1-7 0-9 1l-3 6-2-5c-4-1-8-1-12 1z" fill="#f3e3cf"/><circle cx="31.3" cy="16.8" r=".9" fill="#0c3b3a"/></svg><span><b style="color:#fff">Kestrel Valley</b><small style="color:#9cc0b8">Credit Union</small></span></a>
        <p style="font-size:.94rem;margin:0">214 Main St, Harlow<br>Member service: Mon to Fri 8 am to 7 pm, Sat 9 am to 1 pm</p>
        <p style="font-size:.94rem;margin:12px 0 0"><a href="tel:+15550142000">(555) 014-2000</a> &middot; <a href="mailto:hello@kestrelvalley.example">hello@kestrelvalley.example</a></p>
        <p style="font-size:.88rem;margin:12px 0 0;color:#9cc0b8">Lost or stolen card, 24 hours: (555) 014-2911<br>Routing number: 000000000 (fictional)</p></div>
      <div><h2>Accounts and loans</h2><ul>{% assign fp = get_content_items(ContentType="products", OrderBy="sort_order asc", PageSize=7) %}{% for p in fp.Items %}<li><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a></li>{% endfor %}</ul></div>
      <div><h2>About us</h2><ul>{% assign fm = get_menu("footer") %}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
      <div><h2>Help and security</h2><ul><li><a href="{{ PathBase }}/security">Security center</a></li><li><a href="{{ PathBase }}/feeds/security.rss"><i class="bi bi-rss" aria-hidden="true"></i> Security alerts (RSS)</a></li><li><a href="{{ PathBase }}/feeds/rates.json"><i class="bi bi-braces" aria-hidden="true"></i> Rates feed (JSON)</a></li><li><a href="{{ PathBase }}/loan-calculator">Loan calculator</a></li><li><a href="{{ PathBase }}/accessibility">Accessibility</a></li><li><a href="{{ PathBase }}/disclosures">Disclosures</a></li></ul></div>
    </div>
    <div class="fbot" style="display:block"><p style="margin:0 0 8px;color:#c5dbd6">Kestrel Valley Credit Union is fictional and is not a real financial institution. Nothing on this site is an offer of credit, and no deposits here are insured. On a real credit union website, this is where the NCUA share insurance statement and the Equal Housing Opportunity notice would appear.</p><span>&copy; 2026 Kestrel Valley Credit Union (fictional). Built with <a href="https://raytha.com" style="text-decoration:underline">Raytha</a>.</span></div>
  </div>
</footer>
<script>
document.addEventListener('keydown',function(e){if(e.key==='Escape'){var h=document.getElementById('hdr');if(h&&h.classList.contains('open')){h.classList.remove('open');var t=h.querySelector('.tog');t.setAttribute('aria-expanded','false');t.focus()}}});
</script>
</body>
</html>
