{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture bg %}{{ p.body_group }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/board">Board and committees</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><h1>{{ Target.PrimaryField }}</h1><p>{{ p.role }}, {% if bg == "board" %}Board of directors{% else %}Supervisory committee{% endif %}</p></div></div>
<div class="body"><div class="wrap art">
  <article class="card pad" style="padding:32px;display:grid;grid-template-columns:180px 1fr;gap:28px"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="Portrait of {{ Target.PrimaryField }}" style="width:180px;height:180px;border-radius:18px"><div class="prose"><h2 style="margin-top:0">About {{ Target.PrimaryField | split: " " | first }}</h2><p>{{ p.bio }}</p><p class="muted">Volunteers serve without pay. Kestrel Valley and everyone on this page are fictional.</p></div></article>
  <aside class="grid" style="gap:20px"><div class="card pad"><dl class="facts"><div><dt>Role</dt><dd>{{ p.role }}</dd></div><div><dt>Term ends</dt><dd>{{ p.term_ends }}</dd></div><div><dt>Member since</dt><dd>{{ p.member_since }}</dd></div></dl></div>
  <div class="cta"><h2 style="font-size:1.15rem">Write to the board</h2><p style="margin:8px 0 14px;font-size:.95rem">Members can write to the board through the secretary.</p><a class="btn btn-g" href="mailto:board@kestrelvalley.example">Email the board</a></div></aside>
</div></div>
