{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture tk %}{{ p.topic }}{% endcapture %}{% for pair in tps %}{% assign kv = pair | split: ":" %}{% if kv[0] == tk %}{% assign tl = kv[1] %}{% assign ti = kv[2] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/learn">Learning center</a></li><li><a href="{{ PathBase }}/learn?topic={{ tk }}">{{ tl }}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill blue" style="margin-bottom:10px"><i class="bi bi-{{ ti }}" aria-hidden="true"></i> {{ tl }} &middot; {{ p.minutes }} minute read</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;margin-bottom:22px">
    <div class="card pad prose" style="padding:32px"><p class="muted" style="font-size:.92rem">By {{ p.author }} &middot; {{ p.posted_on.Value | date: "%B %-d, %Y" }}</p>{{ p.body }}<p class="disc" style="margin-top:24px">General education, not financial advice. Kestrel Valley Credit Union is fictional.</p></div></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    {%- capture f %}topic eq '{{ tk }}'{% endcapture %}{% assign more = get_content_items(ContentType="articles", Filter=f, OrderBy="posted_on desc", PageSize=4) -%}
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">More on {{ tl | downcase }}</h2>{% for a in more.Items %}{% if a.Id != Target.Id %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span><b style="font-size:.95rem">{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.minutes }} minute read</small></span></a>{% endif %}{% endfor %}<a class="more" href="{{ PathBase }}/learn">All articles <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="cta"><h2 style="font-size:1.15rem">Free one-on-one help</h2><p style="margin:8px 0 14px;font-size:.95rem">Our member advisors will go through a budget or a credit report with you, free, at any branch.</p><a class="btn btn-g" href="{{ PathBase }}/locations">Find a branch</a></div>
  </aside>
</div></div>
