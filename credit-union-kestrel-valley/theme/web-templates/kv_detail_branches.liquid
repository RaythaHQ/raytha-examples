{%- assign pcs = "checking:Checking:cash-coin,savings:Savings:piggy-bank,certificates:Certificates:lock,auto:Auto loans:car-front,home:Home loans:house-door,personal:Personal loans and cards:credit-card-2-front,business:Business:shop" | split: "," -%}{%- assign rts = "savings:Savings and checking:APY,certificates:Certificates:APY,auto:Auto loans:APR,home:Home loans:APR,personal:Personal loans and cards:APR" | split: "," -%}{%- assign tps = "budgeting:Budgeting:wallet2,credit:Credit and borrowing:credit-card,home:Buying a home:house-door,fraud:Fraud and scams:shield-exclamation,saving:Saving and retirement:piggy-bank,youth:Kids and students:backpack" | split: "," -%}{%- assign ncs = "members:Member news:blue,community:Community:green,rates:Rates and products:gold,branches:Branches and service:navy,governance:Governance:blue" | split: "," -%}{%- assign lvs = "scam:Scam warning:exclamation-octagon-fill:emergency,service:Service notice:tools:advisory,info:Good to know:info-circle-fill:info" | split: "," -%}{%- assign dks = "annual_meeting:Annual meeting:people,minutes:Minutes:journal-text,report:Report:file-earmark-bar-graph,election:Board election:check2-square,disclosure:Disclosure:file-earmark-text" | split: "," -%}{%- assign bks = "branch:Branch:bank2,atm:ATM only:credit-card,partner:Shared branch:share" | split: "," -%}{%- assign is_mem = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_mem = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_mem = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture bk %}{{ p.kind }}{% endcapture %}{% for pair in bks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/locations">Branches and ATMs</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill navy" style="margin-bottom:10px"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px">{% if bk == "branch" %}<img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover">{% endif %}
    <div class="card pad prose" style="padding:30px"><h2 style="margin-top:0">About this location</h2>{{ p.about }}<h2>Services</h2><div style="display:flex;gap:8px;flex-wrap:wrap">{% assign sv = p.services | split: "," %}{% for s in sv %}<span class="pill blue">{{ s | strip }}</span>{% endfor %}</div></div></div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><dl class="facts"><div><dt>Address</dt><dd>{{ p.address }}<br>{{ p.town }}</dd></div>{% capture c_p_phone %}{{ p.phone | strip }}{% endcapture %}{% if c_p_phone != "" %}<div><dt>Phone</dt><dd><a href="tel:{{ p.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.phone }}</a></dd></div>{% endif %}<div><dt>Lobby</dt><dd class="hours">{{ p.lobby_hours }}</dd></div>{% capture c_p_drive_hours %}{{ p.drive_hours | strip }}{% endcapture %}{% if c_p_drive_hours != "" %}<div><dt>Drive-thru</dt><dd class="hours">{{ p.drive_hours }}</dd></div>{% endif %}{% capture c_p_manager %}{{ p.manager | strip }}{% endcapture %}{% if c_p_manager != "" %}<div><dt>Manager</dt><dd>{{ p.manager }}</dd></div>{% endif %}</dl>
      <a class="btn btn-o ext" style="width:100%;margin-top:14px" href="https://maps.kestrelvalley.example/?q={{ p.address | url_encode }}" rel="noopener"><i class="bi bi-signpost-split" aria-hidden="true"></i> Directions</a></div>
    <div class="card pad"><p style="margin:0;font-size:.94rem"><i class="bi bi-universal-access" aria-hidden="true"></i> Every branch has step-free access, and staff can read documents aloud or provide them in large print.</p></div>
  </aside>
</div></div>
