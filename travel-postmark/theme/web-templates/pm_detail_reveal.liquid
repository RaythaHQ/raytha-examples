{%- assign p = Target.PublishedContent -%}{%- assign t = p.tier -%}{%- assign rt = p.rating | append: "" | plus: 0 -%}
<section class="phead"><svg class="big-pm" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 44c7-5 14 5 21 0s14-5 21 0 14 5 21 0 14-5 21 0M8 56c7-5 14 5 21 0s14-5 21 0 14 5 21 0 14-5 21 0" fill="none" stroke="currentColor" stroke-width="2"/></svg><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/reveals">Past reveals</a><span>/</span><span>{{ Target.PrimaryField }}</span></div>
  <span class="label" style="display:block;margin-top:22px">The clue in the envelope</span><h1 style="font-size:clamp(2rem,3.8vw,3.1rem);max-width:900px;line-height:1.2">“{{ p.clue }}”</h1></div></section>
<section class="section" style="padding-top:60px"><div class="wrap detail">
  <div class="pc" style="transform:rotate(-1.5deg)"><div class="ph"><img src="{{ p.postcard | attachment_redirect_url }}" alt="Postcard of {{ Target.PrimaryField }}"><span class="pm">{{ t.PrimaryField }}<br>{{ p.when | split: " " | last }}</span></div><div class="tx"><h3>{{ Target.PrimaryField }}</h3><div class="meta">{{ p.country }}</div></div></div>
  <div><span class="label">It was</span><h2 style="font-size:clamp(2.8rem,5vw,4.4rem);margin:10px 0 6px">{{ Target.PrimaryField }}</h2><p style="font-size:1.2rem;color:var(--ink2)">{{ p.country }}</p>
    <div class="kv"><div><span>Who went</span><b>{{ p.travelers }}</b></div><div><span>When</span><b>{{ p.when }}</b></div><div><span>Trip</span><b><a href="{{ PathBase }}/{{ t.RoutePath }}" style="color:{{ t.PublishedContent.color }}">{{ t.PrimaryField }}</a></b></div><div><span>Rating</span><b class="stars">{% for i in (1..5) %}{% if i <= rt %}★{% else %}☆{% endif %}{% endfor %}</b></div></div>
    <blockquote style="margin:0 0 24px;padding:18px 22px;border-left:4px solid var(--red);background:var(--card);border-radius:0 12px 12px 0;font:400 1.3rem/1.4 var(--serif)">{{ p.reaction }}<span class="muted" style="display:block;font:700 .7rem var(--mono);letter-spacing:.1em;text-transform:uppercase;margin-top:10px">At the airport</span></blockquote>
    <div class="prose">{{ p.story }}</div>
    <span class="label" style="display:block;margin:24px 0 10px">Highlights we booked</span><ul style="padding-left:1.1rem;color:var(--ink2);margin:0">{% assign ls = p.highlights | newline_to_br | split: "<br />" %}{% for l in ls %}{% assign x = l | strip %}{% if x != "" %}<li style="padding:4px 0">{{ x }}</li>{% endif %}{% endfor %}</ul>
    <div class="row" style="margin-top:30px"><a class="btn btn-r" href="{{ PathBase }}/plan">Plan my own surprise</a><a class="btn btn-line" href="{{ PathBase }}/reveals">More reveals</a></div></div>
</div></section>
