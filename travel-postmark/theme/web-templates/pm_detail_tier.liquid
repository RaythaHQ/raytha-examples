{%- assign p = Target.PublishedContent -%}
<section class="phead"><svg class="big-pm" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="50" cy="50" r="30" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 44c7-5 14 5 21 0s14-5 21 0 14 5 21 0 14-5 21 0M8 56c7-5 14 5 21 0s14-5 21 0 14 5 21 0 14-5 21 0" fill="none" stroke="currentColor" stroke-width="2"/></svg><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/trips">Trips and prices</a><span>/</span><span>{{ Target.PrimaryField }}</span></div>
  <h1 style="color:{{ p.color }}">{{ Target.PrimaryField }}</h1><p>{{ p.tagline }}.</p></div></section>
<section class="section" style="padding-top:60px"><div class="wrap detail">
  <div><div class="prose">{{ p.description }}</div>
    <div class="kv"><div><span>Guide price per person</span><b>{{ p.price_range }}</b></div><div><span>Nights</span><b>{{ p.nights }}</b></div><div><span>How far</span><b>{{ p.reach }}</b></div><div><span>Best for</span><b>{{ p.best_for }}</b></div></div>
    <div class="grid2" style="gap:18px"><div class="card"><span class="label" style="color:var(--teal)">Included</span><ul style="padding-left:1.1rem;margin:12px 0 0;color:var(--ink2)">{% assign ls = p.includes | newline_to_br | split: "<br />" %}{% for l in ls %}{% assign x = l | strip %}{% if x != "" %}<li style="padding:3px 0">{{ x }}</li>{% endif %}{% endfor %}</ul></div>
      <div class="card"><span class="label">Not included</span><ul style="padding-left:1.1rem;margin:12px 0 0;color:var(--ink2)">{% assign ls = p.not_included | newline_to_br | split: "<br />" %}{% for l in ls %}{% assign x = l | strip %}{% if x != "" %}<li style="padding:3px 0">{{ x }}</li>{% endif %}{% endfor %}</ul></div></div>
    <div class="row" style="margin-top:28px"><a class="btn btn-r" href="{{ PathBase }}/plan">Plan a {{ Target.PrimaryField }}</a><a class="btn btn-line" href="{{ PathBase }}/trips">Compare trips</a></div>
    <p class="muted" style="font-size:.88rem;margin-top:14px">Prices are a guide. We quote every trip by email; nothing is paid on this website.</p></div>
  <div>{%- capture tf %}tier eq '{{ Target.Id }}'{% endcapture %}{% assign rs = get_content_items(ContentType="reveals", Filter=tf, OrderBy="sort_order asc", PageSize=4) %}
    <span class="label">Where {{ Target.PrimaryField }} trips have gone</span>
    <div class="grid2" style="gap:20px;margin-top:18px">{% for r in rs.Items %}<a class="pc" href="{{ PathBase }}/{{ r.RoutePath }}"><div class="ph"><img src="{{ r.PublishedContent.postcard | attachment_redirect_url }}" alt="{{ r.PrimaryField }}" loading="lazy"></div><div class="tx"><h3 style="font-size:1.3rem">{{ r.PrimaryField }}</h3><div class="meta">{{ r.PublishedContent.when }}</div></div></a>{% endfor %}</div></div>
</div></section>
