{%- assign s = widget.settings -%}
<section class="section tight"><div class="wrap"><div class="cta reveal"><span class="label">{{ s.kicker }}</span><h2>{{ s.headline }}</h2><p>{{ s.subtitle }}</p>
  <div class="row"><a class="btn btn-r" href="{{ s.primary_url }}">{{ s.primary_label }} <i class="bi bi-arrow-right"></i></a>{% if s.secondary_label %}<a class="btn btn-line" href="{{ s.secondary_url }}">{{ s.secondary_label }}</a>{% endif %}</div></div></div></section>
