<h2 style="font-size:2.4rem;margin-bottom:18px">Guest sign in</h2>
{% if Target.ValidationFailures["__ValidationSummary"] %}<div class="alert show">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
  <label for="email">Email address</label><input id="email" type="email" name="EmailAddress" autocomplete="email">
  <label for="password">Password</label><input id="password" type="password" name="Password" autocomplete="current-password">
  <button type="submit" class="btn btn-t" style="width:100%;justify-content:center">Sign in <i class="bi bi-arrow-right"></i></button>
  <input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form>
<p style="margin:16px 0 0;font-size:.92rem"><a class="muted" href="{{ PathBase }}/account/login/forgot-password/begin">Forgot your password?</a></p>
{% if Target.ShowOrLoginWithSection %}
  {% if Target.HasLoginByMagicLink %}<a href="{{ PathBase }}/account/login/magic-link" class="btn btn-line" style="width:100%;justify-content:center;margin-top:12px">{{ Target.MagicLink.LoginButtonText }}</a>{% endif %}
  {% if Target.HasLoginBySingleSignOn %}{% for sso in Target.SingleSignOns %}<a href="{{ PathBase }}/account/login/sso/{{ sso.DeveloperName }}" class="btn btn-line" style="width:100%;justify-content:center;margin-top:12px">{{ sso.LoginButtonText }}</a>{% endfor %}{% endif %}
{% endif %}
