{%- assign s = widget.settings -%}
<section class="section tight"><div class="wrap"><div class="cta reveal">
  <svg class="bg" style="left:-40px;bottom:-40px;width:260px" viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20 150C60 110 90 70 120 10"/><path d="M48 118c-14-4-24-16-26-30 14 2 25 13 26 30zM62 100c4-15 16-25 31-27-3 15-15 25-31 27zM74 82c-14-5-23-17-24-31 14 3 24 14 24 31zM88 62c5-14 17-23 32-24-4 14-16 23-32 24z"/></svg>
  <span class="label" style="color:#b7c2ad">{{ s.kicker }}</span><h2>{{ s.headline }} <em>{{ s.accent }}</em></h2><p>{{ s.subtitle }}</p>
  <div class="row"><a class="btn btn-paper" href="{{ s.primary_url }}">{{ s.primary_label }} <i class="bi bi-arrow-right"></i></a>{% if s.secondary_label %}<a class="btn btn-ghost" href="{{ s.secondary_url }}">{{ s.secondary_label }}</a>{% endif %}</div>
</div></div></section>
