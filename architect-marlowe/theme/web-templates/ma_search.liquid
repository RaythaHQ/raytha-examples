{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}
{%- assign q = QueryParams.q | strip | remove: "'" | remove: '"' | remove: "<" | remove: ">" | truncate: 60, "" -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Search</li></ol></nav><h1>{% if q != "" %}Results for &ldquo;{{ q }}&rdquo;{% else %}Search{% endif %}</h1><p>Case studies, services, people, journal, roles and clients.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/search" role="search"><div class="grow"><label for="sq">Search for</label><input id="sq" name="q" value="{{ q }}" placeholder="Try accessibility, museum or migration"></div><button class="btn btn-d" type="submit">Search</button></form>
{%- if q != "" -%}
{%- capture f1 %}contains(title,'{{ q }}') or contains(headline,'{{ q }}') or contains(summary,'{{ q }}') or contains(services,'{{ q }}'){% endcapture -%}
{%- capture f2 %}contains(name,'{{ q }}') or contains(tagline,'{{ q }}') or contains(summary,'{{ q }}'){% endcapture -%}
{%- capture f3 %}contains(name,'{{ q }}') or contains(role,'{{ q }}') or contains(focus,'{{ q }}'){% endcapture -%}
{%- capture f4 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f5 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}'){% endcapture -%}
{%- capture f6 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}'){% endcapture -%}
{%- assign rw = get_content_items(ContentType="work", Filter=f1, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rs = get_content_items(ContentType="services", Filter=f2, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rp = get_content_items(ContentType="team", Filter=f3, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign ri = get_content_items(ContentType="insights", Filter=f4, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign rr = get_content_items(ContentType="roles", Filter=f5, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rc = get_content_items(ContentType="clients", Filter=f6, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign total = rw.TotalCount | plus: rs.TotalCount | plus: rp.TotalCount | plus: ri.TotalCount | plus: rr.TotalCount | plus: rc.TotalCount -%}
<p class="count" role="status">{{ total }} result{% if total != 1 %}s{% endif %}</p>
{% if rw.TotalCount > 0 %}<h2 style="font-size:1.5rem;margin:10px 0 20px">Case studies</h2><div class="grid g3" style="margin-bottom:44px">{% for w in rw.Items %}{%- assign x = w.PublishedContent -%}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="wcard" href="{{ PathBase }}/{{ w.RoutePath }}"><div class="img"><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span>{{ w.PrimaryField }}</span><span>{{ il }} &middot; {{ x.year }}</span></div><h3>{{ x.headline }}</h3><div class="tags">{% assign svl = x.services | split: ", " %}{% for s in svl limit: 3 %}<span class="tag">{{ s }}</span>{% endfor %}</div></a>{% endfor %}</div>{% endif %}
<div class="grid g2" style="align-items:start">
{% if rs.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Services</h2></div>{% for s in rs.Items %}<a class="file" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-{{ s.PublishedContent.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><small>{{ s.PublishedContent.tagline }}</small></span></a>{% endfor %}</div>{% endif %}
{% if ri.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Journal</h2></div>{% for a in ri.Items %}<a class="file" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-journal-text"></i></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rp.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">People</h2></div>{% for m in rp.Items %}<a class="file" href="{{ PathBase }}/{{ m.RoutePath }}"><span class="fi" style="overflow:hidden;padding:0" aria-hidden="true"><img src="{{ m.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""></span><span><b>{{ m.PrimaryField }}</b><small>{{ m.PublishedContent.role }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rr.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Open roles</h2></div>{% for r in rr.Items %}<a class="file" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-briefcase"></i></span><span><b>{{ r.PrimaryField }}</b><small>{{ r.PublishedContent.location }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rc.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.3rem">Clients</h2></div>{% for c in rc.Items %}<a class="file" href="{{ PathBase }}/{{ c.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-building"></i></span><span><b>{{ c.PrimaryField }}</b><small>{{ c.PublishedContent.summary }}</small></span></a>{% endfor %}</div>{% endif %}
</div>
{% if total == 0 %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nothing matched &ldquo;{{ q }}&rdquo;</h2><p class="muted">Try a shorter word, or browse the <a href="{{ PathBase }}/work">houses</a>.</p></div>{% endif %}
{%- else -%}
<h2 style="font-size:1.2rem;margin-bottom:12px">Popular searches</h2><div class="chips">{% assign sug = "accessibility,museum,migration,portal,design,hosting" | split: "," %}{% for s in sug %}<a href="{{ PathBase }}/search?q={{ s | url_encode }}">{{ s }}</a>{% endfor %}</div>
{%- endif -%}
</div></div>
