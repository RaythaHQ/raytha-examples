{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture dk -%}{{ p.discipline }}{%- endcapture -%}{%- for pair in discs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="body" style="padding-top:40px"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/about">About</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav>
<div class="art" style="grid-template-columns:380px 1fr;margin-top:10px"><div><div class="person"><div class="img"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="Illustrated portrait of {{ Target.PrimaryField }}"></div></div></div>
<div><span class="tag o">{{ dl }}</span><h1 style="margin:14px 0 6px">{{ Target.PrimaryField }}</h1><p class="muted" style="font-size:1.2rem">{{ p.role }} &middot; {{ p.location }}</p>
<div class="prose">{{ p.bio }}</div>
<div style="display:flex;gap:6px;flex-wrap:wrap;margin:18px 0">{% assign fs = p.focus | split: ", " %}{% for f in fs %}<span class="tag l">{{ f }}</span>{% endfor %}</div>
<p><a href="mailto:{{ p.email }}">{{ p.email }}</a> <span class="muted" style="font-size:.88rem">(does not reach anyone)</span></p>
{%- assign arts = get_content_items(ContentType="insights", OrderBy="posted_on desc", PageSize=50) -%}{%- assign n = 0 -%}
{%- capture list -%}{% for a in arts.Items %}{% if a.PublishedContent.author.RoutePath == Target.RoutePath %}{% assign n = n | plus: 1 %}<li><a href="{{ PathBase }}/{{ a.RoutePath }}">{{ a.PrimaryField }}</a> <span class="muted" style="font-size:.88rem">{{ a.PublishedContent.posted_on.Value | date: "%b %-d, %Y" }}</span></li>{% endif %}{% endfor %}{%- endcapture -%}
{% if n > 0 %}<h2 style="font-size:1.4rem;margin-top:30px">Writing</h2><ul class="prose">{{ list }}</ul>{% endif %}
</div></div></div></div>
