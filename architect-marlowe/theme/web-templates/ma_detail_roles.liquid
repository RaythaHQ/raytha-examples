{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture rk -%}{{ p.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- endif -%}{%- endfor -%}{%- capture dk -%}{{ p.discipline }}{%- endcapture -%}{%- for pair in discs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/start">Start here</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:6px;margin-bottom:6px"><span class="tag">{{ dl }}</span><span class="tag l">{{ rl }}</span></div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<article class="prose">{{ p.body }}<h2>What is included</h2><ul>{% assign ls = p.responsibilities | newline_to_br | split: "<br />" %}{% for l in ls %}{% assign t = l | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul><h2>What to bring</h2><ul>{% assign ls = p.requirements | newline_to_br | split: "<br />" %}{% for l in ls %}{% assign t = l | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></article>
<aside class="side"><div class="card pad"><dl style="margin:0"><dt class="kicker">Location</dt><dd style="margin:6px 0 16px;font-weight:600">{{ p.location }}</dd><dt class="kicker">Salary</dt><dd style="margin:6px 0 16px;font-weight:600">{{ p.salary }}</dd><dt class="kicker">Posted</dt><dd style="margin:6px 0 0;font-weight:600">{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></dl></div>
<div class="card pad" style="background:var(--dark);color:#fff;border:0"><h2 style="font-size:1.2rem;margin-bottom:8px">How to book</h2><p style="margin:0;color:#cfcac2;font-size:.95rem">This is fictional. A real practice would ask for a note at elena@marlowe.example. There is no booking form here.</p></div></aside>
</div></div>
