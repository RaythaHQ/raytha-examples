{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Client portal</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>Client portal</h1><p>Project status, weekly updates, drawings and files, in one place for each client.</p></div></div>
<div class="body"><div class="wrap">
{% if is_member == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>Your project portal.</h2><p style="max-width:640px">Sign in to see your project: where it stands, Elena's weekly updates, drawings and decisions. Each client sees only their own project. Marlowe and its clients are fictional.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to your project portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact Elena</a></div></div>
<div class="grid g3" style="margin-top:24px"><div class="card pad"><h3><i class="bi bi-kanban" aria-hidden="true" style="color:var(--acc)"></i> Project rooms</h3><p class="muted" style="margin:6px 0 0">Phase, progress and the next milestone for each project.</p></div><div class="card pad"><h3><i class="bi bi-chat-square-text" aria-hidden="true" style="color:var(--acc)"></i> Friday updates</h3><p class="muted" style="margin:6px 0 0">What we did, what we need from you and what is next.</p></div><div class="card pad"><h3><i class="bi bi-folder2-open" aria-hidden="true" style="color:var(--acc)"></i> Drawings and files</h3><p class="muted" style="margin:6px 0 0">Guidelines, logo packs, reports and checklists with version numbers.</p></div></div>
{% else %}
<div class="member" style="margin-bottom:26px"><i class="bi bi-person-check" style="font-size:1.5rem;color:var(--acc)" aria-hidden="true"></i><p style="margin:0">Signed in as <strong>{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</strong> &middot; {% if is_studio %}<span class="tag d">Elena: all projects</span>{% else %}{% for pair in cgs %}{% assign kv = pair | split: ":" %}{% assign k2 = "," | append: kv[0] | append: "," %}{% if my_groups contains k2 %}<span class="tag l">{{ kv[1] }}</span> {% endif %}{% endfor %}{% endif %} <span class="muted" style="font-size:.9rem">The template checks your user groups on the server before it renders a project.</span></p></div>
{{ render_section("main", wrap=false) }}
{%- assign prs = get_content_items(ContentType="projects", OrderBy="sort_order asc", PageSize=50) -%}
{%- assign dls = get_content_items(ContentType="deliverables", OrderBy="posted_on desc", PageSize=50) -%}
<div class="art" style="margin-top:26px">
<div><h2 style="font-size:1.6rem;margin-bottom:16px">{% if is_studio %}All projects{% else %}Your project{% endif %}</h2><div class="card">{% for pr in prs.Items %}{% assign p = pr.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed %}{%- assign x = pr.PublishedContent -%}{%- capture sk -%}{{ x.status }}{%- endcapture -%}{%- for pair in sts -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="pj" href="{{ PathBase }}/{{ pr.RoutePath }}"><div class="top"><div><span class="tag l">{{ x.client.PrimaryField }}</span><h3 style="margin-top:8px">{{ pr.PrimaryField }}</h3></div><span class="tag {% if sk == "care" %}g{% else %}o{% endif %}">{{ sl }}</span></div><p>{{ x.summary }}</p><div class="bar" role="img" aria-label="{{ x.progress }} percent complete"><i style="width:{{ x.progress }}%"></i></div><div class="pmeta"><span><b>{{ x.progress }}%</b> complete</span><span>Next: <b>{{ x.next_milestone }}</b>{% if x.next_date %}, {{ x.next_date.Value | date: "%b %-d" }}{% endif %}</span>{% if x.lead %}<span>Lead: <b>{{ x.lead.PrimaryField }}</b></span>{% endif %}</div></a>{% endif %}{% endfor %}</div>
<h2 style="font-size:1.6rem;margin:40px 0 16px">Latest updates</h2><div class="card pad"><div class="tl">{% for pr in prs.Items %}{% assign p = pr.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed %}{% assign ups = p.updates | newline_to_br | split: "<br />" %}{% assign u = ups | first | strip | split: "|" %}{% if u.size > 2 %}<div><time>{{ u[0] | date: "%A, %B %-d" }} &middot; {{ pr.PrimaryField }}</time><h3>{{ u[1] }}</h3><p>{{ u[2] }}</p></div>{% endif %}{% endif %}{% endfor %}</div></div></div>
<aside class="side"><div class="card"><div class="pad" style="padding-bottom:6px"><h2 style="font-size:1.2rem">Recent files</h2></div>{% assign nf = 0 %}{% for d in dls.Items %}{% assign p = d.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed and nf < 6 %}{% assign nf = nf | plus: 1 %}{%- assign y = d.PublishedContent -%}{%- capture dk -%}{{ y.kind }}{%- endcapture -%}{%- for pair in dks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- assign di = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="file" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-{{ di }}"></i></span><span style="flex:1"><b>{{ d.PrimaryField }}</b><small>{% capture vv %}{{ y.version }}{% endcapture %}{% assign vv = vv | strip %}{{ dl }}{% if vv != "" %} &middot; {{ vv }}{% endif %} &middot; {{ y.posted_on.Value | date: "%b %-d, %Y" }}</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>{% endif %}{% endfor %}<div class="pad" style="padding-top:10px"><a class="more" href="{{ PathBase }}/portal/files">All files <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></div>
<div class="card pad" style="background:var(--dark);color:#fff;border:0"><h2 style="font-size:1.15rem;margin-bottom:8px">Need something?</h2><p style="margin:0;color:#cfcac2;font-size:.95rem">Reply to the latest update, or email <a href="mailto:elena@marlowe.example" style="color:#fff">elena@marlowe.example</a> (fictional).</p></div></aside>
</div>
{% endif %}
</div></div>
