{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/work">Work</a></li><li aria-current="page">Clients</li></ol></nav><h1>Clients</h1><p>Homeowners I have designed houses, ADUs and remodels with. All of them are fictional.</p></div></div>
<div class="body"><div class="wrap"><div class="grid g3">
{% for c in Target.Items %}{% assign x = c.PublishedContent %}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="card pad" href="{{ PathBase }}/{{ c.RoutePath }}" style="text-decoration:none;display:block"><img src="{{ x.logo.Value | attachment_redirect_url }}" alt="{{ c.PrimaryField }}" style="height:64px;width:auto;margin-bottom:12px"><span class="tag">{{ il }}</span><p class="muted" style="margin:12px 0 0;font-size:.96rem">{{ x.summary }}</p><p style="margin:10px 0 0;font-size:.86rem;color:var(--muted)">{{ x.location }} &middot; client since {{ x.since }}</p></a>{% endfor %}
</div></div></div>
