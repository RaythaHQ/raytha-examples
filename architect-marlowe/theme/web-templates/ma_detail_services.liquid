{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}{%- assign p = Target.PublishedContent -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/services">Services</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="tag o" style="margin-bottom:6px"><i class="bi bi-{{ p.icon }}" aria-hidden="true"></i> {{ p.tagline }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<article class="prose">{{ p.body }}<h2>What you get</h2><ul>{% assign dl = p.deliverables | newline_to_br | split: "<br />" %}{% for d in dl %}{% assign t = d | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></article>
<aside class="side"><div class="card pad"><dl style="margin:0"><dt class="kicker">Typical timeline</dt><dd style="margin:6px 0 18px;font-weight:600;font-size:1.1rem">{{ p.timeline }}</dd><dt class="kicker">Pricing</dt><dd style="margin:6px 0 0;font-weight:600">Fee in stages, written scope</dd></dl></div>
{% if p.lead %}{% assign m = p.lead %}<div class="card pad"><span class="kicker">Your architect</span><a class="person" href="{{ PathBase }}/{{ m.RoutePath }}" style="display:flex;gap:14px;align-items:center;margin-top:12px"><span class="img" style="width:72px;flex:none"><img src="{{ m.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""></span><span><b style="margin:0">{{ m.PrimaryField }}</b><span>{{ m.PublishedContent.role }}</span></span></a></div>{% endif %}
<a class="btn btn-p" href="{{ PathBase }}/contact" style="justify-content:center">Talk to me about {{ Target.PrimaryField | downcase }}</a></aside>
</div>
<div class="wrap">{%- assign ws = get_content_items(ContentType="work", OrderBy="sort_order asc", PageSize=50) -%}{%- assign n = 0 -%}
{%- capture cards -%}{% for w in ws.Items %}{% capture wsv %}{{ w.PublishedContent.services }}{% endcapture %}{% if wsv contains Target.PrimaryField and n < 2 %}{% assign n = n | plus: 1 %}{%- assign x = w.PublishedContent -%}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="wcard" href="{{ PathBase }}/{{ w.RoutePath }}"><div class="img"><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span>{{ w.PrimaryField }}</span><span>{{ il }} &middot; {{ x.year }}</span></div><h3>{{ x.headline }}</h3><div class="tags">{% assign svl = x.services | split: ", " %}{% for s in svl limit: 3 %}<span class="tag">{{ s }}</span>{% endfor %}</div></a>{% endif %}{% endfor %}{%- endcapture -%}
{% if n > 0 %}<h2 style="margin:64px 0 26px">Related houses</h2><div class="next" style="margin-top:0">{{ cards }}</div>{% endif %}</div></div>
