{%- assign inds = "new_home:New homes,adu:ADUs and guest houses,remodel:Remodels and additions,courtyard:Courtyard houses" | split: "," -%}{%- assign discs = "architecture:Architecture,design:Design,process:Process" | split: "," -%}{%- assign icats = "houses:Houses:o,adu:ADUs:l,remodel:Remodels:g,process:Process:l,notes:Notes from site:d" | split: "," -%}{%- assign rks = "consult:Consultation,feasibility:Feasibility" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design development,build:Permits and build,launch:Move-in,care:Aftercare" | split: "," -%}{%- assign dks = "brand:Drawings:rulers,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_andersen:Andersen house,client_okafor:Okafor ADU" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/portal">Client portal</a></li><li aria-current="page">Files</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>Drawings and files</h1><p>Drawings, reports and notes for your project, newest first.</p></div></div>
<div class="body"><div class="wrap">{% if is_member == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>Your project portal.</h2><p style="max-width:640px">Sign in to see your project: where it stands, Elena's weekly updates, drawings and decisions. Each client sees only their own project. Marlowe and its clients are fictional.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to your project portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact Elena</a></div></div>{% else %}<div class="card">{% for d in Target.Items %}{% assign p = d.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed %}{%- assign y = d.PublishedContent -%}{%- capture dk -%}{{ y.kind }}{%- endcapture -%}{%- for pair in dks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- assign di = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="file" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-{{ di }}"></i></span><span style="flex:1"><b>{{ d.PrimaryField }}</b><small>{% capture vv %}{{ y.version }}{% endcapture %}{% assign vv = vv | strip %}{{ dl }}{% if vv != "" %} &middot; {{ vv }}{% endif %} &middot; {{ y.posted_on.Value | date: "%b %-d, %Y" }}</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>{% endif %}{% endfor %}</div>{% endif %}</div></div>
