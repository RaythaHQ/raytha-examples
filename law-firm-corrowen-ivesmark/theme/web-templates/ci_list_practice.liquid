<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Practice</li></ol><p class="sn">§ 1 · Practice index</p><h1>Practice areas</h1><p class="lede">Nine practices in three groups. Each page says what we handle, what we refer to other firms, how we bill and how a matter usually moves.</p></div></div>{%- assign mts = get_content_items(ContentType="matters", OrderBy="sort_order asc", PageSize=50) -%}
<section class="sec tight"><div class="w" style="padding-left:96px">{%- assign gs = "disputes:1 · Disputes,business:2 · Business,people:3 · People and property" | split: "," -%}{% for g in gs %}{%- assign gp = g | split: ":" -%}<h2 class="sn" style="font-size:13px;margin:34px 0 4px;padding-bottom:10px;border-bottom:2px solid var(--ink)">{{ gp[1] }}</h2><div class="rowlist">{% for p in Target.Items %}{%- assign x=p.PublishedContent -%}{%- capture gr -%}{{ x.group }}{%- endcapture -%}{%- capture fm -%}{{ x.fee_model }}{%- endcapture -%}{% if gr == gp[0] %}{%- assign n=0 -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{% for m in mts.Items %}{%- capture mc -%}{{ m.PublishedContent.code }}{%- endcapture -%}{% if mc == pc %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}<a class="row" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="k" style="color:var(--red);font-size:15px">§ {{ x.num }}</span><div><b>{{ p.PrimaryField }}</b><p>{{ x.summary }}</p></div><div style="text-align:right"><span class="chip {{ fm }}">{% capture fl -%}{{ x.fee_model }}{%- endcapture %}{{ fl | replace: "hourly","Hourly" | replace: "flat","Flat fee" | replace: "contingency","Contingency" | replace: "blended","Blended" }}</span><div class="mono muted" style="font-size:12.5px">{{ n }} on the docket</div></div></a>{% endif %}{% endfor %}</div>{% endfor %}</div></section>
