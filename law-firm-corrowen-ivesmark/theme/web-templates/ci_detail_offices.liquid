{%- assign y=Target.PublishedContent -%}{%- assign ats = get_content_items(ContentType="attorneys", OrderBy="sort_order asc", PageSize=20) -%}{%- capture ok -%}{{ y.key }}{%- endcapture -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/offices">Offices</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="sn">§ 5 · Office</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div><div class="prose">{{ y.body }}</div><p class="sn" style="margin:36px 0 18px">Attorneys based here</p><div class="sigs">{% for a in ats.Items %}{%- assign z=a.PublishedContent -%}{%- capture ao -%}{{ z.office }}{%- endcapture -%}{% if ao == ok %}<a class="sig" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ z.photo.Value | attachment_redirect_url }}" alt=""><div><span class="rs">Respectfully submitted,</span><div class="sl">/s/ {{ a.PrimaryField }}</div><div class="nm">{{ a.PrimaryField }} · {% capture ps -%}{{ z.position }}{%- endcapture %}{{ ps | replace: "partner","Partner" | replace: "counsel","Of counsel" | replace: "associate","Associate" }}</div><div class="meta">{{ z.bar | split: " · " | first }}<br>{% capture of -%}{{ z.office }}{%- endcapture %}{{ of | replace: "courthouse-row","Courthouse Row office" | replace: "mill-district","Mill District office" }}</div></div></a>{% endif %}{% endfor %}</div></div>
<aside class="margin"><div class="off" style="border-color:var(--rule)"><div class="ct">⟶ {{ y.courthouse }}</div><div class="kv"><span>Address</span><div>{{ y.address | newline_to_br }}</div><span>Phone</span><div class="mono">{{ y.phone }}</div><span>Hours</span><div>{{ y.hours | replace: "|","<br>" }}</div></div></div></aside></div></div></section>
