{%- assign x=Target.PublishedContent -%}{%- assign prs = get_content_items(ContentType="practice", OrderBy="sort_order asc", PageSize=30) -%}{%- assign ats = get_content_items(ContentType="attorneys", OrderBy="sort_order asc", PageSize=20) -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{%- capture dp -%}{{ x.disposition }}{%- endcapture -%}{%- assign parts = Target.PrimaryField | split: " v. " -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/matters">Matters</a></li><li>{{ x.docket }}</li></ol><p class="sn">§ 3 · Representative matter · {{ x.year }}</p><h1>{{ x.result }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div><div class="caption"><div class="ct">{{ x.forum }}</div><div class="pl">{% if parts.size > 1 %}{{ parts[0] | capitalize }},<br><i class="muted">Party one,</i><br><br>v.<br><br>{{ parts[1] | capitalize }},<br><i class="muted">Party two.</i>{% else %}In the matter of<br><b>{{ Target.PrimaryField }}</b>{% endif %}</div><div class="pr">)
)
)
)
)
)</div><div class="no">{{ x.docket }}<br><br><span class="stamp big {{ dp }}">{% capture dl -%}{{ x.disposition }}{%- endcapture %}{{ dl | replace: "verdict","Verdict" | replace: "settled","Settled" | replace: "dismissed","Dismissed" | replace: "closed","Closed" | replace: "award","Award" | replace: "affirmed","Affirmed" }}</span></div></div>
<div class="prose">{{ x.body }}</div><p class="fine">Prior results do not guarantee a similar outcome. Parties, forum and figures are fictional.</p></div>
<aside class="margin"><div class="mbox"><h4>Practice</h4>{% for p in prs.Items %}{%- capture c -%}{{ p.PublishedContent.code }}{%- endcapture -%}{% if c == pc %}<a class="chip" href="{{ PathBase }}/{{ p.RoutePath }}">§ {{ p.PublishedContent.num }} {{ p.PrimaryField }}</a>{% endif %}{% endfor %}</div><div class="mbox"><h4>Team</h4><ul>{%- assign tm = x.team | split: "|" -%}{% for a in ats.Items %}{% if tm contains a.PrimaryField %}<li><a href="{{ PathBase }}/{{ a.RoutePath }}">{{ a.PrimaryField }}</a></li>{% endif %}{% endfor %}</ul></div><a class="btn line sm" href="{{ PathBase }}/matters">Full docket</a></aside></div></div></section>
