{%- assign prs = get_content_items(ContentType="practice", OrderBy="sort_order asc", PageSize=30) -%}
{%- assign ats = get_content_items(ContentType="attorneys", OrderBy="sort_order asc", PageSize=20) -%}
{%- assign mts = get_content_items(ContentType="matters", OrderBy="sort_order asc", PageSize=50) -%}
{%- assign ins = get_content_items(ContentType="insights", OrderBy="sort_order asc", PageSize=3) -%}
{%- assign offs = get_content_items(ContentType="offices", OrderBy="sort_order asc", PageSize=6) -%}
<section class="hero"><div class="w" style="padding-left:96px"><div class="dline"><span>Draft · for discussion</span><span>Corrowen &amp; Ivesmark LLP · Wendlow (fictional)</span></div>
<div class="doc"><div><p class="sn">§ 0 · Statement of the firm</p><h1 style="margin-top:14px">We <del>handle</del> <ins>try</ins> business disputes, and <del>prepare documents</del> <ins>write the agreements</ins> that keep you out of the next one.</h1>
<p class="lede">A seven-lawyer litigation and business law firm with two offices in the river city of Wendlow. Commercial cases and appeals across the square from the courthouse; contracts, companies, trademarks and estate plans in a converted mill on the river.</p>
<div class="cta"><a class="btn" href="{{ PathBase }}/practice">Practice index</a><a class="btn line" href="{{ PathBase }}/matters">The docket</a></div></div>
<div class="margin" aria-label="Margin comments from the firm's attorneys">{% for a in ats.Items limit:3 %}{%- assign y=a.PublishedContent -%}<div class="cmt"><a href="{{ PathBase }}/{{ a.RoutePath }}"><div class="by"><i>{{ y.initials }}</i>{{ a.PrimaryField }}<span>{% capture ps -%}{{ y.position }}{%- endcapture %}{{ ps | replace: "partner","Partner" | replace: "counsel","Of counsel" | replace: "associate","Associate" }}</span></div><p>{{ y.margin_note }}</p></a></div>{% endfor %}</div></div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 1 · Practice index</p><h2 style="margin-top:8px">What we do, and how much of it we have done</h2><p>Each entry counts the representative matters on file for that practice. Every practice page also lists what we refer out, and how we bill.</p></div><a class="btn line sm" href="{{ PathBase }}/practice">All practice areas</a></div>
<div class="idx">{%- assign gs = "disputes:1 · Disputes,business:2 · Business,people:3 · People and property" | split: "," -%}{% for g in gs %}{%- assign gp = g | split: ":" -%}<div><h3>{{ gp[1] }}</h3>{% for p in prs.Items %}{%- assign x=p.PublishedContent -%}{%- capture gr -%}{{ x.group }}{%- endcapture -%}{% if gr == gp[0] %}{%- assign n=0 -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{% for m in mts.Items %}{%- capture mc -%}{{ m.PublishedContent.code }}{%- endcapture -%}{% if mc == pc %}{%- assign n = n | plus: 1 -%}{% endif %}{% endfor %}<a class="tocrow" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="n">{{ x.num }}</span><b>{{ p.PrimaryField }}</b><span class="ld"></span><span class="c">{{ n }} {% if n == 1 %}matter{% else %}matters{% endif %}</span></a>{% endif %}{% endfor %}</div>{% endfor %}</div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 2 · The docket</p><h2 style="margin-top:8px">Recent representative matters</h2><p>Anonymized, with the forum and how each one ended. The table is built from the matter records.</p></div><a class="btn line sm" href="{{ PathBase }}/matters">Full docket</a></div>
<table class="docket"><thead><tr><th>No.</th><th class="hm">Year</th><th>Matter</th><th class="hm">Forum</th><th>Disposition</th></tr></thead><tbody>{% for m in mts.Items limit:6 %}{%- assign x=m.PublishedContent -%}{%- capture dp -%}{{ x.disposition }}{%- endcapture -%}<tr><td class="m">{{ x.docket }}</td><td class="m hm">{{ x.year }}</td><td><a class="t" href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a><span class="r">{{ x.result }}</span></td><td class="hm" style="font-size:.92rem;color:var(--ink2)">{{ x.forum }}</td><td><span class="stamp {{ dp }}">{% capture dl -%}{{ x.disposition }}{%- endcapture %}{{ dl | replace: "verdict","Verdict" | replace: "settled","Settled" | replace: "dismissed","Dismissed" | replace: "closed","Closed" | replace: "award","Award" | replace: "affirmed","Affirmed" }}</span></td></tr>{% endfor %}</tbody></table><p class="fine">Prior results do not guarantee a similar outcome. All matters, parties and docket numbers are fictional.</p></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 3 · Procedure</p><h2 style="margin-top:8px">How a matter moves, from the first call</h2><p>You are not a client until step three. Nothing you send before then is treated as an engagement.</p></div></div>
<div class="steps">{%- assign ss = "Conflict check^Before you tell us the details, we confirm we do not represent anyone on the other side.~First meeting^An hour with the partner who would run the matter. What happened, what you want, what it may cost.~Engagement letter^Scope, fee model, people, rates and a budget by phase, in writing. Only now are you a client.~Strategy memo^A written plan with the decisions ahead of you and our recommendation for each.~Resolution^Settlement, verdict, closing or signing, then a closing letter and your file." | split: "~" -%}{% for s in ss %}{%- assign sp = s | split: "^" -%}<div class="step{% if forloop.index == 3 %} hi{% endif %}"><h3>{{ sp[0] }}</h3><p>{{ sp[1] }}</p></div>{% endfor %}</div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 4 · Counsel of record</p><h2 style="margin-top:8px">The people who sign the briefs</h2><p>Seven lawyers, all fictional. Each signature block links to a profile with bar admissions, practices and matters.</p></div><a class="btn line sm" href="{{ PathBase }}/attorneys">All attorneys</a></div>
<div class="sigs">{% for a in ats.Items %}{%- assign y=a.PublishedContent -%}<a class="sig" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ y.photo.Value | attachment_redirect_url }}" alt=""><div><span class="rs">Respectfully submitted,</span><div class="sl">/s/ {{ a.PrimaryField }}</div><div class="nm">{{ a.PrimaryField }} · {% capture ps -%}{{ y.position }}{%- endcapture %}{{ ps | replace: "partner","Partner" | replace: "counsel","Of counsel" | replace: "associate","Associate" }}</div><div class="meta">{{ y.bar | split: " · " | first }}<br>{% capture of -%}{{ y.office }}{%- endcapture %}{{ of | replace: "courthouse-row","Courthouse Row office" | replace: "mill-district","Mill District office" }}</div></div></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="doc"><div><p class="sn">§ 5 · Fees, stated plainly</p><h2 style="margin:8px 0 22px">How each practice bills</h2><table class="fees"><thead><tr><th>Practice</th><th>Model</th><th>Detail</th></tr></thead><tbody>{% for p in prs.Items %}{%- assign x=p.PublishedContent -%}{%- capture fm -%}{{ x.fee_model }}{%- endcapture -%}<tr><td><span>{{ x.num }}</span><a href="{{ PathBase }}/{{ p.RoutePath }}" style="color:inherit;text-decoration:none">{{ p.PrimaryField }}</a></td><td><span class="chip {{ fm }}">{% capture fl -%}{{ x.fee_model }}{%- endcapture %}{{ fl | replace: "hourly","Hourly" | replace: "flat","Flat fee" | replace: "contingency","Contingency" | replace: "blended","Blended" }}</span></td><td style="font-size:.94rem;color:var(--ink2)">{{ x.fee_note }}</td></tr>{% endfor %}</tbody></table></div>
<div class="margin"><div class="cmt"><div class="by"><i>BI</i>Bram Ivesmark</div><p>Every engagement letter names the fee model, the people, their rates and a budget by phase. No surprises on the first invoice.</p></div><div class="cmt" style="border-left-color:var(--blue)"><div class="by"><i style="background:var(--blue)">§</i>Note</div><p>There is no intake, payment or contact form on this site, on purpose. <a href="{{ PathBase }}/library/how-we-bill-in-plain-english" style="color:var(--blue);text-decoration:underline">How we bill</a></p></div></div></div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 6 · Insights</p><h2 style="margin-top:8px">Memos to clients and friends of the firm</h2></div><a class="btn line sm" href="{{ PathBase }}/insights">All insights</a></div>
<div class="memos">{% for i in ins.Items %}{%- assign x=i.PublishedContent -%}<a class="memo" href="{{ PathBase }}/{{ i.RoutePath }}"><dl><dt>TO</dt><dd>Clients and friends</dd><dt>FROM</dt><dd>{{ x.author }}</dd><dt>DATE</dt><dd>{{ x.date_label }}</dd><dt>TYPE</dt><dd>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }} · {{ x.minutes }} min</dd></dl><h3>RE: {{ i.PrimaryField }}</h3><p>{{ x.summary }}</p></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w" style="padding-left:96px"><div class="shead"><div><p class="sn">§ 7 · Offices</p><h2 style="margin-top:8px">Two offices, each near the court it uses most</h2></div></div>
<div class="offs">{% for o in offs.Items %}{%- assign y=o.PublishedContent -%}<a class="off" href="{{ PathBase }}/{{ o.RoutePath }}"><h3>{{ o.PrimaryField }}</h3><div class="ct">⟶ {{ y.courthouse }}</div><p style="color:var(--ink2)">{{ y.summary }}</p><div class="kv"><span>Address</span><div>{{ y.address | newline_to_br }}</div><span>Phone</span><div class="mono">{{ y.phone }}</div><span>Hours</span><div>{{ y.hours | replace: "|","<br>" }}</div></div></a>{% endfor %}</div></div></section>
<section class="sec" style="border:0"><div class="w" style="padding-left:96px"><div class="priv"><span class="stamp big">Privileged &amp; confidential</span><div><p class="sn" style="color:#f0b8ab">§ 8 · Client room</p><h2 style="margin-top:8px">Your matter, its deadlines and its budget, behind sign-in.</h2><p>Clients sign in to see where their matter stands, the next deadlines, the budget by phase and the documents their team has shared. In-house counsel get a separate desk with templates and quarterly updates. The check happens on the server, so a locked page is never sent to the browser.</p></div><div style="display:flex;flex-direction:column;gap:10px"><a class="btn" href="{{ PathBase }}/client-room">Open the client room</a><a class="btn line" href="{{ PathBase }}/library">Client library</a></div></div></div></section>
