{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w" style="padding-left:96px"><p class="sn">Search</p><h1>Search the firm's site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="non-compete, lien, appeal, trademark"><button class="btn">Search</button></form></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "practice:Practice areas:title:summary,matters:Representative matters:title:summary,insights:Insights:title:summary,library:Client library:title:summary,attorneys:Attorneys:name:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="sn" style="font-size:13px;margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "clients" or au == "counsel" %} <span class="tag {{ au }}">🔒 {% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }}</span>{% endif %}<p>{{ x.summary | strip_html | truncate: 150 }}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=lien">lien</a>, <a href="?q=appeal">appeal</a>, <a href="?q=non-compete">non-compete</a> or <a href="?q=trademark">trademark</a>.</p>{% endif %}</div></div></section>
