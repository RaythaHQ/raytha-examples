<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Insights</li></ol><p class="sn">§ 4 · Insights</p><h1>Memos, alerts and guides</h1><p class="lede">Written for clients and the people who advise them. General information, not legal advice for your situation.</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="memos">{% for i in Target.Items %}{%- assign x=i.PublishedContent -%}<a class="memo" href="{{ PathBase }}/{{ i.RoutePath }}"><dl><dt>TO</dt><dd>Clients and friends</dd><dt>FROM</dt><dd>{{ x.author }}</dd><dt>DATE</dt><dd>{{ x.date_label }}</dd><dt>TYPE</dt><dd>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }} · {{ x.minutes }} min</dd></dl><h3>RE: {{ i.PrimaryField }}</h3><p>{{ x.summary }}</p></a>{% endfor %}</div></div></section>
