{%- assign x=Target.PublishedContent -%}{%- assign mts = get_content_items(ContentType="matters", OrderBy="sort_order asc", PageSize=50) -%}{%- assign ats = get_content_items(ContentType="attorneys", OrderBy="sort_order asc", PageSize=20) -%}{%- assign ins = get_content_items(ContentType="insights", OrderBy="sort_order asc", PageSize=30) -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{%- capture fm -%}{{ x.fee_model }}{%- endcapture -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/practice">Practice</a></li><li>§ {{ x.num }}</li></ol><p class="sn">§ {{ x.num }} · {% capture gl -%}{{ x.group }}{%- endcapture %}{{ gl | replace: "disputes","Disputes" | replace: "business","Business" | replace: "people","People and property" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div><div class="prose">{{ x.body }}</div>
<h2 style="margin:44px 0 6px">How a matter moves</h2><ol class="clauses">{%- assign st = x.steps | split: "||" -%}{% for s in st %}{%- assign sp = s | split: "::" -%}<li><span class="cn">{{ x.num }}.{{ forloop.index }}</span><div><h3>{{ sp[0] | strip }}</h3><p>{{ sp[1] | strip }}</p></div></li>{% endfor %}</ol></div>
<aside class="margin"><div class="mbox yes"><h4>We handle</h4><ul>{%- assign ls = x.scope | split: "|" -%}{% for l in ls %}<li>{{ l }}</li>{% endfor %}</ul></div><div class="mbox no"><h4>We refer out</h4><ul>{%- assign ls = x.refer | split: "|" -%}{% for l in ls %}<li>{{ l }}</li>{% endfor %}</ul></div><div class="mbox"><h4>Fees</h4><span class="chip {{ fm }}">{% capture fl -%}{{ x.fee_model }}{%- endcapture %}{{ fl | replace: "hourly","Hourly" | replace: "flat","Flat fee" | replace: "contingency","Contingency" | replace: "blended","Blended" }}</span><p style="font-size:.94rem;color:var(--ink2);margin-top:6px">{{ x.fee_note }}</p></div></aside></div></div></section>
<section class="sec tight"><div class="w" style="padding-left:96px"><p class="sn">Counsel for this practice</p><div class="sigs" style="margin-top:22px">{% for a in ats.Items %}{%- assign y=a.PublishedContent -%}{%- assign ap = y.practices | split: "|" -%}{% if ap contains pc %}<a class="sig" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ y.photo.Value | attachment_redirect_url }}" alt=""><div><span class="rs">Respectfully submitted,</span><div class="sl">/s/ {{ a.PrimaryField }}</div><div class="nm">{{ a.PrimaryField }} · {% capture ps -%}{{ y.position }}{%- endcapture %}{{ ps | replace: "partner","Partner" | replace: "counsel","Of counsel" | replace: "associate","Associate" }}</div><div class="meta">{{ y.bar | split: " · " | first }}<br>{% capture of -%}{{ y.office }}{%- endcapture %}{{ of | replace: "courthouse-row","Courthouse Row office" | replace: "mill-district","Mill District office" }}</div></div></a>{% endif %}{% endfor %}</div></div></section>
<section class="sec tight"><div class="w" style="padding-left:96px"><p class="sn" style="margin-bottom:18px">On the docket</p><table class="docket"><thead><tr><th>No.</th><th class="hm">Year</th><th>Matter</th><th class="hm">Forum</th><th>Disposition</th></tr></thead><tbody>{% for m in mts.Items %}{%- assign z=m.PublishedContent -%}{%- capture mc -%}{{ z.code }}{%- endcapture -%}{%- capture dp -%}{{ z.disposition }}{%- endcapture -%}{% if mc == pc %}<tr><td class="m">{{ z.docket }}</td><td class="m hm">{{ z.year }}</td><td><a class="t" href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a><span class="r">{{ z.result }}</span></td><td class="hm" style="font-size:.92rem;color:var(--ink2)">{{ z.forum }}</td><td><span class="stamp {{ dp }}">{% capture dl -%}{{ z.disposition }}{%- endcapture %}{{ dl | replace: "verdict","Verdict" | replace: "settled","Settled" | replace: "dismissed","Dismissed" | replace: "closed","Closed" | replace: "award","Award" | replace: "affirmed","Affirmed" }}</span></td></tr>{% endif %}{% endfor %}</tbody></table><p class="fine">Prior results do not guarantee a similar outcome.</p>
{%- assign hasi=false -%}{% for i in ins.Items %}{%- capture ic -%}{{ i.PublishedContent.code }}{%- endcapture -%}{% if ic == pc %}{%- assign hasi=true -%}{% endif %}{% endfor %}{% if hasi %}<p class="sn" style="margin:44px 0 18px">Related insights</p><div class="memos">{% for i in ins.Items %}{%- assign z=i.PublishedContent -%}{%- capture ic -%}{{ z.code }}{%- endcapture -%}{% if ic == pc %}<a class="memo" href="{{ PathBase }}/{{ i.RoutePath }}"><dl><dt>FROM</dt><dd>{{ z.author }}</dd><dt>DATE</dt><dd>{{ z.date_label }}</dd></dl><h3>RE: {{ i.PrimaryField }}</h3><p>{{ z.summary }}</p></a>{% endif %}{% endfor %}</div>{% endif %}</div></section>
