{%- assign x=Target.PublishedContent -%}{%- assign prs = get_content_items(ContentType="practice", OrderBy="sort_order asc", PageSize=30) -%}{%- assign ats = get_content_items(ContentType="attorneys", OrderBy="sort_order asc", PageSize=20) -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/insights">Insights</a></li><li>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</li></ol><p class="sn">Memorandum · {% capture kl2 -%}{{ x.kind }}{%- endcapture %}{{ kl2 | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</p>
<dl style="display:grid;grid-template-columns:80px 1fr;gap:6px 10px;font:500 14px/1.5 var(--mono);margin:18px 0 0;max-width:720px"><dt class="muted">TO</dt><dd style="margin:0">Clients and friends of the firm</dd><dt class="muted">FROM</dt><dd style="margin:0">{%- capture au -%}{{ x.author }}{%- endcapture -%}{% for a in ats.Items %}{% if a.PrimaryField == au %}<a href="{{ PathBase }}/{{ a.RoutePath }}">{{ au }}</a>{% endif %}{% endfor %}</dd><dt class="muted">DATE</dt><dd style="margin:0">{{ x.date_label }}</dd></dl><h1 style="margin-top:4px">{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div class="prose">{{ x.body }}<p class="fine">General information about a fictional jurisdiction, not legal advice.</p></div><aside class="margin"><div class="mbox"><h4>Practice</h4>{% for p in prs.Items %}{%- capture c -%}{{ p.PublishedContent.code }}{%- endcapture -%}{% if c == pc %}<a class="chip" href="{{ PathBase }}/{{ p.RoutePath }}">§ {{ p.PublishedContent.num }} {{ p.PrimaryField }}</a>{% endif %}{% endfor %}</div><div class="mbox"><h4>Reading time</h4><p class="mono">{{ x.minutes }} minutes</p></div><a class="btn line sm" href="{{ PathBase }}/insights">All insights</a></aside></div></div></section>
