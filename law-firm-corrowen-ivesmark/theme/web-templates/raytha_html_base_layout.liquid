<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Corrowen & Ivesmark LLP" %}{{ Target.Title }} | {% endif %}Corrowen &amp; Ivesmark LLP — litigation and business law, Wendlow</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Corrowen &amp; Ivesmark LLP (fictional) is a seven-lawyer litigation and business law firm in Wendlow. A law firm website built on Raytha, a self-hosted, open-source .NET CMS for law firms, with a members-only client room.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..600&display=swap" rel="stylesheet"><style>
:root{--paper:#fbfaf6;--paper2:#f3f1e9;--ink:#15181d;--ink2:#3c434f;--mute:#6b7280;--rule:#dcd8cc;--red:#c2321f;--redsoft:#fbe9e5;--blue:#1f3f86;--bluesoft:#e8edf8;--rail:272px;
--serif:"Source Serif 4",Georgia,serif;--sans:"IBM Plex Sans",system-ui,sans-serif;--mono:"IBM Plex Mono",ui-monospace,monospace}
*{box-sizing:border-box}
body{margin:0;overflow-x:hidden;background:var(--paper) linear-gradient(90deg,var(--ink) 0 var(--rail),var(--paper) var(--rail)) no-repeat;color:var(--ink);font:400 17px/1.62 var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--blue)}a:hover{color:var(--red)}
img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:var(--serif);font-weight:600;line-height:1.15;letter-spacing:-.01em;margin:0}
h1{font-size:clamp(2.2rem,4.2vw,3.5rem)}h2{font-size:clamp(1.55rem,2.4vw,2.1rem)}h3{font-size:1.2rem}
p{margin:0 0 1em}
.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:9}
.mono{font-family:var(--mono)}.muted{color:var(--mute)}
.sn{font:500 12.5px/1 var(--mono);letter-spacing:.08em;color:var(--red);text-transform:uppercase}
/* rail */
.rail{position:fixed;inset:0 auto 0 0;width:var(--rail);background:var(--ink);color:#d9dbe0;display:flex;flex-direction:column;padding:28px 24px 22px;z-index:5;overflow:auto}
.rail .mark{color:#fff;text-decoration:none;display:block;padding-bottom:22px;border-bottom:1px solid #2b313b}
.rail .mark b{display:block;font:600 1.42rem/1.12 var(--serif);letter-spacing:-.01em}
.rail .mark b i{font-style:italic;color:#f0b8ab;font-weight:500}
.rail .mark small{display:block;margin-top:8px;font:500 11px/1.4 var(--mono);letter-spacing:.12em;color:#8b919c;text-transform:uppercase}
.toc{list-style:none;margin:22px 0 0;padding:0;counter-reset:s}
.toc li{counter-increment:s}
.toc a{display:flex;gap:12px;align-items:baseline;color:#d9dbe0;text-decoration:none;padding:7px 0;font:500 15.5px/1.3 var(--sans);border-bottom:1px dotted #2b313b}
.toc a:before{content:"§ " counter(s);font:500 11.5px var(--mono);color:#8b919c;min-width:30px}
.toc a:hover{color:#fff}.toc a:hover:before{color:#f0b8ab}
.rail .room{margin-top:22px;display:block;border:1px solid #f0b8ab;color:#fff;text-decoration:none;padding:12px 14px;font:600 14.5px/1.3 var(--sans)}
.rail .room small{display:block;font:500 11px/1.5 var(--mono);color:#f0b8ab;letter-spacing:.08em;text-transform:uppercase;margin-bottom:3px}
.rail .room:hover{background:#2b313b;color:#fff}
.rail .acct{margin-top:14px;font:500 13px var(--sans);color:#8b919c}.rail .acct a{color:#d9dbe0}.mroom{display:none;margin-left:12px}
.rail .rfoot{margin-top:auto;padding-top:24px;font:400 11.5px/1.5 var(--mono);color:#7d838e}
.rail .rsearch{margin-top:18px;display:flex}.rail .rsearch input{flex:1;min-width:0;background:#20252d;border:1px solid #2f3540;color:#fff;padding:8px 10px;font:14px var(--sans)}
.page{margin-left:var(--rail);min-height:100vh;display:flex;flex-direction:column}
.notice{background:var(--paper2);border-bottom:1px solid var(--rule);font:500 12.5px/1.45 var(--mono);color:var(--ink2);padding:9px 0}
.notice .w{display:flex;gap:14px;justify-content:space-between;flex-wrap:wrap}
.notice b{color:var(--red);letter-spacing:.1em;margin-right:8px}
.w{max-width:1180px;margin:0 auto;padding:0 48px}
main{flex:1}
/* doc grid: text + margin */
.doc{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:56px}
.margin{border-left:1px solid var(--rule);padding-left:22px}
.sec{padding:76px 0;border-bottom:1px solid var(--rule)}.sec.tight{padding:48px 0}
.shead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px;flex-wrap:wrap}
.shead p{margin:10px 0 0;max-width:640px;color:var(--ink2)}
.btn{display:inline-flex;gap:8px;align-items:center;background:var(--ink);color:#fff!important;text-decoration:none;font:600 15px/1 var(--sans);padding:14px 20px;border:1.5px solid var(--ink)}
.btn:hover{background:var(--red);border-color:var(--red)}
.btn.line{background:transparent;color:var(--ink)!important}.btn.line:hover{background:var(--ink);color:#fff!important}
.btn.sm{padding:9px 14px;font-size:14px}
del{color:var(--red);text-decoration-thickness:2px;text-decoration-color:var(--red)}
ins{color:var(--blue);text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:6px;text-decoration-color:var(--blue)}
/* hero */
.hero{padding:44px 0 70px;border-bottom:1px solid var(--rule);background:linear-gradient(90deg,transparent 0 63px,#f2c9c1 63px 65px,transparent 65px)}
.dline{display:flex;justify-content:space-between;font:500 12px var(--mono);letter-spacing:.12em;color:var(--mute);text-transform:uppercase;border-bottom:1px solid var(--ink);padding-bottom:10px;margin-bottom:46px}
.hero h1{font-size:clamp(2.4rem,4.6vw,4rem);font-weight:600;max-width:15em}
.hero h1 ins,.hero h1 del{font-weight:600}
.lede{font:400 1.22rem/1.6 var(--serif);color:var(--ink2);max-width:40em;margin-top:26px}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.cmt{position:relative;background:#fff;border:1px solid var(--rule);border-left:3px solid var(--red);padding:14px 16px 14px 16px;margin-bottom:16px;font-size:.95rem;box-shadow:0 1px 0 var(--rule)}
.cmt:before{content:"";position:absolute;left:-26px;top:22px;width:23px;border-top:1.5px dashed var(--red)}
.cmt .by{display:flex;align-items:center;gap:9px;margin-bottom:6px;font:600 13.5px var(--sans)}
.cmt .by i{font:600 11.5px/26px var(--mono);font-style:normal;width:26px;height:26px;text-align:center;background:var(--red);color:#fff;border-radius:50%}
.cmt .by span{font:400 11.5px var(--mono);color:var(--mute);margin-left:auto}
.cmt p{margin:0;color:var(--ink2)}
.cmt a{text-decoration:none;color:inherit}
/* practice index */
.idx{display:grid;grid-template-columns:1fr;gap:34px;max-width:920px}
.idx h3{font:600 12.5px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--red);padding-bottom:10px;border-bottom:2px solid var(--ink);margin-bottom:6px}
.tocrow{display:flex;align-items:baseline;gap:10px;padding:11px 0;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--rule)}
.tocrow .n{font:500 13px var(--mono);color:var(--mute);min-width:30px}
.tocrow b{font:600 1.08rem/1.25 var(--serif)}
.tocrow .ld{flex:1;border-bottom:2px dotted #b9b4a6;transform:translateY(-4px);min-width:20px}
.tocrow .c{font:500 12.5px var(--mono);color:var(--ink2);white-space:nowrap}
.tocrow:hover b{color:var(--blue)}
/* docket */
.docket{width:100%;border-collapse:collapse;font-size:15px;background:#fff;border:1px solid var(--ink)}
.docket th{font:600 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;text-align:left;padding:12px 14px;background:var(--ink);color:#fff}
.docket td{padding:16px 14px;border-top:1px solid var(--rule);vertical-align:top}
.docket td.m{font:500 13px var(--mono);color:var(--ink2);white-space:nowrap}
.docket a.t{font:600 1.05rem/1.3 var(--serif);color:var(--ink);text-decoration:none}.docket a.t:hover{color:var(--blue)}
.docket .r{display:block;color:var(--ink2);font-size:.92rem;margin-top:3px}
.docket tr:hover td{background:#fdfcf8}
.stamp{display:inline-block;font:700 11.5px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--red);border:2px solid var(--red);padding:6px 8px;transform:rotate(-4deg);white-space:nowrap;background:rgba(255,255,255,.6)}
.stamp.settled,.stamp.closed{color:var(--blue);border-color:var(--blue)}
.stamp.big{font-size:15px;padding:10px 14px;border-width:3px}
.fine{font:400 12.5px/1.5 var(--mono);color:var(--mute);margin-top:12px}
/* steps */
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;border-top:2px solid var(--ink);counter-reset:st}
.step{padding:22px 20px 0 0;position:relative}
.step:before{counter-increment:st;content:counter(st);position:absolute;top:-15px;left:0;width:28px;height:28px;border-radius:50%;background:var(--paper);border:2px solid var(--ink);font:600 13px/24px var(--mono);text-align:center}
.step h3{margin:6px 0 6px;font-size:1.1rem}.step p{color:var(--ink2);font-size:.95rem;margin:0}
.step.hi:before{background:var(--red);border-color:var(--red);color:#fff}
/* signature blocks */
.sigs{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:34px 40px}
.sig{display:grid;grid-template-columns:78px 1fr;gap:16px;text-decoration:none;color:var(--ink);align-items:start}
.sig img{width:78px;height:78px;object-fit:cover;border:1px solid var(--rule)}
.sig .rs{font:italic 400 .9rem var(--serif);color:var(--mute)}
.sig .sl{font:italic 500 1.35rem/1 var(--serif);color:var(--blue);border-bottom:1.5px solid var(--ink);padding:10px 0 6px;margin-bottom:6px}
.sig .nm{font:600 15px var(--sans)}.sig .meta{font:400 12.5px/1.5 var(--mono);color:var(--ink2)}
.sig:hover .sl{color:var(--red)}
/* fees */
.fees{width:100%;border-collapse:collapse}
.fees td,.fees th{padding:13px 12px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}
.fees th{font:600 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--mute);border-bottom:2px solid var(--ink)}
.fees td:first-child{font:600 1.02rem var(--serif)}.fees td:first-child span{font:500 12px var(--mono);color:var(--mute);margin-right:10px}
.chip{display:inline-block;font:600 11.5px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:6px 9px;border:1px solid currentColor;color:var(--ink2);white-space:nowrap;text-decoration:none;margin:0 6px 6px 0}
.chip.hourly{color:var(--ink)}.chip.flat{color:var(--blue)}.chip.contingency{color:var(--red)}.chip.blended{color:#6a4b9b}
.margin .chip{white-space:normal;line-height:1.35}a.chip:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
/* memos */
.memos{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.memo{background:#fff;border:1px solid var(--rule);padding:22px 24px 24px;text-decoration:none;color:var(--ink);display:block;position:relative}
.memo:after{content:"";position:absolute;right:-1px;top:-1px;border-width:0 22px 22px 0;border-style:solid;border-color:var(--paper) var(--paper) var(--rule) var(--rule)}
.memo dl{display:grid;grid-template-columns:54px 1fr;gap:4px 8px;margin:0 0 14px;font:500 12.5px/1.45 var(--mono)}
.memo dt{color:var(--mute)}.memo dd{margin:0}
.memo h3{font-size:1.15rem;padding-top:14px;border-top:2px solid var(--ink);margin-bottom:8px}
.memo p{color:var(--ink2);font-size:.95rem;margin:0}
.memo:hover h3{color:var(--blue)}
/* offices */
.offs{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.off{border:1px solid var(--ink);background:#fff;padding:26px;text-decoration:none;color:var(--ink);display:block}
.off h3{font-size:1.4rem;margin-bottom:6px}.off .ct{font:500 12.5px var(--mono);color:var(--red);margin-bottom:14px}
.off .kv{display:grid;grid-template-columns:90px 1fr;gap:6px;font-size:.95rem}.off .kv span{font:500 12px var(--mono);color:var(--mute);text-transform:uppercase;padding-top:3px}
/* room cta */
.priv{background:var(--ink);color:#e6e7ea;padding:46px;position:relative;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}
.priv h2{color:#fff}.priv p{color:#b9bdc6;max-width:640px;margin:12px 0 0}
.priv .stamp{position:absolute;right:40px;top:-18px;background:var(--paper);transform:rotate(3deg)}
.priv .btn{background:#fff;color:var(--ink)!important;border-color:#fff}.priv .btn.line{background:transparent;color:#fff!important;border-color:#5b616c}.priv .btn:hover{background:var(--red);color:#fff!important;border-color:var(--red)}
/* page head */
.phead{padding:40px 0 44px;border-bottom:1px solid var(--rule);background:linear-gradient(90deg,transparent 0 63px,#f2c9c1 63px 65px,transparent 65px)}
.crumbs{list-style:none;display:flex;gap:8px;padding:0;margin:0 0 30px;font:500 12.5px var(--mono);color:var(--mute);flex-wrap:wrap}
.crumbs li+li:before{content:"/";margin-right:8px;color:var(--rule)}.crumbs a{color:var(--ink2);text-decoration:none}
.phead h1{max-width:18em;margin-top:10px}.phead .lede{margin-top:16px}
/* prose */
.prose{font:400 1.08rem/1.72 var(--serif);color:#22262d;max-width:42em}
.prose h2{font-size:1.5rem;margin:1.6em 0 .5em}.prose h2:first-child{margin-top:0}
.prose ul,.prose ol{padding-left:1.3em}.prose li{margin:.3em 0}
.prose table{border-collapse:collapse;width:100%;font:15px/1.5 var(--sans);margin:1em 0}.prose th,.prose td{border:1px solid var(--rule);padding:9px 11px;text-align:left}.prose th{background:var(--paper2)}
.mbox{margin-bottom:26px}.mbox h4{font:600 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--mute);margin-bottom:10px}
.mbox ul{margin:0;padding:0;list-style:none;font-size:.95rem}.mbox li{padding:6px 0;border-bottom:1px dotted var(--rule)}
.mbox.no li{color:var(--ink2)}.mbox.no li:before{content:"✕ ";color:var(--red);font-weight:700}
.mbox.yes li:before{content:"§ ";color:var(--blue);font-family:var(--mono);font-size:12px}
.clauses{counter-reset:none;margin:0;padding:0;list-style:none}
.clauses li{display:grid;grid-template-columns:70px 1fr;gap:18px;padding:20px 0;border-top:1px solid var(--rule)}
.clauses .cn{font:600 14px var(--mono);color:var(--red);padding-top:3px}
.clauses h3{margin-bottom:6px}.clauses p{margin:0;color:var(--ink2)}
.figs{display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--ink)}
.figs div{padding:22px 18px 0 0}.figs b{display:block;font:600 2.4rem/1 var(--serif)}.figs span{font:500 12.5px/1.4 var(--mono);color:var(--ink2)}
/* caption (matter detail) */
.caption{display:grid;grid-template-columns:1fr 30px 1fr;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);margin:10px 0 30px;font:400 1.05rem/1.5 var(--serif)}
.caption .ct{grid-column:1/-1;text-align:center;font:600 13px var(--mono);letter-spacing:.14em;text-transform:uppercase;padding:14px 0;border-bottom:1px solid var(--rule)}
.caption .pl{padding:20px 0}.caption .pr{font-family:var(--mono);color:var(--mute);padding:20px 0;line-height:1.5;white-space:pre}
.caption .no{padding:20px 0 20px 20px;font:500 14px/1.7 var(--mono)}
/* lists */
.rowlist a.row{display:grid;grid-template-columns:120px 1fr auto;gap:22px;padding:20px 0;border-top:1px solid var(--rule);text-decoration:none;color:var(--ink);align-items:start}
.rowlist a.row:hover b{color:var(--blue)}.rowlist b{font:600 1.15rem/1.3 var(--serif)}.rowlist p{margin:4px 0 0;color:var(--ink2);font-size:.96rem}
.rowlist .k{font:500 12px var(--mono);text-transform:uppercase;letter-spacing:.08em;color:var(--mute);padding-top:4px}
.tag{display:inline-block;font:600 11.5px/1 var(--mono);letter-spacing:.06em;padding:6px 9px;background:var(--paper2);color:var(--ink2);white-space:nowrap}
.tag.clients{background:var(--bluesoft);color:var(--blue)}.tag.counsel{background:var(--redsoft);color:var(--red)}.tag.ok{background:#e4f0e6;color:#225c32}
.lock{border:2px dashed var(--red);background:#fff;padding:30px}
.lock h2{margin:12px 0 10px}
/* client room */
.room-top{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.track{display:grid;grid-template-columns:repeat(4,1fr);margin:18px 0 8px}
.track div{border-top:6px solid var(--rule);padding-top:10px;font-size:.92rem;color:var(--mute)}
.track div b{display:block;font:600 1rem var(--serif);color:var(--ink)}
.track .done{border-color:var(--ink)}.track .now{border-color:var(--red)}.track .now b{color:var(--red)}
.panel{background:#fff;border:1px solid var(--rule);padding:24px;margin-bottom:24px}
.panel h3{font-size:1.15rem;margin-bottom:12px}
.dl{width:100%;border-collapse:collapse;font-size:.95rem}.dl td{padding:9px 0;border-bottom:1px dotted var(--rule)}.dl td:first-child{font:500 13px var(--mono);width:120px;color:var(--ink2)}
.bud div{margin:0 0 12px}.bud span{display:flex;justify-content:space-between;font:500 12.5px var(--mono);color:var(--ink2);margin-bottom:5px}
.bud i{display:block;height:9px;background:var(--paper2);position:relative}.bud i u{position:absolute;inset:0 auto 0 0;background:var(--ink)}
.bud i u.hot{background:var(--red)}
.searchbar{display:flex;gap:10px;margin-top:22px;max-width:640px}.searchbar input{flex:1;padding:13px 14px;border:1.5px solid var(--ink);font:16px var(--sans);background:#fff}
.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.hit b{font:600 1.08rem var(--serif)}.hit p{margin:3px 0 0;color:var(--ink2);font-size:.95rem}
label{display:block;font:600 13px var(--mono);letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
input[type=email],input[type=password]{width:100%;padding:13px 14px;border:1.5px solid var(--ink);font:16px var(--sans);background:#fff}
footer.foot{background:var(--paper2);border-top:2px solid var(--ink);padding:40px 0 30px;font-size:.92rem;color:var(--ink2)}
.fgrid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:40px}
.foot h5{font:600 11.5px var(--mono);letter-spacing:.1em;text-transform:uppercase;margin:0 0 10px;color:var(--ink)}
.foot ul{list-style:none;margin:0;padding:0}.foot li{padding:3px 0}.foot a{color:var(--ink2)}
.foot .disc{font:400 12.5px/1.6 var(--mono);border-top:1px solid var(--rule);margin-top:28px;padding-top:16px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
@media(max-width:1100px){.doc{grid-template-columns:1fr}.margin{border-left:0;padding-left:0;border-top:1px solid var(--rule);padding-top:22px}.cmt:before{display:none}.memos{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr 1fr;row-gap:36px}}
@media(max-width:860px){:root{--rail:0px}.rail{position:static;width:auto;padding:16px 20px}.rail .mark{padding-bottom:12px}.toc{display:flex;overflow-x:auto;gap:18px;margin-top:10px}.toc a{border:0;white-space:nowrap;padding:6px 0}.rail .room,.rail .rfoot,.rail .rsearch{display:none}.rail .acct{margin-top:6px}
.w{padding:0 20px!important}.dline span+span{display:none}.hero h1{font-size:2.3rem}.mroom{display:inline!important}body{background:var(--paper)}.hero,.phead{background:none}.idx,.memos,.offs,.fgrid,.figs{grid-template-columns:1fr}.steps{grid-template-columns:1fr 1fr}.priv{grid-template-columns:1fr;padding:30px 24px}.docket .hm{display:none}.rowlist a.row{grid-template-columns:1fr}.caption{grid-template-columns:1fr}.caption .pr{display:none}.track{grid-template-columns:1fr 1fr;gap:10px}.sec{padding:52px 0}.clauses li{grid-template-columns:1fr;gap:4px}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<aside class="rail"><a class="mark" href="{{ PathBase }}/"><b>Corrowen <i>&amp;</i> Ivesmark</b><small>LLP · Wendlow · est. 2004</small></a>
<nav aria-label="Main"><ol class="toc">{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ol></nav>
