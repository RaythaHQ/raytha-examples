{%- assign in_cli=false -%}{%- assign in_cou=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cli=true -%}{%- endif -%}{%- if g == "counsel" -%}{%- assign in_cou=true -%}{%- assign in_cli=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cli=true -%}{%- assign in_cou=true -%}{%- endif -%}<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Client library</li></ol><p class="sn">Client library</p><h1>Guides, checklists and templates</h1><p class="lede">Some are for everyone. Documents marked Clients or In-house counsel open after you sign in with an account in that group; the rest of the page is public so you can see what exists.</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="rowlist" style="max-width:1000px">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cli == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "counsel" and in_cou == false -%}{%- assign ok=false -%}{%- endif -%}<a class="row" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="k">{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary }}</p></div><span class="tag {{ au }}{% if au != "public" and ok %} ok{% endif %}">{% if au != "public" %}{% if ok %}✓ {% else %}🔒 {% endif %}{% endif %}{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }}</span></a>{% endfor %}</div></div></section>
