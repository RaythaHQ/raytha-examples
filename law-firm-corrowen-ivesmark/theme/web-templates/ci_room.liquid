{%- assign in_cli=false -%}{%- assign in_cou=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cli=true -%}{%- endif -%}{%- if g == "counsel" -%}{%- assign in_cou=true -%}{%- assign in_cli=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cli=true -%}{%- assign in_cou=true -%}{%- endif -%}{%- assign lib = get_content_items(ContentType="library", OrderBy="sort_order asc", PageSize=40) -%}{%- assign cl = get_content_items(ContentType="practice", Filter="code eq 'cl'", PageSize=1) -%}{%- assign clp = cl.Items | first -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Client room</li></ol><p class="sn">Privileged &amp; confidential · members only</p><h1>{% if CurrentUser.IsAuthenticated %}{{ CurrentUser.FirstName }}'s client room{% else %}Client room{% endif %}</h1><p class="lede">Where your matter stands, the next deadlines, the budget by phase and the documents your team has shared. In-house counsel also get a counsel desk.</p>{% if CurrentUser.IsAuthenticated %}<div class="room-top"><span class="tag {% if in_cli %}ok{% endif %}">{% if in_cli %}✓{% else %}✕{% endif %} Clients</span><span class="tag {% if in_cou %}ok{% endif %}">{% if in_cou %}✓{% else %}✕{% endif %} In-house counsel</span></div>{% endif %}</div></div>
<section class="sec tight"><div class="w" style="padding-left:96px">{% unless CurrentUser.IsAuthenticated %}<div class="lock" style="max-width:860px"><span class="stamp">Sign in required</span><h2>The client room is for clients of the firm.</h2><p>Your matter team sets up your account when the engagement letter is signed, so there is no sign-up form. Once signed in you see your matter status, deadlines, budget by phase and shared documents; in-house counsel also see templates and quarterly updates.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/client-room">Sign in</a><a class="btn line" href="{{ PathBase }}/library">Public library</a></p></div>
<ol class="clauses" style="max-width:860px;margin-top:34px"><li><span class="cn">R.1</span><div><h3>Matter status</h3><p>The phase your matter is in, drawn from the practice's own steps.</p></div></li><li><span class="cn">R.2</span><div><h3>Deadlines and budget</h3><p>The next dates that matter, and the budget by phase against time billed.</p></div></li><li><span class="cn">R.3</span><div><h3>Counsel desk</h3><p>Templates with commentary and quarterly updates, for in-house counsel accounts.</p></div></li></ol>
{% else %}{% if in_cli %}<div class="doc"><div>
<div class="panel"><p class="sn">Matter 26-0582 · story data</p><h3 style="font-size:1.5rem;margin-top:8px">Supply agreement dispute: Tamsin Feed &amp; Seed v. Orlick Packaging</h3><p class="muted" style="margin:0">Wendlow County Circuit Court (fictional) · {{ clp.PrimaryField }} · responsible partner Helena Corrowen</p>
<div class="track">{%- assign st = clp.PublishedContent.steps | split: "||" -%}{% for s in st %}{%- assign sp = s | split: "::" -%}<div class="{% if forloop.index < 3 %}done{% elsif forloop.index == 3 %}now{% endif %}"><b>{{ forloop.index }}. {{ sp[0] | strip }}</b>{% if forloop.index < 3 %}Done{% elsif forloop.index == 3 %}Current phase{% else %}Ahead{% endif %}</div>{% endfor %}</div></div>
<div class="panel"><h3>Next deadlines</h3><table class="dl"><tr><td>Nov 04, 2026</td><td>Document production due (second set)</td></tr><tr><td>Nov 18, 2026</td><td>Deposition of the plant manager · prep session Nov 12</td></tr><tr><td>Dec 02, 2026</td><td>Mediation statement due to the mediator</td></tr><tr><td>Jan 12, 2027</td><td>Mediation, full day · Courthouse Row office</td></tr></table></div>
<div class="panel"><h3>Shared with you</h3><div class="rowlist">{% for r in lib.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cli == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "counsel" and in_cou == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "clients" and ok %}<a class="row" style="grid-template-columns:110px 1fr" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="k">{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary | truncate: 110 }}</p></div></a>{% endif %}{% endfor %}</div></div>
{% if in_cou %}<div class="panel" style="border:2px solid var(--red)"><p class="sn">Counsel desk</p><h3 style="margin-top:6px">Templates and quarterly updates for in-house counsel</h3><div class="rowlist">{% for r in lib.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cli == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "counsel" and in_cou == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "counsel" and ok %}<a class="row" style="grid-template-columns:110px 1fr" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="k">{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary | truncate: 110 }}</p></div></a>{% endif %}{% endfor %}</div><p class="mono muted" style="font-size:12.5px;margin:12px 0 0">Next quarterly briefing (story): Jan 21, 2027 · Mill District office</p></div>{% else %}<div class="lock" style="padding:20px"><b>No counsel desk on this account.</b> Templates and quarterly updates appear for in-house counsel accounts.</div>{% endif %}
</div><aside class="margin"><div class="mbox"><h4>Budget by phase (story)</h4><div class="bud"><div><span><b>Assess</b>&#36;8,400 of &#36;9,000</span><i><u class="" style="width:93%"></u></i></div><div><span><b>Plead</b>&#36;14,100 of &#36;15,000</span><i><u class="" style="width:94%"></u></i></div><div><span><b>Discover</b>&#36;22,300 of &#36;48,000</span><i><u class="hot" style="width:46%"></u></i></div><div><span><b>Resolve</b>&#36;0 of &#36;30,000</span><i><u class="" style="width:0%"></u></i></div></div></div><div class="mbox"><h4>Your team</h4><ul><li><b>Helena Corrowen</b> · responsible partner</li><li><b>Marguerite Osei</b> · associate</li><li class="mono" style="font-size:13px">(555) 019-4100</li></ul></div><div class="mbox"><h4>Invoices</h4><p style="font-size:.94rem;color:var(--ink2)">Sent monthly by email. There is no payment form on this site, on purpose.</p></div><a class="btn line sm" href="{{ PathBase }}/account/logout">Sign out</a></aside></div>
{% else %}<div class="lock"><h2>Your account is not set up as a client yet.</h2><p>Your matter team adds your account to the clients group when the engagement letter is signed.</p></div>{% endif %}{% endunless %}</div></section>
