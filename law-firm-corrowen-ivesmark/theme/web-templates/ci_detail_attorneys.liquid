{%- assign y=Target.PublishedContent -%}{%- assign prs = get_content_items(ContentType="practice", OrderBy="sort_order asc", PageSize=30) -%}{%- assign mts = get_content_items(ContentType="matters", OrderBy="sort_order asc", PageSize=50) -%}{%- assign ap = y.practices | split: "|" -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/attorneys">Attorneys</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="sn">{% capture ps -%}{{ y.position }}{%- endcapture %}{{ ps | replace: "partner","Partner" | replace: "counsel","Of counsel" | replace: "associate","Associate" }} · {% capture of -%}{{ y.office }}{%- endcapture %}{{ of | replace: "courthouse-row","Courthouse Row office" | replace: "mill-district","Mill District office" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div><div style="display:grid;grid-template-columns:200px 1fr;gap:30px;align-items:start"><img src="{{ y.photo.Value | attachment_redirect_url }}" alt="Generated monogram portrait for {{ Target.PrimaryField }}" style="border:1px solid var(--rule)"><table class="dl"><tr><td>Bar</td><td>{{ y.bar }}</td></tr><tr><td>Education</td><td>{{ y.education }}</td></tr><tr><td>Office</td><td>{% capture of -%}{{ y.office }}{%- endcapture %}{{ of | replace: "courthouse-row","Courthouse Row office" | replace: "mill-district","Mill District office" }}</td></tr><tr><td>Languages</td><td>{{ y.languages }}</td></tr><tr><td>Practices</td><td>{% for p in prs.Items %}{%- capture pc -%}{{ p.PublishedContent.code }}{%- endcapture -%}{% if ap contains pc %}<a class="chip" href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a>{% endif %}{% endfor %}</td></tr></table></div>
<div class="prose" style="margin-top:34px">{{ y.body }}</div></div>
<aside class="margin"><div class="cmt"><div class="by"><i>{{ y.initials }}</i>{{ Target.PrimaryField }}</div><p>{{ y.margin_note }}</p></div><div class="sig" style="grid-template-columns:1fr;margin-top:26px"><div><span class="rs">Respectfully submitted,</span><div class="sl">/s/ {{ Target.PrimaryField }}</div><div class="meta">{{ y.bar }}</div></div></div></aside></div></div></section>
<section class="sec tight"><div class="w" style="padding-left:96px"><p class="sn" style="margin-bottom:18px">Matters with {{ Target.PrimaryField }} on the team</p><table class="docket"><thead><tr><th>No.</th><th class="hm">Year</th><th>Matter</th><th class="hm">Forum</th><th>Disposition</th></tr></thead><tbody>{% for m in mts.Items %}{%- assign z=m.PublishedContent -%}{%- capture mc -%}{{ z.code }}{%- endcapture -%}{%- capture dp -%}{{ z.disposition }}{%- endcapture -%}{%- assign tm = z.team | split: "|" -%}{% if tm contains Target.PrimaryField %}<tr><td class="m">{{ z.docket }}</td><td class="m hm">{{ z.year }}</td><td><a class="t" href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a><span class="r">{{ z.result }}</span></td><td class="hm" style="font-size:.92rem;color:var(--ink2)">{{ z.forum }}</td><td><span class="stamp {{ dp }}">{% capture dl -%}{{ z.disposition }}{%- endcapture %}{{ dl | replace: "verdict","Verdict" | replace: "settled","Settled" | replace: "dismissed","Dismissed" | replace: "closed","Closed" | replace: "award","Award" | replace: "affirmed","Affirmed" }}</span></td></tr>{% endif %}{% endfor %}</tbody></table></div></section>
