{%- assign in_cli=false -%}{%- assign in_cou=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_cli=true -%}{%- endif -%}{%- if g == "counsel" -%}{%- assign in_cou=true -%}{%- assign in_cli=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cli=true -%}{%- assign in_cou=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_cli == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "counsel" and in_cou == false -%}{%- assign ok=false -%}{%- endif -%}
<div class="phead"><div class="w" style="padding-left:96px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/library">Client library</a></li><li>{% capture kl -%}{{ x.kind }}{%- endcapture %}{{ kl | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</li></ol><p class="sn">{% if au != "public" %}Privileged · {% endif %}{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }} · updated {{ x.updated_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w" style="padding-left:96px"><div class="doc"><div>{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}<div class="lock"><span class="stamp">{% capture al2 -%}{{ x.audience }}{%- endcapture %}{{ al2 | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }} only</span><h2>This document is in the client room.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but your account does not include {% capture al3 -%}{{ x.audience }}{%- endcapture %}{{ al3 | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }} documents.{% else %}Sign in with the account your matter team set up to read it.{% endif %} The body of this page is not sent to the browser unless your account is in the right group.</p><p class="cta">{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a>{% endunless %}<a class="btn line" href="{{ PathBase }}/library">Client library</a></p></div>{% endif %}</div>
<aside class="margin"><table class="dl"><tr><td>Audience</td><td>{% capture al4 -%}{{ x.audience }}{%- endcapture %}{{ al4 | replace: "public","Everyone" | replace: "clients","Clients" | replace: "counsel","In-house counsel" }}</td></tr><tr><td>Kind</td><td>{% capture kl3 -%}{{ x.kind }}{%- endcapture %}{{ kl3 | replace: "alert","Client alert" | replace: "memo","Memo" | replace: "guide","Guide" | replace: "checklist","Checklist" | replace: "template","Template" }}</td></tr><tr><td>Updated</td><td>{{ x.updated_label }}</td></tr></table><p style="margin-top:18px"><a class="btn line sm" href="{{ PathBase }}/client-room">Client room</a></p></aside></div></div></section>
