{%- assign y=Target.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "volunteers" and in_vo == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_st == false -%}{%- assign ok=false -%}{%- endif -%}{%- capture ed_d -%}{{ y.date }}{%- endcapture -%}{%- assign ed = ed_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}{%- capture _nepn -%}{{ y.precinct }}{%- endcapture -%}{%- assign epn = _nepn | plus: 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li><a href="{{ PathBase }}/trail">On the trail</a></li><li>Event</li></ol><p class="kick">{% capture lv4 -%}{{ y.kind }}{%- endcapture %}{% case lv4 %}{% when "townhall" %}Town hall{% when "forum" %}Candidate forum{% when "coffee" %}Porch coffee{% when "canvass" %}Canvass launch{% when "visit" %}Site visit{% when "phonebank" %}Phone bank{% else %}{{ lv4 }}{% endcase %} · {{ ed_d | date: "%A, %B %-d, %Y" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{% if ok %}{{ y.summary }}{% else %}A volunteer-only event.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ y.body }}</div><aside><div class="poll"><p class="kick">{% if ed == 0 %}today{% elsif ed == 1 %}tomorrow{% elsif ed > 1 %}in {{ ed }} days{% elsif ed == -1 %}yesterday{% else %}{{ ed | abs }} days ago{% endif %}</p><h3>{{ y.time_label }}</h3><p>{{ y.place }}</p></div>{%- assign pz = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{% for p in pz.Items %}{%- capture _nppn -%}{{ p.PublishedContent.number }}{%- endcapture -%}{%- assign ppn = _nppn | plus: 0 -%}{% if ppn == epn %}<p style="margin-top:14px">In <a href="{{ PathBase }}/{{ p.RoutePath }}">Precinct {{ ppn }}, {{ p.PrimaryField }}</a>.</p>{% endif %}{% endfor %}</aside></div>{% else %}<div class="lockp"><p class="kick" style="color:var(--brick)">🔒 Volunteers</p><h2>This one is for signed-in volunteers.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the field organizer opens a volunteer account after your first shift, and the campaign manager opens staff accounts.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/trail">Sign in</a><a class="btn line" href="{{ PathBase }}/help">How to help</a></p></div>{% endif %}</div></section>
