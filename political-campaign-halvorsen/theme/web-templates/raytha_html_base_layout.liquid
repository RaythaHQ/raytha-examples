<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Noor Halvorsen for County Commission" %}{{ Target.Title }} | {% endif %}Noor Halvorsen for County Commission</title>
{%- capture mau -%}{{ Target.PublishedContent.audience }}{%- endcapture -%}<meta name="description" content="{% if mau == "volunteers" or mau == "staff" %}Members-only page for the Halvorsen campaign (fictional). Sign in to read.{% elsif Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Noor Halvorsen for Wrenfield County Commission, District 2 (fictional): a nonpartisan local campaign site with a plan laid out like a sample ballot, a precinct map with polling places, a server-side countdown to Election Day, public answers to every questionnaire, and members-only desks for volunteers and staff. Built on Raytha, a self-hosted, open-source .NET CMS for political campaigns and the agencies and freelancers who build their sites.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Public+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet"><style>:root{--paper:#f6f1e6;--card:#fffdf7;--ink:#1d2321;--soft:#4a524e;--line:#d9d0bd;--green:#1f4d3b;--green2:#2e6b52;--gold:#e8a823;--gold2:#f6d58a;--brick:#a24a2e;--sky:#dfe9e3;
--serif:"Source Serif 4",Georgia,serif;--sans:"Public Sans",system-ui,sans-serif;--mono:"IBM Plex Mono",ui-monospace,monospace}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.6 var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--green)}a:hover{color:var(--brick)}img,svg{max-width:100%}
.w{max-width:1240px;margin:0 auto;padding:0 28px}
.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:9}
h1,h2,h3{font-family:var(--serif);font-weight:700;letter-spacing:-.01em;line-height:1.12;margin:0 0 .4em}
h1{font-size:clamp(2.3rem,4.4vw,3.6rem)}h2{font-size:clamp(1.6rem,2.6vw,2.2rem)}h3{font-size:1.25rem}
.kick{font:600 .74rem/1.3 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--green2);margin:0 0 10px}
.lede{font-size:1.18rem;color:var(--soft);max-width:760px}.muted{color:var(--soft)}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--green);color:#fff;text-decoration:none;font-weight:700;padding:12px 20px;border-radius:4px;border:2px solid var(--green);font-family:var(--sans);font-size:1rem;cursor:pointer}
.btn:hover{background:var(--ink);border-color:var(--ink);color:#fff}.btn.line{background:transparent;color:var(--green)}.btn.line:hover{background:var(--green);color:#fff}
.btn.gold{background:var(--gold);border-color:var(--gold);color:var(--ink)}
.cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px}
.strip{background:var(--ink);color:#e9e3d4;font:500 .8rem/1 var(--mono);letter-spacing:.04em}
.strip .w{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:38px;flex-wrap:wrap}
.strip a{color:#e9e3d4;text-decoration:none;margin-left:18px}.strip a:hover{color:var(--gold)}
.strip .cd b{color:var(--gold);font-weight:600}.strip .f{opacity:.55;margin-left:14px}
.top{background:var(--paper);border-bottom:3px solid var(--ink);position:sticky;top:0;z-index:5}
.top .w{display:flex;align-items:center;gap:26px;min-height:76px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}
.brand b{display:block;font:800 1.15rem/1.05 var(--sans);letter-spacing:-.01em}.brand small{display:block;font:500 .72rem/1.3 var(--mono);color:var(--soft);letter-spacing:.06em;text-transform:uppercase;margin-top:3px}
.top nav{flex:1}.top nav ul{display:flex;gap:2px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
.top nav a{display:block;white-space:nowrap;padding:8px 9px;text-decoration:none;color:var(--ink);font-weight:600;font-size:.94rem;border-radius:3px}.top nav a:hover{background:var(--sky);color:var(--green)}
.top .sl{font-weight:600;font-size:.92rem;text-decoration:none;color:var(--ink);border:2px solid var(--ink);border-radius:4px;padding:7px 12px;white-space:nowrap}.top .sl:hover{background:var(--ink);color:#fff}.top form input{width:160px;padding:9px 12px;border:2px solid var(--line);border-radius:4px;background:var(--card);font:inherit;font-size:.9rem}
.sec{padding:76px 0}.sec.tight{padding:44px 0}.sec.alt{background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sec.green{background:var(--green);color:#f3efe2}.sec.green .kick{color:var(--gold2)}.sec.green a{color:#fff}
.sh{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px;flex-wrap:wrap}.sh h2{margin:0}
.phead{padding:54px 0 34px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--card),var(--paper))}
.crumbs{list-style:none;margin:0 0 16px;padding:0;display:flex;gap:8px;font:500 .78rem var(--mono);color:var(--soft)}.crumbs li+li:before{content:"/";margin-right:8px;opacity:.5}.crumbs a{color:var(--soft)}
.hero{padding:58px 0 40px;overflow:hidden}.hero .w{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(2.4rem,4.6vw,3.9rem)}
.seat{display:inline-flex;gap:10px;align-items:center;font:600 .78rem var(--mono);letter-spacing:.08em;text-transform:uppercase;background:var(--card);border:1px solid var(--line);padding:7px 12px;border-radius:30px;margin-bottom:18px}
.seat i{width:9px;height:9px;border-radius:50%;background:var(--gold);display:inline-block}
.lawn{position:relative;height:470px}
.sign{position:absolute;left:50%;top:18px;width:390px;margin-left:-195px;transform:rotate(-2.2deg);background:var(--green);color:#fff;border-radius:6px;box-shadow:0 26px 40px -18px rgba(20,30,25,.55),inset 0 0 0 7px #fff,inset 0 0 0 10px var(--green);padding:34px 30px 0;text-align:center;z-index:2;overflow:hidden}
.sign .for{font:700 .82rem var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--gold2)}
.sign .nm{font:800 3.45rem/.95 var(--sans);letter-spacing:-.03em;margin:10px 0 6px}.sign .nm span{display:block}
.sign .of{font:600 1.05rem/1.3 var(--serif);font-style:italic;opacity:.95;margin-bottom:22px}
.sign .band{background:var(--gold);color:var(--ink);font:800 1.05rem/1 var(--sans);letter-spacing:.06em;text-transform:uppercase;padding:14px 10px;margin:0 -30px}
.stake{position:absolute;top:250px;width:8px;height:190px;background:linear-gradient(90deg,#9aa39d,#cfd5d0,#8b948e);z-index:1}.stake.l{left:calc(50% - 120px)}.stake.r{left:calc(50% + 112px)}
.grass{position:absolute;bottom:0;left:-10%;right:-10%;height:70px;background:radial-gradient(60% 120% at 50% 100%,#6f9a6a,#4f7a4d 60%,transparent 61%)}
.ballotcard{position:absolute;right:0;bottom:30px;z-index:3;background:var(--card);border:2px solid var(--ink);padding:14px 18px;border-radius:4px;box-shadow:6px 6px 0 var(--ink);width:210px;transform:rotate(2deg)}
.ballotcard b{display:block;font:800 3.4rem/1 var(--sans);letter-spacing:-.04em;color:var(--green)}.ballotcard span{font:600 .74rem/1.35 var(--mono);text-transform:uppercase;letter-spacing:.06em;display:block}
.road{position:relative;margin:48px 0 8px}
.rail{position:relative;height:200px;margin:0 80px}
.rail .ln{position:absolute;left:0;right:0;top:44px;height:6px;background:var(--line);border-radius:3px}
.rail .done{position:absolute;left:0;top:44px;height:6px;background:var(--green);border-radius:3px}
.rail .ms{position:absolute;top:0;height:200px;width:160px;margin-left:-80px;text-align:center;font-size:.84rem;line-height:1.3}
.rail .ms .dot{position:absolute;top:38px;left:71px;width:18px;height:18px;border-radius:50%;background:var(--card);border:3px solid var(--ink)}
.rail .ms.past .dot{background:var(--green);border-color:var(--green)}.rail .ms.vote .dot{border-color:var(--gold);background:var(--gold)}.rail .ms.deadline .dot{border-color:var(--brick);background:#fff}
.rail .ms .t{position:absolute;top:12px;left:0;right:0;font:600 .72rem var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--soft)}
.rail .ms>span:last-child{position:absolute;top:70px;left:0;right:0}
.rail .ms b{display:block;font-weight:700}.rail .ms small{color:var(--soft)}
.rail .ms.vote b{color:var(--green)}
.rail .today{position:absolute;top:30px;width:3px;height:34px;background:var(--brick);margin-left:-1px}.rail .today span{position:absolute;top:-46px;left:-40px;width:80px;text-align:center;font:700 .66rem var(--mono);color:#fff;background:var(--brick);padding:3px 0;border-radius:3px;letter-spacing:.1em}
.ballot{background:#fff;border:2px solid var(--ink);box-shadow:8px 8px 0 rgba(29,35,33,.9);position:relative}
.ballot .bh{display:flex;justify-content:space-between;gap:16px;padding:16px 22px;border-bottom:2px solid var(--ink);font:600 .76rem/1.4 var(--mono);text-transform:uppercase;letter-spacing:.08em}
.ballot .bh b{font:800 1.05rem var(--sans);letter-spacing:.02em}
.ballot .bi{display:grid;grid-template-columns:56px 1fr auto;gap:16px;align-items:center;padding:18px 22px;border-bottom:1px dashed #b9b2a2;text-decoration:none;color:var(--ink)}
.ballot .bi:last-of-type{border-bottom:0}.ballot .bi:hover{background:#fbf6e8}
.oval{width:44px;height:26px;border:2.5px solid var(--ink);border-radius:50%;display:block;position:relative}
.oval.on:after,.ballot .bi:hover .oval:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--ink)}
.ballot .bi h3{margin:0 0 3px;font-size:1.18rem}.ballot .bi p{margin:0;color:var(--soft);font-size:.96rem}
.ballot .bi .no{font:600 .8rem var(--mono);color:var(--soft)}
.ballot .bf{padding:12px 22px;border-top:2px solid var(--ink);font:500 .76rem var(--mono);color:var(--soft);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.twocol{display:grid;grid-template-columns:1.35fr .65fr;gap:44px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:24px}
.side .kick{margin-bottom:8px}
.mapwrap{display:grid;grid-template-columns:1.55fr .45fr;gap:30px;align-items:start}
.dmap{width:100%;height:auto;display:block;background:#eef0e4;border:2px solid var(--ink);border-radius:4px}
.dmap a:hover .pz{fill:var(--gold2)}
.dmap text{font-family:var(--sans)}
.plist{list-style:none;margin:0;padding:0}.plist li{border-bottom:1px solid var(--line)}.plist a{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:10px 0;text-decoration:none;color:var(--ink)}
.plist .n{width:28px;height:28px;border-radius:50%;background:var(--green);color:#fff;display:grid;place-items:center;font:700 .85rem var(--sans)}
.plist b{display:block;font-size:.98rem}.plist small{color:var(--soft);font-size:.82rem;line-height:1.3;display:block}
.legend{display:flex;gap:18px;flex-wrap:wrap;font:500 .78rem var(--mono);color:var(--soft);margin-top:10px}.legend i{display:inline-block;width:12px;height:12px;margin-right:6px;vertical-align:-1px;border-radius:2px}
.evs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.ev{display:grid;grid-template-columns:62px 1fr;gap:16px;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:18px;text-decoration:none;color:var(--ink);position:relative}
.ev:hover{border-color:var(--green)}
.dblk{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;border:2px solid var(--ink);border-radius:4px;height:76px;background:#fff;line-height:1;overflow:hidden}
.dblk b{font:700 .68rem var(--mono);text-transform:uppercase;letter-spacing:.1em;background:var(--ink);color:#fff;align-self:stretch;text-align:center;padding:4px 0}
.dblk i{font:800 1.7rem/1.1 var(--sans);font-style:normal;margin-top:4px}.dblk small{font:500 .66rem var(--mono);text-transform:uppercase;color:var(--soft)}
.ev h3{font-family:var(--sans);font-size:1.02rem;font-weight:700;margin:0 0 4px;line-height:1.3}.ev p{margin:0;font-size:.88rem;color:var(--soft);line-height:1.45}
.chip{display:inline-block;font:600 .68rem/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:5px 8px;border-radius:3px;background:var(--sky);color:var(--green);margin-bottom:8px}
.chip.today{background:var(--gold);color:var(--ink)}.chip.lock{background:#efe2dc;color:var(--brick)}.chip.past{background:#e7e3da;color:var(--soft)}
.qas{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.qa{background:var(--card);border-left:5px solid var(--gold);padding:20px 22px;text-decoration:none;color:var(--ink);border-radius:0 6px 6px 0}
.qa .q{font:600 1.12rem/1.3 var(--serif);margin:0 0 10px}.qa .a{font-weight:700;color:var(--green);margin:0 0 10px}.qa small{font:500 .74rem var(--mono);color:var(--soft);text-transform:uppercase;letter-spacing:.05em}
.ens{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.en{display:grid;grid-template-columns:54px 1fr;gap:16px;padding:20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-radius:6px}
.en .ini{width:54px;height:54px;border-radius:50%;background:var(--gold);color:var(--ink);display:grid;place-items:center;font:800 1rem var(--sans)}
.en blockquote{margin:0 0 8px;font:400 1.05rem/1.45 var(--serif);font-style:italic}.en b{display:block;font-size:.95rem}.en small{opacity:.8;font-size:.82rem}
.ens.light .en{background:var(--card);border-color:var(--line)}
.dg{display:grid;grid-template-columns:1.4fr .6fr;gap:44px;align-items:start}
.prose{max-width:740px}.prose p{margin:0 0 1em}.prose h2{margin-top:1.2em}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:8px 0 34px}
.box{background:var(--card);border:2px solid var(--ink);border-radius:4px;padding:20px 22px}
.box h3{font:700 .8rem var(--mono);text-transform:uppercase;letter-spacing:.1em;margin:0 0 12px;color:var(--green2)}
.checks{list-style:none;margin:0;padding:0}.checks li{position:relative;padding:0 0 10px 30px;font-size:.96rem;line-height:1.45}
.checks li:before{content:"";position:absolute;left:0;top:3px;width:16px;height:16px;border:2px solid var(--ink);border-radius:2px;background:#fff}
.box.cost{background:#fff;font-family:var(--mono);font-size:.88rem;line-height:1.55;border-style:dashed}
.box.cost p{margin:0}
.meas li:before{border-radius:50%;background:var(--gold);border-color:var(--gold)}
.bnav{display:flex;justify-content:space-between;gap:16px;margin-top:30px;border-top:2px solid var(--ink);padding-top:18px;flex-wrap:wrap}
.bnav a{text-decoration:none;font-weight:700}
.figs{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:0 0 26px}.figs div{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:16px}
.figs b{display:block;font:800 1.7rem/1.1 var(--sans);color:var(--green)}.figs span{font-size:.84rem;color:var(--soft)}
.bar{height:10px;background:#e7e1d2;border-radius:5px;overflow:hidden}.bar i{display:block;height:100%;background:var(--green);border-radius:5px}.bar.gold i{background:var(--gold)}.bar.brick i{background:var(--brick)}
.poll{background:var(--green);color:#fff;border-radius:6px;padding:24px}.poll .kick{color:var(--gold2)}.poll h3{font-size:1.4rem;margin:0 0 4px}.poll p{margin:0;opacity:.92}.poll a{color:#fff}
.hit{display:block;padding:18px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}.hit b{font-size:1.08rem}.hit p{margin:4px 0 0;color:var(--soft);font-size:.95rem}.hit:hover b{color:var(--green)}
.tg{font:600 .7rem var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--brick);margin-left:6px}
.lockp{background:var(--card);border:2px dashed var(--brick);border-radius:6px;padding:34px;max-width:780px}.lockp h2{font-size:1.6rem}
.badge{display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center;background:var(--ink);color:#fff;border-radius:8px;padding:22px 26px;margin-bottom:30px;max-width:720px;position:relative}
.badge .hole{width:16px;height:46px;border-radius:8px;background:var(--paper)}
.badge .t{font:600 .72rem var(--mono);letter-spacing:.14em;color:var(--gold)}.badge .who{font:800 1.6rem/1.1 var(--sans);margin:4px 0}.badge .bc{font:500 .74rem var(--mono);opacity:.75}
.shift{display:grid;grid-template-columns:62px 1fr 170px;gap:18px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);text-decoration:none;color:var(--ink)}
.shift b{display:block}.shift small{color:var(--soft);font-size:.86rem;display:block}.shift .fill small{margin-top:6px;font:500 .74rem var(--mono)}
.table{width:100%;border-collapse:collapse;font-size:.94rem;background:var(--card)}.table th{text-align:left;font:600 .72rem var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--soft);border-bottom:2px solid var(--ink);padding:10px 12px}
.table td{border-bottom:1px solid var(--line);padding:11px 12px;vertical-align:middle}.tscroll{overflow-x:auto}
.vtl{list-style:none;margin:0;padding:0;border-left:3px solid var(--ink);margin-left:10px}
.vtl li{position:relative;padding:0 0 26px 28px}.vtl li:before{content:"";position:absolute;left:-11px;top:4px;width:16px;height:16px;border-radius:50%;background:var(--card);border:3px solid var(--ink)}
.vtl li.past:before{background:var(--green);border-color:var(--green)}.vtl li.vote:before{background:var(--gold);border-color:var(--gold)}.vtl li.deadline:before{border-color:var(--brick)}
.vtl b{font-size:1.08rem}.vtl .when{font:600 .76rem var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--green2);display:block;margin-bottom:3px}
.vtl li.past .when{color:var(--soft)}
.lookup{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin:10px 0 0}.lookup select{font:inherit;padding:11px 12px;border:2px solid var(--ink);border-radius:4px;background:#fff;min-width:260px}
label{display:block;font-weight:700;font-size:.92rem;margin-bottom:6px}
input[type=email],input[type=password]{width:100%;padding:12px 14px;border:2px solid var(--line);border-radius:4px;font:inherit;background:#fff}
.notice{background:#f6e3dc;border-left:4px solid var(--brick);padding:12px 16px;margin-bottom:18px}
.searchbar{display:flex;gap:10px;max-width:620px;margin-top:18px}.searchbar input{flex:1;padding:13px 14px;border:2px solid var(--ink);border-radius:4px;font:inherit}
.paidfor{display:inline-block;border:2px solid #e9e3d4;padding:10px 14px;font:600 .74rem/1.45 var(--mono);letter-spacing:.04em;margin-top:18px;color:#e9e3d4}
.foot{background:var(--ink);color:#cfc9ba;padding:56px 0 30px}.foot a{color:#e9e3d4;text-decoration:none}.foot a:hover{color:var(--gold)}
.foot .fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:34px}.foot h4{font:600 .74rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin:0 0 14px}
.foot ul{list-style:none;margin:0;padding:0}.foot li{margin:0 0 8px}.foot .brand{color:#fff}.foot .brand small{color:#a9a395}
.disc{display:flex;justify-content:space-between;gap:16px;border-top:1px solid #3a423f;margin-top:40px;padding-top:18px;font:500 .74rem var(--mono);flex-wrap:wrap}
.topics{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}.topics a{font:600 .78rem var(--mono);text-decoration:none;border:1.5px solid var(--ink);border-radius:30px;padding:6px 12px;color:var(--ink)}.topics a.on{background:var(--ink);color:#fff}
.qfull{border-bottom:1px solid var(--line);padding:26px 0}.qfull h3{font-size:1.35rem;margin-bottom:6px}
@media(max-width:1100px){.top .sl{display:none}}
@media(max-width:980px){.hero .w,.twocol,.mapwrap,.dg{grid-template-columns:1fr}.evs,.qas{grid-template-columns:1fr 1fr}.three,.figs{grid-template-columns:1fr 1fr}.foot .fg{grid-template-columns:1fr 1fr}}
@media(max-width:700px){body{font-size:16px}.w{padding:0 18px}.evs,.qas,.ens,.three{grid-template-columns:1fr}.top .w{flex-wrap:wrap;gap:8px;padding-top:10px;padding-bottom:6px;min-height:0}.top{position:static}
.top nav ul{flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px}.top nav a{white-space:nowrap;padding:6px 9px;font-size:.9rem}
.hero{padding-top:36px}.lawn{height:400px}.sign{width:300px;margin-left:-150px;padding:26px 22px 0}.sign .nm{font-size:2.65rem}.sign .band{margin:0 -22px}.stake{top:220px}.stake.l{left:calc(50% - 90px)}.stake.r{left:calc(50% + 82px)}
.ballotcard{right:4px;bottom:10px;width:170px}.ballotcard b{font-size:2.6rem}
.rail{height:auto;margin:0}.rail .ln,.rail .done,.rail .today{display:none}.rail .ms{position:static;width:auto;margin:0 0 14px!important;text-align:left;display:grid;grid-template-columns:22px 1fr;gap:4px 12px}.rail .ms .dot{margin:2px 0 0;grid-row:span 2}.rail .ms .t,.rail .ms.up .t,.rail .ms.up>span:last-child{position:static}
.ballot .bi{grid-template-columns:44px 1fr;padding:14px}.ballot .bi .no{display:none}.oval{width:36px;height:22px}.ballot .bh{flex-direction:column}
.shift{grid-template-columns:62px 1fr}.shift .fill{grid-column:2}.sec{padding:52px 0}.strip .f{display:none}.figs{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.rail .ms .dot{grid-column:1;grid-row:1 / 3}.rail .ms .t{grid-column:2;grid-row:1}.rail .ms>span:last-child{grid-column:2;grid-row:2}}
@media(max-width:700px){.rail .ms .dot,.rail .ms .t,.rail .ms>span:last-child{position:static!important}.rail .ms{height:auto!important}.rail .ms .t{font-size:.7rem}}
