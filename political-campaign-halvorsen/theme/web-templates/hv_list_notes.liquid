<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>Campaign notes</li></ol><p class="kick">From the office</p><h1>News, briefs and memos</h1><p class="lede">Public news is for everyone. Volunteer briefs and staff memos are listed by title, but their contents stay on the server unless you are signed in.</p></div></div><section class="sec tight"><div class="w"><div style="max-width:900px">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "volunteers" and in_vo == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_st == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="chip">{% capture lv8 -%}{{ y.kind }}{%- endcapture %}{% case lv8 %}{% when "news" %}News{% when "brief" %}Volunteer brief{% when "memo" %}Staff memo{% when "press" %}Press note{% else %}{{ lv8 }}{% endcase %}</span>{% if au != "public" %} <span class="tg">🔒 {% capture lv9 -%}{{ y.audience }}{%- endcapture %}{% case lv9 %}{% when "public" %}Everyone{% when "volunteers" %}Volunteers{% when "staff" %}Campaign staff{% else %}{{ lv9 }}{% endcase %}</span>{% endif %}<br><b>{{ p.PrimaryField }}</b><p>{% if ok %}{{ y.summary }} · {{ y.from_name }}, {{ y.date_label }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}</div></div></section>
