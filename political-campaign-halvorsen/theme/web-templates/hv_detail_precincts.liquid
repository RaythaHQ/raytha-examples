{%- assign z=Target.PublishedContent -%}{%- capture _npno -%}{{ z.number }}{%- endcapture -%}{%- assign pno = _npno | plus: 0 -%}{%- capture _nrg -%}{{ z.registered }}{%- endcapture -%}{%- assign rg = _nrg | plus: 0 -%}{%- capture _ntl -%}{{ z.turnout_last }}{%- endcapture -%}{%- assign tl = _ntl | plus: 0 -%}{%- capture _npg -%}{{ z.doors_goal }}{%- endcapture -%}{%- assign pg = _npg | plus: 0 -%}{%- capture _npd -%}{{ z.doors_done }}{%- endcapture -%}{%- assign pd = _npd | plus: 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li><a href="{{ PathBase }}/district">District map</a></li><li>Precinct {{ pno }}</li></ol><p class="kick">Precinct {{ pno }} · {{ z.towns }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ z.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div><svg class="dmap" viewBox="0 0 1200 740" role="img" aria-label="District 2 precinct map, drawn from precinct content"><rect width="1200" height="740" fill="#eef0e4"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#9fbfc9" stroke-width="26" stroke-linecap="round"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#bcd6dd" stroke-width="12" stroke-linecap="round"/><ellipse cx="1050" cy="600" rx="70" ry="38" fill="#bcd6dd" stroke="#9fbfc9" stroke-width="3"/><path d="M80,690 L1180,80" stroke="#c9b98e" stroke-width="5"/><path d="M60,200 C300,240 700,230 1180,250" stroke="#c9b98e" stroke-width="4" fill="none"/>{%- assign pmap = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{% for pm in pmap.Items %}{%- assign mz=pm.PublishedContent -%}{%- capture _nmno -%}{{ mz.number }}{%- endcapture -%}{%- assign mno = _nmno | plus: 0 -%}{%- capture _npg -%}{{ mz.doors_goal }}{%- endcapture -%}{%- assign pg = _npg | plus: 0 -%}{%- capture _npd -%}{{ mz.doors_done }}{%- endcapture -%}{%- assign pd = _npd | plus: 0 -%}{%- assign pct = pd | times: 100 | divided_by: pg -%}<a href="{{ PathBase }}/{{ pm.RoutePath }}"><path class="pz" d="{{ mz.patch }}" fill="{% if mno == pno %}#e8a823{% else %}{% assign mm = mno | modulo: 4 %}{% case mm %}{% when 1 %}#cfe0c9{% when 2 %}#ece2c6{% when 3 %}#dbe6df{% else %}#e9d6b6{% endcase %}{% endif %}" stroke="#1d2321" stroke-width="2.5"/></a>{% endfor %}<path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#9fbfc9" stroke-opacity=".75" stroke-width="16" stroke-linecap="round" pointer-events="none"/><ellipse cx="1050" cy="600" rx="62" ry="32" fill="#bcd6dd" fill-opacity=".85" pointer-events="none"/>{% for pm in pmap.Items %}{%- assign mz=pm.PublishedContent -%}{%- capture _npno2 -%}{{ mz.number }}{%- endcapture -%}{%- assign pno2 = _npno2 | plus: 0 -%}{%- capture _nly -%}{{ mz.label_y }}{%- endcapture -%}{%- assign ly = _nly | plus: 0 -%}{%- capture _npx -%}{{ mz.poll_x }}{%- endcapture -%}{%- assign px = _npx | plus: 0 -%}{%- capture _npy -%}{{ mz.poll_y }}{%- endcapture -%}{%- assign py = _npy | plus: 0 -%}<circle cx="{{ mz.label_x }}" cy="{{ ly | minus: 30 }}" r="18" fill="#1f4d3b" pointer-events="none"/><text x="{{ mz.label_x }}" y="{{ ly | minus: 24 }}" text-anchor="middle" font-size="18" font-weight="800" fill="#fff" pointer-events="none">{{ pno2 }}</text><text x="{{ mz.label_x }}" y="{{ ly | plus: 8 }}" text-anchor="middle" font-size="21" font-weight="700" fill="#1d2321" pointer-events="none">{{ pm.PrimaryField }}</text><g pointer-events="none"><rect x="{{ px | minus: 11 }}" y="{{ py | minus: 11 }}" width="22" height="22" rx="3" fill="#fff" stroke="#1d2321" stroke-width="2.5"/><path d="M{{ px | minus: 6 }},{{ py }} l4,5 l8,-10" stroke="#a24a2e" stroke-width="3" fill="none"/></g>{% endfor %}<text x="1180" y="728" text-anchor="end" font-size="14" fill="#4a524e" font-family="IBM Plex Mono,monospace">WREN RIVER · DISTRICT 2 · NOT TO SCALE</text></svg><div class="legend"><span><i style="background:#cfe0c9;border:1px solid #1d2321"></i><i style="background:#ece2c6;border:1px solid #1d2321"></i>Precincts</span><span><i style="background:#fff;border:2px solid #1d2321"></i>Polling place on April 6</span><span><i style="background:#9fbfc9"></i>Wren River and Fallowmere Lake</span></div></div><aside><div class="poll"><p class="kick">You vote here on April 6</p><h3>{{ z.poll_place }}</h3><p>{{ z.poll_address }}</p><p style="margin-top:12px;font-size:.92rem">Polls open 7 am to 8 pm. Early voting for every precinct is at the county building in Marrow.</p></div><div class="figs" style="grid-template-columns:1fr 1fr;margin-top:16px"><div><b>{{ rg | format_number: "N0" }}</b><span>registered voters</span></div><div><b>{{ tl }}%</b><span>voted last county election</span></div></div>{% if in_vo %}{%- assign pct = pd | times: 100 | divided_by: pg -%}<div class="card"><p class="kick">🔒 Volunteers · canvass</p><p style="margin:0 0 8px"><b>{{ pd | format_number: "N0" }}</b> of {{ pg | format_number: "N0" }} doors · captain {{ z.captain }}</p><div class="bar"><i style="width:{{ pct }}%"></i></div></div>{% endif %}</aside></div><h2 style="margin-top:40px">Coming up in {{ Target.PrimaryField }}</h2>{%- assign evl = get_content_items(ContentType="events", OrderBy="date asc", PageSize=50) -%}{%- assign shown = 0 -%}<div class="evs">{% for p in evl.Items %}{%- assign y=p.PublishedContent -%}{%- capture _nepn -%}{{ y.precinct }}{%- endcapture -%}{%- assign epn = _nepn | plus: 0 -%}{%- capture edn_d -%}{{ y.date }}{%- endcapture -%}{%- assign edn = edn_d | remove: "-" | plus: 0 -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "volunteers" and in_vo == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_st == false -%}{%- assign ok=false -%}{%- endif -%}{% if epn == pno and edn >= todayn and au == "public" %}{%- assign shown = shown | plus: 1 -%}<a class="ev" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="dblk"><b>{{ edn_d | date: "%b" }}</b><i>{{ edn_d | date: "%-d" }}</i><small>{{ edn_d | date: "%a" }}</small></span><span><span class="chip">{% capture lv2 -%}{{ y.kind }}{%- endcapture %}{% case lv2 %}{% when "townhall" %}Town hall{% when "forum" %}Candidate forum{% when "coffee" %}Porch coffee{% when "canvass" %}Canvass launch{% when "visit" %}Site visit{% when "phonebank" %}Phone bank{% else %}{{ lv2 }}{% endcase %}</span><h3>{{ p.PrimaryField }}</h3><p>{{ y.time_label }} · {{ y.place }}</p></span></a>{% endif %}{% endfor %}</div>{% if shown == 0 %}<p class="muted">Nothing scheduled here yet. Porch coffees are added most weeks; <a href="{{ PathBase }}/help">host one</a>.</p>{% endif %}<div class="prose" style="margin-top:30px">{{ z.body }}</div></div></section>
