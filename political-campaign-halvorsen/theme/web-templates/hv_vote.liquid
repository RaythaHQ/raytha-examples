{%- assign pq = QueryParams.p | strip | plus: 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>How to vote</li></ol><p class="kick">Wrenfield County · April 6, 2027</p><h1>How to vote in District 2</h1><p class="lede">Choose your precinct to see your polling place. Not sure which one you are in? It is printed on your voter card, or call the county clerk at (555) 016-1100.</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div><form class="lookup" method="get" action="{{ PathBase }}/vote"><div><label for="p">Your precinct</label><select id="p" name="p"><option value="">Choose a precinct</option>{%- assign pl = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{% for p in pl.Items %}{%- capture _non -%}{{ p.PublishedContent.number }}{%- endcapture -%}{%- assign on = _non | plus: 0 -%}<option value="{{ on }}"{% if on == pq %} selected{% endif %}>{{ on }} · {{ p.PrimaryField }}</option>{% endfor %}</select></div><button class="btn">Show polling place</button></form>{% if pq > 0 %}{% for p in pl.Items %}{%- assign z=p.PublishedContent -%}{%- capture _non2 -%}{{ z.number }}{%- endcapture -%}{%- assign on2 = _non2 | plus: 0 -%}{% if on2 == pq %}<div class="poll" style="margin-top:22px"><p class="kick">Precinct {{ on2 }} · {{ p.PrimaryField }}</p><h3>{{ z.poll_place }}</h3><p>{{ z.poll_address }} · Tuesday, April 6 · 7 am to 8 pm</p></div>{% endif %}{% endfor %}<div style="margin-top:18px"><svg class="dmap" viewBox="0 0 1200 740" role="img" aria-label="District 2 precinct map, drawn from precinct content"><rect width="1200" height="740" fill="#eef0e4"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#9fbfc9" stroke-width="26" stroke-linecap="round"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 