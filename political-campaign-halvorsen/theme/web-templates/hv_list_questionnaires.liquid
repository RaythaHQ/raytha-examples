{%- assign tp = QueryParams.topic | strip -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>Asked &amp; answered</li></ol><p class="kick">Asked and answered</p><h1>Every question, answered in public</h1><p class="lede">Questionnaires from the Ledger, unions, neighborhood groups and voters on doors. The short answer first, then the full one, unedited.</p></div></div><section class="sec tight"><div class="w"><div class="topics"><a href="?" class="{% if tp == "" %}on{% endif %}">All</a>{%- assign seen = "" -%}{% for q in Target.Items %}{%- capture qt -%}{{ q.PublishedContent.topic }}{%- endcapture -%}{% unless seen contains qt %}{%- assign seen = seen | append: "|" | append: qt -%}<a href="?topic={{ qt | url_encode }}" class="{% if tp == qt %}on{% endif %}">{{ qt }}</a>{% endunless %}{% endfor %}</div><div style="max-width:900px">{% for q in Target.Items %}{%- assign y=q.PublishedContent -%}{%- capture qt -%}{{ y.topic }}{%- endcapture -%}{% if tp == "" or tp == qt %}<div class="qfull"><span class="chip">{{ qt }}</span><h3><a href="{{ PathBase }}/{{ q.RoutePath }}" style="color:inherit;text-decoration:none">{{ q.PrimaryField }}</a></h3><p style="font-weight:700;color:var(--green);margin:0 0 8px">{{ y.short_answer }}</p><div class="prose">{{ y.answer }}</div><small class="muted" style="font-family:var(--mono)">Asked by {{ y.asked_by }} · {{ y.date_label }}</small></div>{% endif %}{% endfor %}</div></div></section>
