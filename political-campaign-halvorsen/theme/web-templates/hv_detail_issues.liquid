{%- assign y=Target.PublishedContent -%}{%- capture _nbno -%}{{ y.ballot_no }}{%- endcapture -%}{%- assign bno = _nbno | plus: 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li><a href="{{ PathBase }}/plan">The plan</a></li><li>No. {{ bno }}</li></ol><p class="kick">Ballot item {{ bno }} of 7 · {{ y.topic }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.stance }}</p></div></div><section class="sec tight"><div class="w"><div class="three"><div class="box"><h3>What I will do</h3>{%- capture lraw -%}{{ y.commitments }}{%- endcapture -%}{%- assign litems = lraw | split: "|" -%}<ul class="checks ">{% for li in litems %}<li>{{ li | strip }}</li>{% endfor %}</ul></div><div class="box cost"><h3>What it costs</h3><p>{{ y.cost }}</p></div><div class="box"><h3>How you will know</h3>{%- capture lraw -%}{{ y.measure }}{%- endcapture -%}{%- assign litems = lraw | split: "|" -%}<ul class="checks meas">{% for li in litems %}<li>{{ li | strip }}</li>{% endfor %}</ul></div></div><div class="dg"><div class="prose"><p class="kick">Why it is on the ballot</p><p style="font-size:1.15rem"><b>{{ y.summary }}</b></p>{{ y.body }}</div><aside><div class="card side"><p class="kick">Ask about it</p><p style="margin:0 0 14px">Bring this one to a porch coffee or a town hall. Or call the office at (555) 016-2027.</p><a class="btn" href="{{ PathBase }}/trail">Upcoming events</a></div></aside></div>{%- assign iss = get_content_items(ContentType="issues", OrderBy="ballot_no asc", PageSize=20) -%}{%- assign pi = 0 -%}{%- assign ni = 0 -%}{% for p in iss.Items %}{%- capture _nib -%}{{ p.PublishedContent.ballot_no }}{%- endcapture -%}{%- assign ib = _nib | plus: 0 -%}{%- assign bm = bno | minus: 1 -%}{%- assign bp = bno | plus: 1 -%}{% if ib == bm %}{%- assign prv = p -%}{%- assign pi = 1 -%}{% endif %}{% if ib == bp %}{%- assign nxt = p -%}{%- assign ni = 1 -%}{% endif %}{% endfor %}<nav class="bnav" aria-label="Ballot items"><span>{% if pi == 1 %}<a href="{{ PathBase }}/{{ prv.RoutePath }}">&larr; No. {{ bno | minus: 1 }}: {{ prv.PrimaryField }}</a>{% endif %}</span><a href="{{ PathBase }}/plan">All seven</a><span>{% if ni == 1 %}<a href="{{ PathBase }}/{{ nxt.RoutePath }}">No. {{ bno | plus: 1 }}: {{ nxt.PrimaryField }} &rarr;</a>{% endif %}</span></nav></div></section>
