{%- assign y=Target.PublishedContent -%}{%- capture md_d -%}{{ y.date }}{%- endcapture -%}{%- assign md = md_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li><a href="{{ PathBase }}/road">Road to April 6</a></li><li>Milestone</li></ol><p class="kick">{% capture lv7 -%}{{ y.kind }}{%- endcapture %}{% case lv7 %}{% when "campaign" %}Campaign{% when "deadline" %}Deadline{% when "vote" %}Voting{% else %}{{ lv7 }}{% endcase %} · {{ md_d | date: "%A, %B %-d, %Y" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.note }}</p></div></div><section class="sec tight"><div class="w"><p><span class="chip today" style="font-size:.85rem">{% if md == 0 %}today{% elsif md == 1 %}tomorrow{% elsif md > 1 %}in {{ md }} days{% elsif md == -1 %}yesterday{% else %}{{ md | abs }} days ago{% endif %}</span></p><p class="cta"><a class="btn line" href="{{ PathBase }}/road">All dates</a><a class="btn" href="{{ PathBase }}/vote">How to vote</a></p></div></section>
