<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>Road to April 6</li></ol><p class="kick">Road to April 6 · {{ tdate }}</p><h1>Every date between now and Election Day</h1><p class="lede">Deadlines, early voting and campaign moments. The countdowns are worked out on the server each time the page loads.</p></div></div><section class="sec tight"><div class="w"><div class="dg"><ol class="vtl">{% for m in Target.Items %}{%- assign y=m.PublishedContent -%}{%- capture md_d -%}{{ y.date }}{%- endcapture -%}{%- assign md = md_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}{%- capture mk -%}{{ y.kind }}{%- endcapture -%}<li class="{{ mk }}{% if md < 0 %} past{% endif %}"><span class="when">{{ md_d | date: "%a, %b %-d, %Y" }} · {% if md == 0 %}today{% elsif md == 1 %}tomorrow{% elsif md > 1 %}in {{ md }} days{% elsif md == -1 %}yesterday{% else %}{{ md | abs }} days ago{% endif %}</span><b>{{ m.PrimaryField }}</b><p class="muted" style="margin:4px 0 0">{{ y.note }}</p></li>{% endfor %}</ol><aside class="poll"><p class="kick">Election Day</p><h3>{% if el_days > 0 %}{{ el_days }} days to go{% else %}Today{% endif %}</h3><p>Tuesday, April 6, 2027. Polls open 7 am to 8 pm.</p><p style="margin-top:12px"><a href="{{ PathBase }}/vote">Find your polling place &rarr;</a></p></aside></div></div></section>
