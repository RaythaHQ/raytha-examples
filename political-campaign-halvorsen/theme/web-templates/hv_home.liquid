<section class="hero"><div class="w"><div><span class="seat"><i></i>Wrenfield County Commission · District 2 · nonpartisan seat</span><h1>Bridges, clinic hours and the county checkbook, on a schedule you can check.</h1><p class="lede">I am Noor Halvorsen. I spent fourteen years as the county extension agent, on farm roads and in church basements. This is my plan for District 2, with what each piece costs and how you will know it happened.</p><p class="cta"><a class="btn" href="{{ PathBase }}/plan">Read the plan</a><a class="btn line" href="{{ PathBase }}/vote">Find your polling place</a></p></div><div class="lawn" aria-hidden="true"><div class="grass"></div><span class="stake l"></span><span class="stake r"></span><div class="sign"><div class="for">Re-open the bridges</div><div class="nm"><span>NOOR</span><span>HALVORSEN</span></div><div class="of">for County Commission, District 2</div><div class="band">Vote April 6</div></div><div class="ballotcard">{% if el_days > 0 %}<b>{{ el_days }}</b><span>days to Election Day</span>{% elsif el_days == 0 %}<b>Today</b><span>Polls open 7 am to 8 pm</span>{% else %}<b>✓</b><span>The election is over</span>{% endif %}</div></div></div></section><section class="sec tight" style="padding-top:10px"><div class="w"><div class="sh"><div><p class="kick">Road to April 6</p><h2>Where we are on the calendar</h2></div><a href="{{ PathBase }}/road">Every date &rarr;</a></div><div class="road">{%- assign nms = msall.Items | size -%}{%- assign segs = nms | minus: 1 -%}{%- assign kk = -1 -%}{%- assign prev_s = 0 -%}{%- assign tpos = 0 -%}{% for m in msall.Items %}{%- capture rd -%}{{ m.PublishedContent.date }}{%- endcapture -%}{%- assign rs = rd | date: "%s" | plus: 0 -%}{%- assign ix = forloop.index0 -%}{% if rs <= nows %}{%- assign kk = ix -%}{%- assign prev_s = rs -%}{% else %}{%- assign kp1 = kk | plus: 1 -%}{% if kk >= 0 and ix == kp1 %}{%- assign gap = rs | minus: prev_s -%}{%- assign fr = nows | minus: prev_s | times: 100 | divided_by: gap -%}{%- assign tpos = kk | times: 100 | plus: fr | divided_by: segs -%}{% endif %}{% endif %}{% endfor %}{% if kk == segs %}{%- assign tpos = 100 -%}{% endif %}<div class="rail"><div class="ln"></div><div class="done" style="width:{{ tpos }}%"></div><div class="today" style="left:{{ tpos }}%"><span>TODAY</span></div>{% for m in msall.Items %}{%- assign y=m.PublishedContent -%}{%- capture md_d -%}{{ y.date }}{%- endcapture -%}{%- assign md = md_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}{%- capture mk -%}{{ y.kind }}{%- endcapture -%}{%- assign mp = forloop.index0 | times: 10000 | divided_by: segs | divided_by: 100.0 -%}<div class="ms {{ mk }}{% if md < 0 %} past{% endif %}" style="left:{{ mp }}%"><span class="t">{{ md_d | date: "%b %-d" }}</span><span class="dot"></span><span><b>{{ m.PrimaryField }}</b><small>{% if md == 0 %}today{% elsif md == 1 %}tomorrow{% elsif md > 1 %}in {{ md }} days{% elsif md == -1 %}yesterday{% else %}{{ md | abs }} days ago{% endif %}</small></span></div>{% endfor %}</div></div><p class="muted" style="font-size:.9rem;margin-top:10px">Dates come from content; the “today” mark and every countdown are worked out on the server when the page loads.</p></div></section><section class="sec alt"><div class="w"><div class="twocol"><div><div class="ballot"><div class="bh"><span><b>The plan, as a sample ballot</b><br>Wrenfield County · District 2 · April 6, 2027</span><span style="text-align:right">Seven items<br>each with a price</span></div>{%- assign iss = get_content_items(ContentType="issues", OrderBy="ballot_no asc", PageSize=20) -%}{% for p in iss.Items %}{%- assign y=p.PublishedContent -%}<a class="bi" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="oval{% if forloop.first %} on{% endif %}"></span><span><h3>{{ p.PrimaryField }}</h3><p>{{ y.stance }}</p></span><span class="no">No. {{ y.ballot_no }}</span></a>{% endfor %}<div class="bf"><span>{{ iss.TotalCount }} items · what, cost and measure for each</span><span>Not an official ballot</span></div></div></div><aside><p class="kick">How to read it</p><h2>Seven items. Every one has a price and a test.</h2><p class="muted">Each item says what I will do, what it costs and where the money comes from, and how you will know it worked. If something in the plan changes, the change and the reason go on the item’s page.</p><div class="card" style="margin-top:20px"><p class="kick">Asked most on doors</p>{%- assign topq = get_content_items(ContentType="questionnaires", OrderBy="sort_order asc", PageSize=1) -%}{% for q in topq.Items %}<p style="font:600 1.15rem/1.3 var(--serif);margin:0 0 8px">{{ q.PrimaryField }}</p><p style="margin:0 0 10px;font-weight:700;color:var(--green)">{{ q.PublishedContent.short_answer }}</p><a href="{{ PathBase }}/{{ q.RoutePath }}">The full answer &rarr;</a>{% endfor %}</div></aside></div></div></section><section class="sec"><div class="w"><div class="sh"><div><p class="kick">The district</p><h2>Eight precincts, one seat</h2></div><a href="{{ PathBase }}/district">The full map &rarr;</a></div><div class="mapwrap"><div><svg class="dmap" viewBox="0 0 1200 740" role="img" aria-label="District 2 precinct map, drawn from precinct content"><rect width="1200" height="740" fill="#eef0e4"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#9fbfc9" stroke-width="26" stroke-linecap="round"/><path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#bcd6dd" stroke-width="12" stroke-linecap="round"/><ellipse cx="1050" cy="600" rx="70" ry="38" fill="#bcd6dd" stroke="#9fbfc9" stroke-width="3"/><path d="M80,690 L1180,80" stroke="#c9b98e" stroke-width="5"/><path d="M60,200 C300,240 700,230 1180,250" stroke="#c9b98e" stroke-width="4" fill="none"/>{%- assign pmap = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{% for pm in pmap.Items %}{%- assign mz=pm.PublishedContent -%}{%- capture _nmno -%}{{ mz.number }}{%- endcapture -%}{%- assign mno = _nmno | plus: 0 -%}{%- capture _npg -%}{{ mz.doors_goal }}{%- endcapture -%}{%- assign pg = _npg | plus: 0 -%}{%- capture _npd -%}{{ mz.doors_done }}{%- endcapture -%}{%- assign pd = _npd | plus: 0 -%}{%- assign pct = pd | times: 100 | divided_by: pg -%}<a href="{{ PathBase }}/{{ pm.RoutePath }}"><path class="pz" d="{{ mz.patch }}" fill="{% assign mm = mno | modulo: 4 %}{% case mm %}{% when 1 %}#cfe0c9{% when 2 %}#ece2c6{% when 3 %}#dbe6df{% else %}#e9d6b6{% endcase %}" stroke="#1d2321" stroke-width="2.5"/></a>{% endfor %}<path d="M-10,300 C120,320 210,410 330,430 C450,450 520,380 640,420 C760,460 820,560 960,560 C1060,560 1120,520 1210,540" fill="none" stroke="#9fbfc9" stroke-opacity=".75" stroke-width="16" stroke-linecap="round" pointer-events="none"/><ellipse cx="1050" cy="600" rx="62" ry="32" fill="#bcd6dd" fill-opacity=".85" pointer-events="none"/>{% for pm in pmap.Items %}{%- assign mz=pm.PublishedContent -%}{%- capture _npno2 -%}{{ mz.number }}{%- endcapture -%}{%- assign pno2 = _npno2 | plus: 0 -%}{%- capture _nly -%}{{ mz.label_y }}{%- endcapture -%}{%- assign ly = _nly | plus: 0 -%}{%- capture _npx -%}{{ mz.poll_x }}{%- endcapture -%}{%- assign px = _npx | plus: 0 -%}{%- capture _npy -%}{{ mz.poll_y }}{%- endcapture -%}{%- assign py = _npy | plus: 0 -%}<circle cx="{{ mz.label_x }}" cy="{{ ly | minus: 30 }}" r="18" fill="#1f4d3b" pointer-events="none"/><text x="{{ mz.label_x }}" y="{{ ly | minus: 24 }}" text-anchor="middle" font-size="18" font-weight="800" fill="#fff" pointer-events="none">{{ pno2 }}</text><text x="{{ mz.label_x }}" y="{{ ly | plus: 8 }}" text-anchor="middle" font-size="21" font-weight="700" fill="#1d2321" pointer-events="none">{{ pm.PrimaryField }}</text><g pointer-events="none"><rect x="{{ px | minus: 11 }}" y="{{ py | minus: 11 }}" width="22" height="22" rx="3" fill="#fff" stroke="#1d2321" stroke-width="2.5"/><path d="M{{ px | minus: 6 }},{{ py }} l4,5 l8,-10" stroke="#a24a2e" stroke-width="3" fill="none"/></g>{% endfor %}<text x="1180" y="728" text-anchor="end" font-size="14" fill="#4a524e" font-family="IBM Plex Mono,monospace">WREN RIVER · DISTRICT 2 · NOT TO SCALE</text></svg><div class="legend"><span><i style="background:#cfe0c9;border:1px solid #1d2321"></i><i style="background:#ece2c6;border:1px solid #1d2321"></i>Precincts</span><span><i style="background:#fff;border:2px solid #1d2321"></i>Polling place on April 6</span><span><i style="background:#9fbfc9"></i>Wren River and Fallowmere Lake</span></div></div><ul class="plist">{%- assign pl = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{% for p in pl.Items %}{%- assign z=p.PublishedContent -%}<li><a href="{{ PathBase }}/{{ p.RoutePath }}"><span class="n">{{ z.number }}</span><span><b>{{ p.PrimaryField }}</b><small>Votes at {{ z.poll_place }}</small></span></a></li>{% endfor %}</ul></div></div></section><section class="sec alt"><div class="w"><div class="sh"><div><p class="kick">On the trail</p><h2>Come and ask in person</h2></div><a href="{{ PathBase }}/trail">The whole schedule &rarr;</a></div><div class="evs">{%- assign evl = get_content_items(ContentType="events", OrderBy="date asc", PageSize=50) -%}{%- assign shown = 0 -%}{% for p in evl.Items %}{%- assign y=p.PublishedContent -%}{%- capture edn_d -%}{{ y.date }}{%- endcapture -%}{%- assign edn = edn_d | remove: "-" | plus: 0 -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "volunteers" and in_vo == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_st == false -%}{%- assign ok=false -%}{%- endif -%}{% if edn >= todayn and shown < 6 and au == "public" %}{%- assign shown = shown | plus: 1 -%}<a class="ev" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="dblk"><b>{{ edn_d | date: "%b" }}</b><i>{{ edn_d | date: "%-d" }}</i><small>{{ edn_d | date: "%a" }}</small></span><span>{% if edn == todayn %}<span class="chip today">Today · {{ y.time_label }}</span>{% else %}<span class="chip">{% capture lv1 -%}{{ y.kind }}{%- endcapture %}{% case lv1 %}{% when "townhall" %}Town hall{% when "forum" %}Candidate forum{% when "coffee" %}Porch coffee{% when "canvass" %}Canvass launch{% when "visit" %}Site visit{% when "phonebank" %}Phone bank{% else %}{{ lv1 }}{% endcase %}</span>{% endif %}<h3>{{ p.PrimaryField }}</h3><p>{{ y.time_label }} · {{ y.place }}</p></span></a>{% endif %}{% endfor %}</div></div></section><section class="sec"><div class="w"><div class="sh"><div><p class="kick">Asked and answered</p><h2>Every questionnaire, answered in public</h2></div><a href="{{ PathBase }}/answers">All answers &rarr;</a></div><div class="qas">{%- assign qs = get_content_items(ContentType="questionnaires", OrderBy="sort_order asc", PageSize=3) -%}{% for q in qs.Items %}{%- assign y=q.PublishedContent -%}<a class="qa" href="{{ PathBase }}/{{ q.RoutePath }}"><p class="q">{{ q.PrimaryField }}</p><p class="a">{{ y.short_answer }}</p><small>Asked by {{ y.asked_by }} · {{ y.date_label }}</small></a>{% endfor %}</div></div></section><section class="sec green"><div class="w"><div class="sh"><div><p class="kick">Endorsements</p><h2 style="color:#fff">Who is backing the plan</h2></div><a href="{{ PathBase }}/endorsements">All of them &rarr;</a></div><div class="ens">{%- assign es = get_content_items(ContentType="endorsements", OrderBy="sort_order asc", PageSize=4) -%}{% for e in es.Items %}{%- assign y=e.PublishedContent -%}<div class="en"><span class="ini">{{ y.initials }}</span><div><blockquote>“{{ y.quote }}”</blockquote><b>{{ e.PrimaryField }}</b><small>{{ y.role }}</small></div></div>{% endfor %}</div></div></section><section class="sec tight"><div class="w"><div class="card" style="display:flex;justify-content:space-between;gap:24px;align-items:center;flex-wrap:wrap"><div><p class="kick">Pitch in</p><h2 style="margin:0">Knock doors, drive voters, host a porch coffee.</h2><p class="muted" style="margin:8px 0 0">No sign-up form: call the office or come to a Saturday launch. The field organizer opens your volunteer account after your first shift.</p></div><a class="btn gold" href="{{ PathBase }}/help">How to help</a></div></div></section>
