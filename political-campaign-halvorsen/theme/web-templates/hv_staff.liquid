<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>Staff desk</li></ol><p class="kick">Staff desk</p><h1>{% if in_st %}Field numbers, {{ tdate }}{% else %}Staff desk{% endif %}</h1><p class="lede">{% if in_st %}Precinct progress, days to each deadline, and memos. Visible to the campaign staff group only.{% else %}Precinct numbers and memos, for signed-in campaign staff.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if in_st %}{%- assign pl = get_content_items(ContentType="precincts", OrderBy="sort_order asc", PageSize=20) -%}{%- assign tg = 0 -%}{%- assign td = 0 -%}{% for p in pl.Items %}{%- capture _ng1 -%}{{ p.PublishedContent.doors_goal }}{%- endcapture -%}{%- assign g1 = _ng1 | plus: 0 -%}{%- capture _nd1 -%}{{ p.PublishedContent.doors_done }}{%- endcapture -%}{%- assign d1 = _nd1 | plus: 0 -%}{%- assign tg = tg | plus: g1 -%}{%- assign td = td | plus: d1 -%}{% endfor %}{%- assign tp = td | times: 100 | divided_by: tg -%}<div class="figs"><div><b>{{ el_days }}</b><span>days to Election Day</span></div><div><b>{{ rg_days }}</b><span>days to the registration deadline</span></div><div><b>{{ td | format_number: "N0" }}</b><span>doors knocked of {{ tg | format_number: "N0" }}</span></div><div><b>{{ tp }}%</b><span>of the district door goal</span></div></div><div class="tscroll"><table class="table"><thead><tr><th>#</th><th>Precinct</th><th>Captain</th><th>Doors</th><th style="width:34%">Progress</th><th>Flag</th></tr></thead><tbody>{% for p in pl.Items %}{%- assign z=p.PublishedContent -%}{%- capture _ng -%}{{ z.doors_goal }}{%- endcapture -%}{%- assign g = _ng | plus: 0 -%}{%- capture _nd -%}{{ z.doors_done }}{%- endcapture -%}{%- assign d = _nd | plus: 0 -%}{%- assign pc = d | times: 100 | divided_by: g -%}<tr><td>{{ z.number }}</td><td><a href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b></a></td><td>{{ z.captain }}</td><td>{{ d | format_number: "N0" }} / {{ g | format_number: "N0" }}</td><td><div class="bar{% if pc < 40 %} brick{% endif %}"><i style="width:{{ pc }}%"></i></div></td><td>{% if pc < 40 %}<span class="chip lock">Behind · {{ pc }}%</span>{% elsif pc >= 75 %}<span class="chip today">Ahead · {{ pc }}%</span>{% else %}<span class="chip">{{ pc }}%</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div><h2 style="margin-top:40px">Memos</h2>{%- assign mm = get_content_items(ContentType="notes", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=10) -%}{% for p in mm.Items %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b><p>{{ p.PublishedContent.summary }} · {{ p.PublishedContent.from_name }}, {{ p.PublishedContent.date_label }}</p></a>{% endfor %}{% else %}<div class="lockp"><p class="kick" style="color:var(--brick)">🔒 Staff desk</p><h2>Sign in with a staff account.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the field organizer opens a volunteer account after your first shift, and the campaign manager opens staff accounts.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff">Sign in</a><a class="btn line" href="{{ PathBase }}/help">How to help</a></p></div>{% endif %}</div></section>
