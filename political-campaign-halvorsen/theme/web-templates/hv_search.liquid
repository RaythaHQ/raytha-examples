{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li>Search</li></ol><p class="kick">Search</p><h1>{% if q != "" %}Results for “{{ q }}”{% else %}Search the campaign{% endif %}</h1><p class="lede">The plan, answers, events, precincts and notes. Members-only notes show a title only unless you are signed in.</p><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="bridge, clinic, flood"><button class="btn">Search</button></form></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "issues:The plan:title:summary,questionnaires:Answers:question:short_answer,events:Events:title:summary,precincts:Precincts:name:summary,endorsements:Endorsements:name:quote,notes:Notes:title:summary,milestones:Dates:label:note" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "volunteers" and in_vo == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_st == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "volunteers" or au == "staff" %} <span class="tg">🔒 Members</span>{% endif %}<p>{% if ok %}{{ x.summary | default: x.short_answer | default: x.note | default: x.quote | strip_html | truncate: 160 }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=bridge">bridge</a>, <a href="?q=clinic">clinic</a>, <a href="?q=flood">flood</a> or <a href="?q=Grange">Grange</a>.</p>{% endif %}</div></div></section>
