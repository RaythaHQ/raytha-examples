{%- assign y=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halvorsen 2027</a></li><li><a href="{{ PathBase }}/shifts">Shifts</a></li><li>Shift</li></ol><p class="kick">Volunteer shift</p><h1>{% if in_vo %}{{ Target.PrimaryField }}{% else %}Volunteer shift{% endif %}</h1><p class="lede">{% if in_vo %}{{ y.time_label }} · {{ y.meet }}{% else %}For signed-in volunteers.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if in_vo %}{%- capture _nsl -%}{{ y.slots }}{%- endcapture -%}{%- assign sl = _nsl | plus: 0 -%}{%- capture _nfl -%}{{ y.filled }}{%- endcapture -%}{%- assign fl = _nfl | plus: 0 -%}<div class="three"><div class="box"><h3>Turf packet</h3><p style="margin:0">{{ y.turf }}</p></div><div class="box"><h3>Lead</h3><p style="margin:0">{{ y.lead }}<br><small class="muted">{{ fl }} of {{ sl }} signed up</small></p></div><div class="box cost"><h3>Script notes</h3><p>{{ y.script }}</p></div></div>{% else %}<div class="lockp"><p class="kick" style="color:var(--brick)">🔒 Volunteers</p><h2>Sign in to see this shift.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the field organizer opens a volunteer account after your first shift, and the campaign manager opens staff accounts.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/shifts">Sign in</a><a class="btn line" href="{{ PathBase }}/help">How to help</a></p></div>{% endif %}</div></section>
