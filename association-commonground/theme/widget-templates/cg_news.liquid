{%- assign s = widget.settings -%}
{%- assign items = get_content_items(ContentType="news", OrderBy="published_on desc", PageSize=3) -%}
<section class="section band"><div class="wrap">
  <div class="shead"><div><span class="eyebrow">{{ s.kicker }}</span><h2>{{ s.headline }} <em>{{ s.accent }}</em></h2></div><a class="btn btn-ghost" href="{{ PathBase }}/news">All news <i class="bi bi-arrow-right"></i></a></div>
  <div class="grid3">{% for a in items.Items %}{% assign p = a.PublishedContent %}<a class="card reveal" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="im"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="bd"><span class="pill green">{{ p.topic | append: "" | capitalize }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ p.excerpt | truncatewords: 20 }}</p><p class="muted" style="margin-top:12px;font-size:.84rem">{{ p.published_on.Value | date: "%B %-d, %Y" }}</p></div></a>{% endfor %}</div>
</div></section>
