<h3>Member sign in</h3>
{% if Target.ValidationFailures["__ValidationSummary"] %}
  <div class="alert">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>
{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
  <label for="email">Email address</label>
  <input id="email" type="email" name="EmailAddress" autocomplete="email">
  <label for="password">Password</label>
  <input id="password" type="password" name="Password" autocomplete="current-password">
  <button type="submit">Sign in</button>
  <input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form>
<p style="margin:16px 0 0;font-size:.92rem"><a href="{{ PathBase }}/account/login/forgot-password/begin" style="text-decoration:underline">Forgot your password?</a></p>
<p class="muted" style="font-size:.9rem;margin-top:12px">Not a member yet? <a href="{{ PathBase }}/membership" style="text-decoration:underline;color:var(--ink)">See membership options</a>.</p>
{% if Target.ShowOrLoginWithSection %}
  <p class="muted" style="margin-top:18px">or sign in with</p>
  {% if Target.HasLoginByMagicLink %}<a href="{{ PathBase }}/account/login/magic-link" class="btn btn-ghost" style="width:100%;justify-content:center;margin:6px 0">{{ Target.MagicLink.LoginButtonText }}</a>{% endif %}
  {% if Target.HasLoginBySingleSignOn %}{% for sso in Target.SingleSignOns %}<a href="{{ PathBase }}/account/login/sso/{{ sso.DeveloperName }}" class="btn btn-ghost" style="width:100%;justify-content:center;margin:6px 0">{{ sso.LoginButtonText }}</a>{% endfor %}{% endif %}
{% endif %}
