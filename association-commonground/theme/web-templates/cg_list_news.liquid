{%- assign topics = "association:Association,chapters:Chapters,policy:Policy,growing:Growing" | split: "," -%}
{%- assign qt = "" -%}{%- for pair in topics %}{% assign kv = pair | split: ":" %}{% if QueryParams.topic == kv[0] %}{% assign qt = kv[0] %}{% endif %}{% endfor -%}
<section class="phead"><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><span>News</span></div>
  <h1>News from <em>the plots.</em></h1><p>Association updates, chapter stories, policy wins and practical growing notes from members across the country.</p></div></section>
<section class="section" style="padding-top:48px"><div class="wrap">
  <div class="filters"><span class="lbl">Topic</span><a href="{{ PathBase }}/news" class="{% if qt == '' %}on{% endif %}">All</a>{% for pair in topics %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/news?topic={{ kv[0] }}" class="{% if qt == kv[0] %}on{% endif %}">{{ kv[1] }}</a>{% endfor %}</div>
  {%- assign n = 0 -%}
  <div class="grid3">
  {%- for a in Target.Items %}{% assign p = a.PublishedContent %}{% capture tp %}{{ p.topic }}{% endcapture %}{% if qt == "" or qt == tp %}{% assign n = n | plus: 1 %}
    {% if n == 1 and qt == "" %}</div><a class="card reveal" href="{{ PathBase }}/{{ a.RoutePath }}" style="display:grid;grid-template-columns:1.2fr 1fr;margin-bottom:24px"><div class="im" style="aspect-ratio:auto;min-height:320px"><img src="{{ p.image.Value | attachment_redirect_url }}" alt=""></div><div class="bd" style="padding:36px;align-self:center"><span class="pill green">{{ p.topic | append: "" | capitalize }}</span><h3 style="font-size:2.1rem;margin:14px 0 12px">{{ a.PrimaryField }}</h3><p style="font-size:1.05rem">{{ p.excerpt }}</p><p class="muted" style="margin-top:16px;font-size:.88rem">{{ p.author }} · {{ p.published_on.Value | date: "%B %-d, %Y" }}</p></div></a><div class="grid3">
    {% else %}<a class="card reveal" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="im"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="bd"><span class="pill green">{{ p.topic | append: "" | capitalize }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ p.excerpt | truncatewords: 22 }}</p><p class="muted" style="margin-top:12px;font-size:.84rem">{{ p.published_on.Value | date: "%b %-d, %Y" }}</p></div></a>{% endif %}
  {%- endif %}{% endfor %}
  </div>
  {% if n == 0 %}<p class="muted">No stories in this topic yet.</p>{% endif %}
</div></section>
<style>@media(max-width:820px){a.card[style*="1.2fr"]{grid-template-columns:1fr!important}}</style>
