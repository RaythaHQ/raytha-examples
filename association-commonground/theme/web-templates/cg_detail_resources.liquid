{%- assign is_member = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_member = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- endif -%}
{%- assign kinds = "toolkit:Toolkit:bi-tools:#c8553d,template:Template:bi-file-earmark-text:#3f7d5a,recording:Recording:bi-camera-video:#2f6f8f,guide:Guide:bi-signpost-2:#c98f0f" | split: "," -%}
{%- assign p = Target.PublishedContent -%}{%- capture k %}{{ p.kind }}{% endcapture -%}{%- for pair in kinds %}{% assign kv = pair | split: ":" %}{% if kv[0] == k %}{% assign kl = kv[1] %}{% assign ki = kv[2] %}{% assign kc = kv[3] %}{% endif %}{% endfor -%}
<section class="section" style="padding-top:48px"><div class="wrap" style="max-width:900px">
  <div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/resources">Member resources</a><span>/</span><span>{{ kl }}</span></div>
  <div style="display:flex;gap:18px;align-items:center;margin:26px 0 14px"><div class="res" style="padding:0;border:0;background:none;display:block"><div class="ic" style="background:{{ kc }};width:64px;height:64px;font-size:1.6rem"><i class="bi {{ ki }}"></i></div></div><div><span class="pill">{{ kl }}</span> <span class="muted" style="font-size:.88rem;margin-left:6px">{{ p.meta }}</span></div></div>
  <h1 style="font-size:clamp(2.3rem,4.6vw,3.6rem);margin:0 0 16px">{{ Target.PrimaryField }}</h1>
  <p style="font-size:1.2rem;color:var(--ink2);margin:0 0 34px">{{ p.summary }}</p>
  {% if is_member %}
    <div class="box" style="padding:36px"><span class="pill green" style="margin-bottom:18px"><i class="bi bi-unlock-fill"></i> Member access</span><div class="prose">{{ p.body }}</div>
      <a class="btn btn-green" href="#" onclick="return false" style="margin-top:12px"><i class="bi bi-download"></i> Download ({{ p.meta }})</a></div>
  {% else %}
    <div class="lockwall"><span class="eyebrow" style="color:var(--mustard)">Members only</span><h2>This {{ kl | downcase }} is part of the member library.</h2>
      <p>Sign in with your member account to read and download it. Memberships start at $45 a year and include every toolkit, template and recording.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-clay" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right"></i> Member sign in</a><a class="btn btn-line" style="border-color:#fff;color:#fff" href="{{ PathBase }}/membership">Become a member</a></div></div>
  {% endif %}
</div></section>
