{%- assign p = Target.PublishedContent -%}{%- capture rg %}{{ p.region }}{% endcapture -%}
{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- capture f %}chapter eq '{{ Target.Id | append: "" }}'{% endcapture -%}{%- assign evs = get_content_items(ContentType="events", Filter=f, OrderBy="start asc", PageSize=20) -%}
<section class="phead" style="--c:{{ p.color }}"><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/chapters">Chapters</a><span>/</span><span>{{ Target.PrimaryField }}</span></div>
  <h1>{{ Target.PrimaryField }}</h1><p>{{ p.description }}</p>
  <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px"><span class="pill green"><i class="bi bi-geo-alt-fill"></i> {{ p.city }}, {{ p.state }}</span><span class="pill mustard"><i class="bi bi-people-fill"></i> {{ p.members }} members</span><span class="pill clay"><i class="bi bi-flower2"></i> {{ p.gardens }} gardens</span></div></div></section>
<section class="section" style="padding-top:56px"><div class="wrap split">
  <div>
    <span class="eyebrow">Chapter events</span><h2 style="font-size:2.3rem;margin:12px 0 18px">What's on in {{ p.city }}</h2>
    {%- assign n = 0 -%}
    <div>{% for e in evs.Items %}{% assign q = e.PublishedContent %}{% capture d %}{{ q.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% if d >= today %}{% assign n = n | plus: 1 %}
      <a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><div><b>{{ q.start.Value | date: "%-d" }}</b><span>{{ q.start.Value | date: "%b" }}</span></div></div><div><h3>{{ e.PrimaryField }}</h3><p class="muted" style="margin:0">{{ q.summary }}</p></div><span class="go btn btn-ghost">Details</span></a>{% endif %}{% endfor %}</div>
    {% if n == 0 %}<p class="muted">No upcoming events right now. Chapter meetings still happen: {{ p.meets }}.</p>{% endif %}
  </div>
  <aside class="aside">
    <div class="box"><h3>Chapter details</h3><div class="facts">
      <div><span>Chapter lead</span><b>{{ p.lead }}</b></div><div><span>Meets</span><b>{{ p.meets }}</b></div><div><span>Founded</span><b>{{ p.founded }}</b></div><div><span>Email</span><b><a href="mailto:{{ p.email }}" style="text-decoration:underline">{{ p.email }}</a></b></div></div></div>
    <div class="box" style="background:var(--green);color:#e8efe5;border:0"><h3 style="color:#fff">Join this chapter</h3><p style="margin:0 0 16px;color:#c7d4c6;font-size:.95rem">Every membership includes your local chapter. Pick a tier and choose {{ Target.PrimaryField }} when you sign up.</p><a class="btn btn-clay" href="{{ PathBase }}/membership">Membership options</a></div>
  </aside>
</div></section>
