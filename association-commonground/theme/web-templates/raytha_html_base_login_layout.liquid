<section class="auth">
  <div class="wrap auth-grid">
    <div>
      <span class="eyebrow">Members</span>
      <h1>Welcome back to <em>the garden.</em></h1>
      <p style="font-size:1.15rem;color:var(--ink2);max-width:520px">Sign in to open the member library: toolkits, legal templates, insurance guides and every webinar recording.</p>
      <div style="display:flex;gap:22px;margin-top:26px;flex-wrap:wrap;font-weight:600;color:var(--ink2)"><span><i class="bi bi-journal-richtext" style="color:var(--clay)"></i> Toolkits</span><span><i class="bi bi-file-earmark-text" style="color:var(--leaf)"></i> Templates</span><span><i class="bi bi-camera-video" style="color:var(--sky)"></i> Recordings</span></div>
    </div>
    <div class="card auth-card">
      {% renderbody %}
    </div>
  </div>
</section>
