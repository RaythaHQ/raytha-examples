{%- assign is_member = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign is_member = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_member = true -%}{%- endif -%}
{%- assign kinds = "toolkit:Toolkit:bi-tools:#c8553d,template:Template:bi-file-earmark-text:#3f7d5a,recording:Recording:bi-camera-video:#2f6f8f,guide:Guide:bi-signpost-2:#c98f0f" | split: "," -%}
<section class="phead"><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><span>Member resources</span></div>
  <h1>The member <em>library.</em></h1><p>Toolkits, legal templates, guides and webinar recordings written by gardeners and volunteer experts. Anyone can browse the list; members open the full resource.</p>
  <div style="margin-top:20px">{% if is_member %}<span class="pill green"><i class="bi bi-unlock-fill"></i> Signed in as a member. Everything is open.</span>{% else %}<span class="pill clay"><i class="bi bi-lock-fill"></i> Members only</span> <a href="{{ PathBase }}/account/login?returnUrl=/resources" style="text-decoration:underline;font-weight:600;margin-left:8px">Sign in</a>{% endif %}</div></div></section>
<section class="section" style="padding-top:48px"><div class="wrap">
  {%- assign qk = "" -%}{%- for pair in kinds %}{% assign kv = pair | split: ":" %}{% if QueryParams.kind == kv[0] %}{% assign qk = kv[0] %}{% endif %}{% endfor -%}
  <div class="filters"><span class="lbl">Type</span><a href="{{ PathBase }}/resources" class="{% if qk == '' %}on{% endif %}">All</a>{% for pair in kinds %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/resources?kind={{ kv[0] }}" class="{% if qk == kv[0] %}on{% endif %}">{{ kv[1] }}s</a>{% endfor %}</div>
  <div style="display:grid;gap:12px">
  {%- for r in Target.Items %}{% assign p = r.PublishedContent %}{% capture k %}{{ p.kind }}{% endcapture %}{% if qk == "" or qk == k %}{% for pair in kinds %}{% assign kv = pair | split: ":" %}{% if kv[0] == k %}{% assign kl = kv[1] %}{% assign ki = kv[2] %}{% assign kc = kv[3] %}{% endif %}{% endfor %}
    <a class="res reveal" href="{{ PathBase }}/{{ r.RoutePath }}"><div class="ic" style="background:{{ kc }}"><i class="bi {{ ki }}"></i></div>
      <div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><h3>{{ r.PrimaryField }}</h3><span class="pill">{{ kl }}</span></div><p>{{ p.summary }}</p></div>
      <span class="muted" style="font-size:.85rem;text-align:right">{% if is_member %}<i class="bi bi-unlock" style="color:var(--leaf)"></i> Open{% else %}<i class="bi bi-lock-fill" style="color:var(--clay)"></i> Members{% endif %}<br><span style="font-size:.8rem">{{ p.meta }}</span></span></a>
  {%- endif %}{% endfor %}
  </div>
</div></section>
<style>@media(max-width:640px){.res{grid-template-columns:44px 1fr}.res>span:last-child{display:none}.res .ic{width:44px;height:44px}}</style>
