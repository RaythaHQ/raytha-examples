{%- assign p = Target.PublishedContent -%}
{%- assign more = get_content_items(ContentType="news", OrderBy="published_on desc", PageSize=4) -%}
<article class="section" style="padding-top:48px"><div class="wrap" style="max-width:820px">
  <div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/news">News</a><span>/</span><span>{{ p.topic | append: "" | capitalize }}</span></div>
  <h1 style="font-size:clamp(2.4rem,5vw,3.8rem);margin:20px 0 16px">{{ Target.PrimaryField }}</h1>
  <p style="font-size:1.22rem;color:var(--ink2);margin:0 0 20px">{{ p.excerpt }}</p>
  <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:.92rem;margin-bottom:30px"><span class="pill green">{{ p.topic | append: "" | capitalize }}</span><span>{{ p.author }}</span><span>·</span><span>{{ p.published_on.Value | date: "%B %-d, %Y" }}</span></div>
</div>
<div class="wrap" style="max-width:1040px"><div class="card" style="margin-bottom:40px"><div class="im" style="aspect-ratio:16/7"><img src="{{ p.image.Value | attachment_redirect_url }}" alt=""></div></div></div>
<div class="wrap" style="max-width:720px"><div class="prose" style="font-size:1.12rem">{{ p.body }}</div></div></article>
<section class="section band tight"><div class="wrap"><div class="shead"><h2 style="font-size:2rem">More news</h2><a class="btn btn-ghost" href="{{ PathBase }}/news">All news</a></div>
  <div class="grid3">{% assign k = 0 %}{% for a in more.Items %}{% if a.Id != Target.Id and k < 3 %}{% assign k = k | plus: 1 %}{% assign q = a.PublishedContent %}<a class="card" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="im"><img src="{{ q.image.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="bd"><span class="pill green">{{ q.topic | append: "" | capitalize }}</span><h3>{{ a.PrimaryField }}</h3></div></a>{% endif %}{% endfor %}</div></div></section>
