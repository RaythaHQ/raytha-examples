<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/board">Board</a></li><li>Policies</li></ol><p class="kick">Board policy manual</p><h1>Policies</h1><p class="lede">The rules the board has adopted, by series. Policies under review show which reading they are on, and link to the meeting where the board will take them up.</p></div></div>
<section class="sec tight"><div class="w">{%- assign ss = "1000:Community,2000:Administration,3000:Business and operations,4000:Students,5000:Staff,6000:Instruction" | split: "," -%}{% for s in ss %}{%- assign sp = s | split: ":" -%}{%- assign cnt=0 -%}{% for p in Target.Items %}{%- capture se -%}{{ p.PublishedContent.series }}{%- endcapture -%}{% if se == sp[0] %}{%- assign cnt = cnt | plus: 1 -%}{% endif %}{% endfor %}{% if cnt > 0 %}<h2 style="font-size:1.3rem;margin:30px 0 12px"><span class="mono">{{ sp[0] }}</span> · {{ sp[1] }}</h2><div class="rowl">{% for p in Target.Items %}{%- assign y=p.PublishedContent -%}{%- capture se -%}{{ y.series }}{%- endcapture -%}{%- capture rv -%}{{ y.review }}{%- endcapture -%}{% if se == sp[0] %}<a class="row" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="mono" style="font-size:1.4rem;font-weight:700">{{ y.number }}</span><div><b>{{ p.PrimaryField }}</b><p>{{ y.summary }}</p></div><div style="text-align:right">{% if rv != "current" %}<span class="aud families">{% capture rvl -%}{{ y.review }}{%- endcapture %}{{ rvl | replace: "current","Current" | replace: "first","First reading" | replace: "second","Second reading" }}</span>{% else %}<span class="aud public">Current</span>{% endif %}<div class="mono muted" style="font-size:12.5px;margin-top:6px">rev. {{ y.revised }}</div></div></a>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}</div></section>
