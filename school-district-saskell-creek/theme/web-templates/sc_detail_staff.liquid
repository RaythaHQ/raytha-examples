{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}{%- assign x=Target.PublishedContent -%}{%- capture code -%}{{ x.school }}{%- endcapture -%}{%- assign sn="District office" -%}{%- assign sn_url="" -%}{% for q in sch.Items %}{%- capture qc -%}{{ q.PublishedContent.code }}{%- endcapture -%}{% if qc == code %}{%- assign sn=q.PrimaryField -%}{%- capture sn_url -%}{{ PathBase }}/{{ q.RoutePath }}{%- endcapture -%}{% endif %}{% endfor %}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/staff">Staff directory</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ x.dept }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.role }} · {% if sn_url != "" %}<a href="{{ sn_url }}">{{ sn }}</a>{% else %}District office{% endif %}</p></div></div>
<section class="sec tight"><div class="w"><div class="pass" style="max-width:860px"><div class="l"><p class="kick">Staff card</p><h2>{{ Target.PrimaryField }}</h2><p class="muted" style="margin-top:10px">{{ x.summary }}</p></div><div class="r"><div class="big" style="font-size:3.4rem">{{ x.initials }}</div><dl><dt>Room</dt><dd>{{ x.room }}</dd><dt>Phone</dt><dd>(555) 014-{{ x.ext }}</dd><dt>Email</dt><dd style="font-size:.86rem">{{ x.email }}</dd></dl></div></div></div></section>
