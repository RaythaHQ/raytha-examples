{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff directory</li></ol><p class="kick">Staff directory</p><h1>Who to call</h1><p class="lede">District office staff, principals, teachers and counselors. Everyone listed is fictional; email addresses use an example domain.</p></div></div>
<section class="sec tight"><div class="w">{%- capture codes -%}district{% for s in sch.Items %},{{ s.PublishedContent.code }}{% endfor %}{%- endcapture -%}{%- assign grp = codes | split: "," -%}
{% for g in grp %}{%- assign cnt=0 -%}{% for p in Target.Items %}{%- capture pc -%}{{ p.PublishedContent.school }}{%- endcapture -%}{% if pc == g %}{%- assign cnt = cnt | plus: 1 -%}{% endif %}{% endfor %}{% if cnt > 0 %}{%- assign sn="District office" -%}{%- assign sn_url="" -%}{% for q in sch.Items %}{%- capture qc -%}{{ q.PublishedContent.code }}{%- endcapture -%}{% if qc == g %}{%- assign sn=q.PrimaryField -%}{%- capture sn_url -%}{{ PathBase }}/{{ q.RoutePath }}{%- endcapture -%}{% endif %}{% endfor %}<h2 style="font-size:1.3rem;margin:34px 0 12px">{% if sn_url != "" %}<a href="{{ sn_url }}" style="text-decoration:none">{{ sn }} →</a>{% else %}District office · 100 Commons Street{% endif %}</h2><table class="tbl"><thead><tr><th>Name</th><th>Role</th><th>Department</th><th>Room</th><th>Phone</th><th>Email</th></tr></thead><tbody>{% for p in Target.Items %}{%- assign z=p.PublishedContent -%}{%- capture pc -%}{{ z.school }}{%- endcapture -%}{% if pc == g %}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a></td><td>{{ z.role }}</td><td>{{ z.dept }}</td><td class="mono">{{ z.room }}</td><td class="mono">(555) 014-{{ z.ext }}</td><td class="mono" style="font-size:.86rem">{{ z.email }}</td></tr>{% endif %}{% endfor %}</tbody></table>{% endif %}{% endfor %}</div></section>
