<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Saskell Creek Public Schools" %}{{ Target.Title }} | {% endif %}Saskell Creek Public Schools — PreK–12 public school district</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Saskell Creek Public Schools (fictional) is a PreK–12 public school district of sixteen schools on three feeder lines. A school district website built on Raytha, a self-hosted, open-source .NET CMS for public schools, with members-only family and staff areas.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;500;600;700&family=Atkinson+Hyperlegible+Next:wght@400;500;600;700;800&display=swap" rel="stylesheet"><style>
:root{--paper:#f7f4ec;--card:#fffdf8;--ink:#1d2433;--ink2:#4a5366;--ink3:#6b7385;--rule:#ddd6c6;--bus:#f6b800;--bus2:#fff3c4;--ridge:#0f7c74;--creek:#c8402a;--mill:#6a4bc4;--shared:#5b6475;--board:#141b27;--ok:#1f7a3f;--sans:"Atkinson Hyperlegible Next","Atkinson Hyperlegible",system-ui,sans-serif;--mono:"Atkinson Hyperlegible Mono",ui-monospace,monospace}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:400 18px/1.6 var(--sans)}
a{color:inherit}img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--bus);outline-offset:3px;box-shadow:0 0 0 6px var(--ink)}
.skip{position:absolute;left:-999px;top:8px;background:var(--bus);color:var(--ink);padding:10px 16px;font-weight:700;z-index:9}.skip:focus{left:12px}
.w{max-width:1240px;margin:0 auto;padding:0 32px}
h1,h2,h3,h4{font-family:var(--sans);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:0}
h1{font-size:clamp(2.3rem,4.4vw,3.9rem)}h2{font-size:clamp(1.6rem,2.6vw,2.3rem)}h3{font-size:1.25rem;letter-spacing:-.01em}
p{margin:0 0 1em}.mono{font-family:var(--mono)}.muted{color:var(--ink2)}
.kick{font:600 13px/1.3 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);display:flex;align-items:center;gap:10px;margin:0 0 14px}
.kick::before{content:"";width:22px;height:6px;border-radius:3px;background:var(--bus)}
.btn{display:inline-flex;align-items:center;gap:10px;background:var(--ink);color:#fff;text-decoration:none;font:700 1rem var(--sans);padding:14px 22px;border-radius:999px;border:2px solid var(--ink);cursor:pointer}
.btn:hover{background:#000}.btn.y{background:var(--bus);color:var(--ink);border-color:var(--bus)}.btn.line{background:transparent;color:var(--ink)}.btn.sm{padding:9px 16px;font-size:.92rem}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
/* status strip + utility */
.strip{background:var(--bus);color:var(--ink);font-size:.98rem}
.strip .w{display:flex;gap:16px;align-items:center;padding-top:10px;padding-bottom:10px}
.strip b.tag{font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;background:var(--ink);color:var(--bus);padding:4px 9px;border-radius:4px;white-space:nowrap}
.strip a{font-weight:700;white-space:nowrap}
.util{background:var(--ink);color:#d8dce6;font-size:.9rem}
.util .w{display:flex;justify-content:space-between;align-items:center;gap:18px;padding-top:8px;padding-bottom:8px}
.util a{color:#fff;text-decoration:none;font-weight:600}.util a:hover{text-decoration:underline}
.util .r{display:flex;gap:20px;align-items:center}
.util form input{background:#2a3347;border:1px solid #3d4760;color:#fff;border-radius:999px;padding:6px 14px;font:inherit;width:200px}
.fict{font:600 12px var(--mono);letter-spacing:.06em;color:var(--bus)}
/* header + line nav */
.hdr{background:var(--card);border-bottom:1px solid var(--rule)}
.hdr .w{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-top:18px;padding-bottom:18px}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.brand b{display:block;font-size:1.32rem;font-weight:800;letter-spacing:-.02em;line-height:1.05}.brand small{display:block;font:500 12.5px var(--mono);color:var(--ink2);margin-top:4px;letter-spacing:.04em}
.lnav ol{list-style:none;margin:0;padding:0;display:flex;position:relative}
.lnav ol::before{content:"";position:absolute;left:14px;right:14px;top:9px;height:5px;border-radius:3px;background:linear-gradient(90deg,var(--ridge) 0 33%,var(--creek) 33% 66%,var(--mill) 66%)}
.lnav li{position:relative;padding-top:24px}
.lnav li::before{content:"";position:absolute;top:2px;left:50%;margin-left:-9px;width:18px;height:18px;border-radius:50%;background:#fff;border:4px solid var(--ink)}
.lnav a{display:block;padding:4px 13px;text-decoration:none;font-weight:700;font-size:.98rem;white-space:nowrap}
.lnav a:hover{text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:5px}
/* sections */
.sec{padding:72px 0;border-top:1px solid var(--rule)}.sec.tight{padding:44px 0}.sec.dark{background:var(--board);color:#fff;border:0}
.shead{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}.shead p{color:var(--ink2);max-width:640px;margin:10px 0 0}.dark .shead p{color:#b7c0d1}
.phead{padding:56px 0 40px;background:var(--card);border-bottom:1px solid var(--rule)}
.phead .lede{font-size:1.18rem;color:var(--ink2);max-width:760px;margin-top:16px}
.crumbs{list-style:none;padding:0;margin:0 0 20px;display:flex;gap:8px;flex-wrap:wrap;font:500 14px var(--mono);color:var(--ink2)}.crumbs li+li::before{content:"→ "}.crumbs a{color:var(--ink2)}
/* hero */
.hero{background:var(--card);border-bottom:1px solid var(--rule);padding:38px 0 60px;position:relative;overflow:hidden}
.hero .g{display:grid;grid-template-columns:1.35fr .85fr;gap:56px;align-items:start}
.hero h1{font-size:clamp(2.2rem,3.6vw,3.15rem)}.hero .lede{font-size:1.2rem;color:var(--ink2);max-width:560px;margin-top:20px}
.today{background:var(--ink);color:#fff;border-radius:22px;padding:26px 26px 20px;position:relative;box-shadow:0 20px 50px -24px rgba(20,27,39,.6)}
.today::after{content:"";position:absolute;left:26px;right:26px;top:-9px;height:18px;background:radial-gradient(circle at 9px 9px,var(--card) 7px,transparent 8px) 0 0/28px 18px repeat-x}
.today .d{font:600 13px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--bus)}
.today h2{font-size:1.7rem;margin:8px 0 16px;color:#fff}
.tally{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}
.tally div{background:#273046;border-radius:12px;padding:12px}.tally b{display:block;font:700 1.9rem/1 var(--mono)}.tally span{font-size:.84rem;color:#c6cddb}
.today .lunch{border-top:2px dashed #3d4760;padding-top:14px;font-size:.98rem}.today .lunch small{display:block;font:600 12px var(--mono);color:#aab3c5;letter-spacing:.08em;text-transform:uppercase;margin-bottom:4px}
.today a{color:var(--bus)}
/* map */
.mapcard{background:var(--card);border:1px solid var(--rule);border-radius:24px;padding:26px 26px 10px;background-image:linear-gradient(var(--rule) 1px,transparent 1px),linear-gradient(90deg,var(--rule) 1px,transparent 1px);background-size:40px 40px;background-position:-1px -1px}
.mapcard svg{width:100%;height:auto;display:block}
.mapcard svg a:hover circle,.mapcard svg a:focus circle{stroke:var(--bus);stroke-width:7}
.mapcard svg text{font-family:var(--sans)}
.legend{display:flex;gap:18px;flex-wrap:wrap;margin:0 0 6px;font-weight:700}.legend span{display:inline-flex;align-items:center;gap:8px}.legend i{width:30px;height:8px;border-radius:4px;display:inline-block}
.stack{display:none}
/* line strips (list + mobile map) */
.lines{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.lcol h3{display:flex;align-items:center;gap:10px;padding:14px 16px;border-radius:14px;color:#fff;margin-bottom:6px}
.lcol h3 small{font:600 12px var(--mono);opacity:.85;margin-left:auto}
.stops{list-style:none;margin:0;padding:6px 0 0 0;position:relative}
.stops::before{content:"";position:absolute;left:21px;top:10px;bottom:30px;width:8px;border-radius:4px;background:var(--lc)}
.stops li{position:relative;padding-left:58px;margin-bottom:12px}
.stops li::before{content:"";position:absolute;left:12px;top:20px;width:26px;height:26px;border-radius:50%;background:#fff;border:5px solid var(--ink);box-sizing:border-box}
.stops li.hub::before{width:34px;height:34px;left:8px;top:16px;border-width:6px}
.stops a{display:block;background:var(--card);border:1px solid var(--rule);border-radius:14px;padding:12px 16px;text-decoration:none}
.stops a:hover{border-color:var(--ink)}
.stops b{display:block;font-size:1.04rem}.stops span{font:500 13px var(--mono);color:var(--ink2)}
/* departure board */
.boardx{background:var(--board);border-radius:20px;padding:10px 0;border:6px solid #0b111b;box-shadow:inset 0 0 0 1px #2a3347}
.dep{width:100%;border-collapse:collapse;font-family:var(--mono)}
.dep th{font:600 12px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#8d97ab;text-align:left;padding:12px 18px;border-bottom:1px solid #2a3347}
.dep td{padding:12px 18px;border-bottom:1px solid #222b3c;color:var(--bus);font-size:1.02rem;vertical-align:middle}
.dep tr:last-child td{border-bottom:0}
.dep td.s a{color:#fff;text-decoration:none;font-family:var(--sans);font-weight:700}.dep td.s a:hover{text-decoration:underline}
.dep td.s small{display:block;color:#8d97ab;font:500 12.5px var(--mono)}
.chipl{display:inline-flex;align-items:center;justify-content:center;min-width:64px;height:28px;border-radius:14px;color:#fff;font:700 12px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:0 10px}
.st{display:inline-flex;align-items:center;gap:8px;font:700 13px var(--mono);letter-spacing:.04em;text-transform:uppercase;padding:5px 11px;border-radius:6px;background:#1f3a2a;color:#9be3b3;white-space:nowrap}
.st::before{content:"●"}.st.delayed{background:#4a3a0c;color:#ffd75e}.st.delayed::before{content:"◐"}.st.early_release{background:#41254f;color:#e4c2ff}.st.early_release::before{content:"◑"}.st.closed{background:#5a1d14;color:#ffb3a6}.st.closed::before{content:"✕"}
.lightst{background:#e3f2e8;color:#16542c}.lightst.delayed{background:#fff0c2;color:#6b4c00}.lightst.early_release{background:#efe6fb;color:#4a2b80}.lightst.closed{background:#fde2dc;color:#8a2414}
.note{color:#ffd75e;font:500 13px var(--mono);display:block;margin-top:4px}
/* lunch trays */
.trays{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}
.tray{background:#cfd8d6;border-radius:22px;padding:12px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto 1fr auto;gap:8px;box-shadow:inset 0 -6px 0 rgba(0,0,0,.08);text-decoration:none}
.tray.sec2{background:#d9d2e8}
.tray .dy{grid-column:1/3;display:flex;justify-content:space-between;font:700 13px var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:2px 6px}
.tray .cp{background:var(--card);border-radius:14px;padding:10px 12px;box-shadow:inset 0 2px 5px rgba(0,0,0,.12);font-size:.92rem;line-height:1.3}
.tray .cp.main{grid-column:1/3;min-height:96px}.tray .cp.main b{display:block;font-size:1.04rem;margin-bottom:4px}
.tray .cp small{display:block;font:600 11px var(--mono);color:var(--ink3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:3px}
.tray .al{grid-column:1/3;display:flex;gap:5px;flex-wrap:wrap;padding:2px 4px}
.al span,.alg span{font:700 11px var(--mono);background:var(--ink);color:#fff;padding:3px 7px;border-radius:4px}
.tray.is-today{outline:4px solid var(--bus);outline-offset:3px}
.tray .tn{grid-column:1/3;font-size:.84rem;color:var(--ink2);padding:0 4px}
/* events */
.ev{display:grid;grid-template-columns:88px 1fr auto;gap:18px;align-items:center;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none}
.ev:hover b{text-decoration:underline}
.date{background:var(--card);border:2px solid var(--ink);border-radius:12px;text-align:center;padding:6px 0;line-height:1.05}
.date span{display:block;font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}.date b{display:block;font:800 1.8rem var(--sans)}
.ev p{margin:2px 0 0;color:var(--ink2);font-size:.95rem}
.k{font:700 12px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:5px 10px;border-radius:6px;border:2px solid var(--ink);white-space:nowrap;background:var(--card)}
.k.noschool{background:var(--ink);color:var(--bus)}.k.early{background:var(--bus2)}.k.arts{background:#efe6fb}.k.athletics{background:#e0efec}.k.testing{background:#fde2dc}.k.pd{background:#e6e9ef}
.g2{display:grid;grid-template-columns:1.4fr 1fr;gap:44px}
.mtg{background:var(--card);border:2px solid var(--ink);border-radius:20px;padding:24px}
.mtg ol{margin:14px 0 0;padding:0;list-style:none;counter-reset:a}
.mtg li{counter-increment:a;display:grid;grid-template-columns:34px 1fr;gap:10px;padding:8px 0;border-top:1px dashed var(--rule);font-size:.96rem}
.mtg li::before{content:counter(a);font:700 13px var(--mono);width:26px;height:26px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center}
.mtg li small{display:block;color:var(--ink2)}
/* news */
.news{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:24px}
.card{background:var(--card);border:1px solid var(--rule);border-radius:18px;overflow:hidden;text-decoration:none;display:flex;flex-direction:column}
.card:hover{border-color:var(--ink)}.card img{aspect-ratio:16/9;object-fit:cover;width:100%}
.card .b{padding:18px 20px 20px}.card h3{margin:6px 0 8px}.card p{color:var(--ink2);font-size:.96rem;margin:0}
.card .m{font:600 12.5px var(--mono);color:var(--ink2);letter-spacing:.04em}
.news .card:first-child{grid-row:span 2}.news .card:first-child h3{font-size:1.6rem}
/* pass */
.pass{display:grid;grid-template-columns:1.2fr 1fr;border-radius:24px;overflow:hidden;background:var(--card);border:2px solid var(--ink)}
.pass .l{padding:30px}.pass .r{background:var(--ink);color:#fff;padding:30px;position:relative}
.pass .r::before{content:"";position:absolute;left:-12px;top:0;bottom:0;width:24px;background:radial-gradient(circle at 12px 12px,var(--paper) 9px,transparent 10px) 0 0/24px 30px repeat-y}
.pass dl{display:grid;grid-template-columns:auto 1fr;gap:6px 18px;margin:14px 0 0;font-size:.98rem}.pass dt{font:600 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);padding-top:4px}.pass .r dt{color:#aab3c5}.pass dd{margin:0;font-weight:700}
.big{font:800 2.6rem/1 var(--mono);color:var(--bus)}
/* tables, panels */
.tbl{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--rule);border-radius:16px;overflow:hidden}
.tbl th{text-align:left;font:600 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);padding:12px 16px;border-bottom:2px solid var(--ink);background:#f1ede2}
.tbl td{padding:12px 16px;border-bottom:1px solid var(--rule);vertical-align:top}.tbl tr:last-child td{border-bottom:0}
.tbl a{font-weight:700}
.panel{background:var(--card);border:1px solid var(--rule);border-radius:18px;padding:24px;margin-bottom:20px}
.panel h3{margin-bottom:12px}
.side{display:flex;flex-direction:column;gap:18px}
.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 18px;margin:0}.facts dt{font:600 12px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink2);padding-top:4px}.facts dd{margin:0;font-weight:600}
.prose{max-width:740px;font-size:1.08rem}.prose h2{font-size:1.5rem;margin:30px 0 10px}.prose ul,.prose ol{padding-left:1.3em}.prose li{margin-bottom:6px}
.dg{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:48px;align-items:start}
.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{display:inline-block;font:600 13px var(--mono);border:2px solid var(--ink);border-radius:999px;padding:4px 12px;text-decoration:none;background:var(--card)}
.lock{background:repeating-linear-gradient(135deg,var(--card) 0 14px,#f3eedf 14px 28px);border:3px solid var(--ink);border-radius:20px;padding:30px;max-width:820px}
.lock h2{margin:14px 0 10px}.lock .pill{display:inline-block;font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;background:var(--ink);color:var(--bus);padding:5px 11px;border-radius:5px}
.aud{font:700 12px var(--mono);letter-spacing:.04em;padding:4px 9px;border-radius:6px;white-space:nowrap}.aud.public{background:#e3f2e8;color:#16542c}.aud.families{background:var(--bus2);color:#6b4c00}.aud.staff{background:#e6e9ef;color:#2a3347}
.rowl{display:grid;gap:10px}.row{display:grid;grid-template-columns:120px 1fr auto;gap:18px;align-items:center;background:var(--card);border:1px solid var(--rule);border-radius:14px;padding:14px 18px;text-decoration:none}.row:hover{border-color:var(--ink)}.row p{margin:2px 0 0;color:var(--ink2);font-size:.94rem}
.row .t{font:600 12.5px var(--mono);color:var(--ink2);text-transform:uppercase;letter-spacing:.06em}
/* school strip */
.strip2{display:flex;align-items:center;margin:26px 0 6px;overflow-x:auto;padding:8px 2px 4px}
.strip2 a,.strip2 span.cur{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;font-size:.88rem;font-weight:700;width:120px;text-align:center;position:relative}
.strip2 a::before,.strip2 span.cur::before{content:"";position:absolute;top:13px;left:-50%;width:100%;height:8px;background:var(--lc);z-index:0}
.strip2 > :first-child::before{display:none}
.strip2 i{width:30px;height:30px;border-radius:50%;background:#fff;border:6px solid var(--ink);position:relative;z-index:1}
.strip2 span.cur i{background:var(--bus);width:36px;height:36px;margin-top:-3px}
.strip2 span.cur em{font:700 11px var(--mono);font-style:normal;background:var(--bus);padding:2px 6px;border-radius:4px;letter-spacing:.06em;text-transform:uppercase}
.shero{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;align-items:center}
.shero img{border-radius:22px;border:2px solid var(--ink)}
/* calendar */
.months{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.month h3{margin-bottom:12px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal .hd{font:700 12px var(--mono);text-align:center;color:var(--ink2);padding:4px 0;letter-spacing:.08em}
.cal .d{background:var(--card);border:1px solid var(--rule);border-radius:8px;min-height:92px;padding:6px;font-size:.78rem;line-height:1.2}
.cal .d.x{background:transparent;border-color:transparent}.cal .d.we{background:#efeadd}
.cal .d b.n{font:700 13px var(--mono);display:block;margin-bottom:4px}
.cal .d a{display:block;text-decoration:none;border-left:4px solid var(--ink);padding:2px 5px;margin-bottom:3px;background:#f1ede2;border-radius:0 4px 4px 0;font-weight:600}
.cal .d a.noschool{background:var(--ink);color:var(--bus);border-color:var(--bus)}.cal .d a.early{background:var(--bus2);border-color:var(--bus)}.cal .d a.arts{border-color:var(--mill)}.cal .d a.athletics{border-color:var(--ridge)}.cal .d a.testing{border-color:var(--creek)}.cal .d a.board{border-color:var(--ink);background:#e6e9ef}
.cal .d.nos{background:#fff3c4}
/* foot */
.foot{background:var(--ink);color:#c9cfdb;padding:56px 0 26px;margin-top:0}
.foot .fg{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:34px}
.foot h4{color:#fff;font-size:1rem;margin-bottom:12px}.foot ul{list-style:none;margin:0;padding:0}.foot li{margin-bottom:8px}.foot a{color:#fff;text-decoration:none}.foot a:hover{text-decoration:underline}
.foot .disc{border-top:1px solid #3d4760;margin-top:36px;padding-top:18px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;font:500 13px var(--mono);color:#9aa3b6}
.figs{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.figs div{background:var(--card);border:2px solid var(--ink);border-radius:18px;padding:22px}.figs b{display:block;font:800 2.6rem/1 var(--mono)}.figs span{color:var(--ink2)}
.ol2{list-style:none;padding:0;margin:20px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;counter-reset:s}
.ol2 li{counter-increment:s;background:var(--card);border:1px solid var(--rule);border-radius:16px;padding:18px;position:relative;border-top:8px solid var(--ridge)}
.ol2 li:nth-child(3n+2){border-top-color:var(--creek)}.ol2 li:nth-child(3n){border-top-color:var(--mill)}
.ol2 li::before{content:"Stop " counter(s);font:700 12px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
.ol2.ag li::before{content:"Item " counter(s)}.side>.btn{align-self:flex-start}.ol2 h3{margin:6px 0 6px;font-size:1.12rem}.ol2 p{margin:0;color:var(--ink2);font-size:.96rem}
.searchbar{display:flex;gap:10px;margin-top:22px;max-width:640px}.searchbar input{flex:1;font:inherit;padding:13px 18px;border:2px solid var(--ink);border-radius:999px;background:#fff}
.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none}.hit b{font-size:1.08rem}.hit p{margin:4px 0 0;color:var(--ink2)}
label{font-weight:700;display:block;margin-bottom:6px}input[type=email],input[type=password]{width:100%;font:inherit;padding:12px 14px;border:2px solid var(--ink);border-radius:10px;background:#fff}
@media(max-width:1100px){.lnav a{padding:4px 8px;font-size:.92rem}.hdr .w{flex-direction:column;align-items:flex-start;gap:14px}.lnav{overflow-x:auto;max-width:100%}}
@media(max-width:900px){.hero .g,.g2,.dg,.shero,.months,.pass{grid-template-columns:1fr}.lines{grid-template-columns:1fr}.trays{grid-template-columns:repeat(2,1fr)}.news{grid-template-columns:1fr}.news .card:first-child{grid-row:auto}.foot .fg{grid-template-columns:1fr 1fr}.figs{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.tbl{display:block;overflow-x:auto}.dep thead{display:none}.dep tr{display:grid;grid-template-columns:auto auto 1fr;gap:6px 16px;padding:12px 14px;border-bottom:1px solid #222b3c}.dep td{padding:0;border:0}.dep td.s{grid-column:1/4}.dep td:last-child{grid-column:1/4}.shead{flex-wrap:wrap;align-items:flex-start}body{font-size:17px}.w{padding:0 18px}.util .r .hm,.util form{display:none}.strip .w{flex-wrap:wrap;gap:8px}
.mapcard{display:none}.stack{display:block}.dep th.hm,.dep td.hm{display:none}.dep td,.dep th{padding:10px 12px}
.trays{grid-template-columns:1fr}.ev{grid-template-columns:70px 1fr}.ev .k{grid-column:2;justify-self:start}.row{grid-template-columns:1fr}.cal .d{min-height:54px;font-size:0}.cal .d b.n{font-size:12px}.cal .d a{height:6px;padding:0;margin-bottom:2px}
.sec{padding:48px 0}.hero{padding:36px 0 44px}.tally b{font-size:1.5rem}.lnav li::before{width:14px;height:14px;margin-left:-7px;border-width:3px}.lnav ol::before{top:7px}.lnav a{font-size:.88rem;padding:4px 7px}.figs{grid-template-columns:1fr}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
{%- assign pin = get_content_items(ContentType="news", Filter="pinned eq 'yes'", OrderBy="sort_order asc", PageSize=1) -%}{% for p in pin.Items %}<div class="strip" role="status"><div class="w"><b class="tag">Today</b><span>{{ p.PublishedContent.summary }}</span><a href="{{ PathBase }}/{{ p.RoutePath }}">Details →</a></div></div>{% endfor %}
<div class="util"><div class="w"><span class="fict">FICTIONAL DISTRICT · RAYTHA EXAMPLE SITE</span><div class="r"><a class="hm" href="{{ PathBase }}/new-families">New families</a><a class="hm" href="{{ PathBase }}/accessibility">Accessibility</a>{% if CurrentUser.IsAuthenticated %}<span>Signed in as <b style="color:#fff">{{ CurrentUser.FirstName }}</b></span><a href="{{ PathBase }}/families">Family hub</a><a href="{{ PathBase }}/account/logout">Sign out</a>{% else %}<a href="{{ PathBase }}/account/login?returnUrl=/families">Family &amp; staff sign-in</a>{% endif %}<form action="{{ PathBase }}/search" role="search"><input name="q" aria-label="Search the district site" placeholder="Search: lunch, bus, policy…"></form></div></div></div>
<header class="hdr"><div class="w"><a class="brand" href="{{ PathBase }}/"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><path d="M4 8 H18 Q26 8 30 18 L34 23" stroke="#0f7c74" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M4 23 H34" stroke="#c8402a" stroke-width="5" stroke-linecap="round"/><path d="M4 38 H18 Q26 38 30 28 L34 23" stroke="#6a4bc4" stroke-width="5" fill="none" stroke-linecap="round"/><circle cx="36" cy="23" r="8" fill="#f6b800" stroke="#1d2433" stroke-width="3.5"/></svg><span><b>Saskell Creek Public Schools</b><small>PreK–12 · 16 schools · 3 feeder lines</small></span></a>
<nav class="lnav" aria-label="Main"><ol>{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ol></nav></div></header>
<main id="main">{% renderbody %}</main>
<footer class="foot"><div class="w"><div class="fg"><div><div style="display:flex;gap:12px;align-items:center"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><path d="M4 8 H18 Q26 8 30 18 L34 23" stroke="#0f7c74" stroke-width="5" fill="none" stroke-linecap="round"/><path d="M4 23 H34" stroke="#c8402a" stroke-width="5" stroke-linecap="round"/><path d="M4 38 H18 Q26 38 30 28 L34 23" stroke="#6a4bc4" stroke-width="5" fill="none" stroke-linecap="round"/><circle cx="36" cy="23" r="8" fill="#f6b800" stroke="#1d2433" stroke-width="3.5"/></svg><b style="color:#fff;font-size:1.2rem">Saskell Creek Public Schools</b></div><p style="margin-top:14px;max-width:380px">District office, 100 Commons Street, Saskell Creek. (555) 014-1000 · 7:30 am to 4:30 pm on school days. The district, its schools, people and figures are fictional; this is a Raytha example site.</p></div>
<div><h4>Schools</h4><ul><li><a href="{{ PathBase }}/schools">All schools by line</a></li><li><a href="{{ PathBase }}/calendar">District calendar</a></li><li><a href="{{ PathBase }}/lunch">Lunch menus</a></li><li><a href="{{ PathBase }}/staff">Staff directory</a></li></ul></div>
<div><h4>Board of education</h4><ul><li><a href="{{ PathBase }}/board">Meetings and agendas</a></li><li><a href="{{ PathBase }}/policies">Policy manual</a></li><li><a href="{{ PathBase }}/news">News</a></li></ul></div>
<div><h4>Families and staff</h4><ul>{%- assign fm = get_menu("footer") -%}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div></div>
<div class="disc"><span>© 2026 Saskell Creek Public Schools (fictional) · phone numbers use the 555 range · no payment, registration or enrollment forms on this site.</span><span>Server-rendered with Raytha · works without JavaScript</span></div></div></footer></body></html>
