{%- assign x=Target.PublishedContent -%}{%- capture ms -%}{{ x.status }}{%- endcapture -%}{%- assign pols = get_content_items(ContentType="policies", OrderBy="sort_order asc", PageSize=60) -%}{%- assign pl = x.policies | split: "|" -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/board">Board</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{% capture mkl -%}{{ x.kind }}{%- endcapture %}{{ mkl | replace: "regular","Regular meeting" | replace: "special","Special meeting" | replace: "work","Work session" }} · {% capture msl -%}{{ x.status }}{%- endcapture %}{{ msl | replace: "upcoming","Upcoming" | replace: "draft","Draft minutes" | replace: "approved","Minutes approved" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.time }} · {{ x.location }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><h2>Agenda</h2><ol class="ol2 ag" style="grid-template-columns:1fr">{%- assign ag = x.agenda | split: "||" -%}{% for a in ag %}{%- assign ap = a | split: "::" -%}<li style="border-top-width:0;border-left:8px solid var(--ink)"><h3>{{ ap[0] | strip }}</h3>{% if ap[1] %}<p>{{ ap[1] | strip }}</p>{% endif %}</li>{% endfor %}</ol>
{%- capture _c12 -%}{{ x.votes }}{%- endcapture -%}{% if _c12 != "" %}<h2 style="margin:40px 0 14px">Votes</h2><table class="tbl"><thead><tr><th>Item</th><th>Result</th></tr></thead><tbody>{%- assign vs = x.votes | split: "||" -%}{% for v in vs %}{%- assign vp = v | split: "::" -%}<tr><td>{{ vp[0] | strip }}</td><td class="mono"><b>{{ vp[1] | strip }}</b></td></tr>{% endfor %}</tbody></table>{% endif %}
<h2 style="margin:40px 0 10px">{% if ms == "upcoming" %}Notes{% else %}Minutes{% endif %}</h2><div class="prose">{{ x.body }}</div></div>
<aside class="side"><div class="panel" style="border:2px solid var(--ink)"><dl class="facts"><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Time</dt><dd>{{ x.time }}</dd><dt>Status</dt><dd>{% capture msl2 -%}{{ x.status }}{%- endcapture %}{{ msl2 | replace: "upcoming","Upcoming" | replace: "draft","Draft minutes" | replace: "approved","Minutes approved" }}</dd><dt>Public</dt><dd>Open, streamed, captioned</dd></dl></div>
{%- capture _c13 -%}{{ x.policies }}{%- endcapture -%}{% if _c13 != "" %}<div class="panel"><p class="kick">Policies on this agenda</p>{% for p in pols.Items %}{%- capture pn -%}{{ p.PublishedContent.number }}{%- endcapture -%}{% if pl contains pn %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}" style="padding:8px 0"><b>{{ pn }} · {{ p.PrimaryField }}</b><p>{% capture rvl -%}{{ p.PublishedContent.review }}{%- endcapture %}{{ rvl | replace: "current","Current" | replace: "first","First reading" | replace: "second","Second reading" }}</p></a>{% endif %}{% endfor %}</div>{% endif %}<a class="btn line sm" href="{{ PathBase }}/board">All meetings</a></aside></div></div></section>
