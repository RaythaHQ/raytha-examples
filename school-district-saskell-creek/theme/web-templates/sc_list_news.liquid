<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>News</li></ol><p class="kick">News</p><h1>District and school news</h1><p class="lede">Board decisions, schedule changes and what students are doing across sixteen schools.</p></div></div>
<section class="sec tight"><div class="w"><div class="news">{% for n in Target.Items %}{%- assign y=n.PublishedContent -%}<a class="card" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt=""><div class="b"><span class="m">{% capture nkl -%}{{ y.kind }}{%- endcapture %}{{ nkl | replace: "district","District" | replace: "school","School" | replace: "board","Board" | replace: "athletics","Athletics" | replace: "arts","Arts" | replace: "alert","Status alert" }} · {{ y.date_label }}</span><h3>{{ n.PrimaryField }}</h3><p>{{ y.summary }}</p></div></a>{% endfor %}</div></div></section>
