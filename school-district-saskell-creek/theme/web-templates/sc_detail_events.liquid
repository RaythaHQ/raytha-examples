{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}{%- assign x=Target.PublishedContent -%}{%- capture code -%}{{ x.school }}{%- endcapture -%}{%- capture ek -%}{{ x.kind }}{%- endcapture -%}{%- assign sn="District office" -%}{%- assign sn_url="" -%}{% for q in sch.Items %}{%- capture qc -%}{{ q.PublishedContent.code }}{%- endcapture -%}{% if qc == code %}{%- assign sn=q.PrimaryField -%}{%- capture sn_url -%}{{ PathBase }}/{{ q.RoutePath }}{%- endcapture -%}{% endif %}{% endfor %}{%- assign evs = get_content_items(ContentType="events", OrderBy="sort_order asc", PageSize=60) -%}{%- assign dp = x.date_label | split: " " -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/calendar">Calendar</a></li><li>{{ x.date_label }}</li></ol><div style="display:grid;grid-template-columns:110px 1fr;gap:28px;align-items:center"><div class="date" style="padding:12px 0"><span>{{ dp[0] | remove: "," }} · {{ dp[1] }}</span><b style="font-size:2.6rem">{{ dp[2] }}</b></div><div><p class="kick"><span class="k {{ ek }}">{% capture ekl -%}{{ x.kind }}{%- endcapture %}{{ ekl | replace: "noschool","No school" | replace: "early","Early release" | replace: "family","Family event" | replace: "arts","Arts" | replace: "athletics","Athletics" | replace: "testing","Testing" | replace: "pd","Staff development" }}</span></p><h1 style="font-size:clamp(2rem,3.6vw,3rem)">{{ Target.PrimaryField }}</h1></div></div></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="prose">{{ x.body }}{% if ek == "noschool" %}<p><b>No classes for students on this day.</b> Buses do not run.</p>{% endif %}</div><aside class="panel" style="border:2px solid var(--ink)"><dl class="facts"><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Time</dt><dd>{{ x.time }}</dd><dt>Where</dt><dd>{{ x.location }}</dd><dt>School</dt><dd>{% if sn_url != "" %}<a href="{{ sn_url }}">{{ sn }}</a>{% else %}All schools / district{% endif %}</dd></dl></aside></div></div></section>
