{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}
{%- assign ml = get_content_items(ContentType="menus", OrderBy="sort_order asc", PageSize=20) -%}
{%- assign evs = get_content_items(ContentType="events", OrderBy="sort_order asc", PageSize=7) -%}
{%- assign nws = get_content_items(ContentType="news", OrderBy="sort_order asc", PageSize=5) -%}
{%- assign up = get_content_items(ContentType="meetings", Filter="status eq 'upcoming'", OrderBy="sort_order asc", PageSize=1) -%}
{%- assign dnow = "now" | date: "%a" -%}{%- assign n_ok=0 -%}{%- assign n_d=0 -%}{%- assign n_e=0 -%}{% for s in sch.Items %}{%- capture ss -%}{{ s.PublishedContent.status }}{%- endcapture -%}{% if ss == "on_schedule" %}{%- assign n_ok = n_ok | plus: 1 -%}{% elsif ss == "delayed" %}{%- assign n_d = n_d | plus: 1 -%}{% else %}{%- assign n_e = n_e | plus: 1 -%}{% endif %}{% endfor %}
<section class="hero"><div class="w"><div class="g"><div><p class="kick">Saskell Creek Public Schools · PreK–12 · fictional</p><h1>Sixteen schools. Three lines. One way through.</h1>
<p class="lede">Every student follows a line: an elementary school, a middle school and a high school, with an early learning center and a career center shared by all three. Find your stop, check today's bells, see what's for lunch.</p>
<div class="cta"><a class="btn" href="#map">Find your school</a><a class="btn line" href="#bells">Today's bells</a></div></div>
<aside class="today" aria-label="Today in the district"><div class="d">{{ "now" | date: "%A, %B %d" }}</div><h2>Today in the district</h2>
<div class="tally"><div><b>{{ n_ok }}</b><span>on schedule</span></div><div><b style="color:#ffd75e">{{ n_d }}</b><span>delayed start</span></div><div><b style="color:#e4c2ff">{{ n_e }}</b><span>early release</span></div></div>
<div class="lunch"><small>Lunch today</small>{%- assign hasl=false -%}{% for m in ml.Items %}{%- assign y=m.PublishedContent -%}{%- capture _c0 -%}{{ y.day }}{%- endcapture -%}{% if _c0 == dnow %}{%- assign hasl=true -%}<div><b>{{ y.entree }}</b> · {% capture mll -%}{{ y.level }}{%- endcapture %}{{ mll | replace: "elementary","Elementary" | replace: "secondary","Middle and high" }}</div>{% endif %}{% endfor %}{% unless hasl %}<div>No school lunch today. <a href="{{ PathBase }}/lunch">This week's menus</a></div>{% endunless %}</div>
<p style="margin:16px 0 0;font-size:.92rem"><a href="#bells">Every school's bells and status →</a></p></aside></div><div id="map" style="margin-top:30px"><div class="shead" style="margin-bottom:16px"><div><p class="kick">The feeder map</p><h2 style="font-size:1.7rem">Find your stop, then follow the line</h2></div><a class="btn line sm" href="{{ PathBase }}/schools">All schools by line</a></div><div class="mapcard">{%- assign L3 = "ridge:Ridge line:#0f7c74:Saskell Ridge High,creek:Creek line:#c8402a:Saskell Creek High,mill:Mill line:#6a4bc4:Kestle Mill High" | split: "," -%}
<div class="legend">{% for l in L3 %}{%- assign lp = l | split: ":" -%}<span><i style="background:{{ lp[2] }}"></i>{{ lp[1] }} → {{ lp[3] }}</span>{% endfor %}<span><i style="background:repeating-linear-gradient(90deg,#5b6475 0 6px,transparent 6px 10px)"></i>District-wide</span></div>
<svg viewBox="0 0 1180 425" role="img" aria-labelledby="maptitle"><title id="maptitle">Feeder line map: each elementary school feeds a middle school and a high school; the early learning center feeds every line and the career center serves all three high schools.</title>
{%- for l in L3 -%}{%- assign lp = l | split: ":" -%}{%- assign y = forloop.index0 | times: 140 | plus: 70 -%}{%- assign mn = 9 -%}
{%- for s in sch.Items -%}{%- capture sl -%}{{ s.PublishedContent.line }}{%- endcapture -%}{%- if sl == lp[0] -%}{%- capture cs -%}{{ s.PublishedContent.col }}{%- endcapture -%}{%- assign c = cs | plus: 0 -%}{%- if c < mn -%}{%- assign mn = c -%}{%- endif -%}{%- endif -%}{%- endfor -%}
{%- assign x1 = mn | times: 180 | plus: 240 -%}<path d="M70 210 Q 70 {{ y }} {{ x1 }} {{ y }}" stroke="#5b6475" stroke-width="5" stroke-dasharray="9 9" fill="none"/><path d="M960 {{ y }} Q 1100 {{ y }} 1100 210" stroke="#5b6475" stroke-width="5" stroke-dasharray="9 9" fill="none"/>
<line x1="{{ x1 }}" y1="{{ y }}" x2="960" y2="{{ y }}" stroke="{{ lp[2] }}" stroke-width="16" stroke-linecap="round"/><text x="{{ x1 }}" y="{{ y | minus: 30 }}" font-size="13" font-weight="700" fill="{{ lp[2] }}" letter-spacing="1.5">{{ lp[1] | upcase }}</text>{%- endfor -%}

{%- for s in sch.Items -%}{%- assign z = s.PublishedContent -%}{%- capture ln -%}{{ z.line }}{%- endcapture -%}{%- capture lv -%}{{ z.level }}{%- endcapture -%}{%- capture ss -%}{{ z.status }}{%- endcapture -%}{%- capture cs -%}{{ z.col }}{%- endcapture -%}{%- assign c = cs | plus: 0 -%}{%- assign x = c | times: 180 | plus: 240 -%}{%- assign y = 210 -%}{%- if ln == "ridge" -%}{%- assign y = 70 -%}{%- elsif ln == "mill" -%}{%- assign y = 350 -%}{%- elsif ln == "shared" -%}{%- if c == 0 -%}{%- assign x = 70 -%}{%- else -%}{%- assign x = 1100 -%}{%- endif -%}{%- endif -%}{%- assign r = 14 -%}{%- if lv == "high" or lv == "cte" or lv == "early" -%}{%- assign r = 21 -%}{%- endif -%}
<a href="{{ PathBase }}/{{ s.RoutePath }}" aria-label="{{ s.PrimaryField }}"><circle cx="{{ x }}" cy="{{ y }}" r="{{ r }}" fill="#fff" stroke="#1d2433" stroke-width="6"/>{% if ss != "on_schedule" %}<circle cx="{{ x | plus: 16 }}" cy="{{ y | minus: 16 }}" r="9" fill="#f6b800" stroke="#1d2433" stroke-width="3"/>{% endif %}<text x="{{ x }}" y="{{ y | plus: r | plus: 26 }}" text-anchor="middle" font-size="17" font-weight="800" fill="#1d2433" stroke="#fffdf8" stroke-width="7" paint-order="stroke" stroke-linejoin="round">{{ z.short }}</text><text x="{{ x }}" y="{{ y | plus: r | plus: 45 }}" text-anchor="middle" font-size="13" fill="#4a5366" stroke="#fffdf8" stroke-width="6" paint-order="stroke" stroke-linejoin="round">{% if ss == "delayed" %}Delayed today{% elsif ss == "early_release" %}Early release today{% elsif ln == "shared" %}{{ z.grades }}{% else %}{% capture lvl -%}{{ z.level }}{%- endcapture %}{{ lvl | replace: "elementary","Elementary" | replace: "middle","Middle school" | replace: "high","High school" | replace: "early","Early learning" | replace: "cte","Career and technical" }} · {{ z.grades }}{% endif %}</text></a>{%- endfor -%}
</svg></div><div class="stack">{%- assign L4 = "ridge:Ridge line:#0f7c74:Saskell Ridge High,creek:Creek line:#c8402a:Saskell Creek High,mill:Mill line:#6a4bc4:Kestle Mill High,shared:District-wide:#5b6475:all three lines" | split: "," -%}<div class="lines">{% for l in L4 %}{%- assign lp = l | split: ":" -%}<div class="lcol" style="--lc:{{ lp[2] }}"><h3 style="background:{{ lp[2] }}">{{ lp[1] }}<small>→ {{ lp[3] }}</small></h3><ol class="stops">{% for s in sch.Items %}{%- assign z=s.PublishedContent -%}{%- capture ln -%}{{ z.line }}{%- endcapture -%}{%- capture lv -%}{{ z.level }}{%- endcapture -%}{%- capture ss -%}{{ z.status }}{%- endcapture -%}{% if ln == lp[0] %}<li class="{% if lv == "high" or lv == "cte" %}hub{% endif %}"><a href="{{ PathBase }}/{{ s.RoutePath }}"><b>{{ s.PrimaryField }}</b><span>{% capture lvl -%}{{ z.level }}{%- endcapture %}{{ lvl | replace: "elementary","Elementary" | replace: "middle","Middle school" | replace: "high","High school" | replace: "early","Early learning" | replace: "cte","Career and technical" }} · {{ z.grades }}{% if ss != "on_schedule" %} · <span class="st lightst {{ ss }}" style="font-size:11px;padding:2px 7px">{% capture stl -%}{{ z.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</span>{% endif %}</span></a></li>{% endif %}{% endfor %}</ol></div>{% endfor %}</div></div><p class="muted" style="font-size:.95rem;margin:14px 0 0">Each elementary school feeds one middle school and one high school. Every stop is a school record with a line and a stop number, so the map redraws itself when a school is added.</p></div></div></section>

<section class="sec dark" id="bells"><div class="w"><div class="shead"><div><p class="kick" style="color:#b7c0d1">Today's bells</p><h2 style="color:#fff">Every school, first bell to dismissal</h2><p>Status is written in words as well as color. Each row comes from the school's own record, so a principal updates one field and the board, the map and the school page all change.</p></div></div>
<div class="boardx"><table class="dep"><thead><tr><th class="hm">Line</th><th>School</th><th>First bell</th><th>Dismissal</th><th>Status</th></tr></thead><tbody>{% for s in sch.Items %}{%- assign z=s.PublishedContent -%}{%- capture ln -%}{{ z.line }}{%- endcapture -%}{%- capture ss -%}{{ z.status }}{%- endcapture -%}{%- assign lcol="#5b6475" -%}{%- if ln == "ridge" -%}{%- assign lcol="#0f7c74" -%}{%- elsif ln == "creek" -%}{%- assign lcol="#c8402a" -%}{%- elsif ln == "mill" -%}{%- assign lcol="#6a4bc4" -%}{%- endif -%}<tr><td class="hm"><span class="chipl" style="background:{{ lcol }}">{% capture lnl -%}{{ z.line }}{%- endcapture %}{{ lnl | replace: "ridge","Ridge line" | replace: "creek","Creek line" | replace: "mill","Mill line" | replace: "shared","District-wide" }}</span></td><td class="s"><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a><small>{% capture lvl -%}{{ z.level }}{%- endcapture %}{{ lvl | replace: "elementary","Elementary" | replace: "middle","Middle school" | replace: "high","High school" | replace: "early","Early learning" | replace: "cte","Career and technical" }} · {{ z.grades }}</small></td><td>{{ z.first_bell }}</td><td>{{ z.dismissal }}</td><td><span class="st {{ ss }}">{% capture stl -%}{{ z.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</span>{%- capture _c1 -%}{{ z.status_note }}{%- endcapture -%}{% if _c1 != "" %}<span class="note">{{ z.status_note }}</span>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Lunch this week · elementary</p><h2>What's on the tray</h2><p>Main, vegetarian option, sides and the major allergens in the main dish. Middle and high school menus are on the lunch page.</p></div><a class="btn line sm" href="{{ PathBase }}/lunch">All menus</a></div>
<div class="trays">{% for m in ml.Items %}{%- capture lv -%}{{ m.PublishedContent.level }}{%- endcapture -%}{% if lv == "elementary" %}{%- assign y=m.PublishedContent -%}<a class="tray {%- capture dd -%}{{ y.day }}{%- endcapture -%}{% if dd == dnow %} is-today{% endif %}" href="{{ PathBase }}/{{ m.RoutePath }}"><div class="dy"><span>{{ y.day }} {{ y.date_label }}</span>{%- capture _c2 -%}{{ y.day }}{%- endcapture -%}{% if _c2 == dnow %}<span>Today</span>{% endif %}</div><div class="cp main"><small>Main</small><b>{{ y.entree }}</b></div><div class="cp"><small>Vegetarian</small>{{ y.veg }}</div><div class="cp"><small>Sides</small>{{ y.sides | replace: "|", ", " }}</div><div class="al" aria-label="Allergens">{%- assign als = y.allergens | split: "|" -%}{% for a in als %}<span>{{ a }}</span>{% endfor %}</div>{%- capture _c3 -%}{{ y.note }}{%- endcapture -%}{% if _c3 != "" %}<div class="tn">{{ y.note }}</div>{% endif %}</a>{% endif %}{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="g2"><div><div class="shead"><div><p class="kick">Next stops on the calendar</p><h2>Coming up</h2></div><a class="btn line sm" href="{{ PathBase }}/calendar">Full calendar</a></div>
{% for e in evs.Items %}{%- assign y=e.PublishedContent -%}{%- capture ek -%}{{ y.kind }}{%- endcapture -%}{%- assign dp = y.date_label | split: " " -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ dp[1] }}</span><b>{{ dp[2] }}</b></div><div><b>{{ e.PrimaryField }}</b><p>{{ y.time }}{%- capture _c4 -%}{{ y.location }}{%- endcapture -%}{% if _c4 != "" %} · {{ y.location }}{% endif %}</p></div><span class="k {{ ek }}">{% capture ekl -%}{{ y.kind }}{%- endcapture %}{{ ekl | replace: "noschool","No school" | replace: "early","Early release" | replace: "family","Family event" | replace: "arts","Arts" | replace: "athletics","Athletics" | replace: "testing","Testing" | replace: "pd","Staff development" }}</span></a>{% endfor %}</div>
<div>{% for m in up.Items %}{%- assign y=m.PublishedContent -%}<div class="mtg"><p class="kick">Board of education · next meeting</p><h3 style="font-size:1.5rem">{{ y.date_label }}, {{ y.time }}</h3><p class="muted" style="margin:6px 0 0">{{ y.location }} · open to the public, streamed and captioned</p><ol>{%- assign ag = y.agenda | split: "||" -%}{% for a in ag limit:6 %}{%- assign ap = a | split: "::" -%}<li><div><b>{{ ap[0] | strip }}</b>{% if ap[1] %}<small>{{ ap[1] | strip }}</small>{% endif %}</div></li>{% endfor %}</ol><p class="cta" style="margin-top:16px"><a class="btn sm" href="{{ PathBase }}/{{ m.RoutePath }}">Full agenda</a><a class="btn line sm" href="{{ PathBase }}/policies">Policy manual</a></p></div>{% endfor %}</div></div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">News</p><h2>From the district and the schools</h2></div><a class="btn line sm" href="{{ PathBase }}/news">All news</a></div>
<div class="news">{% for n in nws.Items %}{%- assign y=n.PublishedContent -%}<a class="card" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt=""><div class="b"><span class="m">{% capture nkl -%}{{ y.kind }}{%- endcapture %}{{ nkl | replace: "district","District" | replace: "school","School" | replace: "board","Board" | replace: "athletics","Athletics" | replace: "arts","Arts" | replace: "alert","Status alert" }} · {{ y.date_label }}</span><h3>{{ n.PrimaryField }}</h3>{% if forloop.first %}<p>{{ y.summary }}</p>{% endif %}</div></a>{% endfor %}</div></div></section>
<section class="sec" style="padding-bottom:84px"><div class="w"><div class="pass"><div class="l"><p class="kick">Family hub · staff room · members only</p><h2>Your student's pass, behind sign-in</h2><p class="muted" style="margin-top:14px;font-size:1.08rem">Families sign in to see their student's school, teacher, bus stop times, this week's lunch and the documents shared with families. Staff get a staff room with bulletins, procedures and training days. The check happens on the server: a locked page is never sent to the browser.</p><div class="cta"><a class="btn" href="{{ PathBase }}/families">Open the family hub</a><a class="btn line" href="{{ PathBase }}/staff-room">Staff room</a></div></div>
<div class="r"><p class="kick" style="color:#aab3c5">Student pass · sample</p><div class="big">Route 14</div><dl><dt>School</dt><dd>Fernhall Elementary</dd><dt>Line</dt><dd>Ridge line</dd><dt>AM stop</dt><dd>Marrow St &amp; 5th · 7:14</dd><dt>Teacher</dt><dd>Grade 4 · Room 112</dd></dl><p style="margin:16px 0 0;font:500 13px var(--mono);color:#aab3c5">Sign in to see a real pass (demo accounts only).</p></div></div></div></section>
