{%- assign x=Target.PublishedContent -%}{%- capture pn -%}{{ x.number }}{%- endcapture -%}{%- capture rv -%}{{ x.review }}{%- endcapture -%}{%- assign mts = get_content_items(ContentType="meetings", OrderBy="sort_order asc", PageSize=40) -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/policies">Policies</a></li><li>{{ pn }}</li></ol><p class="kick">Policy {{ pn }} · {% capture sel -%}{{ x.series }}{%- endcapture %}{{ sel | replace: "1000","1000 Community" | replace: "2000","2000 Administration" | replace: "3000","3000 Business and operations" | replace: "4000","4000 Students" | replace: "5000","5000 Staff" | replace: "6000","6000 Instruction" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><aside class="side"><div class="panel" style="border:2px solid var(--ink)"><div class="big" style="color:var(--ink);font-size:3rem">{{ pn }}</div><dl class="facts" style="margin-top:14px"><dt>Adopted</dt><dd>{{ x.adopted }}</dd><dt>Revised</dt><dd>{{ x.revised }}</dd><dt>Status</dt><dd>{% capture rvl -%}{{ x.review }}{%- endcapture %}{{ rvl | replace: "current","Current" | replace: "first","First reading" | replace: "second","Second reading" }}</dd></dl></div>
<div class="panel"><p class="kick">On board agendas</p>{%- assign hm=false -%}{% for m in mts.Items %}{%- assign ml = m.PublishedContent.policies | split: "|" -%}{% if ml contains pn %}{%- assign hm=true -%}<a class="hit" style="padding:8px 0" href="{{ PathBase }}/{{ m.RoutePath }}"><b>{{ m.PrimaryField }}</b><p>{% capture msl -%}{{ m.PublishedContent.status }}{%- endcapture %}{{ msl | replace: "upcoming","Upcoming" | replace: "draft","Draft minutes" | replace: "approved","Minutes approved" }}</p></a>{% endif %}{% endfor %}{% unless hm %}<p class="muted" style="margin:0">Not on a recent agenda.</p>{% endunless %}</div></aside></div></div></section>
