{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}{%- assign x=Target.PublishedContent -%}{%- capture ln -%}{{ x.line }}{%- endcapture -%}{%- capture code -%}{{ x.code }}{%- endcapture -%}{%- capture ss -%}{{ x.status }}{%- endcapture -%}{%- capture lv -%}{{ x.level }}{%- endcapture -%}{%- capture ft -%}{{ x.feeds_to }}{%- endcapture -%}{%- assign lcol="#5b6475" -%}{%- if ln == "ridge" -%}{%- assign lcol="#0f7c74" -%}{%- elsif ln == "creek" -%}{%- assign lcol="#c8402a" -%}{%- elsif ln == "mill" -%}{%- assign lcol="#6a4bc4" -%}{%- endif -%}
{%- assign stf = get_content_items(ContentType="staff", OrderBy="sort_order asc", PageSize=60) -%}{%- assign evs = get_content_items(ContentType="events", OrderBy="sort_order asc", PageSize=60) -%}{%- assign nws = get_content_items(ContentType="news", OrderBy="sort_order asc", PageSize=40) -%}
<div class="phead" style="--lc:{{ lcol }}"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/schools">Schools</a></li><li>{% capture lnl -%}{{ x.line }}{%- endcapture %}{{ lnl | replace: "ridge","Ridge line" | replace: "creek","Creek line" | replace: "mill","Mill line" | replace: "shared","District-wide" }}</li></ol>
<div class="shero"><div><p class="kick"><span class="chipl" style="background:{{ lcol }}">{% capture lnl2 -%}{{ x.line }}{%- endcapture %}{{ lnl2 | replace: "ridge","Ridge line" | replace: "creek","Creek line" | replace: "mill","Mill line" | replace: "shared","District-wide" }}</span> {% capture lvl -%}{{ x.level }}{%- endcapture %}{{ lvl | replace: "elementary","Elementary" | replace: "middle","Middle school" | replace: "high","High school" | replace: "early","Early learning" | replace: "cte","Career and technical" }} · {{ x.grades }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p>
<p style="margin-top:18px"><span class="st lightst {{ ss }}">{% capture stl -%}{{ x.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</span> <span class="mono" style="margin-left:8px">{{ x.first_bell }} – {{ x.dismissal }}</span>{%- capture _c7 -%}{{ x.status_note }}{%- endcapture -%}{% if _c7 != "" %}<br><b style="display:inline-block;margin-top:10px">{{ x.status_note }}</b>{% endif %}</p></div>
<img src="{{ x.art.Value | attachment_redirect_url }}" alt="Generated illustration of {{ Target.PrimaryField }}"></div>
{% if ln != "shared" %}<nav class="strip2" aria-label="Stops on the {% capture lnl3 -%}{{ x.line }}{%- endcapture %}{{ lnl3 | replace: "ridge","Ridge line" | replace: "creek","Creek line" | replace: "mill","Mill line" | replace: "shared","District-wide" }}">{% for s in sch.Items %}{%- capture sl -%}{{ s.PublishedContent.line }}{%- endcapture -%}{% if sl == ln %}{% if s.Id == Target.Id %}<span class="cur"><i></i>{{ s.PublishedContent.short }}<em>You are here</em></span>{% else %}<a href="{{ PathBase }}/{{ s.RoutePath }}"><i></i>{{ s.PublishedContent.short }}</a>{% endif %}{% endif %}{% endfor %}</nav>{% endif %}</div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><div class="prose">{{ x.body }}</div>
<h2 style="margin:36px 0 14px">Programs</h2><div class="chips">{%- assign pg = x.programs | split: "|" -%}{% for p in pg %}<span class="chip">{{ p }}</span>{% endfor %}</div>
{%- assign hs=false -%}{% for p in stf.Items %}{%- capture pc -%}{{ p.PublishedContent.school }}{%- endcapture -%}{% if pc == code %}{%- assign hs=true -%}{% endif %}{% endfor %}{% if hs %}<h2 style="margin:40px 0 14px">Staff at {{ x.short }}</h2><table class="tbl"><thead><tr><th>Name</th><th>Role</th><th>Room</th><th>Ext.</th></tr></thead><tbody>{% for p in stf.Items %}{%- assign z=p.PublishedContent -%}{%- capture pc -%}{{ z.school }}{%- endcapture -%}{% if pc == code %}<tr><td><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a></td><td>{{ z.role }}</td><td class="mono">{{ z.room }}</td><td class="mono">{{ z.ext }}</td></tr>{% endif %}{% endfor %}</tbody></table>{% endif %}
<h2 style="margin:40px 0 6px">On the calendar</h2>{%- assign en=0 -%}{% for e in evs.Items %}{%- capture ec -%}{{ e.PublishedContent.school }}{%- endcapture -%}{% if en < 6 and ec == code or en < 6 and ec == "district" %}{%- assign en = en | plus: 1 -%}{%- assign y=e.PublishedContent -%}{%- capture ek -%}{{ y.kind }}{%- endcapture -%}{%- assign dp = y.date_label | split: " " -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ dp[1] }}</span><b>{{ dp[2] }}</b></div><div><b>{{ e.PrimaryField }}</b><p>{{ y.time }}{%- capture _c8 -%}{{ y.location }}{%- endcapture -%}{% if _c8 != "" %} · {{ y.location }}{% endif %}</p></div><span class="k {{ ek }}">{% capture ekl -%}{{ y.kind }}{%- endcapture %}{{ ekl | replace: "noschool","No school" | replace: "early","Early release" | replace: "family","Family event" | replace: "arts","Arts" | replace: "athletics","Athletics" | replace: "testing","Testing" | replace: "pd","Staff development" }}</span></a>{% endif %}{% endfor %}
{%- assign hn=false -%}{% for n in nws.Items %}{%- capture nc -%}{{ n.PublishedContent.school }}{%- endcapture -%}{% if nc == code %}{%- assign hn=true -%}{% endif %}{% endfor %}{% if hn %}<h2 style="margin:40px 0 14px">News from {{ x.short }}</h2>{% for n in nws.Items %}{%- capture nc -%}{{ n.PublishedContent.school }}{%- endcapture -%}{% if nc == code %}<a class="hit" href="{{ PathBase }}/{{ n.RoutePath }}"><b>{{ n.PrimaryField }}</b><p>{{ n.PublishedContent.summary }}</p></a>{% endif %}{% endfor %}{% endif %}</div>
<aside class="side"><div class="panel" style="border:2px solid var(--ink)"><dl class="facts"><dt>Principal</dt><dd>{{ x.principal }}</dd><dt>Grades</dt><dd>{{ x.grades }}</dd><dt>Students</dt><dd>{{ x.enrollment }} (story)</dd><dt>First bell</dt><dd class="mono">{{ x.first_bell }}</dd><dt>Dismissal</dt><dd class="mono">{{ x.dismissal }}</dd><dt>Mascot</dt><dd>{{ x.mascot }}</dd><dt>Address</dt><dd>{{ x.address | newline_to_br }}</dd><dt>Phone</dt><dd class="mono">{{ x.phone }}</dd></dl></div>
{% if ft != "" %}{% for s in sch.Items %}{%- capture sc2 -%}{{ s.PublishedContent.code }}{%- endcapture -%}{% if sc2 == ft %}<a class="panel" style="text-decoration:none;display:block;border-left:10px solid {{ lcol }}" href="{{ PathBase }}/{{ s.RoutePath }}"><p class="kick">Next stop</p><b style="font-size:1.2rem">{{ s.PrimaryField }} →</b><p class="muted" style="margin:6px 0 0">Grades {{ s.PublishedContent.grades }}</p></a>{% endif %}{% endfor %}{% endif %}
<div class="panel"><p class="kick">Lunch</p><p style="margin:0">{% if lv == "elementary" or lv == "early" %}Elementary menu{% else %}Middle and high menu{% endif %} · <a href="{{ PathBase }}/lunch">this week</a></p></div></aside></div></div></section>
