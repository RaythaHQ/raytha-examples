{%- assign in_fam=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the district site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="lunch, bus, attendance, conferences"><button class="btn">Search</button></form></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "schools:Schools:name:summary,news:News:title:summary,events:Calendar:title:summary,policies:Board policies:title:summary,meetings:Board meetings:title:summary,resources:Resources:title:summary,staff:Staff:name:role" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "families" or au == "staff" %} <span class="aud {{ au }}">🔒 {% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }}</span>{% endif %}<p>{% if x.summary %}{{ x.summary | strip_html | truncate: 150 }}{% else %}{{ x.role }}{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=bus">bus</a>, <a href="?q=attendance">attendance</a>, <a href="?q=conference">conference</a> or <a href="?q=dual">dual language</a>.</p>{% endif %}</div></div></section>
