<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Calendar</li></ol><p class="kick">District calendar · 2026–27</p><h1>Calendar</h1><p class="lede">No-school days, early releases, conferences, concerts, games and testing. Every entry is labeled in words, so the calendar reads without color.</p></div></div>
<section class="sec tight"><div class="w"><div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px"><span class="k noschool">No school</span><span class="k early">Early release</span><span class="k">Family event</span><span class="k arts">Arts</span><span class="k athletics">Athletics</span><span class="k testing">Testing</span><span class="k pd">Staff development</span></div>
<div class="months">{%- assign mos = "2026-11:0:30:November 2026,2026-12:2:31:December 2026" | split: "," -%}{% for mo in mos %}{%- assign mp = mo | split: ":" -%}{%- assign off = mp[1] | plus: 0 -%}{%- assign nd = mp[2] | plus: 0 -%}<div class="month"><h3>{{ mp[3] }}</h3><div class="cal"><div class="hd">SUN</div><div class="hd">MON</div><div class="hd">TUE</div><div class="hd">WED</div><div class="hd">THU</div><div class="hd">FRI</div><div class="hd">SAT</div>{% if off > 0 %}{% for b in (1..off) %}<div class="d x"></div>{% endfor %}{% endif %}{% for d in (1..nd) %}{%- capture ds -%}{{ mp[0] }}-{% if d < 10 %}0{% endif %}{{ d }}{%- endcapture -%}{%- assign wd = off | plus: d | minus: 1 | modulo: 7 -%}{%- assign nos=false -%}{% for e in Target.Items %}{%- capture ek -%}{{ e.PublishedContent.kind }}{%- endcapture -%}{%- capture _c9 -%}{{ e.PublishedContent.date_iso }}{%- endcapture -%}{% if _c9 == ds and ek == "noschool" %}{%- assign nos=true -%}{% endif %}{% endfor %}<div class="d{% if wd == 0 or wd == 6 %} we{% endif %}{% if nos %} nos{% endif %}"><b class="n">{{ d }}</b>{% for e in Target.Items %}{%- capture _c10 -%}{{ e.PublishedContent.date_iso }}{%- endcapture -%}{% if _c10 == ds %}{%- capture ek -%}{{ e.PublishedContent.kind }}{%- endcapture -%}<a class="{{ ek }}" href="{{ PathBase }}/{{ e.RoutePath }}">{{ e.PrimaryField }}</a>{% endif %}{% endfor %}</div>{% endfor %}</div></div>{% endfor %}</div></div></section>
<section class="sec tight"><div class="w"><h2 style="margin-bottom:8px">Every date, in order</h2><p class="muted">The same entries as a list, which is easier to read on a phone or with a screen reader.</p>{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture ek -%}{{ y.kind }}{%- endcapture -%}{%- assign dp = y.date_label | split: " " -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ dp[1] }}</span><b>{{ dp[2] }}</b></div><div><b>{{ e.PrimaryField }}</b><p>{{ y.time }}{%- capture _c11 -%}{{ y.location }}{%- endcapture -%}{% if _c11 != "" %} · {{ y.location }}{% endif %}</p></div><span class="k {{ ek }}">{% capture ekl -%}{{ y.kind }}{%- endcapture %}{{ ekl | replace: "noschool","No school" | replace: "early","Early release" | replace: "family","Family event" | replace: "arts","Arts" | replace: "athletics","Athletics" | replace: "testing","Testing" | replace: "pd","Staff development" }}</span></a>{% endfor %}</div></section>
