{%- assign in_fam=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Resources</li></ol><p class="kick">Resources</p><h1>Handbooks, guides and procedures</h1><p class="lede">Everyone can see what exists. Documents marked Families or Staff open only for signed-in accounts in that group; the check happens on the server.</p></div></div>
<section class="sec tight"><div class="w"><div class="rowl">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<a class="row" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="t">{% capture rkl -%}{{ x.kind }}{%- endcapture %}{{ rkl | replace: "handbook","Handbook" | replace: "guide","Guide" | replace: "procedure","Procedure" | replace: "checklist","Checklist" | replace: "letter","Letter" }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary }}</p></div><div style="text-align:right"><span class="aud {{ au }}">{% if ok == false %}🔒 {% endif %}{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }}</span><div class="mono muted" style="font-size:12.5px;margin-top:6px">{{ x.updated_label }}</div></div></a>{% endfor %}</div></div></section>
