{%- assign dnow = "" -%}{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/lunch">Lunch</a></li><li>{{ x.day }} {{ x.date_label }}</li></ol><p class="kick">{% capture mll -%}{{ x.level }}{%- endcapture %}{{ mll | replace: "elementary","Elementary" | replace: "secondary","Middle and high" }} · {{ x.week }}</p><h1>{{ x.day }} {{ x.date_label }}: {{ x.entree }}</h1><p class="lede">Vegetarian option: {{ x.veg }}. Sides: {{ x.sides | replace: "|", ", " }}.</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div style="max-width:520px">{%- assign m = Target -%}{%- assign y=m.PublishedContent -%}<a class="tray {%- capture dd -%}{{ y.day }}{%- endcapture -%}{% if dd == dnow %} is-today{% endif %}" href="{{ PathBase }}/{{ m.RoutePath }}"><div class="dy"><span>{{ y.day }} {{ y.date_label }}</span>{%- capture _c18 -%}{{ y.day }}{%- endcapture -%}{% if _c18 == dnow %}<span>Today</span>{% endif %}</div><div class="cp main"><small>Main</small><b>{{ y.entree }}</b></div><div class="cp"><small>Vegetarian</small>{{ y.veg }}</div><div class="cp"><small>Sides</small>{{ y.sides | replace: "|", ", " }}</div><div class="al" aria-label="Allergens">{%- assign als = y.allergens | split: "|" -%}{% for a in als %}<span>{{ a }}</span>{% endfor %}</div>{%- capture _c19 -%}{{ y.note }}{%- endcapture -%}{% if _c19 != "" %}<div class="tn">{{ y.note }}</div>{% endif %}</a></div><aside class="panel" style="border:2px solid var(--ink)"><p class="kick">Allergens in the main</p><div class="alg" style="display:flex;gap:6px;flex-wrap:wrap">{%- assign als = x.allergens | split: "|" -%}{% for a in als %}<span>{{ a }}</span>{% endfor %}</div><p class="muted" style="margin:14px 0 0">Ask the cafeteria manager about sides and the vegetarian option. Menus can change with supply.</p></aside></div></div></section>
