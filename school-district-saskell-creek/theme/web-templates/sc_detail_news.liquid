{%- assign sch = get_content_items(ContentType="schools", OrderBy="sort_order asc", PageSize=40) -%}{%- assign x=Target.PublishedContent -%}{%- capture code -%}{{ x.school }}{%- endcapture -%}{%- assign sn="District office" -%}{%- assign sn_url="" -%}{% for q in sch.Items %}{%- capture qc -%}{{ q.PublishedContent.code }}{%- endcapture -%}{% if qc == code %}{%- assign sn=q.PrimaryField -%}{%- capture sn_url -%}{{ PathBase }}/{{ q.RoutePath }}{%- endcapture -%}{% endif %}{% endfor %}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li>{% capture nkl -%}{{ x.kind }}{%- endcapture %}{{ nkl | replace: "district","District" | replace: "school","School" | replace: "board","Board" | replace: "athletics","Athletics" | replace: "arts","Arts" | replace: "alert","Status alert" }}</li></ol><p class="kick">{% capture nkl2 -%}{{ x.kind }}{%- endcapture %}{{ nkl2 | replace: "district","District" | replace: "school","School" | replace: "board","Board" | replace: "athletics","Athletics" | replace: "arts","Arts" | replace: "alert","Status alert" }} · {{ x.date_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="border-radius:20px;margin-bottom:28px;border:2px solid var(--ink)"><div class="prose">{{ x.body }}</div></div><aside class="side"><div class="panel"><dl class="facts"><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>From</dt><dd>{% if sn_url != "" %}<a href="{{ sn_url }}">{{ sn }}</a>{% else %}District office{% endif %}</dd></dl></div><a class="btn line sm" href="{{ PathBase }}/news">All news</a></aside></div></div></section>
