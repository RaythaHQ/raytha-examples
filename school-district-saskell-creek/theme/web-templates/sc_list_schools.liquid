<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Schools</li></ol><p class="kick">Schools by feeder line</p><h1>Sixteen schools on three lines</h1><p class="lede">Find your elementary school, then follow its line to middle and high school. The Early Learning Center and Northgate Career and Technical Center serve every line.</p></div></div>{%- assign sch = Target -%}
<section class="sec tight"><div class="w">{%- assign L4 = "ridge:Ridge line:#0f7c74:Saskell Ridge High,creek:Creek line:#c8402a:Saskell Creek High,mill:Mill line:#6a4bc4:Kestle Mill High,shared:District-wide:#5b6475:all three lines" | split: "," -%}<div class="lines">{% for l in L4 %}{%- assign lp = l | split: ":" -%}<div class="lcol" style="--lc:{{ lp[2] }}"><h3 style="background:{{ lp[2] }}">{{ lp[1] }}<small>→ {{ lp[3] }}</small></h3><ol class="stops">{% for s in sch.Items %}{%- assign z=s.PublishedContent -%}{%- capture ln -%}{{ z.line }}{%- endcapture -%}{%- capture lv -%}{{ z.level }}{%- endcapture -%}{%- capture ss -%}{{ z.status }}{%- endcapture -%}{% if ln == lp[0] %}<li class="{% if lv == "high" or lv == "cte" %}hub{% endif %}"><a href="{{ PathBase }}/{{ s.RoutePath }}"><b>{{ s.PrimaryField }}</b><span>{% capture lvl -%}{{ z.level }}{%- endcapture %}{{ lvl | replace: "elementary","Elementary" | replace: "middle","Middle school" | replace: "high","High school" | replace: "early","Early learning" | replace: "cte","Career and technical" }} · {{ z.grades }}{% if ss != "on_schedule" %} · <span class="st lightst {{ ss }}" style="font-size:11px;padding:2px 7px">{% capture stl -%}{{ z.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</span>{% endif %}</span></a></li>{% endif %}{% endfor %}</ol></div>{% endfor %}</div></div></section>
<section class="sec tight"><div class="w"><h2 style="margin-bottom:18px">All schools at a glance</h2><table class="tbl"><thead><tr><th>School</th><th>Line</th><th>Grades</th><th>Principal</th><th>Bells</th><th>Today</th></tr></thead><tbody>{% for s in Target.Items %}{%- assign z=s.PublishedContent -%}{%- capture ss -%}{{ z.status }}{%- endcapture -%}<tr><td><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a></td><td>{% capture lnl -%}{{ z.line }}{%- endcapture %}{{ lnl | replace: "ridge","Ridge line" | replace: "creek","Creek line" | replace: "mill","Mill line" | replace: "shared","District-wide" }}</td><td>{{ z.grades }}</td><td>{{ z.principal }}</td><td class="mono" style="font-size:.92rem">{{ z.first_bell }} – {{ z.dismissal }}</td><td><span class="st lightst {{ ss }}">{% capture stl -%}{{ z.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</span></td></tr>{% endfor %}</tbody></table></div></section>
