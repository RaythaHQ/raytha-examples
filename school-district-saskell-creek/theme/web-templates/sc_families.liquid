{%- assign in_fam=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign lib = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=40) -%}{%- assign ml = get_content_items(ContentType="menus", OrderBy="sort_order asc", PageSize=20) -%}{%- assign evs = get_content_items(ContentType="events", OrderBy="sort_order asc", PageSize=40) -%}{%- assign fh = get_content_items(ContentType="schools", Filter="code eq 'fh'", PageSize=1) -%}{%- assign fhs = fh.Items | first -%}{%- assign dnow = "now" | date: "%a" -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Family hub</li></ol><p class="kick">Members only · families</p><h1>{% if CurrentUser.IsAuthenticated %}Welcome, {{ CurrentUser.FirstName }}{% else %}Family hub{% endif %}</h1><p class="lede">Your student's school pass, bus stop times, this week's lunch, the dates that affect your family, and documents shared with families.</p>{% if CurrentUser.IsAuthenticated %}<p style="margin-top:14px"><span class="aud {% if in_fam %}public{% else %}staff{% endif %}">{% if in_fam %}✓{% else %}✕{% endif %} Families</span> <span class="aud {% if in_staff %}public{% else %}staff{% endif %}">{% if in_staff %}✓{% else %}✕{% endif %} Staff</span></p>{% endif %}</div></div>
<section class="sec tight"><div class="w">{% unless CurrentUser.IsAuthenticated %}<div class="lock"><span class="pill">Sign in required</span><h2>The family hub is for Saskell Creek families.</h2><p>The school office creates your family account at enrollment, so there is no sign-up form. Once signed in you see your student's school, teacher and bus stop, this week's lunch, conference dates, and documents shared with families.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/families">Sign in</a><a class="btn line" href="{{ PathBase }}/resources">Public resources</a></p></div>
<ol class="ol2" style="max-width:900px;margin-top:30px"><li><h3>Student pass</h3><p>School, line, teacher, room and bus stop times.</p></li><li><h3>This week</h3><p>Lunch, early releases and conferences.</p></li><li><h3>Family documents</h3><p>Letters and checklists shared only with families.</p></li></ol>
{% else %}{% if in_fam %}<div class="dg"><div>
<div class="pass"><div class="l"><p class="kick">Student pass · story data</p><h2>Ines Okafor-Reyes</h2><dl><dt>School</dt><dd><a href="{{ PathBase }}/{{ fhs.RoutePath }}">{{ fhs.PrimaryField }}</a></dd><dt>Grade</dt><dd>4 · dual language</dd><dt>Teacher</dt><dd>Priya Lindqvist · Room 112</dd><dt>Bells</dt><dd class="mono">{{ fhs.PublishedContent.first_bell }} – {{ fhs.PublishedContent.dismissal }}</dd><dt>Today</dt><dd>{% capture stl -%}{{ fhs.PublishedContent.status }}{%- endcapture %}{{ stl | replace: "on_schedule","On schedule" | replace: "early_release","Early release" | replace: "delayed","Delayed start" | replace: "closed","Closed" }}</dd></dl></div>
<div class="r"><p class="kick" style="color:#aab3c5">Bus · Ridge line</p><div class="big">Route 14</div><dl><dt>AM stop</dt><dd>Marrow St &amp; 5th · 7:14</dd><dt>PM drop</dt><dd>3:10 pm</dd><dt>Changed</dt><dd>Nov 2 (was 7:22)</dd><dt>Depot</dt><dd class="mono">(555) 014-1040</dd></dl></div></div>
<h2 style="margin:40px 0 16px">Lunch this week at Fernhall</h2><div class="trays">{% for m in ml.Items %}{%- capture lv -%}{{ m.PublishedContent.level }}{%- endcapture -%}{% if lv == "elementary" %}{%- assign y=m.PublishedContent -%}<a class="tray {%- capture dd -%}{{ y.day }}{%- endcapture -%}{% if dd == dnow %} is-today{% endif %}" href="{{ PathBase }}/{{ m.RoutePath }}"><div class="dy"><span>{{ y.day }} {{ y.date_label }}</span>{%- capture _c5 -%}{{ y.day }}{%- endcapture -%}{% if _c5 == dnow %}<span>Today</span>{% endif %}</div><div class="cp main"><small>Main</small><b>{{ y.entree }}</b></div><div class="cp"><small>Vegetarian</small>{{ y.veg }}</div><div class="cp"><small>Sides</small>{{ y.sides | replace: "|", ", " }}</div><div class="al" aria-label="Allergens">{%- assign als = y.allergens | split: "|" -%}{% for a in als %}<span>{{ a }}</span>{% endfor %}</div>{%- capture _c6 -%}{{ y.note }}{%- endcapture -%}{% if _c6 != "" %}<div class="tn">{{ y.note }}</div>{% endif %}</a>{% endif %}{% endfor %}</div>
<h2 style="margin:40px 0 6px">Dates for your family</h2>{% for e in evs.Items %}{%- assign y=e.PublishedContent -%}{%- capture ek -%}{{ y.kind }}{%- endcapture -%}{%- capture es -%}{{ y.school }}{%- endcapture -%}{% if ek == "noschool" or ek == "early" or es == "fh" %}{%- assign dp = y.date_label | split: " " -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ dp[1] }}</span><b>{{ dp[2] }}</b></div><div><b>{{ e.PrimaryField }}</b><p>{{ y.time }}</p></div><span class="k {{ ek }}">{% capture ekl -%}{{ y.kind }}{%- endcapture %}{{ ekl | replace: "noschool","No school" | replace: "early","Early release" | replace: "family","Family event" | replace: "arts","Arts" | replace: "athletics","Athletics" | replace: "testing","Testing" | replace: "pd","Staff development" }}</span></a>{% endif %}{% endfor %}</div>
<aside class="side"><div class="panel" style="border:2px solid var(--ink)"><p class="kick">Conference</p><h3>Thu, Nov 12 · 8:40 am</h3><p class="muted" style="margin:0">With Priya Lindqvist, Room 112. Spanish interpreter requested (story).</p></div>
<div class="panel"><p class="kick">Shared with families</p>{% for r in lib.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "families" and ok %}<a class="hit" style="padding:10px 0" href="{{ PathBase }}/{{ r.RoutePath }}"><b>{{ r.PrimaryField }}</b><p>{% capture rkl -%}{{ x.kind }}{%- endcapture %}{{ rkl | replace: "handbook","Handbook" | replace: "guide","Guide" | replace: "procedure","Procedure" | replace: "checklist","Checklist" | replace: "letter","Letter" }} · {{ x.updated_label }}</p></a>{% endif %}{% endfor %}</div>
{% if in_staff %}<a class="panel" href="{{ PathBase }}/staff-room" style="display:block;text-decoration:none;background:var(--ink);color:#fff"><p class="kick" style="color:#aab3c5">Staff account</p><b style="font-size:1.2rem">Open the staff room →</b></a>{% endif %}<a class="btn line sm" href="{{ PathBase }}/account/logout">Sign out</a></aside></div>
{% else %}<div class="lock"><h2>This account is not set up as a family account.</h2><p>The school office adds family accounts to the families group at enrollment.</p></div>{% endif %}{% endunless %}</div></section>
