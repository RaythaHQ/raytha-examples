{%- assign in_fam=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign lib = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=40) -%}{%- assign evs = get_content_items(ContentType="events", Filter="kind eq 'pd'", OrderBy="sort_order asc", PageSize=10) -%}
<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff room</li></ol><p class="kick">Members only · staff</p><h1>Staff room</h1><p class="lede">This week's bulletin, procedures, training days and the documents shared with staff.</p></div></div>
<section class="sec tight"><div class="w">{% if in_staff %}<div class="dg"><div>{% for r in lib.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{% if au == "staff" and rk == "letter" %}<div class="panel" style="border:2px solid var(--ink);border-top:10px solid var(--bus)"><p class="kick">Bulletin · {{ x.updated_label }}</p><h2 style="font-size:1.6rem">{{ r.PrimaryField }}</h2><div class="prose" style="margin-top:12px">{{ x.body }}</div></div>{% endif %}{% endfor %}
<h2 style="margin:30px 0 14px">Staff documents</h2><div class="rowl">{% for r in lib.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if au == "staff" and ok %}<a class="row" style="grid-template-columns:110px 1fr" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="t">{% capture rkl -%}{{ x.kind }}{%- endcapture %}{{ rkl | replace: "handbook","Handbook" | replace: "guide","Guide" | replace: "procedure","Procedure" | replace: "checklist","Checklist" | replace: "letter","Letter" }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary }}</p></div></a>{% endif %}{% endfor %}</div></div>
<aside class="side"><div class="panel"><p class="kick">Training days</p>{% for e in evs.Items %}<a class="hit" style="padding:8px 0" href="{{ PathBase }}/{{ e.RoutePath }}"><b>{{ e.PublishedContent.date_label }}</b><p>{{ e.PrimaryField }}</p></a>{% endfor %}</div><div class="panel"><p class="kick">Quick numbers</p><dl class="facts"><dt>Subs</dt><dd class="mono">(555) 014-1015</dd><dt>Tech</dt><dd class="mono">(555) 014-1060</dd><dt>Access</dt><dd class="mono">(555) 014-1030</dd></dl></div><a class="btn line sm" href="{{ PathBase }}/account/logout">Sign out</a></aside></div>
{% else %}<div class="lock"><span class="pill">Staff only</span><h2>The staff room is for district employees.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but this account is not in the staff group.{% else %}Sign in with your district staff account.{% endif %} Bulletins, substitute procedures and emergency cards are not sent to the browser for other accounts.</p><p class="cta">{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Sign in</a>{% endunless %}<a class="btn line" href="{{ PathBase }}/families">Family hub</a></p></div>{% endif %}</div></section>
