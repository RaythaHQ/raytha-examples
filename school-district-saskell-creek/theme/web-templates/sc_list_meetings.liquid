<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Board</li></ol><p class="kick">Board of education</p><h1>Meetings, agendas and votes</h1><p class="lede">Seven elected members (fictional). Regular meetings are the first and third Tuesday at 6:30 pm, open to the public, streamed and captioned. Agendas are posted at least 72 hours ahead.</p></div></div>
<section class="sec tight"><div class="w">{% for m in Target.Items %}{%- assign y=m.PublishedContent -%}{%- capture ms -%}{{ y.status }}{%- endcapture -%}{% if ms == "upcoming" %}<div class="mtg" style="margin-bottom:34px"><div class="g2" style="gap:30px"><div><p class="kick">Next meeting · agenda posted</p><h2><a href="{{ PathBase }}/{{ m.RoutePath }}" style="text-decoration:none">{{ m.PrimaryField }}</a></h2><p class="muted" style="margin-top:8px">{{ y.time }} · {{ y.location }}</p><p>{{ y.summary }}</p><a class="btn sm" href="{{ PathBase }}/{{ m.RoutePath }}">Full agenda</a></div><div><ol class="ol2 ag" style="grid-template-columns:1fr">{%- assign ag = y.agenda | split: "||" -%}{% for a in ag %}{%- assign ap = a | split: "::" -%}<li style="border-top-width:0;border-left:8px solid var(--ink)"><h3>{{ ap[0] | strip }}</h3>{% if ap[1] %}<p>{{ ap[1] | strip }}</p>{% endif %}</li>{% endfor %}</ol></div></div></div>{% endif %}{% endfor %}
<h2 style="margin:10px 0 16px">All meetings</h2><table class="tbl"><thead><tr><th>Date</th><th>Meeting</th><th>Kind</th><th>Status</th><th>Summary</th></tr></thead><tbody>{% for m in Target.Items %}{%- assign y=m.PublishedContent -%}{%- capture ms -%}{{ y.status }}{%- endcapture -%}<tr><td class="mono" style="white-space:nowrap">{{ y.date_label }}</td><td><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></td><td>{% capture mkl -%}{{ y.kind }}{%- endcapture %}{{ mkl | replace: "regular","Regular meeting" | replace: "special","Special meeting" | replace: "work","Work session" }}</td><td><span class="aud {% if ms == "approved" %}public{% elsif ms == "draft" %}families{% else %}staff{% endif %}">{% capture msl -%}{{ y.status }}{%- endcapture %}{{ msl | replace: "upcoming","Upcoming" | replace: "draft","Draft minutes" | replace: "approved","Minutes approved" }}</span></td><td style="font-size:.94rem;color:var(--ink2)">{{ y.summary }}</td></tr>{% endfor %}</tbody></table><p class="cta"><a class="btn line" href="{{ PathBase }}/policies">Board policy manual</a></p></div></section>
