{%- assign in_fam=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/resources">Resources</a></li><li>{% capture rkl -%}{{ x.kind }}{%- endcapture %}{{ rkl | replace: "handbook","Handbook" | replace: "guide","Guide" | replace: "procedure","Procedure" | replace: "checklist","Checklist" | replace: "letter","Letter" }}</li></ol><p class="kick"><span class="aud {{ au }}">{% capture al -%}{{ x.audience }}{%- endcapture %}{{ al | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }}</span> · updated {{ x.updated_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div>{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}<div class="lock"><span class="pill">{% capture al2 -%}{{ x.audience }}{%- endcapture %}{{ al2 | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }} only</span><h2>Sign in to read this document.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but your account is not in the {% capture al3 -%}{{ x.audience }}{%- endcapture %}{{ al3 | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }} group.{% else %}This document is shared with {% capture al4 -%}{{ x.audience }}{%- endcapture %}{{ al4 | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }} accounts.{% endif %} The body of this page is only sent to the browser when the signed-in account is in the right group.</p><p class="cta">{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a>{% endunless %}<a class="btn line" href="{{ PathBase }}/resources">All resources</a></p></div>{% endif %}</div>
<aside class="panel" style="border:2px solid var(--ink)"><dl class="facts"><dt>Audience</dt><dd>{% capture al5 -%}{{ x.audience }}{%- endcapture %}{{ al5 | replace: "public","Everyone" | replace: "families","Families" | replace: "staff","Staff" }}</dd><dt>Kind</dt><dd>{% capture rkl2 -%}{{ x.kind }}{%- endcapture %}{{ rkl2 | replace: "handbook","Handbook" | replace: "guide","Guide" | replace: "procedure","Procedure" | replace: "checklist","Checklist" | replace: "letter","Letter" }}</dd><dt>Updated</dt><dd>{{ x.updated_label }}</dd></dl></aside></div></div></section>
