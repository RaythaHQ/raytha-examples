<section class="section"><div class="wrap">
  <div style="border-radius:28px;padding:56px;background:radial-gradient(600px 300px at 90% 0,#2b3fae,transparent 70%),linear-gradient(135deg,#0b1233,#141e57);color:#fff;display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:center" id="ctabox">
    <div><span class="kicker" style="color:#8fe9d2">Need a hand?</span><h2 style="font-size:clamp(1.7rem,3vw,2.4rem);margin:8px 0 10px">{{ widget.settings.headline }}</h2><p style="color:#b9c2ea;margin:0">{{ widget.settings.subtitle }}</p></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px" class="ctaopts">
    {%- for o in widget.settings.options %}{% assign u = o.url %}{% if u contains "://" or u contains "mailto:" %}{% else %}{% assign u = PathBase | append: o.url %}{% endif %}
      <a href="{{ u }}" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:18px;padding:20px;display:block;transition:.25s" onmouseover="this.style.background='rgba(255,255,255,.13)'" onmouseout="this.style.background='rgba(255,255,255,.07)'"><i class="bi bi-{{ o.icon }}" style="font-size:1.4rem;color:#8fe9d2"></i><h3 style="font-size:1.02rem;margin:10px 0 4px;color:#fff">{{ o.title }}</h3><p style="margin:0;font-size:.86rem;color:#a9b3df">{{ o.body }}</p></a>
    {%- endfor %}
    </div>
  </div>
</div></section>
<style>@media(max-width:900px){#ctabox{grid-template-columns:1fr!important;padding:32px!important}.ctaopts{grid-template-columns:1fr!important}}</style>
