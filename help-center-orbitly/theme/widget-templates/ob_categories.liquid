{%- assign cats = get_content_items(ContentType="categories", OrderBy="sort_order asc", PageSize=12) -%}
<section class="section"><div class="wrap">
  <div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2></div><a class="btn btn-line" href="{{ PathBase }}/help">All topics <i class="bi bi-arrow-right"></i></a></div>
  <div class="cats">
  {%- for c in cats.Items %}{% assign cid = c.Id | append: "" %}{% capture f %}category eq '{{ cid }}'{% endcapture %}{% assign n = get_content_items(ContentType="articles", Filter=f, PageSize=1).TotalCount %}
    <a class="card lift cat reveal" style="--c:{{ c.PublishedContent.color }}" href="{{ PathBase }}/{{ c.RoutePath }}"><span class="ico"><i class="bi bi-{{ c.PublishedContent.icon }}"></i></span><h3>{{ c.PrimaryField }}</h3><p>{{ c.PublishedContent.description }}</p><span class="n">{{ n }} articles <i class="bi bi-arrow-right"></i></span></a>
  {%- endfor %}
  </div>
</div></section>
