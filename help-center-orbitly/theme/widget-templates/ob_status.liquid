<section class="section tight"><div class="narrow" style="width:min(940px,100% - 48px)">
  <div class="status-hd"><span class="pulse"></span>{{ widget.settings.summary }}</div>
  <div class="card" style="margin-top:20px;overflow:hidden">
    <div style="display:flex;justify-content:space-between;padding:16px 22px;font-size:.85rem" class="muted"><span>Last 90 days</span><span><i class="bi bi-square-fill" style="color:#9fe3cf"></i> Operational &nbsp; <i class="bi bi-square-fill" style="color:var(--sun)"></i> Degraded</span></div>
    {%- for c in widget.settings.components %}{% capture dd %},{{ c.degraded | remove: " " }},{% endcapture %}
    <div class="comp"><b>{{ c.name }}</b><span class="muted" style="font-size:.88rem">{{ c.uptime }} uptime</span>
      <div class="bars">{% for i in (1..90) %}{% capture key %},{{ i }},{% endcapture %}<i{% if dd contains key %} class="d"{% endif %}></i>{% endfor %}</div></div>
    {%- endfor %}
  </div>
  <h2 style="font-size:1.5rem;margin:48px 0 10px">Past incidents</h2>
  {%- for x in widget.settings.incidents %}
  <div class="rel" style="grid-template-columns:150px 1fr;padding:22px 0"><span class="when">{{ x.date }}</span><div><h3 style="font-size:1.1rem;margin:0 0 6px">{{ x.title }}</h3><p class="muted" style="margin:0">{{ x.body }}</p></div></div>
  {%- endfor %}
</div></section>
