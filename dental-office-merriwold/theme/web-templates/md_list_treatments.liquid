{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}{%- capture fq -%}{{ QueryParams.family | strip }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>Treatments</li></ol><p class="kick">Treatments · {{ Target.TotalCount }} in all</p><h1>What we do, and what it takes</h1><p class="lede">Every treatment with the visits it takes, the minutes in the chair for each, and an honest 1 to 5 rating of how it feels. Pick one for the visit-by-visit plan and the teeth it applies to.</p></div></div><section class="sec tight"><div class="w"><div class="filters"><a href="?" class="{% if fq == "" %}on{% endif %}">All</a><a href="?family=preventive" class="{% if fq == "preventive" %}on{% endif %}">Preventive</a><a href="?family=restorative" class="{% if fq == "restorative" %}on{% endif %}">Restorative</a><a href="?family=cosmetic" class="{% if fq == "cosmetic" %}on{% endif %}">Cosmetic</a><a href="?family=orthodontic" class="{% if fq == "orthodontic" %}on{% endif %}">Orthodontic</a><a href="?family=surgical" class="{% if fq == "surgical" %}on{% endif %}">Oral surgery</a><a href="?family=urgent" class="{% if fq == "urgent" %}on{% endif %}">Urgent care</a><a href="?family=children" class="{% if fq == "children" %}on{% endif %}">Children</a></div><div class="ledger"><div class="lrow lhead" style="border:0"><span>Treatment</span><span class="fcol">Family</span><span>How it feels</span><span class="vcol">Visits, by chair time</span><span class="mins">Chair time</span></div>{% for t in Target.Items %}{%- assign y = t.PublishedContent -%}{%- capture yf -%}{{ y.family }}{%- endcapture -%}{% if fq == "" or fq == yf %}<a class="lrow" href="{{ PathBase }}/{{ t.RoutePath }}">{%- assign vs = y.visits | split: "|" -%}{%- assign tot = 0 -%}{%- assign vcount = vs | size -%}{% for v in vs %}{%- assign vp = v | split: "~" -%}{%- assign tot = tot | plus: vp[0] -%}{% endfor %}{%- capture _nfv -%}{{ y.feel }}{%- endcapture -%}{%- assign fv = _nfv | plus: 0 -%}<span><b>{{ t.PrimaryField }}</b><small>{{ y.teeth_label }}</small></span><span class="fcol"><span class="tg">{% capture lv2 -%}{{ y.family }}{%- endcapture %}{% case lv2 %}{% when "preventive" %}Preventive{% when "restorative" %}Restorative{% when "cosmetic" %}Cosmetic{% when "orthodontic" %}Orthodontic{% when "surgical" %}Oral surgery{% when "urgent" %}Urgent care{% when "children" %}Children{% else %}{{ lv2 }}{% endcase %}</span></span><span><span class="feel" title="How it feels: {{ fv }} of 5">{% for i in (1..5) %}<i class="{% if i <= fv %}on{% endif %}"></i>{% endfor %}</span></span><span class="vcol"><span class="vbar">{%- assign vs = y.visits | split: "|" -%}{% for v in vs %}{%- assign vp = v | split: "~" -%}<span style="width:{{ vp[0] | plus: 0 | times: 100 | divided_by: 240 }}%"></span>{% endfor %}</span><small class="muted" style="font-size:.8rem">{{ vcount }} visit{% if vcount > 1 %}s{% endif %}</small></span><span class="mins">{{ tot }} min</span></a>{% endif %}{% endfor %}</div><p class="muted" style="margin-top:16px;font-size:.92rem">Prefer to start from a tooth? <a href="{{ PathBase }}/chart">Open the tooth map</a>.</p></div></section>
