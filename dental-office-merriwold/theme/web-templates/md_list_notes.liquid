{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>Chairside notes</li></ol><p class="kick">Chairside notes</p><h1>What we see in the chair</h1><p class="lede">Short pieces by the clinicians, each about one tooth. Every note links back to the tooth on the map.</p></div></div><section class="sec tight"><div class="w"><div class="notes">{% for n in Target.Items %}{%- assign y = n.PublishedContent -%}<a class="card note" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="tbig"><small>Tooth</small>{{ y.tooth }}</span><b>{{ n.PrimaryField }}</b><p class="muted" style="margin:0;font-size:.95rem">{{ y.summary }}</p><span class="mono muted" style="font-size:.76rem;margin-top:auto">{{ y.author | upcase }} · {%- capture _d1 -%}{{ y.date }}{%- endcapture -%}{{ _d1 | date: "%b %-d" | upcase }}</span></a>{% endfor %}</div></div></section>
