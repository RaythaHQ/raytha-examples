{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}{%- assign y=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li><a href="{{ PathBase }}/desk">Huddle</a></li></ol><p class="kick">Team only</p><h1>{% if in_tm %}{{ Target.PrimaryField }}{% else %}Huddle item{% endif %}</h1><p class="lede">{% if in_tm %}{{ y.date }} · {{ y.owner }}{% else %}Sign in as a team member to see it.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if in_tm %}<div class="card" style="max-width:720px"><p>{{ y.note }}</p><p><a href="{{ PathBase }}/desk">← Back to the huddle</a></p></div>{% else %}<div class="lockp"><p class="kick" style="color:var(--coral)">🔒 Team only</p><h2>The morning huddle is for the Merriwold team.</h2><p class="muted">Checked on the server: signed out, or signed in as a patient, none of the huddle items are sent to the browser.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Team sign-in</a></p></div>{% endif %}</div></section>
