{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}{%- assign y=Target.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "patients" and in_pt == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "team" and in_tm == false -%}{%- assign ok=false -%}{%- endif -%}{%- capture ytr -%}{{ y.treatment }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li><a href="{{ PathBase }}/library">Library</a></li><li>{{ y.code }}</li></ol><p class="kick">{{ y.code }} · {% capture lv8 -%}{{ y.kind }}{%- endcapture %}{% case lv8 %}{% when "aftercare" %}Aftercare{% when "before" %}Before your visit{% when "form" %}Printable form{% when "homecare" %}Home care{% else %}{{ lv8 }}{% endcase %} · {{ y.pages }} printed page{%- capture _pg -%}{{ y.pages }}{%- endcapture -%}{%- assign pgn = _pg | plus: 0 -%}{% if pgn > 1 %}s{% endif %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{% if ok %}{{ y.summary }}{% else %}A sheet for signed-in patients of the practice.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% unless ok %}<div class="lockp"><p class="kick" style="color:var(--coral)">🔒 For patients</p><h2>This sheet is in the patient room.</h2><p class="muted">This is checked on the server: signed out, the instructions and forms are never sent to the browser. In the story, the front desk opens an account for each patient at their first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Patient sign-in</a><a class="btn line" href="{{ PathBase }}/patients">What is in the patient room</a></p></div>{% else %}<div class="tgrid"><div>{%- capture _c1 -%}{{ y.timeline }}{%- endcapture -%}{% if _c1 != "" %}<h2>What to expect, hour by hour</h2><div class="track"><ol>{%- assign tls = y.timeline | split: "|" -%}{% for tl in tls %}{%- assign tp = tl | split: "~" -%}{%- assign th = tp[0] | plus: 0 -%}<li><b>{% if th == 0 %}Right after{% elsif th < 24 %}{{ th }} hours{% elsif th < 168 %}{%- assign _dd = th | divided_by: 24 -%}Day {{ _dd }}{% elsif th < 720 %}{%- assign _ww = th | divided_by: 168 -%}Week {{ _ww }}{% else %}{%- assign _mm = th | divided_by: 720 -%}Month {{ _mm }}{% endif %}</b><span>{{ tp[1] }}</span></li>{% endfor %}</ol></div>{% endif %}<div class="prose">{{ y.body }}</div><p class="mono muted" style="font-size:.78rem;margin-top:30px">■ MERRIWOLD DENTAL · SHEET {{ y.code }} · FICTIONAL SAMPLE, NOT MEDICAL ADVICE · CALL 555-0181 WITH ANY WORRY</p></div><aside class="side">{% if ytr != "" %}{%- assign trs = get_content_items(ContentType="treatments", PageSize=40) -%}{% for t in trs.Items %}{%- capture tpf -%}{{ t.PrimaryField }}{%- endcapture -%}{% if tpf == ytr %}{%- assign tyy = t.PublishedContent -%}{%- assign vs = tyy.visits | split: "|" -%}{%- assign tot = 0 -%}{%- assign vcount = vs | size -%}{% for v in vs %}{%- assign vp = v | split: "~" -%}{%- assign tot = tot | plus: vp[0] -%}{% endfor %}<div class="card"><p class="kick">For this treatment</p><a href="{{ PathBase }}/{{ t.RoutePath }}" style="font-family:'Source Serif 4',serif;font-size:1.3rem;font-weight:600;text-decoration:none">{{ t.PrimaryField }}</a><p class="muted" style="margin:6px 0 0">{{ vcount }} visit{% if vcount > 1 %}s{% endif %} · {{ tot }} min in the chair · back to normal: {{ tyy.recovery | downcase }}</p></div>{% endif %}{% endfor %}{% endif %}<div class="card" style="margin-top:16px;background:var(--coral2);border-color:#f6c8b9"><p class="kick" style="color:#a2412b">Call us if</p><p style="margin:0">pain gets worse after day three, bleeding does not stop with gauze, or you have a fever. Out of hours, the answerphone gives the on-call number.</p></div></aside></div>{% endunless %}</div></section>
