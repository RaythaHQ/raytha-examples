{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}{%- assign hs = get_content_items(ContentType="huddle", OrderBy="date asc", PageSize=100) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>Team huddle</li></ol><p class="kick">Team only · {{ tdate }}</p><h1>Morning huddle</h1><p class="lede">Lab cases, sterilizer checks, recall calls and chair notes for today and the days ahead. Visible only to signed-in team members.</p></div></div><section class="sec tight"><div class="w">{% if in_tm %}{%- assign kt = 0 -%}{%- assign kl = 0 -%}{%- assign kn = 0 -%}{%- assign kd = 0 -%}{% for h in hs.Items %}{%- assign hy = h.PublishedContent -%}{%- capture hd_d -%}{{ hy.date }}{%- endcapture -%}{%- assign hd = hd_d | remove: "-" | plus: 0 -%}{%- capture hdn -%}{{ hy.done }}{%- endcapture -%}{% if hdn == "yes" %}{%- assign kd = kd | plus: 1 -%}{% elsif hd == todayn %}{%- assign kt = kt | plus: 1 -%}{% elsif hd < todayn %}{%- assign kl = kl | plus: 1 -%}{% else %}{%- assign kn = kn | plus: 1 -%}{% endif %}{% endfor %}<div class="kpis"><div><b>{{ kt }}</b><span>for today</span></div><div><b style="color:var(--coral)">{{ kl }}</b><span>carried over</span></div><div><b>{{ kn }}</b><span>coming up</span></div><div><b>{{ kd }}</b><span>done</span></div></div><div class="board"><div class="col"><h3>Today and carried over</h3>{% for h in hs.Items %}{%- capture hd0_d -%}{{ h.PublishedContent.date }}{%- endcapture -%}{%- assign hd0 = hd0_d | remove: "-" | plus: 0 -%}{%- capture hdn0 -%}{{ h.PublishedContent.done }}{%- endcapture -%}{% if hdn0 != "yes" and hd0 <= todayn %}{%- assign hy = h.PublishedContent -%}{%- capture hd_d -%}{{ hy.date }}{%- endcapture -%}{%- assign hd = hd_d | remove: "-" | plus: 0 -%}{%- capture hdn -%}{{ hy.done }}{%- endcapture -%}{%- capture _nhch -%}{{ hy.chair }}{%- endcapture -%}{%- assign hch = _nhch | plus: 0 -%}<div class="item{% if hdn == "yes" %} done{% elsif hd < todayn %} late{% endif %}"><b>{{ h.PrimaryField }}</b><small>{% capture lv11 -%}{{ hy.kind }}{%- endcapture %}{% case lv11 %}{% when "lab" %}Lab case{% when "steri" %}Sterilization{% when "recall" %}Recall calls{% when "supplies" %}Supplies{% when "chair" %}Chair note{% when "training" %}Training{% else %}{{ lv11 }}{% endcase %} · {% if hch > 0 %}Chair {{ hch }} · {% endif %}{{ hy.owner }}{% if hdn == "yes" %} · done{% endif %}</small><span style="font-size:.88rem;color:var(--ink2)">{{ hy.note }}</span></div>{% endif %}{% endfor %}</div><div class="col"><h3>Coming up</h3>{% for h in hs.Items %}{%- capture hd1_d -%}{{ h.PublishedContent.date }}{%- endcapture -%}{%- assign hd1 = hd1_d | remove: "-" | plus: 0 -%}{%- capture hdn1 -%}{{ h.PublishedContent.done }}{%- endcapture -%}{% if hdn1 != "yes" and hd1 > todayn %}{%- assign hy = h.PublishedContent -%}{%- capture hd_d -%}{{ hy.date }}{%- endcapture -%}{%- assign hd = hd_d | remove: "-" | plus: 0 -%}{%- capture hdn -%}{{ hy.done }}{%- endcapture -%}{%- capture _nhch -%}{{ hy.chair }}{%- endcapture -%}{%- assign hch = _nhch | plus: 0 -%}<div class="item{% if hdn == "yes" %} done{% elsif hd < todayn %} late{% endif %}"><span class="mono muted" style="font-size:.74rem">{%- capture _d5 -%}{{ hy.date }}{%- endcapture -%}{{ _d5 | date: "%a %b %-d" | upcase }}</span><br><b>{{ h.PrimaryField }}</b><small>{% capture lv11 -%}{{ hy.kind }}{%- endcapture %}{% case lv11 %}{% when "lab" %}Lab case{% when "steri" %}Sterilization{% when "recall" %}Recall calls{% when "supplies" %}Supplies{% when "chair" %}Chair note{% when "training" %}Training{% else %}{{ lv11 }}{% endcase %} · {% if hch > 0 %}Chair {{ hch }} · {% endif %}{{ hy.owner }}{% if hdn == "yes" %} · done{% endif %}</small><span style="font-size:.88rem;color:var(--ink2)">{{ hy.note }}</span></div>{% endif %}{% endfor %}</div><div class="col"><h3>Done</h3>{% for h in hs.Items %}{%- capture hdn2 -%}{{ h.PublishedContent.done }}{%- endcapture -%}{% if hdn2 == "yes" %}{%- assign hy = h.PublishedContent -%}{%- capture hd_d -%}{{ hy.date }}{%- endcapture -%}{%- assign hd = hd_d | remove: "-" | plus: 0 -%}{%- capture hdn -%}{{ hy.done }}{%- endcapture -%}{%- capture _nhch -%}{{ hy.chair }}{%- endcapture -%}{%- assign hch = _nhch | plus: 0 -%}<div class="item{% if hdn == "yes" %} done{% elsif hd < todayn %} late{% endif %}"><b>{{ h.PrimaryField }}</b><small>{% capture lv11 -%}{{ hy.kind }}{%- endcapture %}{% case lv11 %}{% when "lab" %}Lab case{% when "steri" %}Sterilization{% when "recall" %}Recall calls{% when "supplies" %}Supplies{% when "chair" %}Chair note{% when "training" %}Training{% else %}{{ lv11 }}{% endcase %} · {% if hch > 0 %}Chair {{ hch }} · {% endif %}{{ hy.owner }}{% if hdn == "yes" %} · done{% endif %}</small><span style="font-size:.88rem;color:var(--ink2)">{{ hy.note }}</span></div>{% endif %}{% endfor %}</div></div>{% else %}<div class="lockp"><p class="kick" style="color:var(--coral)">🔒 Team only</p><h2>The morning huddle is for the Merriwold team.</h2><p class="muted">Checked on the server: signed out, or signed in as a patient, none of the huddle items are sent to the browser.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Team sign-in</a></p></div>{% endif %}</div></section>
