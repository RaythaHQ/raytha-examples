{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}{%- assign gs = get_content_items(ContentType="guides", OrderBy="sort_order asc", PageSize=60) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>Patient room</li></ol><p class="kick">For patients of the practice</p><h1>{% if in_pt %}Welcome back, {{ CurrentUser.FirstName }}{% else %}The patient room{% endif %}</h1><p class="lede">Aftercare instructions for every treatment, the care sheets we hand out at the chair, and forms you can print and fill in at home before a visit.</p></div></div><section class="sec tight"><div class="w">{% unless in_pt %}<div class="lockp"><p class="kick" style="color:var(--coral)">🔒 For patients</p><h2>Sign in to open the patient room.</h2><p class="muted">This is checked on the server: signed out, the instructions and forms are never sent to the browser. In the story, the front desk opens an account for each patient at their first visit.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/patients">Patient sign-in</a><a class="btn line" href="{{ PathBase }}/patients">What is in the patient room</a></p></div><h2 class="grp" style="margin-top:36px">What is inside</h2><div class="shelf">{% for g in gs.Items %}{%- assign y = g.PublishedContent -%}{%- capture gau -%}{{ y.audience }}{%- endcapture -%}{% if gau == "patients" %}<div class="sheet lockd"><span class="code">{{ y.code }} · {% capture lv12 -%}{{ y.kind }}{%- endcapture %}{% case lv12 %}{% when "aftercare" %}Aftercare{% when "before" %}Before your visit{% when "form" %}Printable form{% when "homecare" %}Home care{% else %}{{ lv12 }}{% endcase %}</span><b>{{ g.PrimaryField }}</b><span class="ft"><span>{{ y.pages }} page{%- capture _pg -%}{{ y.pages }}{%- endcapture -%}{%- assign pgn = _pg | plus: 0 -%}{% if pgn > 1 %}s{% endif %}</span><span class="tg lock">🔒</span></span></div>{% endif %}{% endfor %}</div>{% else %}<h2 class="grp">Aftercare</h2><div class="shelf" style="margin-bottom:10px">{% for g in gs.Items %}{%- assign y = g.PublishedContent -%}{%- capture gk -%}{{ y.kind }}{%- endcapture -%}{%- capture gau -%}{{ y.audience }}{%- endcapture -%}{% if gk == "aftercare" and gau == "patients" %}<a class="sheet" href="{{ PathBase }}/{{ g.RoutePath }}"><span class="code">{{ y.code }}</span><b>{{ g.PrimaryField }}</b><p>{{ y.summary }}</p><span class="ft"><span>{{ y.pages }} page{%- capture _pg -%}{{ y.pages }}{%- endcapture -%}{%- assign pgn = _pg | plus: 0 -%}{% if pgn > 1 %}s{% endif %}</span><span>{%- capture _c3 -%}{{ y.timeline }}{%- endcapture -%}{% if _c3 != "" %}Hour-by-hour{% else %}Print at home{% endif %}</span></span></a>{% endif %}{% endfor %}</div><h2 class="grp">Home care</h2><div class="shelf" style="margin-bottom:10px">{% for g in gs.Items %}{%- assign y = g.PublishedContent -%}{%- capture gk -%}{{ y.kind }}{%- endcapture -%}{%- capture gau -%}{{ y.audience }}{%- endcapture -%}{% if gk == "homecare" and gau == "patients" %}<a class="sheet" href="{{ PathBase }}/{{ g.RoutePath }}"><span class="code">{{ y.code }}</span><b>{{ g.PrimaryField }}</b><p>{{ y.summary }}</p><span class="ft"><span>{{ y.pages }} page{%- capture _pg -%}{{ y.pages }}{%- endcapture -%}{%- assign pgn = _pg | plus: 0 -%}{% if pgn > 1 %}s{% endif %}</span><span>{%- capture _c4 -%}{{ y.timeline }}{%- endcapture -%}{% if _c4 != "" %}Hour-by-hour{% else %}Print at home{% endif %}</span></span></a>{% endif %}{% endfor %}</div><h2 class="grp">Printable forms</h2><div class="shelf" style="margin-bottom:10px">{% for g in gs.Items %}{%- assign y = g.PublishedContent -%}{%- capture gk -%}{{ y.kind }}{%- endcapture -%}{%- capture gau -%}{{ y.audience }}{%- endcapture -%}{% if gk == "form" and gau == "patients" %}<a class="sheet" href="{{ PathBase }}/{{ g.RoutePath }}"><span class="code">{{ y.code }}</span><b>{{ g.PrimaryField }}</b><p>{{ y.summary }}</p><span class="ft"><span>{{ y.pages }} page{%- capture _pg -%}{{ y.pages }}{%- endcapture -%}{%- assign pgn = _pg | plus: 0 -%}{% if pgn > 1 %}s{% endif %}</span><span>{%- capture _c5 -%}{{ y.timeline }}{%- endcapture -%}{% if _c5 != "" %}Hour-by-hour{% else %}Print at home{% endif %}</span></span></a>{% endif %}{% endfor %}</div><div class="card" style="margin-top:26px;background:var(--mint2);border-color:var(--mint)"><p class="kick">About the forms</p><p style="margin:0">Print them, fill them in at home and bring them to your visit. Nothing is submitted through this website, and nothing about your treatment is stored here.</p></div>{% endunless %}</div></section>
