ss="people" style="margin-top:20px">{%- assign ps = get_content_items(ContentType="clinicians", OrderBy="sort_order asc", PageSize=3) -%}{% for p in ps.Items %}{%- assign y = p.PublishedContent -%}<a class="card person" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ini">{{ y.initials }}</span><div><b style="font-family:'Source Serif 4',serif;font-size:1.2rem">{{ p.PrimaryField }}</b><div class="muted" style="font-size:.9rem">{{ y.role }} · {{ y.credentials }}</div></div><p style="margin:0;font-size:.95rem">{{ y.summary }}</p>{%- capture dd -%},{{ y.days }},{%- endcapture -%}<div class="days"><span class="{% if dd contains ",Mon," %}on{% endif %}">Mon</span><span class="{% if dd contains ",Tue," %}on{% endif %}">Tue</span><span class="{% if dd contains ",Wed," %}on{% endif %}">Wed</span><span class="{% if dd contains ",Thu," %}on{% endif %}">Thu</span><span class="{% if dd contains ",Fri," %}on{% endif %}">Fri</span><span class="{% if dd contains ",Sat," %}on{% endif %}">Sat</span></div></a>{% endfor %}</div></div></section><section class="sec" style="padding-top:0"><div class="w"><div class="band"><div><p class="kick">The patient room</p><h2>Aftercare, forms and home care, for our patients</h2><p>Hour-by-hour aftercare for every treatment, printable forms to fill in at home, and the care sheets we hand out at the chair. Checked on the server, so signed-out visitors see the titles and nothing else.</p><p class="cta">{% if in_pt %}<a class="btn" href="{{ PathBase }}/patients">Go to the patient room</a>{% else %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/patients">Patient sign-in</a><a class="btn line" href="{{ PathBase }}/patients">What is in there</a>{% endif %}</p></div><div>{%- assign gs = get_content_items(ContentType="guides", OrderBy="sort_order asc", PageSize=40) -%}{%- assign gn = 0 -%}{% for g in gs.Items %}{%- assign gy = g.PublishedContent -%}{%- capture gau -%}{{ gy.audience }}{%- endcapture -%}{% if gau == "patients" and gn < 6 %}{%- assign gn = gn | plus: 1 -%}<div class="lockrow"><span class="tg {% unless in_pt %}lock{% endunless %}">{% if in_pt %}Open{% else %}🔒{% endif %} {{ gy.code }}</span><span><b style="color:#fff">{{ g.PrimaryField }}</b></span></div>{% endif %}{% endfor %}</div></div></div></section><section class="sec alt"><div class="w"><div class="two"><div><p class="kick">Answers</p><h2>The questions people ask at the front desk</h2><p class="muted">Short answers first. The long ones are a click away, written by whoever on the team gets asked most.</p><p class="cta"><a class="btn line" href="{{ PathBase }}/answers">All answers</a></p></div><div>{%- assign qs = get_content_items(ContentType="questions", OrderBy="sort_order asc", PageSize=5) -%}{% for q in qs.Items %}<details class="qa"><summary>{{ q.PrimaryField }}</summary><div class="a">{{ q.PublishedContent.short }} <a href="{{ PathBase }}/{{ q.RoutePath }}">More</a></div></details>{% endfor %}</div></div></div></section>
