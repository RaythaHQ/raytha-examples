{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>Huddle</li></ol><p class="kick">Team only</p><h1>Huddle items</h1><p class="lede">Every item on the morning huddle board, by date.</p></div></div><section class="sec tight"><div class="w">{% if in_tm %}<div style="max-width:780px">{% for h in Target.Items %}{%- assign hy = h.PublishedContent -%}{%- capture hd_d -%}{{ hy.date }}{%- endcapture -%}{%- assign hd = hd_d | remove: "-" | plus: 0 -%}{%- capture hdn -%}{{ hy.done }}{%- endcapture -%}{%- capture _nhch -%}{{ hy.chair }}{%- endcapture -%}{%- assign hch = _nhch | plus: 0 -%}<div class="item{% if hdn == "yes" %} done{% elsif hd < todayn %} late{% endif %}"><b>{{ h.PrimaryField }}</b><small>{% capture lv11 -%}{{ hy.kind }}{%- endcapture %}{% case lv11 %}{% when "lab" %}Lab case{% when "steri" %}Sterilization{% when "recall" %}Recall calls{% when "supplies" %}Supplies{% when "chair" %}Chair note{% when "training" %}Training{% else %}{{ lv11 }}{% endcase %} · {% if hch > 0 %}Chair {{ hch }} · {% endif %}{{ hy.owner }}{% if hdn == "yes" %} · done{% endif %}</small><span style="font-size:.88rem;color:var(--ink2)">{{ hy.note }}</span></div>{% endfor %}</div>{% else %}<div class="lockp"><p class="kick" style="color:var(--coral)">🔒 Team only</p><h2>The morning huddle is for the Merriwold team.</h2><p class="muted">Checked on the server: signed out, or signed in as a patient, none of the huddle items are sent to the browser.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Team sign-in</a></p></div>{% endif %}</div></section>
