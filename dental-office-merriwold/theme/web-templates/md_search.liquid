gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "patients" and in_pt == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "team" and in_tm == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% unless ok %} <span class="tg lock">🔒 Patients</span>{% endunless %}<p>{% if ok %}{{ x.summary | default: x.short | default: x.bio | strip_html | truncate: 160 }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=crown">crown</a>, <a href="?q=wisdom">wisdom</a>, <a href="?q=nervous">nervous</a> or <a href="?q=molar">molar</a>.</p>{% endif %}</div></div></section>
