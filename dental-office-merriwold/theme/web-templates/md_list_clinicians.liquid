{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign wds = "now" | date: "%a" -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_pt=false -%}{%- assign in_tm=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "patients" -%}{%- assign in_pt=true -%}{%- endif -%}{%- if g == "team" -%}{%- assign in_tm=true -%}{%- assign in_pt=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pt=true -%}{%- assign in_tm=true -%}{%- endif -%}{%- assign HL = "," -%}{%- assign tsel = 0 -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Merriwold</a></li><li>The team</li></ol><p class="kick">The team · {{ Target.TotalCount }} people</p><h1>Who you will meet</h1><p class="lede">Three dentists, two hygienists and the person who writes up every plan and estimate. Days in and languages for each.</p></div></div><section class="sec tight"><div class="w"><div class="people">{% for p in Target.Items %}{%- assign y = p.PublishedContent -%}<a class="card person" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ini">{{ y.initials }}</span><div><b style="font-family:'Source Serif 4',serif;font-size:1.2rem">{{ p.PrimaryField }}</b><div class="muted" style="font-size:.9rem">{{ y.role }} · {{ y.credentials }}</div></div><p style="margin:0;font-size:.95rem">{{ y.summary }}</p>{%- capture dd -%},{{ y.days }},{%- endcapture -%}<div class="days"><span class="{% if dd contains ",Mon," %}on{% endif %}">Mon</span><span class="{% if dd contains ",Tue," %}on{% endif %}">Tue</span><span class="{% if dd contains ",Wed," %}on{% endif %}">Wed</span><span class="{% if dd contains ",Thu," %}on{% endif %}">Thu</span><span class="{% if dd contains ",Fri," %}on{% endif %}">Fri</span><span class="{% if dd contains ",Sat," %}on{% endif %}">Sat</span></div></a>{% endfor %}</div></div></section>
