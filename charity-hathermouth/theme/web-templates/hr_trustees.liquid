{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Trustees</li></ol><p class="kick">Trustees · trustees only</p><h1>{% if in_tr %}Board pack{% else %}Trustees{% endif %}</h1><p class="lede">{% if in_tr %}Minutes, board papers, the risk register and the management accounts. Names and figures are fictional.{% else %}Minutes, board papers and the risk register, for signed-in trustees.{% endif %}</p></div></div>
{% if in_tr %}{%- assign tn = get_content_items(ContentType="notices", Filter="audience eq 'trustees'", OrderBy="sort_order asc", PageSize=20) -%}{%- assign te = get_content_items(ContentType="events", Filter="audience eq 'trustees'", OrderBy="sort_order asc", PageSize=10) -%}{%- assign ta = get_content_items(ContentType="appeals", OrderBy="sort_order asc", PageSize=1) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,420px) minmax(0,1fr)"><div><div class="idcard tr"><div class="t">HATHERMOUTH RIVER RESCUE · BOARD PACK</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">TRUSTEE · DEMO ACCOUNT<br>PAPERS BELOW ARE FICTIONAL</div></div><h2 style="margin:26px 0 8px;font-size:1.4rem">Meetings</h2><div class="cal" style="grid-template-columns:1fr">{% for e in te.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div>
<div>{% for a in ta.Items %}{%- assign y=a.PublishedContent -%}<div class="panel light"><p class="kick">Appeal tracker</p><h3>{{ a.PrimaryField }}</h3>{%- assign gl = y.goal | append: "" | plus: 0 -%}{%- assign rs = y.raised | append: "" | plus: 0 -%}{%- assign gp = rs | times: 100 | divided_by: gl | floor -%}{% if gp > 100 %}{%- assign gp = 100 -%}{% endif %}{%- assign left = gl | minus: rs -%}<div class="gauge"><div class="track" role="img" aria-label="{{ gp }} percent of target raised"><i style="width:{{ gp }}%"></i></div><div class="nums"><span><b>${{ rs | format_number: "N0" }}</b>raised</span><span style="text-align:center"><b>{{ gp }}%</b>of target</span><span style="text-align:right"><b>${{ gl | format_number: "N0" }}</b>target</span></div></div><p class="muted" style="font-size:.9rem;margin:0">The board paper on procurement needs &#36;250,000 by January to keep the April delivery date.</p></div>{% endfor %}</div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:14px">Minutes, papers and the risk register</h2><ul class="rows">{% for r in tn.Items %}{%- assign y=r.PublishedContent -%}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></span><span><span class="tag tr">{% capture lv22 -%}{{ y.kind }}{%- endcapture %}{% case lv22 %}{% when "sop" %}Procedure{% when "kit" %}Kit check{% when "rota" %}Rota{% when "bulletin" %}Bulletin{% when "minutes" %}Minutes{% when "paper" %}Board paper{% when "risk" %}Risk register{% when "accounts" %}Accounts{% else %}{{ lv22 }}{% endcase %}</span></span></li>{% endfor %}</ul></div></section>
{% else %}<section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_crew %}<div class="lockp"><p class="kick">🔒 Trustees only</p><h2>You are signed in with a crew account.</h2><p class="muted">Board papers are for trustees. Your procedures and bulletins are in the <a href="{{ PathBase }}/crew-room">crew room</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Trustees only</p><h2>Trustees sign in to see the board pack.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/trustees">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% endif %}</div></section>{% endif %}
