<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Stay safe</li></ol><p class="kick">Stay safe</p><h1>Six rules for the <em>River Hather</em></h1><p class="lede">Written by our crew from the callouts they go to most. If someone is in trouble in the water, call 911 first.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="signs">{% for a in Target.Items %}{%- assign y=a.PublishedContent -%}<a class="sign" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="st" aria-hidden="true"></span><span class="b"><span class="lab">{% capture lv2 -%}{{ y.kind }}{%- endcapture %}{% case lv2 %}{% when "cold" %}Cold water{% when "tides" %}Tides and mud{% when "flood" %}Floods{% when "ice" %}Ice{% when "dogs" %}Dogs{% when "paddling" %}Paddling{% else %}{{ lv2 }}{% endcase %}</span><h3>{{ a.PrimaryField }}</h3><span class="rule">{{ y.rule }}</span><span class="muted" style="font-size:.93rem">{{ y.summary }}</span></span></a>{% endfor %}</div></div></section>
