{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign dow = "now" | date: "%u" | plus: 0 -%}{%- assign wk = doy | minus: dow | plus: 10 | divided_by: 7 | floor -%}{%- assign wi = wk | modulo: 4 -%}{%- assign wl = get_content_items(ContentType="watches", OrderBy="sort_order asc", PageSize=4) -%}{% for x in wl.Items %}{% if forloop.index0 == wi %}{%- assign onw = x -%}{% endif %}{% endfor %}{%- assign onwc = onw.PublishedContent -%}{%- capture owcol -%}{{ onwc.color }}{%- endcapture -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Watches</li></ol><p class="kick">The watches</p><h1>Four watches, <em>one pager</em></h1><p class="lede">Each watch takes the pager for a week, from Monday 08:00. Which watch is on call is worked out on the server from the week number; nobody edits it.</p></div></div><section class="sec tight"><div class="w"><div class="watches">{% for w in Target.Items %}{%- assign y=w.PublishedContent -%}{%- capture wc -%}{{ y.color }}{%- endcapture -%}<a class="wcard{% if w.RoutePath == onw.RoutePath %} on{% endif %}" href="{{ PathBase }}/{{ w.RoutePath }}" style="--c:{{ wc }}">{% if w.RoutePath == onw.RoutePath %}<span class="onb">ON CALL</span>{% endif %}<h3>{{ w.PrimaryField }}</h3><small>Leader {{ y.leader }} · {{ y.crew_count }} crew · since {{ y.since }}</small><span style="font-size:.94rem">{{ y.summary }}</span></a>{% endfor %}</div></div></section>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2>The next eight weeks</h2><p class="muted" style="margin:0 0 18px">The rota repeats every four weeks. Swaps are agreed between watch leaders.</p><div class="rota">{%- assign ri = wk | plus: 0 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}" class="now"><span>THIS WEEK · WK {{ wk | plus: 0 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 1 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>NEXT WEEK · WK {{ wk | plus: 1 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 2 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 2 WEEKS · WK {{ wk | plus: 2 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 3 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 3 WEEKS · WK {{ wk | plus: 3 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 4 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 4 WEEKS · WK {{ wk | plus: 4 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 5 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 5 WEEKS · WK {{ wk | plus: 5 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 6 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 6 WEEKS · WK {{ wk | plus: 6 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}{%- assign ri = wk | plus: 7 | modulo: 4 -%}{% for x in wl.Items %}{% if forloop.index0 == ri %}{%- capture rc -%}{{ x.PublishedContent.color }}{%- endcapture -%}<div style="--c:{{ rc }}"><span>IN 7 WEEKS · WK {{ wk | plus: 7 }}</span>{{ x.PrimaryField }}</div>{% endif %}{% endfor %}</div></div></section>
