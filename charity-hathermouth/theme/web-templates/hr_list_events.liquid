{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Events</li></ol><p class="kick">Events</p><h1>Open evenings, talks, <em>the Boxing Day dip</em></h1><p class="lede">Public events are open to everyone and need no booking. Training nights are for signed-in crew; board meetings for trustees.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="cal">{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "crew" and in_crew == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "trustees" and in_tr == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% else %}<div class="ev"><span class="dt" style="background:var(--ink2)"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3 class="lockt">{{ e.PrimaryField }}</h3><small>{% if au == "crew" %}<span class="tag crew">🔒 Crew</span>{% elsif au == "trustees" %}<span class="tag tr">🔒 Trustees</span>{% else %}<span class="tag">Public</span>{% endif %} sign in for details</small></span></div>{% endif %}{% endfor %}</div></div></section>
