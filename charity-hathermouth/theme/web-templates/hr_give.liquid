{%- assign aps = get_content_items(ContentType="appeals", Filter="status eq 'open'", OrderBy="sort_order asc", PageSize=4) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Ways to give</li></ol><p class="kick">Ways to give</p><h1>Every launch is paid for by <em>someone like you</em></h1><p class="lede">Hathermouth River Rescue receives no government running costs. Here is how people give, and where the money went last year. There is no donation or payment form on this site: every way to give is arranged by post, through your bank, or in person.</p></div></div>
<section class="sec tight"><div class="w"><div class="shead"><div><p class="kick">Open appeals</p><h2>Give to something specific</h2></div><a class="btn sm line" href="{{ PathBase }}/appeals">All appeals</a></div><div class="g2" style="grid-template-columns:repeat(2,minmax(0,1fr))">{% for a in aps.Items %}{%- assign y=a.PublishedContent -%}<div class="panel light"><p class="kick">Closes {{ y.closes }}</p><h3><a href="{{ PathBase }}/{{ a.RoutePath }}" style="color:var(--navy);text-decoration:none">{{ a.PrimaryField }}</a></h3><p class="muted" style="margin:0">{{ y.summary }}</p>{%- assign gl = y.goal | append: "" | plus: 0 -%}{%- assign rs = y.raised | append: "" | plus: 0 -%}{%- assign gp = rs | times: 100 | divided_by: gl | floor -%}{% if gp > 100 %}{%- assign gp = 100 -%}{% endif %}{%- assign left = gl | minus: rs -%}<div class="gauge"><div class="track" role="img" aria-label="{{ gp }} percent of target raised"><i style="width:{{ gp }}%"></i></div><div class="nums"><span><b>${{ rs | format_number: "N0" }}</b>raised</span><span style="text-align:center"><b>{{ gp }}%</b>of target</span><span style="text-align:right"><b>${{ gl | format_number: "N0" }}</b>target</span></div></div></div>{% endfor %}</div></div></section>
{{ render_section("main", wrap=false) }}
