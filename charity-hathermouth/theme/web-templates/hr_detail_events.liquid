{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "crew" and in_crew == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "trustees" and in_tr == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/events">Events</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{% capture lv16 -%}{{ x.kind }}{%- endcapture %}{% case lv16 %}{% when "public" %}Open to all{% when "training" %}Training{% when "fundraiser" %}Fundraiser{% when "meeting" %}Meeting{% else %}{{ lv16 }}{% endcase %} · {{ x.date_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{% if ok %}{{ x.date_label }} · {{ x.time_label }} · {{ x.place }}{% else %}An event for signed-in members.{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="card side"><dl class="kv"><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Time</dt><dd>{{ x.time_label }}</dd><dt>Place</dt><dd>{{ x.place }}</dd><dt>For</dt><dd>{% capture lv17 -%}{{ x.audience }}{%- endcapture %}{% case lv17 %}{% when "public" %}Everyone{% when "crew" %}Crew{% when "trustees" %}Trustees{% else %}{{ lv17 }}{% endcase %}</dd></dl></aside></div>{% else %}{% if au == "trustees" %}<div class="lockp"><p class="kick">🔒 Trustees only</p><h2>Signed-in trustees see this meeting.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Crew only</p><h2>Signed-in crew see this training night.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% endif %}{% endif %}</div></section>
