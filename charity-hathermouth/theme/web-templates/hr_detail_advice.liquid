{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/safety">Stay safe</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv15 -%}{{ x.kind }}{%- endcapture %}{% case lv15 %}{% when "cold" %}Cold water{% when "tides" %}Tides and mud{% when "flood" %}Floods{% when "ice" %}Ice{% when "dogs" %}Dogs{% when "paddling" %}Paddling{% else %}{{ lv15 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><div class="sign" style="margin-bottom:26px"><span class="st"></span><span class="b"><span class="lab">The one rule</span><span class="rule" style="font-size:1.5rem">{{ x.rule }}</span></span></div><h2 style="font-size:1.4rem">What to do</h2>{%- assign pts = x.points | split: "|" -%}<ol class="ladder light" style="border-left-color:var(--amber)">{% for p in pts %}<li style="grid-template-columns:40px 1fr"><b>{{ forloop.index }}</b><span>{{ p }}</span></li>{% endfor %}</ol><div class="prose" style="margin-top:24px">{{ x.body }}</div></div>
<aside class="card side"><p class="kick">In an emergency</p><p style="margin:0;font:700 1.3rem/1.3 'Archivo',sans-serif;color:var(--navy)">Call 911 and ask for the fire department.</p><p class="muted" style="font-size:.92rem;margin:10px 0 0">Tell them where you are by the nearest landmark: the weir, the town bridge, the marina, the marsh path or the Bar.</p></aside></div></div></section>
