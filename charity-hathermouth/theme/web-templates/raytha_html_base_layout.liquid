.idcard{background:var(--sig);color:#fff;border-radius:8px;padding:24px 26px;position:relative;overflow:hidden}.idcard:after{content:"";position:absolute;right:-40px;bottom:-40px;width:180px;height:180px;border:18px solid rgba(255,255,255,.14);border-radius:50%}.idcard .t{font:600 .66rem "IBM Plex Mono",monospace;letter-spacing:.16em;opacity:.9}.idcard .who{font:800 1.8rem/1.1 "Archivo",sans-serif;margin:24px 0 6px}.idcard .bc{font:500 .74rem/1.7 "IBM Plex Mono",monospace;letter-spacing:.05em}.idcard.tr{background:var(--navy)}
.figs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;background:var(--card);border:1px solid var(--rule);border-radius:6px}.figs div{padding:20px 16px;border-left:1px solid var(--rule)}.figs div:first-child{border-left:0}.figs b{display:block;font:800 2rem/1 "Archivo",sans-serif;color:var(--sig)}.figs span{font-size:.88rem;color:var(--ink2)}
details.q{border-bottom:1px solid var(--rule)}details.q summary{cursor:pointer;padding:16px 0;font:700 1.08rem "Archivo",sans-serif;color:var(--navy);list-style:none;display:flex;justify-content:space-between;gap:12px}details.q summary::-webkit-details-marker{display:none}details.q summary:after{content:"+";color:var(--sig);font-size:1.3rem;line-height:1}details.q[open] summary:after{content:"–"}details.q p{margin:0 0 16px;color:var(--ink2)}
.ways{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.way{background:var(--card);border:1px solid var(--rule);border-radius:6px;padding:20px;display:flex;flex-direction:column;gap:8px}.way .cd{width:46px;height:46px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font:600 .9rem "IBM Plex Mono",monospace;letter-spacing:.06em}.way h3{margin:6px 0 0;font-size:1.1rem}.way p{margin:0;font-size:.94rem;color:var(--ink2)}.way small{margin-top:auto;font:500 .74rem "IBM Plex Mono",monospace;color:var(--sea);padding-top:10px;border-top:1px dashed var(--rule)}
.split{display:flex;height:46px;border-radius:4px;overflow:hidden;margin:6px 0 16px}.split i{display:block;height:100%;background:var(--c)}.splitk{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 24px}.splitk li{display:grid;grid-template-columns:14px 1fr auto;gap:10px;align-items:center;font-size:.95rem;border-bottom:1px solid var(--rule2);padding-bottom:8px}.splitk i{width:14px;height:14px;background:var(--c);border-radius:2px}.splitk b{font:600 .95rem "IBM Plex Mono",monospace}
.searchbar{display:flex;gap:10px;max-width:640px;margin-top:20px}.searchbar input{flex:1;padding:13px 16px;border:2px solid #fff;border-radius:3px;font:inherit;background:#fff}.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.hit b{font:700 1.06rem "Archivo",sans-serif;color:var(--navy)}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.94rem}
.foot{background:#0a1a2b;color:#9fb6c9;padding:56px 0 26px;font-size:.94rem}.foot h4{font:600 .66rem "IBM Plex Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:#fff}.foot a{color:#dbe5ee;text-decoration:none}.foot a:hover{color:#fff;text-decoration:underline}.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:7px}.fg{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:34px}.disc{border-top:1px solid #23415f;margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font:500 .74rem "IBM Plex Mono",monospace}
.notice{background:#fde7dd;border:1px solid #f3c0a8;padding:12px 14px;margin-bottom:14px;border-radius:3px}label{display:block;font:700 .95rem "Archivo",sans-serif;margin:0 0 6px;color:var(--navy)}input[type=email],input[type=password]{width:100%;padding:12px 14px;border:2px solid var(--navy);border-radius:3px;font:inherit;background:#fff}
.watches{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.wcard{background:var(--card);border:1px solid var(--rule);border-top:8px solid var(--c);border-radius:6px;padding:18px 20px;text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:6px;position:relative}.wcard.on{box-shadow:0 0 0 3px var(--c);border-color:var(--c)}.wcard .onb{position:absolute;top:12px;right:12px;font:600 .6rem "IBM Plex Mono",monospace;letter-spacing:.12em;background:var(--navy);color:#fff;padding:4px 7px;border-radius:2px}.wcard h3{margin:0}.wcard small{color:var(--ink2);font-size:.9rem}
.rota{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:6px}.rota div{background:var(--c);color:#fff;border-radius:4px;padding:12px 10px;font:700 .95rem "Archivo",sans-serif;min-height:78px;display:flex;flex-direction:column;justify-content:space-between}.rota div span{font:500 .62rem "IBM Plex Mono",monospace;letter-spacing:.08em;opacity:.9}.rota div.now{outline:3px solid var(--navy);outline-offset:2px}
.ladder.light li{border-bottom-color:var(--rule)}.ladder.light li:before{background:var(--card);border-color:var(--amber)}.ladder.light b{color:var(--navy)}.ladder.light span{color:var(--ink)}
.ladder.light{border-left-color:var(--amber)}
@media (max-width:1060px){.hero .w,.dg,.g2,.appeal{grid-template-columns:1fr!important}.side{position:static}.boats,.watches,.ways{grid-template-columns:repeat(2,minmax(0,1fr))}.signs,.roles{grid-template-columns:repeat(2,minmax(0,1fr))}.roles li:nth-child(n){border-right:1px solid #2c4a68}.figs{grid-template-columns:repeat(3,1fr)}.figs div:nth-child(4){border-left:0}.fg{grid-template-columns:1fr 1fr}.top nav{order:3;width:100%}.top .w{flex-wrap:wrap;padding-top:12px;padding-bottom:6px}.top form{display:none}.rota{grid-template-columns:repeat(4,minmax(0,1fr))}.splitk{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.contours{display:none}.w{padding:0 18px}.sos .f{display:none}.sos .w{font-size:.8rem}.top nav ul{flex-wrap:nowrap;overflow-x:auto}.top nav a{white-space:nowrap;font-size:.86rem;padding:10px 9px}.brand b{font-size:1.1rem}
.hero .w{padding-top:30px;padding-bottom:36px;gap:30px}.brow{grid-template-columns:1fr;gap:6px}.boats,.watches,.ways,.signs,.roles,.cal,.splitk{grid-template-columns:1fr}.roles li{border-right:0!important}.figs{grid-template-columns:repeat(2,1fr)}.figs div:nth-child(odd){border-left:0}.fg{grid-template-columns:1fr}
.log a{grid-template-columns:12px minmax(0,1fr);gap:4px 12px}.log .t{grid-column:2;order:-1}.log .k{grid-row:1/3}.log .o{grid-column:2;text-align:left}.barrow{grid-template-columns:110px 1fr 24px}.rows li{grid-template-columns:1fr;gap:4px}.mapcard{padding:8px;overflow-x:auto}.mapcard .river{min-width:760px}.stat b{font-size:1.4rem}.rota{grid-template-columns:repeat(2,minmax(0,1fr))}.table th:nth-child(4),.table td:nth-child(4),.table th:nth-child(5),.table td:nth-child(5){display:none}.ladder li{grid-template-columns:78px 1fr}}
</style></head><body>
