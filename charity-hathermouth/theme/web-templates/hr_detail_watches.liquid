{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign dow = "now" | date: "%u" | plus: 0 -%}{%- assign wk = doy | minus: dow | plus: 10 | divided_by: 7 | floor -%}{%- assign wi = wk | modulo: 4 -%}{%- assign wl = get_content_items(ContentType="watches", OrderBy="sort_order asc", PageSize=4) -%}{% for x in wl.Items %}{% if forloop.index0 == wi %}{%- assign onw = x -%}{% endif %}{% endfor %}{%- assign onwc = onw.PublishedContent -%}{%- capture owcol -%}{{ onwc.color }}{%- endcapture -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign x=Target.PublishedContent -%}{%- capture wc -%}{{ x.color }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/watches">Watches</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% if Target.RoutePath == onw.RoutePath %}On the pager this week{% else %}Crew watch · since {{ x.since }}{% endif %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div class="prose">{{ x.body }}<h2>Crew</h2>{%- assign cl = x.crew | split: "|" -%}<p>{% for c in cl %}{{ c }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p><p class="muted" style="font-size:.92rem">Names are fictional.</p></div>
<aside class="card side" style="border-top:8px solid {{ wc }}"><dl class="kv"><dt>Leader</dt><dd>{{ x.leader }}</dd><dt>Helms</dt><dd>{{ x.helms | replace: "|", ", " }}</dd><dt>Crew</dt><dd>{{ x.crew_count }}</dd><dt>Formed</dt><dd>{{ x.since }}</dd></dl></aside></div></div></section>
