<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Volunteer</li></ol><p class="kick">Volunteer</p><h1>Most of our crew had never <em>been on a boat</em></h1><p class="lede">Every role is unpaid, and every one matters on the night. Start at an open evening at the station on the first Tuesday of the month, 7:00 pm. There is no application or sign-up form: just come along.</p></div></div><section class="sec tight"><div class="w"><div class="tscroll"><table class="table"><thead><tr><th>Role</th><th>Kind</th><th>Commitment</th><th>Training</th><th>Places</th></tr></thead><tbody>{% for r in Target.Items %}{%- assign y=r.PublishedContent -%}<tr><td><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></td><td>{% capture lv11 -%}{{ y.kind }}{%- endcapture %}{% case lv11 %}{% when "water" %}On the water{% when "shore" %}Shore crew{% when "community" %}Community{% when "support" %}Fundraising and shop{% else %}{{ lv11 }}{% endcase %}</td><td>{{ y.commitment }}</td><td>{{ y.training }}</td><td class="c" style="font-size:1.1rem;color:var(--navy)">{{ y.openings }}</td></tr>{% endfor %}</tbody></table></div></div></section>
{%- assign oe = get_content_items(ContentType="events", Filter="kind eq 'public'", OrderBy="sort_order asc", PageSize=3) -%}<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2>Next open events</h2><div class="cal">{% for e in oe.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div></section>
