<section class="sec alt"><div class="w g2"><div><div class="shead"><div><p class="kick">Pager log</p><h2>Recent callouts</h2></div><a class="btn sm line" href="{{ PathBase }}/callouts">All callouts</a></div><ul class="log">{% for c in lg.Items %}{%- assign y=c.PublishedContent -%}{%- capture lk -%}{{ y.kind }}{%- endcapture -%}<li><a href="{{ PathBase }}/{{ c.RoutePath }}" style="--c:{% case lk %}{% when "water" %}#e0531f{% when "vessel" %}#1d5f8a{% when "animal" %}#d99a1e{% when "search" %}#6a4c93{% when "flood" %}#2f8f8a{% when "medical" %}#b8324a{% else %}#10263d{% endcase %}"><span class="t">{{ y.month }} {{ y.day_num }} · {{ y.time_label }}</span><span class="k" aria-hidden="true"></span><span><b>{{ c.PrimaryField }}</b><small>{% capture lv3 -%}{{ y.reach }}{%- endcapture %}{% case lv3 %}{% when "weir" %}Hather Weir{% when "town" %}Town Reach{% when "marina" %}Marina Reach{% when "marsh" %}Saltmarsh{% when "bar" %}The Bar{% else %}{{ lv3 }}{% endcase %} · mile {{ y.mile }} · {{ y.boat }}</small></span><span class="o">{{ y.ref }}<br>{{ y.duration }}</span></a></li>{% endfor %}</ul></div>
<div><p class="kick">2026 so far</p><h3 style="font-size:1.4rem">Callouts by kind</h3>{%- assign kb = get_content_items(ContentType="callouts", PageSize=200) -%}{%- assign kmax = 1 -%}{%- assign n_water = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "water" %}{%- assign n_water = n_water | plus: 1 -%}{% endif %}{% endfor %}{% if n_water > kmax %}{%- assign kmax = n_water -%}{% endif %}{%- assign n_vessel = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "vessel" %}{%- assign n_vessel = n_vessel | plus: 1 -%}{% endif %}{% endfor %}{% if n_vessel > kmax %}{%- assign kmax = n_vessel -%}{% endif %}{%- assign n_animal = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "animal" %}{%- assign n_animal = n_animal | plus: 1 -%}{% endif %}{% endfor %}{% if n_animal > kmax %}{%- assign kmax = n_animal -%}{% endif %}{%- assign n_search = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "search" %}{%- assign n_search = n_search | plus: 1 -%}{% endif %}{% endfor %}{% if n_search > kmax %}{%- assign kmax = n_search -%}{% endif %}{%- assign n_flood = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "flood" %}{%- assign n_flood = n_flood | plus: 1 -%}{% endif %}{% endfor %}{% if n_flood > kmax %}{%- assign kmax = n_flood -%}{% endif %}{%- assign n_medical = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "medical" %}{%- assign n_medical = n_medical | plus: 1 -%}{% endif %}{% endfor %}{% if n_medical > kmax %}{%- assign kmax = n_medical -%}{% endif %}<div class="bars">{%- assign pct = n_water | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=water" style="--c:#e0531f"><span>Person in the water</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_water }}</em></a>{%- assign pct = n_vessel | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=vessel" style="--c:#1d5f8a"><span>Vessel in difficulty</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_vessel }}</em></a>{%- assign pct = n_animal | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=animal" style="--c:#d99a1e"><span>Animal rescue</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_animal }}</em></a>{%- assign pct = n_search | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=search" style="--c:#6a4c93"><span>Search</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_search }}</em></a>{%- assign pct = n_flood | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=flood" style="--c:#2f8f8a"><span>Flood response</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_flood }}</em></a>{%- assign pct = n_medical | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=medical" style="--c:#b8324a"><span>Medical on the bank</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_medical }}</em></a></div><p class="muted" style="font-size:.9rem;margin-top:16px">Counted on the server from the callout log. Select a kind to filter the log.</p></div></div></section>
{% for a in aps.Items %}{%- assign y=a.PublishedContent -%}<section class="sec dark"><div class="w appeal"><div><p class="kick" style="color:#ff9a6b">Our appeal</p><h2>{{ a.PrimaryField }}</h2><p style="color:#b9c9d7;font-size:1.1rem;max-width:620px">{{ y.summary }}</p>{%- assign gl = y.goal | append: "" | plus: 0 -%}{%- assign rs = y.raised | append: "" | plus: 0 -%}{%- assign gp = rs | times: 100 | divided_by: gl | floor -%}{% if gp > 100 %}{%- assign gp = 100 -%}{% endif %}{%- assign left = gl | minus: rs -%}<div class="gauge"><div class="track" role="img" aria-label="{{ gp }} percent of target raised"><i style="width:{{ gp }}%"></i></div><div class="nums"><span><b>${{ rs | format_number: "N0" }}</b>raised</span><span style="text-align:center"><b>{{ gp }}%</b>of target</span><span style="text-align:right"><b>${{ gl | format_number: "N0" }}</b>target</span></div></div><p style="color:#9fb6c9;font-size:.92rem">{{ y.donors }} donors so far · closes {{ y.closes }}</p><p class="cta"><a class="btn" href="{{ PathBase }}/give">Ways to give</a><a class="btn lt" href="{{ PathBase }}/{{ a.RoutePath }}">About the appeal</a></p></div>
<div><p class="kick" style="color:#7fd3cf">What a gift pays for</p>{%- assign bl = y.buys | split: "|" -%}<ol class="ladder">{% for s in bl %}{%- assign sp = s | split: "~" -%}<li><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></li>{% endfor %}</ol></div></div></section>{% endfor %}
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">The fleet</p><h2>Two lifeboats, a flood boat and a truck</h2><p>Every one was paid for by gifts, wills and local fundraising.</p></div><a class="btn sm line" href="{{ PathBase }}/fleet">The fleet</a></div><div class="boats">{% for b in fl.Items %}{%- assign y=b.PublishedContent -%}<a class="boat" href="{{ PathBase }}/{{ b.RoutePath }}"><img src="{{ y.art.Value | attachment_redirect_url }}" alt="Generated side-profile plate of {{ b.PrimaryField }}" loading="lazy"><div class="b"><span class="lab" style="font-size:.66rem;letter-spacing:.12em;color:var(--sig);text-transform:uppercase">{% capture lv1 -%}{{ y.kind }}{%- endcapture %}{% case lv1 %}{% when "ilb" %}Inshore lifeboat{% when "flood" %}Flood rescue boat{% when "vehicle" %}Response vehicle{% else %}{{ lv1 }}{% endcase %}</span><h3>{{ b.PrimaryField }}</h3><p>{{ y.summary }}</p><div class="sp"><span><b>{{ y.launches }}</b> launches in 2026</span><span>since {{ y.in_service }}</span></div></div></a>{% endfor %}</div></div></section>
<section class="sec alt"><div class="w"><div class="shead"><div><p class="kick">Stay safe</p><h2>Six rules that would have prevented most of our callouts</h2></div><a class="btn sm line" href="{{ PathBase }}/safety">Safety advice</a></div><div class="signs">{% for a in adv.Items %}{%- assign y=a.PublishedContent -%}<a class="sign" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="st" aria-hidden="true"></span><span class="b"><span class="lab">{% capture lv2 -%}{{ y.kind }}{%- endcapture %}{% case lv2 %}{% when "cold" %}Cold water{% when "tides" %}Tides and mud{% when "flood" %}Floods{% when "ice" %}Ice{% when "dogs" %}Dogs{% when "paddling" %}Paddling{% else %}{{ lv2 }}{% endcase %}</span><h3>{{ a.PrimaryField }}</h3><span class="rule">{{ y.rule }}</span><span class="muted" style="font-size:.93rem">{{ y.summary }}</span></span></a>{% endfor %}</div></div></section>
<section class="sec dark"><div class="w"><div class="shead"><div><p class="kick" style="color:#ff9a6b">Volunteer</p><h2>Most of our crew had never been on a boat</h2><p>Come to an open evening on the first Tuesday of the month. There is no form: you meet the crew and see the boats.</p></div><a class="btn" href="{{ PathBase }}/volunteer">All roles</a></div>
<ul class="roles">{% for r in rls.Items %}{%- assign y=r.PublishedContent -%}<li><a href="{{ PathBase }}/{{ r.RoutePath }}"><small>{% capture lv4 -%}{{ y.kind }}{%- endcapture %}{% case lv4 %}{% when "water" %}On the water{% when "shore" %}Shore crew{% when "community" %}Community{% when "support" %}Fundraising and shop{% else %}{{ lv4 }}{% endcase %} · {{ y.openings }} places</small><b>{{ r.PrimaryField }}</b><span>{{ y.commitment }}</span></a></li>{% endfor %}</ul></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Events</p><h2>Come and see us</h2></div><a class="btn sm line" href="{{ PathBase }}/events">All events</a></div><div class="cal">{% for e in evs.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div></section>
