{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="bar, kayak, flood"><button class="btn">Search</button></form><p class="lede" style="margin-top:12px;font-size:1rem">Searches callouts, the fleet, safety advice, volunteer roles, appeals, events, watches and notices.</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "callouts:Callouts:title:summary,fleet:Fleet:name:summary,advice:Safety advice:title:summary,roles:Volunteer roles:title:summary,appeals:Appeals:title:summary,events:Events:title:summary,watches:Watches:name:summary,notices:Notices and papers:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--navy)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "crew" %} <span class="tag crew">🔒 Crew</span>{% elsif au == "trustees" %} <span class="tag tr">🔒 Trustees</span>{% endif %}{% if au == "crew" and in_crew == false %}<p>Sign in to read.</p>{% elsif au == "trustees" and in_tr == false %}<p>Sign in to read.</p>{% else %}<p>{{ x.summary | strip_html | truncate: 150 }}</p>{% endif %}</a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=bar">bar</a>, <a href="?q=kayak">kayak</a>, <a href="?q=flood">flood</a> or <a href="?q=boat">boat</a>.</p>{% endif %}</div></div></section>
