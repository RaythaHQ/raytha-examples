{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign dow = "now" | date: "%u" | plus: 0 -%}{%- assign wk = doy | minus: dow | plus: 10 | divided_by: 7 | floor -%}{%- assign wi = wk | modulo: 4 -%}{%- assign wl = get_content_items(ContentType="watches", OrderBy="sort_order asc", PageSize=4) -%}{% for x in wl.Items %}{% if forloop.index0 == wi %}{%- assign onw = x -%}{% endif %}{% endfor %}{%- assign onwc = onw.PublishedContent -%}{%- capture owcol -%}{{ onwc.color }}{%- endcapture -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign hw1 = doy | times: 50 | plus: 190 | modulo: 745 -%}{%- assign nowm = "now" | date: "%H" | plus: 0 | times: 60 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 | plus: nowm -%}{%- assign nhw = hw1 -%}{% if nhw < nowm %}{%- assign nhw = hw1 | plus: 745 -%}{% endif %}{% if nhw >= 1440 %}{%- assign nhw = nhw | minus: 1440 -%}{% endif %}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Crew room</li></ol><p class="kick">Crew room · crew only</p><h1>{% if in_crew %}Evening, {{ CurrentUser.FirstName }}.{% else %}Crew room{% endif %}</h1><p class="lede">{% if in_crew %}Procedures, kit checks, training nights and bulletins. Demo account: names and dates are fictional.{% else %}Procedures, kit checks, training nights and bulletins, for signed-in crew.{% endif %}</p></div></div>
{% if in_crew %}{%- assign cn = get_content_items(ContentType="notices", Filter="audience eq 'crew'", OrderBy="sort_order asc", PageSize=20) -%}{%- assign ce = get_content_items(ContentType="events", Filter="audience eq 'crew'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,420px) minmax(0,1fr)"><div><div class="idcard"><div class="t">HATHERMOUTH RIVER RESCUE · CREW CARD</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">CREW · DEMO ACCOUNT<br>ON THE PAGER THIS WEEK: {{ onw.PrimaryField | upcase }}</div></div><div class="panel light" style="margin-top:18px"><p class="kick">Tides today · illustrative</p><ol class="tides">{%- assign t = hw1 | plus: -373 -%}{% if t >= 0 and t < 1440 %}<li class="lw"><span>LW</span><b>{%- assign hh = t | divided_by: 60 | floor -%}{%- assign mm = t | modulo: 60 -%}{% if hh < 10 %}0{% endif %}{{ hh }}:{% if mm < 10 %}0{% endif %}{{ mm }}</b></li>{% endif %}{%- assign t = hw1 | plus: 0 -%}{% if t >= 0 and t < 1440 %}<li class="hw"><span>HW</span><b>{%- assign hh = t | divided_by: 60 | floor -%}{%- assign mm = t | modulo: 60 -%}{% if hh < 10 %}0{% endif %}{{ hh }}:{% if mm < 10 %}0{% endif %}{{ mm }}</b></li>{% endif %}{%- assign t = hw1 | plus: 372 -%}{% if t >= 0 and t < 1440 %}<li class="lw"><span>LW</span><b>{%- assign hh = t | divided_by: 60 | floor -%}{%- assign mm = t | modulo: 60 -%}{% if hh < 10 %}0{% endif %}{{ hh }}:{% if mm < 10 %}0{% endif %}{{ mm }}</b></li>{% endif %}{%- assign t = hw1 | plus: 745 -%}{% if t >= 0 and t < 1440 %}<li class="hw"><span>HW</span><b>{%- assign hh = t | divided_by: 60 | floor -%}{%- assign mm = t | modulo: 60 -%}{% if hh < 10 %}0{% endif %}{{ hh }}:{% if mm < 10 %}0{% endif %}{{ mm }}</b></li>{% endif %}{%- assign t = hw1 | plus: 1117 -%}{% if t >= 0 and t < 1440 %}<li class="lw"><span>LW</span><b>{%- assign hh = t | divided_by: 60 | floor -%}{%- assign mm = t | modulo: 60 -%}{% if hh < 10 %}0{% endif %}{{ hh }}:{% if mm < 10 %}0{% endif %}{{ mm }}</b></li>{% endif %}</ol></div></div>
<div><h2 style="margin-bottom:12px">Training nights</h2><div class="cal" style="grid-template-columns:1fr">{% for e in ce.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:14px">Procedures, kit checks and bulletins</h2><ul class="rows">{% for r in cn.Items %}{%- assign y=r.PublishedContent -%}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></span><span><span class="tag crew">{% capture lv21 -%}{{ y.kind }}{%- endcapture %}{% case lv21 %}{% when "sop" %}Procedure{% when "kit" %}Kit check{% when "rota" %}Rota{% when "bulletin" %}Bulletin{% when "minutes" %}Minutes{% when "paper" %}Board paper{% when "risk" %}Risk register{% when "accounts" %}Accounts{% else %}{{ lv21 }}{% endcase %}</span></span></li>{% endfor %}</ul></div></section>
{% else %}<section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_tr %}<div class="lockp"><p class="kick">🔒 Crew only</p><h2>You are signed in with a trustee account.</h2><p class="muted">The crew room is for operational crew. Board papers and minutes are in the <a href="{{ PathBase }}/trustees">trustees' area</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Crew only</p><h2>Crew sign in to see the crew room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/crew-room">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% endif %}</div></section>{% endif %}
