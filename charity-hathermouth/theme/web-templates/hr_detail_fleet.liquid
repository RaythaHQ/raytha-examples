{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/fleet">Fleet</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv9 -%}{{ x.kind }}{%- endcapture %}{% case lv9 %}{% when "ilb" %}Inshore lifeboat{% when "flood" %}Flood rescue boat{% when "vehicle" %}Response vehicle{% else %}{{ lv9 }}{% endcase %} · in service since {{ x.in_service }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><img src="{{ x.art.Value | attachment_redirect_url }}" alt="Generated side-profile plate of {{ Target.PrimaryField }}" style="border:1px solid var(--rule);border-radius:6px;margin-bottom:26px"><div class="prose">{{ x.body }}<h2>Who paid for her</h2><p>{{ x.funded_by }}. Cost when new: {{ x.cost }}.</p></div></div>
<aside class="card side"><dl class="kv"><dt>Kind</dt><dd>{% capture lv10 -%}{{ x.kind }}{%- endcapture %}{% case lv10 %}{% when "ilb" %}Inshore lifeboat{% when "flood" %}Flood rescue boat{% when "vehicle" %}Response vehicle{% else %}{{ lv10 }}{% endcase %}</dd><dt>Length</dt><dd>{{ x.length }}</dd><dt>Engine</dt><dd>{{ x.engine }}</dd><dt>Crew</dt><dd>{{ x.crew }}</dd><dt>Top speed</dt><dd>{{ x.speed }}</dd><dt>Launches 2026</dt><dd>{{ x.launches }}</dd><dt>Cost</dt><dd>{{ x.cost }}</dd></dl></aside></div></div></section>
