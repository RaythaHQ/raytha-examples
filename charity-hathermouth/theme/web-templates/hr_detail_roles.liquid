{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/volunteer">Volunteer</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv12 -%}{{ x.kind }}{%- endcapture %}{% case lv12 %}{% when "water" %}On the water{% when "shore" %}Shore crew{% when "community" %}Community{% when "support" %}Fundraising and shop{% else %}{{ lv12 }}{% endcase %} · {{ x.openings }} places</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div class="prose">{{ x.body }}<h2>What you need</h2>{%- assign nd = x.needs | split: "|" -%}<ul>{% for n in nd %}<li>{{ n }}</li>{% endfor %}</ul></div>
<aside class="card side"><dl class="kv"><dt>Commitment</dt><dd>{{ x.commitment }}</dd><dt>Minimum age</dt><dd>{{ x.min_age }}</dd><dt>Training</dt><dd>{{ x.training }}</dd><dt>Places</dt><dd>{{ x.openings }}</dd></dl><p class="muted" style="font-size:.92rem;margin:18px 0 0">Open evening: first Tuesday of the month, 7:00 pm, at the station. Or call the volunteer coordinator on (555) 019-0712.</p></aside></div></div></section>
