{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Notices and papers</li></ol><p class="kick">Notices and papers</p><h1>Procedures, bulletins and <em>board papers</em></h1><p class="lede">The annual report is public. Procedures, kit checks and bulletins are for crew; minutes, board papers and the risk register are for trustees. Titles are listed; contents are sent only to signed-in members.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><ul class="rows">{% for r in Target.Items %}{%- assign y=r.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "crew" and in_crew == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "trustees" and in_tr == false -%}{%- assign ok=false -%}{%- endif -%}<li><span class="k">{{ y.date_label }}</span><span>{% if ok %}<a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small>{% else %}<span class="lockt">{{ r.PrimaryField }}</span><small>Sign in to read.</small>{% endif %}</span><span>{% if au == "crew" %}<span class="tag crew">🔒 Crew</span>{% elsif au == "trustees" %}<span class="tag tr">🔒 Trustees</span>{% else %}<span class="tag">Public</span>{% endif %}</span></li>{% endfor %}</ul></div></section>
