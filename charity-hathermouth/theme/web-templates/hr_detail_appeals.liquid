{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/appeals">Appeals</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv14 -%}{{ x.status }}{%- endcapture %}{% case lv14 %}{% when "open" %}Open{% when "met" %}Target met{% when "closed" %}Closed{% else %}{{ lv14 }}{% endcase %} · closes {{ x.closes }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec dark tight"><div class="w appeal"><div>{%- assign gl = x.goal | append: "" | plus: 0 -%}{%- assign rs = x.raised | append: "" | plus: 0 -%}{%- assign gp = rs | times: 100 | divided_by: gl | floor -%}{% if gp > 100 %}{%- assign gp = 100 -%}{% endif %}{%- assign left = gl | minus: rs -%}<div class="gauge"><div class="track" role="img" aria-label="{{ gp }} percent of target raised"><i style="width:{{ gp }}%"></i></div><div class="nums"><span><b>${{ rs | format_number: "N0" }}</b>raised</span><span style="text-align:center"><b>{{ gp }}%</b>of target</span><span style="text-align:right"><b>${{ gl | format_number: "N0" }}</b>target</span></div></div><p style="color:#9fb6c9;font-size:.92rem;margin:0">{{ x.donors }} donors · no payment is taken on this site</p></div><div><p class="kick" style="color:#7fd3cf">What a gift pays for</p>{%- assign bl = x.buys | split: "|" -%}<ol class="ladder">{% for s in bl %}{%- assign sp = s | split: "~" -%}<li><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></li>{% endfor %}</ol></div></div></section>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><aside class="card side"><p class="kick">How to give to this appeal</p><p style="margin:0 0 12px">Write "{{ Target.PrimaryField }}" on the back of a check, or name it when you call the station, and your gift is kept in a restricted fund.</p><p class="cta" style="margin:0"><a class="btn sm" href="{{ PathBase }}/give">Ways to give</a></p></aside></div></div></section>
