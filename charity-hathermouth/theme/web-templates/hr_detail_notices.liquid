{%- assign in_crew=false -%}{%- assign in_tr=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "crew" -%}{%- assign in_crew=true -%}{%- endif -%}{%- if g == "trustees" -%}{%- assign in_tr=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_crew=true -%}{%- assign in_tr=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "crew" and in_crew == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "trustees" and in_tr == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/notices">Notices and papers</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv18 -%}{{ x.kind }}{%- endcapture %}{% case lv18 %}{% when "sop" %}Procedure{% when "kit" %}Kit check{% when "rota" %}Rota{% when "bulletin" %}Bulletin{% when "minutes" %}Minutes{% when "paper" %}Board paper{% when "risk" %}Risk register{% when "accounts" %}Accounts{% else %}{{ lv18 }}{% endcase %} · {{ x.date_label }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{% if ok %}{{ x.summary }}{% else %}A notice for signed-in members.{% endif %}</p><p style="margin:16px 0 0">{% if au == "crew" %}<span class="tag crew">🔒 Crew</span>{% elsif au == "trustees" %}<span class="tag tr">🔒 Trustees</span>{% else %}<span class="tag">Public</span>{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="card side"><dl class="kv"><dt>From</dt><dd>{{ x.from_name }}</dd><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Kind</dt><dd>{% capture lv19 -%}{{ x.kind }}{%- endcapture %}{% case lv19 %}{% when "sop" %}Procedure{% when "kit" %}Kit check{% when "rota" %}Rota{% when "bulletin" %}Bulletin{% when "minutes" %}Minutes{% when "paper" %}Board paper{% when "risk" %}Risk register{% when "accounts" %}Accounts{% else %}{{ lv19 }}{% endcase %}</dd><dt>For</dt><dd>{% capture lv20 -%}{{ x.audience }}{%- endcapture %}{% case lv20 %}{% when "public" %}Everyone{% when "crew" %}Crew{% when "trustees" %}Trustees{% else %}{{ lv20 }}{% endcase %}</dd></dl></aside></div>{% else %}{% if au == "trustees" %}<div class="lockp"><p class="kick">🔒 Trustees only</p><h2>Signed-in trustees can read this paper.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Crew only</p><h2>Signed-in crew can read this notice.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the operations manager opens accounts for crew after induction, and the clerk opens them for trustees.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/volunteer">Volunteer with us</a></p></div>{% endif %}{% endif %}</div></section>
