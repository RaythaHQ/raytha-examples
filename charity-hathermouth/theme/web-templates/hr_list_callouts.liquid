{%- assign fk = QueryParams.kind | strip | downcase -%}{%- assign fr = QueryParams.reach | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Callouts</li></ol><p class="kick">Callouts · 2026</p><h1>The pager log</h1><p class="lede">Every launch this year, newest first. Filter by kind or by reach; the filtering happens on the server, so every filtered view has its own link.</p><div class="filters"><span class="fl">KIND</span><a href="?kind=&amp;reach={{ fr }}" class="{% if fk == "" %}on{% endif %}">All kinds</a><a href="?kind=water&amp;reach={{ fr }}" class="{% if fk == "water" %}on{% endif %}">Person in the water</a><a href="?kind=vessel&amp;reach={{ fr }}" class="{% if fk == "vessel" %}on{% endif %}">Vessel in difficulty</a><a href="?kind=animal&amp;reach={{ fr }}" class="{% if fk == "animal" %}on{% endif %}">Animal rescue</a><a href="?kind=search&amp;reach={{ fr }}" class="{% if fk == "search" %}on{% endif %}">Search</a><a href="?kind=flood&amp;reach={{ fr }}" class="{% if fk == "flood" %}on{% endif %}">Flood response</a><a href="?kind=medical&amp;reach={{ fr }}" class="{% if fk == "medical" %}on{% endif %}">Medical on the bank</a></div><div class="filters"><span class="fl">REACH</span><a href="?kind={{ fk }}&amp;reach=" class="{% if fr == "" %}on{% endif %}">Whole river</a><a href="?kind={{ fk }}&amp;reach=weir" class="{% if fr == "weir" %}on{% endif %}">Hather Weir</a><a href="?kind={{ fk }}&amp;reach=town" class="{% if fr == "town" %}on{% endif %}">Town Reach</a><a href="?kind={{ fk }}&amp;reach=marina" class="{% if fr == "marina" %}on{% endif %}">Marina Reach</a><a href="?kind={{ fk }}&amp;reach=marsh" class="{% if fr == "marsh" %}on{% endif %}">Saltmarsh</a><a href="?kind={{ fk }}&amp;reach=bar" class="{% if fr == "bar" %}on{% endif %}">The Bar</a></div></div></div>
<section class="sec tight"><div class="w"><div class="g2"><div>{%- assign shown=0 -%}{%- assign helped=0 -%}<ul class="log">{% for c in Target.Items %}{%- assign y=c.PublishedContent -%}{%- capture ck -%}{{ y.kind }}{%- endcapture -%}{%- capture cr -%}{{ y.reach }}{%- endcapture -%}{% if fk == "" or fk == ck %}{% if fr == "" or fr == cr %}{%- assign shown = shown | plus: 1 -%}{%- assign helped = y.people | append: "" | plus: 0 | plus: helped -%}{%- capture lk -%}{{ y.kind }}{%- endcapture -%}<li><a href="{{ PathBase }}/{{ c.RoutePath }}" style="--c:{% case lk %}{% when "water" %}#e0531f{% when "vessel" %}#1d5f8a{% when "animal" %}#d99a1e{% when "search" %}#6a4c93{% when "flood" %}#2f8f8a{% when "medical" %}#b8324a{% else %}#10263d{% endcase %}"><span class="t">{{ y.month }} {{ y.day_num }} · {{ y.time_label }}</span><span class="k" aria-hidden="true"></span><span><b>{{ c.PrimaryField }}</b><small>{% capture lv5 -%}{{ y.reach }}{%- endcapture %}{% case lv5 %}{% when "weir" %}Hather Weir{% when "town" %}Town Reach{% when "marina" %}Marina Reach{% when "marsh" %}Saltmarsh{% when "bar" %}The Bar{% else %}{{ lv5 }}{% endcase %} · mile {{ y.mile }} · {{ y.boat }}</small></span><span class="o">{{ y.ref }}<br>{{ y.duration }}</span></a></li>{% endif %}{% endif %}{% endfor %}</ul>{% if shown == 0 %}<p class="muted">No callouts match. <a href="{{ PathBase }}/callouts">Show all</a>.</p>{% endif %}</div>
<aside class="side"><div class="stat"><div><b>{{ shown }}</b><span>callouts shown</span></div><div><b>{{ helped }}</b><span>people helped</span></div><div><b>{{ Target.Items.size }}</b><span>in 2026</span></div></div><div class="panel"><h3>By kind</h3>{%- assign kb = get_content_items(ContentType="callouts", PageSize=200) -%}{%- assign kmax = 1 -%}{%- assign n_water = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "water" %}{%- assign n_water = n_water | plus: 1 -%}{% endif %}{% endfor %}{% if n_water > kmax %}{%- assign kmax = n_water -%}{% endif %}{%- assign n_vessel = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "vessel" %}{%- assign n_vessel = n_vessel | plus: 1 -%}{% endif %}{% endfor %}{% if n_vessel > kmax %}{%- assign kmax = n_vessel -%}{% endif %}{%- assign n_animal = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "animal" %}{%- assign n_animal = n_animal | plus: 1 -%}{% endif %}{% endfor %}{% if n_animal > kmax %}{%- assign kmax = n_animal -%}{% endif %}{%- assign n_search = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "search" %}{%- assign n_search = n_search | plus: 1 -%}{% endif %}{% endfor %}{% if n_search > kmax %}{%- assign kmax = n_search -%}{% endif %}{%- assign n_flood = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "flood" %}{%- assign n_flood = n_flood | plus: 1 -%}{% endif %}{% endfor %}{% if n_flood > kmax %}{%- assign kmax = n_flood -%}{% endif %}{%- assign n_medical = 0 -%}{% for c in kb.Items %}{%- capture ckk -%}{{ c.PublishedContent.kind }}{%- endcapture -%}{% if ckk == "medical" %}{%- assign n_medical = n_medical | plus: 1 -%}{% endif %}{% endfor %}{% if n_medical > kmax %}{%- assign kmax = n_medical -%}{% endif %}<div class="bars">{%- assign pct = n_water | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=water" style="--c:#e0531f"><span>Person in the water</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_water }}</em></a>{%- assign pct = n_vessel | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=vessel" style="--c:#1d5f8a"><span>Vessel in difficulty</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_vessel }}</em></a>{%- assign pct = n_animal | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=animal" style="--c:#d99a1e"><span>Animal rescue</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_animal }}</em></a>{%- assign pct = n_search | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=search" style="--c:#6a4c93"><span>Search</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_search }}</em></a>{%- assign pct = n_flood | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=flood" style="--c:#2f8f8a"><span>Flood response</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_flood }}</em></a>{%- assign pct = n_medical | times: 100 | divided_by: kmax | floor -%}<a class="barrow" href="{{ PathBase }}/callouts?kind=medical" style="--c:#b8324a"><span>Medical on the bank</span><span class="b"><i style="width:{{ pct }}%"></i></span><em>{{ n_medical }}</em></a></div></div></aside></div></div></section>
