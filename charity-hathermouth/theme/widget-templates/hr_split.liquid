<section class="sec tight"><div class="w"><div class="panel"><p class="kick">The accounts</p><h2>{{ widget.settings.headline }}</h2><p class="muted" style="margin:0 0 14px">{{ widget.settings.intro }}</p><div class="split" role="img" aria-label="Spending split">{% for i in widget.settings.items %}<i style="--c:{{ i.color }};width:{{ i.pct }}%" title="{{ i.label }} {{ i.pct }}%"></i>{% endfor %}</div><ul class="splitk">{% for i in widget.settings.items %}<li style="--c:{{ i.color }}"><i></i><span>{{ i.label }}</span><b>{{ i.pct }}%</b></li>{% endfor %}</ul><p class="muted" style="font-size:.92rem;margin:16px 0 0">{{ widget.settings.foot }}</p></div></div></section>
