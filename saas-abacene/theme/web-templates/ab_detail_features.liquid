{%- assign x=Target.PublishedContent -%}{%- capture pl -%}{{ x.pillar }}{%- endcapture -%}{%- case pl -%}{%- when "meter" -%}{%- assign pn="01 · Meter" -%}{%- when "aggregate" -%}{%- assign pn="02 · Aggregate" -%}{%- when "rate" -%}{%- assign pn="03 · Rate" -%}{%- else -%}{%- assign pn="04 · Invoice" -%}{%- endcase -%}{%- assign others = get_content_items(ContentType="features", OrderBy="sort_order asc", PageSize=20) -%}
<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/product">Product</a></li><li>{{ pn }}</li></ol><p class="kick">{{ pn }} · {{ x.tagline }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ x.body }}</div>{%- capture smp -%}{{ x.sample }}{%- endcapture -%}{% if smp != "" %}<h3 style="margin:30px 0 12px">Sample</h3><pre class="pre">{{ x.sample | escape }}</pre>{% endif %}</div>
<aside class="side"><p class="kick" style="margin:0">Spec</p><div class="kv">{%- assign rows = x.spec | split: "|" -%}{% for r in rows %}{%- assign kvp = r | split: ":" -%}<div><span>{{ kvp[0] | strip }}</span><b>{{ kvp[1] | strip }}</b></div>{% endfor %}</div><div class="card"><p class="kick">All features</p>{% for o in others.Items %}<div style="padding:4px 0">{% if o.Id == Target.Id %}<b>{{ o.PrimaryField }}</b>{% else %}<a href="{{ PathBase }}/{{ o.RoutePath }}">{{ o.PrimaryField }}</a>{% endif %}</div>{% endfor %}</div><a class="btn" href="{{ PathBase }}/docs">Read the docs</a></aside></div></section>
