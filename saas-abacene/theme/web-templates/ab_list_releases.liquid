{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Changelog</li></ol><p class="kick">Changelog</p><h1>What shipped, and when</h1><p class="lede">Release notes for every version. Beta entries are visible to members of the beta program after sign-in; everyone else sees that a beta shipped, and nothing more.</p></div></div>
<section class="sec tight"><div class="wrap" style="max-width:980px">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- case kd -%}{%- when "feature" -%}{%- assign kl="New" -%}{%- when "improvement" -%}{%- assign kl="Improved" -%}{%- when "fix" -%}{%- assign kl="Fixed" -%}{%- else -%}{%- assign kl="Beta" -%}{%- endcase -%}<article style="display:grid;grid-template-columns:150px 1fr;gap:28px;padding:28px 0;border-top:1px solid var(--rule)"><div><div class="ver" style="font-size:1.05rem">{{ x.version }}</div><div class="muted mono" style="font-size:12.5px">{{ x.date_label }}</div></div><div><span class="tag {{ kd }}">{% if au == "beta" %}🔒 {% endif %}{{ kl }}</span><h2 style="font-size:1.45rem;margin:10px 0 8px"><a href="{{ PathBase }}/{{ r.RoutePath }}" style="color:inherit;text-decoration:none">{{ r.PrimaryField }}</a></h2>{% if au == "beta" and in_beta == false %}<p class="muted">Beta program release notes. <a href="{{ PathBase }}/account/login?returnUrl=/{{ r.RoutePath }}">Sign in</a> as a beta member to read them.</p>{% else %}<p class="muted">{{ x.summary }}</p>{% endif %}</div></article>{% endfor %}</div></section>
