{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Docs</li></ol><p class="kick">Docs</p><h1>Abacene documentation</h1><p class="lede">Concepts, guides and reference. Public docs are open; docs marked Customers or Beta need a signed-in account in that group.</p><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" aria-label="Search docs" placeholder="Search: idempotency, credits, SSO…"><button class="btn">Search</button></form></div></div>
<section class="sec tight"><div class="wrap">{%- assign secs = "start^Get started^Send your first event and see it on an invoice.~metering^Metering^Meters, dimensions, idempotency and late events.~pricing^Pricing models^Rate cards, tiers, packages and credits.~invoicing^Invoicing^Explain, reconcile, export.~admin^Admin and security^SSO, roles and the audit log." | split: "~" -%}<div class="dcols">{% for s in secs %}{%- assign sp = s | split: "^" -%}<div class="dgroup"><h2>{{ sp[1] }}</h2><p class="muted" style="margin:-6px 0 12px">{{ sp[2] }}</p>{% for d in Target.Items %}{%- assign x=d.PublishedContent -%}{%- capture sc -%}{{ x.section }}{%- endcapture -%}{%- capture ac -%}{{ x.access }}{%- endcapture -%}{%- assign ok=true -%}{%- if ac == "customers" and in_cust == false -%}{%- assign ok=false -%}{%- endif -%}{%- if ac == "beta" and in_beta == false -%}{%- assign ok=false -%}{%- endif -%}{%- case ac -%}{%- when "customers" -%}{%- assign al="Customers" -%}{%- when "beta" -%}{%- assign al="Beta" -%}{%- else -%}{%- assign al="Public" -%}{%- endcase -%}{% if sc == sp[0] %}<a class="drow" href="{{ PathBase }}/{{ d.RoutePath }}"><div><b>{{ d.PrimaryField }}</b><p>{{ x.summary | truncate: 100 }}</p></div><div style="text-align:right"><span class="tag {{ ac }}">{% if ac != "public" %}🔒 {% endif %}{{ al }}</span><div class="mono muted" style="font-size:12px;margin-top:6px">{{ x.reading_time }}</div></div></a>{% endif %}{% endfor %}</div>{% endfor %}</div></div></section>
