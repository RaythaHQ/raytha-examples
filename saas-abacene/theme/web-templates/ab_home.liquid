{%- assign feats = get_content_items(ContentType="features", OrderBy="sort_order asc", PageSize=20) -%}
{%- assign rels = get_content_items(ContentType="releases", OrderBy="released_on desc", PageSize=5) -%}
{%- assign sts = get_content_items(ContentType="stories", OrderBy="sort_order asc", PageSize=2) -%}
{%- assign pls = get_content_items(ContentType="plans", OrderBy="sort_order asc", PageSize=4) -%}
{%- assign ints = get_content_items(ContentType="integrations", OrderBy="sort_order asc", PageSize=30) -%}
<section class="hero"><div class="wrap"><div><p class="kick">Usage metering &amp; billing ledger · for API companies</p><h1>Every API call, priced to the cent. <em>And explained.</em></h1><p class="lede">Abacene meters raw usage events, rolls them up by customer and dimension, rates them against your price book, and hands finance an invoice where every line traces back to the events behind it. No spreadsheet in the middle.</p><div class="cta"><a class="btn" href="{{ PathBase }}/docs/quickstart-send-your-first-meter-event">Read the quickstart →</a><a class="btn ghost" href="{{ PathBase }}/pricing">See pricing</a></div><p class="trust">48.2B events metered last month (story) · p99 ingest 41 ms · 0 unexplained invoice lines</p></div>
<div class="tape" aria-label="Sample invoice tape (story data)"><h4><span>Invoice INV-20431</span><span>Oct 2026</span></h4>
<div class="ln"><span>Customer</span><i></i><b>quillon-geocode</b></div><div class="ln"><span>Period</span><i></i><b>Oct 01 → Oct 31</b></div><div style="height:8px"></div>
<div class="ln"><span>geocode.lookups</span><i></i><b>&#36;1,284.20</b></div><div class="ln sub"><span>3,210,500 × &#36;0.40 / 1k</span></div>
<div class="ln"><span>geocode.batch_rows</span><i></i><b>&#36;612.75</b></div><div class="ln sub"><span>tier 2 · 24.51M rows @ &#36;0.025 / 1k</span></div>
<div class="ln"><span>tiles.served</span><i></i><b>&#36;318.00</b></div><div class="ln sub"><span>package · 3 × 1M tiles @ &#36;106</span></div>
<div class="ln"><span>prepaid credits</span><i></i><b>−&#36;500.00</b></div><div class="ln sub"><span>burndown · &#36;1,500 left of &#36;6,000</span></div>
<div class="ln"><span>late events (Sep)</span><i></i><b>&#36;9.40</b></div><div class="ln sub"><span>23,500 arrived within the 72 h window</span></div>
<div class="ln tot"><span>TOTAL DUE</span><i></i><b>&#36;1,724.35</b></div><div style="display:flex;justify-content:space-between;align-items:center;padding:14px 6px 4px"><span class="mono muted" style="font-size:12px">paid by ACH · ref 7781-Q</span><div class="stamp">RECONCILED<br>5 lines · 5 explained</div></div></div></div></section>
<section class="flowsec"><div class="wrap"><div class="flow">
{%- assign stages = "meter^01^Meter^Ingest raw events from your API, queue or database — idempotent, with late arrivals handled.~aggregate^02^Aggregate^Roll events up by customer, meter and any dimension you name.~rate^03^Rate^Price usage with tiers, volume, packages, minimums and prepaid credits.~invoice^04^Invoice^Every line explained, exportable, and reconciled against your ledger." | split: "~" -%}
{% for s in stages %}{%- assign sp = s | split: "^" -%}<div class="node"><span class="n">{{ sp[1] }} · STAGE</span><h3>{{ sp[2] }}</h3><p>{{ sp[3] }}</p><ul>{% for i in feats.Items %}{%- assign x=i.PublishedContent -%}{%- capture pl -%}{{ x.pillar }}{%- endcapture -%}{% if pl == sp[0] %}<li><a href="{{ PathBase }}/{{ i.RoutePath }}">{{ i.PrimaryField }}</a></li>{% endif %}{% endfor %}</ul></div>{% endfor %}
</div></div></section>
<section class="sec dark"><div class="wrap explain"><div><p class="kick">Invoice explain</p><h2>“Why is this line &#36;1,284.20?” has a one-click answer.</h2><p class="lede" style="margin-top:16px">Your customer's finance team asks. Your support team opens the line and walks it back: price, aggregate, dimension, events, the duplicates dropped and the late events counted. The same tree is in the API.</p>
<ul class="checks"><li>Deduplicated on your idempotency key, never on a guess</li><li>Late events within the window re-rate the period; after it, they post as an adjustment</li><li>Price book versions are immutable — an old invoice re-renders exactly</li><li>Export the tree as CSV or JSON for your auditors</li></ul><p style="margin-top:22px"><a class="btn sig" href="{{ PathBase }}/product/invoice-explain">How invoice explain works</a></p></div>
<div class="tree" role="img" aria-label="Invoice explain tree (story data)"><span class="h">INV-20431 · line 1 · geocode.lookups        &#36;1,284.20</span>
<span class="d">│</span>
├─ price     <span class="g">rate-card quillon-2026-07 v3</span>  per_unit &#36;0.40 / 1k
├─ aggregate <span class="g">sum(count)</span>  3,210,500
│  ├─ region=us-east        1,902,114
│  ├─ region=eu-west          981,770
│  └─ region=ap-south         326,616
├─ events    3,234,912 received
│  ├─ <span class="o">− 24,412 duplicates</span>  (idempotency_key)
│  ├─ <span class="g">+ 0 late</span>  window 72 h, closed Nov 03
│  └─ first 2026-10-01T00:00:03Z · last 2026-10-31T23:59:58Z
└─ ledger    <span class="g">posted</span>  je-88213 · reconciled ✓
<span class="d"># story data · fictional customer</span></div></div></section>
<section class="sec"><div class="wrap"><div class="head2"><div><p class="kick">Spec sheet</p><h2>What's in the ledger</h2></div><a class="btn ghost" href="{{ PathBase }}/product">All features →</a></div>
{% for i in feats.Items limit:4 %}{%- assign x=i.PublishedContent -%}<a class="specrow" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="idx">{{ forloop.index | prepend: "0" }}</span><div><p class="kick" style="margin-bottom:8px">{{ x.tagline }}</p><h3>{{ i.PrimaryField }}</h3><p>{{ x.summary }}</p></div><div class="kv">{%- assign rows = x.spec | split: "|" -%}{% for r in rows %}{%- assign kvp = r | split: ":" -%}<div><span>{{ kvp[0] | strip }}</span><b>{{ kvp[1] | strip }}</b></div>{% endfor %}</div></a>{% endfor %}</div></section>
<section class="sec rule"><div class="wrap"><div class="head2"><div><p class="kick">Customers (fictional)</p><h2>Billing that finance stopped arguing with</h2></div><a class="btn ghost" href="{{ PathBase }}/customers">All stories →</a></div><div class="stories">
{% for s in sts.Items %}{%- assign x=s.PublishedContent -%}<a class="story" href="{{ PathBase }}/{{ s.RoutePath }}"><div class="met"><div><p class="kick">{{ s.PrimaryField }} · {{ x.industry }}</p><div class="big">{{ x.metric_value }}</div><p class="muted" style="margin:8px 0 0">{{ x.metric_label }}</p></div><p style="margin:18px 0 0;font-weight:600">“{{ x.quote | truncate: 120 }}”</p></div><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""></a>{% endfor %}</div></div></section>
<section class="sec rule"><div class="wrap"><div class="head2"><div><p class="kick">Changelog</p><h2>Shipped every two weeks, in writing</h2></div><a class="btn ghost" href="{{ PathBase }}/changelog">Full changelog →</a></div><div class="log">
{% for r in rels.Items %}{%- assign x=r.PublishedContent -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- case kd -%}{%- when "feature" -%}{%- assign kl="New" -%}{%- when "improvement" -%}{%- assign kl="Improved" -%}{%- when "fix" -%}{%- assign kl="Fixed" -%}{%- else -%}{%- assign kl="Beta" -%}{%- endcase -%}<a class="logrow" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ver">{{ x.version }}</span><span class="dt">{{ x.date_label }}</span><div><b>{{ r.PrimaryField }}</b><p>{% if au == "beta" %}Beta program release notes — members only.{% else %}{{ x.summary | truncate: 110 }}{% endif %}</p></div><span class="tag {{ kd }}">{% if au == "beta" %}🔒 {% endif %}{{ kl }}</span></a>{% endfor %}</div></div></section>
<section class="sec rule"><div class="wrap"><div class="head2"><div><p class="kick">Pricing</p><h2>Priced on events, not seats</h2><p class="muted">Every plan includes unlimited dashboard users. You pay for what you meter.</p></div><a class="btn ghost" href="{{ PathBase }}/pricing">Compare plans →</a></div><div class="tiers">
{% for p in pls.Items %}{%- assign x=p.PublishedContent -%}{%- capture bd -%}{{ x.badge }}{%- endcapture -%}<div class="tier{% if bd != "" %} hi{% endif %}">{% if bd != "" %}<span class="bdg">{{ x.badge }}</span>{% endif %}<h3>{{ p.PrimaryField }}</h3><div class="price">{{ x.price_label }} <small>{{ x.price_unit }}</small></div><p class="muted" style="margin:0">{{ x.included_events }}</p><p class="muted" style="margin:0;font-size:.92rem">{{ x.overage }}</p></div>{% endfor %}</div></div></section>
<section class="sec rule"><div class="wrap"><div class="head2"><div><p class="kick">Integrations</p><h2>Meter from where the usage already is</h2></div><a class="btn ghost" href="{{ PathBase }}/integrations">Directory →</a></div><div class="chips">
{% for i in ints.Items %}{%- assign x=i.PublishedContent -%}{%- capture stt -%}{{ x.status }}{%- endcapture -%}<a class="chip" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="dot {{ stt }}"></span>{{ i.PrimaryField }}{% if stt == "beta" %} <span class="tag beta">beta</span>{% endif %}</a>{% endfor %}</div></div></section>
<section class="sec" style="padding-top:20px"><div class="wrap"><div class="closer"><div><p class="kick" style="color:#1a0d05">Customer &amp; beta hub</p><h2>Runbooks, customer docs and beta notes live behind sign-in.</h2><p style="margin:12px 0 0;max-width:620px">Public docs are open to everyone. Reconciliation runbooks, SSO setup and beta release notes are for signed-in customers — gated on the server, not hidden with script.</p></div><div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end"><a class="btn" href="{{ PathBase }}/beta">Open the hub</a><a class="btn ghost" style="border-color:#1a0d05" href="{{ PathBase }}/docs">Public docs</a></div></div></div></section>
