{%- assign x=Target.PublishedContent -%}{%- capture stt -%}{{ x.status }}{%- endcapture -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/integrations">Integrations</a></li><li>{{ Target.PrimaryField }}</li></ol><span class="tag {{ stt }}">{% if stt == "beta" %}Beta{% else %}Generally available{% endif %}</span><h1 style="margin-top:12px">{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ x.body }}</div>{%- capture stp -%}{{ x.setup }}{%- endcapture -%}{% if stp != "" %}<h3 style="margin:28px 0 12px">Setup</h3><pre class="pre">{{ x.setup | escape }}</pre>{% endif %}</div><aside class="side"><div class="card"><p class="kick">Related</p><p><a href="{{ PathBase }}/docs">Docs</a><br><a href="{{ PathBase }}/changelog">Changelog</a><br><a href="{{ PathBase }}/integrations">All integrations</a></p></div></aside></div></section>
