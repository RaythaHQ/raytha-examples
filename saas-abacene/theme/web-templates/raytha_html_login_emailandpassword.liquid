{% if Target.ValidationFailures["__ValidationSummary"] %}<div class="lock" role="alert" style="padding:12px 16px;margin-bottom:14px">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
<label for="email">Work email</label><input id="email" type="email" name="EmailAddress" autocomplete="email" style="margin-bottom:16px">
<label for="password">Password</label><input id="password" type="password" name="Password" autocomplete="current-password" style="margin-bottom:20px">
<button type="submit" class="btn" style="width:100%;justify-content:center">Sign in</button>
<input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form><p style="margin:16px 0 0;font-size:.9rem;text-align:center"><a href="{{ PathBase }}/account/login/forgot-password/begin">Forgot your password?</a></p>
