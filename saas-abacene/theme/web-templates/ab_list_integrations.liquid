<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Integrations</li></ol><p class="kick">Integrations</p><h1>Meter from where usage already lives</h1><p class="lede">Event sources, SDKs, exports, identity and finance. Open standards first, so nothing here depends on one vendor.</p></div></div>
<section class="sec tight"><div class="wrap">{%- assign cats = "sources:Event sources,sdks:SDKs,exports:Exports and warehouses,identity:Identity,ops:Alerts and ops,finance:Finance" | split: "," -%}{% for c in cats %}{%- assign cp = c | split: ":" -%}{%- capture blk -%}{% for i in Target.Items %}{%- assign x=i.PublishedContent -%}{%- capture cc -%}{{ x.category }}{%- endcapture -%}{%- capture stt -%}{{ x.status }}{%- endcapture -%}{% if cc == cp[0] %}<a class="icard" href="{{ PathBase }}/{{ i.RoutePath }}"><div class="top"><span class="glyph">{{ i.PrimaryField | slice: 0, 2 }}</span><span class="tag {{ stt }}">{% if stt == "beta" %}Beta{% else %}GA{% endif %}</span></div><b>{{ i.PrimaryField }}</b><span class="muted" style="font-size:.93rem">{{ x.summary }}</span></a>{% endif %}{% endfor %}{%- endcapture -%}{% if blk != "" %}<h2 style="font-size:1.3rem;margin:34px 0 14px">{{ cp[1] }}</h2><div class="idir">{{ blk }}</div>{% endif %}{% endfor %}</div></section>
