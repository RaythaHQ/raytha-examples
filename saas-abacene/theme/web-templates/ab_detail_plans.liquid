{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/pricing">Pricing</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">Plan</p><h1>{{ Target.PrimaryField }} · {{ x.price_label }} <span class="muted" style="font-size:.5em">{{ x.price_unit }}</span></h1><p class="lede">{{ x.best_for }}</p></div></div>
<section class="sec tight"><div class="wrap two"><div><table class="tbl"><tbody><tr><td>Included usage</td><td>{{ x.included_events }}</td></tr><tr><td>Overage</td><td>{{ x.overage }}</td></tr></tbody></table><h3 style="margin:28px 0 10px">Includes</h3><ul>{%- assign inc = x.includes | split: "|" -%}{% for li in inc %}<li>{{ li | strip }}</li>{% endfor %}</ul></div><aside class="side"><div class="card"><p class="kick">Worked example</p><p style="font:14px/1.6 var(--mono)">{{ x.example }}</p></div><a class="btn" href="{{ PathBase }}/pricing">Compare all plans</a></aside></div></section>
