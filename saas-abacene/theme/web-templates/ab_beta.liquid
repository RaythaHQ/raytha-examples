{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}{%- assign brel = get_content_items(ContentType="releases", OrderBy="released_on desc", PageSize=20) -%}{%- assign bdocs = get_content_items(ContentType="docs", OrderBy="sort_order asc", PageSize=60) -%}
<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Customer &amp; beta hub</li></ol><p class="kick">Members only</p><h1>{% if CurrentUser.IsAuthenticated %}Welcome back, {{ CurrentUser.FirstName }}.{% else %}Customer &amp; beta hub{% endif %}</h1><p class="lede">Runbooks and customer-only docs for every Abacene customer, plus release notes and guides for accounts in the beta program.</p>{% if CurrentUser.IsAuthenticated %}<p style="margin-top:14px"><span class="who">● Signed in</span> <span class="tag customers">{% if in_cust %}Customers ✓{% else %}Customers ✗{% endif %}</span> <span class="tag beta">{% if in_beta %}Beta program ✓{% else %}Beta program ✗{% endif %}</span></p>{% endif %}</div></div>
<section class="sec tight"><div class="wrap">{% unless CurrentUser.IsAuthenticated %}<div class="lock"><span class="tag locked">🔒 Sign in required</span><h2>The hub is for signed-in Abacene customers.</h2><p>Customer accounts are created by the Abacene team, so there is no sign-up form. Once signed in you see the customer runbooks, and — if your account is in the beta program — beta release notes and guides.</p><p><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/beta">Sign in</a> <a class="btn ghost" href="{{ PathBase }}/docs">Browse public docs</a></p></div>
<div class="grid3" style="margin-top:22px"><div class="card"><p class="kick">Customers</p><h3>Runbooks</h3><p class="muted">Month-end reconciliation, invoice explain API, SSO setup.</p></div><div class="card"><p class="kick">Beta</p><h3>Release notes</h3><p class="muted">What changed in each beta build, and what may still change.</p></div><div class="card"><p class="kick">Beta</p><h3>Guides</h3><p class="muted">How to try contract-aware rating and usage forecasting safely.</p></div></div>
{% else %}<div class="two"><div>{% if in_beta %}<h2 style="margin-bottom:16px">Beta release notes</h2><div class="log">{% for r in brel.Items %}{%- assign x=r.PublishedContent -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- case kd -%}{%- when "feature" -%}{%- assign kl="New" -%}{%- when "improvement" -%}{%- assign kl="Improved" -%}{%- when "fix" -%}{%- assign kl="Fixed" -%}{%- else -%}{%- assign kl="Beta" -%}{%- endcase -%}{% if au == "beta" %}<a class="logrow" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ver">{{ x.version }}</span><span class="dt">{{ x.date_label }}</span><div><b>{{ r.PrimaryField }}</b><p>{{ x.summary | truncate: 120 }}</p></div><span class="tag beta">Beta</span></a>{% endif %}{% endfor %}</div>{% else %}<div class="lock"><span class="tag locked">Beta program</span><h2>Your account is not in the beta program.</h2><p>Beta release notes and guides appear here for accounts in the beta group. In the story, your account manager adds you.</p></div>{% endif %}
<h2 style="margin:40px 0 16px">Docs for your account</h2>{% for d in bdocs.Items %}{%- assign x=d.PublishedContent -%}{%- capture ac -%}{{ x.access }}{%- endcapture -%}{%- assign ok=true -%}{%- if ac == "customers" and in_cust == false -%}{%- assign ok=false -%}{%- endif -%}{%- if ac == "beta" and in_beta == false -%}{%- assign ok=false -%}{%- endif -%}{%- case ac -%}{%- when "customers" -%}{%- assign al="Customers" -%}{%- when "beta" -%}{%- assign al="Beta" -%}{%- else -%}{%- assign al="Public" -%}{%- endcase -%}{% if ac != "public" and ok %}<a class="drow" href="{{ PathBase }}/{{ d.RoutePath }}"><div><b>{{ d.PrimaryField }}</b><p>{{ x.summary | truncate: 110 }}</p></div><span class="tag {{ ac }}">{{ al }}</span></a>{% endif %}{% endfor %}</div>
<aside class="side"><div class="card"><p class="kick">Your account (story)</p><p class="mono" style="font-size:13.5px;line-height:1.9">plan: Growth<br>events this month: 31.8M / 50M<br>credits left: &#36;1,500<br>late window: 72 h</p></div><div class="card"><p class="kick">Beta feedback</p><p>Reply to any beta email, or write to beta@abacene.example (fictional — goes nowhere). There is no feedback form on purpose.</p></div><a class="btn ghost" href="{{ PathBase }}/account/logout">Sign out</a></aside></div>{% endunless %}</div></section>
