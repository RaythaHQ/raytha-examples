{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture ac -%}{{ x.access }}{%- endcapture -%}{%- assign ok=true -%}{%- if ac == "customers" and in_cust == false -%}{%- assign ok=false -%}{%- endif -%}{%- if ac == "beta" and in_beta == false -%}{%- assign ok=false -%}{%- endif -%}{%- case ac -%}{%- when "customers" -%}{%- assign al="Customers" -%}{%- when "beta" -%}{%- assign al="Beta" -%}{%- else -%}{%- assign al="Public" -%}{%- endcase -%}<section class="sec tight"><div class="wrap docs">{%- assign alld = get_content_items(ContentType="docs", OrderBy="sort_order asc", PageSize=60) -%}{%- assign secs = "start:Get started,metering:Metering,pricing:Pricing models,invoicing:Invoicing,admin:Admin and security" | split: "," -%}<nav class="dnav" aria-label="Docs">{% for s in secs %}{%- assign sp = s | split: ":" -%}<h4>{{ sp[1] }}</h4>{% for d in alld.Items %}{%- assign y=d.PublishedContent -%}{%- capture sc -%}{{ y.section }}{%- endcapture -%}{%- capture ya -%}{{ y.access }}{%- endcapture -%}{% if sc == sp[0] %}<a href="{{ PathBase }}/{{ d.RoutePath }}"{% if d.Id == Target.Id %} class="on"{% endif %}><span>{{ d.PrimaryField }}</span>{% if ya != "public" %}<span class="lk">🔒</span>{% endif %}</a>{% endif %}{% endfor %}{% endfor %}</nav><article><ol class="crumbs"><li><a href="{{ PathBase }}/docs">Docs</a></li><li>{{ Target.PrimaryField }}</li></ol><span class="tag {{ ac }}">{% if ac != "public" %}🔒 {% endif %}{{ al }}</span><h1 style="font-size:clamp(2rem,3.6vw,3rem);margin:12px 0">{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p>
{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}<div class="lock" style="margin-top:24px"><span class="tag locked">🔒 {{ al }} only</span><h2>This page is for {% if ac == "beta" %}beta program members{% else %}signed-in Abacene customers{% endif %}.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but your account is not in the {{ al | downcase }} group.{% else %}Sign in with your customer account to read it.{% endif %} The body of this doc is never sent to the browser unless your account is in the right group.</p><p>{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a> {% endunless %}<a class="btn ghost" href="{{ PathBase }}/docs">Public docs</a></p></div>{% endif %}</article>
<aside class="dmeta"><p><b>Access</b><br>{{ al }}</p><p><b>Reading time</b><br>{{ x.reading_time }}</p><p><b>Applies to</b><br>v4.12 and later</p><p><a href="{{ PathBase }}/changelog">Changelog →</a></p></aside></div></section>
