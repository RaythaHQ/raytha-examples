<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Product</li></ol><p class="kick">Product</p><h1>Meter → Aggregate → Rate → Invoice</h1><p class="lede">Four stages, one ledger. Each capability below has a spec, a code sample and the docs that go with it.</p></div></div>
<section class="sec tight"><div class="wrap">{%- assign stages = "meter:01 · Meter,aggregate:02 · Aggregate,rate:03 · Rate,invoice:04 · Invoice" | split: "," -%}{% for s in stages %}{%- assign sp = s | split: ":" -%}<h2 style="margin:34px 0 4px;font:800 13px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--sig)">{{ sp[1] }}</h2>
{% for i in Target.Items %}{%- assign x=i.PublishedContent -%}{%- capture pl -%}{{ x.pillar }}{%- endcapture -%}{% if pl == sp[0] %}<a class="specrow" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="idx">{{ x.sort_order | prepend: "0" }}</span><div><p class="kick" style="margin-bottom:8px">{{ x.tagline }}</p><h3>{{ i.PrimaryField }}</h3><p>{{ x.summary }}</p></div><div class="kv">{%- assign rows = x.spec | split: "|" -%}{% for r in rows %}{%- assign kvp = r | split: ":" -%}<div><span>{{ kvp[0] | strip }}</span><b>{{ kvp[1] | strip }}</b></div>{% endfor %}</div></a>{% endif %}{% endfor %}{% endfor %}</div></section>
