{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="wrap"><p class="kick">Search</p><h1>Search Abacene</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="idempotency, credits, SSO, Kafka…"><button class="btn">Search</button></form></div></div>
<section class="sec tight"><div class="wrap" style="max-width:900px">{% if q != "" %}{%- capture f -%}contains(title,'{{ q }}') or contains(summary,'{{ q }}'){%- endcapture -%}{%- assign groups = "docs:Docs,features:Features,releases:Changelog,integrations:Integrations" | split: "," -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{% if r.TotalCount > 0 %}<h2 style="font-size:1.2rem;margin:28px 0 4px">{{ gp[1] }} <span class="muted mono" style="font-size:.8rem">{{ r.TotalCount }}</span></h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture ac -%}{{ x.access }}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if ac == "customers" or ac == "beta" %} <span class="tag locked">🔒 {{ ac }}</span>{% endif %}<p>{% if ac == "beta" and in_beta == false %}Members-only beta content.{% else %}{{ x.summary | truncate: 150 }}{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% else %}<p class="muted">Try <a href="?q=idempotency">idempotency</a>, <a href="?q=credits">credits</a>, <a href="?q=late">late</a> or <a href="?q=SSO">SSO</a>.</p>{% endif %}</div></section>
