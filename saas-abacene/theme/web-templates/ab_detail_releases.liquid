{%- assign in_cust=false -%}{%- assign in_beta=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "customers" -%}{%- assign in_cust=true -%}{%- endif -%}{%- if g == "beta" -%}{%- assign in_beta=true -%}{%- assign in_cust=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_cust=true -%}{%- assign in_beta=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- case kd -%}{%- when "feature" -%}{%- assign kl="New" -%}{%- when "improvement" -%}{%- assign kl="Improved" -%}{%- when "fix" -%}{%- assign kl="Fixed" -%}{%- else -%}{%- assign kl="Beta" -%}{%- endcase -%}<div class="phead"><div class="wrap" style="max-width:980px"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/changelog">Changelog</a></li><li>{{ x.version }}</li></ol><span class="tag {{ kd }}">{% if au == "beta" %}🔒 {% endif %}{{ kl }}</span><h1 style="margin-top:14px">{{ Target.PrimaryField }}</h1><p class="mono muted">{{ x.version }} · {{ x.date_label }}</p></div></div>
<section class="sec tight"><div class="wrap" style="max-width:980px">{% if au == "beta" and in_beta == false %}<div class="lock"><span class="tag locked">🔒 Beta program</span><h2>These release notes are for beta members.</h2><p>Beta notes cover behavior that may still change, so they are shared with customers in the beta program only. Sign in with a beta account to read them. The check runs on the server; the notes are not in this page.</p><p><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a> <a class="btn ghost" href="{{ PathBase }}/changelog">Back to changelog</a></p></div>{% else %}<p class="lede" style="margin-top:0">{{ x.summary }}</p><div class="prose">{{ x.body }}</div>{% endif %}</div></section>
