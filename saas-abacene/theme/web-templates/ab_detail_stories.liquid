{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="wrap two"><div><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/customers">Customers</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ Target.PrimaryField }} · {{ x.industry }} · fictional</p><h1>{{ x.headline }}</h1><div class="metrics"><div><b class="big">{{ x.metric_value }}</b><span>{{ x.metric_label }}</span></div><div><b class="big">{{ x.metric2_value }}</b><span>{{ x.metric2_label }}</span></div></div></div><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="border-radius:16px;border:1px solid var(--rule)"></div></div>
<section class="sec tight"><div class="wrap two"><div><blockquote class="quote">“{{ x.quote }}”</blockquote><p class="mono muted">— {{ x.quote_by }} (fictional)</p><div class="prose" style="margin-top:28px">{{ x.body }}</div></div><aside class="side"><div class="card"><p class="kick">At a glance</p><p>{{ x.summary }}</p></div><a class="btn" href="{{ PathBase }}/pricing">See pricing</a><a class="btn ghost" href="{{ PathBase }}/customers">More stories</a></aside></div></section>
