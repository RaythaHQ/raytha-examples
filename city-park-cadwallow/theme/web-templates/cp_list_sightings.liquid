{%- assign mon = "now" | date: "%m" | plus: 0 -%}{%- assign mab = "now" | date: "%b" -%}{%- assign mfull = "now" | date: "%B" -%}{%- assign dom = "now" | date: "%d" | plus: 0 -%}{%- assign nowm = "now" | date: "%H" | plus: 0 | times: 60 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 | plus: nowm -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign srl = "436,406,422,372,331,315,329,360,392,425,402,430" | split: "," -%}{%- assign ssl = "1006,1045,1140,1174,1205,1228,1225,1192,1143,1093,990,981" | split: "," -%}{%- assign mi = mon | minus: 1 -%}{% if dom >= 15 %}{%- assign mo = mon | modulo: 12 -%}{%- assign kd = dom | minus: 15 -%}{% else %}{%- assign mo = mon | plus: 10 | modulo: 12 -%}{%- assign kd = 15 | minus: dom -%}{% endif %}{%- assign a1 = srl[mi] | plus: 0 -%}{%- assign a2 = srl[mo] | plus: 0 -%}{%- assign sr = a2 | minus: a1 | times: kd | divided_by: 30 | floor | plus: a1 -%}{%- assign b1 = ssl[mi] | plus: 0 -%}{%- assign b2 = ssl[mo] | plus: 0 -%}{%- assign ss = b2 | minus: b1 | times: kd | divided_by: 30 | floor | plus: b1 -%}{%- assign dl = ss | minus: sr -%}{%- assign gate_open = false -%}{% if nowm >= 300 and nowm < 1380 %}{%- assign gate_open = true -%}{% endif %}{%- assign isdark = false -%}{% if nowm < sr or nowm >= ss %}{%- assign isdark = true -%}{% endif %}{%- assign qm = QueryParams.month | strip | capitalize | truncate: 3,"" -%}{% if qm == "" %}{%- assign qm = mab -%}{% endif %}<div class="phead"><svg class="topo" viewBox="0 0 760 520" aria-hidden="true"><ellipse cx="520" cy="200" rx="60" ry="34" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="104" ry="64" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="148" ry="94" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="192" ry="124" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="236" ry="154" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="280" ry="184" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="324" ry="214" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="368" ry="244" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="412" ry="274" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/></svg><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Cadwallow Park</a></li><li>Look for</li></ol><p class="kick">Look for · the year in the park</p><h1>What to look for, month by month</h1><p class="lede">Each entry stores the months it can be seen. The chart below is built from those months on the server, with this month marked. Pick a month to see only what is out then.</p><p class="filters"><a href="{{ PathBase }}/look-for?month=Jan" class="{% if qm == "Jan" %}on{% endif %}">Jan</a><a href="{{ PathBase }}/look-for?month=Feb" class="{% if qm == "Feb" %}on{% endif %}">Feb</a><a href="{{ PathBase }}/look-for?month=Mar" class="{% if qm == "Mar" %}on{% endif %}">Mar</a><a href="{{ PathBase }}/look-for?month=Apr" class="{% if qm == "Apr" %}on{% endif %}">Apr</a><a href="{{ PathBase }}/look-for?month=May" class="{% if qm == "May" %}on{% endif %}">May</a><a href="{{ PathBase }}/look-for?month=Jun" class="{% if qm == "Jun" %}on{% endif %}">Jun</a><a href="{{ PathBase }}/look-for?month=Jul" class="{% if qm == "Jul" %}on{% endif %}">Jul</a><a href="{{ PathBase }}/look-for?month=Aug" class="{% if qm == "Aug" %}on{% endif %}">Aug</a><a href="{{ PathBase }}/look-for?month=Sep" class="{% if qm == "Sep" %}on{% endif %}">Sep</a><a href="{{ PathBase }}/look-for?month=Oct" class="{% if qm == "Oct" %}on{% endif %}">Oct</a><a href="{{ PathBase }}/look-for?month=Nov" class="{% if qm == "Nov" %}on{% endif %}">Nov</a><a href="{{ PathBase }}/look-for?month=Dec" class="{% if qm == "Dec" %}on{% endif %}">Dec</a></p></div></div>
<section class="sec tight"><div class="w"><h2>Out in {{ qm }}</h2>{%- capture lf -%}contains(months,'{{ qm }}'){%- endcapture -%}{%- assign lk = get_content_items(ContentType="sightings", Filter=lf, OrderBy="sort_order asc", PageSize=20) -%}{% if lk.TotalCount > 0 %}<div class="looks">{% for s in lk.Items %}{%- assign y=s.PublishedContent -%}{%- capture sk -%}{{ y.kind }}{%- endcapture -%}{%- capture smo -%}{{ y.months }}{%- endcapture -%}<a class="look" href="{{ PathBase }}/{{ s.RoutePath }}" style="--c:{% case sk %}{% when "bloom" %}#a64d79{% when "bird" %}#2f6fb0{% when "leaves" %}#c0632b{% when "fungi" %}#7a5a3a{% when "wildlife" %}#2e7d4f{% when "sky" %}#4f8fa8{% else %}#1f3d2b{% endcase %}"><span class="band"></span><span class="b"><span class="lab">{% capture lv20 -%}{{ y.kind }}{%- endcapture %}{% case lv20 %}{% when "bloom" %}In bloom{% when "bird" %}Birds{% when "leaves" %}Leaves and color{% when "fungi" %}Fungi{% when "wildlife" %}Wildlife{% when "sky" %}Sky and water{% else %}{{ lv20 }}{% endcase %}</span><h3>{{ s.PrimaryField }}</h3><p>{{ y.summary }}</p><span class="mstrip" aria-label="Months: {{ y.months }}"><i class="{% if smo contains "Jan" %}on{% endif %}{% if mon == 1 %} now{% endif %}" title="Jan"></i><i class="{% if smo contains "Feb" %}on{% endif %}{% if mon == 2 %} now{% endif %}" title="Feb"></i><i class="{% if smo contains "Mar" %}on{% endif %}{% if mon == 3 %} now{% endif %}" title="Mar"></i><i class="{% if smo contains "Apr" %}on{% endif %}{% if mon == 4 %} now{% endif %}" title="Apr"></i><i class="{% if smo contains "May" %}on{% endif %}{% if mon == 5 %} now{% endif %}" title="May"></i><i class="{% if smo contains "Jun" %}on{% endif %}{% if mon == 6 %} now{% endif %}" title="Jun"></i><i class="{% if smo contains "Jul" %}on{% endif %}{% if mon == 7 %} now{% endif %}" title="Jul"></i><i class="{% if smo contains "Aug" %}on{% endif %}{% if mon == 8 %} now{% endif %}" title="Aug"></i><i class="{% if smo contains "Sep" %}on{% endif %}{% if mon == 9 %} now{% endif %}" title="Sep"></i><i class="{% if smo contains "Oct" %}on{% endif %}{% if mon == 10 %} now{% endif %}" title="Oct"></i><i class="{% if smo contains "Nov" %}on{% endif %}{% if mon == 11 %} now{% endif %}" title="Nov"></i><i class="{% if smo contains "Dec" %}on{% endif %}{% if mon == 12 %} now{% endif %}" title="Dec"></i></span><span class="where">{{ y.where }} · {{ y.best_time }}</span></span></a>{% endfor %}</div>{% else %}<p class="muted">Nothing listed for {{ qm }} yet.</p>{% endif %}</div></section>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2>The whole year</h2><div class="tscroll"><table class="year"><thead><tr><th style="text-align:left">Sighting</th><th class="{% if qm == "Jan" %}now{% endif %}">JAN</th><th class="{% if qm == "Feb" %}now{% endif %}">FEB</th><th class="{% if qm == "Mar" %}now{% endif %}">MAR</th><th class="{% if qm == "Apr" %}now{% endif %}">APR</th><th class="{% if qm == "May" %}now{% endif %}">MAY</th><th class="{% if qm == "Jun" %}now{% endif %}">JUN</th><th class="{% if qm == "Jul" %}now{% endif %}">JUL</th><th class="{% if qm == "Aug" %}now{% endif %}">AUG</th><th class="{% if qm == "Sep" %}now{% endif %}">SEP</th><th class="{% if qm == "Oct" %}now{% endif %}">OCT</th><th class="{% if qm == "Nov" %}now{% endif %}">NOV</th><th class="{% if qm == "Dec" %}now{% endif %}">DEC</th></tr></thead><tbody>{% for s in Target.Items %}{%- assign y=s.PublishedContent -%}{%- capture sk -%}{{ y.kind }}{%- endcapture -%}{%- capture smo -%}{{ y.months }}{%- endcapture -%}<tr class="{% if smo contains qm %}cur{% endif %}" style="--c:{% case sk %}{% when "bloom" %}#a64d79{% when "bird" %}#2f6fb0{% when "leaves" %}#c0632b{% when "fungi" %}#7a5a3a{% when "wildlife" %}#2e7d4f{% when "sky" %}#4f8fa8{% else %}#1f3d2b{% endcase %}"><td class="nm"><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a><small>{% capture lv21 -%}{{ y.kind }}{%- endcapture %}{% case lv21 %}{% when "bloom" %}In bloom{% when "bird" %}Birds{% when "leaves" %}Leaves and color{% when "fungi" %}Fungi{% when "wildlife" %}Wildlife{% when "sky" %}Sky and water{% else %}{{ lv21 }}{% endcase %}</small></td><td class="{% if smo contains "Jan" %}on{% endif %}{% if qm == "Jan" %} now{% endif %}"></td><td class="{% if smo contains "Feb" %}on{% endif %}{% if qm == "Feb" %} now{% endif %}"></td><td class="{% if smo contains "Mar" %}on{% endif %}{% if qm == "Mar" %} now{% endif %}"></td><td class="{% if smo contains "Apr" %}on{% endif %}{% if qm == "Apr" %} now{% endif %}"></td><td class="{% if smo contains "May" %}on{% endif %}{% if qm == "May" %} now{% endif %}"></td><td class="{% if smo contains "Jun" %}on{% endif %}{% if qm == "Jun" %} now{% endif %}"></td><td class="{% if smo contains "Jul" %}on{% endif %}{% if qm == "Jul" %} now{% endif %}"></td><td class="{% if smo contains "Aug" %}on{% endif %}{% if qm == "Aug" %} now{% endif %}"></td><td class="{% if smo contains "Sep" %}on{% endif %}{% if qm == "Sep" %} now{% endif %}"></td><td class="{% if smo contains "Oct" %}on{% endif %}{% if qm == "Oct" %} now{% endif %}"></td><td class="{% if smo contains "Nov" %}on{% endif %}{% if qm == "Nov" %} now{% endif %}"></td><td class="{% if smo contains "Dec" %}on{% endif %}{% if qm == "Dec" %} now{% endif %}"></td></tr>{% endfor %}</tbody></table></div></div></section>
