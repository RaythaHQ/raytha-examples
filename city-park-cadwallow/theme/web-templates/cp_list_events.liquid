h3 class="lockt">{{ e.PrimaryField }}</h3><small>{% if au == "friends" %}<span class="tg fr">🔒 Friends</span>{% elsif au == "staff" %}<span class="tg sf">🔒 Staff</span>{% else %}<span class="tg">Everyone</span>{% endif %} sign in for details</small></span></div>{% endif %}{% endfor %}</div></div></section>
