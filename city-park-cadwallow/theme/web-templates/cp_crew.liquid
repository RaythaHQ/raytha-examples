_h29 > 12 %}{%- assign _h29 = _h29 | minus: 12 -%}{% endif %}{% if _h29 == 0 %}{%- assign _h29 = 12 -%}{% endif %}{{ _h29 }}:{% if _m29 < 10 %}0{% endif %}{{ _m29 }} {{ _a29 }}{%- endcapture -%}{% elsif nowm >= cm %}{%- assign ps = "closed" -%}{%- capture pmsg -%}Closed now · opens {% assign _h30 = om | divided_by: 60 | floor -%}{%- assign _m30 = om | modulo: 60 -%}{%- assign _a30 = "am" -%}{% if _h30 >= 24 %}{%- assign _h30 = _h30 | minus: 24 -%}{% endif %}{% if _h30 >= 12 %}{%- assign _a30 = "pm" -%}{% endif %}{% if _h30 > 12 %}{%- assign _h30 = _h30 | minus: 12 -%}{% endif %}{% if _h30 == 0 %}{%- assign _h30 = 12 -%}{% endif %}{{ _h30 }}:{% if _m30 < 10 %}0{% endif %}{{ _m30 }} {{ _a30 }}{% if pcl == "dusk" %}, closes at dusk{% endif %}{%- endcapture -%}{% elsif left <= 60 %}{%- assign ps = "soon" -%}{%- capture pmsg -%}Closing soon · {% assign _h31 = cm | divided_by: 60 | floor -%}{%- assign _m31 = cm | modulo: 60 -%}{%- assign _a31 = "am" -%}{% if _h31 >= 24 %}{%- assign _h31 = _h31 | minus: 24 -%}{% endif %}{% if _h31 >= 12 %}{%- assign _a31 = "pm" -%}{% endif %}{% if _h31 > 12 %}{%- assign _h31 = _h31 | minus: 12 -%}{% endif %}{% if _h31 == 0 %}{%- assign _h31 = 12 -%}{% endif %}{{ _h31 }}:{% if _m31 < 10 %}0{% endif %}{{ _m31 }} {{ _a31 }}{% if pcl == "dusk" %} (dusk){% endif %}{%- endcapture -%}{% else %}{%- assign ps = "open" -%}{%- capture pmsg -%}Open now · until {% assign _h32 = cm | divided_by: 60 | floor -%}{%- assign _m32 = cm | modulo: 60 -%}{%- assign _a32 = "am" -%}{% if _h32 >= 24 %}{%- assign _h32 = _h32 | minus: 24 -%}{% endif %}{% if _h32 >= 12 %}{%- assign _a32 = "pm" -%}{% endif %}{% if _h32 > 12 %}{%- assign _h32 = _h32 | minus: 12 -%}{% endif %}{% if _h32 == 0 %}{%- assign _h32 = 12 -%}{% endif %}{{ _h32 }}:{% if _m32 < 10 %}0{% endif %}{{ _m32 }} {{ _a32 }}{% if pcl == "dusk" %} (dusk){% endif %}{%- endcapture -%}{% endif %}<li><i class="st-{{ ps }}"></i><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ y.number }} · {{ p.PrimaryField }}</a><em>{% case ps %}{% when "open" %}Open{% when "soon" %}Closing soon{% when "later" %}Opens later{% when "closed" %}Closed now{% else %}Out of season{% endcase %}</em></li>{% endfor %}</ul></div></div>
<div><h2>Work orders, rotas and plans</h2><ul class="rows">{% for r in wo.Items %}{%- assign y=r.PublishedContent -%}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.zone }} · {{ y.summary }}</small></span><span><span class="tg sf">{% capture lv38 -%}{{ y.kind }}{%- endcapture %}{% case lv38 %}{% when "workday" %}Workday plan{% when "tools" %}Tool shed{% when "minutes" %}Minutes{% when "workorder" %}Work order{% when "rota" %}Crew rota{% when "safety" %}Safety{% when "closure" %}Closure plan{% else %}{{ lv38 }}{% endcase %}</span></span></li>{% endfor %}</ul>
