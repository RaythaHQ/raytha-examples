{% elsif in_fr %}<div class="lockp"><p class="kick">🔒 Park staff only</p><h2>You are signed in with a Friends account.</h2><p class="muted">The crew board is for park staff. Friends have the <a href="{{ PathBase }}/stewards">stewards' shed</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Park staff only</p><h2>Sign in to open the crew board.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the volunteer coordinator opens accounts for stewards, and the parks office opens them for staff.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/crew">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the Friends</a></p></div>{% endif %}</div></section>{% if in_st %}{{ render_section("main", wrap=false) }}{% endif %}<div style="height:50px"></div>
