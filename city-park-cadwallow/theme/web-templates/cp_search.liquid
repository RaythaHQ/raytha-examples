{%- assign mon = "now" | date: "%m" | plus: 0 -%}{%- assign mab = "now" | date: "%b" -%}{%- assign mfull = "now" | date: "%B" -%}{%- assign dom = "now" | date: "%d" | plus: 0 -%}{%- assign nowm = "now" | date: "%H" | plus: 0 | times: 60 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 | plus: nowm -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign srl = "436,406,422,372,331,315,329,360,392,425,402,430" | split: "," -%}{%- assign ssl = "1006,1045,1140,1174,1205,1228,1225,1192,1143,1093,990,981" | split: "," -%}{%- assign mi = mon | minus: 1 -%}{% if dom >= 15 %}{%- assign mo = mon | modulo: 12 -%}{%- assign kd = dom | minus: 15 -%}{% else %}{%- assign mo = mon | plus: 10 | modulo: 12 -%}{%- assign kd = 15 | minus: dom -%}{% endif %}{%- assign a1 = srl[mi] | plus: 0 -%}{%- assign a2 = srl[mo] | plus: 0 -%}{%- assign sr = a2 | minus: a1 | times: kd | divided_by: 30 | floor | plus: a1 -%}{%- assign b1 = ssl[mi] | plus: 0 -%}{%- assign b2 = ssl[mo] | plus: 0 -%}{%- assign ss = b2 | minus: b1 | times: kd | divided_by: 30 | floor | plus: b1 -%}{%- assign dl = ss | minus: sr -%}{%- assign gate_open = false -%}{% if nowm >= 300 and nowm < 1380 %}{%- assign gate_open = true -%}{% endif %}{%- assign isdark = false -%}{% if nowm < sr or nowm >= ss %}{%- assign isdark = true -%}{% endif %}{%- assign in_fr=false -%}{%- assign in_st=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "friends" -%}{%- assign in_fr=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_st=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fr=true -%}{%- assign in_st=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><svg class="topo" viewBox="0 0 760 520" aria-hidden="true"><ellipse cx="520" cy="200" rx="60" ry="34" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="104" ry="64" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="148" ry="94" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="192" ry="124" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="236" ry="154" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="280" ry="184" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="324" ry="214" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="368" ry="244" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="412" ry="274" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/></svg><div class="w"><p class="kick">Search</p><h1>Search the park</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="oak, boathouse, ice"><button class="btn wood">Search</button></form><p class="lede" style="margin-top:12px;font-size:1rem">Searches places, trails, the tree register, what to look for, conditions, projects, events and bulletins.</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "places:Places:name:summary,trails:Trails:name:summary,trees:Tree register:name:summary,sightings:Look for:title:summary,conditions:Conditions:title:summary,projects:Park projects:title:summary,events:Events:title:summary,bulletins:Bulletins:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--forest)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "friends" %} <span class="tg fr">🔒 Friends</span>{% elsif au == "staff" %} <span class="tg sf">🔒 Staff</span>{% endif %}{% if au == "friends" and in_fr == false %}<p>Sign in to read.</p>{% elsif au == "staff" and in_st == false %}<p>Sign in to read.</p>{% else %}<p>{{ x.summary | strip_html | truncate: 150 }}</p>{% endif %}</a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=oak">oak</a>, <a href="?q=boathouse">boathouse</a>, <a href="?q=ice">ice</a> or <a href="?q=playground">playground</a>.</p>{% endif %}</div></div></section>
