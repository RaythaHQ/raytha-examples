{%- assign mon = "now" | date: "%m" | plus: 0 -%}{%- assign mab = "now" | date: "%b" -%}{%- assign mfull = "now" | date: "%B" -%}{%- assign dom = "now" | date: "%d" | plus: 0 -%}{%- assign nowm = "now" | date: "%H" | plus: 0 | times: 60 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 | plus: nowm -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign srl = "436,406,422,372,331,315,329,360,392,425,402,430" | split: "," -%}{%- assign ssl = "1006,1045,1140,1174,1205,1228,1225,1192,1143,1093,990,981" | split: "," -%}{%- assign mi = mon | minus: 1 -%}{% if dom >= 15 %}{%- assign mo = mon | modulo: 12 -%}{%- assign kd = dom | minus: 15 -%}{% else %}{%- assign mo = mon | plus: 10 | modulo: 12 -%}{%- assign kd = 15 | minus: dom -%}{% endif %}{%- assign a1 = srl[mi] | plus: 0 -%}{%- assign a2 = srl[mo] | plus: 0 -%}{%- assign sr = a2 | minus: a1 | times: kd | divided_by: 30 | floor | plus: a1 -%}{%- assign b1 = ssl[mi] | plus: 0 -%}{%- assign b2 = ssl[mo] | plus: 0 -%}{%- assign ss = b2 | minus: b1 | times: kd | divided_by: 30 | floor | plus: b1 -%}{%- assign dl = ss | minus: sr -%}{%- assign gate_open = false -%}{% if nowm >= 300 and nowm < 1380 %}{%- assign gate_open = true -%}{% endif %}{%- assign isdark = false -%}{% if nowm < sr or nowm >= ss %}{%- assign isdark = true -%}{% endif %}{%- assign in_fr=false -%}{%- assign in_st=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "friends" -%}{%- assign in_fr=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_st=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fr=true -%}{%- assign in_st=true -%}{%- endif -%}<div class="phead"><svg class="topo" viewBox="0 0 760 520" aria-hidden="true"><ellipse cx="520" cy="200" rx="60" ry="34" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="104" ry="64" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="148" ry="94" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="192" ry="124" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="236" ry="154" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="280" ry="184" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="324" ry="214" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="368" ry="244" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="412" ry="274" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/></svg><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Cadwallow Park</a></li><li>Stewards' shed</li></ol><p class="kick">Stewards' shed · Friends only</p><h1>{% if in_fr %}Morning, {{ CurrentUser.FirstName }}.{% else %}Stewards' shed{% endif %}</h1><p class="lede">{% if in_fr %}Workdays, the tool shed, adopted plots and the Friends' minutes. Demo account: names and figures are fictional.{% else %}Workday plans, the tool shed and the Friends' minutes, for signed-in stewards.{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:20px"><div class="w">{% if in_fr %}{%- assign wd = get_content_items(ContentType="events", Filter="audience eq 'friends'", OrderBy="sort_order asc", PageSize=6) -%}{%- assign nwd = "" -%}{% for e in wd.Items %}{% if forloop.first %}{%- capture nwd -%}{{ e.PublishedContent.date_label | upcase }}{%- endcapture -%}{% endif %}{% endfor %}{%- assign fb = get_content_items(ContentType="bulletins", Filter="audience eq 'friends'", OrderBy="sort_order asc", PageSize=10) -%}
<div class="g2" style="grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:34px;align-items:start"><div style="display:grid;gap:18px"><div class="badge"><div class="t">FRIENDS OF CADWALLOW PARK · STEWARD</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">VOLUNTEER STEWARD · DEMO ACCOUNT<br>NEXT WORKDAY: {{ nwd }}</div></div><div class="card"><p class="kick">Today, worked out on the server</p><dl class="kv"><dt>Gates</dt><dd>{% if gate_open %}Open until 11:00 pm{% else %}Locked until 5:00 am{% endif %}</dd><dt>Sunset</dt><dd>{% assign _h27 = ss | divided_by: 60 | floor -%}{%- assign _m27 = ss | modulo: 60 -%}{%- assign _a27 = "am" -%}{% if _h27 >= 24 %}{%- assign _h27 = _h27 | minus: 24 -%}{% endif %}{% if _h27 >= 12 %}{%- assign _a27 = "pm" -%}{% endif %}{% if _h27 > 12 %}{%- assign _h27 = _h27 | minus: 12 -%}{% endif %}{% if _h27 == 0 %}{%- assign _h27 = 12 -%}{% endif %}{{ _h27 }}:{% if _m27 < 10 %}0{% endif %}{{ _m27 }} {{ _a27 }} (stop work 30 min before)</dd><dt>Daylight</dt><dd>{{ dl | divided_by: 60 | floor }} h {{ dl | modulo: 60 }} min</dd></dl></div></div>
<div><h2>Workdays for stewards</h2><div class="cal" style="grid-template-columns:1fr">{% for e in wd.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt">{{ y.month | upcase }}<b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div><h2 style="margin-top:34px">Plans, the tool shed and minutes</h2><ul class="rows">{% for r in fb.Items %}{%- assign y=r.PublishedContent -%}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></span><span><span class="tg fr">{% capture lv37 -%}{{ y.kind }}{%- endcapture %}{% case lv37 %}{% when "workday" %}Workday plan{% when "tools" %}Tool shed{% when "minutes" %}Minutes{% when "workorder" %}Work order{% when "rota" %}Crew rota{% when "safety" %}Safety{% when "closure" %}Closure plan{% else %}{{ lv37 }}{% endcase %}</span></span></li>{% endfor %}</ul></div></div>
{% elsif in_st %}<div class="lockp"><p class="kick">🔒 Friends only</p><h2>You are signed in with a staff account.</h2><p class="muted">The stewards' shed is for Friends of the park. Staff have the <a href="{{ PathBase }}/crew">crew board</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Friends only</p><h2>Sign in to open the stewards' shed.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the volunteer coordinator opens accounts for stewards, and the parks office opens them for staff.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/stewards">Sign in</a><a class="btn line" href="{{ PathBase }}/about">About the Friends</a></p></div>{% endif %}</div></section>{% if in_fr %}{{ render_section("main", wrap=false) }}{% endif %}<div style="height:50px"></div>
