<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Cadwallow Park" %}{{ Target.Title }} | {% endif %}Cadwallow Park</title>
{%- capture mau -%}{{ Target.PublishedContent.audience }}{%- endcapture -%}<meta name="description" content="{% if mau == "friends" or mau == "staff" %}Members-only page at Cadwallow Park (fictional). Sign in to read.{% elsif Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Cadwallow Park (fictional): a city park website with a trailhead-kiosk park map, open-now status for every gate, playground, shelter and restroom worked out on the server, sunrise and sunset, trails with elevation profiles, a tree register, what to look for this month, trail conditions, park projects, and members-only areas for the Friends of the park and park staff. Built on Raytha, a self-hosted, open-source .NET CMS for city parks departments.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&family=Overpass+Mono:wght@400;600&display=swap" rel="stylesheet"><style>
:root{--paper:#f4efe3;--kraft:#ebe2cc;--card:#fffdf7;--forest:#1f3d2b;--forest2:#2e5a3c;--moss:#4f7d4f;--brown:#5a3e2b;--brownD:#3e2b1e;--cream:#f4ecd8;--ink:#22261f;--ink2:#5d6357;--rule:#dccfb3;--rule2:#ebe2cc;
--blue:#2f6fb0;--red:#c0392b;--orange:#d9822b;--yellow:#d4b21f;--green:#2e7d4f;--ok:#2e7d4f;--warn:#d9822b;--bad:#b03a2e;--off:#8a8475}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:400 1.02rem/1.62 "Literata",Georgia,serif}
img{max-width:100%;display:block}a{color:var(--forest2)}h1,h2,h3,h4{font-family:"Overpass",system-ui,sans-serif;color:var(--forest);line-height:1.12;margin:0 0 .5em;letter-spacing:-.005em}
h1{font-size:clamp(2.1rem,4.2vw,3.3rem);font-weight:800}h2{font-size:clamp(1.5rem,2.4vw,2.05rem);font-weight:800}h3{font-size:1.16rem;font-weight:700}
.w{max-width:1280px;margin:0 auto;padding:0 32px}.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:9}
.kick,.lab{font:600 .7rem/1.3 "Overpass Mono",monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--brown);margin:0 0 10px}
.muted{color:var(--ink2)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;background:var(--forest);color:var(--cream);border-radius:6px;font:700 .95rem "Overpass",sans-serif;text-decoration:none;border:0;cursor:pointer}.btn:hover{background:var(--forest2)}.btn.line{background:transparent;color:var(--forest);box-shadow:inset 0 0 0 2px var(--forest)}.btn.wood{background:var(--brown)}
.cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
/* top strip + header */
.strip{background:var(--forest);color:#cfdccf;font:600 .78rem "Overpass",sans-serif}.strip .w{display:flex;justify-content:space-between;gap:16px;align-items:center;padding-top:7px;padding-bottom:7px}.strip a{color:#fff;text-decoration:none;margin-left:16px}.strip a:hover{text-decoration:underline}
.gchip{display:inline-flex;align-items:center;gap:7px;padding:2px 10px 2px 8px;border-radius:999px;background:rgba(255,255,255,.1)}.gchip i{width:9px;height:9px;border-radius:50%;background:#7fd08f;box-shadow:0 0 0 3px rgba(127,208,143,.25)}.gchip.off i{background:#e07a6a;box-shadow:0 0 0 3px rgba(224,122,106,.25)}
.strip .f{font:600 .66rem "Overpass Mono",monospace;letter-spacing:.12em;opacity:.75;margin-left:6px}
.top{background:var(--kraft);border-bottom:3px solid var(--brown)}.top .w{display:flex;align-items:center;gap:26px;padding-top:14px;padding-bottom:14px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.plank{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;padding:8px 18px 7px;border-radius:9px;color:var(--cream);background:repeating-linear-gradient(90deg,rgba(255,255,255,.04) 0 3px,transparent 3px 11px),linear-gradient(#6b4a33,#563a28);box-shadow:inset 0 0 0 2px #3e2b1e,inset 0 0 0 4px #7d5c43,0 2px 0 #3e2b1e}
.plank b{font:800 1.28rem/1 "Overpass",sans-serif;letter-spacing:.09em}.plank small{font:600 .58rem "Overpass Mono",monospace;letter-spacing:.22em;opacity:.85;margin-top:4px}
.top nav{flex:1}.top nav ul{list-style:none;margin:0;padding:0;display:flex;gap:2px;flex-wrap:wrap}.top nav a{display:block;padding:9px 11px;font:700 .95rem "Overpass",sans-serif;color:var(--forest);text-decoration:none;border-radius:5px}.top nav a:hover{background:rgba(31,61,43,.08)}
.top form input{width:170px;padding:9px 12px;border:2px solid var(--brown);border-radius:6px;background:var(--card);font:inherit;font-size:.92rem}
/* page head: a wayfinding sign */
.phead{background:var(--forest);color:#d9e4d6;padding:36px 0 40px;position:relative;overflow:hidden}.phead .topo{position:absolute;right:-120px;top:-80px;width:760px;opacity:.22;pointer-events:none}.phead .w{position:relative}
.phead h1{color:#fff;max-width:22ch}.phead .lede{max-width:66ch;font-size:1.1rem;margin:0;color:#d9e4d6}.phead .kick{color:#e9c48f}
.crumbs{list-style:none;display:flex;gap:6px;padding:0;margin:0 0 18px;flex-wrap:wrap}.crumbs li{font:700 .78rem "Overpass",sans-serif;color:#fff}.crumbs li a{color:#fff;text-decoration:none}
.crumbs li{background:var(--brown);padding:4px 12px 3px 10px;clip-path:polygon(0 0,calc(100% - 9px) 0,100% 50%,calc(100% - 9px) 100%,0 100%);padding-right:18px;border-radius:3px 0 0 3px}.crumbs li:last-child{background:#3a5c45}
.sec{padding:60px 0}.sec.tight{padding:36px 0}.sec.kraft{background:var(--kraft)}.sec.dark{background:var(--forest);color:#d9e4d6}.sec.dark h2,.sec.dark h3{color:#fff}
.shead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:22px}.shead p{margin:0;max-width:62ch;color:var(--ink2)}.shead a.more{font:700 .92rem "Overpass",sans-serif;white-space:nowrap}
.dark .shead p{color:#c3d1c0}.dark .kick{color:#e9c48f}
/* kiosk hero */
.kiosk{padding:34px 0 46px;background:linear-gradient(var(--kraft),var(--paper))}
.kframe{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:0;background:var(--brownD);border-radius:14px;padding:12px;box-shadow:0 18px 40px -22px rgba(30,25,15,.6)}
.kroof{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:6px 10px 14px;color:var(--cream)}
.kroof h1{color:var(--cream);font-size:clamp(1.6rem,2.8vw,2.4rem);margin:0;letter-spacing:.02em}.kroof p{margin:4px 0 0;font-size:.98rem;color:#e6d7bd;max-width:62ch}
.kmap{background:#d9d3c2;border-radius:8px;overflow:hidden;position:relative;display:flex;align-items:center}.kmap .pmap{display:block;width:100%;height:auto}
.today{background:var(--card);border-radius:8px;margin-left:12px;padding:18px 20px;display:flex;flex-direction:column;gap:14px}
.today .hd{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--forest);padding-bottom:8px}.today .hd b{font:800 1.05rem "Overpass",sans-serif;color:var(--forest)}.today .hd span{font:600 .66rem "Overpass Mono",monospace;letter-spacing:.14em;color:var(--brown)}
.gate{display:flex;gap:12px;align-items:center;padding:12px 14px;border-radius:8px;background:#e5efe3}.gate.off{background:#f6e2dc}.gate .lt{width:16px;height:16px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 5px rgba(46,125,79,.18)}.gate.off .lt{background:var(--bad);box-shadow:0 0 0 5px rgba(176,58,46,.18)}
.gate b{display:block;font:800 1.08rem "Overpass",sans-serif;color:var(--forest)}.gate small{font-size:.86rem;color:var(--ink2)}
.sun{display:grid;grid-template-columns:1fr 1fr;gap:4px 14px}.sun div{display:flex;flex-direction:column}.sun span{font:600 .64rem "Overpass Mono",monospace;letter-spacing:.12em;color:var(--brown);text-transform:uppercase}.sun b{font:800 1.4rem "Overpass",sans-serif;color:var(--forest)}
.dbar{position:relative;height:16px;border-radius:8px;background:linear-gradient(90deg,#2c3a4a 0,#2c3a4a var(--sr),#f2c14e var(--sr),#f7dd8b 50%,#f2c14e var(--ss),#2c3a4a var(--ss));margin-top:6px}.dbar i{position:absolute;top:-5px;bottom:-5px;width:3px;background:var(--red);left:var(--now);border-radius:2px}.dbar+small{display:flex;justify-content:space-between;font:600 .62rem "Overpass Mono",monospace;color:var(--ink2);margin-top:4px}
.onow{list-style:none;margin:0;padding:0;display:grid;gap:7px}.onow li{display:grid;grid-template-columns:10px 1fr auto;gap:10px;align-items:center;font-size:.9rem}.onow li i{width:10px;height:10px;border-radius:50%}.onow a{color:var(--ink);text-decoration:none}.onow a:hover{text-decoration:underline}.onow em{font:600 .66rem "Overpass Mono",monospace;font-style:normal;color:var(--ink2)}
.st-open{background:var(--ok)}.st-soon{background:var(--warn)}.st-later,.st-closed{background:var(--bad)}.st-season{background:var(--off)}
.today .ft{margin-top:auto;font:600 .64rem "Overpass Mono",monospace;letter-spacing:.06em;color:var(--ink2);border-top:1px dashed var(--rule);padding-top:10px}
.legend{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px;grid-column:1/-1}.legend a{display:flex;gap:9px;align-items:center;padding:7px 12px 7px 8px;background:#2b1e15;border-radius:6px;color:var(--cream);text-decoration:none}.legend a:hover{background:#4a3424}.legend b{display:block;font:700 .9rem "Overpass",sans-serif;line-height:1.1}.legend small{font:600 .62rem "Overpass Mono",monospace;opacity:.8}
.light .legend a{background:var(--card);color:var(--ink);border:1px solid var(--rule)}.light .legend a:hover{border-color:var(--forest)}
/* map svg */
.pmap .city{fill:#d9d3c2}.pmap .blk{fill:#cbc4b0}.pmap .road{stroke:#f4efe3;stroke-width:22;fill:none}.pmap .street{font:700 11px "Overpass",sans-serif;letter-spacing:.2em;fill:#7a7363}
.pmap .park{fill:#cfe0b5;stroke:#8aa56d;stroke-width:3}.pmap .woods{fill:#9cbf86}.pmap .meadow{fill:#dfe9b8}.pmap .tuft{stroke:#9fb06a;stroke-width:1.4;fill:none}
.pmap .tc1{fill:#4f7d4f}.pmap .tc2{fill:#3c6b47}.pmap .tc3{fill:#2e5a3c}.pmap .contour{fill:none;stroke:#6f8f5a;stroke-width:1.2;opacity:.55;stroke-dasharray:4 3}
.pmap .creek{fill:none;stroke:#6ea6c8;stroke-width:6;stroke-linecap:round}.pmap .wet{fill:#b9d2b4;stroke:#8ab09c;stroke-dasharray:3 3}.pmap .lake{fill:#86b6d3;stroke:#5f97ba;stroke-width:3}.pmap .ripple{fill:none;stroke:#cfe3ef;stroke-width:2}
.pmap .garden{fill:#b8693e}.pmap .gardenin{fill:#e9efd9}.pmap .spur{stroke:#fff;stroke-width:8;stroke-dasharray:2 0}.pmap .infield{fill:#d8b98a;stroke:#fff;stroke-width:2}
.pmap .area{font:800 14px "Overpass",sans-serif;letter-spacing:.16em;fill:#24402c;paint-order:stroke;stroke:#eef3e0;stroke-width:3.5px;stroke-linejoin:round}.pmap .area.sm{font-size:10.5px}.pmap .area.lk{fill:#fff;stroke:#5f97ba;font-size:15px}.pmap .creekl{fill:#3f6f8f}
.pmap .north circle{fill:#fffdf7;stroke:#3e2b1e;stroke-width:2}.pmap .north path{fill:#c0392b}.pmap .north text{font:800 12px "Overpass",sans-serif;fill:#3e2b1e}
.pmap .scale path{stroke:#3e2b1e;stroke-width:2;fill:none}.pmap .scale text{font:600 10px "Overpass Mono",monospace;fill:#3e2b1e}
.pmap .tcase{fill:none;stroke:#fff;stroke-width:11;stroke-linejoin:round;stroke-linecap:round;opacity:.9}.pmap .tline{fill:none;stroke-width:5.5;stroke-linejoin:round;stroke-linecap:round;stroke-dasharray:14 5}
.pmap .tlink:hover .tline{stroke-width:8}.pmap .tlink.fade{opacity:.22}.pmap .tlink.fade:hover{opacity:.6}
.pmap .pin circle{fill:#1f3d2b;stroke:#fff;stroke-width:2.5}.pmap .pin text{font:800 12px "Overpass",sans-serif;fill:#fff}.pmap .pin.gate circle{fill:#5a3e2b}.pmap .pin:hover circle{fill:#c0392b}
.pmap .hl circle{fill:none;stroke:#c0392b;stroke-width:4}.pmap .hl circle+circle{stroke-width:2;opacity:.5}
.pmap .here path{fill:#c0392b;stroke:#fff;stroke-width:2}.pmap .here rect{fill:#c0392b}.pmap .here text{font:800 11px "Overpass",sans-serif;letter-spacing:.12em;fill:#fff}
.pmap .ttag .tring{fill:#fffdf7;stroke:#7a5a3a;stroke-width:2}.pmap .ttag .tleaf{fill:#2e7d4f}.pmap .ttag .tstem{stroke:#5a3e2b;stroke-width:2}.pmap .ttag:hover .tring{stroke:#c0392b;stroke-width:3}
.mapcard{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:10px;overflow:hidden}.mapcard .pmap{display:block;width:100%;height:auto;border-radius:6px}
/* status cards */
.board{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.pcard{display:grid;grid-template-columns:40px 1fr;gap:12px;background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:14px 14px 13px;text-decoration:none;color:var(--ink);position:relative}.pcard:hover{border-color:var(--forest)}
.pcard .no{width:36px;height:36px;border-radius:50%;background:var(--forest);color:#fff;display:grid;place-items:center;font:800 .95rem "Overpass",sans-serif}.pcard.gate .no{background:var(--brown)}
.pcard h3{font-size:1rem;margin:0 0 2px}.pcard small{display:block;font-size:.83rem;color:var(--ink2);line-height:1.35}
.sbadge{display:inline-flex;align-items:center;gap:6px;font:600 .66rem/1.4 "Overpass Mono",monospace;letter-spacing:.06em;text-transform:uppercase;margin-top:7px;padding:5px 8px;border-radius:4px;color:#fff}.sbadge.st-season{color:#fff}
/* look for */
.looks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.look{background:var(--card);border:1px solid var(--rule);border-radius:10px;overflow:hidden;text-decoration:none;color:var(--ink);display:flex;flex-direction:column}.look:hover{border-color:var(--forest)}
.look .band{height:8px;background:var(--c)}.look .b{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px}.look .lab{color:var(--c);margin:0}.look h3{margin:0}.look p{margin:0;font-size:.93rem;color:var(--ink2)}
.look .where{font:600 .7rem "Overpass Mono",monospace;color:var(--forest2);margin-top:auto;padding-top:8px;border-top:1px dashed var(--rule)}
.mstrip{display:grid;grid-template-columns:repeat(12,1fr);gap:2px;margin-top:6px}.mstrip i{height:6px;border-radius:2px;background:var(--rule2)}.mstrip i.on{background:var(--c)}.mstrip i.now{outline:2px solid var(--ink);outline-offset:1px}
/* year chart */
.year{width:100%;border-collapse:separate;border-spacing:3px;background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:10px}.year th{font:600 .66rem "Overpass Mono",monospace;letter-spacing:.08em;color:var(--ink2);padding:6px 2px;text-align:center}.year th.now{color:#fff;background:var(--forest);border-radius:4px}
.year td{height:30px;border-radius:4px;background:#f1ebdc}.year td.on{background:var(--c)}.year td.nm{background:transparent;padding:0 12px 0 4px;height:auto;width:30%}.year td.nm a{font:700 .92rem "Overpass",sans-serif;color:var(--forest);text-decoration:none}.year td.nm small{display:block;font:600 .62rem "Overpass Mono",monospace;color:var(--ink2);text-transform:uppercase;letter-spacing:.08em}
.year td.now{box-shadow:inset 0 0 0 2px var(--forest)}.year tr.cur td.nm a{color:var(--red)}
/* trails */
.trails{display:grid;gap:14px}
.post{display:grid;grid-template-columns:64px minmax(0,1.3fr) minmax(0,1fr) 220px;gap:22px;align-items:center;background:var(--card);border:1px solid var(--rule);border-left:10px solid var(--c);border-radius:10px;padding:16px 20px;text-decoration:none;color:var(--ink)}.post:hover{border-color:var(--c)}
.post .blaze{width:56px;height:56px}.post h3{margin:0 0 3px;font-size:1.28rem}.post p{margin:0;font-size:.93rem;color:var(--ink2)}
.stats{display:grid;grid-template-columns:repeat(3,auto);gap:4px 18px;justify-content:start}.stats span{font:600 .62rem "Overpass Mono",monospace;letter-spacing:.1em;color:var(--brown);text-transform:uppercase}.stats b{display:block;font:800 1.18rem "Overpass",sans-serif;color:var(--forest);letter-spacing:0;text-transform:none}
.spark{width:100%;height:58px;display:block}.spark .pf,.prof .pf{fill:color-mix(in srgb,var(--c) 22%,transparent)}.spark .pl,.prof .pl{fill:none;stroke:var(--c);stroke-width:2.5;vector-effect:non-scaling-stroke;stroke-linejoin:round}
.profwrap{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:18px 20px}.prof{width:100%;height:220px;display:block}.prof .pg{stroke:var(--rule);stroke-width:1;vector-effect:non-scaling-stroke}
.pax{display:flex;justify-content:space-between;font:600 .66rem "Overpass Mono",monospace;color:var(--ink2);margin-top:6px}
.wps{list-style:none;margin:0;padding:0;border-left:4px solid var(--c);margin-left:10px}.wps li{position:relative;padding:9px 0 9px 22px;display:grid;grid-template-columns:70px 1fr;gap:10px;border-bottom:1px dashed var(--rule)}.wps li:before{content:"";position:absolute;left:-10px;top:15px;width:12px;height:12px;border-radius:50%;background:var(--card);border:3px solid var(--c)}.wps b{font:700 .8rem "Overpass Mono",monospace;color:var(--brown)}
/* conditions */
.conds{list-style:none;margin:0;padding:0;background:var(--card);border:1px solid var(--rule);border-radius:10px;overflow:hidden}.conds li{display:grid;grid-template-columns:150px minmax(0,1fr) 200px;gap:18px;padding:14px 18px;border-bottom:1px solid var(--rule2);align-items:center}.conds li:last-child{border-bottom:0}
.light3{display:flex;gap:5px;padding:6px 8px;background:#2b2a26;border-radius:20px;width:max-content}.light3 i{width:14px;height:14px;border-radius:50%;background:#4a4842}.light3.open i:nth-child(1){background:#5fd07f;box-shadow:0 0 8px #5fd07f}.light3.caution i:nth-child(2){background:#f2a33a;box-shadow:0 0 8px #f2a33a}.light3.closed i:nth-child(3){background:#ec5c4a;box-shadow:0 0 8px #ec5c4a}
.conds b{font:700 1rem "Overpass",sans-serif;color:var(--forest)}.conds a{text-decoration:none}.conds small{display:block;color:var(--ink2);font-size:.9rem}.conds .meta{font:600 .7rem "Overpass Mono",monospace;color:var(--ink2);text-align:right}
.conds .stl{font:600 .66rem "Overpass Mono",monospace;letter-spacing:.08em;text-transform:uppercase;margin-top:6px;display:block;color:var(--ink2)}
/* projects */
.projs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.proj{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:20px 22px;display:flex;flex-direction:column;gap:10px}.proj h3{margin:0}.proj h3 a{color:var(--forest);text-decoration:none}.proj p{margin:0;font-size:.95rem;color:var(--ink2)}
.steps{list-style:none;margin:4px 0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);position:relative}.steps li{position:relative;text-align:center;font:600 .62rem "Overpass Mono",monospace;letter-spacing:.04em;color:var(--ink2);text-transform:uppercase}
.steps li i{display:block;width:18px;height:18px;margin:0 auto 6px;border-radius:50%;background:var(--card);border:3px solid var(--rule);position:relative;z-index:1}.steps li:before{content:"";position:absolute;top:8px;left:-50%;right:50%;height:3px;background:var(--rule)}.steps li:first-child:before{display:none}
.steps li.done i{background:var(--green);border-color:var(--green)}.steps li.done:before,.steps li.now:before{background:var(--green)}.steps li.now i{border-color:var(--green);background:#fff;box-shadow:0 0 0 4px rgba(46,125,79,.2)}.steps li.now{color:var(--forest);font-weight:600}
.budget .bt{height:12px;border-radius:6px;background:var(--rule2);overflow:hidden}.budget .bt i{display:block;height:100%;background:repeating-linear-gradient(135deg,var(--forest2) 0 10px,var(--moss) 10px 20px)}.budget .bn{display:flex;justify-content:space-between;font-size:.82rem;color:var(--ink2);margin-top:6px}.budget b{color:var(--forest);font-family:"Overpass",sans-serif}
/* trees */
.tags{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.tag-al{position:relative;display:flex;flex-direction:column;gap:6px;padding:26px 18px 18px;text-decoration:none;color:#2a2d2f;border-radius:10px 10px 10px 10px;background:linear-gradient(135deg,#e6e8e9,#c9cdd0 45%,#eef0f1 60%,#bfc4c7);box-shadow:inset 0 0 0 1px rgba(0,0,0,.18),0 6px 14px -8px rgba(0,0,0,.4)}
.tag-al:before{content:"";position:absolute;top:10px;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:var(--paper);box-shadow:inset 0 1px 2px rgba(0,0,0,.5)}
.tag-al .no{font:800 1.5rem "Overpass Mono",monospace;letter-spacing:.06em;color:#3b3f42;text-shadow:0 1px 0 rgba(255,255,255,.7)}.tag-al h3{margin:0;color:#1f3d2b}.tag-al small{font:italic .88rem "Literata",serif;color:#4b5055}.tag-al .sz{display:flex;gap:14px;font:600 .7rem "Overpass Mono",monospace;color:#3b3f42;margin-top:auto;padding-top:8px;border-top:1px solid rgba(0,0,0,.15)}
.tag-al.heritage{box-shadow:inset 0 0 0 1px rgba(0,0,0,.18),inset 0 -6px 0 #b8693e,0 6px 14px -8px rgba(0,0,0,.4)}
.rings{display:block;margin:0 auto}
/* events */
.cal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 34px}.ev{display:grid;grid-template-columns:62px 1fr;gap:16px;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.ev .dt{text-align:center;background:var(--brown);color:var(--cream);border-radius:6px;padding:7px 0 6px;height:fit-content;font:600 .66rem "Overpass Mono",monospace;letter-spacing:.1em}.ev .dt b{display:block;font:800 1.5rem/1 "Overpass",sans-serif;letter-spacing:0}.ev h3{margin:0 0 3px;font-size:1.04rem}.ev small{color:var(--ink2);font-size:.88rem}
.lockt{color:var(--ink2)!important}
.tg{display:inline-block;font:600 .64rem/1 "Overpass Mono",monospace;letter-spacing:.08em;padding:5px 8px;border-radius:3px;border:1px solid var(--rule);color:var(--ink2);margin-right:6px;text-transform:uppercase;white-space:nowrap;background:var(--card)}.tg.fr{background:#e3efd9;border-color:#b9d3a6;color:#2e5a3c}.tg.sf{background:#efe2d2;border-color:#d8bf9e;color:#5a3e2b}
/* generic */
.dg{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,370px);gap:46px;align-items:start}.side{position:sticky;top:20px}
.card{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:22px 24px}
.prose{max-width:70ch}.prose h2{margin-top:1.3em;font-size:1.5rem}
.kv{display:grid;grid-template-columns:auto 1fr;gap:9px 18px;margin:0}.kv dt{font:600 .64rem/1.9 "Overpass Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--brown)}.kv dd{margin:0}
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-top:20px}.filters a{padding:7px 13px;text-decoration:none;font:700 .85rem "Overpass",sans-serif;color:#d9e4d6;border:1px solid rgba(255,255,255,.28);border-radius:999px}.filters a:hover{border-color:#fff;color:#fff}.filters a.on{background:#e9c48f;color:var(--brownD);border-color:#e9c48f}
.table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--rule)}.table th{text-align:left;font:600 .64rem/1 "Overpass Mono",monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--brown);padding:12px 14px;border-bottom:2px solid var(--forest)}.table td{padding:12px 14px;border-bottom:1px solid var(--rule2);vertical-align:top;font-size:.95rem}.table td a{font:700 1rem "Overpass",sans-serif;color:var(--forest)}.table td small{display:block;color:var(--ink2)}
.tscroll{overflow-x:auto}
.rows{list-style:none;margin:0;padding:0;border-top:2px solid var(--forest)}.rows li{display:grid;grid-template-columns:120px 1fr auto;gap:20px;padding:14px 0;border-bottom:1px solid var(--rule);align-items:baseline}.rows .k{font:600 .72rem "Overpass Mono",monospace;color:var(--ink2)}.rows a{font:700 1.02rem "Overpass",sans-serif;text-decoration:none;color:var(--forest)}.rows a:hover{color:var(--red)}.rows small{display:block;color:var(--ink2);font-size:.9rem}
.lockp{background:var(--card);border:1px solid var(--rule);border-left:8px solid var(--brown);padding:30px 32px;max-width:780px;border-radius:8px}.lockp h2{font-size:1.6rem}
.badge{background:var(--forest);color:var(--cream);border-radius:14px;padding:22px 24px 20px;position:relative;overflow:hidden;border:3px solid #e9c48f}.badge .t{font:600 .64rem "Overpass Mono",monospace;letter-spacing:.16em;color:#e9c48f}.badge .who{font:800 1.8rem/1.1 "Overpass",sans-serif;margin:12px 0 6px;color:#fff}.badge .bc{font:600 .72rem/1.6 "Overpass Mono",monospace;letter-spacing:.06em;opacity:.9}
.badge:after{content:"";position:absolute;right:-30px;top:-30px;width:150px;height:150px;border-radius:50%;border:16px solid rgba(233,196,143,.16)}.badge.staff{background:var(--brown)}
.figs{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;background:var(--card);border:1px solid var(--rule);border-radius:10px}.figs div{padding:20px 16px;border-left:1px solid var(--rule)}.figs div:first-child{border-left:0}.figs b{display:block;font:800 1.9rem/1 "Overpass",sans-serif;color:var(--forest2)}.figs span{font-size:.88rem;color:var(--ink2)}
details.q{border-bottom:1px solid var(--rule)}details.q summary{cursor:pointer;padding:16px 0;font:700 1.06rem "Overpass",sans-serif;color:var(--forest);list-style:none;display:flex;justify-content:space-between;gap:12px}details.q summary::-webkit-details-marker{display:none}details.q summary:after{content:"+";color:var(--brown);font-size:1.3rem;line-height:1}details.q[open] summary:after{content:"–"}details.q p{margin:0 0 16px;color:var(--ink2)}
.rules{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.rule{display:grid;grid-template-columns:62px 1fr;gap:14px;align-items:start;background:var(--brown);color:var(--cream);border-radius:10px;padding:16px;box-shadow:inset 0 0 0 2px #3e2b1e,inset 0 0 0 4px #7d5c43}.rule .cd{width:58px;height:58px;border-radius:50%;background:var(--cream);color:var(--brownD);display:grid;place-items:center;font:800 .95rem "Overpass",sans-serif;border:3px solid #3e2b1e}.rule b{display:block;font:800 1.04rem "Overpass",sans-serif;color:#fff;margin-bottom:4px}.rule span{font-size:.9rem;color:#ead9bd}
.ways{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.way{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:18px}.way .md{display:inline-block;font:800 .72rem "Overpass Mono",monospace;letter-spacing:.14em;background:var(--forest);color:#fff;padding:5px 9px;border-radius:4px;margin-bottom:10px}.way h3{font-size:1.02rem;margin:0 0 6px}.way p{margin:0;font-size:.93rem;color:var(--ink2)}
.searchbar{display:flex;gap:10px;max-width:640px;margin-top:20px}.searchbar input{flex:1;padding:13px 16px;border:2px solid #fff;border-radius:6px;font:inherit;background:#fff}.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.hit b{font:700 1.06rem "Overpass",sans-serif;color:var(--forest)}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.94rem}
.foot{background:#17291d;color:#b9c8b6;padding:56px 0 26px;font-size:.94rem}.foot h4{font:600 .66rem "Overpass Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:#e9c48f}.foot a{color:#e2ebe0;text-decoration:none}.foot a:hover{color:#fff;text-decoration:underline}.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:7px}.fg{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:34px}
.disc{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;border-top:1px solid #2e4a35;margin-top:40px;padding-top:18px;font:600 .66rem "Overpass Mono",monospace;letter-spacing:.06em}
.notice{background:#f6e2dc;border:1px solid #e3b5a9;padding:12px 14px;margin-bottom:14px;border-radius:6px}label{display:block;font:700 .95rem "Overpass",sans-serif;margin:0 0 6px;color:var(--forest)}input[type=email],input[type=password]{width:100%;padding:12px 14px;border:2px solid var(--forest);border-radius:6px;font:inherit;background:#fff}
.g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.g3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.friends{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:40px;align-items:center}
.lyr{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 12px}.lyr a{padding:7px 13px;border-radius:999px;border:1px solid var(--rule);background:var(--card);text-decoration:none;font:700 .85rem "Overpass",sans-serif;color:var(--forest)}.lyr a.on{background:var(--forest);color:#fff;border-color:var(--forest)}
.areas{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.areas h3{font-size:.98rem;padding-bottom:6px;border-bottom:3px solid var(--forest)}.areas ul{list-style:none;margin:0;padding:0;display:grid;gap:6px}.areas li a{display:grid;grid-template-columns:26px 1fr;gap:8px;text-decoration:none;color:var(--ink);font-size:.92rem;align-items:center}.areas li a span{width:24px;height:24px;border-radius:50%;background:var(--forest);color:#fff;display:grid;place-items:center;font:800 .72rem "Overpass",sans-serif}
.amen{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}.amen li{background:var(--kraft);border-radius:999px;padding:5px 12px;font:600 .85rem "Overpass",sans-serif;color:var(--brownD)}
.hero-img{border-radius:10px;border:1px solid var(--rule);margin-bottom:24px}
@media (max-width:1100px){.kframe{grid-template-columns:1fr}.today{margin:12px 0 0}.board{grid-template-columns:repeat(2,minmax(0,1fr))}.looks,.rules,.g3{grid-template-columns:repeat(2,minmax(0,1fr))}.tags,.ways{grid-template-columns:repeat(2,minmax(0,1fr))}.post{grid-template-columns:56px 1fr;}.post .stats,.post .spark{grid-column:2}.dg,.friends,.projs,.g2{grid-template-columns:1fr}.side{position:static}.areas{grid-template-columns:repeat(2,minmax(0,1fr))}.figs{grid-template-columns:repeat(3,1fr)}.figs div:nth-child(4){border-left:0}.fg{grid-template-columns:1fr 1fr}.top form{display:none}}
@media (max-width:640px){.w{padding:0 16px}.strip .f{display:none}.strip .w{font-size:.74rem}.top .w{flex-wrap:wrap;gap:10px}.top nav ul{flex-wrap:nowrap;overflow-x:auto}.top nav a{white-space:nowrap;font-size:.88rem;padding:8px 8px}
.kiosk{padding:16px 0 30px}.kframe{padding:8px;border-radius:10px}.kroof{padding:4px 6px 10px}.kroof p{font-size:.9rem}.kroof .btn{display:none}.board,.looks,.rules,.tags,.ways,.cal,.g3,.areas{grid-template-columns:1fr}.figs{grid-template-columns:repeat(2,1fr)}.figs div:nth-child(odd){border-left:0}.fg{grid-template-columns:1fr}
.conds li{grid-template-columns:1fr;gap:6px}.conds .meta{text-align:left}.rows li{grid-template-columns:1fr;gap:4px}.post{padding:14px;gap:14px}.stats{grid-template-columns:repeat(3,auto)}.year{font-size:.8rem}.year td{height:22px}.year th{font-size:.5rem}.mapcard{padding:6px}.legend a{padding:6px 10px 6px 6px}.phead .topo{display:none}.shead{flex-direction:column;align-items:start}}
