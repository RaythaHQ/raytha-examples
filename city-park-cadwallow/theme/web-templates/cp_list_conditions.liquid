12 520 200)"/><ellipse cx="520" cy="200" rx="280" ry="184" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="324" ry="214" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="368" ry="244" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="412" ry="274" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/></svg><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Cadwallow Park</a></li><li>Conditions</li></ol><p class="kick">Conditions board</p><h1>Trail and facility conditions</h1><p class="lede">Posted by the park crew. Red means closed, amber means take care, green means open. Updated as things change.</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><ul class="conds">{% for c in Target.Items %}{%- assign y=c.PublishedContent -%}{%- capture cst -%}{{ y.status }}{%- endcapture -%}<li><span><span class="light3 {{ cst }}" aria-hidden="true"><i></i><i></i><i></i></span><span class="stl">{% capture lv23 -%}{{ y.status }}{%- endcapture %}{% case lv23 %}{% when "open" %}Open{% when "caution" %}Use caution{% when "closed" %}Closed{% else %}{{ lv23 }}{% endcase %}</span></span><span><a href="{{ PathBase }}/{{ c.RoutePath }}"><b>{{ c.PrimaryField }}</b></a><small>{{ y.applies_to }} · {{ y.summary }}</small></span><span class="meta">Posted {{ y.posted }}{%- capture _c5 -%}{{ y.until }}{%- endcapture -%}{% if _c5 != "" %}<br>Until {{ y.until }}{% endif %}</span></li>{% endfor %}</ul></div></section>
