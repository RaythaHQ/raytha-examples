<section class="sec kraft"><div class="w"><div class="shead"><div><p class="kick">Look for · {{ mfull }}</p><h2>In the park this month</h2><p>Picked from the year's list by the current month. Next month the list changes on its own.</p></div><a class="more" href="{{ PathBase }}/look-for">The whole year →</a></div><div class="looks">{% for s in looks.Items %}{%- assign y=s.PublishedContent -%}{%- capture sk -%}{{ y.kind }}{%- endcapture -%}{%- capture smo -%}{{ y.months }}{%- endcapture -%}<a class="look" href="{{ PathBase }}/{{ s.RoutePath }}" style="--c:{% case sk %}{% when "bloom" %}#a64d79{% when "bird" %}#2f6fb0{% when "leaves" %}#c0632b{% when "fungi" %}#7a5a3a{% when "wildlife" %}#2e7d4f{% when "sky" %}#4f8fa8{% else %}#1f3d2b{% endcase %}"><span class="band"></span><span class="b"><span class="lab">{% capture lv3 -%}{{ y.kind }}{%- endcapture %}{% case lv3 %}{% when "bloom" %}In bloom{% when "bird" %}Birds{% when "leaves" %}Leaves and color{% when "fungi" %}Fungi{% when "wildlife" %}Wildlife{% when "sky" %}Sky and water{% else %}{{ lv3 }}{% endcase %}</span><h3>{{ s.PrimaryField }}</h3><p>{{ y.summary }}</p><span class="mstrip" aria-label="Months: {{ y.months }}"><i class="{% if smo contains "Jan" %}on{% endif %}{% if mon == 1 %} now{% endif %}" title="Jan"></i><i class="{% if smo contains "Feb" %}on{% endif %}{% if mon == 2 %} now{% endif %}" title="Feb"></i><i class="{% if smo contains "Mar" %}on{% endif %}{% if mon == 3 %} now{% endif %}" title="Mar"></i><i class="{% if smo contains "Apr" %}on{% endif %}{% if mon == 4 %} now{% endif %}" title="Apr"></i><i class="{% if smo contains "May" %}on{% endif %}{% if mon == 5 %} now{% endif %}" title="May"></i><i class="{% if smo contains "Jun" %}on{% endif %}{% if mon == 6 %} now{% endif %}" title="Jun"></i><i class="{% if smo contains "Jul" %}on{% endif %}{% if mon == 7 %} now{% endif %}" title="Jul"></i><i class="{% if smo contains "Aug" %}on{% endif %}{% if mon == 8 %} now{% endif %}" title="Aug"></i><i class="{% if smo contains "Sep" %}on{% endif %}{% if mon == 9 %} now{% endif %}" title="Sep"></i><i class="{% if smo contains "Oct" %}on{% endif %}{% if mon == 10 %} now{% endif %}" title="Oct"></i><i class="{% if smo contains "Nov" %}on{% endif %}{% if mon == 11 %} now{% endif %}" title="Nov"></i><i class="{% if smo contains "Dec" %}on{% endif %}{% if mon == 12 %} now{% endif %}" title="Dec"></i></span><span class="where">{{ y.where }} · {{ y.best_time }}</span></span></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Five blazed trails · 10.6 miles</p><h2>Follow the blaze</h2><p>Each trail has its own blaze on posts at every junction. Profiles are drawn on the server from the elevations stored with each trail, all on the same scale.</p></div><a class="more" href="{{ PathBase }}/trails">Trail guide →</a></div><div class="trails">{% for t in trs.Items %}{%- assign y=t.PublishedContent -%}{%- capture bsh -%}{{ y.blaze_shape }}{%- endcapture -%}{%- capture bcol -%}{{ y.blaze_color }}{%- endcapture -%}<a class="post" href="{{ PathBase }}/{{ t.RoutePath }}" style="--c:{{ bcol }}"><svg class="blaze" width="56" height="56" viewBox="0 0 28 28" aria-hidden="true"><rect x="1" y="1" width="26" height="26" rx="5" fill="#fff" stroke="#1f2a24" stroke-width="1.5"/>{% case bsh %}{% when "circle" %}<circle cx="14" cy="14" r="8" fill="{{ bcol }}"/>{% when "triangle" %}<path d="M14 5 L23 21 H5Z" fill="{{ bcol }}"/>{% when "square" %}<rect x="6.5" y="6.5" width="15" height="15" fill="{{ bcol }}"/>{% when "diamond" %}<path d="M14 4 L24 14 L14 24 L4 14Z" fill="{{ bcol }}"/>{% else %}<rect x="5" y="10" width="18" height="8" fill="{{ bcol }}"/>{% endcase %}</svg><span><h3>{{ t.PrimaryField }}</h3><p>{{ y.summary }}</p></span><span class="stats"><span>Length<b>{{ y.length_mi }} mi</b></span><span>Climb<b>{{ y.climb_ft }} ft</b></span><span>Grade<b>{% capture lv4 -%}{{ y.difficulty }}{%- endcapture %}{% case lv4 %}{% when "easy" %}Easy{% when "moderate" %}Moderate{% when "hard" %}Strenuous{% else %}{{ lv4 }}{% endcase %}</b></span></span><span>{%- assign pv = y.profile | split: "," -%}{%- assign pn = pv.size | minus: 1 -%}{%- assign pmin = 99999 -%}{%- assign pmax = 0 -%}{% for e in pv %}{%- assign ev = e | strip | plus: 0 -%}{% if ev < pmin %}{%- assign pmin = ev -%}{% endif %}{% if ev > pmax %}{%- assign pmax = ev -%}{% endif %}{% endfor %}{%- assign pbase = pmin | minus: 6 -%}{%- capture ppts -%}{% for e in pv %}{%- assign ev = e | strip | plus: 0 -%}{%- assign px = forloop.index0 | times: 220 | divided_by: pn -%}{%- assign py = ev | minus: pbase | times: 58 | divided_by: 170 -%}{%- assign py = 58 | minus: py -%}{{ px }},{{ py }} {% endfor %}{%- endcapture -%}<svg class="spark" viewBox="0 0 220 58" preserveAspectRatio="none" role="img" aria-label="Elevation profile, {{ pmin }} to {{ pmax }} feet"><polygon points="0,58 {{ ppts }}220,58" class="pf"/><polyline points="{{ ppts }}" class="pl"/></svg><span class="pax"><span>{{ y.route }}</span><span>{{ y.time_label }}</span></span></span></a>{% endfor %}</div></div></section>
<section class="sec tight" style="padding-bottom:60px"><div class="w"><div class="g2" style="grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:34px"><div><div class="shead"><div><p class="kick">Conditions board</p><h2>Posted by the crew</h2></div><a class="more" href="{{ PathBase }}/conditions">All conditions →</a></div><ul class="conds">{% for c in cds.Items %}{%- assign y=c.PublishedContent -%}{%- capture cst -%}{{ y.status }}{%- endcapture -%}<li><span><span class="light3 {{ cst }}" aria-hidden="true"><i></i><i></i><i></i></span><span class="stl">{% capture lv5 -%}{{ y.status }}{%- endcapture %}{% case lv5 %}{% when "open" %}Open{% when "caution" %}Use caution{% when "closed" %}Closed{% else %}{{ lv5 }}{% endcase %}</span></span><span><a href="{{ PathBase }}/{{ c.RoutePath }}"><b>{{ c.PrimaryField }}</b></a><small>{{ y.applies_to }} · {{ y.summary }}</small></span><span class="meta">Posted {{ y.posted }}{%- capture _c0 -%}{{ y.until }}{%- endcapture -%}{% if _c0 != "" %}<br>Until {{ y.until }}{% endif %}</span></li>{% endfor %}</ul></div>
<div><div class="shead"><div><p class="kick">Park projects</p><h2>Being built</h2></div><a class="more" href="{{ PathBase }}/projects">All projects →</a></div><div style="display:grid;gap:16px">{% for p in pjs.Items %}{%- assign y=p.PublishedContent -%}<div class="proj"><p class="kick" style="margin:0">{% capture lv6 -%}{{ y.area }}{%- endcapture %}{% case lv6 %}{% when "woods" %}Cadwallow Woods{% when "meadow" %}Long Meadow{% when "wallow" %}The Wallow{% when "south" %}South Commons{% when "east" %}Elm Walk{% else %}{{ lv6 }}{% endcase %} · {% capture lv7 -%}{{ y.status }}{%- endcapture %}{% case lv7 %}{% when "planning" %}Planning{% when "design" %}Design{% when "bidding" %}Bidding{% when "construction" %}Construction{% when "complete" %}Complete{% else %}{{ lv7 }}{% endcase %}</p><h3><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a></h3>{%- assign php = y.phase | append: "" | plus: 0 -%}<ol class="steps"><li class="{% if php > 1 %}done{% elsif php == 1 %}now{% endif %}"><i></i><span>Planning</span></li><li class="{% if php > 2 %}done{% elsif php == 2 %}now{% endif %}"><i></i><span>Design</span></li><li class="{% if php > 3 %}done{% elsif php == 3 %}now{% endif %}"><i></i><span>Bidding</span></li><li class="{% if php > 4 %}done{% elsif php == 4 %}now{% endif %}"><i></i><span>Construction</span></li><li class="{% if php > 5 %}done{% elsif php == 5 %}now{% endif %}"><i></i><span>Complete</span></li></ol><p>{{ y.summary }}</p>{%- assign bg = y.budget | append: "" | plus: 0 -%}{%- assign bf = y.funded | append: "" | plus: 0 -%}{%- assign bp = bf | times: 100 | divided_by: bg | floor -%}{% if bp > 100 %}{%- assign bp = 100 -%}{% endif %}<div class="budget"><div class="bt"><i style="width:{{ bp }}%"></i></div><div class="bn"><span><b>${{ bf | format_number: "N0" }}</b> funded</span><span><b>{{ bp }}%</b></span><span><b>${{ bg | format_number: "N0" }}</b> budget</span></div></div><p style="font-size:.86rem"><b>Timeline:</b> {{ y.timeline }}</p></div>{% endfor %}</div></div></div></div></section>
<section class="sec dark"><div class="w"><div class="friends"><div><p class="kick">Events · free, nothing to book</p><h2>Coming up in the park</h2><div class="cal" style="grid-template-columns:1fr">{% for e in evs.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" style="color:#d9e4d6;border-color:#2e4a35" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt">{{ y.month | upcase }}<b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div><p class="cta"><a class="btn wood" href="{{ PathBase }}/events">All events</a></p></div>
<div class="card" style="background:#24452f;border-color:#2e5a3c;color:#d9e4d6"><p class="kick">Friends of Cadwallow Park</p><h2>Twelve workdays a year, and a shed full of loppers</h2><p>The Friends clear invasive shrubs, plant the meadow plots and raise money for the park: &#36;198,500 so far toward the new playground. Come to any Saturday workday; there is no form to fill in.</p><p class="cta">{% if in_fr %}<a class="btn wood" href="{{ PathBase }}/stewards">Open the stewards' shed</a>{% else %}<a class="btn wood" href="{{ PathBase }}/account/login?returnUrl=/stewards">Stewards sign in</a>{% endif %}<a class="btn line" style="color:#fff;box-shadow:inset 0 0 0 2px #fff" href="{{ PathBase }}/about">About the Friends</a></p></div></div></div></section>
