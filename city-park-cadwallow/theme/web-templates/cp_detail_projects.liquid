{%- assign mon = "now" | date: "%m" | plus: 0 -%}{%- assign mab = "now" | date: "%b" -%}{%- assign mfull = "now" | date: "%B" -%}{%- assign dom = "now" | date: "%d" | plus: 0 -%}{%- assign nowm = "now" | date: "%H" | plus: 0 | times: 60 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 | plus: nowm -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign srl = "436,406,422,372,331,315,329,360,392,425,402,430" | split: "," -%}{%- assign ssl = "1006,1045,1140,1174,1205,1228,1225,1192,1143,1093,990,981" | split: "," -%}{%- assign mi = mon | minus: 1 -%}{% if dom >= 15 %}{%- assign mo = mon | modulo: 12 -%}{%- assign kd = dom | minus: 15 -%}{% else %}{%- assign mo = mon | plus: 10 | modulo: 12 -%}{%- assign kd = 15 | minus: dom -%}{% endif %}{%- assign a1 = srl[mi] | plus: 0 -%}{%- assign a2 = srl[mo] | plus: 0 -%}{%- assign sr = a2 | minus: a1 | times: kd | divided_by: 30 | floor | plus: a1 -%}{%- assign b1 = ssl[mi] | plus: 0 -%}{%- assign b2 = ssl[mo] | plus: 0 -%}{%- assign ss = b2 | minus: b1 | times: kd | divided_by: 30 | floor | plus: b1 -%}{%- assign dl = ss | minus: sr -%}{%- assign gate_open = false -%}{% if nowm >= 300 and nowm < 1380 %}{%- assign gate_open = true -%}{% endif %}{%- assign isdark = false -%}{% if nowm < sr or nowm >= ss %}{%- assign isdark = true -%}{% endif %}{%- assign x=Target.PublishedContent -%}<div class="phead"><svg class="topo" viewBox="0 0 760 520" aria-hidden="true"><ellipse cx="520" cy="200" rx="60" ry="34" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="104" ry="64" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="148" ry="94" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="192" ry="124" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="236" ry="154" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="280" ry="184" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="324" ry="214" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="368" ry="244" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/><ellipse cx="520" cy="200" rx="412" ry="274" fill="none" stroke="#e9c48f" stroke-width="1.3" transform="rotate(-12 520 200)"/></svg><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Cadwallow Park</a></li><li><a href="{{ PathBase }}/projects">Park projects</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv28 -%}{{ x.area }}{%- endcapture %}{% case lv28 %}{% when "woods" %}Cadwallow Woods{% when "meadow" %}Long Meadow{% when "wallow" %}The Wallow{% when "south" %}South Commons{% when "east" %}Elm Walk{% else %}{{ lv28 }}{% endcase %} · {% capture lv29 -%}{{ x.status }}{%- endcapture %}{% case lv29 %}{% when "planning" %}Planning{% when "design" %}Design{% when "bidding" %}Bidding{% when "construction" %}Construction{% when "complete" %}Complete{% else %}{{ lv29 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><div class="card" style="margin-bottom:26px">{%- assign php = x.phase | append: "" | plus: 0 -%}<ol class="steps"><li class="{% if php > 1 %}done{% elsif php == 1 %}now{% endif %}"><i></i><span>Planning</span></li><li class="{% if php > 2 %}done{% elsif php == 2 %}now{% endif %}"><i></i><span>Design</span></li><li class="{% if php > 3 %}done{% elsif php == 3 %}now{% endif %}"><i></i><span>Bidding</span></li><li class="{% if php > 4 %}done{% elsif php == 4 %}now{% endif %}"><i></i><span>Construction</span></li><li class="{% if php > 5 %}done{% elsif php == 5 %}now{% endif %}"><i></i><span>Complete</span></li></ol><div style="margin-top:18px">{%- assign bg = x.budget | append: "" | plus: 0 -%}{%- assign bf = x.funded | append: "" | plus: 0 -%}{%- assign bp = bf | times: 100 | divided_by: bg | floor -%}{% if bp > 100 %}{%- assign bp = 100 -%}{% endif %}<div class="budget"><div class="bt"><i style="width:{{ bp }}%"></i></div><div class="bn"><span><b>${{ bf | format_number: "N0" }}</b> funded</span><span><b>{{ bp }}%</b></span><span><b>${{ bg | format_number: "N0" }}</b> budget</span></div></div></div></div><div class="prose">{{ x.body }}</div></div><aside class="card side"><dl class="kv"><dt>Phase</dt><dd>{% capture lv30 -%}{{ x.status }}{%- endcapture %}{% case lv30 %}{% when "planning" %}Planning{% when "design" %}Design{% when "bidding" %}Bidding{% when "construction" %}Construction{% when "complete" %}Complete{% else %}{{ lv30 }}{% endcase %}</dd><dt>Area</dt><dd>{% capture lv31 -%}{{ x.area }}{%- endcapture %}{% case lv31 %}{% when "woods" %}Cadwallow Woods{% when "meadow" %}Long Meadow{% when "wallow" %}The Wallow{% when "south" %}South Commons{% when "east" %}Elm Walk{% else %}{{ lv31 }}{% endcase %}</dd><dt>Budget</dt><dd>${{ x.budget | append: "" | plus: 0 | format_number: "N0" }}</dd><dt>Funding</dt><dd>{{ x.funding }}</dd><dt>Timeline</dt><dd>{{ x.timeline }}</dd>{%- capture _c6 -%}{{ x.meeting }}{%- endcapture -%}{% if _c6 != "" %}<dt>Public meeting</dt><dd>{{ x.meeting }}</dd>{% endif %}</dl></aside></div></div></section>
