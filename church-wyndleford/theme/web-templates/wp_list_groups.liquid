{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- capture dq -%}{{ QueryParams.day | strip }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>Small groups</li></ol><p class="kick">Small groups · {{ Target.TotalCount }}</p><h1>Smaller than Sunday</h1><p class="lede">Groups of six to twenty people who meet during the week, in homes, in the parish hall and in one diner. The neighborhood and time are public; members see who hosts and the address.</p></div></div><section class="sec tight"><div class="w"><div class="filters"><a href="?" class="{% if dq == "" %}on{% endif %}">Any day</a><a href="?day=Monday" class="{% if dq == "Monday" %}on{% endif %}">Monday</a><a href="?day=Tuesday" class="{% if dq == "Tuesday" %}on{% endif %}">Tuesday</a><a href="?day=Wednesday" class="{% if dq == "Wednesday" %}on{% endif %}">Wednesday</a><a href="?day=Thursday" class="{% if dq == "Thursday" %}on{% endif %}">Thursday</a><a href="?day=Friday" class="{% if dq == "Friday" %}on{% endif %}">Friday</a><a href="?day=Saturday" class="{% if dq == "Saturday" %}on{% endif %}">Saturday</a><a href="?day=Sunday" class="{% if dq == "Sunday" %}on{% endif %}">Sunday</a></div><div class="groups">{% for g in Target.Items %}{%- capture gd -%}{{ g.PublishedContent.day }}{%- endcapture -%}{% if dq == "" or dq == gd %}{%- assign gy = g.PublishedContent -%}{%- capture gop -%}{{ gy.open }}{%- endcapture -%}<a class="card gcard" href="{{ PathBase }}/{{ g.RoutePath }}"><span class="when"><span>{{ gy.day }} · {{ gy.time }}</span><span>{% capture lv13 -%}{{ gy.kind }}{%- endcapture %}{% case lv13 %}{% when "bible" %}Bible study{% when "prayer" %}Prayer{% when "parents" %}Parents{% when "young" %}Young adults{% when "seniors" %}Seniors{% when "books" %}Books{% when "service" %}Service{% else %}{{ lv13 }}{% endcase %}</span></span><b>{{ g.PrimaryField }}</b><p>{{ gy.summary }}</p><span class="muted" style="font-size:.86rem">{{ gy.area }} · about {{ gy.usual_size }} people{% if gop == "no" %} · <b style="font:inherit;color:#7a5b2a">full for now</b>{% endif %}</span>{% if in_m %}<span class="host">Hosted by {{ gy.host }} · {{ gy.address }}</span>{% else %}<span class="host locked">🔒 Members see the host and address</span>{% endif %}</a>{% endif %}{% endfor %}</div></div></section>
