{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign SS = get_content_items(ContentType="seasons", OrderBy="sort_order asc", PageSize=20) -%}{%- assign cur = SS.Items | first -%}{%- assign ys = 0 -%}{%- assign ye = 0 -%}{%- for s in SS.Items -%}{%- capture _dsa -%}{{ s.PublishedContent.start }}{%- endcapture -%}{%- assign sa = _dsa | remove: "-" | plus: 0 -%}{%- capture _dsb -%}{{ s.PublishedContent.end }}{%- endcapture -%}{%- assign sb = _dsb | remove: "-" | plus: 0 -%}{%- if sa <= todayn and sb >= todayn -%}{%- assign cur = s -%}{%- endif -%}{%- capture _nso -%}{{ s.PublishedContent.sort_order }}{%- endcapture -%}{%- assign so = _nso | plus: 0 -%}{%- if so >= 1 -%}{%- capture _ese1 -%}{{ s.PublishedContent.start }}{%- endcapture -%}{%- assign se1 = _ese1 | date: "%s" | plus: 0 -%}{%- capture _ese2 -%}{{ s.PublishedContent.end }}{%- endcapture -%}{%- assign se2 = _ese2 | date: "%s" | plus: 0 -%}{%- if ys == 0 -%}{%- assign ys = se1 -%}{%- endif -%}{%- assign ye = se2 -%}{%- endif -%}{%- endfor -%}{%- assign today_season = cur -%}{%- capture sq -%}{{ QueryParams.s | strip }}{%- endcapture -%}{%- assign preview = false -%}{%- if sq != "" -%}{%- for s in SS.Items -%}{%- capture sk -%}{{ s.PublishedContent.key }}{%- endcapture -%}{%- capture _nso -%}{{ s.PublishedContent.sort_order }}{%- endcapture -%}{%- assign so = _nso | plus: 0 -%}{%- if sk == sq and so >= 1 -%}{%- assign cur = s -%}{%- assign preview = true -%}{%- endif -%}{%- endfor -%}{%- endif -%}{%- capture thex -%}{{ Target.PublishedContent.hex }}{%- endcapture -%}{%- if thex != "" -%}{%- assign cur = Target -%}{%- assign preview = true -%}{%- endif -%}{%- assign ytot = ye | minus: ys | divided_by: 86400 | plus: 1 -%}{%- assign tday = nows | minus: ys | divided_by: 86400 -%}{%- capture acc -%}{{ cur.PublishedContent.hex }}{%- endcapture -%}{%- capture tint -%}{{ cur.PublishedContent.tint }}{%- endcapture -%}{%- capture cname -%}{{ cur.PublishedContent.name }}{%- endcapture -%}{%- capture ckey -%}{{ cur.PublishedContent.key }}{%- endcapture -%}{%- assign SM = get_content_items(ContentType="sermons", OrderBy="date asc", PageSize=80) -%}{%- assign gotnx = false -%}{%- assign nx = SM.Items | first -%}{%- assign lastp = SM.Items | first -%}{%- for s in SM.Items -%}{%- capture _dsd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- assign sd = _dsd | remove: "-" | plus: 0 -%}{%- if sd >= todayn and gotnx == false -%}{%- assign nx = s -%}{%- assign gotnx = true -%}{%- endif -%}{%- if sd < todayn -%}{%- assign lastp = s -%}{%- endif -%}{%- endfor -%}{%- assign PP = get_content_items(ContentType="people", OrderBy="sort_order asc", PageSize=40) -%}{%- assign y = nx.PublishedContent -%}{%- capture nxhex_k -%}{{ y.color }}{%- endcapture -%}{% case nxhex_k %}{% when "blue" %}{%- assign nxhex = "#34417c" -%}{% when "violet" %}{%- assign nxhex = "#5b2e63" -%}{% when "white" %}{%- assign nxhex = "#a87b1f" -%}{% when "green" %}{%- assign nxhex = "#3c6a49" -%}{% when "red" %}{%- assign nxhex = "#a8322a" -%}{% when "rose" %}{%- assign nxhex = "#b9577a" -%}{% else %}{%- assign nxhex = "#6b5d4f" -%}{% endcase %}{%- capture nxd -%}{{ y.date }}{%- endcapture -%}<section class="hero"><div class="w"><div class="intro"><p class="kick">A parish on the green in Wyndleford</p><h1>A church that keeps time by the <em>church year</em></h1><p>Three services every Sunday, a food pantry on Thursdays, and a website that changes color with the seasons. This is this week's bulletin.</p></div><div class="spread"><div class="leaf cover" style="background:{{ nxhex }}"><span class="arch"></span><p class="kick">This Sunday · {{ nxd | date: "%A %-d %B" }}</p><h2>{{ y.sunday }}</h2><p class="date">{% capture lv1 -%}{{ y.season }}{%- endcapture %}{% case lv1 %}{% when "advent" %}Advent{% when "christmas" %}Christmas{% when "epiphany" %}Epiphany{% when "lent" %}Lent{% when "holyweek" %}Holy Week{% when "easter" %}Easter{% when "pentecost" %}Pentecost{% when "ordinary" %}Season after Pentecost{% else %}{{ lv1 }}{% endcase %} · {% capture lv2 -%}{{ y.color }}{%- endcapture %}{% case lv2 %}{% when "blue" %}Blue{% when "violet" %}Violet{% when "white" %}White and gold{% when "green" %}Green{% when "red" %}Red{% when "rose" %}Rose{% else %}{{ lv2 }}{% endcase %}</p><div class="svc"><div><b>8:00</b><span>Said Eucharist, in the Lady Chapel</span></div><div><b>10:30</b><span>Sung Eucharist with the choir, Sunday school and nursery</span></div><div><b>17:00</b><span>{%- capture _c0 -%}{{ y.season }}{%- endcapture -%}{% if _c0 == "advent" %}Advent Lessons and Carols{% else %}Evensong{% endif %}</span></div></div></div><div class="leaf ord"><h3>The readings</h3><ol>{%- assign rs = y.readings | split: "|" -%}{% for r in rs %}{%- assign rp = r | split: "~" -%}<li><span>{{ rp[1] }}</span><b>{{ rp[0] }}</b></li>{% endfor %}</ol><h3>Hymns</h3><ol>{%- assign hs = y.hymns | split: "|" -%}{% for h in hs %}{%- assign hp = h | split: "~" -%}<li class="hy"><em>{{ hp[0] }}</em><b>{{ hp[1] }}</b><i>{{ hp[2] }}</i></li>{% endfor %}</ol>{%- capture pn -%}{{ y.preacher }}{%- endcapture -%}{% for p in PP.Items %}{%- capture ppf -%}{{ p.PrimaryField }}{%- endcapture -%}{% if ppf == pn %}<a class="preach" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ini">{{ p.PublishedContent.initials }}</span><span><span class="kick" style="margin:0">Preaching</span><b style="display:block;font:500 1.15rem var(--serif)">{{ p.PrimaryField }}</b><small class="muted">{{ p.PublishedContent.role }}</small></span></a>{% endif %}{% endfor %}<p style="margin:16px 0 0;font-size:.95rem">Sermon: <a href="{{ PathBase }}/{{ nx.RoutePath }}" style="font:italic 500 1.1rem var(--serif);color:var(--acc)">{{ nx.PrimaryField }}</a></p></div></div></div></section><section class="sec" style="padding-top:20px"><div class="w"><div class="sechead"><div><p class="kick">This week in the parish</p><h2>{{ tdate }} and the six days after</h2></div><a href="{{ PathBase }}/calendar">The whole calendar →</a></div>{%- assign EVS = get_content_items(ContentType="events", OrderBy="date asc", PageSize=200) -%}<div class="week">{% for i in (0..6) %}{%- assign de = i | times: 86400 | plus: nows -%}{%- assign ds = de | date: "%Y-%m-%d" -%}{%- assign dw = de | date: "%w" | plus: 0 -%}<div class="day{% if i == 0 %} today{% endif %}{% if dw == 0 %} sun{% endif %}"><div class="dn"><b>{{ de | date: "%-d" }}</b><span>{% if i == 0 %}Today{% else %}{{ de | date: "%a" }}{% endif %}</span></div>{% if dw == 0 %}<a class="ev" href="{{ PathBase }}/sundays"><small>8:00 · 10:30 · 17:00</small>Sunday services</a>{% endif %}{% if dw == 3 %}<a class="ev" href="{{ PathBase }}/ministries/worship-and-the-altar-guild"><small>07:00</small>Wednesday Eucharist</a>{% endif %}{% for e in EVS.Items %}{%- capture edt -%}{{ e.PublishedContent.date }}{%- endcapture -%}{% if edt == ds %}{%- capture et -%}{{ e.PrimaryField }}{%- endcapture -%}{% unless et == "Wednesday Eucharist" %}{%- capture eau -%}{{ e.PublishedContent.audience }}{%- endcapture -%}<a class="ev{% if eau == "members" %} mem{% endif %}" href="{{ PathBase }}/{{ e.RoutePath }}"><small>{{ e.PublishedContent.time }}{% if eau == "members" %} · 🔒 members{% endif %}</small>{{ e.PrimaryField }}</a>{% endunless %}{% endif %}{% endfor %}</div>{% endfor %}</div></div></section><section class="sec alt"><div class="w"><div class="sechead"><div><p class="kick">Ministries</p><h2>Eight ways in</h2></div><a href="{{ PathBase }}/ministries">All ministries →</a></div><div class="windows">{%- assign MS = get_content_items(ContentType="ministries", OrderBy="sort_order asc", PageSize=8) -%}{% for m in MS.Items %}<a class="win" href="{{ PathBase }}/{{ m.RoutePath }}"><span class="glass">{{ m.PublishedContent.glyph }}</span><b>{{ m.PrimaryField }}</b><p>{{ m.PublishedContent.summary }}</p><small>{{ m.PublishedContent.meets | split: ";" | first }}</small></a>{% endfor %}</div></div></section><section class="sec"><div class="w"><div class="grid2"><div><div class="sechead"><div><p class="kick">Sundays</p><h2>Recent sermons</h2></div><a href="{{ PathBase }}/sundays">Every Sunday →</a></div>{%- assign SD = get_content_items(ContentType="sermons", OrderBy="date desc", PageSize=40) -%}{%- assign k = 0 -%}{% for s in SD.Items %}{%- capture _dsd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- assign sd = _dsd | remove: "-" | plus: 0 -%}{% if sd < todayn and k < 4 %}{%- assign k = k | plus: 1 -%}{%- capture srd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- capture shx_k -%}{{ s.PublishedContent.color }}{%- endcapture -%}{% case shx_k %}{% when "blue" %}{%- assign shx = "#34417c" -%}{% when "violet" %}{%- assign shx = "#5b2e63" -%}{% when "white" %}{%- assign shx = "#a87b1f" -%}{% when "green" %}{%- assign shx = "#3c6a49" -%}{% when "red" %}{%- assign shx = "#a8322a" -%}{% when "rose" %}{%- assign shx = "#b9577a" -%}{% else %}{%- assign shx = "#6b5d4f" -%}{% endcase %}<a class="srow" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="d"><span class="dot" style="background:{{ shx }}"></span>{{ srd | date: "%b %Y" | upcase }}<strong>{{ srd | date: "%-d %B" }}</strong></span><span><small>{{ s.PublishedContent.sunday }}</small><b>{{ s.PrimaryField }}</b></span><span class="who">{{ s.PublishedContent.preacher }}</span><span class="len">{%- capture _c1 -%}{{ s.PublishedContent.series }}{%- endcapture -%}{% if _c1 != "" %}{{ s.PublishedContent.series }}<br>{% endif %}{{ s.PublishedContent.minutes }} min</span></a>{% endif %}{% endfor %}</div><aside><div class="card" style="padding:26px"><p class="kick">The church year</p><h3 style="font-size:1.6rem">{{ cname }}</h3><p class="muted" style="margin:0 0 14px">{{ cur.PublishedContent.summary }}</p>{%- assign din = ys | minus: nows | divided_by: 86400 -%}{% if din > 0 %}<p style="margin:0 0 14px"><b>Advent begins {% if din == 1 %}tomorrow{% else %}in {{ din }} days{% endif %}.</b> The site, like the altar, turns blue.</p>{% endif %}<a class="btn" href="{{ PathBase }}/year">See the whole year</a></div></aside></div></div></section><section class="sec" style="padding-top:0"><div class="w"><div class="band"><div><p class="kick">For members</p><h2>The directory, the prayer list and the rota</h2><p>Members sign in to find each other, to see who is reading or making coffee on Sunday, to ask for a swap, and to pray for one another by name. Checked on the server, so signed-out visitors see only what the parish reads aloud on Sunday.</p><p class="cta">{% if in_m %}<a class="btn light" href="{{ PathBase }}/members">Go to members</a>{% else %}<a class="btn light" href="{{ PathBase }}/account/login?returnUrl=/members">Member sign-in</a><a class="btn line" style="color:#fff;border-color:#6b645a" href="{{ PathBase }}/members">What is in there</a>{% endif %}</p></div><div>{%- assign PRQ = get_content_items(ContentType="prayers", OrderBy="date desc", PageSize=40) -%}{%- assign pk = 0 -%}{% for p in PRQ.Items %}{%- capture pau -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{% if pk < 7 %}{%- assign pk = pk | plus: 1 -%}<div class="lockrow"><span class="tg">{% if pau == "public" %}Read aloud{% elsif pau == "members" %}{% if in_m %}Members{% else %}🔒 members{% endif %}{% else %}🔒 clergy{% endif %}</span><span>{% if pau == "public" %}{{ p.PrimaryField }}{% elsif pau == "members" and in_m %}{{ p.PrimaryField }}{% elsif pau == "clergy" and in_c %}{{ p.PrimaryField }}{% else %}<span style="color:#9d9486">A request shared with {% if pau == "members" %}members{% else %}the clergy{% endif %}</span>{% endif %}</span></div>{% endif %}{% endfor %}</div></div></div></section><section class="sec alt"><div class="w"><div class="sechead"><div><p class="kick">Clergy and staff</p><h2>Who you will meet at the door</h2></div><a href="{{ PathBase }}/people">Everyone →</a></div><div class="people">{% for p in PP.Items %}{% if forloop.index <= 3 %}<a class="card person" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="hd"><span class="ini">{{ p.PublishedContent.initials }}</span><span><b>{{ p.PrimaryField }}</b><span class="muted" style="display:block;font-size:.9rem">{{ p.PublishedContent.role }}</span></span></span><span style="font-size:.95rem">{{ p.PublishedContent.summary }}</span><span class="kick" style="margin:auto 0 0;font-size:.68rem">{{ p.PublishedContent.office_hours }}</span></a>{% endif %}{% endfor %}</div></div></section><section class="sec"><div class="w"><div class="two"><div><p class="kick">Plan a visit</p><h2>First time? Come at 10:30.</h2><p class="muted">The 10:30 has the choir, Sunday school and a staffed nursery, and the coffee afterwards is the best way to meet people. Nobody will ask you to stand up or say anything. There is step-free access from the green.</p><p class="cta"><a class="btn" href="{{ PathBase }}/visit">What to expect</a><a class="btn line" href="{{ PathBase }}/sundays">This Sunday's readings</a></p></div><div class="card" style="padding:0;overflow:hidden"><svg class="plan" viewBox="0 0 560 330" role="img" aria-label="Site plan of the church, parish hall and green"><rect x="0" y="0" width="560" height="330" fill="#eef1e6"/><path d="M0 310 H560" stroke="#d8cfbd" stroke-width="40"/><text x="16" y="315" class="sm">CHURCH GREEN · BUS 4 STOPS HERE</text><rect x="40" y="40" width="250" height="110" rx="4" fill="var(--card)" stroke="var(--ink)" stroke-width="1.4"/><path d="M290 60 h40 a35 35 0 0 1 0 70 h-40" fill="var(--card)" stroke="var(--ink)" stroke-width="1.4"/><rect x="14" y="70" width="26" height="50" fill="var(--acc)"/><text x="90" y="92">The church</text><text x="90" y="110" class="sm">NAVE · 280 SEATS</text><text x="296" y="100" class="sm">ALTAR</text><rect x="150" y="150" width="118" height="56" fill="var(--card)" stroke="var(--ink)" stroke-width="1.4"/><text x="160" y="174" style="font-size:12px">Lady Chapel</text><text x="160" y="192" class="sm">8:00 · WED 7:00</text><rect x="380" y="30" width="150" height="150" rx="4" fill="var(--card)" stroke="var(--ink)" stroke-width="1.4"/><text x="396" y="60">Parish hall</text><text x="396" y="78" class="sm">PANTRY · COFFEE</text><path d="M380 120 h150" stroke="var(--line2)"/><text x="396" y="144" style="font-size:12px">Lantern Room</text><text x="396" y="162" class="sm">SUNDAY SCHOOL</text><path d="M365 105 h15" stroke="var(--ink)" stroke-dasharray="3 3"/><rect x="120" y="226" width="170" height="40" fill="none" stroke="#9caf8f" stroke-dasharray="4 4"/><text x="130" y="250" class="sm">CHURCHYARD AND GARDEN</text><path d="M455 290 V180" stroke="var(--acc)" stroke-width="3" stroke-dasharray="1 7" stroke-linecap="round"/><circle cx="455" cy="290" r="7" fill="var(--acc)"/><text x="468" y="262" class="sm">STEP-FREE</text><text x="468" y="276" class="sm">ENTRANCE</text><path d="M100 290 V150" stroke="var(--ink)" stroke-width="2"/><circle cx="100" cy="290" r="5" fill="var(--ink)"/><text x="110" y="286" class="sm">WEST DOOR</text></svg></div></div></div></section>
