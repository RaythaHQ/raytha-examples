<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Wyndleford Parish Church" %}{{ Target.Title }} | {% endif %}Wyndleford Parish Church</title>
{%- capture mau -%}{{ Target.PublishedContent.audience }}{%- endcapture -%}<meta name="description" content="{% if mau == "members" or mau == "clergy" %}Page for members of Wyndleford Parish Church (fictional). Sign in to read.{% elsif Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Wyndleford Parish Church (fictional) is a parish in Wyndleford that follows the church year: Sundays with readings, hymns and sermons, a calendar, ministries, small groups and members-only directory, prayer list and volunteer rota. Built on Raytha, a self-hosted, open-source .NET CMS for church websites.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Public+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"><style>:root{--paper:#f6f2ea;--card:#fffdf8;--ink:#221d18;--ink2:#5b5248;--line:#e2d9ca;--line2:#cfc3b0;--gold:#a87b1f;--stone:#26231f;--acc:#3c6a49;--tint:#e3ece2;
--serif:"EB Garamond",Georgia,serif;--sans:"Public Sans",system-ui,sans-serif;--mono:"DM Mono",ui-monospace,monospace}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.62 var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit}img{max-width:100%}
.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:9}
.w{max-width:1200px;margin:0 auto;padding:0 32px}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.12;letter-spacing:-.005em;margin:0 0 .4em}
h1{font-size:clamp(2.4rem,4.6vw,3.7rem)}h2{font-size:clamp(1.7rem,2.6vw,2.25rem)}h3{font-size:1.35rem}
em{font-style:italic;color:var(--acc)}
.kick{font:500 .74rem/1.4 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin:0 0 10px}
.muted{color:var(--ink2)}.mono{font-family:var(--mono)}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--acc);color:#fff;border:1px solid var(--acc);padding:11px 20px;border-radius:999px;font:600 .95rem var(--sans);text-decoration:none;cursor:pointer}
.btn.line{background:transparent;color:var(--ink);border-color:var(--line2)}.btn.light{background:#fff;color:var(--acc);border-color:#fff}
.cta{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0 0}
/* header */
.ribbon{display:flex;height:16px;position:relative;background:var(--stone)}
.ribbon a{display:block;position:relative;opacity:.92;border-right:1px solid rgba(255,255,255,.35);text-decoration:none;overflow:hidden}
.ribbon a span{position:absolute;left:6px;top:1px;font:500 9.5px/14px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.88);white-space:nowrap}
.ribbon a.on{opacity:1;box-shadow:inset 0 -3px 0 rgba(255,255,255,.75)}
.ribbon .now{position:absolute;top:-2px;width:3px;height:22px;background:var(--ink);border:1px solid #fff;border-radius:2px;z-index:2}
.notice{background:var(--tint);border-bottom:1px solid var(--line);font-size:.86rem}
.notice .w{display:flex;justify-content:space-between;gap:20px;padding-top:8px;padding-bottom:8px;flex-wrap:wrap}
.notice b{color:var(--acc)}.notice .times{color:var(--ink2);font-family:var(--mono);font-size:.78rem;padding-top:2px}
.mast{background:var(--card);border-bottom:1px solid var(--line)}
.mast>.w{display:flex;align-items:center;justify-content:space-between;padding-top:20px;padding-bottom:16px}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none}
.brand b{display:block;font:500 1.75rem/1 var(--serif);letter-spacing:.01em}
.brand small{display:block;font:italic 400 1rem/1.4 var(--serif);color:var(--ink2);margin-top:4px}
.acct{display:flex;gap:18px;align-items:center;font-size:.92rem}.acct a{text-decoration:none;color:var(--ink2)}.acct a:hover{color:var(--acc)}
.acct .srch{border:1px solid var(--line2);border-radius:999px;padding:6px 14px}
.nav{border-top:1px solid var(--line)}.nav ul{list-style:none;margin:0;padding:0;display:flex;gap:4px;flex-wrap:wrap}
.nav a{display:block;padding:12px 14px;text-decoration:none;font-weight:500;font-size:.96rem;border-bottom:3px solid transparent}
.nav a:hover{border-bottom-color:var(--acc);color:var(--acc)}
.nav li:first-child a{padding-left:0}
/* page heads */
.phead{padding:54px 0 40px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,var(--tint),var(--paper))}
.phead .lede{font-size:1.18rem;max-width:760px;color:var(--ink2);margin:0}
.crumbs{list-style:none;padding:0;margin:0 0 18px;display:flex;gap:8px;font-size:.86rem;color:var(--ink2);flex-wrap:wrap}
.crumbs li+li:before{content:"/";margin-right:8px;opacity:.5}.crumbs a{text-decoration:none}
.sec{padding:72px 0}.sec.tight{padding:44px 0}.sec.alt{background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.sechead{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:24px}.sechead h2{margin:0}
.sechead>a{font-weight:600;text-decoration:none;color:var(--acc)}
.card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:22px}
.tg{display:inline-block;font:500 .7rem/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:5px 8px;border-radius:4px;background:var(--tint);color:var(--acc);vertical-align:middle}
.tg.lock{background:#efe7da;color:#7a5b2a}
.dot{display:inline-block;width:11px;height:11px;border-radius:50%;vertical-align:baseline;margin-right:6px;border:1px solid rgba(0,0,0,.15)}
/* bulletin spread */
.hero{padding:46px 0 64px;background:radial-gradient(120% 90% at 50% 0,var(--tint),var(--paper) 70%)}
.hero .intro{text-align:center;max-width:820px;margin:0 auto 34px}.hero .intro h1{margin-bottom:12px}.hero .intro p{font-size:1.15rem;color:var(--ink2);margin:0}
.spread{display:grid;grid-template-columns:1fr 1fr;background:var(--card);border:1px solid var(--line2);border-radius:4px;box-shadow:0 30px 60px -30px rgba(40,30,20,.35),0 2px 0 rgba(0,0,0,.03);position:relative;overflow:hidden}
.spread:after{content:"";position:absolute;left:50%;top:0;bottom:0;width:40px;margin-left:-20px;background:linear-gradient(90deg,transparent,rgba(60,40,20,.12) 48%,rgba(255,255,255,.4) 52%,transparent);pointer-events:none}
.leaf{padding:40px 46px 42px}
.leaf.cover{background:var(--acc);color:#fff;position:relative}
.leaf.cover .kick{color:rgba(255,255,255,.8)}
.leaf.cover h2{font-size:clamp(2.1rem,3.6vw,3rem);font-style:italic;color:#fff;margin:4px 0 8px}
.leaf.cover .date{font:400 1.25rem var(--serif);opacity:.9}
.leaf.cover .arch{position:absolute;right:34px;bottom:0;width:150px;height:210px;border:1.5px solid rgba(255,255,255,.35);border-bottom:0;border-radius:75px 75px 0 0}
.leaf.cover .arch:before{content:"";position:absolute;inset:14px 14px 0;border:1.5px solid rgba(255,255,255,.22);border-bottom:0;border-radius:61px 61px 0 0}
.svc{margin:30px 0 0;display:grid;gap:12px;max-width:330px}
.svc div{display:flex;gap:14px;align-items:baseline;border-top:1px solid rgba(255,255,255,.25);padding-top:10px}
.svc b{font:500 1.05rem var(--mono);min-width:58px}.svc span{opacity:.92}
.ord h3{font-size:1rem;font-family:var(--mono);font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin:0 0 12px}
.ord ol{list-style:none;margin:0 0 24px;padding:0}
.ord li{display:grid;grid-template-columns:120px 1fr;gap:12px;padding:8px 0;border-bottom:1px dotted var(--line2)}
.ord li span{font:500 .72rem/1.9 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.ord li b{font:500 1.12rem/1.4 var(--serif)}
.ord li.hy{grid-template-columns:56px 1fr auto}.ord li.hy em{font:500 1rem var(--mono);color:var(--acc);font-style:normal}
.ord li.hy i{font-style:normal;font-size:.8rem;color:var(--ink2)}
.preach{display:flex;gap:14px;align-items:center;background:var(--tint);border-radius:6px;padding:14px 16px;text-decoration:none}
.ini{flex:none;width:46px;height:46px;border-radius:50%;background:var(--acc);color:#fff;display:grid;place-items:center;font:500 1.05rem var(--serif);letter-spacing:.04em}
.ini.big{width:76px;height:76px;font-size:1.6rem}
/* week strip */
.week{display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--card)}
.day{border-right:1px solid var(--line);min-height:210px;padding:14px 12px}.day:last-child{border-right:0}
.day.today{background:var(--tint)}.day.sun{background:linear-gradient(180deg,var(--tint),var(--card) 60%)}
.day .dn{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:10px}
.day .dn b{font:500 1.9rem/1 var(--serif)}.day .dn span{font:500 .7rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
.ev{display:block;text-decoration:none;padding:7px 8px;border-left:3px solid var(--acc);background:var(--paper);border-radius:0 4px 4px 0;margin-bottom:7px;font-size:.84rem;line-height:1.3}
.ev small{display:block;font:500 .7rem var(--mono);color:var(--ink2);margin-bottom:2px}
.ev.mem{border-left-color:#a98a4f}
/* windows (ministries) */
.windows{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.win{display:flex;flex-direction:column;text-decoration:none;background:var(--card);border:1px solid var(--line);border-radius:120px 120px 6px 6px;padding:0 0 20px;overflow:hidden;transition:transform .15s}
.win:hover{transform:translateY(-3px)}
.win .glass{height:120px;display:grid;place-items:center;font-size:2.6rem;color:#fff;background:conic-gradient(from 200deg at 50% 100%,var(--acc),color-mix(in srgb,var(--acc) 60%,#fff),var(--acc),color-mix(in srgb,var(--acc) 70%,#000),var(--acc));border-bottom:6px solid var(--paper);border-radius:120px 120px 0 0;margin:10px 10px 0}
.win b{font:500 1.3rem/1.2 var(--serif);padding:16px 20px 4px}.win p{margin:0;padding:0 20px;font-size:.92rem;color:var(--ink2)}
.win small{padding:12px 20px 0;margin-top:auto;font:500 .72rem var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--acc)}
/* sermons */
.srow{display:grid;grid-template-columns:140px 1fr 210px 120px;gap:20px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line);text-decoration:none}
.srow:hover b{color:var(--acc)}
.srow .d{font:500 .8rem var(--mono);color:var(--ink2)}.srow .d strong{display:block;font:500 1.5rem/1.1 var(--serif);color:var(--ink)}
.srow b{font:500 1.3rem/1.25 var(--serif);display:block}.srow small{color:var(--ink2);font-size:.88rem}
.srow .who{font-size:.9rem}.srow .len{font:500 .78rem var(--mono);color:var(--ink2);text-align:right}
.sgroup{margin:40px 0 6px;display:flex;align-items:center;gap:12px}.sgroup h2{margin:0;font-size:1.6rem}
.sgroup i{flex:1;height:1px;background:var(--line2)}
.cband{height:10px;border-radius:5px;margin:0 0 6px}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 22px}
.filters a{padding:7px 14px;border:1px solid var(--line2);border-radius:999px;text-decoration:none;font-size:.88rem;background:var(--card)}
.filters a.on{background:var(--acc);border-color:var(--acc);color:#fff}
.grid2{display:grid;grid-template-columns:1.6fr 1fr;gap:48px;align-items:start}
.two{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.prose{font-size:1.08rem}.prose p{margin:0 0 1em}.prose h2{margin-top:1.4em}
.sermon{font:400 1.32rem/1.62 var(--serif)}.sermon p:first-child:first-letter{float:left;font-size:4.2rem;line-height:.85;padding:6px 10px 0 0;color:var(--acc)}
.side{display:grid;gap:18px;position:sticky;top:18px}
.facts{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:6px;background:var(--card);margin:0 0 30px}
.facts div{padding:14px 16px;border-right:1px solid var(--line)}.facts div:last-child{border-right:0}
.facts span{display:block;font:500 .68rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}.facts b{font:500 1.15rem var(--serif)}
.pn{display:flex;justify-content:space-between;gap:16px;margin-top:36px;border-top:1px solid var(--line);padding-top:18px}
.pn a{text-decoration:none;max-width:48%}.pn small{display:block;font:500 .7rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}.pn b{font:500 1.1rem var(--serif)}
/* wheel */
.wheelg{display:grid;grid-template-columns:600px 1fr;gap:50px;align-items:center}
.wheel{width:100%;height:auto}.wheel text{font-family:var(--mono)}
.wheel .lab{font-size:13px;letter-spacing:.12em;text-transform:uppercase;fill:var(--ink2)}
.wheel .c1{font:500 13px var(--mono);letter-spacing:.14em;fill:var(--ink2)}.wheel .c2{font:500 44px var(--serif);font-family:var(--serif);fill:var(--acc)}.wheel .c3{font:italic 20px var(--serif);font-family:var(--serif);fill:var(--ink2)}
.wheel a circle{transition:stroke-width .2s}.wheel a:hover circle{stroke-width:78px}
.seasons{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.scard{display:grid;grid-template-columns:10px 1fr;gap:18px;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:20px 22px 20px 0;overflow:hidden;text-decoration:none}
.scard.on{outline:2px solid var(--acc)}
.scard .bar{border-radius:0 4px 4px 0}
.scard b{font:500 1.45rem var(--serif)}.scard small{display:block;font:500 .74rem var(--mono);color:var(--ink2);letter-spacing:.04em;margin:2px 0 8px}
.scard p{margin:0;font-size:.94rem;color:var(--ink2)}
.practices{list-style:none;padding:0;margin:0}.practices li{padding:10px 0 10px 28px;border-bottom:1px solid var(--line);position:relative}
.practices li:before{content:"";position:absolute;left:4px;top:18px;width:10px;height:10px;border-radius:50%;background:var(--acc)}
/* calendar */
.month{display:grid;grid-template-columns:repeat(7,1fr);border-left:1px solid var(--line);border-top:1px solid var(--line);background:var(--card)}
.month .hd{font:500 .72rem var(--mono);letter-spacing:.12em;text-transform:uppercase;padding:10px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper);color:var(--ink2)}
.cell{min-height:128px;padding:8px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.cell.out{background:repeating-linear-gradient(135deg,var(--paper),var(--paper) 6px,#f1ebe0 6px,#f1ebe0 12px)}.cell.out .n{opacity:.4}
.cell .n{font:500 1.1rem var(--serif);display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.cell.today{box-shadow:inset 0 0 0 2px var(--acc)}.cell.today .n b{background:var(--acc);color:#fff;border-radius:50%;width:28px;height:28px;display:grid;place-items:center}
.cell .sw{width:9px;height:9px;border-radius:50%}
.cell .ev{font-size:.76rem;padding:4px 6px;margin-bottom:4px}
.mnav{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.mnav h2{margin:0}.mnav a{text-decoration:none;font-weight:600;color:var(--acc)}
.agenda a{display:grid;grid-template-columns:150px 1fr auto;gap:18px;padding:14px 0;border-bottom:1px solid var(--line);text-decoration:none;align-items:baseline}
.agenda .when{font:500 .8rem var(--mono);color:var(--ink2)}.agenda b{font:500 1.18rem var(--serif)}
/* people, groups, directory */
.people{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.person{display:flex;flex-direction:column;gap:12px;text-decoration:none}
.person .hd{display:flex;gap:14px;align-items:center}.person b{font:500 1.25rem var(--serif)}
.groups{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.gcard{display:flex;flex-direction:column;gap:8px;text-decoration:none}
.gcard .when{display:flex;justify-content:space-between;font:500 .76rem var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--acc)}
.gcard b{font:500 1.3rem/1.2 var(--serif)}.gcard p{margin:0;font-size:.93rem;color:var(--ink2)}
.host{margin-top:auto;padding-top:10px;border-top:1px dashed var(--line2);font-size:.86rem}
.host.locked{color:#7a5b2a}
.dir{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.hh{display:grid;grid-template-columns:52px 1fr;gap:16px;text-decoration:none}
.hh b{font:500 1.2rem var(--serif)}.hh .meta{font:500 .76rem var(--mono);color:var(--ink2);margin-top:6px}
/* prayer */
.plist{columns:2;column-gap:28px}
.pr{break-inside:avoid;margin:0 0 18px;padding:18px 20px;background:var(--card);border:1px solid var(--line);border-top:3px solid var(--acc);border-radius:4px}
.pr.m{border-top-color:#a98a4f}.pr.c{border-top-color:var(--stone)}
.pr b{font:500 1.22rem var(--serif);display:block;margin:6px 0 4px}.pr p{margin:0;font-size:.95rem}.pr small{display:block;margin-top:10px;font:500 .72rem var(--mono);color:var(--ink2)}
/* rota */
.rota{width:100%;border-collapse:collapse;background:var(--card);font-size:.9rem}
.rota th,.rota td{border:1px solid var(--line);padding:10px 10px;text-align:left;vertical-align:top}
.rota th{font:500 .7rem var(--mono);letter-spacing:.1em;text-transform:uppercase;background:var(--paper);color:var(--ink2)}
.rota td.sun{font:500 1rem var(--serif);white-space:nowrap}.rota td.sun small{display:block;font:500 .7rem var(--mono);color:var(--ink2)}
.rota td.swap{background:#fbf0d9}.rota td.mine{box-shadow:inset 0 0 0 2px var(--acc)}
.rota td i{display:block;font-style:normal;font-size:.75rem;color:#7a5b2a;margin-top:4px}
/* lock + members */
.lockp{background:var(--stone);color:#f3ede2;border-radius:8px;padding:38px 40px}.lockp .kick{color:#e0c88f}.lockp h2{color:#fff}.lockp .muted{color:#c9c0b2}
.lockp .btn.line{color:#fff;border-color:#6b645a}
.band{background:var(--stone);color:#efe8dc;border-radius:8px;padding:44px;display:grid;grid-template-columns:1fr 1fr;gap:40px}
.band h2{color:#fff}.band .kick{color:#e0c88f}.band p{color:#cfc6b8}
.lockrow{display:flex;gap:12px;align-items:center;padding:11px 0;border-bottom:1px solid #3d3933;font-size:.95rem}
.lockrow .tg{background:#3d3933;color:#e0c88f}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.tile{display:block;text-decoration:none}.tile b{font:500 1.5rem var(--serif);display:block}.tile .big{font:500 2.6rem/1 var(--serif);color:var(--acc)}
.hit{display:block;padding:16px 0;border-bottom:1px solid var(--line);text-decoration:none}.hit b{font:500 1.2rem var(--serif)}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.95rem}
.grp{font-size:1.3rem;margin:34px 0 8px}
.searchbar{display:flex;gap:10px;margin-top:22px;max-width:640px}.searchbar input{flex:1}
input{font:inherit;padding:12px 14px;border:1px solid var(--line2);border-radius:6px;background:#fff;width:100%}
label{display:block;font-weight:600;margin-bottom:6px;font-size:.92rem}
.alert{background:#fbe9e6;border:1px solid #e6b9b0;padding:12px;border-radius:6px;margin-bottom:16px}
/* visit: site plan */
.plan{width:100%;height:auto;background:var(--card);border:1px solid var(--line);border-radius:6px}
.plan text{font-family:var(--sans);font-size:13px;fill:var(--ink)}.plan .sm{font-size:11px;fill:var(--ink2);font-family:var(--mono)}
.steps{counter-reset:s;list-style:none;padding:0;margin:0}.steps li{counter-increment:s;padding:14px 0 14px 54px;border-bottom:1px solid var(--line);position:relative}
.steps li:before{content:counter(s);position:absolute;left:0;top:14px;width:36px;height:36px;border-radius:50%;border:1.5px solid var(--acc);color:var(--acc);display:grid;place-items:center;font:500 1.1rem var(--serif)}
.steps b{font:500 1.15rem var(--serif);display:block}
/* footer */
.foot{background:var(--stone);color:#cfc6b8;padding:52px 0 30px;margin-top:40px;font-size:.92rem}
.foot a{color:#efe8dc;text-decoration:none}.fg{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}
.fname{font:500 1.5rem var(--serif);color:#fff;margin:0 0 8px}.fh{font:500 .72rem var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#e0c88f;margin:0 0 8px}
.fx{border-top:1px solid #3d3933;margin-top:30px;padding-top:18px;font-size:.82rem;color:#9d9486}
.grid2 .srow{grid-template-columns:118px 1fr 92px}.grid2 .srow .who{display:none}
@media (max-width:980px){.spread,.grid2,.two,.wheelg,.band,.fg{grid-template-columns:1fr}.spread:after{display:none}.windows{grid-template-columns:repeat(2,1fr)}
.week{grid-template-columns:1fr}.day{border-right:0;border-bottom:1px solid var(--line);min-height:0}.people,.groups,.tiles,.dir{grid-template-columns:1fr}.seasons{grid-template-columns:1fr}
.srow{grid-template-columns:90px 1fr}.srow .who,.srow .len{display:none}.plist{columns:1}.side{position:static}.facts{grid-template-columns:1fr 1fr}
.month .hd{display:none}.month{grid-template-columns:1fr}.cell.out{display:none}.cell{min-height:0}.agenda a{grid-template-columns:1fr}
.w{padding:0 18px}.mast>.w{flex-wrap:wrap;gap:10px}.acct{font-size:.85rem}.nav ul{flex-wrap:nowrap;overflow-x:auto}.nav a{white-space:nowrap;padding:10px 10px}
.notice .times{display:none}.mnav{flex-wrap:wrap;gap:6px 14px}.mnav h2{order:-1;width:100%}.leaf.cover .arch{display:none}.leaf{padding:28px 24px}.ribbon a span{display:none}.rota{font-size:.78rem}.brand b{font-size:1.4rem}.lockp,.band{padding:28px 22px}}
