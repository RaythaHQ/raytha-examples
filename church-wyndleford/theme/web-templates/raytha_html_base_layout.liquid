endif -%}{%- endfor -%}{%- endif -%}{%- capture thex -%}{{ Target.PublishedContent.hex }}{%- endcapture -%}{%- if thex != "" -%}{%- assign cur = Target -%}{%- assign preview = true -%}{%- endif -%}{%- assign ytot = ye | minus: ys | divided_by: 86400 | plus: 1 -%}{%- assign tday = nows | minus: ys | divided_by: 86400 -%}{%- capture acc -%}{{ cur.PublishedContent.hex }}{%- endcapture -%}{%- capture tint -%}{{ cur.PublishedContent.tint }}{%- endcapture -%}{%- capture cname -%}{{ cur.PublishedContent.name }}{%- endcapture -%}{%- capture ckey -%}{{ cur.PublishedContent.key }}{%- endcapture -%}<style>:root{--acc:{{ acc }};--tint:{{ tint }}}</style></head><body>
