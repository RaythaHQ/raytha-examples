<header class="top"><div class="ribbon" aria-label="The church year 2026 to 2027">{%- for s in SS.Items -%}{%- capture _nso -%}{{ s.PublishedContent.sort_order }}{%- endcapture -%}{%- assign so = _nso | plus: 0 -%}{%- if so >= 1 -%}{%- capture _ee1 -%}{{ s.PublishedContent.start }}{%- endcapture -%}{%- assign e1 = _ee1 | date: "%s" | plus: 0 -%}{%- capture _ee2 -%}{{ s.PublishedContent.end }}{%- endcapture -%}{%- assign e2 = _ee2 | date: "%s" | plus: 0 -%}{%- assign dd = e2 | minus: e1 | divided_by: 86400 | plus: 1 -%}{%- capture sk -%}{{ s.PublishedContent.key }}{%- endcapture -%}<a href="{{ PathBase }}/year?s={{ sk }}" class="{% if sk == ckey %}on{% endif %}" style="flex:{{ dd }} 1 0;background:{{ s.PublishedContent.hex }}" title="{{ s.PrimaryField }}: {{ dd }} days"><span>{{ s.PrimaryField }}</span></a>{%- endif -%}{%- endfor -%}{%- assign tp = tday | times: 1000 | divided_by: ytot -%}{% if tp < 0 %}{%- assign tp = 0 -%}{% endif %}<i class="now" style="left:calc({{ tp }}% / 10)" title="Today"></i></div>
<div class="notice"><div class="w"><span><b>{{ cname }}</b>{% if preview %} · previewing this season's colors · <a href="?">back to today</a>{% else %}{%- capture _ntseason -%}{{ today_season.PublishedContent.sort_order }}{%- endcapture -%}{%- assign tseason = _ntseason | plus: 0 -%}{% if tseason == 0 %} · {% assign din = ys | minus: nows | divided_by: 86400 -%} Advent and the new church year begin {% if din == 1 %}tomorrow{% elsif din <= 0 %}today{% else %}in {{ din }} days{% endif %}{% else %} · day {{ tday | plus: 1 }} of the church year{% endif %}{% endif %}</span><span class="times">Sundays 8:00 · 10:30 · 17:00 &nbsp;|&nbsp; 14 Church Green, Wyndleford</span></div></div>
