{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>Sundays</li></ol><p class="kick">Sundays · {{ Target.TotalCount }} services</p><h1>Every Sunday: readings, hymns and the sermon</h1><p class="lede">Each Sunday follows the Revised Common Lectionary, so the readings are the same as in thousands of other churches. The hymns, the preacher and the sermon are ours. Grouped by season, newest first.</p></div></div>{%- capture bq -%}{{ QueryParams.by | strip }}{%- endcapture -%}{%- capture rq -%}{{ QueryParams.series | strip }}{%- endcapture -%}<section class="sec tight"><div class="w"><div class="filters"><a href="?" class="{% if bq == "" and rq == "" %}on{% endif %}">All</a><a href="?by=The Rev. Miriam Achterberg" class="{% if bq == "The Rev. Miriam Achterberg" %}on{% endif %}">Miriam Achterberg</a><a href="?by=The Rev. Tobias Nwankwo-Hale" class="{% if bq == "The Rev. Tobias Nwankwo-Hale" %}on{% endif %}">Tobias Nwankwo-Hale</a><a href="?by=The Rev. Ruth Pellingham" class="{% if bq == "The Rev. Ruth Pellingham" %}on{% endif %}">Ruth Pellingham</a><a href="?series=Keep awake" class="{% if rq == "Keep awake" %}on{% endif %}">Series: Keep awake</a><a href="?series=The last parables" class="{% if rq == "The last parables" %}on{% endif %}">Series: The last parables</a><a href="?series=Letters and parables" class="{% if rq == "Letters and parables" %}on{% endif %}">Series: Letters and parables</a></div>{%- assign last = "" -%}{%- assign phase = "" -%}{% for s in Target.Items %}{%- assign y = s.PublishedContent -%}{%- capture yp -%}{{ y.preacher }}{%- endcapture -%}{%- capture yr -%}{{ y.series }}{%- endcapture -%}{%- capture _dsd -%}{{ y.date }}{%- endcapture -%}{%- assign sd = _dsd | remove: "-" | plus: 0 -%}{% if bq == "" or bq == yp %}{% if rq == "" or rq == yr %}{%- if sd >= todayn -%}{%- assign ph = "Coming Sundays" -%}{%- else -%}{%- assign ph = "Preached" -%}{%- endif -%}{% if ph != phase %}{%- assign phase = ph -%}{%- assign last = "" -%}<p class="kick" style="margin:34px 0 0;color:var(--ink2)">{{ ph }}</p>{% endif %}{%- capture ysk -%}{{ y.season }}{%- endcapture -%}{% if ysk != last %}{%- assign last = ysk -%}<div class="sgroup"><h2>{% capture lv7 -%}{{ y.season }}{%- endcapture %}{% case lv7 %}{% when "advent" %}Advent{% when "christmas" %}Christmas{% when "epiphany" %}Epiphany{% when "lent" %}Lent{% when "holyweek" %}Holy Week{% when "easter" %}Easter{% when "pentecost" %}Pentecost{% when "ordinary" %}Season after Pentecost{% else %}{{ lv7 }}{% endcase %}</h2><i></i></div>{% endif %}{%- capture srd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- capture shx_k -%}{{ s.PublishedContent.color }}{%- endcapture -%}{% case shx_k %}{% when "blue" %}{%- assign shx = "#34417c" -%}{% when "violet" %}{%- assign shx = "#5b2e63" -%}{% when "white" %}{%- assign shx = "#a87b1f" -%}{% when "green" %}{%- assign shx = "#3c6a49" -%}{% when "red" %}{%- assign shx = "#a8322a" -%}{% when "rose" %}{%- assign shx = "#b9577a" -%}{% else %}{%- assign shx = "#6b5d4f" -%}{% endcase %}<a class="srow" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="d"><span class="dot" style="background:{{ shx }}"></span>{{ srd | date: "%b %Y" | upcase }}<strong>{{ srd | date: "%-d %B" }}</strong></span><span><small>{{ s.PublishedContent.sunday }}</small><b>{{ s.PrimaryField }}</b></span><span class="who">{{ s.PublishedContent.preacher }}</span><span class="len">{%- capture _c10 -%}{{ s.PublishedContent.series }}{%- endcapture -%}{% if _c10 != "" %}{{ s.PublishedContent.series }}<br>{% endif %}{{ s.PublishedContent.minutes }} min</span></a>{% endif %}{% endif %}{% endfor %}</div></section>
