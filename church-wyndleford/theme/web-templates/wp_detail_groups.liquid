{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign y = Target.PublishedContent -%}{%- capture yo -%}{{ y.open }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/groups">Small groups</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv14 -%}{{ y.kind }}{%- endcapture %}{% case lv14 %}{% when "bible" %}Bible study{% when "prayer" %}Prayer{% when "parents" %}Parents{% when "young" %}Young adults{% when "seniors" %}Seniors{% when "books" %}Books{% when "service" %}Service{% else %}{{ lv14 }}{% endcase %} · {{ y.day }}s at {{ y.time }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="facts"><div><span>When</span><b>{{ y.day }}s, {{ y.time }}</b></div><div><span>Neighborhood</span><b>{{ y.area }}</b></div><div><span>Usual size</span><b>About {{ y.usual_size }}</b></div><div><span>Newcomers</span><b>{% if yo == "yes" %}Welcome{% else %}Full for now{% endif %}</b></div></div><div class="grid2"><div class="prose">{{ y.body }}<p>Part of <b>{{ y.ministry }}</b>. To join, talk to the host after a Sunday service or call the parish office on 555-0100. There is no sign-up form.</p></div><aside class="side">{% if in_m %}<div class="card"><p class="kick">Host and address · members</p><p style="font:500 1.3rem var(--serif);margin:0">{{ y.host }}</p><p class="muted" style="margin:4px 0 0">{{ y.address }}</p></div>{% else %}<div class="lockp" style="padding:26px"><p class="kick">🔒 Members only</p><p style="margin:0 0 14px">The host and the address are shown to signed-in members.</p><a class="btn light" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Member sign-in</a></div>{% endif %}</aside></div></div></section>
