 _c7 -%}{{ e.PublishedContent.ministry }}{%- endcapture -%}{% if _c7 != "" %} · {{ e.PublishedContent.ministry }}{% endif %}</span></span><span>{% if eau == "members" %}<span class="tg lock">🔒 Members</span>{% else %}<span class="tg">{% capture lv6 -%}{{ e.PublishedContent.kind }}{%- endcapture %}{% case lv6 %}{% when "worship" %}Worship{% when "music" %}Music{% when "children" %}Children{% when "youth" %}Youth{% when "care" %}Pastoral care{% when "outreach" %}Outreach{% when "study" %}Study{% when "fellowship" %}Fellowship{% when "buildings" %}Buildings and grounds{% else %}{{ lv6 }}{% endcase %}</span>{% endif %}</span></a>{% endif %}{% endfor %}</div>{% if k == 0 %}<p class="muted">Nothing on the calendar yet.</p>{% endif %}</div><aside class="side"><div class="card"><p class="kick">What we do</p><ul class="practices">{%- assign ps = y.practices | split: "|" -%}{% for p in ps %}<li>{{ p }}</li>{% endfor %}</ul></div><div class="card" style="background:var(--acc);color:#fff;border:0"><p class="kick" style="color:rgba(255,255,255,.8)">The color</p><p style="font:500 1.6rem var(--serif);margin:0">{% capture lv5 -%}{{ y.color }}{%- endcapture %}{% case lv5 %}{% when "blue" %}Blue{% when "violet" %}Violet{% when "white" %}White and gold{% when "green" %}Green{% when "red" %}Red{% when "rose" %}Rose{% else %}{{ lv5 }}{% endcase %}</p><p style="margin:6px 0 0;opacity:.85;font-size:.92rem">This page is shown in the season's colors. On the altar, the hangings, the stoles and the pulpit fall change on the first day of the season.</p></div><a class="btn line" href="{{ PathBase }}/year?s={{ yk }}">See it on the wheel</a></aside></div></div></section>
