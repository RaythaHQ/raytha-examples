{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign PP = get_content_items(ContentType="people", OrderBy="sort_order asc", PageSize=40) -%}{%- assign EVS = get_content_items(ContentType="events", OrderBy="date asc", PageSize=200) -%}{%- assign y = Target.PublishedContent -%}{%- capture me -%}{{ Target.PrimaryField }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/ministries">Ministries</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv12 -%}{{ y.kind }}{%- endcapture %}{% case lv12 %}{% when "worship" %}Worship{% when "music" %}Music{% when "children" %}Children{% when "youth" %}Youth{% when "care" %}Pastoral care{% when "outreach" %}Outreach{% when "study" %}Study{% when "fellowship" %}Fellowship{% when "buildings" %}Buildings and grounds{% else %}{{ lv12 }}{% endcase %} · {{ y.meets }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="grid2"><div><div class="facts"><div><span>Meets</span><b>{{ y.meets | split: ";" | first }}</b></div><div><span>Where</span><b>{{ y.room }}</b></div><div><span>Volunteers</span><b>{{ y.volunteers }}</b></div><div><span>Leader</span><b>{{ y.leader | replace: "The Rev. ", "" }}</b></div></div><div class="prose">{{ y.body }}</div>{%- assign GS = get_content_items(ContentType="groups", OrderBy="sort_order asc", PageSize=40) -%}{%- assign k = 0 -%}{% for g in GS.Items %}{%- capture gm -%}{{ g.PublishedContent.ministry }}{%- endcapture -%}{% if gm == me %}{%- assign k = k | plus: 1 -%}{% if k == 1 %}<h2 style="margin-top:34px">Small groups</h2>{% endif %}<a class="hit" href="{{ PathBase }}/{{ g.RoutePath }}"><b>{{ g.PrimaryField }}</b> <span class="tg">{{ g.PublishedContent.day }} {{ g.PublishedContent.time }}</span><p>{{ g.PublishedContent.summary }}</p></a>{% endif %}{% endfor %}<h2 style="margin-top:34px">Coming up</h2><div class="agenda">{%- assign k = 0 -%}{% for e in EVS.Items %}{%- capture em -%}{{ e.PublishedContent.ministry }}{%- endcapture -%}{%- capture _ded -%}{{ e.PublishedContent.date }}{%- endcapture -%}{%- assign ed = _ded | remove: "-" | plus: 0 -%}{% if em == me and ed >= todayn %}{%- assign k = k | plus: 1 -%}{%- capture eau -%}{{ e.PublishedContent.audience }}{%- endcapture -%}{%- capture edd -%}{{ e.PublishedContent.date }}{%- endcapture -%}<a href="{{ PathBase }}/{{ e.RoutePath }}"><span class="when">{{ edd | date: "%a %-d %b" | upcase }} · {{ e.PublishedContent.time }}</span><span><b>{{ e.PrimaryField }}</b><span class="muted" style="display:block;font-size:.9rem">{{ e.PublishedContent.room }}{%- capture _c13 -%}{{ e.PublishedContent.ministry }}{%- endcapture -%}{% if _c13 != "" %} · {{ e.PublishedContent.ministry }}{% endif %}</span></span><span>{% if eau == "members" %}<span class="tg lock">🔒 Members</span>{% else %}<span class="tg">{% capture lv6 -%}{{ e.PublishedContent.kind }}{%- endcapture %}{% case lv6 %}{% when "worship" %}Worship{% when "music" %}Music{% when "children" %}Children{% when "youth" %}Youth{% when "care" %}Pastoral care{% when "outreach" %}Outreach{% when "study" %}Study{% when "fellowship" %}Fellowship{% when "buildings" %}Buildings and grounds{% else %}{{ lv6 }}{% endcase %}</span>{% endif %}</span></a>{% endif %}{% endfor %}</div>{% if k == 0 %}<p class="muted">Nothing on the calendar for this ministry yet.</p>{% endif %}</div><aside class="side"><div class="win" style="pointer-events:none"><span class="glass" style="height:160px;font-size:3.4rem">{{ y.glyph }}</span><b>Talk to</b><p>{{ y.leader }}</p><small>{{ y.meets }}</small></div>{%- capture ln -%}{{ y.leader }}{%- endcapture -%}{% for p in PP.Items %}{%- capture ppf -%}{{ p.PrimaryField }}{%- endcapture -%}{% if ppf == ln %}<a class="card" style="text-decoration:none" href="{{ PathBase }}/{{ p.RoutePath }}"><p class="kick" style="margin:0">{{ p.PublishedContent.role }}</p><b style="font:500 1.2rem var(--serif)">{{ p.PrimaryField }}</b><p class="muted" style="margin:6px 0 0;font-size:.9rem">{{ p.PublishedContent.email }}<br>{{ p.PublishedContent.office_hours }}</p></a>{% endif %}{% endfor %}</aside></div></div></section>
