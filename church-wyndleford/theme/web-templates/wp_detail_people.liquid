{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign y = Target.PublishedContent -%}{%- capture me -%}{{ Target.PrimaryField }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/people">People</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ y.role }} · here since {{ y.since }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="grid2"><div><div class="sermon" style="font-size:1.25rem"><p>{{ y.bio }}</p></div>{%- assign SD = get_content_items(ContentType="sermons", OrderBy="date desc", PageSize=80) -%}{%- assign k = 0 -%}{% for s in SD.Items %}{%- capture sp -%}{{ s.PublishedContent.preacher }}{%- endcapture -%}{% if sp == me %}{%- assign k = k | plus: 1 -%}{% if k == 1 %}<h2 style="margin-top:30px">Sermons</h2>{% endif %}{%- capture srd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- capture shx_k -%}{{ s.PublishedContent.color }}{%- endcapture -%}{% case shx_k %}{% when "blue" %}{%- assign shx = "#34417c" -%}{% when "violet" %}{%- assign shx = "#5b2e63" -%}{% when "white" %}{%- assign shx = "#a87b1f" -%}{% when "green" %}{%- assign shx = "#3c6a49" -%}{% when "red" %}{%- assign shx = "#a8322a" -%}{% when "rose" %}{%- assign shx = "#b9577a" -%}{% else %}{%- assign shx = "#6b5d4f" -%}{% endcase %}<a class="srow" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="d"><span class="dot" style="background:{{ shx }}"></span>{{ srd | date: "%b %Y" | upcase }}<strong>{{ srd | date: "%-d %B" }}</strong></span><span><small>{{ s.PublishedContent.sunday }}</small><b>{{ s.PrimaryField }}</b></span><span class="who">{{ s.PublishedContent.preacher }}</span><span class="len">{%- capture _c14 -%}{{ s.PublishedContent.series }}{%- endcapture -%}{% if _c14 != "" %}{{ s.PublishedContent.series }}<br>{% endif %}{{ s.PublishedContent.minutes }} min</span></a>{% endif %}{% endfor %}{%- assign MS = get_content_items(ContentType="ministries", OrderBy="sort_order asc", PageSize=20) -%}{%- assign k = 0 -%}{% for m in MS.Items %}{%- capture ml -%}{{ m.PublishedContent.leader }}{%- endcapture -%}{% if ml == me %}{%- assign k = k | plus: 1 -%}{% if k == 1 %}<h2 style="margin-top:30px">Leads</h2>{% endif %}<a class="hit" href="{{ PathBase }}/{{ m.RoutePath }}"><b>{{ m.PrimaryField }}</b><p>{{ m.PublishedContent.summary }}</p></a>{% endif %}{% endfor %}</div><aside class="side"><div class="card" style="text-align:center;padding:30px"><span class="ini big" style="margin:0 auto 14px">{{ y.initials }}</span><b style="font:500 1.3rem var(--serif)">{{ Target.PrimaryField }}</b><p class="muted" style="margin:4px 0 16px">{{ y.role }}</p><p style="margin:0;font-size:.95rem"><span class="kick" style="display:block;margin:0 0 4px">Office hours</span>{{ y.office_hours }}</p><p style="margin:14px 0 0;font-family:var(--mono);font-size:.86rem">{{ y.email }}</p></div></aside></div></div></section>
