{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>Ministries</li></ol><p class="kick">Ministries · {{ Target.TotalCount }}</p><h1>Eight ways into parish life</h1><p class="lede">Worship, music, children, youth, a food pantry, pastoral care, study and the crew who look after the building. Each one says when it meets, where, and who to talk to.</p></div></div><section class="sec tight"><div class="w"><div class="windows">{% for m in Target.Items %}<a class="win" href="{{ PathBase }}/{{ m.RoutePath }}"><span class="glass">{{ m.PublishedContent.glyph }}</span><b>{{ m.PrimaryField }}</b><p>{{ m.PublishedContent.summary }}</p><small>{{ m.PublishedContent.meets | split: ";" | first }}</small></a>{% endfor %}</div><div class="card" style="margin-top:36px;display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap"><div><p class="kick" style="margin:0">Volunteers this year</p><p style="margin:0;font:500 1.4rem var(--serif)">{%- assign vt = 0 -%}{% for m in Target.Items %}{%- capture _nmv -%}{{ m.PublishedContent.volunteers }}{%- endcapture -%}{%- assign mv = _nmv | plus: 0 -%}{%- assign vt = vt | plus: mv -%}{% endfor %}{{ vt }} places filled by people in the parish, and no paid staff in most of them.</p></div><a class="btn" href="{{ PathBase }}/groups">Small groups</a></div></div></section>
