{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign SM = get_content_items(ContentType="sermons", OrderBy="date asc", PageSize=80) -%}{%- assign gotnx = false -%}{%- assign nx = SM.Items | first -%}{%- assign lastp = SM.Items | first -%}{%- for s in SM.Items -%}{%- capture _dsd -%}{{ s.PublishedContent.date }}{%- endcapture -%}{%- assign sd = _dsd | remove: "-" | plus: 0 -%}{%- if sd >= todayn and gotnx == false -%}{%- assign nx = s -%}{%- assign gotnx = true -%}{%- endif -%}{%- if sd < todayn -%}{%- assign lastp = s -%}{%- endif -%}{%- endfor -%}{%- assign PP = get_content_items(ContentType="people", OrderBy="sort_order asc", PageSize=40) -%}{%- assign y = Target.PublishedContent -%}{%- capture shx_k -%}{{ y.color }}{%- endcapture -%}{% case shx_k %}{% when "blue" %}{%- assign shx = "#34417c" -%}{% when "violet" %}{%- assign shx = "#5b2e63" -%}{% when "white" %}{%- assign shx = "#a87b1f" -%}{% when "green" %}{%- assign shx = "#3c6a49" -%}{% when "red" %}{%- assign shx = "#a8322a" -%}{% when "rose" %}{%- assign shx = "#b9577a" -%}{% else %}{%- assign shx = "#6b5d4f" -%}{% endcase %}{%- capture yd -%}{{ y.date }}{%- endcapture -%}{%- capture _dyn -%}{{ y.date }}{%- endcapture -%}{%- assign yn = _dyn | remove: "-" | plus: 0 -%}{%- capture me -%}{{ Target.Id }}{%- endcapture -%}<div style="--acc:{{ shx }}"><div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/sundays">Sundays</a></li><li>{{ y.sunday }}</li></ol><p class="kick">{{ y.sunday }} · {{ yd | date: "%A %-d %B %Y" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ y.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="facts"><div><span>Season</span><b><span class="dot" style="background:{{ shx }}"></span>{% capture lv8 -%}{{ y.season }}{%- endcapture %}{% case lv8 %}{% when "advent" %}Advent{% when "christmas" %}Christmas{% when "epiphany" %}Epiphany{% when "lent" %}Lent{% when "holyweek" %}Holy Week{% when "easter" %}Easter{% when "pentecost" %}Pentecost{% when "ordinary" %}Season after Pentecost{% else %}{{ lv8 }}{% endcase %}</b></div><div><span>Color</span><b>{% capture lv9 -%}{{ y.color }}{%- endcapture %}{% case lv9 %}{% when "blue" %}Blue{% when "violet" %}Violet{% when "white" %}White and gold{% when "green" %}Green{% when "red" %}Red{% when "rose" %}Rose{% else %}{{ lv9 }}{% endcase %}</b></div><div><span>Preacher</span><b>{{ y.preacher | replace: "The Rev. ", "" }}</b></div><div><span>{% if yn >= todayn %}Planned length{% else %}Sermon{% endif %}</span><b>{{ y.minutes }} minutes</b></div></div><div class="grid2"><div>{% if yn >= todayn %}<p class="kick">To be preached {{ yd | date: "%A %-d %B" }}</p>{% else %}<p class="kick">The sermon</p>{% endif %}<div class="sermon">{{ y.body }}</div>{%- assign prev = "" -%}{%- assign nextp = "" -%}{%- assign found = false -%}{% for s in SM.Items %}{%- capture sid -%}{{ s.Id }}{%- endcapture -%}{% if found and nextp == "" %}{%- assign nextp = s -%}{% endif %}{% if sid == me %}{%- assign found = true -%}{% endif %}{% unless found %}{%- assign prev = s -%}{% endunless %}{% endfor %}<div class="pn">{% if prev != "" %}<a href="{{ PathBase }}/{{ prev.RoutePath }}"><small>← {{ prev.PublishedContent.sunday }}</small><b>{{ prev.PrimaryField }}</b></a>{% else %}<span></span>{% endif %}{% if nextp != "" %}<a href="{{ PathBase }}/{{ nextp.RoutePath }}" style="text-align:right"><small>{{ nextp.PublishedContent.sunday }} →</small><b>{{ nextp.PrimaryField }}</b></a>{% endif %}</div></div><aside class="side"><div class="card ord"><h3>The readings</h3><ol>{%- assign rs = y.readings | split: "|" -%}{% for r in rs %}{%- assign rp = r | split: "~" -%}<li><span>{{ rp[1] }}</span><b>{{ rp[0] }}</b></li>{% endfor %}</ol><h3>Hymns</h3><ol>{%- assign hs = y.hymns | split: "|" -%}{% for h in hs %}{%- assign hp = h | split: "~" -%}<li class="hy"><em>{{ hp[0] }}</em><b>{{ hp[1] }}</b><i>{{ hp[2] }}</i></li>{% endfor %}</ol>{%- capture pn -%}{{ y.preacher }}{%- endcapture -%}{% for p in PP.Items %}{%- capture ppf -%}{{ p.PrimaryField }}{%- endcapture -%}{% if ppf == pn %}<a class="preach" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="ini">{{ p.PublishedContent.initials }}</span><span><span class="kick" style="margin:0">Preaching</span><b style="display:block;font:500 1.15rem var(--serif)">{{ p.PrimaryField }}</b><small class="muted">{{ p.PublishedContent.role }}</small></span></a>{% endif %}{% endfor %}</div>{%- capture _c11 -%}{{ y.series }}{%- endcapture -%}{% if _c11 != "" %}<a class="card" style="text-decoration:none" href="{{ PathBase }}/sundays?series={{ y.series }}"><p class="kick" style="margin:0">Series</p><b style="font:500 1.3rem var(--serif)">{{ y.series }}</b></a>{% endif %}</aside></div></div></section></div>
