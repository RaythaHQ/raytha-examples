{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign y = Target.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_m == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "clergy" and in_c == false -%}{%- assign ok=false -%}{%- endif -%}{%- capture yd -%}{{ y.date }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/calendar">Calendar</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ yd | date: "%A %-d %B %Y" }} · {{ y.time }} to {{ y.end_time }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{% if ok %}{{ y.summary }}{% else %}A members-only event.{% endif %}</p></div></div><section class="sec tight"><div class="w"><div class="facts"><div><span>When</span><b>{{ yd | date: "%a %-d %b" }}, {{ y.time }}</b></div><div><span>Where</span><b>{{ y.room }}</b></div><div><span>Kind</span><b>{% capture lv10 -%}{{ y.kind }}{%- endcapture %}{% case lv10 %}{% when "worship" %}Worship{% when "music" %}Music{% when "children" %}Children{% when "youth" %}Youth{% when "care" %}Pastoral care{% when "outreach" %}Outreach{% when "study" %}Study{% when "fellowship" %}Fellowship{% when "buildings" %}Buildings and grounds{% else %}{{ lv10 }}{% endcase %}</b></div><div><span>For</span><b>{% capture lv11 -%}{{ y.audience }}{%- endcapture %}{% case lv11 %}{% when "public" %}Everyone{% when "members" %}Members{% when "clergy" %}Clergy and pastoral team{% else %}{{ lv11 }}{% endcase %}</b></div></div><div class="grid2"><div>{% if ok %}<div class="prose">{{ y.body }}</div><p class="muted" style="font-size:.95rem">No sign-up needed. Questions to the parish office, 555-0100.</p>{% else %}<div class="lockp"><p class="kick">🔒 Members only</p><h2>The details of this event are for members of the parish</h2><p class="muted">This is checked on the server: signed out, these names and details are never sent to the browser. In the story, the parish office opens an account for each member household.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Member sign-in</a><a class="btn line" href="{{ PathBase }}/members">What members see</a></p></div>{% endif %}</div><aside class="side">{%- capture mn -%}{{ y.ministry }}{%- endcapture -%}{% if mn != "" %}{%- assign MS = get_content_items(ContentType="ministries", PageSize=20) -%}{% for m in MS.Items %}{%- capture mpf -%}{{ m.PrimaryField }}{%- endcapture -%}{% if mpf == mn %}<a class="win" href="{{ PathBase }}/{{ m.RoutePath }}"><span class="glass">{{ m.PublishedContent.glyph }}</span><b>{{ m.PrimaryField }}</b><p>{{ m.PublishedContent.summary }}</p><small>{{ m.PublishedContent.meets | split: ";" | first }}</small></a>{% endif %}{% endfor %}{% endif %}<a class="btn line" href="{{ PathBase }}/calendar?m={{ yd | truncate: 7, "" }}">Back to {{ yd | date: "%B" }}</a></aside></div></div></section>
