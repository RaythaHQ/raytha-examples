{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>Search</li></ol><p class="kick">Search</p><h1>{% if q != "" %}Results for “{{ q }}”{% else %}Search Wyndleford{% endif %}</h1><p class="lede">Sundays and sermons, the calendar, ministries, small groups, people and the seasons of the church year.</p><form class="searchbar" action="" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="advent, choir, pantry"><button class="btn">Search</button></form></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:860px">{% if q != "" %}{%- assign groups = "sermons:Sundays:title:summary,events:Calendar:title:summary,ministries:Ministries:name:summary,groups:Small groups:name:summary,people:People:name:bio,seasons:The church year:name:meaning" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="grp">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_m == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "clergy" and in_c == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% unless ok %} <span class="tg lock">🔒 Members</span>{% endunless %}<p>{% if ok %}{{ x.summary | default: x.bio | default: x.meaning | strip_html | truncate: 160 }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=advent">advent</a>, <a href="?q=choir">choir</a>, <a href="?q=pantry">pantry</a> or <a href="?q=Mark">Mark</a>.</p>{% endif %}</div></div></section>
