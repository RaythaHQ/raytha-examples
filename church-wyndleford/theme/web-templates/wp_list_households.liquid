{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- capture aq -%}{{ QueryParams.area | strip }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/members">Members</a></li><li>Directory</li></ol><p class="kick">Members · parish directory</p><h1>{% if in_m %}{{ Target.TotalCount }} households{% else %}The parish directory{% endif %}</h1><p class="lede">Households, the people in them, their neighborhood and how to reach them. Kept by the parish office and shown only to signed-in members.</p></div></div><section class="sec tight"><div class="w">{% if in_m %}<div class="filters"><a href="?" class="{% if aq == "" %}on{% endif %}">Everywhere</a><a href="?area=Cobbler's Green" class="{% if aq == "Cobbler's Green" %}on{% endif %}">Cobbler's Green</a><a href="?area=Ferry Street" class="{% if aq == "Ferry Street" %}on{% endif %}">Ferry Street</a><a href="?area=Hollins Ridge" class="{% if aq == "Hollins Ridge" %}on{% endif %}">Hollins Ridge</a><a href="?area=Mill End" class="{% if aq == "Mill End" %}on{% endif %}">Mill End</a><a href="?area=Old Town" class="{% if aq == "Old Town" %}on{% endif %}">Old Town</a><a href="?area=The Flats" class="{% if aq == "The Flats" %}on{% endif %}">The Flats</a></div><div class="dir">{% for h in Target.Items %}{%- capture ha -%}{{ h.PublishedContent.area }}{%- endcapture -%}{% if aq == "" or aq == ha %}<a class="card hh" href="{{ PathBase }}/{{ h.RoutePath }}"><span class="ini" style="width:52px;height:52px">{{ h.PrimaryField | remove: "The " | slice: 0, 1 }}</span><span><b>{{ h.PrimaryField }}</b><span style="display:block;font-size:.94rem">{{ h.PublishedContent.people }}</span><span class="meta">{{ h.PublishedContent.area | upcase }} · {{ h.PublishedContent.phone }} · SINCE {{ h.PublishedContent.joined }}</span></span></a>{% endif %}{% endfor %}</div>{% else %}<div class="lockp"><p class="kick">🔒 Members only</p><h2>The directory is for members of the parish</h2><p class="muted">This is checked on the server: signed out, these names and details are never sent to the browser. In the story, the parish office opens an account for each member household.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/directory">Member sign-in</a><a class="btn line" href="{{ PathBase }}/members">What members see</a></p></div>{% endif %}</div></section>
