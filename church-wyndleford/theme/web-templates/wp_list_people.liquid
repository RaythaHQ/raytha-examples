{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>People</li></ol><p class="kick">Clergy and staff · {{ Target.TotalCount }}</p><h1>The people at the door</h1><p class="lede">Three clergy, three staff and the senior warden. Office hours and email for each; the parish office is open weekday mornings.</p></div></div><section class="sec tight"><div class="w">{% for k in (1..3) %}{% if k == 1 %}{%- assign kk = "clergy" -%}{%- assign kl = "Clergy" -%}{% elsif k == 2 %}{%- assign kk = "staff" -%}{%- assign kl = "Staff" -%}{% else %}{%- assign kk = "lay" -%}{%- assign kl = "Lay leaders" -%}{% endif %}<div class="sgroup"><h2>{{ kl }}</h2><i></i></div><div class="people" style="margin-top:16px">{% for p in Target.Items %}{%- capture pk -%}{{ p.PublishedContent.kind }}{%- endcapture -%}{% if pk == kk %}<a class="card person" href="{{ PathBase }}/{{ p.RoutePath }}"><span class="hd"><span class="ini">{{ p.PublishedContent.initials }}</span><span><b>{{ p.PrimaryField }}</b><span class="muted" style="display:block;font-size:.9rem">{{ p.PublishedContent.role }}</span></span></span><span style="font-size:.95rem">{{ p.PublishedContent.summary }}</span><span class="kick" style="margin:auto 0 0;font-size:.68rem">{{ p.PublishedContent.office_hours }}</span></a>{% endif %}{% endfor %}</div>{% endfor %}</div></section>
