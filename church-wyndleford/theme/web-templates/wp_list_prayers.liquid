{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li>Prayer list</li></ol><p class="kick">Prayer list · {{ Target.TotalCount }} requests</p><h1>Pray with us, by name</h1><p class="lede">Names on the list are prayed for at every service. Some are read aloud and shown here to everyone; some are shared only with members; a few stay with the clergy and the pastoral team. Each one comes off the list on the date the person asked for.</p></div></div><section class="sec tight"><div class="w">{%- assign nm = 0 -%}{%- assign nc = 0 -%}{% for p in Target.Items %}{%- capture pau -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{% if pau == "members" and in_m == false %}{%- assign nm = nm | plus: 1 -%}{% endif %}{% if pau == "clergy" and in_c == false %}{%- assign nc = nc | plus: 1 -%}{% endif %}{% endfor %}<div class="grid2"><div class="plist">{% for p in Target.Items %}{%- capture pau -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{%- capture au -%}{{ p.PublishedContent.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_m == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "clergy" and in_c == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}<a class="pr{% if pau == "members" %} m{% elsif pau == "clergy" %} c{% endif %}" href="{{ PathBase }}/{{ p.RoutePath }}" style="display:block;text-decoration:none"><span class="tg{% if pau != "public" %} lock{% endif %}">{% capture lv18 -%}{{ p.PublishedContent.kind }}{%- endcapture %}{% case lv18 %}{% when "healing" %}Healing{% when "thanks" %}Thanksgiving{% when "grief" %}Those who mourn{% when "travel" %}Travel and change{% when "newlife" %}New life{% when "world" %}The world{% else %}{{ lv18 }}{% endcase %} · {% if pau == "public" %}read aloud{% elsif pau == "members" %}members{% else %}clergy only{% endif %}</span><b>{{ p.PrimaryField }}</b><p>{{ p.PublishedContent.request }}</p><small>ADDED {% capture _dt18 %}{{ p.PublishedContent.date }}{% endcapture %}{{ _dt18 | date: "%-d %b" | upcase }} · UNTIL {% capture _dt19 %}{{ p.PublishedContent.until }}{% endcapture %}{{ _dt19 | date: "%-d %b" | upcase }} · {{ p.PublishedContent.asked_by | upcase }}</small></a>{% endif %}{% endfor %}</div><aside class="side">{% if nm > 0 or nc > 0 %}<div class="lockp" style="padding:28px"><p class="kick">🔒 Not shown to you</p>{% if nm > 0 %}<p style="margin:0 0 8px"><b style="font:500 1.6rem var(--serif);color:#fff">{{ nm }}</b> requests shared with members</p>{% endif %}{% if nc > 0 %}<p style="margin:0 0 16px"><b style="font:500 1.6rem var(--serif);color:#fff">{{ nc }}</b> kept with the clergy and pastoral team</p>{% endif %}<p class="muted" style="font-size:.9rem">Their names and requests are left out on the server, not hidden in the page.</p>{% unless in_m %}<a class="btn light" href="{{ PathBase }}/account/login?returnUrl=/prayer">Member sign-in</a>{% endunless %}</div>{% endif %}<div class="card"><p class="kick">To add a name</p><p style="margin:0;font-size:.95rem">Tell any of the clergy, or call the parish office on 555-0100, and say who the request may be shared with. There is no form on this site.</p></div></aside></div></div></section>
