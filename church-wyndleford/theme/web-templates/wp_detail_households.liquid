{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign wdn = "now" | date: "%w" | plus: 0 -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_m=false -%}{%- assign in_c=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_m=true -%}{%- endif -%}{%- if g == "clergy" -%}{%- assign in_c=true -%}{%- assign in_m=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_m=true -%}{%- assign in_c=true -%}{%- endif -%}{%- assign y = Target.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_m == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "clergy" and in_c == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Wyndleford</a></li><li><a href="{{ PathBase }}/directory">Directory</a></li><li>Household</li></ol><p class="kick">Members · directory</p><h1>{% if ok %}{{ Target.PrimaryField }}{% else %}A household{% endif %}</h1><p class="lede">{% if ok %}{{ y.people }}{% else %}Sign in to see the directory.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% if ok %}<div class="facts"><div><span>Neighborhood</span><b>{{ y.area }}</b></div><div><span>Phone</span><b>{{ y.phone }}</b></div><div><span>Email</span><b style="font-size:.95rem">{{ y.email }}</b></div><div><span>Member since</span><b>{{ y.joined }}</b></div></div><h2>Serves in</h2>{%- assign sv = y.serves | split: ", " -%}{%- assign MS = get_content_items(ContentType="ministries", PageSize=20) -%}{% for s in sv %}{% for m in MS.Items %}{%- capture mpf -%}{{ m.PrimaryField }}{%- endcapture -%}{% if mpf == s %}<a class="hit" href="{{ PathBase }}/{{ m.RoutePath }}"><b>{{ m.PrimaryField }}</b><p>{{ m.PublishedContent.meets }}</p></a>{% endif %}{% endfor %}{% endfor %}{% else %}<div class="lockp"><p class="kick">🔒 Members only</p><h2>The directory is for members of the parish</h2><p class="muted">This is checked on the server: signed out, these names and details are never sent to the browser. In the story, the parish office opens an account for each member household.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/directory">Member sign-in</a><a class="btn line" href="{{ PathBase }}/members">What members see</a></p></div>{% endif %}</div></section>
