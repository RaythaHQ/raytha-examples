<section class="sec tight"><div class="w"><h2 style="margin-bottom:22px">{{ widget.settings.headline }}</h2><div class="notes">{% for i in widget.settings.items %}<div class="note"><span class="chip">{{ i.tag }}</span><h3>{{ i.title }}</h3><p class="muted" style="margin:0">{{ i.text }}</p></div>{% endfor %}</div></div></section>
