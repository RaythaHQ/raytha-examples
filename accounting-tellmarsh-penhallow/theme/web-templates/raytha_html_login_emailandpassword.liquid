{% if Target.ValidationFailures["__ValidationSummary"] %}<div class="notice" role="alert">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
<label for="email">Email</label><input id="email" type="email" name="EmailAddress" autocomplete="email">
<label for="password">Password</label><input id="password" type="password" name="Password" autocomplete="current-password">
<button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:8px">Sign in</button>
<input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form><p style="margin:16px 0 0;text-align:center"><a href="{{ PathBase }}/account/login/forgot-password/begin">Forgot your password?</a></p>
