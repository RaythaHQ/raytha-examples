{%- assign x=Target.PublishedContent -%}{%- capture pc -%}{{ x.author }}{%- endcapture -%}{%- capture rm_s -%}{{ x.read_min }}{%- endcapture -%}{%- assign rm = rm_s | plus: 0 -%}{%- capture f -%}code eq '{{ pc }}'{%- endcapture -%}{%- assign ap = get_content_items(ContentType="people", Filter=f, PageSize=1) -%}{%- assign more = get_content_items(ContentType="notes", OrderBy="sort_order asc", PageSize=4) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/notes">Field notes</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{{ x.date_label }} · {% capture lv28 -%}{{ x.kind }}{%- endcapture %}{% case lv28 %}{% when "tax" %}Tax{% when "books" %}Bookkeeping{% when "payroll" %}Payroll{% when "planning" %}Planning{% when "firm" %}At the firm{% else %}{{ lv28 }}{% endcase %} · {{ rm }} min read</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="prose"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="border-radius:14px;margin-bottom:28px">{{ x.body }}</div><aside>{% for m in ap.Items %}<div class="panel"><p class="kick">Written by</p><div class="ppl big" style="grid-template-columns:1fr">{%- assign y=m.PublishedContent -%}<a class="person" href="{{ PathBase }}/{{ m.RoutePath }}"><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt="Generated monogram for {{ m.PrimaryField }}" loading="lazy"><b>{{ m.PrimaryField }}</b><small>{{ y.role }}</small>{%- capture _c4 -%}{{ y.credentials }}{%- endcapture -%}{% if _c4 != "" and y.credentials %}<span class="cr">{{ y.credentials }}</span>{% endif %}<p>{{ y.focus }} · ext. {{ y.ext }}</p></a></div></div>{% endfor %}<div class="panel" style="margin-top:22px"><p class="kick">More notes</p>{% for n in more.Items %}{% if n.RoutePath != Target.RoutePath %}<p style="margin:0 0 10px"><a href="{{ PathBase }}/{{ n.RoutePath }}">{{ n.PrimaryField }}</a></p>{% endif %}{% endfor %}</div></aside></div></div></section>
