{%- assign tm = "now" | date: "%m" | plus: 0 -%}{%- assign td = "now" | date: "%d" | plus: 0 -%}{%- assign mst = "0,31,59,90,120,151,181,212,243,273,304,334" | split: "," -%}{%- assign tmi = tm | minus: 1 -%}{%- assign tdoy = mst[tmi] | plus: td -%}{%- assign tq = tm | plus: 2 | divided_by: 3 -%}{%- assign tdeg = tdoy | times: 360.0 | divided_by: 365 | round: 1 -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign x=Target.PublishedContent -%}{%- assign dls = get_content_items(ContentType="deadlines", OrderBy="doy asc", PageSize=60) -%}{%- capture sc -%}{{ x.service }}{%- endcapture -%}{%- capture dy_s -%}{{ Target.PublishedContent.doy }}{%- endcapture -%}{%- assign dy = dy_s | plus: 0 -%}{%- assign tn = dy | minus: tdoy -%}{% if tn < 0 %}{%- assign tn = tn | plus: 365 -%}{% endif %}{%- capture qm_s -%}{{ x.month }}{%- endcapture -%}{%- assign qm = qm_s | plus: 0 -%}{%- assign qq = qm | plus: 2 | divided_by: 3 -%}{%- capture fw -%}{{ x.for_whom }}{%- endcapture -%}{%- capture dday_s -%}{{ x.day }}{%- endcapture -%}{%- assign dday = dday_s | plus: 0 -%}{%- capture f -%}code eq '{{ sc }}'{%- endcapture -%}{%- assign sq = get_content_items(ContentType="services", Filter=f, PageSize=1) -%}{%- assign nx = Target -%}
