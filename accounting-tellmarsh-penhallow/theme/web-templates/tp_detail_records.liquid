{%- assign x=Target.PublishedContent -%}{%- assign all = get_content_items(ContentType="records", OrderBy="sort_order asc", PageSize=20) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/keep">Records to keep</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">Records · {% capture lv33 -%}{{ x.kind }}{%- endcapture %}{% case lv33 %}{% when "household" %}Household{% when "business" %}Business{% when "payroll" %}Payroll and staff{% when "property" %}Property and investments{% else %}{{ lv33 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">Keep for: {{ x.keep_label }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose"><h2>Why</h2><p>{{ x.why }}</p><div class="keep" style="margin-top:26px"><div class="axis"><span>Record</span><span class="sc"><span>0</span><span>5 years</span><span>10+</span></span><span style="text-align:right">Keep for</span></div>{%- assign r = Target -%}{%- assign y=r.PublishedContent -%}{%- capture yr_s -%}{{ y.years }}{%- endcapture -%}{%- assign yr = yr_s | plus: 0 -%}{%- capture rk -%}{{ y.kind }}{%- endcapture -%}{%- assign bw = yr | times: 10 -%}{% if bw > 100 %}{%- assign bw = 100 -%}{% endif %}<a class="krow" href="{{ PathBase }}/{{ r.RoutePath }}" style="--c:{% case rk %}{% when "household" %}var(--q1){% when "business" %}var(--q4){% when "payroll" %}var(--q3){% else %}var(--q2){% endcase %}"><span><b>{{ r.PrimaryField }}</b><small>{% capture lv34 -%}{{ y.kind }}{%- endcapture %}{% case lv34 %}{% when "household" %}Household{% when "business" %}Business{% when "payroll" %}Payroll and staff{% when "property" %}Property and investments{% else %}{{ lv34 }}{% endcase %}</small></span><span class="bar"><i class="{% if yr > 50 %}perm{% endif %}" style="width:{{ bw }}%"></i></span><span class="lb">{{ y.keep_label }}</span></a></div></div><aside class="panel"><p class="kick">Other records</p>{% for r in all.Items %}{% if r.RoutePath != Target.RoutePath %}<p style="margin:0 0 8px"><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a> <span class="muted small">· {{ r.PublishedContent.keep_label }}</span></p>{% endif %}{% endfor %}</aside></div></div></section>
