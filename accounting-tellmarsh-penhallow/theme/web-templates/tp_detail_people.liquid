{%- assign x=Target.PublishedContent -%}{%- capture pc -%}{{ x.code }}{%- endcapture -%}{%- capture f -%}lead eq '{{ pc }}'{%- endcapture -%}{%- assign ls = get_content_items(ContentType="services", Filter=f, OrderBy="sort_order asc", PageSize=8) -%}{%- capture f2 -%}author eq '{{ pc }}'{%- endcapture -%}{%- assign an = get_content_items(ContentType="notes", Filter=f2, OrderBy="sort_order asc", PageSize=6) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/people">People</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ x.role }}{%- capture _c3 -%}{{ x.credentials }}{%- endcapture -%}{% if _c3 != "" and x.credentials %} · {{ x.credentials }}{% endif %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,300px) minmax(0,1fr) minmax(0,320px)"><div><img src="{{ x.portrait.Value | attachment_redirect_url }}" alt="Generated monogram for {{ Target.PrimaryField }}" style="border-radius:50%;box-shadow:0 0 0 8px var(--card),0 0 0 9px var(--rule)"></div><div class="prose">{{ x.body }}{% if ls.TotalCount > 0 %}<h2 style="margin:28px 0 16px;font-size:1.45rem">Leads</h2><div class="svcs" style="grid-template-columns:1fr 1fr">{% for s in ls.Items %}{%- assign y=s.PublishedContent -%}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="hole"></span><span class="chip">{% capture lv25 -%}{{ y.category }}{%- endcapture %}{% case lv25 %}{% when "individuals" %}Individuals{% when "business" %}Business{% when "payroll" %}Payroll{% when "nonprofit" %}Nonprofit{% when "advisory" %}Advisory{% else %}{{ lv25 }}{% endcase %}</span><h3>{{ s.PrimaryField }}</h3><span class="fee"><small>From</small>{{ y.fee_from }}</span><p>{{ y.summary }}</p><span class="ft">{{ y.fee_basis }}<br>Lead: {% capture lv26 -%}{{ y.lead }}{%- endcapture %}{% case lv26 %}{% when "nadia" %}Nadia Penhallow{% when "owen" %}Owen Tellmarsh{% when "marisol" %}Marisol Ferreira{% when "desmond" %}Desmond Achterberg{% when "lena" %}Lena Hask{% when "theo" %}Theo Barlowe{% when "june" %}June Okafor-Reyes{% else %}{{ lv26 }}{% endcase %}</span></a>{% endfor %}</div>{% endif %}</div>
<aside><div class="memo"><p class="mh">MEMO · CONTACT</p><dl class="kv"><dt>Direct</dt><dd>(555) 017-4400, ext. {{ x.ext }}</dd><dt>Focus</dt><dd>{{ x.focus }}</dd><dt>Since</dt><dd>{{ x.since }}</dd></dl></div>{% if an.TotalCount > 0 %}<div class="panel" style="margin-top:22px"><p class="kick">Field notes by {{ Target.PrimaryField | split: " " | first }}</p>{% for n in an.Items %}<p style="margin:0 0 10px"><a href="{{ PathBase }}/{{ n.RoutePath }}">{{ n.PrimaryField }}</a></p>{% endfor %}</div>{% endif %}</aside></div></div></section>
