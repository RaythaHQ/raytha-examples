{%- assign tm = "now" | date: "%m" | plus: 0 -%}{%- assign td = "now" | date: "%d" | plus: 0 -%}{%- assign mst = "0,31,59,90,120,151,181,212,243,273,304,334" | split: "," -%}{%- assign tmi = tm | minus: 1 -%}{%- assign tdoy = mst[tmi] | plus: td -%}{%- assign tq = tm | plus: 2 | divided_by: 3 -%}{%- assign tdeg = tdoy | times: 360.0 | divided_by: 365 | round: 1 -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign x=Target.PublishedContent -%}{%- capture sc -%}{{ x.code }}{%- endcapture -%}{%- capture ld -%}{{ x.lead }}{%- endcapture -%}{%- capture f -%}service eq '{{ sc }}'{%- endcapture -%}{%- assign sd = get_content_items(ContentType="deadlines", Filter=f, OrderBy="doy asc", PageSize=10) -%}{%- capture f2 -%}code eq '{{ ld }}'{%- endcapture -%}{%- assign lp = get_content_items(ContentType="people", Filter=f2, PageSize=1) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/services">Services</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv21 -%}{{ x.category }}{%- endcapture %}{% case lv21 %}{% when "individuals" %}Individuals{% when "business" %}Business{% when "payroll" %}Payroll{% when "nonprofit" %}Nonprofit{% when "advisory" %}Advisory{% else %}{{ lv21 }}{% endcase %} · from {{ x.fee_from }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><div class="prose">{{ x.body }}</div><div class="grid2" style="margin-top:28px"><div><h2 style="font-size:1.45rem;margin-bottom:12px">What is included</h2>{%- assign inc = x.includes | split: "|" -%}<ul class="ticks">{% for i in inc %}<li>{{ i }}</li>{% endfor %}</ul></div>
<div><h2 style="font-size:1.45rem;margin-bottom:12px">What to bring</h2>{%- assign br = x.bring | split: "|" -%}<ul class="boxes">{% for i in br %}<li>{{ i }}</li>{% endfor %}</ul></div></div>
{% if sd.TotalCount > 0 %}<h2 style="margin:36px 0 18px;font-size:1.45rem">Dates this engagement covers</h2><div class="tiles" style="grid-template-columns:repeat(3,1fr)">{% for d in sd.Items %}{%- assign y=d.PublishedContent -%}{%- capture dy_s -%}{{ d.PublishedContent.doy }}{%- endcapture -%}{%- assign dy = dy_s | plus: 0 -%}{%- assign tn = dy | minus: tdoy -%}{% if tn < 0 %}{%- assign tn = tn | plus: 365 -%}{% endif %}{%- capture qm_s -%}{{ y.month }}{%- endcapture -%}{%- assign qm = qm_s | plus: 0 -%}{%- assign qq = qm | plus: 2 | divided_by: 3 -%}{%- capture fw -%}{{ y.for_whom }}{%- endcapture -%}{%- capture dday_s -%}{{ y.day }}{%- endcapture -%}{%- assign dday = dday_s | plus: 0 -%}<a class="tile" style="--c:{% case qq %}{% when 1 %}var(--q1){% when 2 %}var(--q2){% when 3 %}var(--q3){% else %}var(--q4){% endcase %}" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="mh"><span>{% capture lv22 -%}{{ y.month }}{%- endcapture %}{% case lv22 %}{% when "1" %}Jan{% when "2" %}Feb{% when "3" %}Mar{% when "4" %}Apr{% when "5" %}May{% when "6" %}Jun{% when "7" %}Jul{% when "8" %}Aug{% when "9" %}Sep{% when "10" %}Oct{% when "11" %}Nov{% when "12" %}Dec{% else %}{{ lv22 }}{% endcase %}</span><span>Q{{ qq }}</span></span><span class="in">{% if tn == 0 %}today{% elsif tn == 1 %}tomorrow{% else %}in {{ tn }} days{% endif %}</span><span class="d">{{ dday }}</span><b>{{ d.PrimaryField }}</b><small><span class="chip f-{{ fw }}">{% capture lv23 -%}{{ y.for_whom }}{%- endcapture %}{% case lv23 %}{% when "individuals" %}Individuals{% when "business" %}Business{% when "payroll" %}Employers{% when "nonprofit" %}Nonprofits{% when "everyone" %}Everyone{% else %}{{ lv23 }}{% endcase %}</span>{{ y.form | truncate: 30 }}</small></a>{% endfor %}</div>{% endif %}</div>
<aside><div class="memo"><p class="mh">MEMO · FEE</p><dl class="kv"><dt>From</dt><dd><b style="font:500 1.6rem Newsreader,serif">{{ x.fee_from }}</b></dd><dt>Basis</dt><dd>{{ x.fee_basis }}</dd><dt>Timing</dt><dd>{{ x.turnaround }}</dd><dt>Start</dt><dd><a href="{{ PathBase }}/new-clients">Call (555) 017-4400</a></dd></dl></div>
{% for m in lp.Items %}<div class="panel" style="margin-top:22px"><p class="kick">Lead</p><div class="ppl big" style="grid-template-columns:1fr">{%- assign y=m.PublishedContent -%}<a class="person" href="{{ PathBase }}/{{ m.RoutePath }}"><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt="Generated monogram for {{ m.PrimaryField }}" loading="lazy"><b>{{ m.PrimaryField }}</b><small>{{ y.role }}</small>{%- capture _c1 -%}{{ y.credentials }}{%- endcapture -%}{% if _c1 != "" and y.credentials %}<span class="cr">{{ y.credentials }}</span>{% endif %}<p>{{ y.focus }} · ext. {{ y.ext }}</p></a></div></div>{% endfor %}</aside></div></div></section>
