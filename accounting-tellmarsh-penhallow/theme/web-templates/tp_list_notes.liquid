{%- assign fk = QueryParams.kind | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Field notes</li></ol><p class="kick">Field notes</p><h1>Short notes from the firm</h1><p class="lede">Written by the people who do the work, about the calendar, the paperwork and the way the firm runs.</p><div class="filters"><a href="{{ PathBase }}/notes" class="{% if fk == "" %}on{% endif %}">All</a><a href="{{ PathBase }}/notes?kind=tax" class="{% if fk == "tax" %}on{% endif %}">Tax</a><a href="{{ PathBase }}/notes?kind=books" class="{% if fk == "books" %}on{% endif %}">Bookkeeping</a><a href="{{ PathBase }}/notes?kind=payroll" class="{% if fk == "payroll" %}on{% endif %}">Payroll</a><a href="{{ PathBase }}/notes?kind=planning" class="{% if fk == "planning" %}on{% endif %}">Planning</a><a href="{{ PathBase }}/notes?kind=firm" class="{% if fk == "firm" %}on{% endif %}">At the firm</a></div></div></div><section class="sec tight"><div class="w"><div class="nlist">{% for n in Target.Items %}{%- capture nkd -%}{{ n.PublishedContent.kind }}{%- endcapture -%}{% if fk == "" or fk == nkd %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv27 -%}{{ y.kind }}{%- endcapture %}{% case lv27 %}{% when "tax" %}Tax{% when "books" %}Bookkeeping{% when "payroll" %}Payroll{% when "planning" %}Planning{% when "firm" %}At the firm{% else %}{{ lv27 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span>{{ y.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
