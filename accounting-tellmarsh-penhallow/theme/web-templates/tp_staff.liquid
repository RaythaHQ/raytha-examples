{%- assign in_client=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_client=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_client=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_client=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign tm = "now" | date: "%m" | plus: 0 -%}{%- assign td = "now" | date: "%d" | plus: 0 -%}{%- assign mst = "0,31,59,90,120,151,181,212,243,273,304,334" | split: "," -%}{%- assign tmi = tm | minus: 1 -%}{%- assign tdoy = mst[tmi] | plus: td -%}{%- assign tq = tm | plus: 2 | divided_by: 3 -%}{%- assign tdeg = tdoy | times: 360.0 | divided_by: 365 | round: 1 -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign dls = get_content_items(ContentType="deadlines", OrderBy="doy asc", PageSize=60) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff room</li></ol><p class="kick">Staff room · staff only</p><h1>Staff room</h1><p class="lede">{% if in_staff %}Season board, deadlines in the next 45 days, notices and procedures. Names and counts are fictional.{% else %}The season board and procedures, for signed-in staff.{% endif %}</p></div></div>
{% if in_staff %}<section class="sec tight" style="padding-bottom:0"><div class="w"><h2 style="margin-bottom:18px">Due in the next 45 days</h2><div class="tiles">{%- assign shown = 0 -%}{% for d in dls.Items %}{%- capture dy_s -%}{{ d.PublishedContent.doy }}{%- endcapture -%}{%- assign dy = dy_s | plus: 0 -%}{%- assign t45 = dy | minus: tdoy -%}{% if t45 < 0 %}{%- assign t45 = t45 | plus: 365 -%}{% endif %}{% if t45 <= 45 and shown < 5 %}{%- assign shown = shown | plus: 1 -%}{%- assign y=d.PublishedContent -%}{%- capture dy_s -%}{{ d.PublishedContent.doy }}{%- endcapture -%}{%- assign dy = dy_s | plus: 0 -%}{%- assign tn = dy | minus: tdoy -%}{% if tn < 0 %}{%- assign tn = tn | plus: 365 -%}{% endif %}{%- capture qm_s -%}{{ y.month }}{%- endcapture -%}{%- assign qm = qm_s | plus: 0 -%}{%- assign qq = qm | plus: 2 | divided_by: 3 -%}{%- capture fw -%}{{ y.for_whom }}{%- endcapture -%}{%- capture dday_s -%}{{ y.day }}{%- endcapture -%}{%- assign dday = dday_s | plus: 0 -%}<a class="tile" style="--c:{% case qq %}{% when 1 %}var(--q1){% when 2 %}var(--q2){% when 3 %}var(--q3){% else %}var(--q4){% endcase %}" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="mh"><span>{% capture lv40 -%}{{ y.month }}{%- endcapture %}{% case lv40 %}{% when "1" %}Jan{% when "2" %}Feb{% when "3" %}Mar{% when "4" %}Apr{% when "5" %}May{% when "6" %}Jun{% when "7" %}Jul{% when "8" %}Aug{% when "9" %}Sep{% when "10" %}Oct{% when "11" %}Nov{% when "12" %}Dec{% else %}{{ lv40 }}{% endcase %}</span><span>Q{{ qq }}</span></span><span class="in">{% if tn == 0 %}today{% elsif tn == 1 %}tomorrow{% else %}in {{ tn }} days{% endif %}</span><span class="d">{{ dday }}</span><b>{{ d.PrimaryField }}</b><small><span class="chip f-{{ fw }}">{% capture lv41 -%}{{ y.for_whom }}{%- endcapture %}{% case lv41 %}{% when "individuals" %}Individuals{% when "business" %}Business{% when "payroll" %}Employers{% when "nonprofit" %}Nonprofits{% when "everyone" %}Everyone{% else %}{{ lv41 }}{% endcase %}</span>{{ y.form | truncate: 30 }}</small></a>{% endif %}{% endfor %}</div></div></section>{{ render_section("main", wrap=false) }}{%- assign sr = get_content_items(ContentType="documents", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=20) -%}<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:22px">Procedures and templates</h2><div class="grid2">{% for r in sr.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_client == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<a class="doc" href="{{ PathBase }}/{{ r.RoutePath }}">{% if au == "clients" %}<span class="chip lock">🔒 Clients</span>{% elsif au == "staff" %}<span class="chip staff">Staff</span>{% else %}<span class="chip">Everyone</span>{% endif %}<span class="chip">{% capture lv35 -%}{{ x.kind }}{%- endcapture %}{% case lv35 %}{% when "checklist" %}Checklist{% when "howto" %}How-to{% when "policy" %}Policy{% when "procedure" %}Procedure{% when "template" %}Template{% else %}{{ lv35 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endfor %}</div></div></section>{% else %}<section class="sec tight"><div class="w">{% if in_client %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>You are signed in as a client.</h2><p class="muted">The staff room is only for firm staff. Your checklists and engagement are in the <a href="{{ PathBase }}/client-portal">client portal</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Firm staff sign in to see the staff room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, portal accounts are opened when an engagement letter is signed.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Sign in</a><a class="btn line" href="{{ PathBase }}/new-clients">How to become a client</a></p></div>{% endif %}</div></section>{% endif %}
