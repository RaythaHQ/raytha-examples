<div class="keep"><div class="axis"><span>Record</span><span class="sc"><span>0</span><span>5 years</span><span>10+</span></span><span style="text-align:right">Keep for</span></div>{% for r in recs.Items %}{%- assign y=r.PublishedContent -%}{%- capture yr_s -%}{{ y.years }}{%- endcapture -%}{%- assign yr = yr_s | plus: 0 -%}{%- capture rk -%}{{ y.kind }}{%- endcapture -%}{%- assign bw = yr | times: 10 -%}{% if bw > 100 %}{%- assign bw = 100 -%}{% endif %}<a class="krow" href="{{ PathBase }}/{{ r.RoutePath }}" style="--c:{% case rk %}{% when "household" %}var(--q1){% when "business" %}var(--q4){% when "payroll" %}var(--q3){% else %}var(--q2){% endcase %}"><span><b>{{ r.PrimaryField }}</b><small>{% capture lv9 -%}{{ y.kind }}{%- endcapture %}{% case lv9 %}{% when "household" %}Household{% when "business" %}Business{% when "payroll" %}Payroll and staff{% when "property" %}Property and investments{% else %}{{ lv9 }}{% endcase %}</small></span><span class="bar"><i class="{% if yr > 50 %}perm{% endif %}" style="width:{{ bw }}%"></i></span><span class="lb">{{ y.keep_label }}</span></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">People · the name on your return</p><h2>Who does the work</h2><p>One person prepares your return, another reviews it, and a partner signs every business return.</p></div><a class="btn sm line" href="{{ PathBase }}/people">All people →</a></div>
<div class="ppl">{% for m in ppl.Items %}{%- assign y=m.PublishedContent -%}<a class="person" href="{{ PathBase }}/{{ m.RoutePath }}"><img src="{{ y.portrait.Value | attachment_redirect_url }}" alt="Generated monogram for {{ m.PrimaryField }}" loading="lazy"><b>{{ m.PrimaryField }}</b><small>{{ y.role }}</small>{%- capture _c0 -%}{{ y.credentials }}{%- endcapture -%}{% if _c0 != "" and y.credentials %}<span class="cr">{{ y.credentials }}</span>{% endif %}</a>{% endfor %}</div></div></section>
<section class="sec tight" style="padding-bottom:80px"><div class="w"><div class="shead"><div><p class="kick">Field notes</p><h2>Written by the people who do the work</h2></div><a class="btn sm line" href="{{ PathBase }}/notes">All notes →</a></div><div class="nlist">{% for n in nts.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv10 -%}{{ y.kind }}{%- endcapture %}{% case lv10 %}{% when "tax" %}Tax{% when "books" %}Bookkeeping{% when "payroll" %}Payroll{% when "planning" %}Planning{% when "firm" %}At the firm{% else %}{{ lv10 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span>{{ y.summary }}</span></a>{% endfor %}</div></div></section>
<section class="band"><div class="w"><div><p class="kick" style="color:#ffe2a8">Client portal</p><h2>{% if in_client %}Welcome back, {{ CurrentUser.FirstName }}.{% else %}Your checklist, organizer help and engagement, in one place.{% endif %}</h2><p>Clients sign in to see what to send, how to send it, and where their return is. Accounts are opened when an engagement letter is signed; there is no sign-up form.</p><p class="cta"><a class="btn" href="{{ PathBase }}/client-portal">{% if in_client %}Open the client portal{% else %}Client portal sign-in{% endif %}</a></p></div>
<ul><li><b>CHECKLIST</b>What to bring, by family or business</li><li><b>ORGANIZER</b>Line-by-line help with the 2026 organizer</li><li><b>STATUS</b>Where your engagement is this quarter</li><li><b>NOTICES</b>Office dates and planning meetings</li></ul></div></section>
