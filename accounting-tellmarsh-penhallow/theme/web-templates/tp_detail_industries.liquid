{%- assign x=Target.PublishedContent -%}{%- assign svcs = get_content_items(ContentType="services", OrderBy="sort_order asc", PageSize=8) -%}{%- assign nts = get_content_items(ContentType="notes", OrderBy="sort_order asc", PageSize=3) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/who-we-serve">Who we serve</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">Who we serve · {{ x.short }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.art.Value | attachment_redirect_url }}" alt="" style="border-radius:14px;border:1px solid var(--rule);margin-bottom:28px"><div class="prose">{{ x.body }}</div><h2 style="margin:28px 0 12px;font-size:1.45rem">Typical engagements</h2>{%- assign tp = x.typical | split: "|" -%}<ul class="ticks">{% for i in tp %}<li>{{ i }}</li>{% endfor %}</ul></div>
<aside><div class="memo" style="--c:{{ x.color }}"><p class="mh">MEMO · IN FIGURES</p><p style="font:500 4rem/1 Newsreader,serif;color:{{ x.color }};margin:0 0 6px 34px">{{ x.stat }}</p><p>{{ x.stat_label }} on our books (story)</p></div><div class="panel" style="margin-top:22px"><p class="kick">Services</p>{% for s in svcs.Items %}<p style="margin:0 0 8px"><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a> <span class="muted small">· from {{ s.PublishedContent.fee_from }}</span></p>{% endfor %}</div></aside></div></div></section>
<section class="sec tight" style="border-top:1px solid var(--rule)"><div class="w"><h2 style="margin-bottom:22px">Field notes</h2><div class="nlist">{% for n in nts.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv24 -%}{{ y.kind }}{%- endcapture %}{% case lv24 %}{% when "tax" %}Tax{% when "books" %}Bookkeeping{% when "payroll" %}Payroll{% when "planning" %}Planning{% when "firm" %}At the firm{% else %}{{ lv24 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span>{{ y.summary }}</span></a>{% endfor %}</div></div></section>
