{%- assign in_client=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_client=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_client=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_client=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_client == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/documents">Documents</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv36 -%}{{ x.kind }}{%- endcapture %}{% case lv36 %}{% when "checklist" %}Checklist{% when "howto" %}How-to{% when "policy" %}Policy{% when "procedure" %}Procedure{% when "template" %}Template{% else %}{{ lv36 }}{% endcase %} · updated {{ x.updated }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:18px 0 0">{% if au == "clients" %}<span class="chip lock">🔒 Clients</span>{% elsif au == "staff" %}<span class="chip staff">Staff only</span>{% else %}<span class="chip">Everyone</span>{% endif %}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div>{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}{% if au == "staff" %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Signed-in staff see this page.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, portal accounts are opened when an engagement letter is signed.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/new-clients">How to become a client</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Clients</p><h2>Sign in to the client portal to read this.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, portal accounts are opened when an engagement letter is signed.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/new-clients">How to become a client</a></p></div>{% endif %}{% endif %}</div>
<aside class="memo"><p class="mh">MEMO · DOCUMENT</p><dl class="kv"><dt>Kind</dt><dd>{% capture lv37 -%}{{ x.kind }}{%- endcapture %}{% case lv37 %}{% when "checklist" %}Checklist{% when "howto" %}How-to{% when "policy" %}Policy{% when "procedure" %}Procedure{% when "template" %}Template{% else %}{{ lv37 }}{% endcase %}</dd><dt>For</dt><dd>{% capture lv38 -%}{{ x.audience }}{%- endcapture %}{% case lv38 %}{% when "public" %}Everyone{% when "clients" %}Clients{% when "staff" %}Staff{% else %}{{ lv38 }}{% endcase %}</dd><dt>Updated</dt><dd>{{ x.updated }}</dd><dt>Help</dt><dd>(555) 017-4410</dd></dl></aside></div></div></section>
