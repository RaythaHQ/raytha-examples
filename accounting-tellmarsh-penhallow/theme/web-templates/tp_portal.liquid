{%- assign in_client=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_client=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_client=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_client=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign tm = "now" | date: "%m" | plus: 0 -%}{%- assign td = "now" | date: "%d" | plus: 0 -%}{%- assign mst = "0,31,59,90,120,151,181,212,243,273,304,334" | split: "," -%}{%- assign tmi = tm | minus: 1 -%}{%- assign tdoy = mst[tmi] | plus: td -%}{%- assign tq = tm | plus: 2 | divided_by: 3 -%}{%- assign tdeg = tdoy | times: 360.0 | divided_by: 365 | round: 1 -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign dls = get_content_items(ContentType="deadlines", OrderBy="doy asc", PageSize=60) -%}{%- assign nxd = 999 -%}{% for d in dls.Items %}{%- capture dy_s -%}{{ d.PublishedContent.doy }}{%- endcapture -%}{%- assign dy = dy_s | plus: 0 -%}{%- assign dn = dy | minus: tdoy -%}{% if dn < 0 %}{%- assign dn = dn | plus: 365 -%}{% endif %}{% if dn < nxd %}{%- assign nxd = dn -%}{%- assign nx = d -%}{% endif %}{% endfor %}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Client portal</li></ol><p class="kick">Client portal · clients</p><h1>{% if in_client %}Hello, {{ CurrentUser.FirstName }}.{% else %}Client portal{% endif %}</h1><p class="lede">{% if in_client %}Your checklists, organizer help, the stage your engagement is in, and notices from the office.{% else %}Checklists, organizer help and engagement status for signed-in clients.{% endif %}</p></div></div>
{% if in_client %}{%- assign cds = get_content_items(ContentType="documents", Filter="audience eq 'clients'", OrderBy="sort_order asc", PageSize=20) -%}<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,420px) minmax(0,1fr)"><div><div class="ccard"><small>TELLMARSH &amp; PENHALLOW · CLIENT FILE</small><h2>{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</h2><p style="margin:0;color:#c9cfdd">Individual return · tax planning</p><div class="cn">TP-{{ CurrentUser.EmailAddress | size | plus: 2026 }}-{{ CurrentUser.LastName | size | plus: 40 }}</div></div><p class="muted small" style="margin-top:14px">Client number and engagement are fictional demo data.</p>
{%- assign z=nx.PublishedContent -%}{%- capture dday_s -%}{{ z.day }}{%- endcapture -%}{%- assign dday = dday_s | plus: 0 -%}<div class="panel" style="margin-top:20px"><p class="kick">Your next date</p><p style="margin:0"><b style="font:500 2.6rem/1 Newsreader,serif">{{ nxd }}</b> days · <a href="{{ PathBase }}/{{ nx.RoutePath }}">{{ nx.PrimaryField }}</a>, {% capture lv39 -%}{{ z.month }}{%- endcapture %}{% case lv39 %}{% when "1" %}Jan{% when "2" %}Feb{% when "3" %}Mar{% when "4" %}Apr{% when "5" %}May{% when "6" %}Jun{% when "7" %}Jul{% when "8" %}Aug{% when "9" %}Sep{% when "10" %}Oct{% when "11" %}Nov{% when "12" %}Dec{% else %}{{ lv39 }}{% endcase %} {{ dday }}</p></div></div>
<div><h2 style="margin-bottom:6px">Where your engagement is</h2><p class="muted" style="margin:0 0 14px">The stage follows the calendar: this is Q{{ tq }}.</p><div class="track"><div style="--c:var(--q1)"{% if tq == 1 %} class="now"{% endif %}><small>Q1{% if tq == 1 %} · NOW{% endif %}</small><b>Organizer and documents</b><p>Upload against the checklist; we confirm what is missing.</p></div><div style="--c:var(--q2)"{% if tq == 2 %} class="now"{% endif %}><small>Q2{% if tq == 2 %} · NOW{% endif %}</small><b>Preparation and review</b><p>Prepared by one person, reviewed by another, then sent to sign.</p></div><div style="--c:var(--q3)"{% if tq == 3 %} class="now"{% endif %}><small>Q3{% if tq == 3 %} · NOW{% endif %}</small><b>Extensions and estimates</b><p>Extended returns finished; estimates checked mid-year.</p></div><div style="--c:var(--q4)"{% if tq == 4 %} class="now"{% endif %}><small>Q4{% if tq == 4 %} · NOW{% endif %}</small><b>Year-end planning</b><p>November meeting, Q4 estimate and year-end moves.</p></div></div>
<h2 style="margin:34px 0 16px">Checklists and how-tos</h2><div class="grid2">{% for r in cds.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_client == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<a class="doc" href="{{ PathBase }}/{{ r.RoutePath }}">{% if au == "clients" %}<span class="chip lock">🔒 Clients</span>{% elsif au == "staff" %}<span class="chip staff">Staff</span>{% else %}<span class="chip">Everyone</span>{% endif %}<span class="chip">{% capture lv35 -%}{{ x.kind }}{%- endcapture %}{% case lv35 %}{% when "checklist" %}Checklist{% when "howto" %}How-to{% when "policy" %}Policy{% when "procedure" %}Procedure{% when "template" %}Template{% else %}{{ lv35 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endfor %}</div></div></div></div></section>
{{ render_section("main", wrap=false) }}{% else %}<section class="sec tight"><div class="w"><div class="lockp"><p class="kick">🔒 Clients</p><h2>Sign in to see your checklists and engagement.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, portal accounts are opened when an engagement letter is signed.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/client-portal">Sign in</a><a class="btn line" href="{{ PathBase }}/new-clients">How to become a client</a></p></div></div></section>{% endif %}
