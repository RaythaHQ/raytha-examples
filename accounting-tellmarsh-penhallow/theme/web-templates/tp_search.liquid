{%- assign in_client=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_client=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_client=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_client=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="estimates, payroll, 990"><button class="btn">Search</button></form><p class="muted small" style="margin-top:12px">Searches deadlines, services, people, field notes, records and documents.</p></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "deadlines:Deadlines:title:summary,services:Services:name:summary,people:People:name:focus,notes:Field notes:title:summary,records:Records to keep:name:why,documents:Documents:name:summary,industries:Who we serve:name:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au != "staff" or in_staff %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "clients" %} <span class="chip lock">🔒 Clients</span>{% elsif au == "staff" %} <span class="chip staff">Staff</span>{% endif %}<p>{% if x.summary %}{{ x.summary | strip_html | truncate: 150 }}{% elsif x.why %}{{ x.why }}{% else %}{{ x.focus }}{% endif %}</p></a>{% endif %}{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=estimate">estimate</a>, <a href="?q=payroll">payroll</a>, <a href="?q=990">990</a> or <a href="?q=keep">keep</a>.</p>{% endif %}</div></div></section>
