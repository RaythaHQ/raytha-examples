{%- assign in_client=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "clients" -%}{%- assign in_client=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_client=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_client=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Documents</li></ol><p class="kick">Documents</p><h1>Checklists, how-tos and procedures</h1><p class="lede">Some documents are for everyone. Client checklists and organizer help need a portal sign-in; staff procedures appear only for staff.</p></div></div><section class="sec tight"><div class="w"><div class="grid2">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_client == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}{% if au != "staff" or in_staff %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "clients" and in_client == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<a class="doc" href="{{ PathBase }}/{{ r.RoutePath }}">{% if au == "clients" %}<span class="chip lock">🔒 Clients</span>{% elsif au == "staff" %}<span class="chip staff">Staff</span>{% else %}<span class="chip">Everyone</span>{% endif %}<span class="chip">{% capture lv35 -%}{{ x.kind }}{%- endcapture %}{% case lv35 %}{% when "checklist" %}Checklist{% when "howto" %}How-to{% when "policy" %}Policy{% when "procedure" %}Procedure{% when "template" %}Template{% else %}{{ lv35 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
