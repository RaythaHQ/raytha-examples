{%- comment -%} Meridian Hub base layout. The whole portal sits behind sign-in: only members of the "employees" user group (or admins) get the page body. Everyone else gets the sign-in landing; the page HTML is rendered on the server and thrown away, never sent. Templates that must stay public (the sign-in pages) set gate_open. {%- endcomment -%}
{%- assign is_emp = false -%}{%- assign is_mgr = false -%}
{%- for g in CurrentUser.UserGroups -%}{%- if g == "employees" -%}{%- assign is_emp = true -%}{%- endif -%}{%- if g == "managers" -%}{%- assign is_mgr = true -%}{%- endif -%}{%- endfor -%}
{%- if CurrentUser.IsAdmin -%}{%- assign is_emp = true -%}{%- assign is_mgr = true -%}{%- endif -%}
{%- assign gate_open = false -%}
{%- capture rp %}{{ Target.RoutePath }}{% endcapture -%}{%- if rp == "home" -%}{%- assign rp = "" -%}{%- endif -%}
{%- capture page_body %}{% renderbody %}{% endcapture -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{% if is_emp %}{% if Target.PrimaryField %}{{ Target.PrimaryField }} · {% elsif Target.Label %}{{ Target.Label }} · {% elsif Target.Title and rp != "" %}{{ Target.Title }} · {% endif %}{% elsif gate_open %}Sign in · {% endif %}Meridian Hub</title>
  <meta name="description" content="Meridian Hub, the employee portal for Meridian Waterworks.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ PathBase }}/raytha_default_2026/assets/css/bootstrap-icons.min.css">
  <style>@font-face{font-display:block;font-family:"bootstrap-icons";src:url("{{ PathBase }}/raytha_default_2026/assets/fonts/bootstrap-icons.woff2") format("woff2"),url("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/fonts/bootstrap-icons.woff2") format("woff2")}</style>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='%2318a594'/%3E%3Ccircle cx='32' cy='32' r='20' fill='none' stroke='white' stroke-width='5'/%3E%3Cpath d='M32 12c-8 7-12 13-12 20s4 13 12 20' fill='none' stroke='white' stroke-width='5'/%3E%3C/svg%3E">
  <style>:root{--bg:#f2f5f4;--panel:#fff;--ink:#0d1f26;--ink2:#33464e;--mut:#6a7a81;--line:#e1e7e5;--line2:#edf1f0; --deep:#0a2a36;--deep2:#0f3a4b;--teal:#18a594;--teal2:#0d8577;--mint:#dbf2ec;--coral:#ef6a4e;--coral2:#fde6df;--amber:#f2b33d;--amber2:#fdf0d3;--sky:#3b82f6;--sky2:#e3edff;--vio:#7c3aed; --r:18px;--sans:"Geist",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;--mono:"Geist Mono",ui-monospace,SFMono-Regular,monospace; --sh:0 1px 2px rgba(13,31,38,.04),0 10px 30px -18px rgba(13,31,38,.25);--ease:cubic-bezier(.2,.7,.2,1)} *{box-sizing:border-box}html{-webkit-text-size-adjust:100%} body{margin:0;background:var(--bg);color:var(--ink);font:15.5px/1.6 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip} a{color:inherit;text-decoration:none}img{max-width:100%;display:block}button{font:inherit} h1,h2,h3,h4{margin:0;line-height:1.15;letter-spacing:-.025em;font-weight:650} p{margin:0 0 .9em} .kick{font:600 .7rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--mut)} .mut{color:var(--mut)}.mono{font-family:var(--mono)} .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)} /* app shell */ .app{display:grid;grid-template-columns:268px minmax(0,1fr);min-height:100vh;background:linear-gradient(90deg,var(--deep) 268px,transparent 268px)} .side{position:sticky;top:0;height:100vh;background:radial-gradient(120% 60% at 0% 0%,#12495c 0%,transparent 60%),var(--deep);color:#b9d0d5;display:flex;flex-direction:column;padding:18px 14px 14px;overflow:auto;z-index:60} .brand{display:flex;align-items:center;gap:11px;padding:6px 8px 18px;color:#fff} .brand b{display:block;font-size:1.06rem;letter-spacing:-.02em;font-weight:650;line-height:1.1}.brand small{display:block;font-size:.72rem;color:#8fb0b8;letter-spacing:.01em} .mark{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#1fc2ad,#0e7f73);display:grid;place-items:center;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);flex:none} .navg{margin:14px 0 4px;padding:0 10px;font:600 .64rem/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#6f949d} .nav a{display:flex;align-items:center;gap:11px;padding:8px 10px;border-radius:10px;color:#c8dbdf;font-weight:500;font-size:.93rem;transition:background .2s,color .2s} .nav a i{font-size:1.02rem;width:20px;text-align:center;color:#7fb2b9} .nav a:hover{background:rgba(255,255,255,.06);color:#fff} .nav a.on{background:rgba(31,194,173,.16);color:#fff;box-shadow:inset 2px 0 0 #2fd3bd}.nav a.on i{color:#4fe0cb} .nav a .cnt{margin-left:auto;font:600 .68rem/1 var(--mono);background:rgba(255,255,255,.1);padding:4px 7px;border-radius:99px;color:#d6e7ea} .nav a .cnt.warn{background:var(--amber);color:#3b2a00} .me{margin-top:auto;padding:12px;border-radius:14px;background:rgba(255,255,255,.06);display:flex;align-items:center;gap:10px} .me .av{width:38px;height:38px} .me b{display:block;color:#fff;font-weight:600;font-size:.9rem;line-height:1.2}.me small{display:block;font-size:.72rem;color:#8fb0b8;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:140px} .me a.out{margin-left:auto;color:#8fb0b8;font-size:1.1rem;padding:4px}.me a.out:hover{color:#fff} .av{border-radius:50%;display:grid;place-items:center;font-weight:650;font-size:.82rem;color:#fff;background:linear-gradient(135deg,var(--teal),#2563eb);flex:none;overflow:hidden} .av img{width:100%;height:100%;object-fit:cover} .top{position:sticky;top:0;z-index:50;height:66px;display:flex;align-items:center;gap:14px;padding:0 32px;background:rgba(242,245,244,.82);backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--line)} .top .tog{display:none;background:none;border:0;font-size:1.5rem;padding:4px;color:var(--ink);cursor:pointer} .srch{flex:1;max-width:560px;position:relative} .srch input{width:100%;height:42px;border-radius:12px;border:1px solid var(--line);background:#fff;padding:0 70px 0 40px;font:inherit;font-size:.92rem;color:var(--ink);outline:none;transition:border-color .2s,box-shadow .2s} .srch input:focus{border-color:var(--teal);box-shadow:0 0 0 4px rgba(24,165,148,.15)} .srch i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mut)} .srch kbd{position:absolute;right:10px;top:50%;transform:translateY(-50%);font:500 .7rem var(--mono);color:var(--mut);border:1px solid var(--line);border-radius:6px;padding:2px 6px;background:var(--bg)} .top .right{margin-left:auto;display:flex;align-items:center;gap:12px} .spill{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:99px;font-size:.8rem;font-weight:550;background:#fff;border:1px solid var(--line);white-space:nowrap} .dot{width:8px;height:8px;border-radius:50%;background:var(--teal);display:inline-block;flex:none;box-shadow:0 0 0 3px rgba(24,165,148,.18)} .dot.degraded{background:var(--amber);box-shadow:0 0 0 3px rgba(242,179,61,.22)}.dot.maintenance{background:var(--sky);box-shadow:0 0 0 3px rgba(59,130,246,.18)}.dot.outage{background:var(--coral);box-shadow:0 0 0 3px rgba(239,106,78,.22)} .today{font:500 .8rem var(--mono);color:var(--mut);white-space:nowrap} .main{padding:30px 32px 40px;max-width:1380px;width:100%} .foot{padding:28px 32px 36px;color:var(--mut);font-size:.8rem;display:flex;gap:18px;flex-wrap:wrap;border-top:1px solid var(--line);max-width:1380px} .foot a{text-decoration:underline;text-underline-offset:3px} .scrim{display:none} @media(max-width:1020px){.app{grid-template-columns:1fr;background:none}.side{position:fixed;left:0;top:0;bottom:0;width:284px;transform:translateX(-102%);transition:transform .3s var(--ease)} body.nav-open .side{transform:none;box-shadow:30px 0 60px -30px rgba(0,0,0,.5)}body.nav-open .scrim{display:block;position:fixed;inset:0;background:rgba(10,42,54,.45);z-index:55} .top{padding:0 16px}.top .tog{display:block}.today{display:none}.main{padding:22px 16px 36px}.foot{padding:22px 16px 30px}} @media(max-width:640px){.srch kbd{display:none}.spill span.t{display:none}.spill{padding:9px}.srch input{padding-right:12px}} /* building blocks */ .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)} .lift{transition:transform .3s var(--ease),box-shadow .3s,border-color .3s}.lift:hover{transform:translateY(-3px);box-shadow:0 2px 4px rgba(13,31,38,.04),0 24px 40px -24px rgba(13,31,38,.35);border-color:#d3dcda} .ph{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:24px} .ph h1{font-size:clamp(1.75rem,3vw,2.35rem);margin-top:10px;letter-spacing:-.035em} .ph p{margin:8px 0 0;color:var(--ink2);max-width:640px} .crumbs{display:flex;gap:8px;align-items:center;font-size:.82rem;color:var(--mut);margin-bottom:14px;flex-wrap:wrap}.crumbs a:hover{color:var(--ink)}.crumbs i{font-size:.7rem} .chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center} .chips a,.chip{display:inline-flex;align-items:center;gap:7px;padding:7px 13px;border-radius:99px;background:#fff;border:1px solid var(--line);font-size:.84rem;font-weight:520;color:var(--ink2);white-space:nowrap;transition:.2s} .chips a:hover{border-color:#c9d3d1;color:var(--ink)}.chips a.on{background:var(--ink);border-color:var(--ink);color:#fff} .chips .lbl{font:600 .66rem/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--mut);margin-right:4px} .bdg{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:99px;font-size:.72rem;font-weight:600;background:var(--line2);color:var(--ink2);white-space:nowrap;line-height:1.5} .bdg.teal{background:var(--mint);color:#0b6b60}.bdg.coral{background:var(--coral2);color:#a63a22}.bdg.amber{background:var(--amber2);color:#7a5200}.bdg.sky{background:var(--sky2);color:#1d4ed8}.bdg.ink{background:var(--ink);color:#fff}.bdg.vio{background:#efe7ff;color:#5b21b6} .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:42px;padding:0 18px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font-weight:600;font-size:.9rem;cursor:pointer;transition:.2s;white-space:nowrap} .btn:hover{border-color:#c4cfcd;transform:translateY(-1px)} .btn.pri{background:var(--teal);border-color:var(--teal);color:#fff}.btn.pri:hover{background:var(--teal2)} .btn.dark{background:var(--ink);border-color:var(--ink);color:#fff} .btn.sm{height:34px;padding:0 12px;font-size:.82rem;border-radius:10px} .g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.g3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.g4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px} @media(max-width:1180px){.g4{grid-template-columns:repeat(3,minmax(0,1fr))}} @media(max-width:900px){.g3,.g4{grid-template-columns:repeat(2,minmax(0,1fr))}} @media(max-width:600px){.g2,.g3,.g4{grid-template-columns:1fr}} .sh{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:0 0 14px} .sh h2{font-size:1.08rem;letter-spacing:-.02em;display:flex;align-items:center;gap:9px}.sh h2 i{color:var(--teal)} .sh a{font-size:.82rem;font-weight:600;color:var(--teal2);display:inline-flex;gap:5px;align-items:center}.sh a:hover{color:var(--ink)} .dt{width:56px;flex:none;border-radius:13px;overflow:hidden;text-align:center;background:#fff;border:1px solid var(--line)} .dt span{display:block;background:var(--coral);color:#fff;font:600 .62rem/1 var(--mono);letter-spacing:.1em;padding:5px 0 4px;text-transform:uppercase} .dt b{display:block;font-size:1.35rem;line-height:1;padding:7px 0 2px;letter-spacing:-.03em}.dt small{display:block;font-size:.62rem;color:var(--mut);padding-bottom:6px;text-transform:uppercase;letter-spacing:.06em} .prose{font-size:1.02rem;line-height:1.72;color:#1d3038} .prose h3{font-size:1.15rem;margin:1.6em 0 .5em}.prose ul,.prose ol{padding-left:1.25em;margin:0 0 1em}.prose li{margin:.3em 0}.prose li::marker{color:var(--teal)} .prose strong{font-weight:650;color:var(--ink)}.prose a{color:var(--teal2);text-decoration:underline;text-underline-offset:3px} .empty{padding:46px 20px;text-align:center;color:var(--mut)} .lock{display:flex;gap:14px;align-items:center;padding:16px 18px;border-radius:14px;background:repeating-linear-gradient(135deg,#f6f8f7 0 10px,#eff3f2 10px 20px);border:1px dashed #cdd7d5;color:var(--ink2);font-size:.9rem} .lock i{font-size:1.3rem;color:var(--mut)} .reveal{opacity:0;transform:translateY(10px);transition:opacity .6s var(--ease),transform .6s var(--ease)}.reveal.in{opacity:1;transform:none} @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}.reveal{opacity:1;transform:none}} /* Raytha account pages (profile, password) */ .acct{max-width:560px}.acct h3{font-size:1.5rem;margin-bottom:16px} .form-label,.acct label{display:block;font-weight:600;font-size:.86rem;margin:0 0 6px} .form-control,.auth input[type=email],.auth input[type=password],.auth input[type=text]{width:100%;height:46px;border-radius:12px;border:1px solid var(--line);padding:0 14px;font:inherit;background:#fff;color:var(--ink);outline:none;transition:.2s} .form-control:focus,.auth input:focus{border-color:var(--teal);box-shadow:0 0 0 4px rgba(24,165,148,.15)} .mb-3{margin-bottom:16px}.w-100{width:100%}.mt-2{margin-top:10px} .btn-primary{display:inline-flex;align-items:center;justify-content:center;height:46px;padding:0 20px;border:0;border-radius:12px;background:var(--teal);color:#fff;font-weight:650;cursor:pointer} .btn-secondary{display:flex;align-items:center;justify-content:center;height:44px;border-radius:12px;border:1px solid var(--line);background:#fff;font-weight:600;margin:8px 0} .alert,.alert-danger{padding:12px 14px;border-radius:12px;background:var(--coral2);color:#8f2f1a;font-size:.9rem;margin-bottom:14px}.alert-success{background:var(--mint);color:#0b6b60} .invalid-feedback{color:#b23b22;font-size:.8rem}.list-group{list-style:none;padding:0;margin:0}.lead{color:var(--mut);font-size:.9rem;margin:16px 0 4px} .link-secondary{color:var(--mut);font-size:.86rem;text-decoration:underline;text-underline-offset:3px} /* public gate and sign-in */ .gate{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);background:var(--bg)} .gate-l{position:relative;overflow:hidden;background:radial-gradient(90% 70% at 10% 0%,#155b6f 0%,transparent 60%),radial-gradient(70% 60% at 100% 100%,#0f6f63 0%,transparent 55%),var(--deep);color:#d2e4e8;padding:44px 56px;display:flex;flex-direction:column} .gate-l .lines{position:absolute;inset:0;opacity:.5;pointer-events:none} .gate-l .brand{padding:0;position:relative} .gate-l .copy{margin:auto 0;position:relative;max-width:560px;padding:48px 0} .gate-l h1{color:#fff;font-size:clamp(2.3rem,4.4vw,3.6rem);letter-spacing:-.045em;line-height:1.02;margin:18px 0 18px;font-weight:650} .gate-l h1 em{font-style:normal;background:linear-gradient(90deg,#5ff0d8,#9be7ff);-webkit-background-clip:text;background-clip:text;color:transparent} .gate-l p.lede{font-size:1.1rem;color:#b9d2d8;max-width:500px} .gate-l .feats{display:grid;grid-template-columns:1fr 1fr;gap:12px 22px;margin:26px 0 30px;padding:0;list-style:none;font-size:.92rem} .gate-l .feats li{display:flex;gap:10px;align-items:center}.gate-l .feats i{width:30px;height:30px;border-radius:9px;background:rgba(95,240,216,.12);color:#5ff0d8;display:grid;place-items:center;font-size:.95rem;flex:none} .gate-l .note{position:relative;font-size:.8rem;color:#86a8b0} .gate-l .kick{color:#7fd9cb} .gate-r{display:grid;place-items:center;padding:40px;position:relative;overflow:hidden} .auth{width:min(430px,100%);padding:34px 32px} .auth h3{font-size:1.6rem;letter-spacing:-.03em;margin:0 0 6px} .auth .sub{color:var(--mut);font-size:.92rem;margin-bottom:22px} .auth label{display:block;font-weight:600;font-size:.84rem;margin:14px 0 6px} .auth button[type=submit]{width:100%;margin-top:20px;height:48px;border:0;border-radius:12px;background:var(--teal);color:#fff;font-weight:650;font-size:.96rem;cursor:pointer} .auth button[type=submit]:hover{background:var(--teal2)} .auth .sso{display:flex;align-items:center;justify-content:center;gap:10px;height:46px;border-radius:12px;border:1px solid var(--line);background:#fff;font-weight:600;margin-top:10px} .auth .or{display:flex;align-items:center;gap:12px;color:var(--mut);font-size:.78rem;margin:20px 0 4px}.auth .or::before,.auth .or::after{content:"";flex:1;height:1px;background:var(--line)} .collage{position:relative;width:min(520px,100%);height:560px} .collage .c{position:absolute;background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 60px -30px rgba(13,31,38,.35);padding:16px} .collage .sk{height:9px;border-radius:9px;background:var(--line2);margin:8px 0}.collage .sk.s{width:55%}.collage .sk.m{width:78%} .collage .c1{left:0;top:30px;width:330px;transform:rotate(-3deg);animation:bob 7s ease-in-out infinite} .collage .c2{right:0;top:0;width:220px;transform:rotate(4deg);animation:bob 8s ease-in-out infinite -2s} .collage .c3{left:60px;top:300px;width:380px;transform:rotate(1.5deg);animation:bob 9s ease-in-out infinite -4s} .collage .c4{right:6px;top:230px;width:190px;transform:rotate(-5deg);animation:bob 7.5s ease-in-out infinite -1s} .collage .ban{height:110px;border-radius:12px;background:linear-gradient(135deg,#0f3a4b,#18a594);margin-bottom:12px} .collage .row{display:flex;gap:10px;align-items:center;margin:10px 0}.collage .row .av{width:34px;height:34px} @keyframes bob{50%{translate:0 -10px}} @media(max-width:960px){.gate{grid-template-columns:1fr}.gate-l{padding:28px 22px}.gate-l .copy{padding:36px 0 20px}.gate-l .feats{grid-template-columns:1fr}.gate-r{padding:28px 16px 48px}.collage{display:none}}</style>
</head>
{%- if is_emp %}
{%- assign sys = get_content_items(ContentType="systems", OrderBy="sort_order asc", PageSize=50) -%}
{%- assign issues = 0 -%}{%- for s in sys.Items %}{% capture st %}{{ s.PublishedContent.status }}{% endcapture %}{% if st != "operational" %}{% assign issues = issues | plus: 1 %}{% endif %}{% endfor -%}
{%- assign seg = rp | split: "/" | first -%}
{%- assign icons = "/=house,/news=megaphone,/events=calendar-event,/people=person-vcard,/departments=diagram-3,/handbook=journal-text,/resources=folder2-open,/it-help=life-preserver,/status=activity,/company=buildings,/search=search" | split: "," -%}
<body class="app-body">
<div class="app">
  <aside class="side" id="side" aria-label="Main navigation">
    <a class="brand" href="{{ PathBase }}/"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5c-3 2.6-4.5 5.4-4.5 8.5s1.5 5.9 4.5 8.5"/><path d="M3.8 9.5h16.4M3.8 14.5h16.4" opacity=".55"/></svg></span><span><b>Meridian Hub</b><small>Meridian Waterworks</small></span></a>
    <nav class="nav">
      <div class="navg">Workspace</div>
      {%- assign menu = get_main_menu() -%}
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase %}{% assign us = u | remove_first: "/" %}{% assign ic = "dot" %}{% for p in icons %}{% assign kv = p | split: "=" %}{% if kv[0] == u %}{% assign ic = kv[1] %}{% endif %}{% endfor %}
        {%- if forloop.index == 4 %}<div class="navg">People</div>{% elsif forloop.index == 6 %}<div class="navg">Knowledge</div>{% endif %}
        <a href="{{ mi.Url }}" class="{% if us == seg %}on{% endif %}"><i class="bi bi-{{ ic }}"></i>{{ mi.Label }}{% if u == "/status" and issues > 0 %}<span class="cnt warn">{{ issues }}</span>{% endif %}</a>
      {%- endfor %}
    </nav>
    {%- assign ql = get_menu("quicklinks") -%}
    {%- if ql.MenuItems.size > 0 %}
    <div class="navg" style="margin-top:18px">Quick links</div>
    <nav class="nav">{% for mi in ql.MenuItems %}<a href="{{ mi.Url }}"><i class="bi bi-box-arrow-up-right" style="font-size:.8rem"></i>{{ mi.Label }}</a>{% endfor %}</nav>
    {%- endif %}
    <div class="me" style="margin-top:22px">
      <span class="av">{{ CurrentUser.FirstName | slice: 0 }}{{ CurrentUser.LastName | slice: 0 }}</span>
      <div style="min-width:0"><b>{{ CurrentUser.FullName }}</b><small>{% if is_mgr %}People manager · {% endif %}{{ CurrentUser.EmailAddress }}</small></div>
      <a class="out" href="{{ PathBase }}/account/logout" title="Sign out"><i class="bi bi-box-arrow-right"></i><span class="sr">Sign out</span></a>
    </div>
  </aside>
  <div class="scrim" onclick="document.body.classList.remove('nav-open')"></div>
  <div style="min-width:0">
    <header class="top">
      <button class="tog" type="button" aria-label="Open navigation" onclick="document.body.classList.toggle('nav-open')"><i class="bi bi-list"></i></button>
      <form class="srch" action="{{ PathBase }}/search" method="get" role="search"><i class="bi bi-search"></i><input type="search" name="q" placeholder="Search people, news, policies, help…" aria-label="Search Meridian Hub" value="{{ QueryParams.q | escape }}"><kbd>/</kbd></form>
      <div class="right">
        <a class="spill" href="{{ PathBase }}/status">{% if issues > 0 %}<span class="dot degraded"></span><span class="t">{{ issues }} system{% if issues != 1 %}s{% endif %} need attention</span>{% else %}<span class="dot"></span><span class="t">All systems normal</span>{% endif %}</a>
        <span class="today">{{ "now" | date: "%a, %b %-d" }}</span>
      </div>
    </header>
    <main class="main" id="main">{{ page_body }}</main>
    <footer class="foot"><span>Meridian Hub · for Meridian Waterworks employees only</span><a href="{{ PathBase }}/company">About the company</a><a href="{{ PathBase }}/it-help">Get IT help</a><a href="{{ PathBase }}/account/me">My account</a><span style="margin-left:auto">Built with Raytha</span></footer>
  </div>
</div>
{%- elsif gate_open %}
<body>
<div class="gate">
  <section class="gate-l"><svg class="lines" viewBox="0 0 800 900" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="#5ff0d8" stroke-opacity=".14"><ellipse cx="640" cy="160" rx="80" ry="80"/><ellipse cx="640" cy="160" rx="150" ry="150"/><ellipse cx="640" cy="160" rx="220" ry="220"/><ellipse cx="640" cy="160" rx="290" ry="290"/><ellipse cx="640" cy="160" rx="360" ry="360"/><ellipse cx="640" cy="160" rx="430" ry="430"/><ellipse cx="640" cy="160" rx="500" ry="500"/><ellipse cx="640" cy="160" rx="570" ry="570"/><ellipse cx="640" cy="160" rx="640" ry="640"/><ellipse cx="640" cy="160" rx="710" ry="710"/></g></svg>
    <a class="brand" href="{{ PathBase }}/"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5c-3 2.6-4.5 5.4-4.5 8.5s1.5 5.9 4.5 8.5"/><path d="M3.8 9.5h16.4M3.8 14.5h16.4" opacity=".55"/></svg></span><span><b>Meridian Hub</b><small>Meridian Waterworks</small></span></a>
    <div class="copy"><span class="kick">Employee portal</span><h1>Welcome back to <em>Meridian Hub.</em></h1><p class="lede">Sign in with your Meridian account to see company news, find colleagues, read the handbook and get IT help.</p><ul class="feats"><li><i class="bi bi-megaphone"></i>Company news</li><li><i class="bi bi-person-vcard"></i>People directory</li><li><i class="bi bi-journal-text"></i>Handbook and policies</li><li><i class="bi bi-calendar-event"></i>Events and town halls</li><li><i class="bi bi-folder2-open"></i>Templates and documents</li><li><i class="bi bi-life-preserver"></i>IT help and system status</li></ul></div>
    <p class="note">For Meridian Waterworks employees and contractors. Trouble signing in? Call the IT service desk on extension 4357.</p>
  </section>
  <section class="gate-r"><div class="card auth">{{ page_body }}</div></section>
</div>
{%- else %}
<body>
<div class="gate">
  <section class="gate-l"><svg class="lines" viewBox="0 0 800 900" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="#5ff0d8" stroke-opacity=".14"><ellipse cx="640" cy="160" rx="80" ry="80"/><ellipse cx="640" cy="160" rx="150" ry="150"/><ellipse cx="640" cy="160" rx="220" ry="220"/><ellipse cx="640" cy="160" rx="290" ry="290"/><ellipse cx="640" cy="160" rx="360" ry="360"/><ellipse cx="640" cy="160" rx="430" ry="430"/><ellipse cx="640" cy="160" rx="500" ry="500"/><ellipse cx="640" cy="160" rx="570" ry="570"/><ellipse cx="640" cy="160" rx="640" ry="640"/><ellipse cx="640" cy="160" rx="710" ry="710"/></g></svg>
    <a class="brand" href="{{ PathBase }}/"><span class="mark"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5c-3 2.6-4.5 5.4-4.5 8.5s1.5 5.9 4.5 8.5"/><path d="M3.8 9.5h16.4M3.8 14.5h16.4" opacity=".55"/></svg></span><span><b>Meridian Hub</b><small>Meridian Waterworks</small></span></a>
    <div class="copy">
      <span class="kick">Employee portal · sign-in required</span>
      <h1>Everything you need at work, <em>in one place.</em></h1>
      <p class="lede">Meridian Hub is the intranet for everyone at Meridian Waterworks, in Austin, Tulsa, Denver, Rotterdam and at home.</p>
      <ul class="feats"><li><i class="bi bi-megaphone"></i>Company news</li><li><i class="bi bi-person-vcard"></i>People directory</li><li><i class="bi bi-journal-text"></i>Handbook and policies</li><li><i class="bi bi-calendar-event"></i>Events and town halls</li><li><i class="bi bi-folder2-open"></i>Templates and documents</li><li><i class="bi bi-life-preserver"></i>IT help and system status</li></ul>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn pri" style="height:50px;padding:0 24px;font-size:1rem" href="{{ PathBase }}/account/login?returnUrl={{ PathBase }}/{{ rp }}">Sign in to Meridian Hub <i class="bi bi-arrow-right"></i></a>
        {% if CurrentUser.IsAuthenticated %}<a class="btn" style="height:50px;background:transparent;color:#fff;border-color:rgba(255,255,255,.25)" href="{{ PathBase }}/account/logout">Sign out</a>{% endif %}
      </div>
      {% if CurrentUser.IsAuthenticated %}<p style="margin-top:16px;font-size:.88rem;color:#f5c9bd"><i class="bi bi-exclamation-circle"></i> You are signed in as {{ CurrentUser.EmailAddress }}, but this account is not in the Employees group yet. Ask the service desk to add it.</p>{% endif %}
    </div>
    <p class="note">For Meridian Waterworks employees and contractors. Meridian Waterworks is a fictional company in a Raytha demo.</p>
  </section>
  <section class="gate-r" aria-hidden="true">
    <div class="collage">
      <div class="c c1"><div class="ban"></div><span class="kick">Announcements</span><div class="sk m"></div><div class="sk s"></div></div>
      <div class="c c2"><span class="kick">This week</span><div class="row"><div class="dt"><span>Oct</span><b>15</b><small>Thu</small></div><div style="flex:1"><div class="sk"></div><div class="sk s"></div></div></div><div class="row"><div class="dt"><span>Oct</span><b>22</b><small>Thu</small></div><div style="flex:1"><div class="sk"></div><div class="sk s"></div></div></div></div>
      <div class="c c3"><span class="kick">People</span><div class="row"><span class="av" style="background:linear-gradient(135deg,#e0663f,#f2b33d)"></span><div style="flex:1"><div class="sk m"></div><div class="sk s"></div></div></div><div class="row"><span class="av" style="background:linear-gradient(135deg,#2563eb,#18a594)"></span><div style="flex:1"><div class="sk m"></div><div class="sk s"></div></div></div><div class="row"><span class="av" style="background:linear-gradient(135deg,#7c3aed,#be185d)"></span><div style="flex:1"><div class="sk m"></div><div class="sk s"></div></div></div></div>
      <div class="c c4"><span class="kick">Status</span><div class="row"><span class="dot"></span><div class="sk" style="flex:1"></div></div><div class="row"><span class="dot"></span><div class="sk" style="flex:1"></div></div><div class="row"><span class="dot degraded"></span><div class="sk s" style="flex:1"></div></div></div>
    </div>
  </section>
</div>
{%- endif %}
<script>
(function(){
  var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -40px 0px'}):null;
  document.querySelectorAll('.reveal').forEach(function(el){io?io.observe(el):el.classList.add('in')});
  document.addEventListener('keydown',function(e){var s=document.querySelector('.srch input');if(e.key==='/'&&s&&document.activeElement.tagName!=='INPUT'&&document.activeElement.tagName!=='TEXTAREA'){e.preventDefault();s.focus()}if(e.key==='Escape')document.body.classList.remove('nav-open')});
  var h=new Date().getHours(),g=document.querySelector('[data-greet]');if(g)g.textContent=h<12?'Good morning':h<18?'Good afternoon':'Good evening';
  var ack=[];try{ack=JSON.parse(localStorage.getItem('mh:ack')||'[]')}catch(e){}
  document.querySelectorAll('[data-ack]').forEach(function(el){if(ack.indexOf(el.getAttribute('data-ack'))>-1)el.classList.add('acked')});
  var n=document.querySelectorAll('[data-todo]:not(.acked)').length;document.querySelectorAll('[data-todo-count]').forEach(function(c){c.textContent=n});
})();
</script>
</body>
</html>
