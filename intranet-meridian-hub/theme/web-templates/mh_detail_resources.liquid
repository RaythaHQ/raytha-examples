{%- assign rkinds = "template:Template,guide:Guide,form:Form,brand:Brand asset,deck:Slide deck" | split: "," -%}
{%- assign r = Target.PublishedContent -%}{%- capture kv2 %}{{ r.kind }}{% endcapture -%}{%- assign kl = kv2 -%}{%- for kv in rkinds %}{% assign pr = kv | split: ":" %}{% if pr[0] == kv2 %}{% assign kl = pr[1] %}{% endif %}{% endfor -%}{% capture mo %}{{ r.managers_only }}{% endcapture %}
<nav class="crumbs"><a href="{{ PathBase }}/">Home</a><i class="bi bi-chevron-right"></i><a href="{{ PathBase }}/resources">Resources</a><i class="bi bi-chevron-right"></i><span>{{ Target.PrimaryField | truncate: 48 }}</span></nav>
{%- if mo == "True" and is_mgr == false %}
<div class="card" style="padding:56px 28px;text-align:center;max-width:720px;margin:10px auto"><span style="width:64px;height:64px;border-radius:18px;background:#efe7ff;color:#6d28d9;display:inline-grid;place-items:center;font-size:1.8rem"><i class="bi bi-person-badge"></i></span><h1 style="font-size:1.8rem;margin:16px 0 8px">This document is for people managers</h1><p class="mut" style="max-width:460px;margin:0 auto 20px">It's only available to the People managers group.</p><a class="btn" href="{{ PathBase }}/resources">Back to resources</a></div>
{%- else %}
<div class="dg">
  <article class="card" style="padding:30px 32px">
    <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap"><span class="doc"><i class="bi bi-file-earmark-pdf"></i><small>{{ r.file_format }}</small></span><div style="flex:1;min-width:220px"><div class="chips" style="gap:6px"><span class="bdg teal">{{ kl }}</span>{% if mo == "True" %}<span class="bdg vio">Managers only</span>{% endif %}</div><h1 style="font-size:clamp(1.6rem,2.8vw,2.2rem);letter-spacing:-.04em;margin:10px 0 6px">{{ Target.PrimaryField }}</h1><p class="mut" style="margin:0">{{ r.summary }}</p></div></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin:24px 0;padding:18px 0;border-top:1px solid var(--line2);border-bottom:1px solid var(--line2)"><a class="btn pri" href="{{ r.file.Value | attachment_redirect_url }}" download><i class="bi bi-download"></i> Download</a><a class="btn" href="{{ r.file.Value | attachment_redirect_url }}" target="_blank" rel="noopener"><i class="bi bi-eye"></i> Open in a new tab</a></div>
    <div class="prose">{{ r.body }}</div>
  </article>
  <aside><div class="card" style="padding:18px 20px"><span class="kick">Details</span><div class="mi" style="margin-top:8px"><div><span>Owner</span><span><a href="{{ PathBase }}/{{ r.department.RoutePath }}" style="color:var(--teal2)">{{ r.department.PrimaryField }}</a></span></div><div><span>Format</span><span>{{ r.file_format }}</span></div><div><span>Updated</span><span>{{ r.updated_on.Value | date: "%b %-d, %Y" }}</span></div><div><span>Kind</span><span>{{ kl }}</span></div></div></div></aside>
</div>
{%- endif %}
<style>.doc{width:92px;height:116px;border-radius:14px;background:linear-gradient(160deg,#fff,#f1f5f4);border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:2.2rem;color:#d1453b;box-shadow:var(--sh);position:relative}.doc small{font:600 .62rem var(--mono);color:var(--mut);text-transform:uppercase;letter-spacing:.08em}</style>
<style>.dg{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:22px;align-items:start}.dg>aside{display:flex;flex-direction:column;gap:18px;position:sticky;top:86px}
.mi{display:flex;flex-direction:column;gap:0}.mi div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line2);font-size:.86rem}.mi div:first-child{border-top:0}.mi div span:first-child{color:var(--mut)}.mi div span:last-child{text-align:right;font-weight:550}
.li{display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line2);font-size:.9rem}.li:first-of-type{border-top:0}.li img{width:36px;height:36px;border-radius:50%}.li b{font-weight:600;display:block;line-height:1.25}.li small{color:var(--mut);font-size:.78rem;display:block;line-height:1.3}
@media(max-width:1020px){.dg{grid-template-columns:1fr}.dg>aside{position:static}}</style>
