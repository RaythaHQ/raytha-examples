{%- assign stat = "operational:Operational,degraded:Degraded,maintenance:Planned maintenance,outage:Outage" | split: "," -%}
{%- assign s = Target.PublishedContent -%}{%- capture sv %}{{ s.status }}{% endcapture -%}{%- assign sl = sv -%}{%- for kv in stat %}{% assign pr = kv | split: ":" %}{% if pr[0] == sv %}{% assign sl = pr[1] %}{% endif %}{% endfor -%}
<nav class="crumbs"><a href="{{ PathBase }}/">Home</a><i class="bi bi-chevron-right"></i><a href="{{ PathBase }}/status">System status</a><i class="bi bi-chevron-right"></i><span>{{ Target.PrimaryField | truncate: 48 }}</span></nav>
<div class="card" style="padding:30px 32px;max-width:760px"><div style="display:flex;gap:16px;align-items:center"><span style="width:56px;height:56px;border-radius:16px;background:var(--line2);display:grid;place-items:center;font-size:1.5rem"><i class="bi bi-{{ s.icon }}"></i></span><div><h1 style="font-size:1.8rem;letter-spacing:-.035em">{{ Target.PrimaryField }}</h1><p class="mut" style="margin:2px 0 0">{{ s.description }}</p></div></div>
  <div style="display:flex;gap:10px;align-items:center;margin-top:22px;padding:16px 18px;border-radius:14px;background:var(--bg)"><span class="dot {{ sv }}"></span><b>{{ sl }}</b>{% capture nt %}{{ s.note | strip }}{% endcapture %}{% if nt != "" %}<span class="mut">· {{ s.note }}</span>{% endif %}</div>
  <a class="btn" style="margin-top:18px" href="{{ PathBase }}/status"><i class="bi bi-arrow-left"></i> All systems</a></div>
