{%- assign offices = "austin:Austin HQ,tulsa:Tulsa plant,denver:Denver,rotterdam:Rotterdam,remote:Remote" | split: "," -%}
{%- assign d = Target.PublishedContent -%}{%- capture df %}department eq '{{ Target.Id | append: "" }}'{% endcapture -%}{%- capture of %}owner eq '{{ Target.Id | append: "" }}'{% endcapture -%}
{%- assign team = get_content_items(ContentType="people", Filter=df, OrderBy="sort_order asc", PageSize=40) -%}
{%- assign news = get_content_items(ContentType="announcements", Filter=df, OrderBy="posted_on desc", PageSize=4) -%}
{%- assign pols = get_content_items(ContentType="policies", Filter=of, OrderBy="sort_order asc", PageSize=20) -%}
{%- assign docs = get_content_items(ContentType="resources", Filter=df, OrderBy="updated_on desc", PageSize=10) -%}
<nav class="crumbs"><a href="{{ PathBase }}/">Home</a><i class="bi bi-chevron-right"></i><a href="{{ PathBase }}/departments">Departments</a><i class="bi bi-chevron-right"></i><span>{{ Target.PrimaryField | truncate: 48 }}</span></nav>
<section class="dh reveal" style="--c:{{ d.color }}"><div class="ic"><i class="bi bi-{{ d.icon }}"></i></div><div style="flex:1;min-width:0"><span class="kick" style="color:rgba(255,255,255,.7)">Department</span><h1>{{ Target.PrimaryField }}</h1><p>{{ d.summary }}</p></div>
  <div class="ds"><div><b>{{ d.headcount }}</b><span>people</span></div><div><b>{{ team.TotalCount }}</b><span>in the directory</span></div><div><b style="font-size:1rem">{{ d.location }}</b><span>main office</span></div></div></section>
<div class="dg">
  <div style="display:flex;flex-direction:column;gap:22px;min-width:0">
    <section class="card" style="padding:24px 26px"><span class="kick">What we do</span><div class="prose" style="margin-top:10px">{{ d.mission }}</div></section>
    <section><div class="sh"><h2><i class="bi bi-people"></i> People</h2><a href="{{ PathBase }}/people?dept={{ Target.RoutePath | split: '/' | last }}">In the directory <i class="bi bi-arrow-right"></i></a></div>
      <div class="g3">{% for x in team.Items %}<a class="card lift" href="{{ PathBase }}/{{ x.RoutePath }}" style="display:flex;gap:12px;align-items:center;padding:12px"><img src="{{ x.PublishedContent.photo.Value | attachment_redirect_url }}" alt="" style="width:50px;height:50px;border-radius:13px"><span style="min-width:0"><b style="display:block;font-weight:600;line-height:1.25">{{ x.PrimaryField }}</b><small class="mut" style="font-size:.8rem;line-height:1.3;display:block">{{ x.PublishedContent.job_title }}</small></span></a>{% endfor %}</div></section>
    {% if news.TotalCount > 0 %}<section><div class="sh"><h2><i class="bi bi-megaphone"></i> Recent news</h2></div><div class="g2">{% for x in news.Items %}<a class="card lift" href="{{ PathBase }}/{{ x.RoutePath }}" style="padding:16px 18px;display:block"><small class="mono mut" style="font-size:.72rem">{{ x.PublishedContent.posted_on.Value | date: "%b %-d" }}</small><b style="display:block;font-weight:600;margin-top:4px;line-height:1.35">{{ x.PrimaryField }}</b></a>{% endfor %}</div></section>{% endif %}
  </div>
  <aside>
    <div class="card" style="padding:18px 20px"><span class="kick">Get in touch</span><div class="mi" style="margin-top:8px"><div><span>Team email</span><span><a href="mailto:{{ d.email }}" style="color:var(--teal2)">{{ d.email }}</a></span></div><div><span>Chat</span><span class="mono">{{ d.channel }}</span></div><div><span>Main office</span><span>{{ d.location }}</span></div></div></div>
    {% if pols.TotalCount > 0 %}<div class="card" style="padding:18px 20px"><span class="kick">Policies we own</span>{% for x in pols.Items %}{% capture mo %}{{ x.PublishedContent.managers_only }}{% endcapture %}{% if mo != "True" or is_mgr %}<a class="li" href="{{ PathBase }}/{{ x.RoutePath }}" style="{% if forloop.first %}border-top:0;margin-top:8px{% endif %}"><i class="bi bi-journal-text" style="color:var(--teal)"></i><span><b>{{ x.PrimaryField }}</b></span></a>{% endif %}{% endfor %}</div>{% endif %}
    {% if docs.TotalCount > 0 %}<div class="card" style="padding:18px 20px"><span class="kick">Documents</span>{% for x in docs.Items %}{% capture mo %}{{ x.PublishedContent.managers_only }}{% endcapture %}{% if mo != "True" or is_mgr %}<a class="li" href="{{ PathBase }}/{{ x.RoutePath }}" style="{% if forloop.first %}border-top:0;margin-top:8px{% endif %}"><i class="bi bi-file-earmark-arrow-down" style="color:var(--teal)"></i><span><b>{{ x.PrimaryField }}</b></span></a>{% endif %}{% endfor %}</div>{% endif %}
  </aside>
</div>
<style>.dh{display:flex;gap:22px;align-items:center;flex-wrap:wrap;border-radius:22px;padding:28px 30px;margin-bottom:22px;color:#fff;background:radial-gradient(80% 140% at 100% 0%,rgba(255,255,255,.18),transparent 60%),linear-gradient(120deg,var(--c),#0a2a36 120%)}
.dh .ic{width:68px;height:68px;border-radius:20px;background:rgba(255,255,255,.16);display:grid;place-items:center;font-size:2rem;flex:none}
.dh h1{font-size:clamp(1.7rem,3vw,2.4rem);letter-spacing:-.04em;margin:8px 0 6px}.dh p{margin:0;color:rgba(255,255,255,.82);max-width:620px}
.ds{display:flex;gap:10px;flex-wrap:wrap}.ds div{background:rgba(255,255,255,.12);border-radius:14px;padding:12px 16px;min-width:110px}.ds b{display:block;font-size:1.5rem;letter-spacing:-.03em;line-height:1.1}.ds span{font-size:.74rem;color:rgba(255,255,255,.75)}</style>
<style>.dg{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:22px;align-items:start}.dg>aside{display:flex;flex-direction:column;gap:18px;position:sticky;top:86px}
.mi{display:flex;flex-direction:column;gap:0}.mi div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid var(--line2);font-size:.86rem}.mi div:first-child{border-top:0}.mi div span:first-child{color:var(--mut)}.mi div span:last-child{text-align:right;font-weight:550}
.li{display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line2);font-size:.9rem}.li:first-of-type{border-top:0}.li img{width:36px;height:36px;border-radius:50%}.li b{font-weight:600;display:block;line-height:1.25}.li small{color:var(--mut);font-size:.78rem;display:block;line-height:1.3}
@media(max-width:1020px){.dg{grid-template-columns:1fr}.dg>aside{position:static}}</style>
