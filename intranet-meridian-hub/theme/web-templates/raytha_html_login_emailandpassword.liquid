<h3>Sign in</h3>
<p class="sub">Use your Meridian email address and password.</p>
{% if Target.ValidationFailures["__ValidationSummary"] %}<div class="alert"><i class="bi bi-exclamation-circle"></i> {{ Target.ValidationFailures["__ValidationSummary"] }}</div>{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post">
  <label for="email">Work email</label>
  <input id="email" type="email" name="EmailAddress" autocomplete="username" placeholder="you@meridian.example" required>
  <label for="password">Password</label>
  <input id="password" type="password" name="Password" autocomplete="current-password" required>
  <button type="submit">Sign in</button>
  <input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form>
<p style="margin:16px 0 0;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><a class="link-secondary" href="{{ PathBase }}/account/login/forgot-password/begin">Forgot password?</a><span class="mut" style="font-size:.84rem">Service desk: x4357</span></p>
{% if Target.ShowOrLoginWithSection %}
  <div class="or">or</div>
  {% if Target.HasLoginBySingleSignOn %}{% for sso in Target.SingleSignOns %}<a class="sso" href="{{ PathBase }}/account/login/sso/{{ sso.DeveloperName }}"><i class="bi bi-shield-lock"></i> {{ sso.LoginButtonText }}</a>{% endfor %}{% endif %}
  {% if Target.HasLoginByMagicLink %}<a class="sso" href="{{ PathBase }}/account/login/magic-link"><i class="bi bi-envelope"></i> {{ Target.MagicLink.LoginButtonText }}</a>{% endif %}
{% endif %}
<p class="mut" style="font-size:.78rem;margin:22px 0 0;border-top:1px solid var(--line);padding-top:14px">Accounts are created by IT when you join. There is no public sign-up.</p>
