<section style="margin-bottom:26px"><div class="sh"><h2>{{ widget.settings.headline }}</h2></div><div class="g4">{% for it in widget.settings.items %}<div class="card reveal" style="padding:20px"><span style="width:44px;height:44px;border-radius:13px;background:var(--mint);color:var(--teal2);display:grid;place-items:center;font-size:1.25rem"><i class="bi bi-{{ it.icon }}"></i></span><h3 style="font-size:1.05rem;margin:14px 0 6px">{{ it.title }}</h3><p class="mut" style="font-size:.88rem;margin:0">{{ it.text }}</p></div>{% endfor %}</div></section>
