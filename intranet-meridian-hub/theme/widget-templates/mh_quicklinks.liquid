<div class="ql">{% for l in widget.settings.links %}<a href="{{ l.url }}"><i class="bi bi-{{ l.icon }}"></i><span>{{ l.label }}</span></a>{% endfor %}</div>
<style>.ql{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px;position:relative;z-index:1}
.ql a{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:#e4f1f3;font-weight:550;font-size:.88rem;transition:.25s}
.ql a:hover{background:rgba(255,255,255,.14);transform:translateY(-2px)}.ql i{width:32px;height:32px;border-radius:10px;background:rgba(95,240,216,.14);color:#5ff0d8;display:grid;place-items:center;flex:none}
@media(max-width:700px){.ql{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>
