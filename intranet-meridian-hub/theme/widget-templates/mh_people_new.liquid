{%- assign s = widget.settings -%}{% assign c = s.count | append: "" | plus: 0 %}{% if c == 0 %}{% assign c = 4 %}{% endif %}
{%- assign xs = get_content_items(ContentType="people", OrderBy="start_date desc", PageSize=c) -%}
<section class="card reveal" style="padding:18px 20px"><div class="sh"><h2><i class="bi bi-stars"></i> {{ s.headline | default: "New faces" }}</h2><a href="/people">Directory <i class="bi bi-arrow-right"></i></a></div>
<div class="g4" style="gap:12px">{% for x in xs.Items %}{% assign p = x.PublishedContent %}<a class="wp" href="/{{ x.RoutePath }}"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt=""><b>{{ x.PrimaryField }}</b><small>{{ p.job_title }}</small><span class="bdg teal">Joined {{ p.start_date.Value | date: "%b %-d" }}</span></a>{% endfor %}</div></section>
<style>.wp{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;padding:14px 10px;border-radius:14px;border:1px solid var(--line2);transition:.2s}.wp:hover{background:#fafcfb;border-color:var(--line)}.wp img{width:68px;height:68px;border-radius:50%;margin-bottom:6px}.wp b{font-weight:600;line-height:1.25;font-size:.92rem}.wp small{color:var(--mut);font-size:.76rem;line-height:1.3;min-height:2em}.wp .bdg{margin-top:6px}
@media(max-width:1300px){.wp small{min-height:0}}</style>
