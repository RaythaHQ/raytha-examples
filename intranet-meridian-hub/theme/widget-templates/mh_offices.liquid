<section style="margin-bottom:26px"><div class="sh"><h2>{{ widget.settings.headline }}</h2></div><div class="g3">{% for it in widget.settings.items %}{% capture f %}office eq '{{ it.key }}'{% endcapture %}{% assign pp = get_content_items(ContentType="people", Filter=f, OrderBy="sort_order asc", PageSize=6) %}
<a class="card lift reveal of" href="/people?office={{ it.key }}"><span class="kick">{{ it.key }}</span><h3>{{ it.name }}</h3><p class="mut">{{ it.address }}</p><p style="font-size:.88rem">{{ it.note }}</p><span class="ft"><span class="stack">{% for p in pp.Items %}<img src="{{ p.PublishedContent.photo.Value | attachment_redirect_url }}" alt="">{% endfor %}</span><span class="mono mut" style="font-size:.74rem">{{ pp.TotalCount }} in the directory</span></span></a>{% endfor %}</div></section>
<style>.of{padding:20px;display:flex;flex-direction:column}.of h3{font-size:1.15rem;margin:8px 0 4px}.of p{margin:0 0 8px;font-size:.88rem}.of .ft{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;gap:8px;flex-wrap:wrap}.stack{display:flex}.stack img{width:30px;height:30px;border-radius:50%;border:2px solid #fff;margin-left:-8px}.stack img:first-child{margin-left:0}</style>
