{%- assign xs = get_content_items(ContentType="people", Filter="is_leadership eq 'true'", OrderBy="sort_order asc", PageSize=12) -%}
<section style="margin-bottom:26px"><div class="sh"><h2>{{ widget.settings.headline }}</h2><a href="/people">Everyone <i class="bi bi-arrow-right"></i></a></div><div class="g3">{% for x in xs.Items %}{% assign p = x.PublishedContent %}<a class="card lift reveal" href="/{{ x.RoutePath }}" style="display:flex;gap:14px;align-items:center;padding:14px"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="" style="width:64px;height:64px;border-radius:16px"><span><b style="display:block;font-weight:650">{{ x.PrimaryField }}</b><small class="mut" style="display:block;font-size:.84rem;line-height:1.35">{{ p.job_title }}</small></span></a>{% endfor %}</div></section>
