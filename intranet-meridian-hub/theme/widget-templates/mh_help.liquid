{%- assign xs = get_content_items(ContentType="help_articles", Filter="popular eq 'true'", OrderBy="title asc", PageSize=6) -%}
<section class="card reveal" style="padding:18px 20px"><div class="sh"><h2><i class="bi bi-life-preserver"></i> {{ widget.settings.headline | default: "Popular IT help" }}</h2><a href="/it-help">All <i class="bi bi-arrow-right"></i></a></div>
{% for x in xs.Items %}<a class="ws" href="/{{ x.RoutePath }}"><i class="bi bi-arrow-return-right"></i><span>{{ x.PrimaryField }}</span><span class="mono mut" style="font-size:.72rem">{{ x.PublishedContent.minutes }} min</span></a>{% endfor %}</section>
