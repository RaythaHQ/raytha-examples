{%- assign xs = get_content_items(ContentType="systems", OrderBy="sort_order asc", PageSize=20) -%}
<section class="card reveal" style="padding:18px 20px"><div class="sh"><h2><i class="bi bi-activity"></i> {{ widget.settings.headline | default: "System status" }}</h2><a href="/status">Details <i class="bi bi-arrow-right"></i></a></div>
{% for x in xs.Items %}{% assign q = x.PublishedContent %}{% capture st %}{{ q.status }}{% endcapture %}<a class="ws" href="/{{ x.RoutePath }}"><i class="bi bi-{{ q.icon }}"></i><span>{{ x.PrimaryField }}{% if st != "operational" %}<small>{{ q.note }}</small>{% endif %}</span><span class="dot {{ st }}"></span></a>{% endfor %}</section>
<style>.ws{display:flex;gap:12px;align-items:center;padding:9px 0;border-top:1px solid var(--line2);font-size:.88rem;font-weight:520}.ws:first-of-type{border-top:0}.ws>i{color:var(--mut);width:18px}.ws span:nth-child(2){flex:1;min-width:0}.ws small{display:block;color:var(--mut);font-weight:400;font-size:.76rem;line-height:1.35;margin-top:2px}</style>
