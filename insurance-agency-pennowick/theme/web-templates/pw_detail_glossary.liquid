{%- assign x=Target.PublishedContent -%}{%- assign all = get_content_items(ContentType="glossary", OrderBy="term asc", PageSize=100) -%}
<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/glossary">Glossary</a></li><li>{{ x.letter }}</li></ol><p class="lbl">Glossary · {{ x.letter }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ x.short }}</p></div></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ x.body }}</div>{%- capture ex -%}{{ x.example }}{%- endcapture -%}{% if ex != "" %}<div class="ex"><b>Worked example (story figures)</b>{{ x.example }}</div>{% endif %}{%- capture rl -%}{{ x.related }}{%- endcapture -%}{% if rl != "" %}<p class="lbl" style="margin-top:28px">Related terms</p><div class="chips">{%- assign rs = x.related | split: "|" -%}{% for r in rs %}{% for t in all.Items %}{% if t.PrimaryField == r %}<a class="chip" href="{{ PathBase }}/{{ t.RoutePath }}">{{ r }}</a>{% endif %}{% endfor %}{% endfor %}</div>{% endif %}</div>
<aside class="side"><div class="card"><p class="lbl">All terms</p>{% for t in all.Items %}<div style="padding:3px 0">{% if t.Id == Target.Id %}<b>{{ t.PrimaryField }}</b>{% else %}<a href="{{ PathBase }}/{{ t.RoutePath }}">{{ t.PrimaryField }}</a>{% endif %}</div>{% endfor %}</div></aside></div></section>
