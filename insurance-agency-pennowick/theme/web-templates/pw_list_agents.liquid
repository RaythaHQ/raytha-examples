<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Agents</li></ol><p class="lbl">Licensed staff (fictional people)</p><h1>Who answers when you call</h1><p class="lede" style="margin:0">Six licensed people across three offices. Portraits are generated monograms; nobody pictured is real.</p></div></div></div>
<section class="sec tight"><div class="wrap"><div class="pgrid">{% for a in Target.Items %}{%- assign y=a.PublishedContent -%}<a class="pcard" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ y.photo.Value | attachment_redirect_url }}" alt=""><div><span class="code">{% capture lb %}{{ y.office }}{% endcapture %}{{ lb | replace: "main-street","Main Street office" | replace: "larch-ferry","Larch Ferry office" | replace: "owlbrook","Owlbrook Junction office" }}</span><h3>{{ a.PrimaryField }}</h3><p style="margin:0;font-weight:700">{{ y.role }}</p><p class="muted" style="margin:8px 0 0;font-size:.95rem">{{ y.summary }}</p><div class="chips">{%- assign cl = y.lines | split: "|" -%}{% for l in cl %}<span class="chip">{{ l }}</span>{% endfor %}</div></div></a>{% endfor %}</div></div></section>
