<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Coverage</li></ol><p class="lbl">Coverage lines</p><h1>What we place, in plain English</h1><p class="lede" style="margin:0">Eleven lines of coverage across home, business and life. Each page says what is usually covered, what usually is not, and the questions clients ask us most.</p></div></div></div>
<section class="sec tight"><div class="wrap">{%- assign fams = "personal:Home and family,business:Business,life:Life and income" | split: "," -%}{% for f in fams %}{%- assign fp = f | split: ":" -%}<div class="fam"><h2>{{ fp[1] }}</h2></div><div class="covgrid">{% for i in Target.Items %}{%- assign x=i.PublishedContent -%}{%- capture fm -%}{{ x.family }}{%- endcapture -%}{% if fm == fp[0] %}<a class="cov {{ fm }}" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="num">{{ x.sort_order }}</span><div><span class="code">{{ x.code }}</span><h3>{{ i.PrimaryField }}</h3><p style="color:var(--ink);margin-top:2px">{{ x.tagline }}</p><p>{{ x.summary | truncate: 150 }}</p></div></a>{% endif %}{% endfor %}</div>{% endfor %}</div></section>
