<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Offices</li></ol><p class="lbl">Offices</p><h1>Three offices in Pennowick County</h1><p class="lede" style="margin:0">Walk in for ID cards, policy reviews or help with a claim. All places and addresses are fictional.</p></div></div></div>
<section class="sec tight"><div class="wrap">{% for o in Target.Items %}{%- assign y=o.PublishedContent -%}<a class="card" href="{{ PathBase }}/{{ o.RoutePath }}" style="display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:28px;margin-bottom:16px;align-items:start"><div><span class="code">Office {{ forloop.index }}</span><h2 style="font-size:1.6rem;margin:4px 0 6px">{{ o.PrimaryField }}</h2><p class="muted" style="margin:0">{{ y.summary }}</p></div><div><p class="lbl" style="margin-bottom:6px">Address</p><p style="white-space:pre-line;margin:0">{{ y.address }}</p><p class="mono" style="margin:8px 0 0"><b>{{ y.phone }}</b></p></div><div><p class="lbl" style="margin-bottom:6px">Hours</p><p class="mono" style="margin:0;font-size:14px;line-height:1.8">{%- assign hs = y.hours | split: "|" -%}{% for h in hs %}{{ h }}<br>{% endfor %}</p></div></a>{% endfor %}</div></section>
