{%- assign in_pol=false -%}{%- assign in_biz=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "policyholders" -%}{%- assign in_pol=true -%}{%- endif -%}{%- if g == "business" -%}{%- assign in_biz=true -%}{%- assign in_pol=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pol=true -%}{%- assign in_biz=true -%}{%- endif -%}<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Client resources</li></ol><p class="lbl">Client resources</p><h1>Checklists, calendars and guides</h1><p class="lede" style="margin:0">Some are for everyone. Ones marked Policyholders or Business clients open after you sign in to your binder with an account in that group.</p></div></div></div>
<section class="sec tight"><div class="wrap" style="max-width:1020px"><div class="rlist">{% for r in Target.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "policyholders" and in_pol == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "business" and in_biz == false -%}{%- assign ok=false -%}{%- endif -%}<a class="rrow" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="k">{% capture lb %}{{ x.kind }}{% endcapture %}{{ lb | capitalize }}</span><div><b style="font-family:var(--serif);font-size:1.12rem">{{ r.PrimaryField }}</b><p>{{ x.summary }}</p></div><span class="tag {{ au }}">{% if au != "public" %}{% if ok %}✓ {% else %}🔒 {% endif %}{% endif %}{% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }}</span></a>{% endfor %}</div></div></section>
