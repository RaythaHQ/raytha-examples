{%- assign y=Target.PublishedContent -%}{%- assign ags = get_content_items(ContentType="agents", OrderBy="sort_order asc", PageSize=12) -%}{%- capture ok -%}{{ y.key }}{%- endcapture -%}
<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/offices">Offices</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="lbl">Walk-in office · fictional address</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ y.summary }}</p></div></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ y.body }}</div><h2 style="margin:30px 0 14px;font-size:1.4rem">Who works here</h2><div class="pgrid">{% for a in ags.Items %}{%- capture ao -%}{{ a.PublishedContent.office }}{%- endcapture -%}{% if ao == ok %}<a class="pcard" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ a.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""><div><h3>{{ a.PrimaryField }}</h3><p class="muted" style="margin:0">{{ a.PublishedContent.role }}</p></div></a>{% endif %}{% endfor %}</div></div>
<aside class="side"><div class="kv"><div><span>Phone</span><b>{{ y.phone }}</b></div>{%- assign hs = y.hours | split: "|" -%}{% for h in hs %}{%- assign hp = h | split: ": " -%}<div><span>{{ hp[0] }}</span><b>{{ hp[1] }}</b></div>{% endfor %}</div><div class="card"><p class="lbl">Address</p><p style="white-space:pre-line;margin:0">{{ y.address }}</p><p class="muted" style="margin:10px 0 0;font-size:.94rem">{{ y.parking }}</p></div></aside></div></section>
