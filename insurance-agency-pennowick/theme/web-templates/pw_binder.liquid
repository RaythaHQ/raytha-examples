{%- assign in_pol=false -%}{%- assign in_biz=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "policyholders" -%}{%- assign in_pol=true -%}{%- endif -%}{%- if g == "business" -%}{%- assign in_biz=true -%}{%- assign in_pol=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pol=true -%}{%- assign in_biz=true -%}{%- endif -%}{%- assign rs = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=40) -%}
<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Client binder</li></ol><p class="lbl">Members only</p><h1>{% if CurrentUser.IsAuthenticated %}{{ CurrentUser.FirstName }}'s binder{% else %}Client binder{% endif %}</h1><p class="lede" style="margin:0">Your policies at a glance, renewal dates, claims numbers and the guides that go with them. Business clients also get certificate and audit guides.</p>{% if CurrentUser.IsAuthenticated %}<p style="margin:14px 0 0"><span class="who">● Signed in</span> <span class="tag policyholders">{% if in_pol %}Policyholder ✓{% else %}Policyholder ✗{% endif %}</span> <span class="tag business">{% if in_biz %}Business client ✓{% else %}Business client ✗{% endif %}</span></p>{% endif %}</div></div></div>
<section class="sec tight"><div class="wrap">{% unless CurrentUser.IsAuthenticated %}<div class="lock"><span class="tag locked">🔒 Sign in required</span><h2>The binder is for Pennowick clients.</h2><p>Your agent sets up your binder at your first policy review, so there is no sign-up form. Once signed in you see your policy summary, renewal calendar and claims contact sheet, and, for business accounts, certificate and audit guides.</p><p><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/binder">Sign in</a> <a class="btn line" href="{{ PathBase }}/resources">Public resources</a></p></div>
<div class="moments" style="margin-top:30px"><div class="moment"><span class="n">1.</span><div><h3>Policies at a glance</h3><p>Carrier, policy number, renewal date and deductible for each line.</p></div></div><div class="moment"><span class="n">2.</span><div><h3>Renewal calendar</h3><p>What renews when, and what we check 45 days before.</p></div></div><div class="moment"><span class="n">3.</span><div><h3>Business tab</h3><p>Certificates of insurance, payroll audit prep and the 120-day renewal timeline.</p></div></div></div>
{% else %}<div class="tabset"><span class="on">Household</span>{% if in_biz %}<span class="on">Business</span>{% endif %}<span>Guides</span></div><div class="binder"><div class="two" style="grid-template-columns:1fr 320px">{% if in_pol %}<div><p class="lbl">Policies at a glance (story data)</p><div style="overflow:auto"><table class="pol"><thead><tr><th>Line</th><th>Carrier</th><th>Policy no.</th><th>Renews</th><th>Deductible</th></tr></thead><tbody><tr><td>Homeowners</td><td>Halvorly Mutual</td><td class="m">HM-HO-448120</td><td class="m">Jun 14, 2027</td><td class="m">&#36;1,000 · 2% wind</td></tr><tr><td>Auto (2 cars)</td><td>Ostrine Indemnity</td><td class="m">OI-PA-77310</td><td class="m">Apr 02, 2027</td><td class="m">&#36;500 / &#36;250</td></tr><tr><td>Flood</td><td>Marlinth Flood</td><td class="m">MF-58021</td><td class="m">Sep 30, 2027</td><td class="m">&#36;2,000</td></tr><tr><td>Umbrella</td><td>Quarrow F&amp;C</td><td class="m">QF-UM-10994</td><td class="m">Jan 09, 2027</td><td class="m">none</td></tr>{% if in_biz %}<tr><td><b>BOP · Corner Café</b></td><td>Corrabin Casualty</td><td class="m">CC-BOP-30117</td><td class="m">Mar 01, 2027</td><td class="m">&#36;1,000</td></tr><tr><td><b>Workers' comp</b></td><td>Corrabin Casualty</td><td class="m">CC-WC-30118</td><td class="m">Mar 01, 2027</td><td class="m">pay-as-you-go</td></tr><tr><td><b>Commercial auto</b></td><td>Ostrine Indemnity</td><td class="m">OI-CA-20455</td><td class="m">Mar 01, 2027</td><td class="m">&#36;1,000</td></tr>{% endif %}</tbody></table></div>
<p class="lbl" style="margin-top:30px">Guides in your binder</p><div class="rlist">{% for r in rs.Items %}{%- assign x=r.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "policyholders" and in_pol == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "business" and in_biz == false -%}{%- assign ok=false -%}{%- endif -%}{% if au != "public" and ok %}<a class="rrow" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="k">{% capture lb %}{{ x.kind }}{% endcapture %}{{ lb | capitalize }}</span><div><b style="font-family:var(--serif)">{{ r.PrimaryField }}</b><p>{{ x.summary | truncate: 110 }}</p></div><span class="tag {{ au }}">{% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }}</span></a>{% endif %}{% endfor %}</div>{% unless in_biz %}<div class="lock" style="margin-top:22px;padding:20px"><b>No business tab in this binder.</b> Certificate and audit guides appear for business client accounts.</div>{% endunless %}</div>
<aside class="side" style="position:static"><div class="card" style="border-left:5px solid var(--ox)"><p class="lbl">Next renewal</p><p style="font:640 1.6rem/1.1 var(--serif);margin:0">Jan 09, 2027</p><p class="muted" style="margin:6px 0 0">Umbrella · we start the review 45 days out (Nov 25).</p></div><div class="card"><p class="lbl">Your agent</p><p style="margin:0">{% if in_biz %}<b>Tomas Brightling</b><br><span class="muted">Larch Ferry office · (555) 014-2240</span>{% else %}<b>Priya Halvorsen</b><br><span class="muted">Main Street office · (555) 014-2200</span>{% endif %}</p></div><div class="card"><p class="lbl">Changes</p><p style="margin:0;font-size:.95rem">Coverage changes are made by phone or in person with a licensed agent. There is no change form on purpose.</p></div><a class="btn line" href="{{ PathBase }}/account/logout">Sign out</a></aside>{% else %}<div class="lock"><h2>Your account is not set up as a client yet.</h2><p>Your agent adds your account to the policyholder group at your first review.</p></div>{% endif %}</div></div>{% endunless %}</div></section>
