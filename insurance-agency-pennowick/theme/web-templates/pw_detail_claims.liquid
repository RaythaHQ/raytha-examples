{%- assign x=Target.PublishedContent -%}{%- assign covs = get_content_items(ContentType="coverage", OrderBy="sort_order asc", PageSize=30) -%}{%- assign cars = get_content_items(ContentType="carriers", OrderBy="sort_order asc", PageSize=30) -%}{%- capture cd -%}{{ x.code }}{%- endcapture -%}
<div class="folder"><div class="wrap"><div class="flabel" style="border-left-color:var(--ox2)"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/claims">Claims desk</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="lbl">Claims guide</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ x.summary }}</p></div></div></div>
<section class="sec tight"><div class="wrap"><div class="hours3 paper"><div class="hcol h1st"><h4>First hour</h4><ol>{%- assign st = x.first_hour | split: "|" -%}{% for s in st %}<li>{{ s }}</li>{% endfor %}</ol></div><div class="hcol h2nd"><h4>First day</h4><ol>{%- assign st = x.first_day | split: "|" -%}{% for s in st %}<li>{{ s }}</li>{% endfor %}</ol></div><div class="hcol h3rd"><h4>First week</h4><ol>{%- assign st = x.first_week | split: "|" -%}{% for s in st %}<li>{{ s }}</li>{% endfor %}</ol></div></div><div class="two" style="margin-top:40px"><div class="prose"><h2 style="margin-top:0">Good to know</h2>{{ x.body }}<p class="muted mono" style="font-size:12.5px">General guidance for a fictional agency. Your policy and your carrier's instructions come first.</p></div><aside class="side"><div class="card" style="border-left:5px solid var(--ox)"><p class="lbl">Keep these</p><ul style="margin:0;padding-left:18px">{%- assign ks = x.keep | split: "|" -%}{% for k in ks %}<li>{{ k }}</li>{% endfor %}</ul></div>{% for i in covs.Items %}{%- capture ic -%}{{ i.PublishedContent.code }}{%- endcapture -%}{% if ic == cd %}<a class="card" href="{{ PathBase }}/{{ i.RoutePath }}"><p class="lbl">Related coverage</p><b style="font-family:var(--serif);font-size:1.15rem">{{ i.PrimaryField }}</b></a>{% endif %}{% endfor %}<div class="card"><p class="lbl">Carrier claims lines</p>{% for c in cars.Items %}{%- assign cl = c.PublishedContent.lines | split: "|" -%}{% if cl contains cd %}<div class="mono" style="display:flex;justify-content:space-between;gap:10px;font-size:13px;padding:4px 0;border-bottom:1px dotted var(--rule)"><span>{{ c.PrimaryField }}</span><b>{{ c.PublishedContent.claims_phone }}</b></div>{% endif %}{% endfor %}</div></aside></div></div></section>
