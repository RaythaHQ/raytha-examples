{%- assign y=Target.PublishedContent -%}{%- assign covs = get_content_items(ContentType="coverage", OrderBy="sort_order asc", PageSize=30) -%}{%- assign cl = y.lines | split: "|" -%}{%- capture kd -%}{{ y.kind }}{%- endcapture -%}
<div class="folder"><div class="wrap"><div class="flabel" style="display:grid;grid-template-columns:96px 1fr;gap:24px;align-items:center"><span class="seal {{ kd }}" style="width:96px;height:96px;font-size:1.8rem">{{ y.monogram }}</span><div><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/carriers">Carriers</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="lbl">{% capture lb %}{{ y.kind }}{% endcapture %}{{ lb | capitalize }} carrier · fictional</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ y.summary }}</p></div></div></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ y.body }}</div><h2 style="margin:34px 0 14px;font-size:1.4rem">Lines written through Pennowick</h2><div class="covgrid">{% for i in covs.Items %}{%- assign x=i.PublishedContent -%}{%- capture cd -%}{{ x.code }}{%- endcapture -%}{%- capture fm -%}{{ x.family }}{%- endcapture -%}{% if cl contains cd %}<a class="cov {{ fm }}" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="num">{{ x.sort_order }}</span><div><h3>{{ i.PrimaryField }}</h3><p>{{ x.tagline }}</p></div></a>{% endif %}{% endfor %}</div></div>
<aside class="side"><div class="kv"><div><span>Kind</span><b>{% capture lb %}{{ y.kind }}{% endcapture %}{{ lb | capitalize }}</b></div><div><span>Appointed</span><b>{{ y.appointed_since }}</b></div><div><span>Lines</span><b>{{ cl.size }}</b></div><div><span>Claims line</span><b>{{ y.claims_phone }}</b></div></div><div class="card"><p class="lbl">Report a claim</p><p style="margin:0">Call the carrier first, then call us so our claims advocate can follow it. <a href="{{ PathBase }}/claims">Claims guides →</a></p></div></aside></div></section>
