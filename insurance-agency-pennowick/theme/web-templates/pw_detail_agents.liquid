{%- assign y=Target.PublishedContent -%}{%- assign covs = get_content_items(ContentType="coverage", OrderBy="sort_order asc", PageSize=30) -%}{%- assign offs = get_content_items(ContentType="offices", OrderBy="sort_order asc", PageSize=6) -%}{%- assign cl = y.lines | split: "|" -%}{%- capture myo -%}{{ y.office }}{%- endcapture -%}
<div class="folder"><div class="wrap"><div class="flabel" style="display:grid;grid-template-columns:150px 1fr;gap:28px;align-items:center"><img src="{{ y.photo.Value | attachment_redirect_url }}" alt="" style="border-radius:6px;border:1px solid var(--rule)"><div><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/agents">Agents</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="lbl">{{ y.role }} · {% capture lb %}{{ y.office }}{% endcapture %}{{ lb | replace: "main-street","Main Street office" | replace: "larch-ferry","Larch Ferry office" | replace: "owlbrook","Owlbrook Junction office" }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ y.summary }}</p></div></div></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="prose">{{ y.body }}</div><h2 style="margin:30px 0 14px;font-size:1.4rem">Lines {{ Target.PrimaryField | split: " " | first }} works on</h2><div class="covgrid">{% for i in covs.Items %}{%- assign x=i.PublishedContent -%}{%- capture cd -%}{{ x.code }}{%- endcapture -%}{%- capture fm -%}{{ x.family }}{%- endcapture -%}{% if cl contains cd %}<a class="cov {{ fm }}" href="{{ PathBase }}/{{ i.RoutePath }}"><span class="num">{{ x.sort_order }}</span><div><h3>{{ i.PrimaryField }}</h3><p>{{ x.tagline }}</p></div></a>{% endif %}{% endfor %}</div></div>
<aside class="side"><div class="kv"><div><span>Office</span><b>{% capture lb %}{{ y.office }}{% endcapture %}{{ lb | replace: "main-street","Main Street office" | replace: "larch-ferry","Larch Ferry office" | replace: "owlbrook","Owlbrook Junction office" }}</b></div><div><span>Languages</span><b>{{ y.languages }}</b></div><div><span>License</span><b>{{ y.license }}</b></div><div><span>Years here</span><b>{{ y.years }}</b></div></div>{% for o in offs.Items %}{%- capture ok -%}{{ o.PublishedContent.key }}{%- endcapture -%}{% if ok == myo %}<a class="btn line" href="{{ PathBase }}/{{ o.RoutePath }}">{{ o.PrimaryField }} hours</a>{% endif %}{% endfor %}</aside></div></section>
