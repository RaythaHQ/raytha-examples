{%- assign in_pol=false -%}{%- assign in_biz=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "policyholders" -%}{%- assign in_pol=true -%}{%- endif -%}{%- if g == "business" -%}{%- assign in_biz=true -%}{%- assign in_pol=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pol=true -%}{%- assign in_biz=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="folder"><div class="wrap"><div class="flabel"><p class="lbl">Search</p><h1>Search the agency site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="deductible, flood, certificate, hail"><button class="btn">Search</button></form></div></div></div>
<section class="sec tight"><div class="wrap" style="max-width:900px">{% if q != "" %}{%- assign groups = "coverage:Coverage:title:summary,claims:Claims guides:title:summary,glossary:Glossary:term:short,resources:Client resources:title:summary,carriers:Carriers:name:summary" | split: "," -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{% if r.TotalCount > 0 %}<h2 style="font-size:1.25rem;margin:28px 0 4px">{{ gp[1] }} <span class="muted mono" style="font-size:.8rem">{{ r.TotalCount }}</span></h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- capture sm -%}{{ x.summary }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "policyholders" or au == "business" %} <span class="tag {{ au }}">🔒 {% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }}</span>{% endif %}<p>{% if sm != "" %}{{ sm | truncate: 150 }}{% else %}{{ x.short | truncate: 150 }}{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% else %}<p class="muted">Try <a href="?q=flood">flood</a>, <a href="?q=deductible">deductible</a>, <a href="?q=certificate">certificate</a> or <a href="?q=hail">hail</a>.</p>{% endif %}</div></section>
