<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Carriers</li></ol><p class="lbl">Appointed carriers (all fictional)</p><h1>The companies behind your policy</h1><p class="lede" style="margin:0">We are appointed with {{ Target.TotalCount }} insurance companies: national, regional and specialty. Each card lists the lines it writes through us and its claims line.</p></div></div></div>
<section class="sec tight"><div class="wrap"><div class="carr">{% for c in Target.Items %}{%- assign y=c.PublishedContent -%}{%- capture kd -%}{{ y.kind }}{%- endcapture -%}<a class="cc" href="{{ PathBase }}/{{ c.RoutePath }}"><span class="seal {{ kd }}">{{ y.monogram }}</span><div><span class="code">{% capture lb %}{{ y.kind }}{% endcapture %}{{ lb | capitalize }} · appointed {{ y.appointed_since }}</span><h3>{{ c.PrimaryField }}</h3><p class="muted" style="margin:6px 0 0;font-size:.95rem">{{ y.summary }}</p><div class="chips">{%- assign cl = y.lines | split: "|" -%}{% for l in cl %}<span class="chip">{{ l }}</span>{% endfor %}</div><p class="mono" style="margin:10px 0 0;font-size:13px">Claims: <b>{{ y.claims_phone }}</b></p></div></a>{% endfor %}</div></div></section>
