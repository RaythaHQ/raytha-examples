.pol{width:100%;border-collapse:collapse}.pol th,.pol td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:left}.pol th{font:700 11px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.pol td.m{font-family:var(--mono);font-size:.93rem}
.who{display:inline-flex;gap:8px;align-items:center;font:700 12.5px var(--mono);background:var(--tealsoft);color:var(--teal);padding:5px 11px;border-radius:999px}
.searchbar{display:flex;gap:10px;max-width:680px;margin-top:20px}input[type=text],input[type=search],input[type=email],input[type=password],input:not([type]){width:100%;padding:12px 14px;border:1.5px solid var(--ink);border-radius:6px;font:inherit;background:#fff}label{display:block;font-weight:700;margin-bottom:6px;font-size:.93rem}
.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:inherit}.hit b{color:var(--ox);font-family:var(--serif)}.hit p{margin:3px 0 0;color:var(--muted)}
.foot{background:var(--ink);color:#b9b6ad;padding:58px 0 32px;font-size:.95rem}.foot a{color:#ece6d6;text-decoration:none}.foot .logo b{font-size:1.12rem;white-space:nowrap}.foot .logo small{white-space:nowrap;font-size:10px}.foot a:hover{color:var(--brass)}.fgrid{display:grid;grid-template-columns:1.6fr repeat(4,1fr);gap:28px}.foot h5{font:700 11.5px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#8a8778;margin:0 0 12px}.foot ul{list-style:none;padding:0;margin:0;line-height:2}.fine{border-top:1px solid #333a4a;margin-top:38px;padding-top:20px;font:12.5px/1.6 var(--mono);color:#8a8778;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.skip{position:absolute;left:-999px}.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:99}
@media(max-width:1000px){.hero .intro,.two,.mapgrid,.closer,.versus{grid-template-columns:1fr}.versus>div+div{border-left:0;border-top:1.5px solid var(--ink)}.stamp{justify-self:start}.legend,.moments,.clist,.pgrid{grid-template-columns:1fr 1fr}.moment:nth-child(n){padding-left:0;border-left:0}.people{grid-template-columns:repeat(3,1fr)}.fgrid{grid-template-columns:1fr 1fr}.side{position:static}.gl{columns:1}.facts{grid-template-columns:1fr 1fr}}
@media(max-width:640px){body{font-size:16px}.notice .wrap>a{display:none}.hot{display:none}.stamp{display:none}.legend,.moments,.clist,.covgrid,.carr,.hours3,.pgrid,.ledger{grid-template-columns:1fr}.ledger>div+div{border-left:0;border-top:1px solid var(--rule)}.people{grid-template-columns:1fr 1fr}.pin{width:24px;height:24px;border-width:2px;font-size:11px}.pin .tip{display:none}.sec{padding:52px 0}.closer{padding:28px}.rrow{grid-template-columns:1fr auto}.rrow .k{grid-column:1/-1}.tabs a{padding:9px 14px}.facts{grid-template-columns:1fr}.facts div{border-right:0;border-bottom:1px solid var(--rule)}.hero{padding-top:30px}.cov{grid-template-columns:48px 1fr}.cc{grid-template-columns:56px 1fr}.seal{width:56px;height:56px;font-size:1.1rem}}
</style></head><body>
