{%- assign x=Target.PublishedContent -%}{%- assign cars = get_content_items(ContentType="carriers", OrderBy="sort_order asc", PageSize=30) -%}{%- assign clms = get_content_items(ContentType="claims", OrderBy="sort_order asc", PageSize=30) -%}{%- assign ags = get_content_items(ContentType="agents", OrderBy="sort_order asc", PageSize=12) -%}{%- capture cd -%}{{ x.code }}{%- endcapture -%}
<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/coverage">Coverage</a></li><li>{% capture lb %}{{ x.family }}{% endcapture %}{{ lb | replace: "personal","Home and family" | replace: "business","Business" | replace: "life","Life and income" }}</li></ol><p class="lbl">{% capture lb %}{{ x.family }}{% endcapture %}{{ lb | replace: "personal","Home and family" | replace: "business","Business" | replace: "life","Life and income" }} · {{ x.tagline }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ x.summary }}</p></div></div></div>
<section class="sec tight"><div class="wrap two"><div><div class="ledger"><div class="yes"><h4>Usually covered</h4><ul>{%- assign ls = x.covered | split: "|" -%}{% for l in ls %}<li>{{ l }}</li>{% endfor %}</ul></div><div class="no"><h4>Usually not covered</h4><ul>{%- assign ls = x.not_covered | split: "|" -%}{% for l in ls %}<li>{{ l }}</li>{% endfor %}</ul></div></div>
<div class="prose">{{ x.body }}</div><div class="qa" style="margin-top:34px;max-width:780px"><h2 style="margin-bottom:12px">Questions clients ask</h2>{%- assign qs = x.questions | split: "||" -%}{% for q in qs %}{%- assign qp = q | split: "::" -%}<details{% if forloop.first %} open{% endif %}><summary>{{ qp[0] | strip }}</summary><p>{{ qp[1] | strip }}</p></details>{% endfor %}</div>
<p class="muted mono" style="font-size:12.5px;margin-top:26px">Summaries only. The policy, its endorsements and exclusions decide coverage. Everything here is fictional.</p></div>
<aside class="side"><div class="card"><p class="lbl">Who usually needs it</p><p style="margin:0">{{ x.who }}</p></div><div class="card"><p class="lbl">Carriers that write it through us</p>{% for c in cars.Items %}{%- assign cl = c.PublishedContent.lines | split: "|" -%}{% if cl contains cd %}<div style="padding:5px 0;border-bottom:1px dotted var(--rule)"><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a></div>{% endif %}{% endfor %}</div>
<div class="card"><p class="lbl">Agents for this line</p>{% for a in ags.Items %}{%- assign al = a.PublishedContent.lines | split: "|" -%}{% if al contains cd %}<div style="display:flex;gap:10px;align-items:center;padding:5px 0"><img src="{{ a.PublishedContent.photo.Value | attachment_redirect_url }}" alt="" style="width:36px;height:36px;border-radius:4px"><a href="{{ PathBase }}/{{ a.RoutePath }}">{{ a.PrimaryField }}</a></div>{% endif %}{% endfor %}</div>
{%- capture cg -%}{% for c in clms.Items %}{%- capture cc -%}{{ c.PublishedContent.code }}{%- endcapture -%}{% if cc == cd %}<div style="padding:5px 0"><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a></div>{% endif %}{% endfor %}{%- endcapture -%}{% if cg != "" %}<div class="card" style="border-left:5px solid var(--ox)"><p class="lbl">If you need to claim</p>{{ cg }}</div>{% endif %}</aside></div></section>
