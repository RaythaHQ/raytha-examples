{%- assign in_pol=false -%}{%- assign in_biz=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "policyholders" -%}{%- assign in_pol=true -%}{%- endif -%}{%- if g == "business" -%}{%- assign in_biz=true -%}{%- assign in_pol=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_pol=true -%}{%- assign in_biz=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- capture kd -%}{{ x.kind }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "policyholders" and in_pol == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "business" and in_biz == false -%}{%- assign ok=false -%}{%- endif -%}
<div class="folder"><div class="wrap"><div class="flabel"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/resources">Client resources</a></li><li>{% capture lb %}{{ x.kind }}{% endcapture %}{{ lb | capitalize }}</li></ol><span class="tag {{ au }}">{% if au != "public" %}🔒 {% endif %}{% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }}</span> <span class="tag">{% capture lb %}{{ x.kind }}{% endcapture %}{{ lb | capitalize }} · updated {{ x.updated_label }}</span><h1 style="margin-top:12px">{{ Target.PrimaryField }}</h1><p class="lede" style="margin:0">{{ x.summary }}</p></div></div></div>
<section class="sec tight"><div class="wrap two"><div>{% if ok %}<div class="prose">{{ x.body }}</div>{% else %}<div class="lock"><span class="tag locked">🔒 {% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }} only</span><h2>This page is in the client binder.</h2><p>{% if CurrentUser.IsAuthenticated %}You are signed in as {{ CurrentUser.FirstName }}, but your binder does not include {% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" | downcase }} resources.{% else %}Sign in with the account your agent set up to read it.{% endif %} The body of this page is not sent to the browser unless your account is in the right group.</p><p>{% unless CurrentUser.IsAuthenticated %}<a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a> {% endunless %}<a class="btn line" href="{{ PathBase }}/resources">Public resources</a></p></div>{% endif %}</div>
<aside class="side"><div class="kv"><div><span>Audience</span><b>{% capture lb %}{{ x.audience }}{% endcapture %}{{ lb | replace: "public","Everyone" | replace: "policyholders","Policyholders" | replace: "business","Business clients" }}</b></div><div><span>Kind</span><b>{% capture lb %}{{ x.kind }}{% endcapture %}{{ lb | capitalize }}</b></div><div><span>Updated</span><b>{{ x.updated_label }}</b></div></div><a class="btn line" href="{{ PathBase }}/binder">Client binder</a></aside></div></section>
