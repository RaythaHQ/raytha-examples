{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture ek %}{{ p.category }}{% endcapture %}{% for pair in evc %}{% assign kv = pair | split: ":" %}{% if kv[0] == ek %}{% assign el = kv[1] %}{% assign ei = kv[2] %}{% endif %}{% endfor %}{% capture fr %}{{ p.free | downcase }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/events">Community calendar</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:10px"><span class="pill blue"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span>{% if fr == "true" %}<span class="pill green">Free</span>{% endif %}</div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;margin-bottom:22px"><div class="card pad prose" style="padding:32px">{{ p.body }}</div></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><div style="display:flex;gap:14px;align-items:center;margin-bottom:14px"><div class="date" aria-hidden="true"><span>{{ p.start.Value | date: "%b" }}</span><b>{{ p.start.Value | date: "%-d" }}</b><small>{{ p.start.Value | date: "%a" }}</small></div><b style="color:var(--ink)">{{ p.start.Value | date: "%A, %B %-d" }}<br><span class="muted" style="font-weight:500">{{ p.time_label }}</span></b></div><dl class="facts"><div><dt>Where</dt><dd>{{ p.location }}</dd></div><div><dt>Cost</dt><dd>{% if fr == "true" %}Free{% else %}See details{% endif %}</dd></div></dl></div>
    <div class="card pad"><p style="margin:0;font-size:.94rem"><i class="bi bi-universal-access" aria-hidden="true"></i> Need an accommodation to attend? Call Parks and Recreation at (555) 010-4500 at least 48 hours ahead.</p></div>
  </aside>
</div></div>
