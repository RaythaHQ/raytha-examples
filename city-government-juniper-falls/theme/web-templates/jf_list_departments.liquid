{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Departments</li></ol></nav><h1>City departments</h1><p>Who does what at the City of Juniper Falls, with phone numbers, email addresses and opening hours.</p></div></div>
<div class="body"><div class="wrap"><div class="grid g3">
{%- for d in Target.Items %}{% assign x = d.PublishedContent %}<a class="card dept" style="--c:{{ x.color }}" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><h3 style="font-size:1.2rem">{{ d.PrimaryField }}</h3><p>{{ x.summary }}</p><span class="ph"><i class="bi bi-telephone" aria-hidden="true"></i> {{ x.phone }}</span></a>{% endfor %}
</div></div></div>
