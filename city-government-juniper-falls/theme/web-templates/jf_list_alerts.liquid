{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Alerts</li></ol></nav><h1>Alerts</h1><p>Emergency and advisory alerts from the city. Active alerts also show at the top of every page.</p></div></div>
<div class="body"><div class="wrap" style="max-width:900px"><div class="card">
{%- for a in Target.Items %}{% assign x = a.PublishedContent %}{% capture lv %}{{ x.level }}{% endcapture %}{% capture on %}{{ x.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% endif %}{% endfor %}
<a class="ntc" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="ic" aria-hidden="true" style="{% if lv == 'emergency' %}background:#fde8e6;color:var(--red){% elsif lv == 'info' %}background:var(--blue2);color:var(--blue){% endif %}"><i class="bi bi-{{ li }}"></i></span><span><small>{{ ll }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }} &middot; {% if on == "true" %}<b style="display:inline;color:var(--green)">Active</b>{% else %}Ended{% endif %}</small><b>{{ a.PrimaryField }}</b><small>{{ x.message }}</small></span></a>{% endfor %}
</div><p class="muted" style="font-size:.92rem;margin-top:16px">Sign up for text and email alerts at <a class="ext" href="https://alerts.juniperfalls.example" rel="noopener">alerts.juniperfalls.example</a>.</p></div></div>
