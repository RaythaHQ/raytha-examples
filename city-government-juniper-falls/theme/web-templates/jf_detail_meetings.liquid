{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture ms %}{{ p.status }}{% endcapture %}{% for pair in mst %}{% assign kv = pair | split: ":" %}{% if kv[0] == ms %}{% assign msl = kv[1] %}{% assign msc = kv[2] %}{% endif %}{% endfor %}{% capture ag %}{{ p.agenda.Value }}{% endcapture %}{% capture mn %}{{ p.minutes.Value }}{% endcapture %}{% capture vu %}{{ p.video_url }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/meetings">Agendas and minutes</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:10px"><span class="pill {{ msc }}">{{ msl }}</span><a class="pill navy" style="text-decoration:none" href="{{ PathBase }}/{{ p.board.RoutePath }}">{{ p.board.PrimaryField }}</a></div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px">
    {% if ms == "cancelled" %}<div class="alert advisory" style="border-radius:12px"><div style="display:flex;gap:12px;padding:14px 18px;align-items:center"><span class="ic" aria-hidden="true"><i class="bi bi-calendar-x"></i></span><p><b>This meeting was cancelled.</b> Items move to the next regular meeting.</p></div></div>{% endif %}
    <div class="card pad prose" style="padding:30px"><h2 style="margin-top:0">{% if ms == "held" %}What happened{% else %}On the agenda{% endif %}</h2>{{ p.body }}</div>
    <div class="card pad"><h2 style="font-size:1.25rem;margin-bottom:12px">Documents</h2><div class="docs">{% if ag != "" %}<a href="{{ p.agenda.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Agenda (PDF)</a>{% endif %}{% if mn != "" %}<a href="{{ p.minutes.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Approved minutes (PDF)</a>{% endif %}{% if vu != "" %}<a href="{{ vu }}" rel="noopener"><i class="bi bi-play-btn" aria-hidden="true"></i> Meeting video</a>{% endif %}{% if ag == "" and mn == "" %}<span>The agenda is posted at least 72 hours before the meeting.</span>{% endif %}</div></div>
  </div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><div style="display:flex;gap:14px;align-items:center;margin-bottom:14px"><div class="date" aria-hidden="true"><span>{{ p.start.Value | date: "%b" }}</span><b>{{ p.start.Value | date: "%-d" }}</b><small>{{ p.start.Value | date: "%a" }}</small></div><b style="color:var(--ink)">{{ p.start.Value | date: "%A, %B %-d, %Y" }}<br><span class="muted" style="font-weight:500">{{ p.time_label }}</span></b></div><dl class="facts"><div><dt>Where</dt><dd>{{ p.location }}</dd></div><div><dt>Body</dt><dd><a href="{{ PathBase }}/{{ p.board.RoutePath }}">{{ p.board.PrimaryField }}</a></dd></div><div><dt>Status</dt><dd>{{ msl }}</dd></div></dl>
      <a class="btn btn-o" style="width:100%;margin-top:14px" href="{{ PathBase }}/feeds/meetings.ics"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Add meetings to my calendar</a></div>
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Public comment</h2><p style="font-size:.94rem;margin:0">Speak for up to three minutes in person, or email written comments to <a href="mailto:citysecretary@juniperfalls.example">the City Secretary</a> by noon on the meeting day. Need an interpreter or other accommodation? Call (555) 010-4010 at least 48 hours ahead.</p></div>
  </aside>
</div></div>
