{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{%- capture f %}board eq '{{ Target.Id }}'{% endcapture -%}{%- assign mq = get_content_items(ContentType="meetings", Filter=f, OrderBy="start asc", PageSize=40) -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/boards">Boards and commissions</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px"><div class="card pad prose" style="padding:30px">{{ p.about }}</div>
  <div class="card"><div class="pad" style="padding-bottom:0;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap"><h2 style="font-size:1.35rem">Meetings</h2><a class="more" href="{{ PathBase }}/meetings?body={{ Target.Id }}">All meetings of this body <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>{% for m in mq.Items %}{% assign x = m.PublishedContent %}{% capture ms %}{{ x.status }}{% endcapture %}{% capture ag %}{{ x.agenda.Value }}{% endcapture %}{% capture mn %}{{ x.minutes.Value }}{% endcapture %}{% capture vu %}{{ x.video_url }}{% endcapture %}{% for pair in mst %}{% assign kv = pair | split: ":" %}{% if kv[0] == ms %}{% assign msl = kv[1] %}{% assign msc = kv[2] %}{% endif %}{% endfor %}
<div class="mtg"><div class="date" aria-hidden="true"><span>{{ x.start.Value | date: "%b" }}</span><b>{{ x.start.Value | date: "%-d" }}</b><small>{{ x.start.Value | date: "%a" }}</small></div>
  <div style="min-width:0"><h3><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></h3><p>{{ x.time_label }} &middot; {{ x.location }}{% if ms != "scheduled" %} &middot; <span class="pill {{ msc }}">{{ msl }}</span>{% endif %}</p>
  <div class="docs">{% if ag != "" %}<a href="{{ x.agenda.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Agenda<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if mn != "" %}<a href="{{ x.minutes.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Minutes<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if vu != "" %}<a href="{{ vu }}" rel="noopener"><i class="bi bi-play-btn" aria-hidden="true"></i> Video<span class="vh"> of {{ m.PrimaryField }}</span></a>{% endif %}{% if ms == "scheduled" and ag == "" %}<span>Agenda posted 72 hours ahead</span>{% endif %}{% if ms == "cancelled" %}<span>No meeting</span>{% endif %}</div></div></div>{% else %}<div class="pad muted">No meetings posted yet.</div>{% endfor %}</div></div>
  <aside class="grid" style="gap:20px"><div class="card pad"><dl class="facts"><div><dt>Meets</dt><dd>{{ p.meets }}</dd></div><div><dt>Seats</dt><dd>{{ p.seats }}</dd></div><div><dt>Staff contact</dt><dd>City Secretary</dd></div></dl></div>
  <div class="cta"><h2 style="font-size:1.15rem">Apply to serve</h2><p style="margin:8px 0 14px;font-size:.95rem">Seats are filled by Council appointment. Email the City Secretary to be considered.</p><a class="btn btn-g" href="mailto:citysecretary@juniperfalls.example">Email the City Secretary</a></div></aside>
</div></div>
