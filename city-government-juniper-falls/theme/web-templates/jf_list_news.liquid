{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign qc = "" -%}{%- for pair in ncats %}{% assign kv = pair | split: ":" %}{% if QueryParams.topic == kv[0] %}{% assign qc = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">News</li></ol></nav><h1>News releases</h1><p>Announcements from City Hall and city departments, newest first.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter news by topic"><a href="{{ PathBase }}/news"{% if qc == "" %} aria-current="true"{% endif %}>All topics</a>{% for pair in ncats %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/news?topic={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}>{{ kv[1] }}</a>{% endfor %}</nav>
<div class="grid g3">{% for a in Target.Items %}{% capture ak %}{{ a.PublishedContent.category }}{% endcapture %}{% if qc == "" or qc == ak %}{% assign x = a.PublishedContent %}{% capture ck %}{{ x.category }}{% endcapture %}{% for pair in ncats %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}
<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')" role="img" aria-label=""></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.posted_on.Value | date: "%B %-d, %Y" }}</p></div></a>{% endif %}{% endfor %}</div>
</div></div>
