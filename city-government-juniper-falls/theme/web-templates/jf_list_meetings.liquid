{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign bq = get_content_items(ContentType="boards", OrderBy="sort_order asc", PageSize=20) -%}
{%- assign qb = "" -%}{%- for b in bq.Items %}{% assign bid = b.Id | append: "" %}{% if QueryParams.body == bid %}{% assign qb = bid %}{% assign qbn = b.PrimaryField %}{% endif %}{% endfor -%}
{%- assign past = false -%}{%- if QueryParams.when == "past" %}{% assign past = true %}{% endif -%}
{%- if past %}{% assign items = Target.Items | reverse %}{% else %}{% assign items = Target.Items %}{% endif -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Agendas and minutes</li></ol></nav><h1>Public meetings, agendas and minutes</h1><p>Every meeting of the City Council and city boards is open to the public. Agendas are posted at least 72 hours ahead, minutes once they are approved.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/meetings"><div><label for="mb">Body</label><select id="mb" name="body"><option value="">All bodies</option>{% for b in bq.Items %}{% assign bid = b.Id | append: "" %}<option value="{{ bid }}"{% if qb == bid %} selected{% endif %}>{{ b.PrimaryField }}</option>{% endfor %}</select></div>
  <div><label for="mw">Show</label><select id="mw" name="when"><option value="upcoming">Upcoming meetings</option><option value="past"{% if past %} selected{% endif %}>Past meetings</option></select></div>
  <button class="btn btn-p" type="submit">Show meetings</button><a class="btn btn-o" href="{{ PathBase }}/feeds/meetings.ics" style="margin-left:auto"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Subscribe (iCal)</a></form>
<div class="split"><div><h2 style="font-size:1.4rem;margin-bottom:14px">{% if past %}Past{% else %}Upcoming{% endif %} meetings{% if qb != "" %}: {{ qbn }}{% endif %}</h2>
<div class="card">{% assign c = 0 %}{% for m in items %}{% capture d %}{{ m.PublishedContent.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% assign mb = m.PublishedContent.board.Id | append: "" %}{% if qb == "" or qb == mb %}{% assign show = false %}{% if past %}{% if d < today %}{% assign show = true %}{% endif %}{% else %}{% if d >= today %}{% assign show = true %}{% endif %}{% endif %}{% if show %}{% assign c = c | plus: 1 %}{% assign x = m.PublishedContent %}{% capture ms %}{{ x.status }}{% endcapture %}{% capture ag %}{{ x.agenda.Value }}{% endcapture %}{% capture mn %}{{ x.minutes.Value }}{% endcapture %}{% capture vu %}{{ x.video_url }}{% endcapture %}{% for pair in mst %}{% assign kv = pair | split: ":" %}{% if kv[0] == ms %}{% assign msl = kv[1] %}{% assign msc = kv[2] %}{% endif %}{% endfor %}
<div class="mtg"><div class="date" aria-hidden="true"><span>{{ x.start.Value | date: "%b" }}</span><b>{{ x.start.Value | date: "%-d" }}</b><small>{{ x.start.Value | date: "%a" }}</small></div>
  <div style="min-width:0"><h3><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></h3><p>{{ x.time_label }} &middot; {{ x.location }}{% if ms != "scheduled" %} &middot; <span class="pill {{ msc }}">{{ msl }}</span>{% endif %}</p>
  <div class="docs">{% if ag != "" %}<a href="{{ x.agenda.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Agenda<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if mn != "" %}<a href="{{ x.minutes.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Minutes<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if vu != "" %}<a href="{{ vu }}" rel="noopener"><i class="bi bi-play-btn" aria-hidden="true"></i> Video<span class="vh"> of {{ m.PrimaryField }}</span></a>{% endif %}{% if ms == "scheduled" and ag == "" %}<span>Agenda posted 72 hours ahead</span>{% endif %}{% if ms == "cancelled" %}<span>No meeting</span>{% endif %}</div></div></div>{% endif %}{% endif %}{% endfor %}
{% if c == 0 %}<div class="pad"><p class="muted" style="margin:0">No {% if past %}past{% else %}upcoming{% endif %} meetings match. Try another body.</p></div>{% endif %}</div></div>
<aside class="grid" style="gap:20px"><div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:10px">Speak at a meeting</h2><p style="font-size:.95rem">Anyone can speak during public comment for up to three minutes. Fill in a speaker card at the meeting, or email the City Secretary by noon on the meeting day to comment in writing.</p><a href="mailto:citysecretary@juniperfalls.example" style="font-weight:700">citysecretary@juniperfalls.example</a></div>
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:6px">Boards and commissions</h2>{% for b in bq.Items %}<a class="nli" href="{{ PathBase }}/{{ b.RoutePath }}" style="padding:10px 0"><span><b style="font-size:.96rem">{{ b.PrimaryField }}</b><small>{{ b.PublishedContent.meets }}</small></span></a>{% endfor %}</div>
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:6px">Watch live</h2><p style="font-size:.95rem;margin:0">Council meetings stream live on JFTV, cable channel 16, and on the city's video page.</p></div></aside></div>
</div></div>
