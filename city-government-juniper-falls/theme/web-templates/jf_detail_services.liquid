{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture sa %}{{ p.action }}{% endcapture %}{% for pair in acts %}{% assign kv = pair | split: ":" %}{% if kv[0] == sa %}{% assign al = kv[1] %}{% assign ai = kv[2] %}{% endif %}{% endfor %}{% capture ou %}{{ p.online_url }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/services">How do I...</a></li><li><a href="{{ PathBase }}/services?action={{ sa }}">{{ al }}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill gold" style="margin-bottom:10px"><i class="bi bi-{{ ai }}" aria-hidden="true"></i> {{ al }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article class="card pad prose" style="padding:32px">{{ p.body }}</article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    {% if ou != "" %}{% assign first = ou | slice: 0 %}<div class="cta">{% if first == "/" %}<h2 style="font-size:1.25rem">Start here</h2><p style="margin:8px 0 16px;font-size:.95rem">Everything you need is on this website.</p><a class="btn btn-g" href="{{ PathBase }}{{ ou }}">{{ p.online_label }}</a>{% else %}<h2 style="font-size:1.25rem">Do it online</h2><p style="margin:8px 0 16px;font-size:.95rem">This takes you to the city's secure {{ p.department.PrimaryField }} system.</p><a class="btn btn-g ext" href="{{ ou }}" rel="noopener">{{ p.online_label }}</a>{% endif %}</div>{% endif %}
    <div class="card pad"><dl class="facts"><div><dt>Cost</dt><dd>{{ p.fee }}</dd></div><div><dt>Time needed</dt><dd>{{ p.time_needed }}</dd></div><div><dt>Department</dt><dd><a href="{{ PathBase }}/{{ p.department.RoutePath }}">{{ p.department.PrimaryField }}</a></dd></div><div><dt>Phone</dt><dd><a href="tel:{{ p.department.PublishedContent.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.department.PublishedContent.phone }}</a></dd></div><div><dt>Hours</dt><dd>{{ p.department.PublishedContent.hours }}</dd></div></dl></div>
    {%- capture f %}department eq '{{ p.department.Id }}'{% endcapture %}{% assign rel = get_content_items(ContentType="services", Filter=f, OrderBy="sort_order asc", PageSize=6) -%}
    {% if rel.TotalCount > 1 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.1rem">More from {{ p.department.PrimaryField }}</h2></div>{% for s in rel.Items %}{% if s.Id != Target.Id %}{% assign x = s.PublishedContent %}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><small>{{ x.summary }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endif %}{% endfor %}</div>{% endif %}
  </aside>
</div></div>
