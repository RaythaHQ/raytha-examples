{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Mayor and Council</li></ol></nav><h1>Mayor and City Council</h1><p>Juniper Falls has a council-manager government. The Mayor and six district council members are elected to staggered four-year terms and hire the City Manager.</p></div></div>
<div class="body"><div class="wrap">
{%- for o in Target.Items %}{% if forloop.first %}{% assign x = o.PublishedContent %}<div class="card mayor"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt="Portrait of {{ o.PrimaryField }}"><div><span class="kicker">{{ x.role }}</span><h2 style="font-size:2rem;margin:6px 0 10px"><a href="{{ PathBase }}/{{ o.RoutePath }}" style="color:var(--ink);text-decoration:none">{{ o.PrimaryField }}</a></h2><p style="font-size:1.05rem">{{ x.bio | truncate: 260 }}</p><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-p" href="mailto:{{ x.email }}"><i class="bi bi-envelope" aria-hidden="true"></i> Email the Mayor</a><a class="btn btn-o" href="{{ PathBase }}/{{ o.RoutePath }}">Biography</a></div></div></div>{% endif %}{% endfor %}
<h2 style="margin:40px 0 16px">City Council</h2>
<div class="grid g3">{% for o in Target.Items %}{% unless forloop.first %}{% assign x = o.PublishedContent %}<a class="card pad" href="{{ PathBase }}/{{ o.RoutePath }}" style="display:flex;gap:16px;align-items:center;text-decoration:none;color:var(--text)"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt="" style="width:84px;height:84px;border-radius:50%"><span><span class="pill navy">{{ x.district }}</span><b style="display:block;color:var(--ink);font-size:1.1rem;margin-top:6px">{{ o.PrimaryField }}</b><small class="muted">{{ x.role }} &middot; term ends {{ x.term_ends.Value | date: "%b %Y" }}</small></span></a>{% endunless %}{% endfor %}</div>
<div class="card pad" style="margin-top:28px;display:flex;gap:18px;align-items:center;flex-wrap:wrap"><i class="bi bi-geo" style="font-size:1.8rem;color:var(--blue)" aria-hidden="true"></i><div style="flex:1;min-width:240px"><h3>Not sure which district you live in?</h3><p class="muted" style="margin:4px 0 0">Look up your address on the city map, or call the City Secretary at (555) 010-4010.</p></div><a class="btn btn-o ext" href="https://maps.juniperfalls.example/districts" rel="noopener">Find my district</a><a class="btn btn-p" href="{{ PathBase }}/meetings">Council agendas</a></div>
</div></div>
