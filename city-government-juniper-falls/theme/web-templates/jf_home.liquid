{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{{ render_section("hero", wrap=false) }}
{%- assign tops = get_content_items(ContentType="services", Filter="top_task eq 'true'", OrderBy="sort_order asc", PageSize=8) -%}
<section class="tasks" aria-labelledby="tt"><div class="wrap"><h2 id="tt" style="position:absolute;left:-9999px">Popular services</h2><div class="tgrid">
{%- for s in tops.Items %}{% assign x = s.PublishedContent %}<a class="task" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><span>{{ x.summary }}</span></span></a>{% endfor %}
</div><p style="text-align:right;margin:14px 0 0"><a class="more" href="{{ PathBase }}/services">All services <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p></div></section>
{%- assign mq = get_content_items(ContentType="meetings", OrderBy="start asc", PageSize=60) -%}
{%- assign nq = get_content_items(ContentType="notices", OrderBy="posted_on desc", PageSize=5) -%}
<section class="sec" aria-labelledby="mh"><div class="wrap split">
  <div><div class="shead"><div><span class="kicker">Open government</span><h2 id="mh">Upcoming public meetings</h2><p>Agendas are posted at least 72 hours before each meeting.</p></div><a class="more" href="{{ PathBase }}/meetings">All agendas and minutes <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="card">{% assign c = 0 %}{% for m in mq.Items %}{% capture d %}{{ m.PublishedContent.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% if d >= today and c < 4 %}{% assign c = c | plus: 1 %}{% assign x = m.PublishedContent %}{% capture ms %}{{ x.status }}{% endcapture %}{% capture ag %}{{ x.agenda.Value }}{% endcapture %}{% capture mn %}{{ x.minutes.Value }}{% endcapture %}{% capture vu %}{{ x.video_url }}{% endcapture %}{% for pair in mst %}{% assign kv = pair | split: ":" %}{% if kv[0] == ms %}{% assign msl = kv[1] %}{% assign msc = kv[2] %}{% endif %}{% endfor %}
<div class="mtg"><div class="date" aria-hidden="true"><span>{{ x.start.Value | date: "%b" }}</span><b>{{ x.start.Value | date: "%-d" }}</b><small>{{ x.start.Value | date: "%a" }}</small></div>
  <div style="min-width:0"><h3><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></h3><p>{{ x.time_label }} &middot; {{ x.location }}{% if ms != "scheduled" %} &middot; <span class="pill {{ msc }}">{{ msl }}</span>{% endif %}</p>
  <div class="docs">{% if ag != "" %}<a href="{{ x.agenda.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Agenda<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if mn != "" %}<a href="{{ x.minutes.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Minutes<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if vu != "" %}<a href="{{ vu }}" rel="noopener"><i class="bi bi-play-btn" aria-hidden="true"></i> Video<span class="vh"> of {{ m.PrimaryField }}</span></a>{% endif %}{% if ms == "scheduled" and ag == "" %}<span>Agenda posted 72 hours ahead</span>{% endif %}{% if ms == "cancelled" %}<span>No meeting</span>{% endif %}</div></div></div>{% endif %}{% endfor %}</div>
    <p style="margin:12px 0 0;font-size:.92rem"><a href="{{ PathBase }}/feeds/meetings.ics"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Add every public meeting to your calendar</a></p></div>
  <div><div class="shead"><div><span class="kicker">Legal notices</span><h2>Public notices</h2><p>Hearings, bids and new ordinances.</p></div><a class="more" href="{{ PathBase }}/notices">All notices <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
    <div class="card">{% for n in nq.Items %}{% assign x = n.PublishedContent %}{% capture nk %}{{ x.kind }}{% endcapture %}{% for pair in nks %}{% assign kv = pair | split: ":" %}{% if kv[0] == nk %}{% assign nkl = kv[1] %}{% assign nki = kv[2] %}{% endif %}{% endfor %}
<a class="ntc" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ nki }}"></i></span><span><small>{{ nkl }} &middot; posted {{ x.posted_on.Value | date: "%b %-d" }}{% if x.deadline.Value %} &middot; <b style="display:inline;color:var(--ink);font-size:.82rem">{% if nk == "bid" %}Due{% else %}Date{% endif %} {{ x.deadline.Value | date: "%b %-d" }}</b>{% endif %}</small><b>{{ n.PrimaryField }}</b></span></a>{% endfor %}</div>
    <p style="margin:12px 0 0;font-size:.92rem"><a href="{{ PathBase }}/feeds/notices.rss"><i class="bi bi-rss" aria-hidden="true"></i> Follow notices by RSS</a></p></div>
</div></section>
{%- assign fq = get_content_items(ContentType="news", Filter="featured eq 'true'", OrderBy="posted_on desc", PageSize=1) -%}{%- assign f = fq.Items | first -%}
{%- assign rq = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=5) -%}
<section class="sec alt" aria-labelledby="nh"><div class="wrap">
  <div class="shead"><div><span class="kicker">Newsroom</span><h2 id="nh">City news</h2></div><a class="more" href="{{ PathBase }}/news">All news releases <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="split">
    {% if f %}{% assign x = f.PublishedContent %}{% capture ck %}{{ x.category }}{% endcapture %}{% for pair in ncats %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}<a class="card feat" href="{{ PathBase }}/{{ f.RoutePath }}" style="grid-template-columns:1fr"><div class="img" style="min-height:260px;background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ f.PrimaryField }}</h3><p class="muted" style="margin:0">{{ x.summary }}</p></div></a>{% endif %}
    <div class="card pad">{% assign c = 0 %}{% for a in rq.Items %}{% if a.Id != f.Id and c < 4 %}{% assign c = c | plus: 1 %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }} &middot; {{ a.PublishedContent.department.PrimaryField }}</small></span></a>{% endif %}{% endfor %}</div>
  </div>
</div></section>
{%- assign eq = get_content_items(ContentType="events", OrderBy="start asc", PageSize=40) -%}
<section class="sec" aria-labelledby="eh"><div class="wrap">
  <div class="shead"><div><span class="kicker">Community calendar</span><h2 id="eh">Things to do in Juniper Falls</h2></div><a class="more" href="{{ PathBase }}/events">Full calendar <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g4">{% assign c = 0 %}{% for e in eq.Items %}{% capture d %}{{ e.PublishedContent.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% if d >= today and c < 4 %}{% assign c = c | plus: 1 %}{% assign x = e.PublishedContent %}{% capture ek %}{{ x.category }}{% endcapture %}{% for pair in evc %}{% assign kv = pair | split: ":" %}{% if kv[0] == ek %}{% assign el = kv[1] %}{% assign ei = kv[2] %}{% endif %}{% endfor %}{% capture fr %}{{ x.free | downcase }}{% endcapture %}
<a class="card ncard" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><div style="display:flex;gap:6px;flex-wrap:wrap"><span class="pill blue"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span>{% if fr == "true" %}<span class="pill green">Free</span>{% endif %}</div><h3>{{ e.PrimaryField }}</h3><p><i class="bi bi-calendar3" aria-hidden="true"></i> {{ x.start.Value | date: "%a, %b %-d" }} &middot; {{ x.time_label }}<br><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ x.location }}</p></div></a>{% endif %}{% endfor %}</div>
</div></section>
{{ render_section("main", wrap=false) }}
{%- assign oq = get_content_items(ContentType="officials", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec alt" aria-labelledby="ch"><div class="wrap">
  <div class="shead"><div><span class="kicker">Your elected officials</span><h2 id="ch">Mayor and City Council</h2><p>The Council meets on the second and fourth Tuesday of each month at 6 pm.</p></div><a class="more" href="{{ PathBase }}/council">Meet the Council <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid council" style="grid-template-columns:repeat(7,minmax(0,1fr));gap:8px">{% for o in oq.Items %}<a class="cm" href="{{ PathBase }}/{{ o.RoutePath }}"><img src="{{ o.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""><b>{{ o.PrimaryField }}</b><span>{{ o.PublishedContent.role }}{% if o.PublishedContent.district != "" and o.PublishedContent.district %}, {{ o.PublishedContent.district }}{% endif %}</span></a>{% endfor %}</div>
</div></section>
