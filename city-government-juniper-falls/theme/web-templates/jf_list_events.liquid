{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign qc = "" -%}{%- for pair in evc %}{% assign kv = pair | split: ":" %}{% if QueryParams.category == kv[0] %}{% assign qc = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Community calendar</li></ol></nav><h1>Community calendar</h1><p>Festivals, library programs, parks activities and civic events around Juniper Falls.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter events"><a href="{{ PathBase }}/events"{% if qc == "" %} aria-current="true"{% endif %}>Everything</a>{% for pair in evc %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/events?category={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="grid g3">{% for e in Target.Items %}{% capture k %}{{ e.PublishedContent.category }}{% endcapture %}{% capture d %}{{ e.PublishedContent.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% if d >= today %}{% if qc == "" or qc == k %}{% assign x = e.PublishedContent %}{% capture ek %}{{ x.category }}{% endcapture %}{% for pair in evc %}{% assign kv = pair | split: ":" %}{% if kv[0] == ek %}{% assign el = kv[1] %}{% assign ei = kv[2] %}{% endif %}{% endfor %}{% capture fr %}{{ x.free | downcase }}{% endcapture %}
<a class="card ncard" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><div style="display:flex;gap:6px;flex-wrap:wrap"><span class="pill blue"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span>{% if fr == "true" %}<span class="pill green">Free</span>{% endif %}</div><h3>{{ e.PrimaryField }}</h3><p><i class="bi bi-calendar3" aria-hidden="true"></i> {{ x.start.Value | date: "%a, %b %-d" }} &middot; {{ x.time_label }}<br><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ x.location }}</p></div></a>{% endif %}{% endif %}{% endfor %}</div>
</div></div>
