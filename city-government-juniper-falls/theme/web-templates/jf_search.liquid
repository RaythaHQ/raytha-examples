{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign q = QueryParams.q | strip | remove: "'" | remove: '"' | remove: "<" | remove: ">" | truncate: 60, "" -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Search</li></ol></nav><h1>{% if q != "" %}Search results for “{{ q }}”{% else %}Search the city website{% endif %}</h1><p>Services, departments, meetings, public notices, news and events.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/search" role="search"><div class="grow"><label for="sq">Search for</label><input id="sq" name="q" value="{{ q }}" placeholder="Try “trash”, “permit” or “budget”"></div><button class="btn btn-p" type="submit">Search</button></form>
{%- if q != "" -%}
{%- capture f1 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f2 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}') or contains(about,'{{ q }}'){% endcapture -%}
{%- assign rs = get_content_items(ContentType="services", Filter=f1, OrderBy="sort_order asc", PageSize=12) -%}{%- assign rd = get_content_items(ContentType="departments", Filter=f2, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rm = get_content_items(ContentType="meetings", Filter=f1, OrderBy="start desc", PageSize=12) -%}{%- assign rn = get_content_items(ContentType="notices", Filter=f1, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign rw = get_content_items(ContentType="news", Filter=f1, OrderBy="posted_on desc", PageSize=12) -%}{%- assign re = get_content_items(ContentType="events", Filter=f1, OrderBy="start asc", PageSize=12) -%}
{%- assign total = rs.TotalCount | plus: rd.TotalCount | plus: rm.TotalCount | plus: rn.TotalCount | plus: rw.TotalCount | plus: re.TotalCount -%}
<p class="muted" role="status" style="margin:-6px 0 20px">{{ total }} result{% if total != 1 %}s{% endif %}</p>
<div class="grid g2">
{% if rs.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Services</h2></div>{% for s in rs.Items %}{% assign x = s.PublishedContent %}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><small>{{ x.summary }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endfor %}</div>{% endif %}
{% if rd.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Departments</h2></div>{% for d in rd.Items %}<a class="svc" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" style="background:{{ d.PublishedContent.color }};color:#fff" aria-hidden="true"><i class="bi bi-{{ d.PublishedContent.icon }}"></i></span><span><b>{{ d.PrimaryField }}</b><small>{{ d.PublishedContent.summary }}</small></span></a>{% endfor %}</div>{% endif %}
{% if rm.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Meetings</h2></div>{% for m in rm.Items %}{% assign x = m.PublishedContent %}{% capture ms %}{{ x.status }}{% endcapture %}{% capture ag %}{{ x.agenda.Value }}{% endcapture %}{% capture mn %}{{ x.minutes.Value }}{% endcapture %}{% capture vu %}{{ x.video_url }}{% endcapture %}{% for pair in mst %}{% assign kv = pair | split: ":" %}{% if kv[0] == ms %}{% assign msl = kv[1] %}{% assign msc = kv[2] %}{% endif %}{% endfor %}
<div class="mtg"><div class="date" aria-hidden="true"><span>{{ x.start.Value | date: "%b" }}</span><b>{{ x.start.Value | date: "%-d" }}</b><small>{{ x.start.Value | date: "%a" }}</small></div>
  <div style="min-width:0"><h3><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></h3><p>{{ x.time_label }} &middot; {{ x.location }}{% if ms != "scheduled" %} &middot; <span class="pill {{ msc }}">{{ msl }}</span>{% endif %}</p>
  <div class="docs">{% if ag != "" %}<a href="{{ x.agenda.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Agenda<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if mn != "" %}<a href="{{ x.minutes.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Minutes<span class="vh"> for {{ m.PrimaryField }} (PDF)</span></a>{% endif %}{% if vu != "" %}<a href="{{ vu }}" rel="noopener"><i class="bi bi-play-btn" aria-hidden="true"></i> Video<span class="vh"> of {{ m.PrimaryField }}</span></a>{% endif %}{% if ms == "scheduled" and ag == "" %}<span>Agenda posted 72 hours ahead</span>{% endif %}{% if ms == "cancelled" %}<span>No meeting</span>{% endif %}</div></div></div>{% endfor %}</div>{% endif %}
{% if rn.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Public notices</h2></div>{% for n in rn.Items %}{% assign x = n.PublishedContent %}{% capture nk %}{{ x.kind }}{% endcapture %}{% for pair in nks %}{% assign kv = pair | split: ":" %}{% if kv[0] == nk %}{% assign nkl = kv[1] %}{% assign nki = kv[2] %}{% endif %}{% endfor %}
<a class="ntc" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ nki }}"></i></span><span><small>{{ nkl }} &middot; posted {{ x.posted_on.Value | date: "%b %-d" }}{% if x.deadline.Value %} &middot; <b style="display:inline;color:var(--ink);font-size:.82rem">{% if nk == "bid" %}Due{% else %}Date{% endif %} {{ x.deadline.Value | date: "%b %-d" }}</b>{% endif %}</small><b>{{ n.PrimaryField }}</b></span></a>{% endfor %}</div>{% endif %}
{% if rw.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">News</h2></div><div class="pad" style="padding-top:8px">{% for a in rw.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div></div>{% endif %}
{% if re.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Events</h2></div><div class="pad" style="padding-top:8px">{% for e in re.Items %}<a class="nli" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="th" style="background-image:url('{{ e.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ e.PrimaryField }}</b><small>{{ e.PublishedContent.start.Value | date: "%a, %B %-d" }} &middot; {{ e.PublishedContent.location }}</small></span></a>{% endfor %}</div></div>{% endif %}
</div>
{% if total == 0 %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nothing matched “{{ q }}”</h2><p class="muted">Try a shorter word, or call City Hall at (555) 010-4000 and we will point you the right way.</p></div>{% endif %}
{%- else -%}
<h2 style="font-size:1.2rem;margin-bottom:12px">Popular searches</h2><div class="chips">{% assign sug = "trash,permit,water bill,budget,pool,library,zoning,jobs" | split: "," %}{% for s in sug %}<a href="{{ PathBase }}/search?q={{ s | url_encode }}">{{ s }}</a>{% endfor %}</div>
{%- endif -%}
</div></div>
