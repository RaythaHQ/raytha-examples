{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture nk %}{{ p.kind }}{% endcapture %}{% for pair in nks %}{% assign kv = pair | split: ":" %}{% if kv[0] == nk %}{% assign nkl = kv[1] %}{% assign nki = kv[2] %}{% endif %}{% endfor %}{% capture doc %}{{ p.document.Value }}{% endcapture %}{% capture dl %}{{ p.deadline.Value }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/notices">Public notices</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill gold" style="margin-bottom:10px"><i class="bi bi-{{ nki }}" aria-hidden="true"></i> {{ nkl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article class="card pad prose" style="padding:32px">{{ p.body }}{% if doc != "" %}<p><a class="btn btn-p" style="text-decoration:none" href="{{ p.document.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download the notice (PDF)</a></p>{% endif %}</article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><dl class="facts"><div><dt>Kind</dt><dd>{{ nkl }}</dd></div><div><dt>Posted</dt><dd>{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></div>{% if dl != "" %}<div><dt>{% if nk == "bid" %}Responses due{% elsif nk == "construction" %}Starts{% else %}Date{% endif %}</dt><dd>{{ p.deadline.Value | date: "%A, %B %-d, %Y" }}</dd></div>{% endif %}<div><dt>Department</dt><dd><a href="{{ PathBase }}/{{ p.department.RoutePath }}">{{ p.department.PrimaryField }}</a></dd></div></dl></div>
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:6px">Questions about this notice</h2><p style="margin:0;font-size:.94rem">{{ p.department.PrimaryField }}<br><a href="tel:{{ p.department.PublishedContent.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.department.PublishedContent.phone }}</a><br><a href="mailto:{{ p.department.PublishedContent.email }}" style="word-break:break-all">{{ p.department.PublishedContent.email }}</a></p></div>
  </aside>
</div></div>
