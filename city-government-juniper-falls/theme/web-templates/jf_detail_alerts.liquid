{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture lv %}{{ p.level }}{% endcapture %}{% capture on %}{{ p.active | downcase }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% endif %}{% endfor %}{% capture lu %}{{ p.link_url }}{% endcapture %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/alerts">Alerts</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {% if lv == "emergency" %}red{% elsif lv == "advisory" %}gold{% else %}blue{% endif %}" style="margin-bottom:10px"><i class="bi bi-{{ li }}" aria-hidden="true"></i> {{ ll }} &middot; {% if on == "true" %}Active{% else %}Ended{% endif %}</span><h1>{{ Target.PrimaryField }}</h1></div></div>
<div class="body"><div class="wrap" style="max-width:900px"><div class="alert {{ lv }}" style="border-radius:14px"><div style="display:flex;gap:14px;padding:22px;align-items:flex-start"><span class="ic" aria-hidden="true"><i class="bi bi-{{ li }}"></i></span><div><p style="font-size:1.08rem">{{ p.message }}</p><p class="muted" style="margin-top:8px;font-size:.9rem">Posted {{ p.posted_on.Value | date: "%A, %B %-d, %Y" }}</p>{% if lu != "" %}<p style="margin-top:12px"><a class="btn btn-p" href="{{ lu }}">More information</a></p>{% endif %}</div></div></div>
<p style="margin-top:20px"><a href="{{ PathBase }}/alerts"><i class="bi bi-arrow-left" aria-hidden="true"></i> All alerts</a></p></div></div>
