<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "City of Juniper Falls" %}{{ Target.Title }} | {% endif %}City of Juniper Falls, Texas</title>
  <meta name="description" content="Official website of the City of Juniper Falls, Texas (a fictional city): city services, meetings, agendas and minutes, public notices, news and events.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,650;8..60,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="alternate" type="application/rss+xml" title="City of Juniper Falls: public notices" href="{{ PathBase }}/feeds/notices.rss">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 52 52'%3E%3Ccircle cx='26' cy='26' r='25' fill='%230f2a44'/%3E%3Cpath d='M26 10l-7 11h4l-6 9h5l-5 8h18l-5-8h5l-6-9h4z' fill='%233f8f66'/%3E%3C/svg%3E">
  <style>:root{--navy:#0f2a44;--navy2:#163a5c;--blue:#1d5fa8;--blue2:#e8f1fb;--gold:#e0a526;--gold2:#fdf3dc;--green:#2f6f4f;--ink:#14202e;--text:#25313f;--muted:#5a6878;--line:#dde3ea;--paper:#f7f6f2;--card:#fff;--red:#b42318;--r:14px;--sh:0 1px 2px rgba(15,42,68,.06),0 10px 28px -16px rgba(15,42,68,.22)}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:"Public Sans",system-ui,sans-serif;font-size:17px;line-height:1.6;color:var(--text);background:var(--paper)}
a{color:var(--blue)}a:hover{color:var(--navy)}img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px;border-radius:4px}
.vh{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:-9999px;top:8px;z-index:100;background:var(--gold);color:var(--ink);padding:10px 16px;border-radius:8px;font-weight:700}.skip:focus{left:12px}
h1,h2,h3,h4{color:var(--ink);line-height:1.18;margin:0;letter-spacing:-.01em}
h1{font-family:"Source Serif 4",Georgia,serif;font-weight:650;font-size:clamp(2rem,3.6vw,3rem)}h2{font-family:"Source Serif 4",Georgia,serif;font-weight:650;font-size:clamp(1.5rem,2.4vw,2rem)}h3{font-size:1.08rem;font-weight:700}
p{margin:0 0 .9em}.muted{color:var(--muted)}.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.kicker{display:inline-block;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
/* gov bar + header */
.govbar{background:var(--navy);color:#cbd8e6;font-size:.82rem}.govbar .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:7px;padding-bottom:7px;flex-wrap:wrap}.govbar a{color:#fff;text-decoration:none;margin-left:18px}.govbar a:hover{text-decoration:underline}
.hdr{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:40}.hdr .wrap{display:flex;align-items:center;gap:24px;height:82px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);flex:none}.brand b{display:block;font-family:"Source Serif 4",serif;font-size:1.32rem;line-height:1.05;font-weight:700}.brand small{display:block;font-size:.76rem;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;font-weight:600}
.nav{display:flex;gap:2px;list-style:none;margin:0 0 0 8px;padding:0}.nav a{display:block;padding:10px 13px;border-radius:9px;text-decoration:none;color:var(--ink);font-weight:600;font-size:.95rem}.nav a:hover{background:var(--blue2)}.nav a[aria-current=page]{color:var(--blue);box-shadow:inset 0 -3px 0 var(--gold)}
.hacts{margin-left:auto;display:flex;gap:10px;align-items:center}
.btn{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:8px;font:700 .95rem "Public Sans";border-radius:10px;padding:11px 18px;text-decoration:none;border:2px solid transparent;cursor:pointer;line-height:1.2;transition:background .15s,transform .15s}
.btn:hover{transform:translateY(-1px)}.btn-p{background:var(--blue);color:#fff}.btn-p:hover{background:var(--navy);color:#fff}.btn-g{background:var(--gold);color:var(--ink)}.btn-g:hover{background:#c98f12;color:var(--ink)}.btn-o{border-color:var(--line);background:#fff;color:var(--ink)}.btn-o:hover{border-color:var(--blue);color:var(--blue)}.btn-w{background:#fff;color:var(--navy)}
.ext::after{content:"\F1C5";font-family:bootstrap-icons;font-size:.8em;margin-left:2px}
.tog{display:none;background:none;border:2px solid var(--line);border-radius:10px;padding:6px 10px;font-size:1.3rem;color:var(--ink)}
/* alerts */
.alert{border-bottom:1px solid rgba(0,0,0,.08)}.alert .wrap{display:flex;gap:14px;align-items:center;padding-top:12px;padding-bottom:12px}.alert .ic{width:36px;height:36px;flex:none;border-radius:50%;display:grid;place-items:center;font-size:1.1rem}
.alert.advisory{background:var(--gold2)}.alert.advisory .ic{background:var(--gold);color:var(--ink)}.alert.emergency{background:#fde8e6}.alert.emergency .ic{background:var(--red);color:#fff}.alert.info{background:var(--blue2)}.alert.info .ic{background:var(--blue);color:#fff}
.alert b{color:var(--ink)}.alert p{margin:0;font-size:.94rem}.alert a.more{margin-left:auto;font-weight:700;white-space:nowrap}
/* hero */
.hero{position:relative;background:linear-gradient(180deg,#0f2a44 0%,#1d4f86 60%,#2b6cb0 100%);color:#fff;overflow:hidden;padding:60px 0 250px}
.hero h1{color:#fff;font-size:clamp(2.3rem,4.6vw,3.7rem);max-width:760px}.hero p.lead{font-size:1.18rem;color:#dbe7f5;max-width:640px;margin:14px 0 26px}.hero .kicker{color:var(--gold)}
.hsearch{display:flex;max-width:680px;background:#fff;border-radius:14px;padding:6px;box-shadow:0 24px 50px -20px rgba(0,0,0,.5)}.hsearch label{position:absolute;left:-9999px}.hsearch input{flex:1;border:0;outline:0;font:inherit;font-size:1.05rem;padding:12px 16px;min-width:0;color:var(--ink);border-radius:10px}.hsearch input:focus-visible{outline:3px solid var(--gold)}
.pop{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;font-size:.9rem;align-items:center}.pop span{color:#bcd0e6}.pop a{color:#fff;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);padding:5px 12px;border-radius:30px;text-decoration:none}.pop a:hover{background:rgba(255,255,255,.22)}
.sky{position:absolute;left:0;right:0;bottom:0;width:100%;height:300px;pointer-events:none}
.tasks{margin-top:-64px;position:relative;z-index:2}
.tgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.task{display:flex;gap:14px;align-items:flex-start;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:18px;text-decoration:none;color:var(--text);box-shadow:var(--sh);transition:transform .15s,border-color .15s}.task:hover{transform:translateY(-2px);border-color:var(--blue);color:var(--text)}
.task .ic{width:46px;height:46px;flex:none;border-radius:12px;background:var(--blue2);color:var(--blue);display:grid;place-items:center;font-size:1.3rem}.task b{display:block;color:var(--ink);font-size:1rem;line-height:1.3}.task span{display:block;font-size:.86rem;color:var(--muted);margin-top:3px;line-height:1.4}.task span span{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
/* sections */
.sec{padding:56px 0}.sec.alt{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.shead{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:22px;flex-wrap:wrap}.shead p{margin:6px 0 0;color:var(--muted)}
.more{font-weight:700;text-decoration:none;white-space:nowrap}.more:hover{text-decoration:underline}
.grid{display:grid;gap:20px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}.split{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:28px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}.pad{padding:22px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:.76rem;font-weight:700;padding:3px 10px;border-radius:30px;background:#eef2f6;color:#334155;white-space:nowrap}.pill.blue{background:var(--blue2);color:#174a85}.pill.gold{background:var(--gold2);color:#7a5200}.pill.green{background:#e3f1e9;color:#1f5138}.pill.red{background:#fde8e6;color:#8f1d14}.pill.navy{background:var(--navy);color:#fff}
/* meetings */
.mtg{display:flex;gap:18px;padding:18px 20px;border-top:1px solid var(--line);align-items:flex-start}.mtg:first-child{border-top:0}
.date{width:66px;flex:none;text-align:center;border:2px solid var(--navy);border-radius:12px;overflow:hidden;background:#fff}.date span{display:block;background:var(--navy);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 0}.date b{display:block;font-family:"Source Serif 4",serif;font-size:1.65rem;color:var(--ink);line-height:1.2;padding:4px 0 2px}.date small{display:block;font-size:.68rem;color:var(--muted);padding-bottom:4px}
.mtg h3 a{color:var(--ink);text-decoration:none}.mtg h3 a:hover{color:var(--blue);text-decoration:underline}.mtg p{margin:4px 0 8px;font-size:.92rem;color:var(--muted)}.docs{display:flex;gap:8px;flex-wrap:wrap}.docs a,.docs span{font-size:.84rem;font-weight:700;padding:6px 11px;border-radius:8px;border:1px solid var(--line);text-decoration:none;display:inline-flex;gap:6px;align-items:center;background:#fff}.docs a:hover{border-color:var(--blue)}.docs span{color:var(--muted);font-weight:600;background:#f6f7f9}
/* notices */
.ntc{display:flex;gap:14px;padding:16px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.ntc:first-child{border-top:0}.ntc:hover{background:#fafbfc}.ntc .ic{width:40px;height:40px;flex:none;border-radius:10px;display:grid;place-items:center;font-size:1.1rem;background:var(--gold2);color:#8a5a00}.ntc b{display:block;color:var(--ink);line-height:1.35;font-size:.98rem}.ntc small{color:var(--muted);font-size:.82rem}
/* news */
.feat{display:grid;grid-template-columns:1.1fr 1fr;overflow:hidden;text-decoration:none;color:var(--text)}.feat .img{min-height:300px;background-size:cover;background-position:center}.feat .bd{padding:28px}.feat h3{font-family:"Source Serif 4",serif;font-size:1.6rem;font-weight:650;margin:10px 0}.feat:hover h3{color:var(--blue)}
.nli{display:flex;gap:14px;padding:14px 0;border-top:1px solid var(--line);text-decoration:none;color:var(--text)}.nli:first-child{border-top:0;padding-top:0}.nli .th{width:96px;height:66px;flex:none;border-radius:10px;background-size:cover;background-position:center}.nli b{display:block;color:var(--ink);line-height:1.35}.nli:hover b{color:var(--blue);text-decoration:underline}.nli small{color:var(--muted);font-size:.82rem}
.ncard{overflow:hidden;text-decoration:none;color:var(--text);display:flex;flex-direction:column;transition:transform .15s}.ncard:hover{transform:translateY(-3px)}.ncard .img{aspect-ratio:1200/630;background-size:cover;background-position:center}.ncard .bd{padding:18px 20px 22px}.ncard h3{margin:8px 0 6px;line-height:1.3}.ncard:hover h3{color:var(--blue)}.ncard p{font-size:.92rem;color:var(--muted);margin:0}
/* council */
.cm{text-align:center;text-decoration:none;color:var(--text);padding:20px 14px}.cm img{width:104px;height:104px;border-radius:50%;margin:0 auto 12px;border:4px solid #fff;box-shadow:0 6px 16px rgba(15,42,68,.18)}.cm b{display:block;color:var(--ink)}.cm span{font-size:.86rem;color:var(--muted)}.cm:hover b{color:var(--blue)}
.mayor{display:grid;grid-template-columns:220px 1fr;gap:28px;align-items:center;padding:28px}.mayor img{width:220px;height:220px;border-radius:18px}
/* stats */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stats>div{padding:22px;border-left:4px solid var(--gold);background:#fff;border-radius:0 12px 12px 0;box-shadow:var(--sh)}.stats b{display:block;font-family:"Source Serif 4",serif;font-size:2.2rem;color:var(--navy);line-height:1.1}.stats span{color:var(--muted);font-size:.92rem}
/* page */
.phead{background:#fff;border-bottom:1px solid var(--line);padding:34px 0 30px}.phead p{color:var(--muted);font-size:1.08rem;max-width:760px;margin:10px 0 0}
.crumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:.88rem;color:var(--muted);margin-bottom:12px;list-style:none;padding:0}.crumbs a{color:var(--blue)}.crumbs li+li::before{content:"/";margin-right:8px;color:#9aa6b2}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.chips a{font-size:.9rem;font-weight:700;padding:8px 15px;border-radius:30px;background:#fff;border:2px solid var(--line);color:var(--ink);text-decoration:none}.chips a:hover{border-color:var(--blue)}.chips a[aria-current=true]{background:var(--navy);border-color:var(--navy);color:#fff}
.body{padding:40px 0 70px}.art{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:30px;align-items:start}
.prose{font-size:1.05rem;line-height:1.72}.prose h2{font-size:1.4rem;margin:1.4em 0 .5em}.prose ul,.prose ol{padding-left:1.3em}.prose li{margin:.35em 0}
.facts{margin:0}.facts>div{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-top:1px solid var(--line);font-size:.94rem}.facts>div:first-child{border-top:0;padding-top:0}.facts dt{color:var(--muted);margin:0}.facts dd{margin:0;color:var(--ink);font-weight:600;text-align:right}
.cta{background:var(--navy);color:#dbe7f5;border-radius:16px;padding:26px;position:relative;overflow:hidden}.cta h2,.cta h3{color:#fff}.cta::after{content:"";position:absolute;right:-60px;bottom:-60px;width:180px;height:180px;border-radius:50%;border:30px solid rgba(224,165,38,.25)}
.svc{display:flex;gap:16px;padding:18px 20px;border-top:1px solid var(--line);text-decoration:none;color:var(--text);align-items:center}.svc:first-child{border-top:0}.svc:hover{background:#fafbfc}.svc .ic{width:44px;height:44px;flex:none;border-radius:11px;display:grid;place-items:center;font-size:1.2rem;background:var(--blue2);color:var(--blue)}.svc b{display:block;color:var(--ink)}.svc:hover b{color:var(--blue);text-decoration:underline}.svc small{display:block;color:var(--muted);font-size:.88rem}.svc .go{margin-left:auto;color:var(--muted)}
.dept{padding:22px;text-decoration:none;color:var(--text);display:flex;flex-direction:column;border-top:5px solid var(--c)}.dept:hover h3{color:var(--blue);text-decoration:underline}.dept .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;font-size:1.3rem;color:#fff;background:var(--c);margin-bottom:14px}.dept p{font-size:.92rem;color:var(--muted);margin:6px 0 14px}.dept .ph{margin-top:auto;font-size:.88rem;font-weight:700;color:var(--ink)}
.fbar{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:22px;padding:16px;background:#fff;border:1px solid var(--line);border-radius:12px}.fbar label{display:block;font-size:.82rem;font-weight:700;color:var(--ink);margin-bottom:4px}.fbar input,.fbar select{border:2px solid var(--line);border-radius:9px;padding:9px 12px;font:inherit;font-size:.95rem;background:#fff;color:var(--ink);min-height:44px}.fbar .grow{flex:1;min-width:220px}.fbar input{width:100%}
.zone{padding:22px;border-top:5px solid var(--c)}.zone .day{font-family:"Source Serif 4",serif;font-size:1.7rem;color:var(--ink);margin:4px 0}.zone p{font-size:.92rem;color:var(--muted);margin:0}
table.t{width:100%;border-collapse:collapse;font-size:.95rem}table.t th,table.t td{padding:12px 14px;border-bottom:1px solid var(--line);text-align:left}table.t th{font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.faq details{border-top:1px solid var(--line);padding:14px 0}.faq details:first-child{border-top:0}.faq summary{cursor:pointer;font-weight:700;color:var(--ink)}.faq p{margin:10px 0 0;color:var(--muted)}
.sub{display:flex;gap:14px;align-items:center;padding:16px 18px;border:1px solid rgba(255,255,255,.18);border-radius:12px;color:#fff;text-decoration:none;background:rgba(255,255,255,.06)}.sub:hover{background:rgba(255,255,255,.12);color:#fff}.sub i{font-size:1.4rem;color:var(--gold)}.sub small{display:block;color:#b9cbe0}
/* footer */
.foot{background:var(--navy);color:#c6d4e3;padding:54px 0 0;margin-top:0}.foot h2{color:#fff;font-size:1.06rem;font-family:"Public Sans";font-weight:700;margin-bottom:12px}.foot a{color:#fff;text-decoration:none}.foot a:hover{text-decoration:underline}.foot ul{list-style:none;padding:0;margin:0}.foot li{margin:7px 0;font-size:.94rem}.fcols{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:30px}.fbot{border-top:1px solid rgba(255,255,255,.12);margin-top:40px;padding:18px 0;font-size:.84rem;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
@media (max-width:1100px){.nav a{padding:10px 9px;font-size:.9rem}.hacts .btn-o{display:none}}
.subband{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:28px;align-items:center}
@media (max-width:980px){.subband{grid-template-columns:1fr}.council{grid-template-columns:repeat(4,minmax(0,1fr))!important}.hdr .wrap{height:70px}.nav{display:none;position:absolute;left:0;right:0;top:70px;background:#fff;flex-direction:column;padding:10px 20px 18px;border-bottom:1px solid var(--line);box-shadow:0 20px 30px -20px rgba(0,0,0,.3)}.hdr.open .nav{display:flex}.nav a{padding:13px 10px;font-size:1rem}.tog{display:block}.hacts{margin-left:auto}.tgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.split,.art,.feat{grid-template-columns:1fr}.g3,.g4{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,1fr)}.fcols{grid-template-columns:1fr 1fr}.mayor{grid-template-columns:1fr}.mayor img{width:160px;height:160px}}
@media (max-width:620px){body{font-size:16px}.hacts .btn-g{display:none}.hero{padding:40px 0 190px}.sky{height:220px}.wrap{padding:0 18px}.govbar .r{display:none}.brand b{font-size:1.12rem}.brand svg{width:42px;height:42px}.hacts .btn-g{padding:9px 12px;font-size:.88rem}.tasks{margin-top:-50px}.tgrid,.g2,.g3,.g4{grid-template-columns:1fr}.task{padding:14px}.mtg{padding:16px}.date{width:58px}.fcols{grid-template-columns:1fr}.alert a.more{display:none}.stats b{font-size:1.7rem}.cm img{width:84px;height:84px}.council{grid-template-columns:repeat(2,minmax(0,1fr))!important}}</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign path = Target.RoutePath | default: "" -%}{%- assign seg = path | split: "/" | first -%}
{%- if seg == "boards" -%}{%- assign seg = "council" -%}{%- endif -%}
<div class="govbar"><div class="wrap"><span><i class="bi bi-bank2" aria-hidden="true"></i> Official website of the City of Juniper Falls, Texas <span class="muted" style="color:#9fb3c8">(a fictional city)</span></span><span class="r"><a href="{{ PathBase }}/accessibility">Accessibility</a><a href="{{ PathBase }}/contact">Contact us</a><a href="tel:+15550104000"><i class="bi bi-telephone" aria-hidden="true"></i> (555) 010-4000</a></span></div></div>
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="brand" href="{{ PathBase }}/" aria-label="City of Juniper Falls home"><svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25" fill="#0f2a44"/><circle cx="26" cy="26" r="21.5" fill="none" stroke="#e0a526" stroke-width="1.6"/><path d="M26 10l-7 11h4l-6 9h5l-5 8h18l-5-8h5l-6-9h4z" fill="#3f8f66"/><rect x="24.6" y="37" width="2.8" height="5" fill="#9fd3b5"/><path d="M12 41c4-2 8-2 14 0s10 2 14 0" stroke="#5b9bd5" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="36.5" cy="15.5" r="3" fill="#e0a526"/></svg><span><b>City of Juniper Falls</b><small>Texas</small></span></a>
    <nav aria-label="Main"><ul class="nav" id="nav">
      {%- assign menu = get_main_menu() %}
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}"{% if u == seg and u != "" %} aria-current="page"{% endif %}>{{ mi.Label }}</a></li>
      {%- endfor %}
    </ul></nav>
    <div class="hacts"><a class="btn btn-o" href="{{ PathBase }}/search"><i class="bi bi-search" aria-hidden="true"></i> Search</a><a class="btn btn-g ext" href="https://pay.juniperfalls.example" rel="noopener">Pay a bill</a>
      <button class="tog" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu" onclick="var h=document.getElementById('hdr');var o=h.classList.toggle('open');this.setAttribute('aria-expanded',o)"><i class="bi bi-list" aria-hidden="true"></i></button></div>
  </div>
</header>
{%- assign al = get_content_items(ContentType="alerts", Filter="active eq 'true'", OrderBy="posted_on desc", PageSize=3) -%}
{%- if seg != "alerts" %}{% for a in al.Items %}{% capture lv %}{{ a.PublishedContent.level }}{% endcapture %}{% for pair in lvs %}{% assign kv = pair | split: ":" %}{% if kv[0] == lv %}{% assign ll = kv[1] %}{% assign li = kv[2] %}{% endif %}{% endfor %}
<div class="alert {{ lv }}" role="region" aria-label="{{ ll }} alert"><div class="wrap"><span class="ic" aria-hidden="true"><i class="bi bi-{{ li }}"></i></span><p><b>{{ ll }}: {{ a.PrimaryField }}.</b> {{ a.PublishedContent.message }}</p><a class="more" href="{{ PathBase }}/{{ a.RoutePath }}">Details <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div></div>
{%- endfor %}{% endif %}
<main id="main" tabindex="-1">{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <div class="fcols">
      <div><a class="brand" href="{{ PathBase }}/" style="color:#fff;margin-bottom:16px"><svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true"><circle cx="26" cy="26" r="25" fill="#0f2a44"/><circle cx="26" cy="26" r="21.5" fill="none" stroke="#e0a526" stroke-width="1.6"/><path d="M26 10l-7 11h4l-6 9h5l-5 8h18l-5-8h5l-6-9h4z" fill="#3f8f66"/><rect x="24.6" y="37" width="2.8" height="5" fill="#9fd3b5"/><path d="M12 41c4-2 8-2 14 0s10 2 14 0" stroke="#5b9bd5" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="36.5" cy="15.5" r="3" fill="#e0a526"/></svg><span><b style="color:#fff">City of Juniper Falls</b><small style="color:#9fb3c8">Texas</small></span></a>
        <p style="font-size:.94rem;margin:0">City Hall, 300 W Main St<br>Juniper Falls, TX 78600<br>Monday to Friday, 8 am to 5 pm</p>
        <p style="font-size:.94rem;margin:12px 0 0"><a href="tel:+15550104000">(555) 010-4000</a> &middot; <a href="mailto:cityhall@juniperfalls.example">cityhall@juniperfalls.example</a></p>
        <p style="font-size:.88rem;margin:12px 0 0;color:#9fb3c8">Emergencies: call 911. Water leaks, 24 hours: (555) 010-4111.</p></div>
      <div><h2>Popular</h2><ul>{% assign fm = get_menu("footer") %}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
      <div><h2>Departments</h2><ul>{% assign dq = get_content_items(ContentType="departments", OrderBy="sort_order asc", PageSize=8) %}{% for d in dq.Items %}<li><a href="{{ PathBase }}/{{ d.RoutePath }}">{{ d.PrimaryField }}</a></li>{% endfor %}<li><a href="{{ PathBase }}/departments">All departments</a></li></ul></div>
      <div><h2>Stay informed</h2><ul><li><a href="{{ PathBase }}/feeds/meetings.ics"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Meetings calendar (iCal)</a></li><li><a href="{{ PathBase }}/feeds/notices.rss"><i class="bi bi-rss" aria-hidden="true"></i> Public notices (RSS)</a></li><li><a href="{{ PathBase }}/alerts">Alerts</a></li><li><a href="{{ PathBase }}/news">News releases</a></li><li><a href="{{ PathBase }}/accessibility">Accessibility statement</a></li></ul></div>
    </div>
    <div class="fbot"><span>&copy; 2026 City of Juniper Falls. A fictional city, made for a Raytha example site.</span><span>Built with <a href="https://raytha.com" style="text-decoration:underline">Raytha</a></span></div>
  </div>
</footer>
<script>
document.addEventListener('keydown',function(e){if(e.key==='Escape'){var h=document.getElementById('hdr');if(h&&h.classList.contains('open')){h.classList.remove('open');var t=h.querySelector('.tog');t.setAttribute('aria-expanded','false');t.focus()}}});
</script>
</body>
</html>
