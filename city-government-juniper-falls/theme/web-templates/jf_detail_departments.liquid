{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{%- capture f %}department eq '{{ Target.Id }}'{% endcapture -%}
{%- assign sv = get_content_items(ContentType="services", Filter=f, OrderBy="sort_order asc", PageSize=10) -%}{%- assign nw = get_content_items(ContentType="news", Filter=f, OrderBy="posted_on desc", PageSize=4) -%}{%- assign nt = get_content_items(ContentType="notices", Filter=f, OrderBy="posted_on desc", PageSize=4) -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/departments">Departments</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill" style="background:{{ p.color }};color:#fff;margin-bottom:10px"><i class="bi bi-{{ p.icon }}" aria-hidden="true"></i> City department</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px">
    <div class="card pad prose" style="padding:30px"><h2 style="margin-top:0">About the department</h2>{{ p.about }}</div>
    {% if sv.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.35rem">Services</h2></div>{% for s in sv.Items %}{% assign x = s.PublishedContent %}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><small>{{ x.summary }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endfor %}</div>{% endif %}
    {% if nw.TotalCount > 0 %}<div class="card pad"><h2 style="font-size:1.35rem;margin-bottom:14px">News</h2>{% for a in nw.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div>{% endif %}
  </div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad" style="border-top:5px solid {{ p.color }}"><h2 style="font-size:1.15rem;margin-bottom:12px">Contact</h2><dl class="facts"><div><dt>Director</dt><dd>{{ p.director }}</dd></div><div><dt>Phone</dt><dd><a href="tel:{{ p.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.phone }}</a></dd></div><div><dt>Email</dt><dd><a href="mailto:{{ p.email }}" style="word-break:break-all">{{ p.email }}</a></dd></div><div><dt>Hours</dt><dd>{{ p.hours }}</dd></div><div><dt>Address</dt><dd>{{ p.address }}</dd></div></dl></div>
    {% if nt.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:0"><h2 style="font-size:1.1rem">Public notices</h2></div>{% for n in nt.Items %}{% assign x = n.PublishedContent %}{% capture nk %}{{ x.kind }}{% endcapture %}{% for pair in nks %}{% assign kv = pair | split: ":" %}{% if kv[0] == nk %}{% assign nkl = kv[1] %}{% assign nki = kv[2] %}{% endif %}{% endfor %}
<a class="ntc" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ nki }}"></i></span><span><small>{{ nkl }} &middot; posted {{ x.posted_on.Value | date: "%b %-d" }}{% if x.deadline.Value %} &middot; <b style="display:inline;color:var(--ink);font-size:.82rem">{% if nk == "bid" %}Due{% else %}Date{% endif %} {{ x.deadline.Value | date: "%b %-d" }}</b>{% endif %}</small><b>{{ n.PrimaryField }}</b></span></a>{% endfor %}</div>{% endif %}
  </aside>
</div></div>
