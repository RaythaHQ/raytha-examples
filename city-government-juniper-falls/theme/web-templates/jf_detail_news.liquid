{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}{% capture ck %}{{ p.category }}{% endcapture %}{% for pair in ncats %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {{ cc }}" style="margin-bottom:10px">{{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;margin-bottom:22px">
    <div class="card pad prose" style="padding:32px"><p class="muted" style="font-size:.92rem">Posted {{ p.posted_on.Value | date: "%A, %B %-d, %Y" }} by {{ p.department.PrimaryField }}</p>{{ p.body }}</div></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">Media contact</h2><p style="margin:0;font-size:.95rem">Communications Office<br><a href="mailto:news@juniperfalls.example">news@juniperfalls.example</a><br>(555) 010-4020</p></div>
    {%- assign more = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=5) -%}
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">More news</h2>{% for a in more.Items %}{% if a.Id != Target.Id %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span><b style="font-size:.95rem">{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d" }}</small></span></a>{% endif %}{% endfor %}</div>
  </aside>
</div></div>
