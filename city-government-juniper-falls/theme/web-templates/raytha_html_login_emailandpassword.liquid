{% if Target.ValidationFailures["__ValidationSummary"] %}<div class="alert advisory" role="alert" style="border-radius:10px;padding:10px 14px;margin-bottom:14px">{{ Target.ValidationFailures["__ValidationSummary"] }}</div>{% endif %}
<form action="{{ PathBase }}/account/login?returnUrl={{ Target.ReturnUrl }}" method="post" class="fbar" style="display:block;border:0;padding:0;margin:0">
  <label for="email">Email</label><input id="email" type="email" name="EmailAddress" autocomplete="email" style="margin-bottom:14px">
  <label for="password">Password</label><input id="password" type="password" name="Password" autocomplete="current-password" style="margin-bottom:18px">
  <button type="submit" class="btn btn-p" style="width:100%">Sign in</button>
  <input name="__RequestVerificationToken" type="hidden" value="{{ Target.RequestVerificationToken }}" />
</form>
<p style="margin:16px 0 0;font-size:.9rem;text-align:center"><a href="{{ PathBase }}/account/login/forgot-password/begin">Forgot your password?</a></p>
