{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Boards and commissions</li></ol></nav><h1>Boards and commissions</h1><p>Residents serve on city boards that advise the Council and decide zoning, parks and library questions. Every meeting is open to the public.</p></div></div>
<div class="body"><div class="wrap"><div class="grid g3">
{%- for b in Target.Items %}{% assign x = b.PublishedContent %}<a class="card dept" style="--c:var(--blue)" href="{{ PathBase }}/{{ b.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><h3 style="font-size:1.15rem">{{ b.PrimaryField }}</h3><p>{{ x.summary }}</p><span class="ph"><i class="bi bi-calendar3" aria-hidden="true"></i> {{ x.meets }} &middot; {{ x.seats }} seats</span></a>{% endfor %}
</div><div class="cta" style="margin-top:28px"><h2 style="font-size:1.35rem">Serve on a board</h2><p style="margin:8px 0 16px;max-width:640px">The Council appoints residents to boards each spring and when seats open. Read about each board, then send the City Secretary a short note about why you want to serve.</p><a class="btn btn-g" href="mailto:citysecretary@juniperfalls.example">Email the City Secretary</a></div></div></div>
