{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign qa = "" -%}{%- for pair in acts %}{% assign kv = pair | split: ":" %}{% if QueryParams.action == kv[0] %}{% assign qa = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">How do I...</li></ol></nav><h1>How do I...</h1><p>Pay a bill, apply for a permit, report a problem or find what you need. Every service lists the fee, how long it takes and who to call.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter services"><a href="{{ PathBase }}/services"{% if qa == "" %} aria-current="true"{% endif %}>All services</a>{% for pair in acts %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/services?action={{ kv[0] }}"{% if qa == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="grid g2">
{%- for pair in acts %}{% assign kv = pair | split: ":" %}{% if qa == "" or qa == kv[0] %}{% assign n = 0 %}{% for s in Target.Items %}{% capture sa %}{{ s.PublishedContent.action }}{% endcapture %}{% if sa == kv[0] %}{% assign n = n | plus: 1 %}{% endif %}{% endfor %}
{% if n > 0 %}<section class="card" aria-labelledby="a-{{ kv[0] }}"><div class="pad" style="padding-bottom:6px;display:flex;gap:10px;align-items:center"><i class="bi bi-{{ kv[2] }}" style="color:var(--gold);font-size:1.3rem" aria-hidden="true"></i><h2 id="a-{{ kv[0] }}" style="font-size:1.35rem">{{ kv[1] }}</h2></div>
{% for s in Target.Items %}{% capture sa %}{{ s.PublishedContent.action }}{% endcapture %}{% if sa == kv[0] %}{% assign x = s.PublishedContent %}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ s.PrimaryField }}</b><small>{{ x.summary }}</small></span><i class="bi bi-chevron-right go" aria-hidden="true"></i></a>{% endif %}{% endfor %}</section>{% endif %}
{%- endif %}{% endfor %}
</div></div></div>
