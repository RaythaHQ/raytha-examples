{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}{%- assign p = Target.PublishedContent -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/council">Mayor and Council</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><h1>{{ Target.PrimaryField }}</h1><p>{{ p.role }}{% if p.district != "" and p.district %}, {{ p.district }}{% endif %}</p></div></div>
<div class="body"><div class="wrap art">
  <article class="card pad" style="padding:32px;display:grid;grid-template-columns:200px 1fr;gap:28px" id="bio"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="Portrait of {{ Target.PrimaryField }}" style="width:200px;height:200px;border-radius:18px"><div class="prose"><h2 style="margin-top:0">Biography</h2><p>{{ p.bio }}</p>
    <h2>Committees</h2><div style="display:flex;gap:8px;flex-wrap:wrap">{% assign cs = p.committees | split: "," %}{% for c in cs %}<span class="pill blue">{{ c | strip }}</span>{% endfor %}</div></div></article>
  <aside class="grid" style="gap:20px">
    <div class="card pad"><dl class="facts"><div><dt>Office</dt><dd>{{ p.role }}</dd></div>{% if p.district != "" and p.district %}<div><dt>District</dt><dd>{{ p.district }}</dd></div>{% endif %}<div><dt>Term ends</dt><dd>{{ p.term_ends.Value | date: "%B %Y" }}</dd></div><div><dt>Phone</dt><dd>{{ p.phone }}</dd></div><div><dt>Email</dt><dd><a href="mailto:{{ p.email }}" style="word-break:break-all">{{ p.email }}</a></dd></div></dl></div>
    <div class="cta"><h2 style="font-size:1.15rem">Next Council meeting</h2>{% assign mq = get_content_items(ContentType="meetings", OrderBy="start asc", PageSize=60) %}{% assign done = false %}{% for m in mq.Items %}{% capture d %}{{ m.PublishedContent.start.Value | date: "%Y-%m-%d" }}{% endcapture %}{% if d >= today and done == false and m.PublishedContent.board.PrimaryField == "City Council" %}{% assign done = true %}<p style="margin:8px 0 14px">{{ m.PublishedContent.start.Value | date: "%A, %B %-d" }} at {{ m.PublishedContent.time_label }}, {{ m.PublishedContent.location }}.</p><a class="btn btn-g" href="{{ PathBase }}/{{ m.RoutePath }}">See the agenda</a>{% endif %}{% endfor %}</div>
  </aside>
</div></div>
