{%- assign acts = "pay:Pay:credit-card,apply:Apply:file-earmark-check,report:Report:megaphone,request:Request:inbox,find:Find:search" | split: "," -%}{%- assign ncats = "city_hall:City Hall:blue,public_safety:Public safety:red,utilities:Water and utilities:blue,parks:Parks and library:green,streets:Streets and transportation:gold,development:Housing and development:navy" | split: "," -%}{%- assign nks = "hearing:Public hearing:megaphone,bid:Bid or RFP:briefcase,ordinance:Ordinance:journal-text,election:Election:check2-square,construction:Construction:cone-striped" | split: "," -%}{%- assign evc = "community:Community:people,parks:Parks and recreation:tree,library:Library:book,arts:Arts and culture:palette,civic:Civic:bank" | split: "," -%}{%- assign mst = "scheduled:Scheduled:blue,held:Held:green,cancelled:Cancelled:red" | split: "," -%}{%- assign lvs = "emergency:Emergency:exclamation-octagon-fill,advisory:Advisory:exclamation-triangle-fill,info:Information:info-circle-fill" | split: "," -%}{%- assign today = "now" | date: "%Y-%m-%d" -%}
{%- assign qk = "" -%}{%- for pair in nks %}{% assign kv = pair | split: ":" %}{% if QueryParams.kind == kv[0] %}{% assign qk = kv[0] %}{% endif %}{% endfor -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Public notices</li></ol></nav><h1>Public notices</h1><p>Public hearings, bids and requests for proposals, ordinances, election notices and construction. Notices are also posted on the board outside City Hall.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter notices"><a href="{{ PathBase }}/notices"{% if qk == "" %} aria-current="true"{% endif %}>All notices</a>{% for pair in nks %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/notices?kind={{ kv[0] }}"{% if qk == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="split"><div class="card">{% assign c = 0 %}{% for n in Target.Items %}{% capture k %}{{ n.PublishedContent.kind }}{% endcapture %}{% if qk == "" or qk == k %}{% assign c = c | plus: 1 %}{% assign x = n.PublishedContent %}{% capture nk %}{{ x.kind }}{% endcapture %}{% for pair in nks %}{% assign kv = pair | split: ":" %}{% if kv[0] == nk %}{% assign nkl = kv[1] %}{% assign nki = kv[2] %}{% endif %}{% endfor %}
<a class="ntc" href="{{ PathBase }}/{{ n.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ nki }}"></i></span><span><small>{{ nkl }} &middot; posted {{ x.posted_on.Value | date: "%b %-d" }}{% if x.deadline.Value %} &middot; <b style="display:inline;color:var(--ink);font-size:.82rem">{% if nk == "bid" %}Due{% else %}Date{% endif %} {{ x.deadline.Value | date: "%b %-d" }}</b>{% endif %}</small><b>{{ n.PrimaryField }}</b></span></a>{% endif %}{% endfor %}{% if c == 0 %}<div class="pad muted">No notices of this kind right now.</div>{% endif %}</div>
<aside class="grid" style="gap:20px"><div class="cta"><h2 style="font-size:1.2rem">Follow public notices</h2><p style="margin:8px 0 16px;font-size:.95rem">Get every new notice in your feed reader, or forward it into your newsroom or neighborhood association's tools.</p><a class="btn btn-g" href="{{ PathBase }}/feeds/notices.rss"><i class="bi bi-rss" aria-hidden="true"></i> RSS feed</a></div>
<div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:6px">Bids and vendors</h2><p style="font-size:.95rem;margin:0">Bid documents are attached to each notice. Questions go to Purchasing at (555) 010-4300 until the question deadline in the notice.</p></div></aside></div>
</div></div>
