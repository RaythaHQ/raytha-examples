{%- assign s = widget.settings -%}<section class="sec" style="padding-bottom:20px"><div class="wrap"><div class="shead"><div><span class="kicker">{{ s.kicker }}</span><h2>{{ s.headline }}</h2><p>{{ s.intro }}</p></div></div>
<div class="grid g4">{% for z in s.items %}<div class="card zone" style="--c:{{ z.color }}"><span class="pill" style="background:{{ z.color }};color:#fff">{{ z.zone }}</span><div class="day">{{ z.day }}</div><p><b style="color:var(--ink)">Recycling:</b> {{ z.recycling }}</p><p style="margin-top:8px">{{ z.areas }}</p></div>{% endfor %}</div></div></section>
