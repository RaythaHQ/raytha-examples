{%- assign s = widget.settings -%}<section class="sec" style="padding-top:20px;padding-bottom:20px"><div class="wrap"><div class="shead"><div><span class="kicker">{{ s.kicker }}</span><h2>{{ s.headline }}</h2>{% if s.intro %}<p>{{ s.intro }}</p>{% endif %}</div></div>
<div class="card" style="overflow-x:auto"><table class="t"><thead><tr><th scope="col">Date</th><th scope="col">Holiday</th><th scope="col">What changes</th></tr></thead><tbody>{% for r in s.rows %}<tr><td style="white-space:nowrap;font-weight:700;color:var(--ink)">{{ r.when }}</td><td>{{ r.what }}</td><td>{{ r.change }}</td></tr>{% endfor %}</tbody></table></div></div></section>
