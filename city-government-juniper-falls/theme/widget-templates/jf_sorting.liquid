{%- assign s = widget.settings -%}<section class="sec" style="padding-top:20px;padding-bottom:20px"><div class="wrap"><div class="shead"><div><span class="kicker">{{ s.kicker }}</span><h2>{{ s.headline }}</h2></div></div>
<div class="grid g3">{% for b in s.items %}<div class="card pad" style="border-top:5px solid {{ b.color }}"><div style="display:flex;gap:12px;align-items:center;margin-bottom:12px"><span style="width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:{{ b.color }};color:#fff;font-size:1.2rem" aria-hidden="true"><i class="bi bi-{{ b.icon }}"></i></span><h3 style="font-size:1.15rem">{{ b.title }}</h3></div>
<h4 style="font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;color:var(--green)">Yes</h4><ul style="margin:6px 0 12px;padding-left:1.2em;font-size:.95rem">{% assign ys = b.yes | newline_to_br | split: "<br />" %}{% for y in ys %}{% assign t = y | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul>
<h4 style="font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;color:var(--red)">No</h4><ul style="margin:6px 0 0;padding-left:1.2em;font-size:.95rem">{% assign ns = b.no | newline_to_br | split: "<br />" %}{% for y in ns %}{% assign t = y | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></div>{% endfor %}</div></div></section>
