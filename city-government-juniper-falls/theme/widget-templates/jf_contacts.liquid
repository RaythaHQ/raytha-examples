{%- assign s = widget.settings -%}<section class="sec" style="padding-top:20px;padding-bottom:20px"><div class="wrap"><div class="shead"><div><span class="kicker">{{ s.kicker }}</span><h2>{{ s.headline }}</h2></div></div>
<div class="grid g3">{% for c in s.items %}<div class="card pad" style="display:flex;gap:14px"><span style="width:44px;height:44px;flex:none;border-radius:12px;display:grid;place-items:center;background:var(--blue2);color:var(--blue);font-size:1.2rem" aria-hidden="true"><i class="bi bi-{{ c.icon }}"></i></span><div><h3>{{ c.name }}</h3><p style="margin:4px 0 2px;font-weight:700"><a href="tel:{{ c.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ c.phone }}</a></p><p class="muted" style="margin:0;font-size:.9rem">{{ c.note }}</p></div></div>{% endfor %}</div></div></section>
