<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} · {% elsif Target.Label %}{{ Target.Label }} · {% elsif Target.Title %}{{ Target.Title }} · {% endif %}Brightwell Medical Supply</title>
  <meta name="description" content="Brightwell Medical Supply: home medical equipment, delivered and set up. Oxygen, CPAP, wheelchairs, hospital beds and bathroom safety, billed to Medicare and most insurance.">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400..800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%230f8b8d'/%3E%3Cpath d='M32 16v32M16 32h32' stroke='%23fff' stroke-width='8' stroke-linecap='round'/%3E%3C/svg%3E">
  <style>
    :root{--navy:#0b2545;--navy2:#13315c;--teal:#0f8b8d;--tealD:#0b6e70;--mint:#dff2ee;--sky:#e8f1f8;--bg:#f5f8f8;--card:#fff;--line:#dce7e7;--ink:#0b2545;--ink2:#34465a;--muted:#5d6e7e;--amber:#f4a259;--r:18px;
      --sans:"Plus Jakarta Sans",system-ui,sans-serif;--mono:"IBM Plex Mono",ui-monospace,monospace;--ease:cubic-bezier(.2,.7,.2,1)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font:16.5px/1.65 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
    a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
    h1,h2,h3,h4{font-weight:800;letter-spacing:-.025em;line-height:1.1;margin:0}
    .wrap{width:min(1200px,100% - 48px);margin-inline:auto}
    @media(max-width:600px){.wrap{width:calc(100% - 32px)}}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--teal)}
    .eyebrow::before{content:"";width:18px;height:2px;background:currentColor;border-radius:2px}
    .muted{color:var(--muted)}
    .code{font:600 .8rem var(--mono);letter-spacing:.02em}
    .btn{display:inline-flex;align-items:center;gap:.5rem;padding:.8rem 1.25rem;border-radius:12px;font:700 .96rem var(--sans);border:1.5px solid transparent;transition:.2s var(--ease);cursor:pointer;white-space:nowrap}
    .btn-teal{background:var(--teal);color:#fff}.btn-teal:hover{background:var(--tealD)}
    .btn-navy{background:var(--navy);color:#fff}.btn-navy:hover{background:#061730}
    .btn-line{border-color:var(--line);background:#fff;color:var(--navy)}.btn-line:hover{border-color:var(--navy)}
    .btn-white{background:#fff;color:var(--navy)}.btn-white:hover{background:var(--mint)}
    .btn-ghost{border-color:rgba(255,255,255,.35);color:#fff}.btn-ghost:hover{background:rgba(255,255,255,.1)}
    .pill{display:inline-flex;align-items:center;gap:.35rem;padding:.28rem .65rem;border-radius:8px;font:700 .74rem var(--sans);background:var(--sky);color:var(--navy2);white-space:nowrap}
    .pill.teal{background:var(--mint);color:var(--tealD)}.pill.amber{background:#fdebd9;color:#8a4b12}.pill.navy{background:var(--navy);color:#fff}.pill.line{background:#fff;border:1px solid var(--line)}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r)}
    .lift{transition:transform .3s var(--ease),box-shadow .3s,border-color .3s}.lift:hover{transform:translateY(-4px);box-shadow:0 22px 40px -26px rgba(11,37,69,.4);border-color:#c6d8d8}
    /* top bar + nav */
    .util{background:var(--navy);color:#c9d6e3;font-size:.84rem}
    .util .wrap{display:flex;gap:22px;align-items:center;height:40px}
    .util a{color:#fff;font-weight:700}.util .r{margin-left:auto;display:flex;gap:18px}
    .util i{color:#7fd1cf;margin-right:6px}
    @media(max-width:900px){.util .hide{display:none}.util .r{display:none}}
    .nav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
    .nav-in{display:flex;align-items:center;gap:26px;height:76px}
    .brand{display:flex;align-items:center;gap:.65rem;font-weight:800;font-size:1.2rem;letter-spacing:-.02em;line-height:1}
    .brand small{display:block;font-weight:600;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-top:3px}
    .nav ul{display:flex;gap:2px;list-style:none;margin:0 auto 0 8px;padding:0}
    .nav ul a{display:block;padding:.5rem .8rem;border-radius:10px;font-size:.95rem;font-weight:600;color:var(--ink2)}
    .nav ul a:hover{background:var(--bg)}.nav ul a.on{color:var(--teal);background:var(--mint)}
    .nav .tog{display:none;background:none;border:0;color:inherit;font-size:1.7rem;margin-left:auto}
    @media(max-width:1020px){.nav ul{display:none;position:absolute;top:76px;left:0;right:0;margin:0;flex-direction:column;background:#fff;padding:12px 16px 20px;border-bottom:1px solid var(--line)}.nav.open ul{display:flex}.nav .tog{display:block}.nav .callbtn{display:none}}
    /* sections */
    .section{padding:88px 0}.section.tight{padding:56px 0}.section.white{background:#fff;border-block:1px solid var(--line)}
    .shead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:34px;flex-wrap:wrap}
    .shead h2{font-size:clamp(1.8rem,3.4vw,2.6rem);margin-top:10px;max-width:700px}
    .shead p{margin:10px 0 0;color:var(--muted);max-width:580px}
    /* hero */
    .hero{position:relative;padding:56px 0 76px;background:radial-gradient(900px 500px at 85% 10%,#d6efea 0,transparent 60%),linear-gradient(#fff,var(--bg))}
    .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
    .hero h1{font-size:clamp(2.5rem,5.2vw,4.1rem);letter-spacing:-.035em;line-height:1.04;margin:16px 0 20px}
    .hero h1 span{color:var(--teal)}
    .hero .lead{font-size:1.15rem;color:var(--ink2);max-width:540px;margin:0 0 26px}
    .search{display:flex;gap:8px;background:#fff;border:1.5px solid var(--line);border-radius:16px;padding:8px;max-width:560px;box-shadow:0 18px 40px -30px rgba(11,37,69,.45)}
    .search i{align-self:center;color:var(--muted);margin-left:10px;font-size:1.1rem}
    .search input{flex:1;border:0;outline:0;font:500 1rem var(--sans);padding:.6rem .4rem;min-width:0;background:transparent}
    .quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px;align-items:center}
    .quick a{padding:.38rem .8rem;border-radius:999px;background:#fff;border:1px solid var(--line);font-weight:600;font-size:.86rem}.quick a:hover{border-color:var(--teal);color:var(--teal)}
    .trust{display:flex;gap:18px;margin-top:30px;flex-wrap:wrap}
    .trust div{display:flex;gap:9px;align-items:center;font-size:.86rem;color:var(--ink2);font-weight:600}
    .trust i{width:38px;height:38px;border-radius:12px;background:var(--mint);color:var(--teal);display:grid;place-items:center;font-size:1.1rem}
    .visual{position:relative;height:500px}
    .visual .panel{position:absolute;inset:20px 0 30px 40px;border-radius:32px;background:linear-gradient(150deg,var(--teal),#0a5f73 60%,var(--navy));overflow:hidden}
    .visual .panel::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,.25),transparent 45%)}
    .visual .prod{position:absolute;left:90px;right:30px;top:70px;border-radius:24px;overflow:hidden;box-shadow:0 40px 60px -30px rgba(0,0,0,.55);border:8px solid #fff;z-index:2}
    .visual .fc{position:absolute;z-index:3;background:#fff;border-radius:16px;padding:14px 16px;box-shadow:0 24px 50px -24px rgba(11,37,69,.55);display:flex;gap:12px;align-items:center;font-size:.86rem;max-width:260px;animation:bob 7s ease-in-out infinite}
    .visual .fc b{display:block;font-size:.95rem}.visual .fc span{color:var(--muted)}
    .visual .fc i{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--mint);color:var(--teal);font-size:1.15rem;flex:none}
    .visual .f1{left:0;top:0}.visual .f2{right:-10px;bottom:0;animation-delay:-2.5s}.visual .f3{left:10px;bottom:70px;animation-delay:-5s}
    @keyframes bob{50%{transform:translateY(-8px)}}
    @media(max-width:980px){.hero-grid{grid-template-columns:1fr}.visual{height:440px;max-width:600px;width:100%;margin:0 auto}}
    @media(max-width:600px){.hero{padding:30px 0 56px}.visual{height:360px}.visual .panel{inset:16px 0 26px 16px}.visual .prod{left:36px;right:14px;top:56px}.visual .f3{display:none}.visual .fc{max-width:220px;font-size:.8rem}.trust{gap:16px}}
    /* grids */
    .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
    @media(max-width:980px){.grid3,.grid4{grid-template-columns:1fr 1fr}}@media(max-width:640px){.grid3,.grid4,.grid2{grid-template-columns:1fr}}
    /* category tiles */
    .cat{display:flex;flex-direction:column;gap:10px;padding:24px;position:relative;overflow:hidden}
    .cat .ic{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;font-size:1.45rem;color:#fff;background:var(--c)}
    .cat h3{font-size:1.2rem}.cat p{margin:0;color:var(--muted);font-size:.93rem;line-height:1.55}
    .cat .n{margin-top:auto;padding-top:8px;font-weight:700;font-size:.88rem;color:var(--c);display:flex;justify-content:space-between;align-items:center}
    /* product cards */
    .prod-card{display:flex;flex-direction:column;overflow:hidden}
    .prod-card .im{aspect-ratio:4/3;overflow:hidden;background:var(--mint);position:relative}
    .prod-card .im img{width:100%;height:100%;object-fit:cover;transition:transform .5s var(--ease)}.prod-card:hover .im img{transform:scale(1.04)}
    .prod-card .im .pill{position:absolute;left:12px;top:12px;background:rgba(255,255,255,.95)}
    .prod-card .bd{padding:18px 20px 20px;display:flex;flex-direction:column;gap:8px;flex:1}
    .prod-card h3{font-size:1.12rem;line-height:1.25}
    .prod-card p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.5}
    .prod-card .ft{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:12px}
    /* steps */
    .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;counter-reset:s}
    .step{padding:26px;position:relative}
    .step::before{counter-increment:s;content:counter(s);width:40px;height:40px;border-radius:12px;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;margin-bottom:16px}
    .step h3{font-size:1.1rem;margin-bottom:8px}.step p{margin:0;color:var(--muted);font-size:.93rem}
    @media(max-width:980px){.steps{grid-template-columns:1fr 1fr}}@media(max-width:560px){.steps{grid-template-columns:1fr}}
    /* insurance band */
    .ins{background:var(--navy);color:#dbe6f0;border-radius:28px;padding:44px;display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:center;position:relative;overflow:hidden}
    .ins::after{content:"";position:absolute;right:-120px;top:-120px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(15,139,141,.5),transparent 70%)}
    .ins h2{color:#fff;font-size:clamp(1.7rem,3vw,2.3rem)}.ins p{color:#b9c8d8}
    .ins .plans{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:relative;z-index:1}
    .ins .plans div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:14px 16px;font-weight:700;color:#fff;display:flex;gap:10px;align-items:center}
    .ins .plans i{color:#7fd1cf}
    @media(max-width:900px){.ins{grid-template-columns:1fr;padding:30px}}@media(max-width:480px){.ins .plans{grid-template-columns:1fr}}
    /* page header + crumbs */
    .phead{padding:48px 0 40px;background:linear-gradient(#fff,var(--bg));border-bottom:1px solid var(--line)}
    .phead h1{font-size:clamp(2.1rem,4.4vw,3.3rem);letter-spacing:-.03em;margin:12px 0 12px;max-width:820px}
    .phead p{font-size:1.1rem;color:var(--ink2);max-width:680px;margin:0}
    .crumbs{display:flex;gap:8px;flex-wrap:wrap;font-size:.86rem;color:var(--muted);font-weight:600}.crumbs a:hover{color:var(--teal)}
    /* filters */
    .filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:24px}
    .filters a{padding:.45rem .9rem;border-radius:10px;border:1px solid var(--line);background:#fff;font-weight:600;font-size:.9rem}
    .filters a.on{background:var(--navy);color:#fff;border-color:var(--navy)}.filters a:not(.on):hover{border-color:var(--teal)}
    .filters form{margin-left:auto;display:flex;gap:6px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:4px 4px 4px 12px}
    .filters input{border:0;outline:0;font:inherit;font-size:.92rem;width:190px;background:transparent}
    .filters form button{border:0;background:var(--teal);color:#fff;border-radius:8px;padding:.35rem .7rem;cursor:pointer}
    @media(max-width:700px){.filters form{margin-left:0;width:100%}.filters input{flex:1}}
    .side-layout{display:grid;grid-template-columns:260px 1fr;gap:32px;align-items:start}
    .side{position:sticky;top:100px;padding:20px}
    .side h4{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:4px 0 10px}
    .side a{display:flex;justify-content:space-between;padding:.45rem .6rem;border-radius:9px;font-weight:600;font-size:.92rem;color:var(--ink2)}
    .side a:hover{background:var(--bg)}.side a.on{background:var(--mint);color:var(--tealD)}
    .side hr{border:0;border-top:1px solid var(--line);margin:14px 0}
    @media(max-width:900px){.side-layout{grid-template-columns:1fr}.side{position:static}}
    /* product page */
    .pd{display:grid;grid-template-columns:1.05fr 1fr;gap:48px;align-items:start}
    .pd .gal{border-radius:24px;overflow:hidden;border:1px solid var(--line);background:var(--mint)}
    .pd h1{font-size:clamp(2rem,3.8vw,2.9rem);letter-spacing:-.03em;margin:12px 0 12px}
    .pd .sum{font-size:1.12rem;color:var(--ink2);margin:0 0 18px}
    .facts{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}
    .facts div{padding:14px 16px;border-radius:14px;background:#fff;border:1px solid var(--line)}
    .facts span{display:block;font-size:.76rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.facts b{font-size:.98rem}
    .order{padding:22px;border-radius:20px;background:var(--navy);color:#dbe6f0;margin-top:18px}
    .order h3{color:#fff;font-size:1.15rem;margin-bottom:6px}.order p{margin:0 0 14px;font-size:.92rem;color:#b9c8d8}
    .order .row{display:flex;gap:10px;flex-wrap:wrap}
    .tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin:56px 0 28px;overflow-x:auto}
    .tabs a{padding:.8rem 1rem;font-weight:700;color:var(--muted);border-bottom:3px solid transparent;white-space:nowrap}.tabs a:hover{color:var(--navy)}.tabs a.on{color:var(--navy);border-color:var(--teal)}
    .spec{width:100%;border-collapse:collapse;background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}
    .spec td{padding:13px 18px;border-bottom:1px solid var(--line);font-size:.95rem}.spec tr:last-child td{border:0}.spec td:first-child{color:var(--muted);font-weight:600;width:42%}
    .checks{display:grid;gap:10px}.checks div{display:flex;gap:10px;align-items:flex-start}.checks i{color:var(--teal);font-size:1.15rem}
    @media(max-width:900px){.pd{grid-template-columns:1fr;gap:28px}}
    /* prose */
    .prose{font-size:1.06rem;color:var(--ink2);max-width:740px}
    .prose h2{font-size:1.5rem;margin:34px 0 10px;color:var(--ink)}.prose p{margin:0 0 16px}
    .prose ul{padding-left:0;list-style:none;margin:0 0 18px}.prose li{position:relative;padding-left:28px;margin:8px 0}
    .prose li::before{content:"";position:absolute;left:4px;top:.55em;width:11px;height:11px;border-radius:50%;border:3px solid var(--teal)}
    .prose strong{color:var(--ink)}
    .prose .note{margin-top:30px;padding:16px 18px;border-radius:14px;background:var(--sky);font-size:.92rem;color:var(--navy2)}
    /* faq */
    details.q{padding:0;margin-bottom:10px;overflow:hidden}
    details.q summary{list-style:none;cursor:pointer;padding:18px 22px;font-weight:700;font-size:1.04rem;display:flex;justify-content:space-between;gap:14px;align-items:center}
    details.q summary::-webkit-details-marker{display:none}
    details.q summary i{transition:transform .25s;color:var(--teal)}details.q[open] summary i{transform:rotate(45deg)}
    details.q p{margin:0;padding:0 22px 20px;color:var(--ink2)}
    /* locations */
    .map{position:relative;border-radius:24px;overflow:hidden;background:#e4efee;border:1px solid var(--line);aspect-ratio:16/9}
    .map svg{position:absolute;inset:0;width:100%;height:100%}
    .pin{position:absolute;transform:translate(-50%,-100%);display:flex;flex-direction:column;align-items:center;gap:4px;z-index:2}
    .pin b{background:#fff;padding:6px 10px;border-radius:10px;font-size:.8rem;box-shadow:0 10px 24px -14px rgba(11,37,69,.6);white-space:nowrap}
    .pin i{font-size:2rem;color:var(--teal);line-height:1;filter:drop-shadow(0 6px 6px rgba(11,37,69,.25))}
    .loc{padding:24px;display:flex;flex-direction:column;gap:12px}
    .loc h3{font-size:1.2rem}.loc .addr{color:var(--ink2)}
    .hours{list-style:none;padding:0;margin:0;font-size:.9rem}.hours li{display:flex;justify-content:space-between;padding:6px 10px;border-radius:8px}.hours li.today{background:var(--mint);color:var(--tealD);font-weight:700}
    @media(max-width:600px){.pin b{display:none}}
    .open-now{font-weight:700;font-size:.84rem;color:var(--tealD)}
    /* contact cards */
    .contact{padding:26px;display:flex;flex-direction:column;gap:10px}
    .contact .ic{width:50px;height:50px;border-radius:14px;display:grid;place-items:center;background:var(--mint);color:var(--teal);font-size:1.3rem}
    .contact h3{font-size:1.1rem}.contact .big{font-size:1.35rem;font-weight:800;color:var(--navy)}.contact p{margin:0;color:var(--muted);font-size:.92rem}
    /* cta band */
    .cta{background:linear-gradient(120deg,var(--teal),#0a6d80);color:#fff;border-radius:28px;padding:44px;display:flex;justify-content:space-between;align-items:center;gap:28px;flex-wrap:wrap}
    .cta h2{font-size:clamp(1.7rem,3.2vw,2.4rem);max-width:620px}.cta p{margin:10px 0 0;color:#d6f1ef;max-width:560px}
    /* resources */
    .res{padding:24px;display:flex;flex-direction:column;gap:10px}
    .res h3{font-size:1.12rem;line-height:1.3}.res p{margin:0;color:var(--muted);font-size:.92rem}
    .res .meta{margin-top:auto;padding-top:10px;display:flex;justify-content:space-between;font-size:.84rem;color:var(--muted);font-weight:600}
    /* footer */
    .foot{background:var(--navy);color:#b9c8d8;padding:64px 0 30px;margin-top:40px}
    .foot .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:36px}
    .foot h4{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin-bottom:14px}
    .foot ul{list-style:none;margin:0;padding:0}.foot li{margin:8px 0;font-size:.94rem}.foot a:hover{color:#fff}
    .foot .brand{color:#fff}.foot .brand small{color:#8ea3b8}
    .foot .phone{font-size:1.5rem;font-weight:800;color:#fff;display:block;margin:6px 0}
    .foot .bottom{display:flex;justify-content:space-between;gap:16px;font-size:.84rem;flex-wrap:wrap;border-top:1px solid #1f3b5f;padding-top:22px;margin-top:44px}
    @media(max-width:860px){.foot .cols{grid-template-columns:1fr 1fr}.foot .cols>div:first-child{grid-column:1/-1}}
    .reveal{opacity:0;transform:translateY(18px);transition:opacity .7s var(--ease),transform .7s var(--ease)}.reveal.in{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}.visual .fc{animation:none}}
  </style>
</head>
<body>
<div class="util"><div class="wrap">
  <span><i class="bi bi-telephone"></i>Order desk <a href="tel:+18005550134">(800) 555-0134</a></span>
  <span class="hide"><i class="bi bi-clock"></i>Mon to Fri 8 to 6, Sat 9 to 1</span>
  <span class="hide"><i class="bi bi-lungs"></i>24-hour respiratory line <a href="tel:+18005550199">(800) 555-0199</a></span>
  <span class="r"><span><i class="bi bi-patch-check"></i>Medicare-enrolled supplier</span></span>
</div></div>
<header class="nav" id="nav">
