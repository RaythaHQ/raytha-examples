<script>
(function(){
  var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.06}):null;
  document.querySelectorAll('.reveal').forEach(function(el){io?io.observe(el):el.classList.add('in')});
  // Highlight today's opening hours: each line starts with the day name.
  var day=new Date().toLocaleDateString('en-US',{weekday:'long'});
  document.querySelectorAll('.hours li').forEach(function(li){if(li.getAttribute('data-day')===day){li.classList.add('today');var o=li.closest('[data-loc]');if(o){var n=o.querySelector('.open-now');if(n)n.textContent='Today: '+li.querySelector('span:last-child').textContent}}});
  // FAQ quick filter
  var fq=document.getElementById('faqfilter');if(fq)fq.addEventListener('input',function(){var v=fq.value.toLowerCase();document.querySelectorAll('details.q').forEach(function(d){d.style.display=d.textContent.toLowerCase().indexOf(v)>-1?'':'none'});document.querySelectorAll('[data-topic]').forEach(function(s){s.style.display=s.querySelector('details.q:not([style*="none"])')?'':'none'})});
})();
</script>
