{%- assign r = Target.PublishedContent -%}
{%- capture k %}{{ r.kind }}{% endcapture -%}
{%- assign more = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=10) -%}
<section class="phead"><div class="wrap"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/resources">Patient resources</a><span>/</span><span>{{ k | replace: "getting_started", "Getting started" | replace: "insurance", "Insurance and billing" | replace: "care", "Use and care" }}</span></div><h1>{{ Target.PrimaryField }}</h1><p>{{ r.summary }}</p>
  <div style="display:flex;gap:16px;margin-top:18px;color:var(--muted);font-weight:600;font-size:.9rem;flex-wrap:wrap"><span><i class="bi bi-clock"></i> {{ r.minutes | append: "" }} min read</span><span><i class="bi bi-person-check"></i> Reviewed by our clinical team</span></div></div></section>
<section class="section" style="padding-top:48px"><div class="wrap" style="display:grid;grid-template-columns:1fr 340px;gap:56px;align-items:start" id="rgrid">
  <article class="prose">{{ r.body }}</article>
  <aside style="position:sticky;top:100px;display:grid;gap:16px">
    {% if r.category %}<a class="card lift" href="{{ PathBase }}/{{ r.category.RoutePath }}" style="padding:22px;display:flex;gap:14px;align-items:center"><span style="width:48px;height:48px;border-radius:14px;background:{{ r.category.PublishedContent.color }};color:#fff;display:grid;place-items:center;font-size:1.3rem;flex:none"><i class="bi bi-{{ r.category.PublishedContent.icon }}"></i></span><span><span class="muted" style="font-size:.8rem;font-weight:700">Related equipment</span><b style="display:block">{{ r.category.PrimaryField }}</b></span></a>{% endif %}
    <div class="order" style="margin:0"><h3>Questions about your situation?</h3><p>Our order desk can check your coverage and explain your options.</p><a class="btn btn-teal" href="tel:+18005550134"><i class="bi bi-telephone-fill"></i> (800) 555-0134</a></div>
    <div class="card" style="padding:22px"><h3 style="font-size:1.05rem;margin-bottom:6px">More guides</h3>{% assign shown = 0 %}{% for m in more.Items %}{% if m.Id != Target.Id and shown < 4 %}{% assign shown = shown | plus: 1 %}<a href="{{ PathBase }}/{{ m.RoutePath }}" style="display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line);font-weight:600;font-size:.94rem">{{ m.PrimaryField }}<i class="bi bi-arrow-right" style="color:var(--teal)"></i></a>{% endif %}{% endfor %}</div>
  </aside>
</div><style>@media(max-width:900px){#rgrid{grid-template-columns:1fr!important}#rgrid aside{position:static!important}}</style></section>
