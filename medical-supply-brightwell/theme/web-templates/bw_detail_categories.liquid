{%- assign c = Target.PublishedContent -%}
{%- capture f %}category eq '{{ Target.Id | append: "" }}'{% endcapture -%}
{%- assign ps = get_content_items(ContentType="products", Filter=f, OrderBy="sort_order asc", PageSize=40) -%}
{%- assign rs = get_content_items(ContentType="resources", Filter=f, OrderBy="sort_order asc", PageSize=6) -%}
{%- assign slug = Target.RoutePath | remove: "equipment/" -%}
<section class="phead" style="--c:{{ c.color }}"><div class="wrap" style="display:flex;gap:28px;align-items:center;flex-wrap:wrap">
  <span style="width:84px;height:84px;border-radius:24px;background:{{ c.color }};color:#fff;display:grid;place-items:center;font-size:2.3rem;flex:none"><i class="bi bi-{{ c.icon }}"></i></span>
  <div style="flex:1;min-width:280px"><div class="crumbs"><a href="{{ PathBase }}/">Home</a><span>/</span><a href="{{ PathBase }}/equipment">Equipment</a><span>/</span><span>{{ Target.PrimaryField }}</span></div><h1>{{ Target.PrimaryField }}</h1><p>{{ c.description }}</p></div>
</div></section>
<section class="section" style="padding-top:44px"><div class="wrap">
  <div class="filters"><span class="muted" style="font-weight:600">{{ ps.TotalCount }} product{% if ps.TotalCount != 1 %}s{% endif %}</span><a href="{{ PathBase }}/products?category={{ slug }}&acquire=rent" style="margin-left:auto">Rentals only</a><a href="{{ PathBase }}/products?category={{ slug }}&coverage=medicare">Medicare covered</a></div>
  <div class="grid3">{% for x in ps.Items %}
{%- capture acq %}{{ x.PublishedContent.acquire }}{% endcapture -%}{%- capture cov %}{{ x.PublishedContent.coverage }}{% endcapture -%}
<a class="card prod-card lift reveal" href="{{ PathBase }}/{{ x.RoutePath }}">
  <div class="im"><img src="{{ x.PublishedContent.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><span class="pill code">HCPCS {{ x.PublishedContent.hcpcs }}</span></div>
  <div class="bd"><span class="muted" style="font-size:.8rem;font-weight:700">{{ x.PublishedContent.category.PrimaryField }}</span><h3>{{ x.PrimaryField }}</h3><p>{{ x.PublishedContent.summary | truncate: 110 }}</p>
  <div class="ft">{% if acq == "rent" %}<span class="pill">Rental</span>{% elsif acq == "buy" %}<span class="pill">Purchase</span>{% else %}<span class="pill">Rent or buy</span>{% endif %}{% if cov == "medicare" %}<span class="pill teal"><i class="bi bi-shield-check"></i> Medicare</span>{% elsif cov == "insurance" %}<span class="pill teal"><i class="bi bi-shield-check"></i> Insurance</span>{% else %}<span class="pill amber">HSA and FSA</span>{% endif %}</div></div>
</a>
{% endfor %}</div>
  {% if rs.TotalCount > 0 %}
  <div class="shead" style="margin-top:64px"><div><span class="eyebrow">Patient resources</span><h2>Guides for {{ Target.PrimaryField | downcase }}</h2></div></div>
  <div class="grid3">{% for r in rs.Items %}<a class="card res lift reveal" href="{{ PathBase }}/{{ r.RoutePath }}"><h3>{{ r.PrimaryField }}</h3><p>{{ r.PublishedContent.summary }}</p><div class="meta"><span><i class="bi bi-clock"></i> {{ r.PublishedContent.minutes | append: "" }} min read</span><i class="bi bi-arrow-right"></i></div></a>{% endfor %}</div>
  {% endif %}
</div></section>
