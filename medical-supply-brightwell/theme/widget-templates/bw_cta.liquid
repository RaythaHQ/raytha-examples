<section class="section tight">
  <div class="wrap"><div class="cta reveal"><div><h2>{{ widget.settings.headline }}</h2><p>{{ widget.settings.body }}</p></div><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-white" href="{{ widget.settings.primary_url }}"><i class="bi bi-telephone-fill"></i> {{ widget.settings.primary_label }}</a>{% if widget.settings.secondary_label != blank %}<a class="btn btn-ghost" href="{{ widget.settings.secondary_url }}">{{ widget.settings.secondary_label }}</a>{% endif %}</div></div></div>
</section>
