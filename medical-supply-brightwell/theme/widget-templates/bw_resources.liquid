{%- assign n = widget.settings.count | default: 3 -%}
{%- assign rs = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=n) -%}
<section class="section white">
  <div class="wrap">
    <div class="shead"><div><span class="eyebrow">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2></div><a class="btn btn-line" href="{{ PathBase }}/resources">All guides <i class="bi bi-arrow-right"></i></a></div>
    <div class="grid3">{% for r in rs.Items %}{% capture k %}{{ r.PublishedContent.kind }}{% endcapture %}<a class="card res lift reveal" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="pill {% if k == 'insurance' %}amber{% elsif k == 'care' %}teal{% endif %}" style="align-self:flex-start">{{ k | replace: "getting_started", "Getting started" | replace: "insurance", "Insurance and billing" | replace: "care", "Use and care" }}</span><h3>{{ r.PrimaryField }}</h3><p>{{ r.PublishedContent.summary }}</p><div class="meta"><span><i class="bi bi-clock"></i> {{ r.PublishedContent.minutes | append: "" }} min read</span><i class="bi bi-arrow-right"></i></div></a>{% endfor %}</div>
  </div>
</section>
