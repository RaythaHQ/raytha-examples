{%- assign fs = QueryParams.shelf | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>New arrivals</li></ol><p class="kick">New arrivals · week of November 2</p><h1>Just arrived on the shelf</h1><p class="lede">Books, audiobooks, films, records, and things to borrow, added this week. Place holds at any desk or by phone; holds go to any branch or Bookmobile stop.</p><div class="filters"><a href="{{ PathBase }}/new" class="{% if fs == "" %}on{% endif %}">Everything</a><a href="{{ PathBase }}/new?shelf=fiction" class="{% if fs == "fiction" %}on{% endif %}">Fiction</a><a href="{{ PathBase }}/new?shelf=mystery" class="{% if fs == "mystery" %}on{% endif %}">Mystery</a><a href="{{ PathBase }}/new?shelf=nonfiction" class="{% if fs == "nonfiction" %}on{% endif %}">Nonfiction</a><a href="{{ PathBase }}/new?shelf=local" class="{% if fs == "local" %}on{% endif %}">Local history</a><a href="{{ PathBase }}/new?shelf=kids" class="{% if fs == "kids" %}on{% endif %}">Kids</a><a href="{{ PathBase }}/new?shelf=teen" class="{% if fs == "teen" %}on{% endif %}">Teen</a><a href="{{ PathBase }}/new?shelf=things" class="{% if fs == "things" %}on{% endif %}">Library of Things</a></div></div></div>
<section class="stacks" style="padding-top:46px"><div class="w"><div class="shelf">{% for p in Target.Items %}{%- capture ps -%}{{ p.PublishedContent.shelf }}{%- endcapture -%}{% if fs == "" or fs == ps %}{%- assign y=p.PublishedContent -%}{%- capture sc -%}{{ y.spine }}{%- endcapture -%}{%- capture shs -%}{{ y.spine_h }}{%- endcapture -%}{%- assign sh = shs | plus: 0 -%}{%- assign tl = p.PrimaryField | size -%}{%- assign sw = tl | times: 0.7 | plus: 44 | round -%}{% if sw > 72 %}{%- assign sw = 72 -%}{% endif %}<a class="spine{% if "#c9a24a,#d9b44a,#9aa3ad,#e07b39,#f2d3a6" contains sc %} lt{% endif %}" href="{{ PathBase }}/{{ p.RoutePath }}" style="background:{{ sc }};height:{{ sh }}%;width:{{ sw }}px" title="{{ p.PrimaryField }}, {{ y.author }}"><span class="t">{{ p.PrimaryField | split: " (" | first }}</span><span class="a">{{ y.author | split: "," | first | split: " " | last }}</span><span class="cn">{{ y.call_number | split: " " | first }}</span></a>{% endif %}{% endfor %}</div><div style="height:46px"></div></div></section>
<section class="sec tight"><div class="w"><div class="covers">{% for p in Target.Items %}{%- capture ps -%}{{ p.PublishedContent.shelf }}{%- endcapture -%}{% if fs == "" or fs == ps %}{%- assign y=p.PublishedContent -%}<a class="cov" href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ y.cover.Value | attachment_redirect_url }}" alt="Generated cover for {{ p.PrimaryField }}" loading="lazy"><b>{{ p.PrimaryField }}</b><small>{{ y.author }} · {% capture lv35 -%}{{ y.format }}{%- endcapture %}{% case lv35 %}{% when "book" %}Book{% when "large" %}Large print{% when "audio" %}Audiobook{% when "ebook" %}E-book{% when "dvd" %}DVD{% when "vinyl" %}Vinyl{% when "thing" %}Library of Things{% else %}{{ lv35 }}{% endcase %}</small></a>{% endif %}{% endfor %}</div></div></section>
