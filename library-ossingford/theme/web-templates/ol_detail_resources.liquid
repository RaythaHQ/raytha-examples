{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "cardholders" and in_card == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "staff" and in_staff == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/resources">Digital resources</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv44 -%}{{ x.kind }}{%- endcapture %}{% case lv44 %}{% when "ebooks" %}E-books and audiobooks{% when "research" %}Research{% when "learning" %}Learning{% when "streaming" %}Streaming{% when "archive" %}Local archive{% when "staff" %}Staff tools{% else %}{{ lv44 }}{% endcase %} · {{ x.provider }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:18px 0 0">{% if au == "cardholders" %}<span class="chip lock">🔒 Library card needed</span>{% elsif au == "staff" %}<span class="chip on">Staff only</span>{% else %}<span class="chip">Free for everyone, no card needed</span>{% endif %}<span class="chip">{{ x.access_note }}</span></p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div>{% if ok %}<div class="prose"><h2>How to get in</h2>{{ x.body }}</div>{% else %}{% if au == "staff" %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Signed-in library staff see this page.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you get a card.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/get-a-card">How to get a card</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Cardholders</p><h2>Sign in with your library account to see how to get in.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you get a card.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/get-a-card">How to get a card</a></p></div>{% endif %}{% endif %}</div>
<aside class="ccard" style="background-position:0 58px,0 70px"><div class="hd"><b>{{ x.letter }} · RESOURCE</b><span>OPL</span></div><p style="margin:0;line-height:30px">Provider: {{ x.provider }}<br>Works: {{ x.access_note }}<br>Kind: {% capture lv45 -%}{{ x.kind }}{%- endcapture %}{% case lv45 %}{% when "ebooks" %}E-books and audiobooks{% when "research" %}Research{% when "learning" %}Learning{% when "streaming" %}Streaming{% when "archive" %}Local archive{% when "staff" %}Staff tools{% else %}{{ lv45 }}{% endcase %}<br>Audience: {% capture lv46 -%}{{ x.audience }}{%- endcapture %}{% case lv46 %}{% when "public" %}Everyone{% when "cardholders" %}Cardholders{% when "staff" %}Staff{% else %}{{ lv46 }}{% endcase %}</p></aside></div></div></section>
