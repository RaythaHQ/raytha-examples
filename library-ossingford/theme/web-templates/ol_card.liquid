{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign today = "now" | date: "%a" | downcase -%}{%- assign todayname = "now" | date: "%A" -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>My library</li></ol><p class="kick">My library · cardholders</p><h1>{% if in_card %}Hello, {{ CurrentUser.FirstName }}.{% else %}My library{% endif %}</h1><p class="lede">{% if in_card %}Your card, the access details for e-books and databases, museum passes and notices for cardholders.{% else %}E-book and database access, museum passes and cardholder notices, for signed-in cardholders.{% endif %}</p></div></div>
