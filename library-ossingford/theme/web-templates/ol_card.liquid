"0" width="1" height="38" fill="#1d2433"/><rect x="106" y="0" width="2" height="38" fill="#1d2433"/><rect x="110" y="0" width="4" height="38" fill="#1d2433"/><rect x="116" y="0" width="1" height="38" fill="#1d2433"/><rect x="119" y="0" width="3" height="38" fill="#1d2433"/><rect x="124" y="0" width="2" height="38" fill="#1d2433"/><rect x="128" y="0" width="1" height="38" fill="#1d2433"/><rect x="131" y="0" width="4" height="38" fill="#1d2433"/><rect x="137" y="0" width="1" height="38" fill="#1d2433"/><rect x="140" y="0" width="2" height="38" fill="#1d2433"/><rect x="144" y="0" width="3" height="38" fill="#1d2433"/><rect x="149" y="0" width="1" height="38" fill="#1d2433"/><rect x="152" y="0" width="2" height="38" fill="#1d2433"/><rect x="156" y="0" width="4" height="38" fill="#1d2433"/><rect x="162" y="0" width="1" height="38" fill="#1d2433"/><rect x="165" y="0" width="3" height="38" fill="#1d2433"/><rect x="170" y="0" width="1" height="38" fill="#1d2433"/><rect x="173" y="0" width="2" height="38" fill="#1d2433"/><rect x="177" y="0" width="4" height="38" fill="#1d2433"/><rect x="183" y="0" width="1" height="38" fill="#1d2433"/><rect x="186" y="0" width="2" height="38" fill="#1d2433"/><rect x="190" y="0" width="3" height="38" fill="#1d2433"/><rect x="195" y="0" width="1" height="38" fill="#1d2433"/><rect x="198" y="0" width="3" height="38" fill="#1d2433"/></svg><span><b>2 1187 00{{ CurrentUser.EmailAddress | size | plus: 4100 }} 7</b><b>{% if in_staff %}STAFF{% else %}ADULT{% endif %}</b></span></div></div><p class="muted" style="margin-top:16px;font-size:.92rem">Show this at any desk or on the Bookmobile. The card number and barcode are fictional.</p></div>
<div><h2 style="margin-bottom:16px">Your digital library</h2><div class="res2" style="grid-template-columns:1fr 1fr">{% for r in rss.Items %}{%- assign x=r.PublishedContent -%}<a href="{{ PathBase }}/{{ r.RoutePath }}"><span class="chip">{% capture lv49 -%}{{ x.kind }}{%- endcapture %}{% case lv49 %}{% when "ebooks" %}E-books and audiobooks{% when "research" %}Research{% when "learning" %}Learning{% when "streaming" %}Streaming{% when "archive" %}Local archive{% when "staff" %}Staff tools{% else %}{{ lv49 }}{% endcase %}</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.access_note }} · open the page for sign-in details</span></a>{% endfor %}</div></div></div></div></section>
{{ render_section("main", wrap=false) }}{% else %}<section class="sec tight"><div class="w"><div class="lockp"><p class="kick">🔒 Cardholders</p><h2>Sign in to see your library card and access details.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you get a card.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/my-library">Sign in</a><a class="btn line" href="{{ PathBase }}/get-a-card">How to get a card</a></p></div></div></section>{% endif %}
