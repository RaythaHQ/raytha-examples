{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li>{{ x.date_label }}</li></ol><p class="kick">{{ x.date_label }} · {% capture lv48 -%}{{ x.kind }}{%- endcapture %}{% case lv48 %}{% when "branches" %}Branches{% when "collections" %}Collections{% when "programs" %}Programs{% when "board" %}Library board{% when "community" %}Community{% else %}{{ lv48 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight"><div class="w"><div class="dg"><div class="prose"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="margin-bottom:24px;border:1px solid var(--rule)">{{ x.body }}</div><aside class="ccard" style="background-position:0 58px,0 70px"><div class="hd"><b>ASK A LIBRARIAN</b><span>OPL</span></div><p style="margin:0;line-height:30px">(555) 014-2200<br>Mon–Thu 9 am – 8 pm<br>Fri 9 – 6 · Sat 10 – 5 · Sun 1 – 5</p></aside></div></div></section>
