{%- assign today = "now" | date: "%a" | downcase -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign x=Target.PublishedContent -%}{%- capture bc -%}{{ x.branch }}{%- endcapture -%}{%- capture wd -%}{{ x.weekday }}{%- endcapture -%}{%- capture pa -%}{{ x.audience }}{%- endcapture -%}{%- capture f -%}code eq '{{ bc }}'{%- endcapture -%}{%- assign bq = get_content_items(ContentType="branches", Filter=f, PageSize=1) -%}{%- assign b = bq.Items | first -%}{%- capture f2 -%}weekday eq '{{ wd }}'{%- endcapture -%}{%- assign same = get_content_items(ContentType="programs", Filter=f2, OrderBy="sort_order asc", PageSize=10) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/programs">Programs</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv27 -%}{{ x.kind }}{%- endcapture %}{% case lv27 %}{% when "storytime" %}Storytime{% when "bookclub" %}Book club{% when "class" %}Class{% when "maker" %}Makerspace{% when "help" %}Help desk{% when "talk" %}Talk{% when "film" %}Film{% when "social" %}Meetup{% else %}{{ lv27 }}{% endcase %} · {% capture lv28 -%}{{ x.audience }}{%- endcapture %}{% case lv28 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv28 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><span class="bigstamp">Every {% capture lv29 -%}{{ x.weekday }}{%- endcapture %}{% case lv29 %}{% when "mon" %}Monday{% when "tue" %}Tuesday{% when "wed" %}Wednesday{% when "thu" %}Thursday{% when "fri" %}Friday{% when "sat" %}Saturday{% when "sun" %}Sunday{% else %}{{ lv29 }}{% endcase %} · {{ x.time_label }}</span><div class="prose">{{ x.body }}</div><div class="panel" style="margin-top:24px"><dl class="kv"><dt>Where</dt><dd><a href="{{ PathBase }}/{{ b.RoutePath }}">{{ b.PrimaryField }}</a> · {{ x.room }}</dd><dt>Who</dt><dd><span class="chip {{ pa }}">{% capture lv30 -%}{{ x.audience }}{%- endcapture %}{% case lv30 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv30 }}{% endcase %}</span></dd><dt>Seats</dt><dd>{{ x.seats }}</dd><dt>Host</dt><dd>{{ x.host }}</dd><dt>Sign-up</dt><dd>None. Just come.</dd></dl></div></div>
<aside><div class="slip"><div class="sh"><span>ALSO ON {% capture lv31 -%}{{ x.weekday }}{%- endcapture %}{% case lv31 %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% when "sat" %}Sat{% when "sun" %}Sun{% else %}{{ lv31 }}{% endcase %}</span></div><ol>{% for p in same.Items %}{% if p.RoutePath != Target.RoutePath %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{% capture lv32 -%}{{ y.weekday }}{%- endcapture %}{% case lv32 %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% when "sat" %}Sat{% when "sun" %}Sun{% else %}{{ lv32 }}{% endcase %} {{ y.time_label | split: " –" | first }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small><span class="chip {{ pa }}">{% capture lv33 -%}{{ y.audience }}{%- endcapture %}{% case lv33 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv33 }}{% endcase %}</span>{% capture lv34 -%}{{ y.branch }}{%- endcapture %}{% case lv34 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv34 }}{% endcase %} · {{ y.room }}</small></div></li>{% endif %}{% endfor %}</ol></div>{% if b %}<div class="panel" style="margin-top:24px"><p class="kick">{{ b.PrimaryField }} hours</p><table class="htable"><tbody><tr{% if today == "mon" %} class="now"{% endif %}><td>Monday</td><td>{{ b.PublishedContent.mon }}</td></tr><tr{% if today == "tue" %} class="now"{% endif %}><td>Tuesday</td><td>{{ b.PublishedContent.tue }}</td></tr><tr{% if today == "wed" %} class="now"{% endif %}><td>Wednesday</td><td>{{ b.PublishedContent.wed }}</td></tr><tr{% if today == "thu" %} class="now"{% endif %}><td>Thursday</td><td>{{ b.PublishedContent.thu }}</td></tr><tr{% if today == "fri" %} class="now"{% endif %}><td>Friday</td><td>{{ b.PublishedContent.fri }}</td></tr><tr{% if today == "sat" %} class="now"{% endif %}><td>Saturday</td><td>{{ b.PublishedContent.sat }}</td></tr><tr{% if today == "sun" %} class="now"{% endif %}><td>Sunday</td><td>{{ b.PublishedContent.sun }}</td></tr></tbody></table></div>{% endif %}</aside></div></div></section>
