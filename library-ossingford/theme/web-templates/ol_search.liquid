{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the library site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="storytime, telescope, Ledger"><button class="btn">Search</button></form><p class="muted" style="margin-top:12px;font-size:.95rem">Searches programs, new arrivals, reading lists, digital resources, branches and news. The catalog itself lives in the library's catalog system.</p></div></div>
<section class="sec tight"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "programs:Programs:title:summary,titles:New arrivals:title:author,lists:Reading lists:name:summary,resources:Digital resources:name:summary,branches:Branches:name:summary,news:News:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:2px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{% if au != "staff" or in_staff %}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "cardholders" %} <span class="chip lock">🔒 Card needed</span>{% elsif au == "staff" %} <span class="chip on">Staff</span>{% endif %}<p>{% if x.summary %}{{ x.summary | strip_html | truncate: 150 }}{% else %}{{ x.author }}{% endif %}</p></a>{% endif %}{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=storytime">storytime</a>, <a href="?q=telescope">telescope</a>, <a href="?q=Ledger">Ledger</a> or <a href="?q=river">river</a>.</p>{% endif %}</div></div></section>
