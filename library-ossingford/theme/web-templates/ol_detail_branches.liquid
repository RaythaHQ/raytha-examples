{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign today = "now" | date: "%a" | downcase -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign x=Target.PublishedContent -%}{%- capture bc -%}{{ x.code }}{%- endcapture -%}{%- capture bs -%}{{ x.status }}{%- endcapture -%}{%- capture f -%}branch eq '{{ bc }}'{%- endcapture -%}{%- assign bp = get_content_items(ContentType="programs", Filter=f, OrderBy="sort_order asc", PageSize=30) -%}{%- capture f2 -%}contains(branches,'{{ bc }}'){%- endcapture -%}{%- assign bt = get_content_items(ContentType="titles", Filter=f2, OrderBy="sort_order asc", PageSize=6) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/branches">Branches</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{{ x.neighborhood }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p style="margin:18px 0 0"><span class="status {{ bs }}">{% capture lv8 -%}{{ x.status }}{%- endcapture %}{% case lv8 %}{% when "open" %}Open{% when "limited" %}Limited service{% when "closed" %}Temporarily closed{% else %}{{ lv8 }}{% endcase %}</span></p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div>{% if bs == "limited" %}<p class="notice">{{ x.status_note }}</p>{% endif %}<img src="{{ x.art.Value | attachment_redirect_url }}" alt="Generated elevation drawing of {{ Target.PrimaryField }}" style="border:1px solid var(--rule);margin-bottom:26px"><div class="prose">{{ x.body }}</div><h2 style="margin:30px 0 14px;font-size:1.5rem">What is here</h2>{%- assign fs = x.features | split: "|" -%}<ul class="feat">{% for i in fs %}<li>{{ i }}</li>{% endfor %}</ul></div>
<aside><div class="panel"><p class="kick">Hours</p><table class="htable"><tbody><tr{% if today == "mon" %} class="now"{% endif %}><td>Monday</td><td>{{ x.mon }}</td></tr><tr{% if today == "tue" %} class="now"{% endif %}><td>Tuesday</td><td>{{ x.tue }}</td></tr><tr{% if today == "wed" %} class="now"{% endif %}><td>Wednesday</td><td>{{ x.wed }}</td></tr><tr{% if today == "thu" %} class="now"{% endif %}><td>Thursday</td><td>{{ x.thu }}</td></tr><tr{% if today == "fri" %} class="now"{% endif %}><td>Friday</td><td>{{ x.fri }}</td></tr><tr{% if today == "sat" %} class="now"{% endif %}><td>Saturday</td><td>{{ x.sat }}</td></tr><tr{% if today == "sun" %} class="now"{% endif %}><td>Sunday</td><td>{{ x.sun }}</td></tr></tbody></table><p style="margin:16px 0 0">{{ x.address }}<br>{{ x.phone }}</p></div></aside></div></div></section>
<section class="sec tight" style="border-top:1px solid var(--rule)"><div class="w"><div class="ddg"><div><h2 style="margin-bottom:18px">Programs here every week</h2>{% if bp.TotalCount > 0 %}<div class="slip"><div class="sh"><span>DATE DUE</span><span style="font-size:.8rem">{{ Target.PrimaryField | upcase }}</span></div><ol>{% for p in bp.Items %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{% capture lv9 -%}{{ y.weekday }}{%- endcapture %}{% case lv9 %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% when "sat" %}Sat{% when "sun" %}Sun{% else %}{{ lv9 }}{% endcase %} {{ y.time_label | split: " –" | first }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small><span class="chip {{ pa }}">{% capture lv10 -%}{{ y.audience }}{%- endcapture %}{% case lv10 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv10 }}{% endcase %}</span>{% capture lv11 -%}{{ y.branch }}{%- endcapture %}{% case lv11 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv11 }}{% endcase %} · {{ y.room }}</small></div></li>{% endfor %}</ol></div>{% else %}<p class="muted">No weekly programs at this location.</p>{% endif %}</div>
<div><h2 style="margin-bottom:18px">New here</h2><div class="grid3" style="grid-template-columns:repeat(3,1fr)">{% for p in bt.Items %}{%- assign y=p.PublishedContent -%}<a class="cov" href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ y.cover.Value | attachment_redirect_url }}" alt="Generated cover for {{ p.PrimaryField }}" loading="lazy"><b>{{ p.PrimaryField }}</b><small>{{ y.author }} · {% capture lv12 -%}{{ y.format }}{%- endcapture %}{% case lv12 %}{% when "book" %}Book{% when "large" %}Large print{% when "audio" %}Audiobook{% when "ebook" %}E-book{% when "dvd" %}DVD{% when "vinyl" %}Vinyl{% when "thing" %}Library of Things{% else %}{{ lv12 }}{% endcase %}</small></a>{% endfor %}</div></div></div></div></section>
