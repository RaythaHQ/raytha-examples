{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Staff room</li></ol><p class="kick">Staff room · library staff only</p><h1>{% if in_staff %}Staff room{% else %}Staff room{% endif %}</h1><p class="lede">{% if in_staff %}Desk schedule, notices and procedures for Ossingford library staff. Names and schedules are fictional.{% else %}Desk schedules and procedures for signed-in library staff.{% endif %}</p></div></div>
{% if in_staff %}{{ render_section("main", wrap=false) }}{%- assign sr = get_content_items(ContentType="resources", Filter="audience eq 'staff'", OrderBy="sort_order asc", PageSize=20) -%}<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:22px">Procedures and tools</h2><div class="res2">{% for r in sr.Items %}{%- assign x=r.PublishedContent -%}<a href="{{ PathBase }}/{{ r.RoutePath }}"><span class="chip on">Staff</span><b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endfor %}</div></div></section>{% else %}<section class="sec tight"><div class="w">{% if in_card %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>You are signed in as a cardholder.</h2><p class="muted">The staff room is only for library staff accounts. Your card and access details are in <a href="{{ PathBase }}/my-library">My library</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Staff only</p><h2>Library staff sign in to see the staff room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, accounts are created at the desk when you get a card.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Sign in</a><a class="btn line" href="{{ PathBase }}/get-a-card">How to get a card</a></p></div>{% endif %}</div></section>{% endif %}
