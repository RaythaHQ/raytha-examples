{%- assign x=Target.PublishedContent -%}{%- capture ps -%}{{ x.shelf }}{%- endcapture -%}{%- capture hb -%}{{ x.branches }}{%- endcapture -%}{%- capture cps -%}{{ x.copies }}{%- endcapture -%}{%- capture hds -%}{{ x.holds }}{%- endcapture -%}{%- assign cp = cps | plus: 0 -%}{%- assign hd = hds | plus: 0 -%}{%- capture f -%}shelf eq '{{ ps }}'{%- endcapture -%}{%- assign more = get_content_items(ContentType="titles", Filter=f, OrderBy="sort_order asc", PageSize=7) -%}{%- assign brs = get_content_items(ContentType="branches", OrderBy="sort_order asc", PageSize=10) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/new">New arrivals</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">{% capture lv36 -%}{{ x.format }}{%- endcapture %}{% case lv36 %}{% when "book" %}Book{% when "large" %}Large print{% when "audio" %}Audiobook{% when "ebook" %}E-book{% when "dvd" %}DVD{% when "vinyl" %}Vinyl{% when "thing" %}Library of Things{% else %}{{ lv36 }}{% endcase %} · {% capture lv37 -%}{{ x.shelf }}{%- endcapture %}{% case lv37 %}{% when "fiction" %}Fiction{% when "mystery" %}Mystery{% when "nonfiction" %}Nonfiction{% when "local" %}Local history{% when "kids" %}Kids{% when "teen" %}Teen{% when "things" %}Library of Things{% else %}{{ lv37 }}{% endcase %} · arrived {{ x.arrived }}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.author }}</p></div></div>
<section class="sec tight"><div class="w"><div style="display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:48px;align-items:start" class="tgrid"><div><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="Generated cover for {{ Target.PrimaryField }}" style="box-shadow:8px 10px 0 rgba(29,36,51,.15);border:1px solid rgba(0,0,0,.1)"></div>
<div><div class="catcard"><span class="cn">{{ x.call_number | replace: " ", "
" }}</span><div class="body"><b>{{ x.author | split: "," | first }}.</b><br>&nbsp;&nbsp;{{ Target.PrimaryField }} / {{ x.author }}. — Ossingford P.L. copy, {% capture lv38 -%}{{ x.format }}{%- endcapture %}{% case lv38 %}{% when "book" %}Book{% when "large" %}Large print{% when "audio" %}Audiobook{% when "ebook" %}E-book{% when "dvd" %}DVD{% when "vinyl" %}Vinyl{% when "thing" %}Library of Things{% else %}{{ lv38 }}{% endcase %}.<br>&nbsp;&nbsp;{{ x.summary }}<div class="tr">1. {% capture lv39 -%}{{ x.shelf }}{%- endcapture %}{% case lv39 %}{% when "fiction" %}Fiction{% when "mystery" %}Mystery{% when "nonfiction" %}Nonfiction{% when "local" %}Local history{% when "kids" %}Kids{% when "teen" %}Teen{% when "things" %}Library of Things{% else %}{{ lv39 }}{% endcase %}. &nbsp;I. Title. &nbsp;&nbsp;Added {{ x.arrived }}, 2026.</div></div></div>
<h2 style="margin:36px 0 12px;font-size:1.5rem">Where to find it</h2>{% if hb == "" %}<p class="muted">E-book only: borrow it in the Bramblebox app with a library card. <a href="{{ PathBase }}/resources/bramblebox-e-books-and-audiobooks">How to get in</a>.</p>{% else %}<table class="avail"><thead><tr><th>Location</th><th>Shelf</th><th>Status</th></tr></thead><tbody>{% for b in brs.Items %}{%- capture bcd -%}{{ b.PublishedContent.code }}{%- endcapture -%}{%- assign hbs = hb | split: "|" -%}{% if hbs contains bcd %}<tr><td><a href="{{ PathBase }}/{{ b.RoutePath }}">{{ b.PrimaryField }}</a></td><td class="tw">{{ x.call_number }}</td><td>{% if hd >= cp %}<span class="wait">All copies out · holds list</span>{% else %}<span class="ok">On the shelf</span>{% endif %}</td></tr>{% endif %}{% endfor %}</tbody></table>{% endif %}
<p style="margin-top:16px" class="tw">{{ cp }} cop{% if cp == 1 %}y{% else %}ies{% endif %} · {{ hd }} hold{% if hd != 1 %}s{% endif %}{% if hd > 0 and cp > 0 %} · about {{ hd | divided_by: cp | plus: 1 | times: 3 }} weeks to wait{% endif %}</p>
{%- capture _c0 -%}{{ x.pick_note }}{%- endcapture -%}{% if _c0 != "" and x.pick_note %}<div class="sticky" style="max-width:520px;margin-top:26px"><b>Staff pick · {{ x.pick_by }}</b>{{ x.pick_note }}</div>{% endif %}
<p class="muted" style="margin-top:26px;font-size:.95rem">Holds are placed at any desk or by calling (555) 014-2200; there is no hold form on this site.</p></div></div></div></section>
<section class="sec tight" style="border-top:1px solid var(--rule)"><div class="w"><h2 style="margin-bottom:22px">More on this shelf</h2><div class="covers">{% for p in more.Items %}{% if p.RoutePath != Target.RoutePath %}{%- assign y=p.PublishedContent -%}<a class="cov" href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ y.cover.Value | attachment_redirect_url }}" alt="Generated cover for {{ p.PrimaryField }}" loading="lazy"><b>{{ p.PrimaryField }}</b><small>{{ y.author }} · {% capture lv40 -%}{{ y.format }}{%- endcapture %}{% case lv40 %}{% when "book" %}Book{% when "large" %}Large print{% when "audio" %}Audiobook{% when "ebook" %}E-book{% when "dvd" %}DVD{% when "vinyl" %}Vinyl{% when "thing" %}Library of Things{% else %}{{ lv40 }}{% endcase %}</small></a>{% endif %}{% endfor %}</div></div></section>
