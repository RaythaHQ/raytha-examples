{%- assign today = "now" | date: "%a" | downcase -%}{%- assign todayname = "now" | date: "%A" -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Branches</li></ol><p class="kick">Branches and hours</p><h1>Four buildings and a Bookmobile</h1><p class="lede">Today is {{ todayname }}; today's hours are highlighted. Every branch takes returns and holds from every other branch.</p></div></div><section class="sec tight"><div class="w">{% for b in Target.Items %}{%- assign z=b.PublishedContent -%}{%- capture bs -%}{{ z.status }}{%- endcapture -%}<div class="bcard"><a href="{{ PathBase }}/{{ b.RoutePath }}"><img src="{{ z.art.Value | attachment_redirect_url }}" alt="Generated elevation drawing of {{ b.PrimaryField }}" loading="lazy"></a><div><p class="kick" style="margin-bottom:6px">{{ z.neighborhood }}</p><h2><a href="{{ PathBase }}/{{ b.RoutePath }}">{{ b.PrimaryField }}</a></h2><p class="muted" style="margin:8px 0 0">{{ z.address }} · {{ z.phone }}</p>{% if bs == "limited" %}<p class="notice" style="margin:14px 0 0">{{ z.status_note }}</p>{% endif %}<div class="week"><div{% if today == "mon" %} class="now"{% endif %}><b>Mon</b>{%- capture hv -%}{{ z.mon }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "tue" %} class="now"{% endif %}><b>Tue</b>{%- capture hv -%}{{ z.tue }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "wed" %} class="now"{% endif %}><b>Wed</b>{%- capture hv -%}{{ z.wed }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "thu" %} class="now"{% endif %}><b>Thu</b>{%- capture hv -%}{{ z.thu }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "fri" %} class="now"{% endif %}><b>Fri</b>{%- capture hv -%}{{ z.fri }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "sat" %} class="now"{% endif %}><b>Sat</b>{%- capture hv -%}{{ z.sat }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div><div{% if today == "sun" %} class="now"{% endif %}><b>Sun</b>{%- capture hv -%}{{ z.sun }}{%- endcapture -%}<span{% if hv == "Closed" or hv == "No route" %} class="x"{% endif %}>{{ hv }}</span></div></div></div></div>{% endfor %}</div></section>
