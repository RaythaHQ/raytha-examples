{%- assign in_card=false -%}{%- assign in_staff=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "cardholders" -%}{%- assign in_card=true -%}{%- endif -%}{%- if g == "staff" -%}{%- assign in_staff=true -%}{%- assign in_card=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_card=true -%}{%- assign in_staff=true -%}{%- endif -%}{%- assign today = "now" | date: "%a" | downcase -%}{%- assign todayname = "now" | date: "%A" -%}{%- assign brs = get_content_items(ContentType="branches", OrderBy="sort_order asc", PageSize=10) -%}{%- assign progs = get_content_items(ContentType="programs", OrderBy="sort_order asc", PageSize=100) -%}{%- assign tts = get_content_items(ContentType="titles", OrderBy="sort_order asc", PageSize=60) -%}{%- assign lsts = get_content_items(ContentType="lists", OrderBy="sort_order asc", PageSize=3) -%}{%- assign rss = get_content_items(ContentType="resources", OrderBy="sort_order asc", PageSize=60) -%}{%- assign nws = get_content_items(ContentType="news", OrderBy="sort_order asc", PageSize=3) -%}
{%- assign ntoday=0 -%}{% for p in progs.Items %}{%- capture wd -%}{{ p.PublishedContent.weekday }}{%- endcapture -%}{% if wd == today %}{%- assign ntoday = ntoday | plus: 1 -%}{% endif %}{% endfor %}
<section class="hero ruled"><div class="w g"><div><p class="kick">Ossingford County · public library</p><h1>Five branches, a bus, and one free library card.</h1><p class="lede">Borrow books, films, records and telescopes. Bring the kids to storytime, find a great-grandparent in the Ledger, print a boarding pass, or just sit somewhere quiet. Everything here is free with a card, and a card is free.</p>
<div class="today-strip"><span>{{ todayname | upcase }}: {{ ntoday }} PROGRAMS</span><span>{{ tts.TotalCount }} NEW ARRIVALS</span><span>{{ rss.TotalCount }} DIGITAL RESOURCES</span></div>
<p class="cta"><a class="btn" href="{{ PathBase }}/programs">This week's programs</a><a class="btn line" href="{{ PathBase }}/get-a-card">Get a library card</a></p></div>
<div class="stack"><div class="ccard"><div class="hd"><span>OSSINGFORD PUBLIC LIBRARY</span><b>027.4 OSS</b></div>
<p style="margin:0 0 4px;line-height:30px"><b>Open today,</b> {{ "now" | date: "%A, %B" }} {{ "now" | date: "%d" | plus: 0 }}</p>
<table class="hours"><tbody>{% for b in brs.Items %}{%- assign z=b.PublishedContent -%}{%- capture hv -%}{% case today %}{% when "mon" %}{{ z.mon }}{% when "tue" %}{{ z.tue }}{% when "wed" %}{{ z.wed }}{% when "thu" %}{{ z.thu }}{% when "fri" %}{{ z.fri }}{% when "sat" %}{{ z.sat }}{% when "sun" %}{{ z.sun }}{% endcase %}{%- endcapture -%}{%- capture bs -%}{{ z.status }}{%- endcapture -%}<tr><td><a href="{{ PathBase }}/{{ b.RoutePath }}">{{ b.PrimaryField }}</a>{% if bs == "limited" %}<span class="lim">LIMITED</span>{% endif %}</td><td{% if hv == "Closed" or hv == "No route" %} class="closed"{% endif %}>{{ hv | split: " · " | first | truncate: 26 }}</td></tr>{% endfor %}</tbody></table>
<p style="margin:6px 0 0;line-height:30px;font-size:.92rem">Holds locker, North Quarry: 7 am – 10 pm daily.</p></div></div></div></section>
<section class="stacks"><div class="w"><div class="shead"><div><p class="kick">New on the shelf · this week</p><h2>Just arrived</h2><p>Every new book, audiobook, film, record and borrowable thing, shelved by color. Pick a spine to see where it is and how many holds are ahead of you.</p></div><a class="btn sm line" style="color:#fff;box-shadow:inset 0 0 0 2px #fff" href="{{ PathBase }}/new">All new arrivals →</a></div>
<div class="shelf">{% for p in tts.Items %}{%- assign y=p.PublishedContent -%}{%- capture sc -%}{{ y.spine }}{%- endcapture -%}{%- capture shs -%}{{ y.spine_h }}{%- endcapture -%}{%- assign sh = shs | plus: 0 -%}{%- assign tl = p.PrimaryField | size -%}{%- assign sw = tl | times: 0.7 | plus: 44 | round -%}{% if sw > 72 %}{%- assign sw = 72 -%}{% endif %}<a class="spine{% if "#c9a24a,#d9b44a,#9aa3ad,#e07b39,#f2d3a6" contains sc %} lt{% endif %}" href="{{ PathBase }}/{{ p.RoutePath }}" style="background:{{ sc }};height:{{ sh }}%;width:{{ sw }}px" title="{{ p.PrimaryField }}, {{ y.author }}"><span class="t">{{ p.PrimaryField | split: " (" | first }}</span><span class="a">{{ y.author | split: "," | first | split: " " | last }}</span><span class="cn">{{ y.call_number | split: " " | first }}</span></a>{% endfor %}</div>
<div class="shelf-foot"><span><b>{{ tts.TotalCount }}</b> new this week</span><span>Holds can go to any branch or Bookmobile stop</span><span>Library of Things: telescopes, sewing machines, hotspots</span></div>
<div class="picks">{%- assign np=0 -%}{% for p in tts.Items %}{%- assign y=p.PublishedContent -%}{%- capture pn -%}{{ y.pick_note }}{%- endcapture -%}{% if pn != "" and np < 3 %}{%- assign np = np | plus: 1 -%}<div class="sticky"><b>Staff pick · {{ y.pick_by }}</b><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a> — {{ pn }}</div>{% endif %}{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Programs · every week</p><h2>Stamped for this week</h2><p>Storytimes, clubs, classes and the makerspace. Every program is free and drop-in: no sign-up and no tickets.</p></div><a class="btn sm line" href="{{ PathBase }}/programs">The week planner →</a></div>
<div class="ddg"><div class="slip"><div class="sh"><span>DATE DUE</span><span style="font-size:.8rem;letter-spacing:.1em">OSSINGFORD P.L.</span></div><ol>{% for p in progs.Items limit:9 %}{%- assign y=p.PublishedContent -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}<li><span class="stamp">{% capture lv1 -%}{{ y.weekday }}{%- endcapture %}{% case lv1 %}{% when "mon" %}Mon{% when "tue" %}Tue{% when "wed" %}Wed{% when "thu" %}Thu{% when "fri" %}Fri{% when "sat" %}Sat{% when "sun" %}Sun{% else %}{{ lv1 }}{% endcase %} {{ y.time_label | split: " –" | first }}</span><div><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small><span class="chip {{ pa }}">{% capture lv2 -%}{{ y.audience }}{%- endcapture %}{% case lv2 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv2 }}{% endcase %}</span>{% capture lv3 -%}{{ y.branch }}{%- endcapture %}{% case lv3 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv3 }}{% endcase %} · {{ y.room }}</small></div></li>{% endfor %}</ol></div>
<div><div class="todaybox"><p class="kick">Today · {{ todayname }}</p><h3>{% if ntoday == 0 %}No programs today{% else %}{{ ntoday }} program{% if ntoday != 1 %}s{% endif %} today{% endif %}</h3><ul>{% for p in progs.Items %}{%- assign y=p.PublishedContent -%}{%- capture wd -%}{{ y.weekday }}{%- endcapture -%}{%- capture pa -%}{{ y.audience }}{%- endcapture -%}{% if wd == today %}<li><span class="tw" style="color:var(--red);font-weight:700">{{ y.time_label }}</span><br><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><br><span class="chip {{ pa }}">{% capture lv4 -%}{{ y.audience }}{%- endcapture %}{% case lv4 %}{% when "all" %}All ages{% when "kids" %}Kids{% when "teens" %}Teens{% when "adults" %}Adults{% when "seniors" %}Older adults{% else %}{{ lv4 }}{% endcase %}</span><small class="muted">{% capture lv5 -%}{{ y.branch }}{%- endcapture %}{% case lv5 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv5 }}{% endcase %}</small></li>{% endif %}{% endfor %}</ul>{% if ntoday == 0 %}<p class="muted" style="margin:10px 0 0">The branches are still open for browsing, study rooms and holds pickup.</p>{% endif %}</div>
<div class="filters">{%- assign auds = "kids:Kids,teens:Teens,adults:Adults,seniors:Older adults,all:All ages" | split: "," -%}{% for a in auds %}{%- assign ap = a | split: ":" -%}<a href="{{ PathBase }}/programs?for={{ ap[0] }}">{{ ap[1] }}</a>{% endfor %}</div></div></div></div></section>
<section class="sec ruled" style="border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)"><div class="w"><div class="shead"><div><p class="kick">Reading lists · from the desk</p><h2>Written on index cards by the people who shelve the books</h2></div><a class="btn sm line" href="{{ PathBase }}/lists">All reading lists →</a></div>
<div class="fan">{% for l in lsts.Items %}{%- assign y=l.PublishedContent -%}{%- assign pk = y.picks | split: "||" -%}<a class="icard" href="{{ PathBase }}/{{ l.RoutePath }}" style="--c:{{ y.color }}"><span class="tab">{% capture lv6 -%}{{ y.branch }}{%- endcapture %}{% case lv6 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv6 }}{% endcase %}</span><h3>{{ l.PrimaryField }}</h3><ol>{% for k in pk limit:4 %}{%- assign kp = k | split: " :: " -%}<li>{{ kp[0] }}</li>{% endfor %}</ol><p class="by">Picked by {{ y.curator }}</p></a>{% endfor %}</div></div></section>
<section class="sec"><div class="w"><div class="shead"><div><p class="kick">Digital library · A–Z</p><h2>Open from anywhere</h2><p>Some resources are free for everyone. E-books, tutoring and research databases need a library card; sign in to see how to get in.</p></div><a class="btn sm line" href="{{ PathBase }}/resources">All {{ rss.TotalCount }} resources →</a></div>
<div class="res2">{%- assign nr=0 -%}{% for r in rss.Items %}{%- assign x=r.PublishedContent -%}{%- capture ra -%}{{ x.audience }}{%- endcapture -%}{% if ra != "staff" and nr < 6 %}{%- assign nr = nr | plus: 1 -%}<a href="{{ PathBase }}/{{ r.RoutePath }}">{% if ra == "cardholders" %}<span class="chip lock">🔒 Card needed</span>{% else %}<span class="chip">Free for everyone</span>{% endif %}<b>{{ r.PrimaryField }}</b><span class="s">{{ x.summary }}</span></a>{% endif %}{% endfor %}</div></div></section>
<section class="sec tight" style="padding-bottom:72px"><div class="w"><div class="shead"><div><p class="kick">Library news</p><h2>From the branches</h2></div><a class="btn sm line" href="{{ PathBase }}/news">All news →</a></div><div class="nlist">{% for n in nws.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv7 -%}{{ y.kind }}{%- endcapture %}{% case lv7 %}{% when "branches" %}Branches{% when "collections" %}Collections{% when "programs" %}Programs{% when "board" %}Library board{% when "community" %}Community{% else %}{{ lv7 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span class="muted">{{ y.summary }}</span></a>{% endfor %}</div></div></section>
<section class="band"><div class="w"><div><h2>A library card is free.</h2><p>For anyone who lives, works or goes to school in Ossingford County. Bring a photo ID and something with your address to any desk or to the Bookmobile.</p></div><a class="btn" href="{{ PathBase }}/get-a-card">How to get a card</a></div></section>
