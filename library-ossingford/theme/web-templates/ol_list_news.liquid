<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>News</li></ol><p class="kick">Library news</p><h1>From the branches</h1><p class="lede">Branch changes, new collections, board decisions and route changes for the Bookmobile.</p></div></div><section class="sec tight"><div class="w"><div class="nlist">{% for n in Target.Items %}{%- assign y=n.PublishedContent -%}<a class="nitem" href="{{ PathBase }}/{{ n.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{{ y.date_label }} · {% capture lv47 -%}{{ y.kind }}{%- endcapture %}{% case lv47 %}{% when "branches" %}Branches{% when "collections" %}Collections{% when "programs" %}Programs{% when "board" %}Library board{% when "community" %}Community{% else %}{{ lv47 }}{% endcase %}</small><b>{{ n.PrimaryField }}</b><span class="muted">{{ y.summary }}</span></a>{% endfor %}</div></div></section>
