{%- assign x=Target.PublishedContent -%}{%- assign pk = x.picks | split: "||" -%}{%- assign others = get_content_items(ContentType="lists", OrderBy="sort_order asc", PageSize=6) -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/lists">Reading lists</a></li><li>{{ Target.PrimaryField }}</li></ol><p class="kick">Reading list · {% capture lv42 -%}{{ x.branch }}{%- endcapture %}{% case lv42 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv42 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div class="catcard" style="padding-top:40px"><span class="tab" style="background:{{ x.color }};position:absolute;top:-16px;left:24px;color:#fff;font:700 .72rem/1 'Courier Prime',monospace;letter-spacing:.1em;padding:6px 10px 8px;border-radius:4px 4px 0 0">{{ pk.size }} PICKS</span><ol style="margin:0;padding-left:24px">{% for k in pk %}{%- assign kp = k | split: " :: " -%}<li><b>{{ kp[0] }}</b> — {{ kp[1] }} <span style="color:var(--red)">({{ kp[2] }})</span></li>{% endfor %}</ol><p style="margin:20px 0 0">— {{ x.curator }}</p></div>
<aside class="panel"><p class="kick">More lists</p>{% for l in others.Items %}{% if l.RoutePath != Target.RoutePath %}<p style="margin:0 0 10px"><a href="{{ PathBase }}/{{ l.RoutePath }}">{{ l.PrimaryField }}</a></p>{% endif %}{% endfor %}<p class="muted" style="margin:18px 0 0;font-size:.95rem">Ask at any desk to have the whole list pulled and held for you.</p></aside></div></div></section>
