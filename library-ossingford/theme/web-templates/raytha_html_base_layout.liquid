<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Ossingford Public Library" %}{{ Target.Title }} | {% endif %}Ossingford Public Library</title>
<meta name="description" content="{% if Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Ossingford Public Library (fictional): five branches and a Bookmobile, weekly programs, new arrivals, reading lists and digital resources. A public library website built on Raytha, a self-hosted, open-source .NET CMS for public libraries, with members-only pages for cardholders and staff.{% endif %}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Public+Sans:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet"><style>
:root{--paper:#f4eedf;--card:#fffbf1;--ink:#1d2433;--ink2:#4a5164;--red:#b8432f;--grn:#2d5a4a;--grn2:#1f4237;--brass:#b08a3e;--rule:#d8cdb2;--manila:#efe2bf;--blue:#3d6a8c}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:400 17px/1.6 "Public Sans",system-ui,sans-serif}
a{color:var(--grn)}a:hover{color:var(--red)}img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:"Source Serif 4",Georgia,serif;font-weight:600;line-height:1.15;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(2.1rem,4.4vw,3.5rem)}h2{font-size:clamp(1.6rem,2.8vw,2.3rem)}h3{font-size:1.25rem}
p{margin:0 0 1em}.w{max-width:1240px;margin:0 auto;padding:0 28px}
.tw{font-family:"Courier Prime","Courier New",monospace}
.skip{position:absolute;left:-999px}.skip:focus{left:8px;top:8px;background:#fff;padding:8px;z-index:9}
.muted{color:var(--ink2)}.kick{font:700 .78rem/1.2 "Courier Prime",monospace;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin:0 0 12px}
/* top bar + header */
.top{background:var(--grn2);color:#d9e6df;font-size:.84rem}.top .w{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:40px;flex-wrap:wrap}
.top a{color:#fff;text-decoration:none;margin-left:16px}.top a:hover{text-decoration:underline;color:#fff}.top .fict{font-family:"Courier Prime",monospace;letter-spacing:.08em}
.top form input{background:#16332a;border:1px solid #3e6b5b;color:#fff;border-radius:3px;padding:5px 10px;font:inherit;width:230px;margin-left:16px}
.top form input::placeholder{color:#a9c2b7}
.hdr{background:var(--paper);border-bottom:3px double var(--ink)}.hdr .w{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:18px;padding-bottom:18px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--ink)}.brand b{display:block;font:600 1.55rem/1.1 "Source Serif 4",Georgia,serif}.brand small{display:block;font:400 .82rem/1.3 "Courier Prime",monospace;color:var(--ink2);letter-spacing:.06em;margin-top:3px}
.drawers ol{list-style:none;margin:0;padding:0;display:flex;gap:10px;flex-wrap:wrap}
.drawers a{position:relative;display:block;padding:7px 14px 8px;background:#e9dfc6;border:2px solid var(--brass);border-radius:3px;box-shadow:inset 0 0 0 3px #f7f1e2,0 2px 0 #c9b98f;font:700 .82rem/1 "Courier Prime",monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--ink);text-decoration:none;margin-bottom:12px}
.drawers a:after{content:"";position:absolute;left:50%;bottom:-12px;width:14px;height:8px;margin-left:-7px;border:2px solid var(--brass);border-top:0;border-radius:0 0 10px 10px}
.drawers a:hover{background:#fff8e6;color:var(--red)}
/* buttons */
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--grn);color:#fff;border:0;border-radius:3px;padding:12px 20px;font:600 1rem/1 "Public Sans",sans-serif;text-decoration:none;cursor:pointer}
.btn:hover{background:var(--grn2);color:#fff}.btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}.btn.line:hover{background:var(--ink);color:#fff}.btn.sm{padding:9px 14px;font-size:.9rem}.btn.red{background:var(--red)}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
/* sections */
.sec{padding:72px 0}.sec.tight{padding:44px 0}.shead{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px;flex-wrap:wrap}.shead p{max-width:640px;margin:10px 0 0;color:var(--ink2)}
.ruled{background-image:repeating-linear-gradient(transparent 0 31px,var(--rule) 31px 32px)}
/* hero */
.hero{padding:56px 0 70px;border-bottom:1px solid var(--rule)}.hero .g{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center}
.hero .lede{font-size:1.2rem;color:var(--ink2);max-width:560px;margin-top:20px}
.today-strip{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.today-strip span{font:700 .78rem/1 "Courier Prime",monospace;letter-spacing:.06em;background:var(--card);border:1px solid var(--rule);padding:8px 10px;border-radius:2px}
.ccard{position:relative;background:var(--card);border:1px solid #d6c9a8;box-shadow:0 1px 0 #d6c9a8,0 18px 40px -18px rgba(29,36,51,.45);padding:26px 30px 52px;font-family:"Courier Prime",monospace;background-image:linear-gradient(var(--red),var(--red)),repeating-linear-gradient(transparent 0 29px,#e4dcc6 29px 30px);background-size:100% 2px,100% 100%;background-position:0 64px,0 76px;background-repeat:no-repeat,repeat}
.ccard:after{content:"";position:absolute;left:50%;bottom:16px;width:22px;height:22px;margin-left:-11px;border-radius:50%;background:var(--paper);box-shadow:inset 0 2px 3px rgba(0,0,0,.25)}
.ccard .hd{display:flex;justify-content:space-between;font-size:.9rem;letter-spacing:.05em;height:44px}.ccard .hd b{color:var(--red)}
.stack{position:relative}.stack:before,.stack:after{content:"";position:absolute;inset:0;background:var(--card);border:1px solid #d6c9a8}.stack:before{transform:rotate(3deg) translate(10px,6px)}.stack:after{transform:rotate(-2deg) translate(-8px,10px)}
.stack .ccard{z-index:1;transform:rotate(-.8deg)}
.hours{width:100%;border-collapse:collapse;font-size:1rem}.hours td{padding:5px 0;height:30px;vertical-align:bottom;white-space:nowrap}.hours td:last-child{text-align:right}.hours a{color:var(--ink);text-decoration:none}.hours a:hover{color:var(--red)}
.hours .closed{color:var(--red)}.hours .lim{display:inline-block;margin-left:6px;font-size:.72rem;color:#fff;background:var(--red);padding:1px 5px;vertical-align:2px}
/* shelf */
.stacks{background:linear-gradient(#21483c,#1a3a30);color:#e8efe9;padding:70px 0 0;overflow:hidden}.stacks h2{color:#fff}.stacks .shead p{color:#b9cfc5}.stacks .kick{color:#f0b9a8}
.shelf{display:flex;align-items:flex-end;gap:4px;height:360px;padding:0 6px;border-bottom:18px solid #7a5232;box-shadow:0 14px 0 #5b3b22;overflow-x:auto;overflow-y:hidden}
.spine{flex:0 0 auto;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:12px 0 10px;color:#fff;text-decoration:none;border-radius:3px 3px 0 0;box-shadow:inset -5px 0 0 rgba(0,0,0,.18),inset 4px 0 0 rgba(255,255,255,.12);transition:transform .15s}
.spine:hover{transform:translateY(-14px);color:#fff}.spine .t{writing-mode:vertical-rl;transform:rotate(180deg);font:600 .92rem/1.12 "Source Serif 4",Georgia,serif;flex:1;min-height:0;overflow:hidden;padding:0 4px;text-align:left}
.spine .a{writing-mode:vertical-rl;transform:rotate(180deg);font:600 .66rem/1 "Public Sans",sans-serif;letter-spacing:.08em;text-transform:uppercase;opacity:.85;white-space:nowrap;margin:8px 0 8px}
.spine .cn{background:#fffbf1;color:var(--ink);font:700 .6rem/1.05 "Courier Prime",monospace;padding:3px 2px;width:80%;text-align:center;word-break:break-word}
.spine.lt{color:var(--ink)}.spine.lt:hover{color:var(--ink)}
.shelf-foot{display:flex;gap:26px;flex-wrap:wrap;padding:34px 0 60px;font-size:.95rem;color:#b9cfc5}.shelf-foot b{color:#fff}
.picks{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;padding-bottom:70px}
.sticky{background:#f7e58e;color:var(--ink);padding:20px 22px;transform:rotate(-1deg);box-shadow:0 10px 20px -10px rgba(0,0,0,.5);font-size:.98rem}.sticky:nth-child(2){transform:rotate(1.2deg);background:#f2d3a6}.sticky:nth-child(3){transform:rotate(-.4deg);background:#d9ead0}
.sticky b{display:block;font:700 .75rem/1.2 "Courier Prime",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--red);margin-bottom:8px}.sticky a{color:var(--ink);font-weight:700}
/* date due slip */
.ddg{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:44px;align-items:start}
.slip{background:var(--manila);border:1px solid #d3c08e;padding:0 0 18px;box-shadow:0 18px 30px -20px rgba(29,36,51,.5);position:relative}
.slip .sh{display:flex;justify-content:space-between;align-items:center;padding:18px 26px;border-bottom:2px solid var(--ink);font:700 1.05rem/1 "Courier Prime",monospace;letter-spacing:.2em}
.slip ol{list-style:none;margin:0;padding:0}.slip li{display:grid;grid-template-columns:150px 1fr;gap:18px;align-items:center;padding:12px 26px;border-bottom:1px solid #d3c08e}
.stamp{display:inline-block;justify-self:start;font:700 .9rem/1.05 "Courier Prime",monospace;letter-spacing:.06em;color:var(--red);border:2px solid var(--red);border-radius:3px;padding:5px 8px;text-transform:uppercase;transform:rotate(-3deg);opacity:.88;mix-blend-mode:multiply;text-align:center}
.slip li:nth-child(even) .stamp{transform:rotate(2deg)}.slip li:nth-child(3n) .stamp{transform:rotate(-1deg);color:#7a2f8a;border-color:#7a2f8a}
.slip li a{color:var(--ink);text-decoration:none;font-weight:600}.slip li a:hover{color:var(--red)}.slip li small{display:block;color:var(--ink2);font-size:.85rem}
.chip{display:inline-block;font:700 .7rem/1 "Courier Prime",monospace;letter-spacing:.06em;text-transform:uppercase;padding:4px 7px;border-radius:2px;background:#e3e9e4;color:var(--grn2);margin-right:6px;text-decoration:none}
.chip.kids{background:#fde3cf;color:#8a3d11}.chip.teens{background:#e5def5;color:#4a3a7a}.chip.adults{background:#dde8f0;color:#24496a}.chip.seniors{background:#efe0e6;color:#7a2f4f}.chip.all{background:#e3e9e4}
.chip.lock{background:var(--ink);color:#fff}.chip.on{background:var(--red);color:#fff}
.todaybox{background:var(--card);border:1px solid var(--rule);padding:26px 28px}.todaybox h3{margin-bottom:6px}.todaybox ul{list-style:none;margin:16px 0 0;padding:0}.todaybox li{padding:12px 0;border-top:1px dashed var(--rule)}.todaybox li a{font-weight:600;color:var(--ink);text-decoration:none}
/* index cards for lists */
.fan{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
.icard{position:relative;display:block;background:var(--card);border:1px solid #d6c9a8;padding:32px 24px 22px;text-decoration:none;color:var(--ink);box-shadow:0 12px 26px -18px rgba(29,36,51,.6);transition:transform .15s;background-image:repeating-linear-gradient(transparent 0 27px,#e6dec9 27px 28px);background-position:0 62px}
.icard:before{content:"";position:absolute;left:0;right:0;top:0;height:8px;background:var(--c,#2d5a4a)}
.icard:hover{transform:translateY(-4px) rotate(-.5deg);color:var(--ink)}.icard h3{margin:4px 0 12px}.icard ol{margin:0;padding-left:20px;font-family:"Courier Prime",monospace;font-size:.95rem;line-height:28px}.icard .by{font-size:.85rem;color:var(--ink2);margin-top:12px}
.tab{position:absolute;top:-16px;left:22px;background:var(--c,#2d5a4a);color:#fff;font:700 .7rem/1 "Courier Prime",monospace;letter-spacing:.1em;padding:6px 10px 8px;border-radius:4px 4px 0 0;text-transform:uppercase}
/* drawer A-Z */
.az{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:26px}.az a{width:44px;height:44px;display:grid;place-items:center;background:#e9dfc6;border:2px solid var(--brass);border-radius:3px;font:700 1.05rem/1 "Courier Prime",monospace;color:var(--ink);text-decoration:none}.az a:hover{background:var(--ink);color:#fff}
.az span{width:44px;height:44px;display:grid;place-items:center;color:#c2b590;font:700 1.05rem/1 "Courier Prime",monospace;border:2px dashed #d8cdb2;border-radius:3px}
.letter{display:grid;grid-template-columns:70px 1fr;gap:20px;border-top:2px solid var(--ink);padding:18px 0}.letter>b{font:600 2.6rem/1 "Source Serif 4",serif;color:var(--red)}
.res{display:grid;grid-template-columns:1fr auto;gap:6px 18px;padding:10px 0;border-bottom:1px dashed var(--rule)}.res a{font-weight:700;color:var(--ink);text-decoration:none;font-size:1.05rem}.res a:hover{color:var(--red)}.res p{grid-column:1/-1;margin:0;color:var(--ink2);font-size:.95rem}
.res2{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.res2 a{display:block;background:var(--card);border:1px solid var(--rule);padding:18px 20px;text-decoration:none;color:var(--ink)}.res2 a:hover{border-color:var(--ink)}.res2 b{display:block;font:600 1.1rem/1.2 "Source Serif 4",serif;margin:8px 0 6px}.res2 span.s{font-size:.92rem;color:var(--ink2)}
/* page head + panels */
.phead{padding:44px 0 40px;border-bottom:1px solid var(--rule);background:linear-gradient(90deg,transparent 0 79px,rgba(184,67,47,.35) 79px 81px,transparent 81px),repeating-linear-gradient(transparent 0 31px,#e4dcc6 31px 32px)}
.phead .lede{font-size:1.15rem;color:var(--ink2);max-width:760px;margin:16px 0 0}
.crumbs{list-style:none;margin:0 0 18px;padding:0;display:flex;gap:8px;font:.85rem "Courier Prime",monospace}.crumbs li+li:before{content:"/";margin-right:8px;color:var(--ink2)}.crumbs a{color:var(--ink2)}
.panel{background:var(--card);border:1px solid var(--rule);padding:24px 26px}.panel.dark{background:var(--ink);color:#e7e9ef;border-color:var(--ink)}.panel.dark a{color:#f4c2b5}
.lockp{background:var(--card);border:2px dashed var(--ink);padding:30px 32px;max-width:760px}.lockp h2{font-size:1.6rem;margin-bottom:10px}
.notice{background:#f9e3dc;border-left:5px solid var(--red);padding:14px 18px;margin:0 0 18px}
.dg{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:48px;align-items:start}
.prose{font-size:1.06rem}.prose h2{margin:0 0 14px}.prose p{max-width:700px}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.grid6{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
/* branches */
.bcard{display:grid;grid-template-columns:330px 1fr;gap:30px;background:var(--card);border:1px solid var(--rule);padding:22px;margin-bottom:22px}.bcard img{border:1px solid var(--rule)}
.bcard h2{font-size:1.7rem}.bcard h2 a{color:var(--ink);text-decoration:none}.bcard h2 a:hover{color:var(--red)}
.week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:16px}.week div{border:1px solid var(--rule);padding:8px 8px 10px;font-size:.8rem;background:#fff;min-height:72px}.week b{display:block;font:700 .72rem/1 "Courier Prime",monospace;letter-spacing:.1em;margin-bottom:6px;color:var(--ink2)}
.week div.now{background:var(--ink);color:#fff;border-color:var(--ink)}.week div.now b{color:#f4c2b5}.week .x{color:var(--red)}
.feat{list-style:none;padding:0;margin:0;columns:2;gap:24px}.feat li{padding:6px 0 6px 22px;position:relative;break-inside:avoid}.feat li:before{content:"▪";position:absolute;left:0;color:var(--red)}
.status{display:inline-block;font:700 .75rem/1 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase;padding:6px 9px;border-radius:2px;background:#dfeee5;color:var(--grn2)}.status.limited{background:#f9e3dc;color:var(--red)}
.htable{width:100%;border-collapse:collapse;font-family:"Courier Prime",monospace}.htable th,.htable td{padding:9px 12px;border-bottom:1px solid var(--rule);text-align:left}.htable tr.now td{background:var(--ink);color:#fff}.htable tr.now td:first-child:after{content:" · today";color:#f4c2b5}
/* week planner (programs) */
.planner{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px}.planner .day{background:var(--card);border:1px solid var(--rule);min-height:220px}.planner .day.now{border:2px solid var(--ink)}
.planner .dh{padding:10px 12px;border-bottom:2px solid var(--ink);font:700 .85rem/1 "Courier Prime",monospace;letter-spacing:.12em;display:flex;justify-content:space-between}.planner .day.now .dh{background:var(--ink);color:#fff}
.ev{display:block;padding:10px 12px;border-bottom:1px dashed var(--rule);text-decoration:none;color:var(--ink);font-size:.88rem;line-height:1.35}.ev:hover{background:#fff}.ev b{display:block;font-weight:700;margin:4px 0 4px}.ev i{font-style:normal;font:700 .74rem/1 "Courier Prime",monospace;color:var(--red)}.ev small{display:block;color:var(--ink2);font-size:.78rem}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 0}.filters a{font:700 .78rem/1 "Courier Prime",monospace;letter-spacing:.06em;text-transform:uppercase;padding:9px 12px;border:2px solid var(--ink);color:var(--ink);text-decoration:none;border-radius:2px}.filters a.on,.filters a:hover{background:var(--ink);color:#fff}
.bigstamp{display:inline-block;font:700 1.5rem/1.1 "Courier Prime",monospace;letter-spacing:.06em;color:var(--red);border:3px solid var(--red);padding:12px 18px;transform:rotate(-3deg);text-transform:uppercase;margin:6px 0 18px;background:rgba(255,255,255,.35)}
dl.kv{display:grid;grid-template-columns:120px 1fr;gap:10px 16px;margin:0}dl.kv dt{font:700 .78rem/1.6 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}dl.kv dd{margin:0}
/* titles */
.covers{display:grid;grid-template-columns:repeat(6,1fr);gap:22px}.cov{text-decoration:none;color:var(--ink)}.cov img{aspect-ratio:2/3;object-fit:cover;box-shadow:4px 6px 0 rgba(29,36,51,.15);border:1px solid rgba(0,0,0,.1)}.cov b{display:block;margin-top:10px;font:600 1rem/1.25 "Source Serif 4",serif}.cov small{display:block;color:var(--ink2);font-size:.85rem}.cov:hover b{color:var(--red)}
.catcard{background:var(--card);border:1px solid #d6c9a8;padding:26px 32px 40px;font-family:"Courier Prime",monospace;font-size:1.02rem;line-height:30px;background-image:repeating-linear-gradient(transparent 0 29px,#e4dcc6 29px 30px);background-position:0 12px;box-shadow:0 18px 40px -22px rgba(29,36,51,.5);position:relative}
.catcard .cn{position:absolute;left:32px;top:26px;color:var(--red);font-weight:700;white-space:pre-line;width:110px;line-height:30px}.catcard .body{margin-left:140px}.catcard .body b{font-weight:700}.catcard .tr{margin-top:30px}
.avail{width:100%;border-collapse:collapse}.avail th,.avail td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--rule)}.avail th{font:700 .75rem/1 "Courier Prime",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2)}
.ok{color:var(--grn);font-weight:700}.wait{color:var(--red);font-weight:700}
/* lib card */
.libcard{width:100%;max-width:440px;aspect-ratio:1.586;border-radius:16px;background:linear-gradient(135deg,#2d5a4a,#1f4237 60%,#173329);color:#fff;padding:24px 26px;position:relative;box-shadow:0 22px 40px -18px rgba(0,0,0,.55);overflow:hidden}
.libcard:before{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;border:30px solid rgba(255,255,255,.06)}
.libcard .nm{font:600 1.35rem/1.1 "Source Serif 4",serif}.libcard .sub{font:.75rem/1.2 "Courier Prime",monospace;letter-spacing:.12em;opacity:.8;margin-top:4px}
.libcard .bc{position:absolute;left:26px;right:26px;bottom:22px;background:#fffbf1;border-radius:6px;padding:10px 14px 8px;color:var(--ink)}.libcard .bc svg{width:100%;height:38px;display:block}.libcard .bc span{display:flex;justify-content:space-between;font:700 .78rem/1.4 "Courier Prime",monospace;letter-spacing:.1em}
.libcard .who{position:absolute;left:26px;bottom:104px;font:700 1rem/1.2 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase}
/* tables + notes widgets */
.sched{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--rule)}.sched th{background:var(--ink);color:#fff;text-align:left;font:700 .78rem/1 "Courier Prime",monospace;letter-spacing:.1em;text-transform:uppercase;padding:12px}.sched td{padding:11px 12px;border-bottom:1px solid var(--rule);font-size:.95rem}.sched tr td:first-child{font-weight:700}
.tscroll{overflow-x:auto}
.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.note{background:var(--card);border:1px solid var(--rule);border-top:6px solid var(--red);padding:20px 22px}.note:nth-child(2){border-top-color:var(--grn)}.note:nth-child(3){border-top-color:var(--brass)}.note h3{margin:8px 0 8px}
.ol2{list-style:none;counter-reset:s;margin:26px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.ol2 li{counter-increment:s;background:var(--card);border:1px solid var(--rule);padding:22px}.ol2 li:before{content:"No. " counter(s);display:block;font:700 .8rem/1 "Courier Prime",monospace;letter-spacing:.1em;color:var(--red);margin-bottom:12px}.ol2 h3{margin-bottom:8px}.ol2 p{margin:0;color:var(--ink2);font-size:.96rem}
/* news */
.nlist{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.nitem{text-decoration:none;color:var(--ink);display:block}.nitem img{border:1px solid var(--rule);aspect-ratio:2/1;object-fit:cover}.nitem b{display:block;font:600 1.2rem/1.25 "Source Serif 4",serif;margin:12px 0 6px}.nitem:hover b{color:var(--red)}.nitem small{font:700 .75rem/1 "Courier Prime",monospace;letter-spacing:.08em;color:var(--red);text-transform:uppercase}
.band{background:var(--red);color:#fff}.band .w{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-top:40px;padding-bottom:40px;flex-wrap:wrap}.band h2{color:#fff}.band p{margin:8px 0 0;color:#fbe1d9;max-width:680px}.band .btn{background:#fff;color:var(--red)}.band .btn:hover{background:var(--ink);color:#fff}
/* search */
.searchbar{display:flex;gap:10px;margin-top:22px;max-width:680px}.searchbar input{flex:1;font:inherit;padding:12px 14px;border:2px solid var(--ink);border-radius:3px;background:#fff}
.hit{display:block;padding:14px 0;border-bottom:1px dashed var(--rule);text-decoration:none;color:var(--ink)}.hit b{font-size:1.08rem}.hit:hover b{color:var(--red)}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.95rem}
label{display:block;font:700 .8rem/1.4 "Courier Prime",monospace;letter-spacing:.08em;text-transform:uppercase;margin-bottom:6px}input[type=email],input[type=password]{width:100%;font:inherit;padding:12px 14px;border:2px solid var(--ink);border-radius:3px;background:#fff}
/* footer */
.foot{background:var(--ink);color:#c5c9d4;padding:60px 0 30px;margin-top:0}.foot a{color:#fff;text-decoration:none}.foot a:hover{text-decoration:underline;color:#fff}.foot h4{color:#fff;font:700 .78rem/1 "Courier Prime",monospace;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
.fg{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:36px}.foot ul{list-style:none;margin:0;padding:0}.foot li{margin:0 0 8px}
.disc{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:44px;padding-top:20px;border-top:1px solid #39415a;font-size:.84rem}
@media (max-width:1100px){.planner{grid-template-columns:repeat(4,1fr)}.covers{grid-template-columns:repeat(4,1fr)}}
@media (max-width:900px){.dg,.tgrid{grid-template-columns:1fr!important}.hero .g,.ddg,.dg{grid-template-columns:1fr}.fan,.picks,.notes,.nlist,.res2,.grid3{grid-template-columns:1fr 1fr}.grid4,.ol2{grid-template-columns:1fr 1fr}.bcard{grid-template-columns:1fr}.fg{grid-template-columns:1fr 1fr}.planner{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){body{font-size:16px}.top .fict{display:none}.top .w{justify-content:flex-end}.phead{background:repeating-linear-gradient(transparent 0 31px,#e4dcc6 31px 32px)}.tgrid>div:first-child img{max-width:200px}.w{padding:0 18px}.top .hm{display:none}.top form input{width:150px;margin-left:0}.hdr .w{padding-top:14px;padding-bottom:10px}.brand b{font-size:1.25rem}
 .drawers ol{gap:6px}.drawers a{font-size:.7rem;padding:6px 8px}.fan,.picks,.notes,.nlist,.res2,.grid2,.grid3,.grid4,.ol2,.planner{grid-template-columns:1fr}.covers{grid-template-columns:repeat(2,1fr)}
 .slip li{grid-template-columns:1fr;gap:6px;padding:12px 18px}.hero{padding:34px 0 50px}.shelf{height:300px}.sec{padding:52px 0}.week{grid-template-columns:repeat(4,1fr)}.feat{columns:1}.catcard .cn{position:static;width:auto;white-space:normal}.catcard .body{margin-left:0}.catcard{padding:20px}.ccard{padding:20px 18px 48px}.letter{grid-template-columns:44px 1fr}.letter>b{font-size:2rem}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="top"><div class="w"><span class="fict">FICTIONAL LIBRARY · RAYTHA EXAMPLE SITE</span><div>{% if CurrentUser.IsAuthenticated %}<span class="hm">Signed in as <b style="color:#fff">{{ CurrentUser.FirstName }}</b></span><a href="{{ PathBase }}/my-library">My library</a><a href="{{ PathBase }}/account/logout">Sign out</a>{% else %}<a href="{{ PathBase }}/account/login?returnUrl=/my-library">Cardholder sign-in</a><a class="hm" href="{{ PathBase }}/account/login?returnUrl=/staff-room">Staff</a>{% endif %}<form action="{{ PathBase }}/search" role="search" style="display:inline"><input name="q" aria-label="Search the site" placeholder="Search programs, titles, help…"></form></div></div></div>
<header class="hdr"><div class="w"><a class="brand" href="{{ PathBase }}/"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect x="1" y="1" width="44" height="44" rx="3" fill="#2d5a4a"/><rect x="8" y="10" width="30" height="22" fill="#fffbf1"/><path d="M8 16H38" stroke="#b8432f" stroke-width="2"/><path d="M12 21H30M12 25H26" stroke="#1d2433" stroke-width="1.6"/><circle cx="23" cy="36" r="3" fill="#b08a3e"/></svg><span><b>Ossingford Public Library</b><small>FIVE BRANCHES · ONE FREE CARD · SINCE 1911</small></span></a>
<nav class="drawers" aria-label="Main"><ol>{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ol></nav></div></header>
<main id="main">{% renderbody %}</main>
<footer class="foot"><div class="w"><div class="fg"><div><div style="display:flex;gap:12px;align-items:center"><svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect x="1" y="1" width="44" height="44" rx="3" fill="#2d5a4a"/><rect x="8" y="10" width="30" height="22" fill="#fffbf1"/><path d="M8 16H38" stroke="#b8432f" stroke-width="2"/><path d="M12 21H30M12 25H26" stroke="#1d2433" stroke-width="1.6"/><circle cx="23" cy="36" r="3" fill="#b08a3e"/></svg><b style="color:#fff;font:600 1.25rem 'Source Serif 4',serif">Ossingford Public Library</b></div><p style="margin-top:14px;max-width:380px">Central Library, 400 Kettle Square, Ossingford (fictional). Ask a librarian: (555) 014-2200. The library, its branches, people and figures are fictional; this is a Raytha example site.</p></div>
<div><h4>Visit</h4><ul><li><a href="{{ PathBase }}/branches">Branches and hours</a></li><li><a href="{{ PathBase }}/branches/bookmobile">Bookmobile route</a></li><li><a href="{{ PathBase }}/programs">This week's programs</a></li><li><a href="{{ PathBase }}/get-a-card">Get a library card</a></li></ul></div>
<div><h4>Borrow</h4><ul><li><a href="{{ PathBase }}/new">New arrivals</a></li><li><a href="{{ PathBase }}/lists">Reading lists</a></li><li><a href="{{ PathBase }}/resources">Digital resources A–Z</a></li></ul></div>
<div><h4>Library</h4><ul>{%- assign fm = get_menu("footer") -%}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div></div>
<div class="disc"><span>© 2026 Ossingford Public Library (fictional) · 555 phone numbers · no payment, registration or sign-up forms on this site.</span><span>Server-rendered with Raytha · works without JavaScript</span></div></div></footer></body></html>
