<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Reading lists</li></ol><p class="kick">Reading lists</p><h1>Picked by the people at the desk</h1><p class="lede">Short lists written by library staff, each tied to a program, a branch or a season.</p></div></div><section class="sec"><div class="w"><div class="fan">{% for l in Target.Items %}{%- assign y=l.PublishedContent -%}{%- assign pk = y.picks | split: "||" -%}<a class="icard" href="{{ PathBase }}/{{ l.RoutePath }}" style="--c:{{ y.color }}"><span class="tab">{% capture lv41 -%}{{ y.branch }}{%- endcapture %}{% case lv41 %}{% when "central" %}Central Library{% when "millrace" %}Millrace{% when "quarry" %}North Quarry{% when "ferrin" %}Ferrin Heights{% when "bookmobile" %}Bookmobile{% else %}{{ lv41 }}{% endcase %}</span><h3>{{ l.PrimaryField }}</h3><ol>{% for k in pk %}{%- assign kp = k | split: " :: " -%}<li>{{ kp[0] }}</li>{% endfor %}</ol><p class="by">Picked by {{ y.curator }}</p></a>{% endfor %}</div></div></section>
