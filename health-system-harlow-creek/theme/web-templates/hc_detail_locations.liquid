{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture bk %}{{ p.kind }}{% endcapture %}{% for pair in lks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/locations">Locations</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill navy" style="margin-bottom:10px"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px"><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover">
    <div class="card pad prose" style="padding:30px"><h2 style="margin-top:0">About this location</h2>{{ p.about }}<h2>Services here</h2><div style="display:flex;gap:8px;flex-wrap:wrap">{% assign sv = p.services | split: "," %}{% for s in sv %}<span class="pill blue">{{ s | strip }}</span>{% endfor %}</div></div></div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><dl class="facts"><div><dt>Address</dt><dd>{{ p.address }}<br>{{ p.town }}</dd></div><div><dt>Phone</dt><dd><a href="tel:{{ p.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.phone }}</a></dd></div><div><dt>Hours</dt><dd class="hours">{{ p.hours }}</dd></div>{% capture c_p_parking %}{{ p.parking | strip }}{% endcapture %}{% if c_p_parking != "" %}<div><dt>Parking</dt><dd>{{ p.parking }}</dd></div>{% endif %}{% capture er %}{{ p.er | downcase }}{% endcapture %}{% if er == "true" %}<div><dt>Emergency</dt><dd>Open 24 hours</dd></div>{% endif %}</dl></div>
    <div class="cta"><h2 style="font-size:1.15rem">Find a doctor here</h2><p style="margin:8px 0 14px;font-size:.95rem">Browse providers and filter by specialty.</p><a class="btn btn-g" href="{{ PathBase }}/providers">Find a doctor</a></div>
  </aside>
</div></div>
