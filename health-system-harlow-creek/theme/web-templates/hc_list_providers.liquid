{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}
{%- assign qs = "" -%}{%- for pair in sps %}{% assign kv = pair | split: ":" %}{% if QueryParams.specialty == kv[0] %}{% assign qs = kv[0] %}{% endif %}{% endfor -%}
{%- assign qacc = QueryParams.accepting | default: "" -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Find a doctor</li></ol></nav><h1>Find a doctor</h1><p>Search our fictional directory by specialty. Filter to providers accepting new patients or offering telehealth.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/providers" method="get">
  <div><label for="spec">Specialty</label><select id="spec" name="specialty"><option value="">Any specialty</option>{% for pair in sps %}{% assign kv = pair | split: ":" %}<option value="{{ kv[0] }}"{% if qs == kv[0] %} selected{% endif %}>{{ kv[1] }}</option>{% endfor %}</select></div>
  <div><label for="acc">Availability</label><select id="acc" name="accepting"><option value="">Anyone</option><option value="true"{% if qacc == "true" %} selected{% endif %}>Accepting new patients</option></select></div>
  <button class="btn btn-p" type="submit">Apply filters</button>
  {% if qs != "" or qacc != "" %}<a class="btn btn-o" href="{{ PathBase }}/providers">Clear</a>{% endif %}
</form>
<div class="pgrid">{% for p in Target.Items %}{% capture sp %}{{ p.PublishedContent.specialty }}{% endcapture %}{% capture ac %}{{ p.PublishedContent.accepting | downcase }}{% endcapture %}{% if qs == "" or qs == sp %}{% if qacc == "" or qacc == ac %}{% assign x = p.PublishedContent %}{% capture sp %}{{ x.specialty }}{% endcapture %}{% for pair in sps %}{% assign kv = pair | split: ":" %}{% if kv[0] == sp %}{% assign sl = kv[1] %}{% assign si = kv[2] %}{% endif %}{% endfor %}<a class="card pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt=""><span><b>{{ p.PrimaryField }}{% capture c %}{{ x.credentials | strip }}{% endcapture %}{% if c != "" %}, {{ x.credentials }}{% endif %}</b><span class="meta">{{ sl }}{% capture t %}{{ x.title | strip }}{% endcapture %}{% if t != "" %} &middot; {{ x.title }}{% endif %}</span><span class="flags">{% capture a %}{{ x.accepting | downcase }}{% endcapture %}{% if a == "true" %}<span class="pill green">Accepting patients</span>{% else %}<span class="pill">Not accepting new</span>{% endif %}{% capture th %}{{ x.telehealth | downcase }}{% endcapture %}{% if th == "true" %}<span class="pill blue">Telehealth</span>{% endif %}</span></span></a>{% endif %}{% endif %}{% endfor %}</div>
<p class="disc" style="margin-top:28px">Every provider on this page is fictional. Harlow Creek Health System is not a real hospital and does not employ these people.</p>
</div></div>
