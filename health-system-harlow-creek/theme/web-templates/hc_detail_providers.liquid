{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture sp %}{{ p.specialty }}{% endcapture %}{% for pair in sps %}{% assign kv = pair | split: ":" %}{% if kv[0] == sp %}{% assign sl = kv[1] %}{% assign si = kv[2] %}{% endif %}{% endfor %}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/providers">Find a doctor</a></li><li><a href="{{ PathBase }}/providers?specialty={{ sp }}">{{ sl }}</a></li><li aria-current="page">{{ Target.PrimaryField }}{% capture c %}{{ p.credentials | strip }}{% endcapture %}{% if c != "" %}, {{ p.credentials }}{% endif %}</li></ol></nav><span class="pill blue" style="margin-bottom:10px"><i class="bi bi-{{ si }}" aria-hidden="true"></i> {{ sl }}</span><h1>{{ Target.PrimaryField }}{% capture c %}{{ p.credentials | strip }}{% endcapture %}{% if c != "" %}, {{ p.credentials }}{% endif %}</h1><p>{{ p.title }}</p></div></div>
<div class="body"><div class="wrap">
<div class="card phero" style="margin-bottom:24px"><img src="{{ p.photo.Value | attachment_redirect_url }}" alt="Portrait of {{ Target.PrimaryField }}"><div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">{% capture a %}{{ p.accepting | downcase }}{% endcapture %}{% if a == "true" %}<span class="pill green">Accepting new patients</span>{% else %}<span class="pill">Not accepting new patients</span>{% endif %}{% capture th %}{{ p.telehealth | downcase }}{% endcapture %}{% if th == "true" %}<span class="pill blue">Telehealth available</span>{% endif %}</div>
  <dl class="facts"><div><dt>Specialty</dt><dd>{{ sl }}</dd></div>{% if p.location %}<div><dt>Location</dt><dd><a href="{{ PathBase }}/{{ p.location.RoutePath }}">{{ p.location.PrimaryField }}</a></dd></div>{% endif %}{% if p.department %}<div><dt>Department</dt><dd><a href="{{ PathBase }}/{{ p.department.RoutePath }}">{{ p.department.PrimaryField }}</a></dd></div>{% endif %}<div><dt>Languages</dt><dd>{{ p.languages }}</dd></div></dl>
</div></div>
<div class="art"><article class="card pad prose" style="padding:32px"><h2 style="margin-top:0">About {{ Target.PrimaryField | split: " " | first }}</h2>{{ p.bio }}<p class="disc" style="margin-top:20px">This provider is fictional. Harlow Creek Health System is a Raytha example site.</p></article>
<aside class="grid" style="gap:20px"><div class="cta"><h2 style="font-size:1.15rem">Request an appointment</h2><p style="margin:8px 0 14px;font-size:.95rem">Call the clinic that lists this provider, or start from the location page. There is no online scheduling form on this demo site.</p><a class="btn btn-g" href="{{ PathBase }}/contact">Contact us</a></div>
<p><a href="{{ PathBase }}/providers"><i class="bi bi-arrow-left" aria-hidden="true"></i> All providers</a></p></aside></div>
</div></div>
