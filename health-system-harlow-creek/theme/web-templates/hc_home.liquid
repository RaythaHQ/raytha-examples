{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}
{%- assign feat_d = get_content_items(ContentType="departments", Filter="featured eq 'true'", OrderBy="sort_order asc", PageSize=6) -%}
{%- assign feat_n = get_content_items(ContentType="news", Filter="featured eq 'true'", OrderBy="posted_on desc", PageSize=3) -%}
{%- assign feat_e = get_content_items(ContentType="events", Filter="featured eq 'true'", OrderBy="starts_on asc", PageSize=4) -%}
{%- assign locs = get_content_items(ContentType="locations", OrderBy="sort_order asc", PageSize=6) -%}
<section class="hero"><div class="wrap">
  <span class="kicker">Regional care, close to home</span>
  <h1>Care you can find, from people who know this valley</h1>
  <p class="lead">Harlow Creek Health System is a fictional regional health system with a 312-bed hospital, clinics and specialty centers. Find a doctor, get directions or prepare for a visit.</p>
  <form class="hsearch" action="{{ PathBase }}/providers" role="search" method="get"><label for="hq">Find a doctor</label><input id="hq" name="q" placeholder="Search by name, or use specialty filters on the next page"><button class="btn btn-g" type="submit">Find a doctor</button></form>
  <div class="pop"><span>Popular:</span><a href="{{ PathBase }}/providers?specialty=family">Family medicine</a><a href="{{ PathBase }}/providers?specialty=cardiology">Cardiology</a><a href="{{ PathBase }}/locations">Locations</a><a href="{{ PathBase }}/services/emergency-and-trauma">Emergency</a></div>
</div></section>
<section class="tasks"><div class="wrap"><div class="tgrid">
  <a class="task" href="{{ PathBase }}/providers"><span class="ic" aria-hidden="true"><i class="bi bi-person-badge"></i></span><span><b>Find a doctor</b><span>Filter by specialty and accepting patients</span></span></a>
  <a class="task" href="{{ PathBase }}/locations"><span class="ic" aria-hidden="true"><i class="bi bi-geo-alt"></i></span><span><b>Locations</b><span>Hospital, urgent care, clinics and specialty centers</span></span></a>
  <a class="task" href="{{ PathBase }}/resources"><span class="ic" aria-hidden="true"><i class="bi bi-journal-medical"></i></span><span><b>Patients and visitors</b><span>Hours, parking, billing and what to bring</span></span></a>
  <a class="task" href="{{ PathBase }}/events"><span class="ic" aria-hidden="true"><i class="bi bi-calendar-event"></i></span><span><b>Classes and events</b><span>Childbirth, diabetes, screenings and support groups</span></span></a>
</div></div></section>
{{ render_section("hero", wrap=false) }}
<section class="sec"><div class="wrap">
  <div class="shead"><div><span class="kicker">Services</span><h2>Departments and specialty care</h2><p>From emergency and trauma to primary care and cancer care.</p></div><a class="more" href="{{ PathBase }}/services">All services <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3">{% for d in feat_d.Items %}{% assign x = d.PublishedContent %}<a class="card dcard" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ d.PrimaryField }}</b><span>{{ x.tagline }}</span></span></a>{% endfor %}</div>
</div></section>
<section class="sec alt"><div class="wrap split">
  <div><div class="shead"><div><span class="kicker">Events</span><h2>Upcoming classes and screenings</h2></div><a class="more" href="{{ PathBase }}/events">All events <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="card">{% for e in feat_e.Items %}{% assign x = e.PublishedContent %}{% capture ek %}{{ x.kind }}{% endcapture %}{% for pair in eks %}{% assign kv = pair | split: ":" %}{% if kv[0] == ek %}{% assign el = kv[1] %}{% assign ei = kv[2] %}{% endif %}{% endfor %}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%Y" }}</small></div><span><span class="pill blue"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }} &middot; {{ x.place }}</p></span></a>{% endfor %}</div></div>
  <div><div class="shead"><div><span class="kicker">News</span><h2>From the health system</h2></div><a class="more" href="{{ PathBase }}/news">All news <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid" style="gap:14px">{% for a in feat_n.Items %}{% assign x = a.PublishedContent %}{% capture ck %}{{ x.category }}{% endcapture %}{% for pair in ncs %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}<a class="card ncard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img" style="background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd"><span class="pill {{ cc }}">{{ cl }}</span><h3>{{ a.PrimaryField }}</h3><p>{{ x.summary }}</p></div></a>{% endfor %}</div></div>
</div></section>
<section class="sec"><div class="wrap">
  <div class="shead"><div><span class="kicker">Locations</span><h2>Where to find us</h2><p>One hospital campus and clinics across Harlow Creek, Millhaven and Ashford Crossing.</p></div><a class="more" href="{{ PathBase }}/locations">All locations <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
  <div class="grid g3">{% for b in locs.Items %}{% assign x = b.PublishedContent %}{% capture bk %}{{ x.kind }}{% endcapture %}{% for pair in lks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<a class="card bcard" href="{{ PathBase }}/{{ b.RoutePath }}" style="overflow:hidden;text-decoration:none;color:var(--text)"><div class="img" style="aspect-ratio:1200/630;background-size:cover;background-position:center;background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd" style="padding:16px 18px"><span class="pill navy"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h3 style="margin:8px 0 4px;font-size:1.15rem">{{ b.PrimaryField }}</h3><p class="muted" style="margin:0;font-size:.92rem">{{ x.address }}, {{ x.town }}</p></div></a>{% endfor %}</div>
</div></section>
{{ render_section("main", wrap=false) }}
