    <div class="card pad"><dl class="facts"><div><dt>Category</dt><dd>{{ jl }}</dd></div><div><dt>Location</dt><dd>{{ p.location }}</dd></div><div><dt>Schedule</dt><dd>{{ p.schedule }}</dd></div><div><dt>Posted</dt><dd>{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></div></dl></div>
    <p class="disc">Fictional posting for a Raytha demo. Do not send real applications.</p>
    <p><a href="{{ PathBase }}/careers"><i class="bi bi-arrow-left" aria-hidden="true"></i> All jobs</a></p>
  </aside>
</div></div>
