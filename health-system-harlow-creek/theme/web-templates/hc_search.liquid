{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}
{%- assign q = QueryParams.q | strip | remove: "'" | remove: '"' | remove: "<" | remove: ">" | truncate: 60, "" -%}
<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Search</li></ol></nav><h1>{% if q != "" %}Search results for “{{ q }}”{% else %}Search{% endif %}</h1><p>Doctors, services, locations, news, events and patient resources.</p></div></div>
<div class="body"><div class="wrap">
<form class="fbar" action="{{ PathBase }}/search" role="search"><div class="grow"><label for="sq">Search for</label><input id="sq" name="q" value="{{ q }}" placeholder="Try cardiology, parking or flu"></div><button class="btn btn-p" type="submit">Search</button></form>
{%- if q != "" -%}
{%- capture f1 %}contains(name,'{{ q }}') or contains(bio,'{{ q }}') or contains(title,'{{ q }}'){% endcapture -%}
{%- capture f2 %}contains(name,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f3 %}contains(title,'{{ q }}') or contains(summary,'{{ q }}') or contains(body,'{{ q }}'){% endcapture -%}
{%- capture f4 %}contains(name,'{{ q }}') or contains(town,'{{ q }}') or contains(services,'{{ q }}'){% endcapture -%}
{%- assign rp = get_content_items(ContentType="providers", Filter=f1, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rd = get_content_items(ContentType="departments", Filter=f2, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rl = get_content_items(ContentType="locations", Filter=f4, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign rn = get_content_items(ContentType="news", Filter=f3, OrderBy="posted_on desc", PageSize=12) -%}
{%- assign re = get_content_items(ContentType="events", Filter=f3, OrderBy="starts_on asc", PageSize=12) -%}
{%- assign rr = get_content_items(ContentType="resources", Filter=f3, OrderBy="sort_order asc", PageSize=12) -%}
{%- assign total = rp.TotalCount | plus: rd.TotalCount | plus: rl.TotalCount | plus: rn.TotalCount | plus: re.TotalCount | plus: rr.TotalCount -%}
<p class="muted" role="status" style="margin:-6px 0 20px">{{ total }} result{% if total != 1 %}s{% endif %}</p>
<div class="grid g2">
{% if rp.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Providers</h2></div><div class="pad" style="padding-top:8px">{% for p in rp.Items %}{% assign x = p.PublishedContent %}{% capture sp %}{{ x.specialty }}{% endcapture %}{% for pair in sps %}{% assign kv = pair | split: ":" %}{% if kv[0] == sp %}{% assign sl = kv[1] %}{% assign si = kv[2] %}{% endif %}{% endfor %}<a class="card pcard" href="{{ PathBase }}/{{ p.RoutePath }}"><img src="{{ x.photo.Value | attachment_redirect_url }}" alt=""><span><b>{{ p.PrimaryField }}{% capture c %}{{ x.credentials | strip }}{% endcapture %}{% if c != "" %}, {{ x.credentials }}{% endif %}</b><span class="meta">{{ sl }}{% capture t %}{{ x.title | strip }}{% endcapture %}{% if t != "" %} &middot; {{ x.title }}{% endif %}</span><span class="flags">{% capture a %}{{ x.accepting | downcase }}{% endcapture %}{% if a == "true" %}<span class="pill green">Accepting patients</span>{% else %}<span class="pill">Not accepting new</span>{% endif %}{% capture th %}{{ x.telehealth | downcase }}{% endcapture %}{% if th == "true" %}<span class="pill blue">Telehealth</span>{% endif %}</span></span></a>{% endfor %}</div></div>{% endif %}
{% if rd.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Services</h2></div>{% for d in rd.Items %}{% assign x = d.PublishedContent %}<a class="card dcard" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{{ x.icon }}"></i></span><span><b>{{ d.PrimaryField }}</b><span>{{ x.tagline }}</span></span></a>{% endfor %}</div>{% endif %}
{% if rl.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Locations</h2></div><div class="pad">{% for b in rl.Items %}<a class="svc" href="{{ PathBase }}/{{ b.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-geo-alt"></i></span><span><b>{{ b.PrimaryField }}</b><small>{{ b.PublishedContent.address }}, {{ b.PublishedContent.town }}</small></span></a>{% endfor %}</div></div>{% endif %}
{% if rn.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">News</h2></div><div class="pad" style="padding-top:8px">{% for a in rn.Items %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span class="th" style="background-image:url('{{ a.PublishedContent.image.Value | attachment_redirect_url }}')"></span><span><b>{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d, %Y" }}</small></span></a>{% endfor %}</div></div>{% endif %}
{% if re.TotalCount > 0 %}<div class="card">{% for e in re.Items %}{% assign x = e.PublishedContent %}{% capture ek %}{{ x.kind }}{% endcapture %}{% for pair in eks %}{% assign kv = pair | split: ":" %}{% if kv[0] == ek %}{% assign el = kv[1] %}{% assign ei = kv[2] %}{% endif %}{% endfor %}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><div class="date"><span>{{ x.starts_on.Value | date: "%b" }}</span><b>{{ x.starts_on.Value | date: "%-d" }}</b><small>{{ x.starts_on.Value | date: "%Y" }}</small></div><span><span class="pill blue"><i class="bi bi-{{ ei }}" aria-hidden="true"></i> {{ el }}</span><h3>{{ e.PrimaryField }}</h3><p>{{ x.time }} &middot; {{ x.place }}</p></span></a>{% endfor %}</div>{% endif %}
{% if rr.TotalCount > 0 %}<div class="card"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Resources</h2></div>{% for r in rr.Items %}{% assign x = r.PublishedContent %}{% capture rk %}{{ x.kind }}{% endcapture %}{% capture so %}{{ x.staff_only | downcase }}{% endcapture %}{% for pair in rks %}{% assign kv = pair | split: ":" %}{% if kv[0] == rk %}{% assign rl = kv[1] %}{% assign ri = kv[2] %}{% endif %}{% endfor %}<a class="svc" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if so == "true" %}lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if so == "true" %} <span class="pill gold" style="margin-left:6px">Staff</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endfor %}</div>{% endif %}
</div>
{% if total == 0 %}<div class="card pad" style="padding:34px;text-align:center"><h2>Nothing matched “{{ q }}”</h2><p class="muted">Try a shorter word, or call (555) 018-1000.</p></div>{% endif %}
{%- else -%}
<h2 style="font-size:1.2rem;margin-bottom:12px">Popular searches</h2><div class="chips">{% assign sug = "cardiology,emergency,parking,flu,primary care,birth" | split: "," %}{% for s in sug %}<a href="{{ PathBase }}/search?q={{ s | url_encode }}">{{ s }}</a>{% endfor %}</div>
{%- endif -%}
</div></div>
