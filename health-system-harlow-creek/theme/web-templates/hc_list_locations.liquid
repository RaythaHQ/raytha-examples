{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Locations</li></ol></nav><h1>Locations</h1><p>Our hospital campus, urgent care, primary care clinic and specialty centers across the valley.</p></div></div>
<div class="body"><div class="wrap">
{%- assign qk = QueryParams.kind | default: "" -%}
<nav class="chips" aria-label="Filter by kind"><a href="{{ PathBase }}/locations"{% if qk == "" %} aria-current="true"{% endif %}>All</a>{% for pair in lks %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/locations?kind={{ kv[0] }}"{% if qk == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="grid g3">{% for b in Target.Items %}{% capture bk %}{{ b.PublishedContent.kind }}{% endcapture %}{% if qk == "" or qk == bk %}{% assign x = b.PublishedContent %}{% capture bk %}{{ x.kind }}{% endcapture %}{% for pair in lks %}{% assign kv = pair | split: ":" %}{% if kv[0] == bk %}{% assign bl = kv[1] %}{% assign bi = kv[2] %}{% endif %}{% endfor %}<a class="card bcard" href="{{ PathBase }}/{{ b.RoutePath }}" style="overflow:hidden;text-decoration:none;color:var(--text)"><div class="img" style="aspect-ratio:1200/630;background-size:cover;background-position:center;background-image:url('{{ x.image.Value | attachment_redirect_url }}')"></div><div class="bd" style="padding:16px 18px"><span class="pill navy"><i class="bi bi-{{ bi }}" aria-hidden="true"></i> {{ bl }}</span><h3 style="margin:8px 0 4px;font-size:1.15rem">{{ b.PrimaryField }}</h3><p class="muted" style="margin:0;font-size:.92rem">{{ x.address }}, {{ x.town }}</p></div></a>{% endif %}{% endfor %}</div>
</div></div>
