{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture ck %}{{ p.category }}{% endcapture %}{% for pair in dcs %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign ci = kv[2] %}{% endif %}{% endfor %}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/services">Services</a></li><li><a href="{{ PathBase }}/services?category={{ ck }}">{{ cl }}</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill blue" style="margin-bottom:10px"><i class="bi bi-{{ p.icon }}" aria-hidden="true"></i> {{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <div class="grid" style="gap:22px"><article class="card pad prose" style="padding:32px">{{ p.body }}</article></div>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    <div class="card pad"><h2 style="font-size:1.15rem;margin-bottom:10px">At a glance</h2><ul class="ticks" style="font-size:.95rem">{% assign hs = p.highlights | newline_to_br | split: "<br />" %}{% for h in hs %}{% assign t = h | strip %}{% if t != "" %}<li>{{ t }}</li>{% endif %}{% endfor %}</ul></div>
    <div class="card pad"><dl class="facts">{% capture c_p_phone %}{{ p.phone | strip }}{% endcapture %}{% if c_p_phone != "" %}<div><dt>Phone</dt><dd><a href="tel:{{ p.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ p.phone }}</a></dd></div>{% endif %}{% if p.location %}<div><dt>Location</dt><dd><a href="{{ PathBase }}/{{ p.location.RoutePath }}">{{ p.location.PrimaryField }}</a></dd></div>{% endif %}</dl></div>
    <div class="cta"><h2 style="font-size:1.15rem">Talk to a clinician</h2><p style="margin:8px 0 14px;font-size:.95rem">Browse providers in related specialties.</p><a class="btn btn-g" href="{{ PathBase }}/providers">Find a doctor</a></div>
  </aside>
</div></div>
