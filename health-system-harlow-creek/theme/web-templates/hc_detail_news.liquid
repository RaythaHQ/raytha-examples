{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture ck %}{{ p.category }}{% endcapture %}{% for pair in ncs %}{% assign kv = pair | split: ":" %}{% if kv[0] == ck %}{% assign cl = kv[1] %}{% assign cc = kv[2] %}{% endif %}{% endfor %}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/news">News</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="pill {{ cc }}" style="margin-bottom:10px">{{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
  <article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:16px;aspect-ratio:1200/630;object-fit:cover;margin-bottom:22px">
    <div class="card pad prose" style="padding:32px"><p class="muted" style="font-size:.92rem">By {{ p.author }} &middot; {{ p.posted_on.Value | date: "%A, %B %-d, %Y" }}</p>{{ p.body }}</div></article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px">
    {%- assign more = get_content_items(ContentType="news", OrderBy="posted_on desc", PageSize=5) -%}
    <div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">More news</h2>{% for a in more.Items %}{% if a.Id != Target.Id %}<a class="nli" href="{{ PathBase }}/{{ a.RoutePath }}"><span><b style="font-size:.95rem">{{ a.PrimaryField }}</b><small>{{ a.PublishedContent.posted_on.Value | date: "%B %-d" }}</small></span></a>{% endif %}{% endfor %}</div>
  </aside>
</div></div>
