{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{% capture rk %}{{ p.kind }}{% endcapture %}{% capture so %}{{ p.staff_only | downcase }}{% endcapture %}{% for pair in rks %}{% assign kv = pair | split: ":" %}{% if kv[0] == rk %}{% assign rl = kv[1] %}{% assign ri = kv[2] %}{% endif %}{% endfor %}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/resources">Patient and visitor info</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><div style="display:flex;gap:8px;margin-bottom:10px"><span class="pill blue"><i class="bi bi-{{ ri }}" aria-hidden="true"></i> {{ rl }}</span>{% if so == "true" %}<span class="pill gold"><i class="bi bi-lock" aria-hidden="true"></i> Staff only</span>{% endif %}</div><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap">{% if so == "true" and is_staff == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This resource is for staff.</h2><p style="max-width:600px">Sign in to the staff portal of this website to see clinical policy digests, onboarding checklists and other clinician resources. This is a website account for staff, not the electronic health record.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the staff portal</a><a class="btn btn-w" href="{{ PathBase }}/contact">Contact us</a></div></div>{% else %}<div class="art">
  <article class="card pad prose" style="padding:32px">{{ p.body }}{% if p.file %}<p style="margin-top:20px"><a class="btn btn-p" style="text-decoration:none" href="{{ p.file.Value | attachment_redirect_url }}"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download the PDF</a></p>{% endif %}</article>
  <aside class="grid" style="gap:20px;position:sticky;top:100px"><div class="card pad"><dl class="facts"><div><dt>Kind</dt><dd>{{ rl }}</dd></div><div><dt>Posted</dt><dd>{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></div><div><dt>Access</dt><dd>{% if so == "true" %}Staff{% else %}Public{% endif %}</dd></div></dl></div>
  <p><a href="{{ PathBase }}/{% if so == "true" %}staff{% else %}resources{% endif %}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</a></p></aside></div>{% endif %}
</div></div>
