{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Careers</li></ol></nav><h1>Careers</h1><p>Open positions across nursing, clinical support, physicians, administration, IT and facilities. Every posting here is fictional.</p></div></div>
<div class="body"><div class="wrap">
{%- assign qc = QueryParams.category | default: "" -%}
<nav class="chips" aria-label="Filter by category"><a href="{{ PathBase }}/careers"{% if qc == "" %} aria-current="true"{% endif %}>All jobs</a>{% for pair in jbs %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/careers?category={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}><i class="bi bi-{{ kv[2] }}" aria-hidden="true"></i> {{ kv[1] }}</a>{% endfor %}</nav>
<div class="card">{% for j in Target.Items %}{% capture jc %}{{ j.PublishedContent.category }}{% endcapture %}{% if qc == "" or qc == jc %}{% assign x = j.PublishedContent %}{% capture jc %}{{ x.category }}{% endcapture %}{% for pair in jbs %}{% assign kv = pair | split: ":" %}{% if kv[0] == jc %}{% assign jl = kv[1] %}{% assign ji = kv[2] %}{% endif %}{% endfor %}<a class="job" href="{{ PathBase }}/{{ j.RoutePath }}"><span class="pill blue"><i class="bi bi-{{ ji }}" aria-hidden="true"></i> {{ jl }}</span><b style="margin-top:6px">{{ j.PrimaryField }}</b><div class="meta">{{ x.location }} &middot; {{ x.schedule }}</div></a>{% endif %}{% endfor %}</div>
<p class="disc" style="margin-top:22px">These job postings are fictional. Do not send real applications or personal information.</p>
</div></div>
