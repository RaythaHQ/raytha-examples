{%- assign lks = "hospital:Hospital:hospital,urgent:Urgent care:lightning-charge,clinic:Clinic:building,specialty:Specialty center:heart-pulse" | split: "," -%}{%- assign dcs = "emergency:Emergency and trauma:ambulance,heart:Heart and vascular:heart-pulse,cancer:Cancer care:bandaid,orthopedics:Orthopedics:activity,womens:Women's health:gender-female,pediatrics:Pediatrics:emoji-smile,primary:Primary care:person-heart,imaging:Imaging and labs:radioactive,surgery:Surgery:scissors,behavioral:Behavioral health:chat-heart" | split: "," -%}{%- assign sps = "family:Family medicine:person-heart,internal:Internal medicine:clipboard2-pulse,cardiology:Cardiology:heart-pulse,oncology:Oncology:bandaid,orthopedics:Orthopedic surgery:activity,obgyn:Obstetrics and gynecology:gender-female,pediatrics:Pediatrics:emoji-smile,emergency:Emergency medicine:ambulance,radiology:Radiology:radioactive,psychiatry:Psychiatry:chat-heart,surgery:General surgery:scissors" | split: "," -%}{%- assign ncs = "community:Community:green,clinical:Clinical programs:blue,research:Research and quality:navy,people:People:gold,notice:Notices:blue" | split: "," -%}{%- assign eks = "class:Health class:mortarboard,support:Support group:people,screening:Screening event:heart,community:Community event:calendar-event" | split: "," -%}{%- assign jbs = "nursing:Nursing:heart-pulse,clinical:Clinical support:bandaid,physicians:Physicians and APPs:person-badge,admin:Administrative:briefcase,it:Information technology:pc-display,facilities:Facilities and support:building" | split: "," -%}{%- assign rks = "visitor:Visitor information:people,patient:Patient guide:journal-medical,billing:Billing and insurance:receipt,prep:Preparing for your visit:clipboard-check,staff:Staff resource:shield-lock" | split: "," -%}{%- assign is_staff = false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "staff" -%}{%- assign is_staff = true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_staff = true -%}{%- endif -%}<div class="phead"><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Staff portal</li></ol></nav><span class="pill gold" style="margin-bottom:10px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Staff only</span><h1>Staff portal</h1><p>Clinical policy digests, onboarding checklists and clinician quick references.</p></div></div>
<div class="body"><div class="wrap">{% if is_staff == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>The staff portal is for staff.</h2><p style="max-width:600px">Sign in to the staff portal of this website to see clinical policy digests, onboarding checklists and other clinician resources. This is a website account for staff, not the electronic health record.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-g" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the staff portal</a><a class="btn btn-w" href="{{ PathBase }}/contact">Contact us</a></div></div>{% else %}
{% if CurrentUser.FirstName != blank %}<div class="member" style="margin-bottom:22px"><i class="bi bi-person-check" style="font-size:1.4rem;color:#8a4a1c" aria-hidden="true"></i><p style="margin:0;font-size:.95rem">Signed in as {{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}. These resources are for staff of this fictional health system.</p></div>{% endif %}
{{ render_section("main", wrap=false) }}
{%- assign sr = get_content_items(ContentType="resources", Filter="staff_only eq 'true'", OrderBy="sort_order asc", PageSize=20) -%}
<div class="card" style="margin-top:22px"><div class="pad" style="padding-bottom:4px"><h2 style="font-size:1.3rem">Staff resources</h2></div>{% for r in sr.Items %}{% assign x = r.PublishedContent %}{% capture rk %}{{ x.kind }}{% endcapture %}{% capture so %}{{ x.staff_only | downcase }}{% endcapture %}{% for pair in rks %}{% assign kv = pair | split: ":" %}{% if kv[0] == rk %}{% assign rl = kv[1] %}{% assign ri = kv[2] %}{% endif %}{% endfor %}<a class="svc" href="{{ PathBase }}/{{ r.RoutePath }}"><span class="ic" aria-hidden="true"><i class="bi bi-{% if so == "true" %}lock{% else %}{{ ri }}{% endif %}"></i></span><span><b>{{ r.PrimaryField }}{% if so == "true" %} <span class="pill gold" style="margin-left:6px">Staff</span>{% endif %}</b><small>{{ x.summary }}</small></span></a>{% endfor %}</div>
{% endif %}</div></div>
