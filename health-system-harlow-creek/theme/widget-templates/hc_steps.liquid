<section class="sec"{% if widget.settings.anchor != blank %} id="{{ widget.settings.anchor }}"{% endif %}><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2><p>{{ widget.settings.intro }}</p></div></div><div class="grid g3">{% for it in widget.settings.items %}<div class="card pad"><h3>{{ it.title }}</h3><p class="muted" style="margin:8px 0 0">{{ it.text }}</p></div>{% endfor %}</div></div></section>
