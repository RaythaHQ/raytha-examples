<section class="sec"{% if Target.Settings.anchor != blank %} id="{{ Target.Settings.anchor }}"{% endif %}><div class="wrap"><div class="shead"><div><span class="kicker">{{ Target.Settings.kicker }}</span><h2>{{ Target.Settings.headline }}</h2><p>{{ Target.Settings.intro }}</p></div></div><div class="grid g3">{% for it in Target.Settings.items %}<div class="card pad"><h3>{{ it.title }}</h3><p class="muted" style="margin:8px 0 0">{{ it.text }}</p></div>{% endfor %}</div></div></section>
