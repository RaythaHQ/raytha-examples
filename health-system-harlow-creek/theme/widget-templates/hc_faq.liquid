<section class="sec alt"><div class="wrap" style="max-width:900px"><h2 style="margin-bottom:18px">{{ widget.settings.headline }}</h2>{% for it in widget.settings.items %}<details class="card" style="padding:14px 18px;margin-bottom:10px"><summary style="font-weight:700;cursor:pointer">{{ it.q }}</summary><p style="margin:10px 0 4px;color:var(--muted)">{{ it.a }}</p></details>{% endfor %}</div></section>
