{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/stories">Stories</a></li><li>{{ x.date_label }}</li></ol><div class="g"><div><p class="kick">{% capture lv30 -%}{{ x.kind }}{%- endcapture %}{% case lv30 %}{% when "classroom" %}Classroom{% when "arts" %}Arts{% when "athletics" %}Athletics{% when "houses" %}Houses{% when "alumni" %}Alumni{% else %}{{ lv30 }}{% endcase %} · {{ x.date_label }}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" style="border:1px solid var(--rule);margin-bottom:28px"><div class="prose">{{ x.body }}</div><p class="pull">“{{ x.pull }}”</p><p class="muted">{{ x.author }}</p></div><aside class="card fr side"><p class="kick">More stories</p>{%- assign more = get_content_items(ContentType="stories", OrderBy="sort_order asc", PageSize=6) -%}<ul class="hall">{% for s in more.Items %}{% if s.RoutePath != Target.RoutePath %}<li><a href="{{ PathBase }}/{{ s.RoutePath }}">{{ s.PrimaryField }}</a></li>{% endif %}{% endfor %}</ul></aside></div></div></section>
