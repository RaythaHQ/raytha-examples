{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Calendar</li></ol><div class="g"><span class="num">VII</span><div><p class="kick">Calendar · 2026–27</p><h1>The term calendar</h1></div></div><p class="lede">Open mornings, concerts, fixtures and holidays are public. Conference times and faculty days are for signed-in families and faculty.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin:36px 0 6px;font-size:1.5rem">Fall term</h2><div class="cal">{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture et -%}{{ y.term }}{%- endcapture -%}{% if et == "fall" %}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% else %}<div class="ev"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3 class="lockt">{{ e.PrimaryField }}</h3><small>{% if au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag fam">🔒 Families</span>{% endif %} sign in for details</small></span></div>{% endif %}{% endif %}{% endfor %}</div><h2 style="margin:36px 0 6px;font-size:1.5rem">Winter term</h2><div class="cal">{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture et -%}{{ y.term }}{%- endcapture -%}{% if et == "winter" %}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% else %}<div class="ev"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3 class="lockt">{{ e.PrimaryField }}</h3><small>{% if au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag fam">🔒 Families</span>{% endif %} sign in for details</small></span></div>{% endif %}{% endif %}{% endfor %}</div><h2 style="margin:36px 0 6px;font-size:1.5rem">Spring term</h2><div class="cal">{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture et -%}{{ y.term }}{%- endcapture -%}{% if et == "spring" %}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}{% if ok %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% else %}<div class="ev"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3 class="lockt">{{ e.PrimaryField }}</h3><small>{% if au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag fam">🔒 Families</span>{% endif %} sign in for details</small></span></div>{% endif %}{% endif %}{% endfor %}</div></div></section>
