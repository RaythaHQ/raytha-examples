<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Athletics &amp; arts</li></ol><div class="g"><span class="num">V</span><div><p class="kick">Athletics, arts, clubs and the outdoors</p><h1>Something every season</h1></div></div><p class="lede">From Grade 6 every student joins a team, an ensemble, a club or the outdoor program each season.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{%- assign prs = get_content_items(ContentType="programs", OrderBy="sort_order asc", PageSize=50) -%}<div class="seasons"><div class="season"><h3>Fall</h3><ul>{% for p in prs.Items %}{%- assign y=p.PublishedContent -%}{%- capture ps -%}{{ y.season }}{%- endcapture -%}{% if ps == "fall" %}<li><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv16 -%}{{ y.kind }}{%- endcapture %}{% case lv16 %}{% when "sport" %}Athletics{% when "arts" %}Arts{% when "club" %}Club{% when "outdoor" %}Outdoors{% else %}{{ lv16 }}{% endcase %} · {% capture lv17 -%}{{ y.division }}{%- endcapture %}{% case lv17 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv17 }}{% endcase %} · {{ y.meets }}</small></li>{% endif %}{% endfor %}</ul></div><div class="season"><h3>Winter</h3><ul>{% for p in prs.Items %}{%- assign y=p.PublishedContent -%}{%- capture ps -%}{{ y.season }}{%- endcapture -%}{% if ps == "winter" %}<li><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv18 -%}{{ y.kind }}{%- endcapture %}{% case lv18 %}{% when "sport" %}Athletics{% when "arts" %}Arts{% when "club" %}Club{% when "outdoor" %}Outdoors{% else %}{{ lv18 }}{% endcase %} · {% capture lv19 -%}{{ y.division }}{%- endcapture %}{% case lv19 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv19 }}{% endcase %} · {{ y.meets }}</small></li>{% endif %}{% endfor %}</ul></div><div class="season"><h3>Spring &amp; year-round</h3><ul>{% for p in prs.Items %}{%- assign y=p.PublishedContent -%}{%- capture ps -%}{{ y.season }}{%- endcapture -%}{% if ps == "spring" or ps == "year" %}<li><a href="{{ PathBase }}/{{ p.RoutePath }}">{{ p.PrimaryField }}</a><small>{% capture lv20 -%}{{ y.kind }}{%- endcapture %}{% case lv20 %}{% when "sport" %}Athletics{% when "arts" %}Arts{% when "club" %}Club{% when "outdoor" %}Outdoors{% else %}{{ lv20 }}{% endcase %} · {% capture lv21 -%}{{ y.division }}{%- endcapture %}{% case lv21 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv21 }}{% endcase %} · {{ y.meets }}</small></li>{% endif %}{% endfor %}</ul></div></div></div></section>
