{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/faculty">Faculty</a></li><li>{{ Target.PrimaryField }}</li></ol><div class="g"><div><p class="kick">{{ x.role }}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><aside class="card fr side"><img src="{{ x.portrait.Value | attachment_redirect_url }}" alt="Generated monogram portrait" style="margin-bottom:16px;border:1px solid var(--rule)"><dl class="kv"><dt>Department</dt><dd>{% capture lv14 -%}{{ x.department }}{%- endcapture %}{% case lv14 %}{% when "english" %}English{% when "math" %}Mathematics{% when "science" %}Science{% when "history" %}History{% when "languages" %}World languages{% when "arts" %}Arts{% when "cs" %}Computer science{% when "wellness" %}Wellness{% when "leadership" %}Leadership{% when "admissions" %}Admissions{% else %}{{ lv14 }}{% endcase %}</dd><dt>Division</dt><dd>{% capture lv15 -%}{{ x.division }}{%- endcapture %}{% case lv15 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv15 }}{% endcase %}</dd><dt>Degrees</dt><dd>{{ x.degrees }}</dd><dt>Since</dt><dd>{{ x.since }}</dd><dt>House</dt><dd>{{ x.house }}</dd></dl></aside></div></div></section>
