{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/calendar">Calendar</a></li><li>{{ x.date_label }}</li></ol><div class="g"><div><p class="kick">{% capture lv26 -%}{{ x.term }}{%- endcapture %}{% case lv26 %}{% when "fall" %}Fall term{% when "winter" %}Winter term{% when "spring" %}Spring term{% else %}{{ lv26 }}{% endcase %} · {% capture lv27 -%}{{ x.kind }}{%- endcapture %}{% case lv27 %}{% when "admissions" %}Admissions{% when "arts" %}Arts{% when "athletics" %}Athletics{% when "community" %}Community{% when "academic" %}Academic{% when "faculty" %}Faculty{% else %}{{ lv27 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.date_label }} · {{ x.time_label }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="card fr side"><dl class="kv"><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Time</dt><dd>{{ x.time_label }}</dd><dt>Place</dt><dd>{{ x.place }}</dd><dt>For</dt><dd>{% capture lv28 -%}{{ x.audience }}{%- endcapture %}{% case lv28 %}{% when "public" %}Everyone{% when "families" %}Families{% when "faculty" %}Faculty{% else %}{{ lv28 }}{% endcase %}</dd></dl></aside></div>{% else %}{% if au == "faculty" %}<div class="lockp"><p class="kick">🔒 Faculty only</p><h2>Signed-in faculty see this date.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Families</p><h2>Sign in with a family account to see this date.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div>{% endif %}{% endif %}</div></section>
