{%- assign x=Target.PublishedContent -%}{%- capture dc -%}{{ x.color }}{%- endcapture -%}{%- capture dcode -%}{{ x.code }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/divisions">Divisions</a></li><li>{{ Target.PrimaryField }}</li></ol><div class="g"><div><p class="kick">{{ x.grades }} · ages {{ x.ages }}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.tagline }}</p></div></div>
<section class="sec tight"><div class="w"><div class="dg"><div><img src="{{ x.art.Value | attachment_redirect_url }}" alt="" style="border:1px solid var(--rule);margin-bottom:28px"><div class="prose">{{ x.body }}</div>
<h2 style="margin:36px 0 16px;font-size:1.6rem">A day in the {{ Target.PrimaryField }}</h2><div style="--c:{{ dc }}">{%- assign dl = x.day | split: "|" -%}<ol class="daytl">{% for s in dl %}{%- assign sp = s | split: "~" -%}<li><span>{{ sp[0] }}</span>{{ sp[1] }}</li>{% endfor %}</ol></div></div>
<aside class="card fr side" style="border-top:4px solid {{ dc }}"><dl class="kv"><dt>Grades</dt><dd>{{ x.grades }}</dd><dt>Students</dt><dd>{{ x.students }}</dd><dt>Avg. class</dt><dd>{{ x.class_size }}</dd><dt>Head</dt><dd>{{ x.head }}</dd></dl><p class="kick" style="margin:22px 0 10px">Hallmarks</p>{%- assign hl = x.hallmarks | split: "|" -%}<ul class="hall">{% for h in hl %}<li>{{ h }}</li>{% endfor %}</ul></aside></div></div></section>
{%- assign dcs = get_content_items(ContentType="courses", OrderBy="sort_order asc", PageSize=100) -%}<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2>Courses in the {{ Target.PrimaryField }}</h2><ul class="rows">{% for c in dcs.Items %}{%- assign y=c.PublishedContent -%}{%- capture cdv -%}{{ y.division }}{%- endcapture -%}{% if cdv == dcode %}<li><span class="k">{{ y.code }}</span><span><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a><small>{{ y.summary }}</small></span><span class="tag">{% capture lv9 -%}{{ y.department }}{%- endcapture %}{% case lv9 %}{% when "english" %}English{% when "math" %}Mathematics{% when "science" %}Science{% when "history" %}History{% when "languages" %}World languages{% when "arts" %}Arts{% when "cs" %}Computer science{% when "wellness" %}Wellness{% when "leadership" %}Leadership{% when "admissions" %}Admissions{% else %}{{ lv9 }}{% endcase %}</span></li>{% endif %}{% endfor %}</ul></div></section>
