{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Common room</li></ol><div class="g"><div><p class="kick">Faculty common room · faculty only</p><h1>Common room</h1></div></div><p class="lede">{% if in_fac %}Duties, minutes and grading deadlines. Names are fictional.{% else %}Duties, minutes and deadlines for signed-in faculty.{% endif %}</p></div></div>
{% if in_fac %}{%- assign cl = get_content_items(ContentType="letters", Filter="audience eq 'faculty'", OrderBy="sort_order asc", PageSize=20) -%}{%- assign ce = get_content_items(ContentType="events", Filter="audience eq 'faculty'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,400px) minmax(0,1fr)"><div><div class="fcard fac"><div class="t">TARRENHURST SCHOOL · COMMON ROOM</div><div class="who">{{ CurrentUser.FirstName }} {{ CurrentUser.LastName }}</div><div class="bc">FACULTY · DEMO ACCOUNT<br>DUTIES AND MINUTES BELOW ARE FICTIONAL</div></div></div><div><h2 style="margin-bottom:12px">Faculty dates</h2><div class="cal" style="grid-template-columns:1fr">{% for e in ce.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:14px">Rotas, minutes and deadlines</h2><ul class="rows">{% for r in cl.Items %}{%- assign y=r.PublishedContent -%}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></span><span><span class="tag fac">Faculty</span></span></li>{% endfor %}</ul></div></section>
{% else %}<section class="sec tight" style="padding-bottom:70px"><div class="w">{% if in_fam %}<div class="lockp"><p class="kick">🔒 Faculty only</p><h2>You are signed in with a family account.</h2><p class="muted">The common room is only for faculty. Your letters and dates are in the <a href="{{ PathBase }}/families">families portal</a>.</p></div>{% else %}<div class="lockp"><p class="kick">🔒 Faculty only</p><h2>Faculty sign in to see the common room.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/common-room">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div>{% endif %}</div></section>{% endif %}
