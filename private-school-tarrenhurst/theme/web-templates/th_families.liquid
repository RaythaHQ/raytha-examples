{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign sd = doy | times: 5 | divided_by: 7 | floor -%}{%- assign ri = sd | modulo: 6 -%}{%- assign rls = "A,B,C,D,E,F" | split: "," -%}{%- assign rl = rls[ri] -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign wkend = false -%}{%- if tdow == "sat" or tdow == "sun" -%}{%- assign wkend = true -%}{%- endif -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{% case rl %}{% when "A" %}{%- assign tb = "A|B|C|D|E" -%}{% when "B" %}{%- assign tb = "F|G|A|B|C" -%}{% when "C" %}{%- assign tb = "D|E|F|G|A" -%}{% when "D" %}{%- assign tb = "B|C|D|E|F" -%}{% when "E" %}{%- assign tb = "G|A|B|C|D" -%}{% when "F" %}{%- assign tb = "E|F|G|A|B" -%}{% endcase %}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Families</li></ol><div class="g"><div><p class="kick">Families portal · families only</p><h1>{% if in_fam %}Welcome back, {{ CurrentUser.FirstName }}.{% else %}Families portal{% endif %}</h1></div></div><p class="lede">{% if in_fam %}Letters home, the handbook, rotas and conference times. Demo account: names and dates are fictional.{% else %}Letters home, the handbook, rotas and conference times, for signed-in families.{% endif %}</p></div></div>
{% if in_fam %}{%- assign fl = get_content_items(ContentType="letters", OrderBy="sort_order asc", PageSize=40) -%}{%- assign fe = get_content_items(ContentType="events", Filter="audience eq 'families'", OrderBy="sort_order asc", PageSize=10) -%}
<section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,400px) minmax(0,1fr)"><div><div class="fcard"><div class="t">TARRENHURST SCHOOL · FAMILY CARD</div><div class="who">The {{ CurrentUser.LastName }} family</div><div class="bc">SIGNED IN AS {{ CurrentUser.FirstName | upcase }} · DEMO ACCOUNT<br>ADVISOR: DANIEL ACHEBE-ROSS · HOUSE: MERROW</div></div><p class="muted" style="margin-top:16px;font-size:.92rem">{% if wkend %}No classes today.{% else %}Today is Day {{ rl }} of the rotation.{% endif %} <a href="{{ PathBase }}/rotation">The rotation →</a></p></div>
<div><h2 style="margin-bottom:12px">Family dates</h2><div class="cal" style="grid-template-columns:1fr">{% for e in fe.Items %}{%- assign y=e.PublishedContent -%}<a class="ev" href="{{ PathBase }}/{{ e.RoutePath }}"><span class="dt"><span>{{ y.month }}</span><b>{{ y.day_num }}</b></span><span><h3>{{ e.PrimaryField }}</h3><small>{{ y.date_label }} · {{ y.time_label }} · {{ y.place }}</small></span></a>{% endfor %}</div></div></div></div></section>
{{ render_section("main", wrap=false) }}
<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2 style="margin-bottom:14px">Letters and documents</h2><ul class="rows">{% for r in fl.Items %}{%- assign y=r.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{% if au != "faculty" %}<li><span class="k">{{ y.date_label }}</span><span><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small></span><span>{% if au == "families" %}<span class="tag fam">🔒 Families</span>{% elsif au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag">Public</span>{% endif %}</span></li>{% endif %}{% endfor %}</ul></div></section>
{% else %}<section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="lockp"><p class="kick">🔒 Families</p><h2>Sign in to see letters home, rotas and conference times.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/families">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div></div></section>{% endif %}
