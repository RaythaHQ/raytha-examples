{%- assign fd = QueryParams.dept | strip | downcase -%}{%- assign fv = QueryParams.div | strip | downcase -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Course of studies</li></ol><div class="g"><span class="num">III</span><div><p class="kick">Course of studies · 2026–27</p><h1>Eight departments, taught <em>around the table</em></h1></div></div><p class="lede">Every course lists its grades, rotation block, credits and prerequisites. Filter by department or division; the filtering happens on the server.</p><div class="filters"><a href="?dept=&amp;div={{ fv }}" class="{% if fd == "" %}on{% endif %}">All departments</a><a href="?dept=english&amp;div={{ fv }}" class="{% if fd == "english" %}on{% endif %}">English</a><a href="?dept=math&amp;div={{ fv }}" class="{% if fd == "math" %}on{% endif %}">Mathematics</a><a href="?dept=science&amp;div={{ fv }}" class="{% if fd == "science" %}on{% endif %}">Science</a><a href="?dept=history&amp;div={{ fv }}" class="{% if fd == "history" %}on{% endif %}">History</a><a href="?dept=languages&amp;div={{ fv }}" class="{% if fd == "languages" %}on{% endif %}">World languages</a><a href="?dept=arts&amp;div={{ fv }}" class="{% if fd == "arts" %}on{% endif %}">Arts</a><a href="?dept=cs&amp;div={{ fv }}" class="{% if fd == "cs" %}on{% endif %}">Computer science</a><a href="?dept=wellness&amp;div={{ fv }}" class="{% if fd == "wellness" %}on{% endif %}">Wellness</a></div><div class="filters"><a href="?dept={{ fd }}&amp;div=" class="{% if fv == "" %}on{% endif %}">All divisions</a><a href="?dept={{ fd }}&amp;div=lower" class="{% if fv == "lower" %}on{% endif %}">Lower</a><a href="?dept={{ fd }}&amp;div=middle" class="{% if fv == "middle" %}on{% endif %}">Middle</a><a href="?dept={{ fd }}&amp;div=upper" class="{% if fv == "upper" %}on{% endif %}">Upper</a></div></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="tscroll"><table class="catalog"><thead><tr><th>Code</th><th>Course</th><th>Level</th><th>Grades</th><th>Block</th><th>Teacher</th></tr></thead><tbody>{%- assign shown=0 -%}{% for c in Target.Items %}{%- assign y=c.PublishedContent -%}{%- capture cd -%}{{ y.department }}{%- endcapture -%}{%- capture cv -%}{{ y.division }}{%- endcapture -%}{%- capture cl -%}{{ y.level }}{%- endcapture -%}{%- capture cb -%}{{ y.block }}{%- endcapture -%}{% if fd == "" or fd == cd %}{% if fv == "" or fv == cv %}{%- assign shown = shown | plus: 1 -%}<tr><td class="c">{{ y.code }}</td><td><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a><small>{{ y.summary | truncate: 110 }}</small></td><td>{% if cl == "signature" %}<span class="tag sig">Signature</span>{% else %}<span class="tag">{% capture lv10 -%}{{ y.level }}{%- endcapture %}{% case lv10 %}{% when "core" %}Core{% when "elective" %}Elective{% when "honors" %}Honors{% when "signature" %}Signature course{% else %}{{ lv10 }}{% endcase %}</span>{% endif %}</td><td>{{ y.grades }}</td><td>{% if cb.size == 1 %}<span class="bk" style="--c:{% case cb %}{% when "A" %}#7a2232{% when "B" %}#3f6177{% when "C" %}#a8812f{% when "D" %}#5f7a5a{% when "E" %}#5b3f6e{% when "F" %}#2f4a6b{% when "G" %}#8a5a3c{% endcase %}">{{ cb }}</span>{% else %}—{% endif %}</td><td>{{ y.teacher }}</td></tr>{% endif %}{% endif %}{% endfor %}</tbody></table></div>{% if shown == 0 %}<p class="muted">No courses match. <a href="{{ PathBase }}/courses">Show all</a>.</p>{% endif %}</div></section>
