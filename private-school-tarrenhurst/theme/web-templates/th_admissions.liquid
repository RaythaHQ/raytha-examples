<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Admissions</li></ol><div class="g"><span class="num">VI</span><div><p class="kick">Admissions · fall 2027</p><h1>Visit in the fall, apply by <em>January 15</em></h1></div></div><p class="lede">Every step is arranged with the admissions office by phone or email: (555) 014-1891 · admissions@tarrenhurst.example. There is no application, inquiry or payment form on this site.</p></div></div>{{ render_section("main", wrap=false) }}
