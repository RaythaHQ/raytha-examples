{%- assign x=Target.PublishedContent -%}{%- capture hc -%}{{ x.color }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/houses">Houses</a></li><li>{{ Target.PrimaryField }}</li></ol><div class="g"><div><p class="kick">House · {{ x.points }} points this year</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede"><i>{{ x.motto }}</i>: {{ x.motto_en }}. Named for {{ x.named_for }}.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><div class="prose">{{ x.body }}</div><h2 style="margin:34px 0 14px;font-size:1.5rem">This year's ledger</h2><table class="sched"><thead><tr><th>Event</th><th style="text-align:right">Points</th></tr></thead><tbody>{%- assign lg = x.ledger | split: "|" -%}{% for r in lg %}{%- assign rp = r | split: "~" -%}<tr><td>{{ rp[0] }}</td><td style="text-align:right;font-family:'Spline Sans Mono',monospace">{{ rp[1] }}</td></tr>{% endfor %}<tr><td><b>Total</b></td><td style="text-align:right;font:500 1.3rem 'Fraunces',serif;color:{{ hc }}">{{ x.points }}</td></tr></tbody></table></div>
<aside class="card fr side"><img src="{{ x.banner.Value | attachment_redirect_url }}" alt="{{ Target.PrimaryField }} banner (generated)" style="max-width:220px;margin:0 auto 16px"><dl class="kv"><dt>Captains</dt><dd>{{ x.captains }}</dd><dt>Named for</dt><dd>{{ x.named_for }}</dd></dl></aside></div></div></section>
