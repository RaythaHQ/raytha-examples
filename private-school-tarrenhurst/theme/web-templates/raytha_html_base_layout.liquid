<nav aria-label="Main"><ul>{%- assign menu = get_main_menu() -%}{% for mi in menu.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></nav></header>
<main id="main">{% renderbody %}</main>
<footer class="foot"><div class="w"><div class="fg"><div><div style="display:flex;gap:14px;align-items:center"><svg width="54" height="62" viewBox="0 0 54 62" aria-hidden="true"><path d="M3 3h48v28c0 15-11 24-24 28C14 55 3 46 3 31z" fill="#7a2232"/><path d="M7 7h40v24c0 12-9 20-20 23C16 51 7 43 7 31z" fill="none" stroke="#e3c27c" stroke-width="1.2"/><path d="M8 30 27 18l19 12" fill="none" stroke="#e3c27c" stroke-width="3.2"/><path d="M17 37c4-2 7-2 10 0 3-2 6-2 10 0v10c-4-2-7-2-10 0-3-2-6-2-10 0z" fill="#f6f1e6"/><path d="M27 37v10" stroke="#7a2232" stroke-width="1"/><circle cx="27" cy="11" r="2.4" fill="#e3c27c"/></svg><b style="font:400 1.5rem 'Fraunces',serif;color:var(--ink)">Tarrenhurst School</b></div><p style="margin-top:14px;max-width:380px">1 School Hill, Tarrenhurst (fictional). Main office (555) 014-1000 · Admissions (555) 014-1891 · admissions@tarrenhurst.example</p></div>
<div><h4>School</h4><ul><li><a href="{{ PathBase }}/divisions">Divisions</a></li><li><a href="{{ PathBase }}/courses">Course of studies</a></li><li><a href="{{ PathBase }}/houses">Houses</a></li><li><a href="{{ PathBase }}/programs">Athletics &amp; arts</a></li></ul></div>
<div><h4>Admissions</h4><ul><li><a href="{{ PathBase }}/admissions">Admissions calendar</a></li><li><a href="{{ PathBase }}/admissions#tuition">Tuition and aid</a></li><li><a href="{{ PathBase }}/visit">Visit</a></li><li><a href="{{ PathBase }}/calendar">Calendar</a></li></ul></div>
<div><h4>More</h4><ul>{%- assign fm = get_menu("footer") -%}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div></div>
