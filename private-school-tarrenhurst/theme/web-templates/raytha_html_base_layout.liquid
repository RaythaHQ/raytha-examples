.pull{font:400 1.5rem/1.35 "Fraunces",serif;font-style:italic;color:var(--ox);border-left:3px solid var(--gilt);padding:4px 0 4px 22px;margin:28px 0}
.searchbar{display:flex;gap:10px;max-width:640px;margin-top:20px}.searchbar input{flex:1;padding:12px 16px;border:1px solid var(--ink);font:inherit;background:var(--card)}.hit{display:block;padding:14px 0;border-bottom:1px solid var(--rule);text-decoration:none;color:var(--ink)}.hit b{font:500 1.1rem "Fraunces",serif}.hit p{margin:4px 0 0;color:var(--ink2);font-size:.93rem}
.foot{background:var(--ivory);border-top:3px double var(--rule);padding:52px 0 26px;color:var(--ink2);font-size:.93rem}.foot h4{font:500 .68rem "Spline Sans Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:var(--ink)}.foot a{color:var(--ink);text-decoration:none}.foot a:hover{color:var(--ox)}.foot ul{list-style:none;margin:0;padding:0;display:grid;gap:7px}.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:34px}.disc{border-top:1px solid var(--rule);margin-top:34px;padding-top:18px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.8rem}
.notice{background:#f3e5e2;border:1px solid #e2c3bd;padding:12px 14px;margin-bottom:14px}label{display:block;font-weight:600;margin:0 0 6px}input[type=email],input[type=password]{width:100%;padding:12px 14px;border:1px solid var(--ink);font:inherit;background:#fff}
@media (max-width:1020px){.cover .g,.dg{grid-template-columns:1fr!important}.side{position:static}.book{grid-template-columns:1fr;gap:0;padding-top:44px}.rail{display:none}.divs,.stories,.portraits{grid-template-columns:repeat(2,minmax(0,1fr))}.depts{grid-template-columns:repeat(2,minmax(0,1fr))}.dept:nth-child(n){padding-left:0;border-left:0}.dept:nth-child(2n){padding-left:18px;border-left:1px solid var(--rule)}.steps{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:20px}.steps li:nth-child(4){border-left:0;padding-left:0}.figs{grid-template-columns:repeat(3,1fr)}.figs div:nth-child(4){border-left:0}.fg{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.w{padding:0 18px}.strip .w{padding-top:6px;padding-bottom:6px}.lh{padding-top:18px}.lh .nm{font-size:1.6rem}.lh .sub{font-size:.56rem;letter-spacing:.12em}.lh nav ul{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start}.lh nav a{white-space:nowrap;padding:12px 12px;font-size:.72rem}.strip .f{font-size:.56rem}.strip input{display:none}.strip a{margin-left:12px}
.cover{padding:34px 0 44px}.wheelrow{grid-template-columns:120px 1fr;gap:14px}.divs,.stories,.portraits,.seasons,.ledger,.cal,.sig{grid-template-columns:1fr}.portraits{grid-template-columns:1fr 1fr}.ledger>div{border-left:0;border-top:1px solid var(--rule)}.depts{grid-template-columns:1fr}.dept:nth-child(n){padding-left:0!important;border-left:0!important}.steps{grid-template-columns:1fr}.steps li+li{border-left:0;padding-left:0;border-top:1px solid var(--rule2)}
.chead{grid-template-columns:62px 1fr}.chead>a{grid-column:1/-1;justify-self:start}.num{font-size:3.2rem}.cuprow{grid-template-columns:44px 1fr 56px;gap:4px 12px}.cuprow img{width:44px;height:62px;grid-row:1/3}.cuprow .bar{grid-column:2/3;grid-row:2;height:14px}.cuprow .pts{grid-row:1/3;grid-column:3}.figs{grid-template-columns:repeat(2,1fr)}.figs div:nth-child(odd){border-left:0}.rows li{grid-template-columns:1fr;gap:4px}.phead .num{font-size:3.4rem}.fg{grid-template-columns:1fr}.portal .w{grid-template-columns:1fr}.catalog th:nth-child(4),.catalog td:nth-child(4),.catalog th:nth-child(6),.catalog td:nth-child(6){display:none}.rows li>span:last-child{order:-1}}
</style></head><body>
