{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="w"><p class="kick">Search</p><h1>Search the school site</h1><form class="searchbar" action="{{ PathBase }}/search" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="latin, choir, open morning"><button class="btn">Search</button></form><p class="muted" style="margin-top:12px;font-size:.95rem">Searches courses, divisions, faculty, houses, programs, the calendar, stories and letters.</p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "courses:Courses:title:summary,divisions:Divisions:name:summary,faculty:Faculty:name:summary,houses:Houses:name:summary,programs:Athletics and arts:title:summary,events:Calendar:title:summary,stories:Stories:title:summary,letters:Letters:title:summary" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="kick" style="margin:30px 0 4px;padding-bottom:8px;border-bottom:1px solid var(--ink)">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "families" %} <span class="tag fam">🔒 Families</span>{% elsif au == "faculty" %} <span class="tag fac">🔒 Faculty</span>{% endif %}{% if au == "faculty" and in_fac == false %}<p>Sign in to read.</p>{% elsif au == "families" and in_fam == false %}<p>Sign in to read.</p>{% else %}<p>{{ x.summary | strip_html | truncate: 150 }}</p>{% endif %}</a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=latin">latin</a>, <a href="?q=choir">choir</a>, <a href="?q=open">open morning</a> or <a href="?q=house">house</a>.</p>{% endif %}</div></div></section>
