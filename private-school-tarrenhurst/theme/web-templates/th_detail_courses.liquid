{%- assign x=Target.PublishedContent -%}{%- capture cl -%}{{ x.level }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/courses">Course of studies</a></li><li>{{ x.code }}</li></ol><div class="g"><div><p class="kick">{{ x.code }} · {% capture lv11 -%}{{ x.department }}{%- endcapture %}{% case lv11 %}{% when "english" %}English{% when "math" %}Mathematics{% when "science" %}Science{% when "history" %}History{% when "languages" %}World languages{% when "arts" %}Arts{% when "cs" %}Computer science{% when "wellness" %}Wellness{% when "leadership" %}Leadership{% when "admissions" %}Admissions{% else %}{{ lv11 }}{% endcase %} · {% capture lv12 -%}{{ x.division }}{%- endcapture %}{% case lv12 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv12 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.summary }}</p><p style="margin:16px 0 0">{% if cl == "signature" %}<span class="tag sig">Signature course</span>{% else %}<span class="tag">{% capture lv13 -%}{{ x.level }}{%- endcapture %}{% case lv13 %}{% when "core" %}Core{% when "elective" %}Elective{% when "honors" %}Honors{% when "signature" %}Signature course{% else %}{{ lv13 }}{% endcase %}</span>{% endif %}<span class="tag">Grades {{ x.grades }}</span><span class="tag">Block {{ x.block }}</span></p></div></div>
<section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div><div class="prose">{{ x.body }}</div><h2 style="margin:34px 0 14px;font-size:1.5rem">Units</h2>{%- assign us = x.units | split: "|" -%}<ol class="daytl">{% for u in us %}<li><span>Unit {{ forloop.index }}</span>{{ u }}</li>{% endfor %}</ol></div>
<aside class="card fr side"><dl class="kv"><dt>Code</dt><dd>{{ x.code }}</dd><dt>Teacher</dt><dd>{{ x.teacher }}</dd><dt>Grades</dt><dd>{{ x.grades }}</dd><dt>Block</dt><dd>{{ x.block }} <a href="{{ PathBase }}/rotation" style="font-size:.85rem">(rotation)</a></dd><dt>Credits</dt><dd>{{ x.credits }}</dd><dt>Prerequisite</dt><dd>{{ x.prereq }}</dd></dl></aside></div></div></section>
