{%- assign doy = "now" | date: "%j" | plus: 0 -%}{%- assign sd = doy | times: 5 | divided_by: 7 | floor -%}{%- assign ri = sd | modulo: 6 -%}{%- assign rls = "A,B,C,D,E,F" | split: "," -%}{%- assign rl = rls[ri] -%}{%- assign tdow = "now" | date: "%a" | downcase -%}{%- assign wkend = false -%}{%- if tdow == "sat" or tdow == "sun" -%}{%- assign wkend = true -%}{%- endif -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{% case rl %}{% when "A" %}{%- assign tb = "A|B|C|D|E" -%}{% when "B" %}{%- assign tb = "F|G|A|B|C" -%}{% when "C" %}{%- assign tb = "D|E|F|G|A" -%}{% when "D" %}{%- assign tb = "B|C|D|E|F" -%}{% when "E" %}{%- assign tb = "G|A|B|C|D" -%}{% when "F" %}{%- assign tb = "E|F|G|A|B" -%}{% endcase %}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>The rotation</li></ol><div class="g"><div><p class="kick">Upper and Middle School schedule</p><h1>The six-day rotation</h1></div></div><p class="lede">Seven blocks (A–G) rotate through a six-day cycle, five blocks a day, so no class always meets first thing. Today is worked out on the server from the date; nobody edits it each morning.</p></div></div><section class="sec tight"><div class="w"><div class="dg" style="grid-template-columns:minmax(0,340px) minmax(0,1fr)"><div class="card fr" style="text-align:center"><p class="kick">{% if wkend %}Weekend · rotation position{% else %}Today · {{ tdate }}{% endif %}</p><div style="max-width:260px;margin:0 auto"><svg class="wheel" viewBox="0 0 300 300" width="300" height="300" role="img" aria-label="Six-day rotation, today is Day {{ rl }}"><circle cx="150" cy="150" r="146" fill="none" stroke="var(--gilt)" stroke-width="1.5"/><path d="M87.0 34.0 A132 132 0 0 1 213.0 34.0 L179.6 95.5 A62 62 0 0 0 120.4 95.5Z" class="seg{% if rl == "A" %} on{% endif %}"/><text x="150.0" y="60.0" text-anchor="middle" class="sl{% if rl == "A" %} on{% endif %}">A</text><path d="M219.0 37.5 A132 132 0 0 1 282.0 146.5 L212.0 148.4 A62 62 0 0 0 182.4 97.1Z" class="seg{% if rl == "B" %} on{% endif %}"/><text x="234.9" y="109.0" text-anchor="middle" class="sl{% if rl == "B" %} on{% endif %}">B</text><path d="M282.0 153.5 A132 132 0 0 1 219.0 262.5 L182.4 202.9 A62 62 0 0 0 212.0 151.6Z" class="seg{% if rl == "C" %} on{% endif %}"/><text x="234.9" y="207.0" text-anchor="middle" class="sl{% if rl == "C" %} on{% endif %}">C</text><path d="M213.0 266.0 A132 132 0 0 1 87.0 266.0 L120.4 204.5 A62 62 0 0 0 179.6 204.5Z" class="seg{% if rl == "D" %} on{% endif %}"/><text x="150.0" y="256.0" text-anchor="middle" class="sl{% if rl == "D" %} on{% endif %}">D</text><path d="M81.0 262.5 A132 132 0 0 1 18.0 153.5 L88.0 151.6 A62 62 0 0 0 117.6 202.9Z" class="seg{% if rl == "E" %} on{% endif %}"/><text x="65.1" y="207.0" text-anchor="middle" class="sl{% if rl == "E" %} on{% endif %}">E</text><path d="M18.0 146.5 A132 132 0 0 1 81.0 37.5 L117.6 97.1 A62 62 0 0 0 88.0 148.4Z" class="seg{% if rl == "F" %} on{% endif %}"/><text x="65.1" y="109.0" text-anchor="middle" class="sl{% if rl == "F" %} on{% endif %}">F</text><text x="150" y="140" text-anchor="middle" class="cday">DAY</text><text x="150" y="182" text-anchor="middle" class="cl">{{ rl }}</text></svg></div><p class="muted" style="margin:10px 0 0;font-size:.9rem">{% if wkend %}No classes today.{% else %}Blocks today: {{ tb | replace: "|", " · " }}{% endif %}</p></div>
<div><h2>The cycle</h2><div class="tscroll"><table class="rgrid"><thead><tr><th></th><th class="{% if rl == "A" %}on{% endif %}">Day A</th><th class="{% if rl == "B" %}on{% endif %}">Day B</th><th class="{% if rl == "C" %}on{% endif %}">Day C</th><th class="{% if rl == "D" %}on{% endif %}">Day D</th><th class="{% if rl == "E" %}on{% endif %}">Day E</th><th class="{% if rl == "F" %}on{% endif %}">Day F</th></tr></thead><tbody><tr><td class="tm">8:10</td><td style="--c:#7a2232" class="{% if rl == "A" %}on{% endif %}">A</td><td style="--c:#2f4a6b" class="{% if rl == "B" %}on{% endif %}">F</td><td style="--c:#5f7a5a" class="{% if rl == "C" %}on{% endif %}">D</td><td style="--c:#3f6177" class="{% if rl == "D" %}on{% endif %}">B</td><td style="--c:#8a5a3c" class="{% if rl == "E" %}on{% endif %}">G</td><td style="--c:#5b3f6e" class="{% if rl == "F" %}on{% endif %}">E</td></tr><tr><td class="tm">9:20</td><td style="--c:#3f6177" class="{% if rl == "A" %}on{% endif %}">B</td><td style="--c:#8a5a3c" class="{% if rl == "B" %}on{% endif %}">G</td><td style="--c:#5b3f6e" class="{% if rl == "C" %}on{% endif %}">E</td><td style="--c:#a8812f" class="{% if rl == "D" %}on{% endif %}">C</td><td style="--c:#7a2232" class="{% if rl == "E" %}on{% endif %}">A</td><td style="--c:#2f4a6b" class="{% if rl == "F" %}on{% endif %}">F</td></tr><tr><td class="tm">10:50</td><td style="--c:#a8812f" class="{% if rl == "A" %}on{% endif %}">C</td><td style="--c:#7a2232" class="{% if rl == "B" %}on{% endif %}">A</td><td style="--c:#2f4a6b" class="{% if rl == "C" %}on{% endif %}">F</td><td style="--c:#5f7a5a" class="{% if rl == "D" %}on{% endif %}">D</td><td style="--c:#3f6177" class="{% if rl == "E" %}on{% endif %}">B</td><td style="--c:#8a5a3c" class="{% if rl == "F" %}on{% endif %}">G</td></tr><tr><td class="tm">12:45</td><td style="--c:#5f7a5a" class="{% if rl == "A" %}on{% endif %}">D</td><td style="--c:#3f6177" class="{% if rl == "B" %}on{% endif %}">B</td><td style="--c:#8a5a3c" class="{% if rl == "C" %}on{% endif %}">G</td><td style="--c:#5b3f6e" class="{% if rl == "D" %}on{% endif %}">E</td><td style="--c:#a8812f" class="{% if rl == "E" %}on{% endif %}">C</td><td style="--c:#7a2232" class="{% if rl == "F" %}on{% endif %}">A</td></tr><tr><td class="tm">1:55</td><td style="--c:#5b3f6e" class="{% if rl == "A" %}on{% endif %}">E</td><td style="--c:#a8812f" class="{% if rl == "B" %}on{% endif %}">C</td><td style="--c:#7a2232" class="{% if rl == "C" %}on{% endif %}">A</td><td style="--c:#2f4a6b" class="{% if rl == "D" %}on{% endif %}">F</td><td style="--c:#5f7a5a" class="{% if rl == "E" %}on{% endif %}">D</td><td style="--c:#3f6177" class="{% if rl == "F" %}on{% endif %}">B</td></tr></tbody></table></div><p class="muted" style="font-size:.9rem;margin-top:10px">Block G holds chamber choir and wellness. Lower School keeps a fixed daily schedule.</p></div></div></div></section>
{%- assign cs = get_content_items(ContentType="courses", OrderBy="sort_order asc", PageSize=100) -%}<section class="sec tight" style="padding-bottom:70px"><div class="w"><h2>{% if wkend %}Courses on the rotation{% else %}Meeting today, Day {{ rl }}{% endif %}</h2><p class="muted" style="margin:0 0 20px">Upper and Middle School courses whose block is in today's cycle.</p><div class="tscroll"><table class="catalog"><thead><tr><th>Block</th><th>Course</th><th>Teacher</th><th>Grades</th><th>Department</th></tr></thead><tbody>{% for c in cs.Items %}{%- assign y=c.PublishedContent -%}{%- capture cb -%}{{ y.block }}{%- endcapture -%}{%- assign show=false -%}{% if cb.size == 1 %}{% if wkend or tb contains cb %}{%- assign show=true -%}{% endif %}{% endif %}{% if show %}<tr><td><span class="bk" style="--c:{% case cb %}{% when "A" %}#7a2232{% when "B" %}#3f6177{% when "C" %}#a8812f{% when "D" %}#5f7a5a{% when "E" %}#5b3f6e{% when "F" %}#2f4a6b{% when "G" %}#8a5a3c{% endcase %}">{{ cb }}</span></td><td><a href="{{ PathBase }}/{{ c.RoutePath }}">{{ c.PrimaryField }}</a><small>{{ y.code }}</small></td><td>{{ y.teacher }}</td><td>{{ y.grades }}</td><td>{% capture lv8 -%}{{ y.department }}{%- endcapture %}{% case lv8 %}{% when "english" %}English{% when "math" %}Mathematics{% when "science" %}Science{% when "history" %}History{% when "languages" %}World languages{% when "arts" %}Arts{% when "cs" %}Computer science{% when "wellness" %}Wellness{% when "leadership" %}Leadership{% when "admissions" %}Admissions{% else %}{{ lv8 }}{% endcase %}</td></tr>{% endif %}{% endfor %}</tbody></table></div></div></section>
