{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}{%- assign x=Target.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/letters">Letters</a></li><li>{{ Target.PrimaryField }}</li></ol><div class="g"><div><p class="kick">{% capture lv31 -%}{{ x.kind }}{%- endcapture %}{% case lv31 %}{% when "letter" %}Letter home{% when "handbook" %}Handbook{% when "rota" %}Rota{% when "minutes" %}Minutes{% when "list" %}List{% when "deadline" %}Deadlines{% else %}{{ lv31 }}{% endcase %} · {{ x.date_label }}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{% if ok %}{{ x.summary }}{% else %}A letter for signed-in members.{% endif %}</p><p style="margin:16px 0 0">{% if au == "families" %}<span class="tag fam">🔒 Families</span>{% elsif au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag">Public</span>{% endif %}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w">{% if ok %}<div class="dg"><div class="prose">{{ x.body }}</div><aside class="card fr side"><dl class="kv"><dt>From</dt><dd>{{ x.from_name }}</dd><dt>Date</dt><dd>{{ x.date_label }}</dd><dt>Division</dt><dd>{% capture lv32 -%}{{ x.division }}{%- endcapture %}{% case lv32 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv32 }}{% endcase %}</dd><dt>For</dt><dd>{% capture lv33 -%}{{ x.audience }}{%- endcapture %}{% case lv33 %}{% when "public" %}Everyone{% when "families" %}Families{% when "faculty" %}Faculty{% else %}{{ lv33 }}{% endcase %}</dd></dl></aside></div>{% else %}{% if au == "faculty" %}<div class="lockp"><p class="kick">🔒 Faculty only</p><h2>Signed-in faculty can read this.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div>{% else %}<div class="lockp"><p class="kick">🔒 Families</p><h2>Sign in with a family account to read this letter.</h2><p class="muted">This page is checked on the server: signed out, its contents are never sent to the browser. In the story, the school office opens accounts for families at enrollment and for faculty on their first day.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}">Sign in</a><a class="btn line" href="{{ PathBase }}/admissions">Admissions</a></p></div>{% endif %}{% endif %}</div></section>
