{%- assign in_fam=false -%}{%- assign in_fac=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "families" -%}{%- assign in_fam=true -%}{%- endif -%}{%- if g == "faculty" -%}{%- assign in_fac=true -%}{%- assign in_fam=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_fam=true -%}{%- assign in_fac=true -%}{%- endif -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Letters</li></ol><div class="g"><div><p class="kick">Letters and documents</p><h1>Letters home, handbooks, rotas and minutes</h1></div></div><p class="lede">Letters from the Head are public. Handbooks, rotas and conference times are for families; duty rotas and minutes are for faculty. Titles are listed; contents are sent only to signed-in members.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><ul class="rows">{% for r in Target.Items %}{%- assign y=r.PublishedContent -%}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "families" and in_fam == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "faculty" and in_fac == false -%}{%- assign ok=false -%}{%- endif -%}<li><span class="k">{{ y.date_label }}</span><span>{% if ok %}<a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a><small>{{ y.summary }}</small>{% else %}<span class="lockt">{{ r.PrimaryField }}</span><small>Sign in to read.</small>{% endif %}</span><span>{% if au == "families" %}<span class="tag fam">🔒 Families</span>{% elsif au == "faculty" %}<span class="tag fac">🔒 Faculty</span>{% else %}<span class="tag">Public</span>{% endif %}</span></li>{% endfor %}</ul></div></section>
