<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li>Stories</li></ol><div class="g"><div><p class="kick">Stories</p><h1>From classrooms, stages, fields and houses</h1></div></div><p class="lede">Written by teachers and students. All stories are fictional.</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="stories">{% for s in Target.Items %}{%- assign y=s.PublishedContent -%}<a class="sto" href="{{ PathBase }}/{{ s.RoutePath }}"><img src="{{ y.image.Value | attachment_redirect_url }}" alt="" loading="lazy"><small>{% capture lv29 -%}{{ y.kind }}{%- endcapture %}{% case lv29 %}{% when "classroom" %}Classroom{% when "arts" %}Arts{% when "athletics" %}Athletics{% when "houses" %}Houses{% when "alumni" %}Alumni{% else %}{{ lv29 }}{% endcase %} · {{ y.date_label }}</small><h3>{{ s.PrimaryField }}</h3><p>{{ y.summary }}</p></a>{% endfor %}</div></div></section>
