{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/programs">Athletics &amp; arts</a></li><li>{{ Target.PrimaryField }}</li></ol><div class="g"><div><p class="kick">{% capture lv22 -%}{{ x.kind }}{%- endcapture %}{% case lv22 %}{% when "sport" %}Athletics{% when "arts" %}Arts{% when "club" %}Club{% when "outdoor" %}Outdoors{% else %}{{ lv22 }}{% endcase %} · {% capture lv23 -%}{{ x.season }}{%- endcapture %}{% case lv23 %}{% when "fall" %}Fall{% when "winter" %}Winter{% when "spring" %}Spring{% when "year" %}Year-round{% else %}{{ lv23 }}{% endcase %}</p><h1>{{ Target.PrimaryField }}</h1></div></div><p class="lede">{{ x.summary }}</p></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div class="dg"><div class="prose">{{ x.body }}</div><aside class="card fr side"><dl class="kv"><dt>Season</dt><dd>{% capture lv24 -%}{{ x.season }}{%- endcapture %}{% case lv24 %}{% when "fall" %}Fall{% when "winter" %}Winter{% when "spring" %}Spring{% when "year" %}Year-round{% else %}{{ lv24 }}{% endcase %}</dd><dt>Division</dt><dd>{% capture lv25 -%}{{ x.division }}{%- endcapture %}{% case lv25 %}{% when "lower" %}Lower School{% when "middle" %}Middle School{% when "upper" %}Upper School{% when "all" %}All divisions{% else %}{{ lv25 }}{% endcase %}</dd><dt>Coach</dt><dd>{{ x.coach }}</dd><dt>Meets</dt><dd>{{ x.meets }}</dd><dt>Note</dt><dd>{{ x.record }}</dd></dl></aside></div></div></section>
