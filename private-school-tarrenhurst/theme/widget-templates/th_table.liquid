<section class="sec tight"{% if widget.settings.headline contains "Tuition" %} id="tuition"{% endif %}><div class="w"><h2>{{ widget.settings.headline }}</h2><p class="muted" style="margin:0 0 22px">{{ widget.settings.intro }}</p><div class="tscroll"><table class="sched"><thead><tr>{%- assign cols = widget.settings.columns | split: "|" -%}{% for c in cols %}<th>{{ c }}</th>{% endfor %}</tr></thead><tbody>{% for r in widget.settings.rows %}<tr>{%- assign cs = r.cells | split: "|" -%}{% for c in cs %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><p class="muted" style="font-size:.9rem;margin-top:12px">{{ widget.settings.foot }}</p></div></section>
