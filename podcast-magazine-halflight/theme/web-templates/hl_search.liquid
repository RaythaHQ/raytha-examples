/">Halflight</a></li><li>Search</li></ol><p class="kick">Search</p><h1>{% if q != "" %}Results for “{{ q }}”{% else %}Search Halflight{% endif %}</h1><p class="lede">Episodes, stories, people, letters and issues. Members-only results show their title and a lock.</p><form class="searchbar" action="" role="search"><input name="q" value="{{ q }}" aria-label="Search" placeholder="baker, bridge, nurse"><button class="btn">Search</button></form></div></div><section class="sec tight" style="padding-bottom:70px"><div class="w"><div style="max-width:880px">{% if q != "" %}{%- assign groups = "episodes:Episodes:title:summary,stories:Stories:title:standfirst,issues:Issues:title:summary,contributors:People:name:bio,letters:Night mail:title:body" | split: "," -%}{%- assign total=0 -%}{% for g in groups %}{%- assign gp = g | split: ":" -%}{%- capture f -%}contains({{ gp[2] }},'{{ q }}') or contains({{ gp[3] }},'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType=gp[0],Filter=f,PageSize=12) -%}{%- assign total = total | plus: r.TotalCount -%}{% if r.TotalCount > 0 %}<h2 class="grp">{{ gp[1] }} · {{ r.TotalCount }}</h2>{% for p in r.Items %}{%- assign x=p.PublishedContent -%}{%- capture au -%}{{ x.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_mb == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "editors" and in_ed == false -%}{%- assign ok=false -%}{%- endif -%}<a class="hit" href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b>{% if au == "members" or au == "editors" %} <span class="tg">🔒 Members</span>{% endif %}<p>{% if ok %}{{ x.summary | default: x.standfirst | default: x.bio | default: x.body | strip_html | truncate: 160 }}{% else %}Sign in to read.{% endif %}</p></a>{% endfor %}{% endif %}{% endfor %}{% if total == 0 %}<p class="muted">Nothing matched “{{ q }}”. Try a shorter word.</p>{% endif %}{% else %}<p class="muted">Try <a href="?q=baker">baker</a>, <a href="?q=bridge">bridge</a>, <a href="?q