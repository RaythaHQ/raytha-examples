{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 -%}{%- assign nowq = nowm | divided_by: 15 | plus: 0 -%}{%- assign nowi = nowh | times: 4 | plus: nowq -%}{%- assign tclock = "now" | date: "%-I:%M %p" | downcase -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_mb=false -%}{%- assign in_ed=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_mb=true -%}{%- endif -%}{%- if g == "editors" -%}{%- assign in_ed=true -%}{%- assign in_mb=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_mb=true -%}{%- assign in_ed=true -%}{%- endif -%}{%- assign PALS = "#f2b84b,#8fb8de,#e7826a,#9fd1b0,#c9a7e8,#f0d98a,#7fc6c4,#e8a0bf,#b7c46a,#d9b38c" | split: "," -%}{%- assign UX = "0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998,-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65" | split: "," -%}{%- assign UY = "-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65,0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998" | split: "," -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halflight</a></li><li>About</li></ol><p class="kick">About Halflight</p><h1>A podcast and a magazine about the night shift</h1><p class="lede">Halflight started as a radio producer's notebook of people she met at 3 a.m. It is now a weekly podcast and a quarterly print magazine, made in Corran by seven people.</p></div></div><section class="sec tight"><div class="w"><div class="epg"><div class="prose"><p>Every episode is one person and one night of work. We record at the hour their shift starts and stay until it ends. Every issue of the magazine collects the stories that did not fit in forty minutes, with photographs taken in whatever light the job has.</p><p>The site runs the way the magazine does: everything is filed by time. Episodes carry the hours of the guest's shift, stories carry the hour they happen, and letters carry their postmark. That is what draws the clock on the home page and the <a href="{{ PathBase }}/hours">hour index</a>.</p><p>Members get the bonus tape, the whole archive and the next issue early, in the <a href="{{ PathBase }}/members">back room</a>. Membership comes with a print subscription; there is no sign-up or payment form on this example site.</p><h2>Who makes it</h2></div><aside class="card side"><p class="kick">In numbers</p><ul class="facts">{%- assign ec = get_content_items(ContentType="episodes", PageSize=1) -%}{%- assign sc = get_content_items(ContentType="stories", PageSize=1) -%}{%- assign ic = get_content_items(ContentType="issues", PageSize=1) -%}{%- assign lc = get_content_items(ContentType="letters", PageSize=1) -%}<li><span>Episodes and bonus tape</span><b>{{ ec.TotalCount }}</b></li><li><span>Issues</span><b>{{ ic.TotalCount }}</b></li><li><span>Stories</span><b>{{ sc.TotalCount }}</b></li><li><span>Letters printed</span><b>{{ lc.TotalCount }}</b></li></ul></aside></div><div class="ppl" style="margin-top:10px">{%- assign pp = get_content_items(ContentType="contributors", OrderBy="sort_order asc", PageSize=20) -%}{% for p in pp.Items %}{%- assign y=p.PublishedContent -%}<a class="card person" href="{{ PathBase }}/{{ p.RoutePath }}" style="text-decoration:none"><span class="ini">{{ y.initials }}</span><div><b>{{ p.PrimaryField }}</b><span class="mono muted" style="font-size:.76rem">{{ y.role | upcase }}</span><p style="margin:6px 0 0;font-size:.94rem">{{ y.summary }}</p></div></a>{% endfor %}</div></div></section>
