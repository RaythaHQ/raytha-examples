h1>The rundown</h1><p class="lede">Every episode from booking to release.</p></div></div><section class="sec tight"><div class="w">{% unless in_ed %}<div class="lockp"><p class="kick" style="color:var(--rose)">🔒 Editors only</p><h2>The production rundown is for the Halflight editors.</h2><p class="muted">Checked on the server: unless you are signed in as an editor, the rundown is never sent to the browser.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Editor sign-in</a><a class="btn line" href="{{ PathBase }}/members">Members back room</a></p></div>{% else %}<table class="ro"><thead><tr><th>Due</th><th>Item</th><th>Stage</th><th>Owner</th></tr></thead><tbody>{% for r in Target.Items %}{%- assign y=r.PublishedContent -%}{%- capture dd_d -%}{{ y.due }}{%- endcapture -%}{%- assign dd = dd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}<tr><td class="ln">{{ dd_d | date: "%b %-d" }}<br>{% if dd == 0 %}today{% elsif dd == 1 %}tomorrow{% elsif dd > 1 %}in {{ dd }} days{% elsif dd == -1 %}yesterday{% else %}{{ dd | abs }} days ago{% endif %}</td><td><b><a href="{{ PathBase }}/{{ r.RoutePath }}">{{ r.PrimaryField }}</a></b><small>{{ y.note }}</small></td><td><span class="chip">{% capture lv5 -%}{{ y.stage }}{%- endcapture %}{% case lv5 %}{% when "booked" %}Booked{% when "recorded" %}Recorded{% when "edit" %}In the edit{% when "mix" %}Mix and master{% when "scheduled" %}Scheduled{% when "live" %}Live{% else %}{{ lv5 }}{% endcase %}</span></td><td>{{ y.owner }}</td></tr>{% endfor %}</tbody></table>{% endunless %}</div></section>
