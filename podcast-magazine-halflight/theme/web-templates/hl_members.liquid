{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 -%}{%- assign nowq = nowm | divided_by: 15 | plus: 0 -%}{%- assign nowi = nowh | times: 4 | plus: nowq -%}{%- assign tclock = "now" | date: "%-I:%M %p" | downcase -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_mb=false -%}{%- assign in_ed=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_mb=true -%}{%- endif -%}{%- if g == "editors" -%}{%- assign in_ed=true -%}{%- assign in_mb=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_mb=true -%}{%- assign in_ed=true -%}{%- endif -%}{%- assign PALS = "#f2b84b,#8fb8de,#e7826a,#9fd1b0,#c9a7e8,#f0d98a,#7fc6c4,#e8a0bf,#b7c46a,#d9b38c" | split: "," -%}{%- assign UX = "0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998,-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65" | split: "," -%}{%- assign UY = "-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65,0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998" | split: "," -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halflight</a></li><li>The back room</li></ol><p class="kick">Members · the back room</p><h1>{% if in_mb %}Welcome back, {{ CurrentUser.FirstName }}.{% else %}The back room{% endif %}</h1><p class="lede">{% if in_mb %}Bonus tape, the archive and the next issue early. Everything here was checked on the server before it was sent to you.{% else %}Bonus episodes, every back issue in full, and the next issue early. Here is what is inside; sign in to open it.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% unless in_mb %}<div class="lockp"><p class="kick" style="color:var(--rose)">🔒 Members only</p><h2>Sign in to open the back room.</h2><p class="muted">This is checked on the server: signed out, the audio, notes and text are never sent to the browser. In the story, membership comes with a print subscription, and the editors open each account.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/members">Member sign-in</a><a class="btn line" href="{{ PathBase }}/members">What members get</a></p></div><h2 class="grp" style="margin-top:40px">What is in here (titles only)</h2>{% endunless %}<div class="two"><div><h2 class="grp" style="margin-top:0">Bonus episodes</h2>{%- assign bx = get_content_items(ContentType="episodes", OrderBy="release desc", PageSize=60) -%}{% for b in bx.Items %}{%- assign y = b.PublishedContent -%}{%- capture bkd -%}{{ y.kind }}{%- endcapture -%}{% if bkd == "bonus" %}{% if in_mb %}<div class="player" style="margin:14px 0"><p class="kick">★ Members bonus · {{ y.duration }} min · {%- capture _dt6 -%}{{ y.release }}{%- endcapture -%}{{ _dt6 | date: "%b %-d" }}</p><h3 style="color:#fff;margin:0 0 4px"><a href="{{ PathBase }}/{{ b.RoutePath }}" style="color:#fff;text-decoration:none">{{ b.PrimaryField }}</a></h3><p style="margin:0;color:#c9cfdb">{{ y.summary }}</p>{%- assign wv = y.wave | split: "," -%}<svg class="wave" viewBox="0 0 432 64" preserveAspectRatio="none" aria-hidden="true">{% for b in wv %}{%- assign bh = b | plus: 0 | times: 6 -%}<rect x="{{ forloop.index0 | times: 6 }}" y="{{ 64 | minus: bh | divided_by: 2 }}" width="4" height="{{ bh }}" rx="2" fill="#f2b84b" fill-opacity="{% if forloop.index0 < 26 %}1{% else %}.45{% endif %}"/>{% endfor %}</svg>{%- capture aud -%}{{ y.audio_url }}{%- endcapture -%}{% if aud != "" %}<audio controls preload="none" src="{{ y.audio_url }}"></audio>{% endif %}</div>{% else %}<div class="lockrow"><span class="tg">🔒</span><span><b style="color:var(--ink)">{{ b.PrimaryField }}</b> · {{ y.duration }} min</span></div>{% endif %}{% endif %}{% endfor %}</div><div>{%- assign isl = get_content_items(ContentType="issues", OrderBy="number desc", PageSize=20) -%}{%- assign sts = get_content_items(ContentType="stories", OrderBy="page asc", PageSize=60) -%}{% for i in isl.Items %}{%- assign iy=i.PublishedContent -%}{%- capture _nino -%}{{ iy.number }}{%- endcapture -%}{%- assign ino = _nino | plus: 0 -%}{%- capture irn_d -%}{{ iy.release }}{%- endcapture -%}{%- assign irn = irn_d | remove: "-" | plus: 0 -%}{%- assign shown=0 -%}{% for s in sts.Items %}{%- assign sy=s.PublishedContent -%}{%- capture _nsis -%}{{ sy.issue }}{%- endcapture -%}{%- assign sis = _nsis | plus: 0 -%}{%- capture sau -%}{{ sy.audience }}{%- endcapture -%}{% if sis == ino and sau == "members" %}{%- assign shown=shown | plus: 1 -%}{% if shown == 1 %}<h2 class="grp"{% if forloop.first %} style="margin-top:0"{% endif %}>{% if irn > todayn %}Read early · {% else %}Archive · {% endif %}Issue {{ ino }}: {{ i.PrimaryField }}</h2>{% endif %}{% if in_mb %}<a class="hit" href="{{ PathBase }}/{{ s.RoutePath }}"><b>{{ s.PrimaryField }}</b> <span class="mono muted" style="font-size:.76rem">· P. {{ sy.page }} · {{ sy.read_min }} MIN</span><p>{{ sy.standfirst }}</p></a>{% else %}<div class="lockrow"><span class="tg">🔒</span><span><b style="color:var(--ink)">{{ s.PrimaryField }}</b> · issue {{ ino }}, p. {{ sy.page }}</span></div>{% endif %}{% endif %}{% endfor %}{% endfor %}</div></div></div></section>
