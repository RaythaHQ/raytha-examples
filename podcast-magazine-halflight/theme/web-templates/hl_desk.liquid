 desk{% if in_ed %} · {{ tdate }}{% endif %}</p><h1>{% if in_ed %}Good morning, {{ CurrentUser.FirstName }}. Here is the week.{% else %}Editors desk{% endif %}</h1><p class="lede">{% if in_ed %}The rundown, read from content on every page load: what is due, what is late, and what is next to air.{% else %}Production notes for the Halflight team.{% endif %}</p></div></div><section class="sec tight"><div class="w">{% unless in_ed %}<div class="lockp"><p class="kick" style="color:var(--rose)">🔒 Editors only</p><h2>The production rundown is for the Halflight editors.</h2><p class="muted">Checked on the server: unless you are signed in as an editor, the rundown is never sent to the browser.</p><p class="cta"><a class="btn" href="{{ PathBase }}/account/login?returnUrl=/desk">Editor sign-in</a><a class="btn line" href="{{ PathBase }}/members">Members back room</a></p></div>{% else %}{%- assign rds = get_content_items(ContentType="rundown", OrderBy="due asc", PageSize=60) -%}{%- assign wk=0 -%}{%- assign late=0 -%}{%- assign air=0 -%}{% for r in rds.Items %}{%- assign y=r.PublishedContent -%}{%- capture dd_d -%}{{ y.due }}{%- endcapture -%}{%- assign dd = dd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}{%- capture st -%}{{ y.stage }}{%- endcapture -%}{% if st != "live" %}{% if dd < 0 %}{%- assign late=late | plus: 1 -%}{% elsif dd <= 7 %}{%- assign wk=wk | plus: 1 -%}{% endif %}{% endif %}{% if st == "live" %}{%- assign air=air | plus: 1 -%}{% endif %}{% endfor %}{%- assign nx = get_content_items(ContentType="episodes", OrderBy="release asc", PageSize=60) -%}{%- assign nd = -1 -%}{% for e in nx.Items %}{%- capture ern_d -%}{{ e.PublishedContent.release }}{%- endcapture -%}{%- assign ern = ern_d | remove: "-" | plus: 0 -%}{%- capture ek -%}{{ e.PublishedContent.kind }}{%- endcapture -%}{% if nd < 0 and ern > todayn and ek == "episode" %}{%- capture nd_d -%}{{ e.PublishedContent.release }}{%- endcapture -%}{%- assign nd = nd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}{%- assign nxt = e -%}{% endif %}{% endfor %}<div class="stats"><div class="stat"><b>{{ wk }}</b><span>due in the next 7 days</span></div><div class="stat"><b>{{ late }}</b><span>past due</span></div><div class="stat"><b>{% if nd >= 0 %}{{ nd }}d{% else %}-{% endif %}</b><span>until {% if nd >= 0 %}ep {{ nxt.PublishedContent.number }} airs{% else %}the next episode{% endif %}</span></div><div class="stat"><b>{{ air }}</b><span>released items on the board</span></div></div><div class="board"><div class="col"><h4>Booked</h4>{% for r in rds.Items %}{%- assign y=r.PublishedContent -%}{%- capture st -%}{{ y.stage }}{%- endcapture -%}{% if st == "booked" %}{%- capture dd_d -%}{{ y.due }}{%- endcapture -%}{%- assign dd = dd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}<a class="tk{% if dd < 0 and st != "live" %} late{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><b>{{ r.PrimaryField }}</b><small>{{ y.owner }}</small><br><small class="d">{% if st == "live" %}aired {{ dd_d | date: "%b %-d" }}{% else %}due {% if dd == 0 %}today{% elsif dd == 1 %}tomorrow{% elsif dd > 1 %}in {{ dd }} days{% elsif dd == -1 %}yesterday{% else %}{{ dd | abs }} days ago{% endif %}{% endif %}</small></a>{% endif %}{% endfor %}</div><div class="col"><h4>Recorded</h4>{% for r in rds.Items %}{%- assign y=r.PublishedContent -%}{%- capture st -%}{{ y.stage }}{%- endcapture -%}{% if st == "recorded" %}{%- capture dd_d -%}{{ y.due }}{%- endcapture -%}{%- assign dd = dd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}<a class="tk{% if dd < 0 and st != "live" %} late{% endif %}" href="{{ PathBase }}/{{ r.RoutePath }}"><b>{{ r.PrimaryField }}</b><small>{{ y.owner }}</small><br><small class="d">{% if st == "live" %}aired {{ dd_d | date: "%b %-d" }}{% else %}due {% if dd == 0 %}today{% elsif dd == 1 %}tomorrow{% elsif dd > 1 %}in {{ dd }} days{% elsif dd == -1 %}yesterday{% else %}{{ dd | abs }} days ago{% endif %}{% endif %}</small></a>{% endif %