{%- assign todayn = "now" | date: "%Y%m%d" | plus: 0 -%}{%- assign todays = "now" | date: "%Y-%m-%d" -%}{%- assign nows = todays | date: "%s" | plus: 0 -%}{%- assign nowh = "now" | date: "%H" | plus: 0 -%}{%- assign nowm = "now" | date: "%M" | plus: 0 -%}{%- assign nowq = nowm | divided_by: 15 | plus: 0 -%}{%- assign nowi = nowh | times: 4 | plus: nowq -%}{%- assign tclock = "now" | date: "%-I:%M %p" | downcase -%}{%- assign tdate = "now" | date: "%A, %B %-d" -%}{%- assign in_mb=false -%}{%- assign in_ed=false -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "members" -%}{%- assign in_mb=true -%}{%- endif -%}{%- if g == "editors" -%}{%- assign in_ed=true -%}{%- assign in_mb=true -%}{%- endif -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign in_mb=true -%}{%- assign in_ed=true -%}{%- endif -%}{%- assign PALS = "#f2b84b,#8fb8de,#e7826a,#9fd1b0,#c9a7e8,#f0d98a,#7fc6c4,#e8a0bf,#b7c46a,#d9b38c" | split: "," -%}{%- assign UX = "0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998,-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65" | split: "," -%}{%- assign UY = "-1000,-998,-991,-981,-966,-947,-924,-897,-866,-831,-793,-752,-707,-659,-609,-556,-500,-442,-383,-321,-259,-195,-131,-65,0,65,131,195,259,321,383,442,500,556,609,659,707,752,793,831,866,897,924,947,966,981,991,998,1000,998,991,981,966,947,924,897,866,831,793,752,707,659,609,556,500,442,383,321,259,195,131,65,0,-65,-131,-195,-259,-321,-383,-442,-500,-556,-609,-659,-707,-752,-793,-831,-866,-897,-924,-947,-966,-981,-991,-998" | split: "," -%}{%- capture sq -%}{{ QueryParams.season | strip }}{%- endcapture -%}<div class="phead"><div class="w"><ol class="crumbs"><li><a href="{{ PathBase }}/">Halflight</a></li><li>Listen</li></ol><p class="kick">Listen · every Thursday</p><h1>All episodes</h1><p class="lede">One person, one night of work, about forty minutes. Season two is the companion to Issue 9 and Issue 10 of the magazine. Bonus episodes are for members.</p></div></div><section class="sec tight"><div class="w"><div class="filters"><a href="?" class="{% if sq == "" %}on{% endif %}">Both seasons</a><a href="?season=2" class="{% if sq == "2" %}on{% endif %}">Season two</a><a href="?season=1" class="{% if sq == "1" %}on{% endif %}">Season one</a></div><table class="ro"><thead><tr><th>No.</th><th>Episode</th><th class="sb">The shift</th><th>Length</th><th>Out</th></tr></thead><tbody>{%- assign col = "#e9a24a" -%}{% for e in Target.Items %}{%- assign y=e.PublishedContent -%}{%- capture ys -%}{{ y.season }}{%- endcapture -%}{% if sq == "" or sq == ys %}{%- capture au -%}{{ y.audience }}{%- endcapture -%}{%- assign ok=true -%}{%- if au == "members" and in_mb == false -%}{%- assign ok=false -%}{%- endif -%}{%- if au == "editors" and in_ed == false -%}{%- assign ok=false -%}{%- endif -%}{%- capture _nno -%}{{ y.number }}{%- endcapture -%}{%- assign no = _nno | plus: 0 -%}{%- capture _ns -%}{{ y.shift_start }}{%- endcapture -%}{%- assign s = _ns | plus: 0 -%}{%- capture _nen -%}{{ y.shift_end }}{%- endcapture -%}{%- assign en = _nen | plus: 0 -%}{%- capture rn_d -%}{{ y.release }}{%- endcapture -%}{%- assign rn = rn_d | remove: "-" | plus: 0 -%}{%- capture kd -%}{{ y.kind }}{%- endcapture -%}{%- capture rd_d -%}{{ y.release }}{%- endcapture -%}{%- assign rd = rd_d | date: "%s" | plus: 0 | minus: nows | divided_by: 86400 -%}<tr{% if rn > todayn %} style="background:#fbf1d8"{% endif %}><td class="n">{% if kd == "bonus" %}★{% elsif kd == "trailer" %}·{% else %}{{ no }}{% endif %}</td><td><b><a href="{{ PathBase }}/{{ e.RoutePath }}">{{ e.PrimaryField }}</a>{% if kd == "bonus" %} <span class="tg">{% if ok %}Members bonus{% else %}🔒 Members{% endif %}</span>{% endif %}{% if rn > todayn %} <span class="tg" style="background:var(--lamp);color:var(--ink)">Coming {% if rd == 0 %}today{% elsif rd == 1 %}tomorrow{% elsif rd > 1 %}in {{ rd }} days{% elsif rd == -1 %}yesterday{% else %}{{ rd | abs }} days ago{% endif %}</span>{% endif %}</b><small>{% if kd == "trailer" %}Trailer · {{ y.summary | truncate: 90 }}{% else %}{{ y.guest }}, {{ y.job | downcase }} · {{ y.place }}{% endif %}</small></td><td class="sb">{% if kd != "trailer" %}<div class="sbar" aria-label="Shift from {% if s == 0 %}midnight{% elsif s < 12 %}{{ s }} am{% elsif s == 12 %}noon{% else %}{{ s | minus: 12 }} pm{% endif %} to {% if en == 0 %}midnight{% elsif en < 12 %}{{ en }} am{% elsif en == 12 %}noon{% else %}{{ en | minus: 12 }} pm{% endif %}"><span class="nt" style="left:0;width:25%"></span><span class="nt" style="left:75%;width:25%"></span>{%- assign sl = s | times: 100.0 | divided_by: 24 -%}{%- assign el = en | times: 100.0 | divided_by: 24 -%}{% if s < en %}<i style="left:{{ sl }}%;width:{{ el | minus: sl }}%;background:{{ col }}"></i>{% else %}<i style="left:{{ sl }}%;width:{{ 100 | minus: sl }}%;background:{{ col }}"></i><i style="left:0;width:{{ el }}%;background:{{ col }}"></i>{% endif %}<span class="nw" style="left:{{ nowh | times: 100.0 | divided_by: 24 }}%"></span></div>{% endif %}</td><td class="ln">{{ y.duration }} min</td><td class="ln">{%- capture _dt1 -%}{{ y.release }}{%- endcapture -%}{{ _dt1 | date: "%b %-d" }}</td></tr>{% endif %}{% endfor %}</tbody></table><p class="muted" style="margin-top:18px;font-size:.92rem">The bars show each guest's shift on a 24-hour day; the shaded ends are night, and the red line is the time right now in Corran.</p></div></section>
