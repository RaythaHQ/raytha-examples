{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/work">Work</a></li><li aria-current="page">Clients</li></ol></nav><h1>Clients</h1><p>Organizations we have designed, built or cared for. All of them are fictional.</p></div></div>
<div class="body"><div class="wrap"><div class="grid g3">
{% for c in Target.Items %}{% assign x = c.PublishedContent %}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="card pad" href="{{ PathBase }}/{{ c.RoutePath }}" style="text-decoration:none;display:block"><img src="{{ x.logo.Value | attachment_redirect_url }}" alt="{{ c.PrimaryField }}" style="height:64px;width:auto;margin-bottom:12px"><span class="tag">{{ il }}</span><p class="muted" style="margin:12px 0 0;font-size:.96rem">{{ x.summary }}</p><p style="margin:10px 0 0;font-size:.86rem;color:var(--muted)">{{ x.location }} &middot; client since {{ x.since }}</p></a>{% endfor %}
</div></div></div>
