{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture ck -%}{{ p.category }}{%- endcapture -%}{%- for pair in icats -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/insights">Insights</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><span class="tag {{ cc }}" style="margin-bottom:6px">{{ cl }}</span><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap art">
<article><img src="{{ p.image.Value | attachment_redirect_url }}" alt="" style="width:100%;border-radius:var(--r);aspect-ratio:1200/630;object-fit:cover;margin-bottom:30px"><div class="prose">{{ p.body }}</div></article>
<aside class="side">{% if p.author %}{% assign m = p.author %}<div class="card pad"><span class="kicker">Written by</span><a class="person" href="{{ PathBase }}/{{ m.RoutePath }}" style="display:flex;gap:14px;align-items:center;margin-top:12px"><span class="img" style="width:72px;flex:none"><img src="{{ m.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""></span><span><b style="margin:0">{{ m.PrimaryField }}</b><span>{{ m.PublishedContent.role }}</span></span></a><p class="muted" style="font-size:.9rem;margin:14px 0 0">{{ p.posted_on.Value | date: "%B %-d, %Y" }} &middot; {{ p.read_time }} read</p></div>{% endif %}
{%- assign rec = get_content_items(ContentType="insights", OrderBy="posted_on desc", PageSize=5) -%}
<div class="card pad"><h2 style="font-size:1.1rem;margin-bottom:10px">More insights</h2>{% for a in rec.Items %}{% if a.RoutePath != Target.RoutePath %}<p style="margin:0 0 10px"><a href="{{ PathBase }}/{{ a.RoutePath }}" style="font-weight:600;text-decoration:none">{{ a.PrimaryField }}</a></p>{% endif %}{% endfor %}</div></aside>
</div></div>
