{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}
{%- assign qi = "" -%}{%- for pair in inds %}{% assign kv = pair | split: ":" %}{% if QueryParams.industry == kv[0] %}{% assign qi = kv[0] %}{% assign qil = kv[1] %}{% endif %}{% endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Work</li></ol></nav><h1>Case studies{% if qi != "" %}: {{ qil }}{% endif %}</h1><p>Websites for retailers, museums, libraries, clinics, law firms and product companies. Every client and result here is fictional.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Filter by industry"><a href="{{ PathBase }}/work"{% if qi == "" %} aria-current="true"{% endif %}>All work</a>{% for pair in inds %}{% assign kv = pair | split: ":" %}{% assign n = 0 %}{% for w in Target.Items %}{% capture wi %}{{ w.PublishedContent.industry }}{% endcapture %}{% if wi == kv[0] %}{% assign n = n | plus: 1 %}{% endif %}{% endfor %}{% if n > 0 %}<a href="{{ PathBase }}/work?industry={{ kv[0] }}"{% if qi == kv[0] %} aria-current="true"{% endif %}>{{ kv[1] }}</a>{% endif %}{% endfor %}</nav>
<div class="wgrid">{% for w in Target.Items %}{%- capture wik -%}{{ w.PublishedContent.industry }}{%- endcapture -%}{% if qi == "" or qi == wik %}{%- assign x = w.PublishedContent -%}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="wcard" href="{{ PathBase }}/{{ w.RoutePath }}"><div class="img"><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span>{{ w.PrimaryField }}</span><span>{{ il }} &middot; {{ x.year }}</span></div><h3>{{ x.headline }}</h3><div class="tags">{% assign svl = x.services | split: ", " %}{% for s in svl limit: 3 %}<span class="tag">{{ s }}</span>{% endfor %}</div></a>{% endif %}{% endfor %}</div>
<p style="margin-top:48px"><a class="more" href="{{ PathBase }}/clients">See every client <i class="bi bi-arrow-right" aria-hidden="true"></i></a></p>
</div></div>
