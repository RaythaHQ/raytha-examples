{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/portal">Client portal</a></li><li aria-current="page">Files</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>Files and brand assets</h1><p>Deliverables, guidelines, logo packs and notes shared with you, newest first.</p></div></div>
<div class="body"><div class="wrap">{% if is_member == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>The client portal is for Halverline clients.</h2><p style="max-width:640px">Sign in to see your project rooms: where each project stands, the weekly updates, deliverables and brand assets. Each client sees only their own projects. Halverline and its clients are fictional.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the client portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the studio</a></div></div>{% else %}<div class="card">{% for d in Target.Items %}{% assign p = d.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed %}{%- assign y = d.PublishedContent -%}{%- capture dk -%}{{ y.kind }}{%- endcapture -%}{%- for pair in dks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- assign di = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="file" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-{{ di }}"></i></span><span style="flex:1"><b>{{ d.PrimaryField }}</b><small>{% capture vv %}{{ y.version }}{% endcapture %}{% assign vv = vv | strip %}{{ dl }}{% if vv != "" %} &middot; {{ vv }}{% endif %} &middot; {{ y.posted_on.Value | date: "%b %-d, %Y" }}</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>{% endif %}{% endfor %}</div>{% endif %}</div></div>
