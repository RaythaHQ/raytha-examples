<!DOCTYPE html>
<html lang="en">
{%- assign seg0 = Target.RoutePath | default: "" | split: "/" | first -%}
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if seg0 == "portal" %}Client portal | {% elsif Target.PrimaryField %}{{ Target.PrimaryField }} | {% elsif Target.Label %}{{ Target.Label }} | {% elsif Target.Title and Target.Title != "Halverline Studio" %}{{ Target.Title }} | {% endif %}Halverline Studio</title>
  <meta name="description" content="{% if seg0 == "portal" %}The members-only client portal of Halverline Studio (fictional): project rooms, weekly updates, deliverables and brand assets.{% elsif Target.PublishedContent.summary %}{{ Target.PublishedContent.summary | strip_html | escape }}{% else %}Halverline Studio (a fictional web design and development studio): case studies, services, the team, insights, careers and a client portal.{% endif %}">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='11' fill='%23121212'/%3E%3Cpath d='M12 10v20M28 10v20M12 20h16' stroke='%23fff' stroke-width='3.4' stroke-linecap='round'/%3E%3Ccircle cx='31' cy='9' r='4.5' fill='%23ff5b2e'/%3E%3C/svg%3E">
  <style>
:root{--ink:#121212;--ink2:#2a2a2a;--paper:#f5f2ec;--card:#fff;--line:#e3ddd3;--muted:#5c5650;--acc:#ff5b2e;--acc-d:#d93d12;--acc2:#2b3cff;--lilac:#dcd7ff;--sage:#cfe7d9;--sand:#efe6d6;--dark:#0e0e0f;--r:18px;--sans:"Instrument Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;--serif:"Instrument Serif",Georgia,serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;font-family:var(--sans);font-size:17px;line-height:1.6;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}a{color:inherit}
h1,h2,h3,h4{margin:0;line-height:1.08;letter-spacing:-.025em;font-weight:600}
h1{font-size:clamp(2.4rem,5.2vw,4.5rem)}h2{font-size:clamp(1.8rem,3.2vw,2.7rem)}h3{font-size:1.25rem;letter-spacing:-.015em}
p{margin:0 0 1em}.muted{color:var(--muted)}
em.s,.s{font-family:var(--serif);font-style:italic;font-weight:400;letter-spacing:-.01em}
.wrap{max-width:1240px;margin:0 auto;padding:0 28px}
.skip{position:absolute;left:-999px;top:8px;background:var(--acc);color:#fff;padding:10px 16px;border-radius:10px;z-index:100;font-weight:700}.skip:focus{left:12px}
:focus-visible{outline:3px solid var(--acc2);outline-offset:3px;border-radius:6px}
.ubar{background:var(--dark);color:#cfcac2;font-size:.82rem}.ubar .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:8px;padding-bottom:8px;flex-wrap:wrap}
.ubar a{color:#fff;text-decoration:none;margin-left:18px}.ubar a:hover{text-decoration:underline}.fict{display:inline-block;background:var(--acc);color:#fff;font-weight:700;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:99px;margin-right:10px}
.hdr{position:sticky;top:0;z-index:50;background:rgba(245,242,236,.92);backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
.hdr .wrap{display:flex;align-items:center;gap:28px;height:76px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}.brand b{font-size:1.3rem;letter-spacing:-.03em;font-weight:700}.brand small{display:block;font-size:.72rem;color:var(--muted);letter-spacing:.02em;margin-top:-2px}
.mark{width:38px;height:38px;flex:none}
.nav{display:flex;gap:4px;list-style:none;margin:0 auto 0 12px;padding:0}.nav a{display:block;padding:8px 13px;border-radius:99px;text-decoration:none;font-weight:500;font-size:.98rem;color:var(--ink2)}
.nav a:hover{background:#fff}.nav a[aria-current]{background:var(--ink);color:#fff}.nav .mob{display:none}
.hacts{display:flex;gap:10px;align-items:center}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:99px;font-weight:600;font-size:.96rem;text-decoration:none;border:1.5px solid transparent;cursor:pointer;font-family:inherit;line-height:1.2;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-1px)}.btn-p{background:var(--acc);color:#fff}.btn-p:hover{background:var(--acc-d)}.btn-d{background:var(--ink);color:#fff}.btn-o{border-color:var(--ink);color:var(--ink);background:transparent}.btn-o:hover{background:#fff}
.btn-w{background:#fff;color:var(--ink)}.btn-ghost{border-color:rgba(255,255,255,.5);color:#fff}.btn-ghost:hover{background:rgba(255,255,255,.1)}
.tog{display:none;background:none;border:1.5px solid var(--ink);border-radius:12px;width:44px;height:44px;font-size:1.4rem;cursor:pointer;color:var(--ink)}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.kicker:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--acc)}
.hero{background:var(--dark);color:#fff;position:relative;overflow:hidden;padding:84px 0 0}
.hero:after{content:"";position:absolute;inset:auto -10% -40% 40%;height:560px;background:radial-gradient(closest-side,rgba(255,91,46,.35),transparent);pointer-events:none}
.hgrid{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;position:relative;z-index:1}
.hero .kicker{color:#bdb7ae}.hero h1{margin:18px 0 22px;font-size:clamp(2.6rem,5.6vw,5rem);line-height:1.02}.hero h1 .s{color:var(--acc)}
.hero .lead{font-size:1.2rem;color:#d6d1c9;max-width:560px}.hero .acts{display:flex;gap:12px;flex-wrap:wrap;margin:26px 0 34px}
.hstats{display:flex;gap:34px;flex-wrap:wrap;border-top:1px solid #2a2a2c;padding:22px 0 44px;color:#bdb7ae;font-size:.9rem}.hstats b{display:block;color:#fff;font-size:1.7rem;letter-spacing:-.02em}
.stack{position:relative;height:520px}.stack a{position:absolute;display:block;width:78%;border-radius:16px;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,.45);transition:transform .25s}
.stack a img{width:100%;aspect-ratio:16/10;object-fit:cover}.stack a span{position:absolute;left:14px;bottom:12px;background:rgba(14,14,15,.82);color:#fff;font-size:.82rem;font-weight:600;padding:5px 12px;border-radius:99px}
.stack a:nth-child(1){left:0;top:40px;transform:rotate(-5deg)}.stack a:nth-child(2){right:0;top:0;transform:rotate(4deg)}.stack a:nth-child(3){left:12%;top:220px;transform:rotate(-1deg)}
.stack a:hover{transform:rotate(0) scale(1.02);z-index:5}
.logos{background:#fff;border-bottom:1px solid var(--line)}.logos .wrap{display:grid;grid-template-columns:repeat(5,1fr);gap:8px 22px;padding-top:26px;padding-bottom:26px;align-items:center}
.logos p{grid-column:1/-1;margin:0 0 4px;font-size:.82rem;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.logos a{display:block;filter:grayscale(1);opacity:.8;transition:.2s}.logos a:hover{filter:none;opacity:1}.logos img{height:70px;width:auto;margin:auto}
.sec{padding:88px 0}.sec.alt{background:#fff}.sec.dark{background:var(--dark);color:#fff}.sec.dark .muted{color:#bdb7ae}.sec.tight{padding:56px 0}
.shead{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:38px;flex-wrap:wrap}.shead h2{margin-top:10px;max-width:760px}.shead p{margin:12px 0 0;color:var(--muted);max-width:640px;font-size:1.06rem}
.more{font-weight:600;text-decoration:none;display:inline-flex;gap:8px;align-items:center;border-bottom:2px solid var(--acc);padding-bottom:2px}
.grid{display:grid;gap:24px}.g2{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r)}.pad{padding:26px}
.wcard{display:block;text-decoration:none;color:inherit}.wcard .img{border-radius:var(--r);overflow:hidden;background:#ddd;aspect-ratio:16/10;position:relative}
.wcard .img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.wcard:hover .img img{transform:scale(1.04)}
.wcard .meta{display:flex;justify-content:space-between;gap:12px;margin:16px 0 6px;font-size:.88rem;color:var(--muted);font-weight:500}
.wcard h3{font-size:1.5rem;line-height:1.15}.wcard:hover h3{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px;text-decoration-color:var(--acc)}
.wcard .tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.tag{display:inline-block;font-size:.76rem;font-weight:600;padding:4px 10px;border-radius:99px;background:var(--sand);color:var(--ink2)}.tag.l{background:var(--lilac)}.tag.g{background:var(--sage)}.tag.o{background:#ffd9cc;color:#8a2b0f}.tag.d{background:var(--ink);color:#fff}
.wgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:56px 32px}.wgrid .wcard:nth-child(3n+1),.wgrid .wcard:last-child:nth-child(3n+2){grid-column:span 2}.wgrid .wcard:nth-child(3n+1) .img,.wgrid .wcard:last-child:nth-child(3n+2) .img{aspect-ratio:21/9}
.svcs{border-top:1px solid var(--line)}.svc{display:grid;grid-template-columns:70px 1fr 1.2fr 40px;gap:20px;align-items:center;padding:26px 6px;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background .2s}
.svc:hover{background:#fff}.svc .n{font-family:var(--serif);font-style:italic;font-size:1.6rem;color:var(--acc)}.svc h3{font-size:1.5rem}.svc p{margin:0;color:var(--muted)}.svc .go{font-size:1.4rem;justify-self:end}
.dark .svcs,.dark .svc{border-color:#2a2a2c}.dark .svc:hover{background:#18181a}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.stats div{border-top:2px solid var(--ink);padding-top:14px}.stats b{display:block;font-size:2.6rem;letter-spacing:-.03em;font-weight:600;line-height:1.1}.stats span{color:var(--muted);font-size:.95rem}
.dark .stats div{border-color:#fff}.dark .stats span{color:#bdb7ae}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;counter-reset:s}.steps .card{padding:26px;position:relative}.steps .card:before{counter-increment:s;content:"0" counter(s);font-family:var(--serif);font-style:italic;font-size:2rem;color:var(--acc);display:block;margin-bottom:12px}
.qt{display:grid;grid-template-columns:auto 1fr;gap:36px;align-items:center}.qt blockquote{margin:0;font-size:clamp(1.5rem,2.6vw,2.2rem);line-height:1.25;letter-spacing:-.02em;font-weight:500}.qt blockquote:before{content:"\201C";color:var(--acc);font-family:var(--serif);font-size:1.4em;line-height:0;vertical-align:-.3em;margin-right:4px}
.qt figcaption{margin-top:18px;color:var(--muted)}.qt figcaption b{color:var(--ink)}.dark .qt figcaption b{color:#fff}
.icard{display:block;text-decoration:none;color:inherit}.icard .img{border-radius:var(--r);overflow:hidden;aspect-ratio:1200/630;background:#ddd}.icard .img img{width:100%;height:100%;object-fit:cover}
.icard .meta{font-size:.85rem;color:var(--muted);margin:14px 0 6px}.icard h3{font-size:1.25rem;line-height:1.25}.icard:hover h3{text-decoration:underline;text-decoration-color:var(--acc);text-underline-offset:3px}
.cta{background:var(--acc);color:#fff;border-radius:28px;padding:56px;display:grid;grid-template-columns:1.4fr 1fr;gap:30px;align-items:center;position:relative;overflow:hidden}
.cta:after{content:"";position:absolute;right:-80px;top:-80px;width:320px;height:320px;border-radius:50%;border:44px solid rgba(255,255,255,.14)}
.cta h2{font-size:clamp(1.9rem,3.4vw,3rem)}.cta p{margin:12px 0 0;font-size:1.08rem;color:#ffe9e1}.cta .acts{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end;position:relative;z-index:1}
.phead{padding:70px 0 46px;border-bottom:1px solid var(--line)}.phead h1{margin:14px 0 14px;max-width:960px}.phead p{font-size:1.18rem;color:var(--muted);max-width:760px;margin:0}
.phead.dk{background:var(--dark);color:#fff;border:0}.phead.dk p{color:#cfcac2}.phead.dk .crumbs,.phead.dk .crumbs a{color:#bdb7ae}
.crumbs{list-style:none;padding:0;margin:0 0 14px;display:flex;gap:8px;flex-wrap:wrap;font-size:.86rem;color:var(--muted)}.crumbs li+li:before{content:"/";margin-right:8px;opacity:.6}.crumbs a{text-decoration:none}.crumbs a:hover{text-decoration:underline}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:34px}.chips a{padding:8px 16px;border-radius:99px;border:1.5px solid var(--line);background:#fff;text-decoration:none;font-weight:500;font-size:.92rem}.chips a:hover{border-color:var(--ink)}.chips a[aria-current]{background:var(--ink);color:#fff;border-color:var(--ink)}
.body{padding:56px 0 90px}
.case-hero{background:var(--c,#222);color:#fff;padding:64px 0 0;position:relative;overflow:hidden}.case-hero .crumbs,.case-hero .crumbs a{color:rgba(255,255,255,.75)}
.case-hero h1{max-width:980px;margin:14px 0 18px}.case-hero .lead{font-size:1.2rem;max-width:760px;color:rgba(255,255,255,.86)}
.case-hero .cimg{margin-top:40px;border-radius:22px 22px 0 0;overflow:hidden;box-shadow:0 -10px 60px rgba(0,0,0,.25)}.case-hero .cimg img{width:100%;aspect-ratio:16/9;object-fit:cover}
.clogo{display:inline-flex;align-items:center;gap:10px;background:#fff;border-radius:14px;padding:6px 14px}.clogo img{height:56px;width:auto}
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:28px 0;border-bottom:1px solid var(--line)}.facts dt{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}.facts dd{margin:4px 0 0;font-weight:600}
.cols{display:grid;grid-template-columns:280px 1fr;gap:56px;padding:56px 0;border-bottom:1px solid var(--line)}.cols h2{font-size:1.6rem}
.prose{font-size:1.08rem}.prose h2{font-size:1.6rem;margin:1.6em 0 .5em}.prose h2:first-child{margin-top:0}.prose ul{padding-left:1.2em}.prose li{margin:.3em 0}.prose a{color:var(--acc-d)}
.disc{font-size:.88rem;color:var(--muted);border-left:3px solid var(--acc);padding-left:12px;margin-top:1.6em}
.results{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:56px 0;border-bottom:1px solid var(--line)}.results div{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:24px}.results b{display:block;font-size:2.3rem;letter-spacing:-.03em;color:var(--c,var(--acc));line-height:1.1;font-weight:600}.results span{color:var(--muted);font-size:.95rem}
.board{border-radius:22px;overflow:hidden;border:1px solid var(--line);margin:56px 0}.board img{width:100%}
.next{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:56px}
.person{display:block;text-decoration:none;color:inherit}.person .img{border-radius:var(--r);overflow:hidden;aspect-ratio:13/15;background:#ddd}.person .img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.person:hover .img img{transform:scale(1.04)}
.person b{display:block;margin-top:14px;font-size:1.12rem}.person span{color:var(--muted);font-size:.92rem}
.role{display:grid;grid-template-columns:1.3fr 1fr 1fr 40px;gap:20px;align-items:center;padding:24px 8px;border-bottom:1px solid var(--line);text-decoration:none;color:inherit}.role:hover{background:#fff}.role h3{font-size:1.3rem}.role .go{justify-self:end;font-size:1.3rem}
.side{display:grid;gap:20px;align-content:start}
.art{display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:start}
.lock{background:var(--dark);color:#fff;border-radius:24px;padding:46px;position:relative;overflow:hidden}.lock:after{content:"";position:absolute;right:-60px;bottom:-60px;width:260px;height:260px;border-radius:50%;background:radial-gradient(closest-side,rgba(255,91,46,.5),transparent)}
.lock .ic{width:58px;height:58px;border-radius:16px;background:var(--acc);display:grid;place-items:center;font-size:1.6rem;margin-bottom:18px}.lock h2{font-size:1.9rem;margin-bottom:10px}.lock p{color:#cfcac2}
.member{display:flex;gap:14px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 20px;flex-wrap:wrap}
.pj{display:block;text-decoration:none;color:inherit;padding:24px}.pj:hover{background:#fbfaf7}.pj+.pj{border-top:1px solid var(--line)}
.pj .top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}.pj h3{font-size:1.25rem}.pj p{margin:6px 0 12px;color:var(--muted);font-size:.96rem}
.bar{height:10px;background:var(--sand);border-radius:99px;overflow:hidden}.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--acc),#ff9a6b);border-radius:99px}
.pmeta{display:flex;gap:18px;flex-wrap:wrap;font-size:.86rem;color:var(--muted);margin-top:10px}.pmeta b{color:var(--ink)}
.phase{display:flex;gap:6px;margin:22px 0}.phase span{flex:1;text-align:center;font-size:.78rem;font-weight:600;padding:8px 4px;border-radius:10px;background:var(--sand);color:var(--muted)}.phase span.on{background:var(--ink);color:#fff}.phase span.done{background:#ffd9cc;color:#8a2b0f}
.tl{position:relative;padding-left:26px;border-left:2px solid var(--line)}.tl>div{position:relative;padding-bottom:26px}.tl>div:before{content:"";position:absolute;left:-33px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--acc);border:3px solid var(--paper)}
.tl time{font-size:.82rem;color:var(--muted);font-weight:600}.tl h3{font-size:1.1rem;margin:2px 0 4px}.tl p{margin:0;color:var(--ink2)}
.file{display:flex;gap:14px;align-items:center;padding:16px 20px;text-decoration:none;color:inherit}.file+.file{border-top:1px solid var(--line)}.file:hover{background:#fbfaf7}
.file .fi{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;background:var(--lilac);font-size:1.2rem;flex:none}.file b{display:block}.file small{color:var(--muted)}
.fbar{display:flex;gap:12px;align-items:flex-end;background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:28px}.fbar .grow{flex:1}
label{display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--ink2)}
input,select{font:inherit;font-size:1rem;padding:11px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;width:100%;color:var(--ink)}input:focus,select:focus{border-color:var(--ink);outline:none}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}.faq summary{font-weight:600;font-size:1.1rem;cursor:pointer}.faq details p{margin:10px 0 0;color:var(--muted)}
.vals{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.vals .card{padding:28px}.vals i{font-size:1.6rem;color:var(--acc)}.vals h3{margin:14px 0 8px}
.count{font-weight:600;margin-bottom:18px}
.foot{background:var(--dark);color:#bdb7ae;padding:74px 0 30px;font-size:.95rem}.foot a{color:#e9e5de;text-decoration:none}.foot a:hover{color:#fff;text-decoration:underline}
.fbig{font-size:clamp(2rem,4.4vw,3.6rem);color:#fff;letter-spacing:-.03em;font-weight:600;line-height:1.05;margin-bottom:46px}.fbig a{color:var(--acc);text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:6px}
.fcols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:30px}.foot h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;color:#8d877f;margin-bottom:14px}.foot ul{list-style:none;padding:0;margin:0}.foot li{margin:7px 0}
.fbot{border-top:1px solid #2a2a2c;margin-top:50px;padding-top:22px;font-size:.84rem}
@media (max-width:1080px){.nav a{padding:8px 9px;font-size:.92rem}.hacts .btn-o{display:none}}
@media (max-width:960px){.hgrid,.cta,.art,.cols{grid-template-columns:1fr}.stack{height:420px}.g3,.g4,.steps,.vals{grid-template-columns:1fr 1fr}.stats,.results,.facts{grid-template-columns:1fr 1fr}.logos .wrap{grid-template-columns:repeat(3,1fr)}
 .svc{grid-template-columns:50px 1fr 30px}.svc p{grid-column:2}.svc .go{grid-row:1;grid-column:3}.role{grid-template-columns:1fr 30px}.role>span:not(.go){grid-column:1}.role .go{grid-row:1;grid-column:2}.cta .acts{justify-content:flex-start}.fcols{grid-template-columns:1fr 1fr}
 .tog{display:grid;place-items:center}.nav{display:none;position:absolute;left:0;right:0;top:76px;background:var(--paper);flex-direction:column;padding:14px 20px 22px;border-bottom:1px solid var(--line);margin:0}.hdr.open .nav{display:flex}.nav a{font-size:1.1rem;padding:12px 14px}.nav .mob{display:block}.hdr .wrap{position:relative}.brand{margin-right:auto}}
@media (max-width:640px){body{font-size:16px}.wrap{padding:0 20px}.g2,.g3,.g4,.steps,.vals,.wgrid,.next{grid-template-columns:1fr}.wgrid .wcard:nth-child(3n+1),.wgrid .wcard:last-child:nth-child(3n+2){grid-column:auto}.wgrid .wcard:nth-child(3n+1) .img,.wgrid .wcard:last-child:nth-child(3n+2) .img{aspect-ratio:16/10}
 .hero{padding-top:52px}.stack{height:300px}.stack a{width:84%}.stack a:nth-child(3){top:130px}.hstats{gap:22px}.sec{padding:60px 0}.cta{padding:34px 26px}.hacts .btn-p{display:none}.ubar .r{display:none}.qt{grid-template-columns:1fr}.lock{padding:30px}
 .phase{flex-wrap:wrap}.phase span{flex:1 1 30%}.fbar{flex-direction:column;align-items:stretch}.logos .wrap{grid-template-columns:repeat(2,1fr)}.logos img{height:48px}}
.feat{display:grid;grid-template-columns:1.2fr 1fr;overflow:hidden;text-decoration:none;margin-bottom:44px}.feat img{width:100%;height:100%;object-fit:cover;aspect-ratio:1200/630}.feat .pad{padding:36px;align-self:center}.feat h2{margin:14px 0 12px;font-size:2rem}@media (max-width:960px){.feat{grid-template-columns:1fr}}</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{%- assign path = Target.RoutePath | default: "" -%}{%- assign seg = path | split: "/" | first -%}
{%- if seg == "clients" -%}{%- assign seg = "work" -%}{%- endif -%}{%- if seg == "team" -%}{%- assign seg = "studio" -%}{%- endif -%}
<div class="ubar"><div class="wrap"><span><span class="fict">Fictional</span>Halverline Studio is a made-up agency for a Raytha example site. Clients, people and projects are invented.</span><span class="r"><a href="{{ PathBase }}/clients">Clients</a><a href="{{ PathBase }}/careers">Careers</a><a href="{{ PathBase }}/search"><i class="bi bi-search" aria-hidden="true"></i> Search</a></span></div></div>
<header class="hdr" id="hdr">
  <div class="wrap">
    <a class="brand" href="{{ PathBase }}/" aria-label="Halverline Studio home"><svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="11" fill="#121212"/><path d="M12 10v20M28 10v20M12 20h16" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/><circle cx="31" cy="9" r="4.5" fill="#ff5b2e"/></svg><span><b>Halverline</b><small>Web design and development</small></span></a>
    <nav aria-label="Main"><ul class="nav" id="nav">
      {%- assign menu = get_main_menu() %}
      {%- for mi in menu.MenuItems %}{% assign u = mi.Url | remove: PathBase | remove_first: "/" %}
      <li><a href="{{ mi.Url }}"{% if u == seg and u != "" %} aria-current="page"{% endif %}>{{ mi.Label }}</a></li>
      {%- endfor %}
      <li class="mob"><a href="{{ PathBase }}/portal"><i class="bi bi-shield-lock" aria-hidden="true"></i> Client portal</a></li>
      <li class="mob"><a href="{{ PathBase }}/search"><i class="bi bi-search" aria-hidden="true"></i> Search</a></li>
    </ul></nav>
    <div class="hacts"><a class="btn btn-o" href="{{ PathBase }}/portal"><i class="bi bi-shield-lock" aria-hidden="true"></i> Client portal</a><a class="btn btn-p" href="{{ PathBase }}/contact">Start a project</a>
      <button class="tog" type="button" aria-controls="nav" aria-expanded="false" aria-label="Open menu" onclick="var h=document.getElementById('hdr');var o=h.classList.toggle('open');this.setAttribute('aria-expanded',o)"><i class="bi bi-list" aria-hidden="true"></i></button></div>
  </div>
</header>
<main id="main" tabindex="-1">{% renderbody %}</main>
<footer class="foot">
  <div class="wrap">
    <p class="fbig">Have a site that needs<br>rethinking? <a href="{{ PathBase }}/contact">Let's talk.</a></p>
    <div class="fcols">
      <div><a class="brand" href="{{ PathBase }}/" style="color:#fff;margin-bottom:16px"><svg class="mark" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="11" fill="#121212"/><path d="M12 10v20M28 10v20M12 20h16" stroke="#fff" stroke-width="3.4" stroke-linecap="round"/><circle cx="31" cy="9" r="4.5" fill="#ff5b2e"/></svg><span><b style="color:#fff">Halverline</b><small style="color:#8d877f">Web design and development</small></span></a>
        <p style="margin:0">14 Wharf Street, Studio 3<br>Portland, Maine (fictional)</p><p style="margin:12px 0 0"><a href="mailto:hello@halverline.example">hello@halverline.example</a></p></div>
      <div><h2>Studio</h2><ul><li><a href="{{ PathBase }}/work">Work</a></li><li><a href="{{ PathBase }}/clients">Clients</a></li><li><a href="{{ PathBase }}/services">Services</a></li><li><a href="{{ PathBase }}/studio">About the studio</a></li></ul></div>
      <div><h2>Read</h2><ul><li><a href="{{ PathBase }}/insights">Insights</a></li><li><a href="{{ PathBase }}/team">Team</a></li><li><a href="{{ PathBase }}/careers">Careers</a></li><li><a href="{{ PathBase }}/search">Search</a></li></ul></div>
      <div><h2>More</h2><ul>{% assign fm = get_menu("footer") %}{% for mi in fm.MenuItems %}<li><a href="{{ mi.Url }}">{{ mi.Label }}</a></li>{% endfor %}</ul></div>
    </div>
    <div class="fbot"><p style="margin:0 0 8px">Halverline Studio is fictional. Its clients, team, case studies and results are invented for a Raytha example site, and this site takes no payments, registrations or job applications.</p><span>&copy; 2026 Halverline Studio (fictional). Built with <a href="https://raytha.com" style="text-decoration:underline">Raytha</a>.</span></div>
  </div>
</footer>
<script>
document.addEventListener('keydown',function(e){if(e.key==='Escape'){var h=document.getElementById('hdr');if(h&&h.classList.contains('open')){h.classList.remove('open');var t=h.querySelector('.tog');t.setAttribute('aria-expanded','false');t.focus()}}});
</script>
</body>
</html>
