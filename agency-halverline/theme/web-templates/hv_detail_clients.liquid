{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture ik -%}{{ p.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/clients">Clients</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav><img src="{{ p.logo.Value | attachment_redirect_url }}" alt="" style="height:72px;width:auto;margin-bottom:6px"><h1>{{ Target.PrimaryField }}</h1><p>{{ p.summary }}</p></div></div>
<div class="body"><div class="wrap">
<dl class="facts" style="padding-top:0"><div><dt>Industry</dt><dd>{{ il }}</dd></div><div><dt>Based in</dt><dd>{{ p.location }}</dd></div><div><dt>Client since</dt><dd>{{ p.since }}</dd></div><div><dt>Status</dt><dd>Fictional client</dd></div></dl>
{%- assign ws = get_content_items(ContentType="work", OrderBy="sort_order asc", PageSize=50) -%}{%- assign n = 0 -%}
{%- capture cards -%}{% for w in ws.Items %}{% if w.PublishedContent.client.RoutePath == Target.RoutePath %}{% assign n = n | plus: 1 %}{%- assign x = w.PublishedContent -%}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="wcard" href="{{ PathBase }}/{{ w.RoutePath }}"><div class="img"><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span>{{ w.PrimaryField }}</span><span>{{ il }} &middot; {{ x.year }}</span></div><h3>{{ x.headline }}</h3><div class="tags">{% assign svl = x.services | split: ", " %}{% for s in svl limit: 3 %}<span class="tag">{{ s }}</span>{% endfor %}</div></a>{% endif %}{% endfor %}{%- endcapture -%}
<h2 style="margin:48px 0 26px">Work for {{ Target.PrimaryField }}</h2>
{% if n > 0 %}<div class="next" style="margin-top:0">{{ cards }}</div>{% else %}<p class="muted">A care plan client. No public case study yet.</p>{% endif %}
</div></div>
