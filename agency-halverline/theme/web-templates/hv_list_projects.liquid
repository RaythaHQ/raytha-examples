{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/portal">Client portal</a></li><li aria-current="page">Projects</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>Projects</h1><p>Every project you have access to.</p></div></div>
<div class="body"><div class="wrap">{% if is_member == false %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>The client portal is for Halverline clients.</h2><p style="max-width:640px">Sign in to see your project rooms: where each project stands, the weekly updates, deliverables and brand assets. Each client sees only their own projects. Halverline and its clients are fictional.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the client portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the studio</a></div></div>{% else %}<div class="card">{% for pr in Target.Items %}{% assign p = pr.PublishedContent %}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{% if allowed %}{%- assign x = pr.PublishedContent -%}{%- capture sk -%}{{ x.status }}{%- endcapture -%}{%- for pair in sts -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="pj" href="{{ PathBase }}/{{ pr.RoutePath }}"><div class="top"><div><span class="tag l">{{ x.client.PrimaryField }}</span><h3 style="margin-top:8px">{{ pr.PrimaryField }}</h3></div><span class="tag {% if sk == "care" %}g{% else %}o{% endif %}">{{ sl }}</span></div><p>{{ x.summary }}</p><div class="bar" role="img" aria-label="{{ x.progress }} percent complete"><i style="width:{{ x.progress }}%"></i></div><div class="pmeta"><span><b>{{ x.progress }}%</b> complete</span><span>Next: <b>{{ x.next_milestone }}</b>{% if x.next_date %}, {{ x.next_date.Value | date: "%b %-d" }}{% endif %}</span>{% if x.lead %}<span>Lead: <b>{{ x.lead.PrimaryField }}</b></span>{% endif %}</div></a>{% endif %}{% endfor %}</div>{% endif %}</div></div>
