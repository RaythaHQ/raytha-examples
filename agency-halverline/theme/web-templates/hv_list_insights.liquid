{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}
{%- assign qc = "" -%}{%- for pair in icats %}{% assign kv = pair | split: ":" %}{% if QueryParams.category == kv[0] %}{% assign qc = kv[0] %}{% endif %}{% endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Insights</li></ol></nav><h1>Insights</h1><p>Notes on design, engineering, content and accessibility from the (fictional) studio.</p></div></div>
<div class="body"><div class="wrap">
<nav class="chips" aria-label="Categories"><a href="{{ PathBase }}/insights"{% if qc == "" %} aria-current="true"{% endif %}>Everything</a>{% for pair in icats %}{% assign kv = pair | split: ":" %}<a href="{{ PathBase }}/insights?category={{ kv[0] }}"{% if qc == kv[0] %} aria-current="true"{% endif %}>{{ kv[1] }}</a>{% endfor %}</nav>
{% if qc == "" %}{% assign a = Target.Items | first %}{% if a %}{% assign x = a.PublishedContent %}{%- capture ck -%}{{ x.category }}{%- endcapture -%}{%- for pair in icats -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="card feat" href="{{ PathBase }}/{{ a.RoutePath }}"><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""><div class="pad"><span class="tag {{ cc }}">{{ cl }}</span><h2>{{ a.PrimaryField }}</h2><p class="muted">{{ x.summary }}</p><p class="muted" style="font-size:.9rem;margin:0">{{ x.author.PrimaryField }} &middot; {{ x.posted_on.Value | date: "%B %-d, %Y" }} &middot; {{ x.read_time }}</p></div></a>{% endif %}{% endif %}
<div class="grid g3">{% for a in Target.Items %}{%- capture ack -%}{{ a.PublishedContent.category }}{%- endcapture -%}{% assign show = false %}{% if qc == "" %}{% unless forloop.first %}{% assign show = true %}{% endunless %}{% elsif qc == ack %}{% assign show = true %}{% endif %}{% if show %}{%- assign x = a.PublishedContent -%}{%- capture ck -%}{{ x.category }}{%- endcapture -%}{%- for pair in icats -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ck -%}{%- assign cl = kv[1] -%}{%- assign cc = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="icard" href="{{ PathBase }}/{{ a.RoutePath }}"><div class="img"><img src="{{ x.image.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span class="tag {{ cc }}">{{ cl }}</span> &nbsp;{{ x.posted_on.Value | date: "%b %-d, %Y" }} &middot; {{ x.read_time }}</div><h3>{{ a.PrimaryField }}</h3></a>{% endif %}{% endfor %}</div>
</div></div>
