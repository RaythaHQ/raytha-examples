{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Services</li></ol></nav><h1>What we do</h1><p>Strategy, design, development, content and care, by the same small team from the first workshop to launch and after.</p></div></div>
<div class="body"><div class="wrap">
<div class="svcs">{% for s in Target.Items %}{%- assign x = s.PublishedContent -%}<a class="svc" href="{{ PathBase }}/{{ s.RoutePath }}"><span class="n">0{{ forloop.index }}</span><h3>{{ s.PrimaryField }}</h3><p>{{ x.tagline }}. {{ x.timeline }}.</p><i class="bi bi-arrow-up-right go" aria-hidden="true"></i></a>{% endfor %}</div>
<div class="grid g3" style="margin-top:56px">
<div class="card pad"><i class="bi bi-git" style="font-size:1.6rem;color:var(--acc)" aria-hidden="true"></i><h3 style="margin:12px 0 6px">You own the code</h3><p class="muted" style="margin:0">Content types, templates and widgets live in your repository. The CMS is MIT-licensed.</p></div>
<div class="card pad"><i class="bi bi-hdd-network" style="font-size:1.6rem;color:var(--acc)" aria-hidden="true"></i><h3 style="margin:12px 0 6px">Host it anywhere</h3><p class="muted" style="margin:0">Your cloud, your data center or a managed care plan with us. Moving later is a handover, not a rebuild.</p></div>
<div class="card pad"><i class="bi bi-people" style="font-size:1.6rem;color:var(--acc)" aria-hidden="true"></i><h3 style="margin:12px 0 6px">No per-seat fees</h3><p class="muted" style="margin:0">Add editors, sections or a second site without a license conversation.</p></div>
</div></div></div>
