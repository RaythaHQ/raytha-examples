{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign p = Target.PublishedContent -%}{%- capture ik -%}{{ p.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}
<section class="case-hero" style="--c:{{ p.accent | default: '#222' }}"><div class="wrap">
 <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/work">Work</a></li><li aria-current="page">{{ Target.PrimaryField }}</li></ol></nav>
 {% if p.client %}<a class="clogo" href="{{ PathBase }}/{{ p.client.RoutePath }}"><img src="{{ p.client.PublishedContent.logo.Value | attachment_redirect_url }}" alt="{{ p.client.PrimaryField }}"></a>{% endif %}
 <h1>{{ p.headline }}</h1><p class="lead">{{ p.summary }}</p>
 <div class="cimg"><img src="{{ p.cover.Value | attachment_redirect_url }}" alt="The {{ Target.PrimaryField }} website on a laptop and a phone (illustration)"></div>
</div></section>
<div class="wrap">
 <dl class="facts"><div><dt>Client</dt><dd>{{ Target.PrimaryField }}</dd></div><div><dt>Industry</dt><dd>{{ il }}</dd></div><div><dt>Year and length</dt><dd>{{ p.year }} &middot; {{ p.duration }}</dd></div><div><dt>Stack</dt><dd>{{ p.stack }}</dd></div></dl>
 <div class="cols"><div><span class="kicker">01</span><h2 style="margin-top:8px">The challenge</h2></div><div class="prose">{{ p.challenge }}</div></div>
 <div class="cols"><div><span class="kicker">02</span><h2 style="margin-top:8px">What we did</h2><div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:14px">{% assign sv = p.services | split: ", " %}{% for s in sv %}<span class="tag">{{ s }}</span>{% endfor %}</div></div><div class="prose">{{ p.approach }}</div></div>
 <div class="results" style="--c:{{ p.accent }}">{% assign rows = p.results | newline_to_br | split: "<br />" %}{% for r in rows %}{% assign c = r | strip | split: "|" %}{% if c.size > 1 %}<div><b>{{ c[0] }}</b><span>{{ c[1] }}</span></div>{% endif %}{% endfor %}</div>
 {% if p.detail %}<div class="board"><img src="{{ p.detail.Value | attachment_redirect_url }}" alt="Design system board for {{ Target.PrimaryField }}: palette, type and components (illustration)" loading="lazy"></div>{% endif %}
 {% if p.quote != blank %}<figure class="qt" style="margin:0 0 56px;grid-template-columns:1fr"><blockquote>{{ p.quote }}</blockquote><figcaption><b>{{ p.quote_name }}</b> &middot; {{ p.quote_role }} (fictional)</figcaption></figure>{% endif %}
 <p class="disc" style="margin-bottom:0">{{ Target.PrimaryField }} is a fictional client. The project, people and results are invented for the Halverline Studio example site.</p>
 {%- assign others = get_content_items(ContentType="work", OrderBy="sort_order asc", PageSize=20) -%}{%- assign shown = 0 -%}
 <h2 style="margin-top:72px">More work</h2>
 <div class="next">{% for w in others.Items %}{% if w.RoutePath != Target.RoutePath and shown < 2 %}{% assign shown = shown | plus: 1 %}{%- assign x = w.PublishedContent -%}{%- capture ik -%}{{ x.industry }}{%- endcapture -%}{%- for pair in inds -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == ik -%}{%- assign il = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="wcard" href="{{ PathBase }}/{{ w.RoutePath }}"><div class="img"><img src="{{ x.cover.Value | attachment_redirect_url }}" alt="" loading="lazy"></div><div class="meta"><span>{{ w.PrimaryField }}</span><span>{{ il }} &middot; {{ x.year }}</span></div><h3>{{ x.headline }}</h3><div class="tags">{% assign svl = x.services | split: ", " %}{% for s in svl limit: 3 %}<span class="tag">{{ s }}</span>{% endfor %}</div></a>{% endif %}{% endfor %}</div>
 <div style="height:90px"></div>
</div>
