{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{%- capture dk -%}{{ p.kind }}{%- endcapture -%}{%- for pair in dks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- assign di = kv[2] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/portal">Client portal</a></li><li><a href="{{ PathBase }}/portal/files">Files</a></li><li aria-current="page">{% if allowed %}{{ Target.PrimaryField }}{% else %}Shared file{% endif %}</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>{% if allowed %}{{ Target.PrimaryField }}{% else %}Shared file{% endif %}</h1><p>{% if allowed %}{{ p.summary }}{% else %}Members only.{% endif %}</p></div></div>
<div class="body"><div class="wrap">{% if allowed == false %}{% if is_member %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This file belongs to another client.</h2><p style="max-width:640px">You are signed in, but your account is not in this client&rsquo;s group, so it stays hidden. The template checks group membership on the server.</p><div style="margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/portal">Back to your projects</a></div></div>{% else %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This file is shared with a client in the portal.</h2><p style="max-width:640px">Sign in with your client portal account to see it.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the client portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the studio</a></div></div>{% endif %}{% else %}
<div class="art"><article class="card pad prose" style="padding:32px">{{ p.body }}{% if p.file %}<p style="margin-top:22px"><a class="btn btn-p" style="text-decoration:none;color:#fff" href="{{ p.file.Value | attachment_redirect_url }}"><i class="bi bi-download" aria-hidden="true"></i> Download</a></p>{% endif %}</article>
<aside class="side"><div class="card pad"><dl style="margin:0"><dt class="kicker">Kind</dt><dd style="margin:6px 0 14px;font-weight:600"><i class="bi bi-{{ di }}" aria-hidden="true"></i> {{ dl }}</dd>{% capture pv %}{{ p.version }}{% endcapture %}{% assign pv = pv | strip %}{% if pv != "" %}<dt class="kicker">Version</dt><dd style="margin:6px 0 14px;font-weight:600">{{ pv }}</dd>{% endif %}<dt class="kicker">Project</dt><dd style="margin:6px 0 14px;font-weight:600"><a href="{{ PathBase }}/{{ p.project.RoutePath }}">{{ p.project.PrimaryField }}</a></dd><dt class="kicker">Posted</dt><dd style="margin:6px 0 0;font-weight:600">{{ p.posted_on.Value | date: "%B %-d, %Y" }}</dd></dl></div>
<p><a href="{{ PathBase }}/portal/files"><i class="bi bi-arrow-left" aria-hidden="true"></i> All files</a></p></aside></div>{% endif %}
</div></div>
