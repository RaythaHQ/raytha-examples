{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}{%- assign is_studio = false -%}{%- assign my_groups = "," -%}{%- for g in CurrentUser.UserGroups -%}{%- if g == "studio" -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign my_groups = my_groups | append: g | append: "," -%}{%- endfor -%}{%- if CurrentUser.IsAdmin -%}{%- assign is_studio = true -%}{%- endif -%}{%- assign is_member = false -%}{%- if is_studio or my_groups contains ",client_" -%}{%- assign is_member = true -%}{%- endif -%}{%- assign p = Target.PublishedContent -%}{%- capture cg -%}{{ p.client_group }}{%- endcapture -%}{%- assign ckey = "," | append: cg | append: "," -%}{%- assign allowed = false -%}{%- if is_studio or my_groups contains ckey -%}{%- assign allowed = true -%}{%- endif -%}{%- capture sk -%}{{ p.status }}{%- endcapture -%}{%- for pair in sts -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == sk -%}{%- assign sl = kv[1] -%}{%- endif -%}{%- endfor -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/portal">Client portal</a></li><li aria-current="page">{% if allowed %}{{ Target.PrimaryField }}{% else %}Project room{% endif %}</li></ol></nav><span class="tag d" style="margin-bottom:6px"><i class="bi bi-shield-lock" aria-hidden="true"></i> Members only</span><h1>{% if allowed %}{{ Target.PrimaryField }}{% else %}Project room{% endif %}</h1><p>{% if allowed %}{{ p.summary }}{% else %}Members only.{% endif %}</p></div></div>
<div class="body"><div class="wrap">{% if allowed == false %}{% if is_member %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This project belongs to another client.</h2><p style="max-width:640px">You are signed in, but your account is not in this client&rsquo;s group, so it stays hidden. The template checks group membership on the server.</p><div style="margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/portal">Back to your projects</a></div></div>{% else %}<div class="lock"><div class="ic" aria-hidden="true"><i class="bi bi-shield-lock"></i></div><h2>This project room is for the client and the studio team.</h2><p style="max-width:640px">Sign in with your client portal account to see it. Each client sees only their own projects.</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;z-index:1"><a class="btn btn-p" href="{{ PathBase }}/account/login?returnUrl=/{{ Target.RoutePath }}"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in to the client portal</a><a class="btn btn-ghost" href="{{ PathBase }}/contact">Contact the studio</a></div></div>{% endif %}{% else %}
<div class="art">
<div>
 <div class="card pad" style="padding:30px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><span class="tag l">{{ p.client.PrimaryField }}</span><span style="font-weight:600">{{ p.progress }}% complete</span></div>
 <div class="phase" aria-label="Project phase: {{ sl }}">{% assign past = true %}{% for pair in sts %}{% assign kv = pair | split: ":" %}{% if kv[0] == sk %}<span class="on" aria-current="step">{{ kv[1] }}</span>{% assign past = false %}{% elsif past %}<span class="done">{{ kv[1] }}</span>{% else %}<span>{{ kv[1] }}</span>{% endif %}{% endfor %}</div>
 <div class="bar"><i style="width:{{ p.progress }}%"></i></div>
 <div class="pmeta" style="font-size:.95rem;margin-top:16px"><span>Next milestone: <b>{{ p.next_milestone }}</b></span>{% if p.next_date %}<span>Due <b>{{ p.next_date.Value | date: "%A, %B %-d" }}</b></span>{% endif %}</div></div>
 <h2 style="font-size:1.6rem;margin:40px 0 18px">Updates</h2>
 <div class="tl">{% assign ups = p.updates | newline_to_br | split: "<br />" %}{% for l in ups %}{% assign u = l | strip | split: "|" %}{% if u.size > 2 %}<div><time>{{ u[0] | date: "%A, %B %-d, %Y" }}</time><h3>{{ u[1] }}</h3><p>{{ u[2] }}</p></div>{% endif %}{% endfor %}</div>
 <div class="prose card pad" style="margin-top:20px"><h2 style="font-size:1.25rem">Project brief</h2>{{ p.body }}</div>
</div>
<aside class="side">
 {%- assign dls = get_content_items(ContentType="deliverables", OrderBy="posted_on desc", PageSize=50) -%}
 <div class="card"><div class="pad" style="padding-bottom:6px"><h2 style="font-size:1.2rem">Files for this project</h2></div>{% assign nf = 0 %}{% for d in dls.Items %}{% if d.PublishedContent.project.RoutePath == Target.RoutePath %}{% assign nf = nf | plus: 1 %}{%- assign y = d.PublishedContent -%}{%- capture dk -%}{{ y.kind }}{%- endcapture -%}{%- for pair in dks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- assign di = kv[2] -%}{%- endif -%}{%- endfor -%}<a class="file" href="{{ PathBase }}/{{ d.RoutePath }}"><span class="fi" aria-hidden="true"><i class="bi bi-{{ di }}"></i></span><span style="flex:1"><b>{{ d.PrimaryField }}</b><small>{% capture vv %}{{ y.version }}{% endcapture %}{% assign vv = vv | strip %}{{ dl }}{% if vv != "" %} &middot; {{ vv }}{% endif %} &middot; {{ y.posted_on.Value | date: "%b %-d, %Y" }}</small></span><i class="bi bi-chevron-right" aria-hidden="true"></i></a>{% endif %}{% endfor %}{% if nf == 0 %}<p class="pad muted" style="margin:0">No files yet.</p>{% endif %}</div>
 {% if p.lead %}{% assign m = p.lead %}<div class="card pad"><span class="kicker">Studio lead</span><a class="person" href="{{ PathBase }}/{{ m.RoutePath }}" style="display:flex;gap:14px;align-items:center;margin-top:12px"><span class="img" style="width:64px;flex:none"><img src="{{ m.PublishedContent.photo.Value | attachment_redirect_url }}" alt=""></span><span><b style="margin:0">{{ m.PrimaryField }}</b><span>{{ m.PublishedContent.role }}</span></span></a></div>{% endif %}
 <p><a href="{{ PathBase }}/portal"><i class="bi bi-arrow-left" aria-hidden="true"></i> All projects</a></p>
</aside></div>{% endif %}
</div></div>
