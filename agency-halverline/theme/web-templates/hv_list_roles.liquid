{%- assign inds = "retail:Retail and ecommerce,food:Food and drink,saas:Software and SaaS,culture:Arts and culture,public:Public sector,health:Healthcare,legal:Professional services,industry:Manufacturing and robotics" | split: "," -%}{%- assign discs = "strategy:Strategy,design:Design,engineering:Engineering,content:Content,production:Production" | split: "," -%}{%- assign icats = "design:Design:o,engineering:Engineering:l,content:Content:g,accessibility:Accessibility:l,studio:Studio notes:d" | split: "," -%}{%- assign rks = "fulltime:Full-time,contract:Contract" | split: "," -%}{%- assign sts = "discovery:Discovery,design:Design,build:Build,launch:Launch,care:Care plan" | split: "," -%}{%- assign dks = "brand:Brand assets:palette,design:Design files:vector-pen,report:Report:file-earmark-text,checklist:Checklist:list-check,notes:Meeting notes:chat-left-text" | split: "," -%}{%- assign cgs = "client_tidewell:Tidewell Outfitters,client_corvane:Corvane Robotics" | split: "," -%}
<div class="phead "><div class="wrap"><nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li aria-current="page">Careers</li></ol></nav><h1>Work with us</h1><p>A small studio that works on a few projects at a time, with the same people from discovery to launch. These roles are fictional; Halverline is not hiring.</p></div></div>
<div class="body"><div class="wrap">
<div style="border-top:1px solid var(--line)">{% for r in Target.Items %}{% assign x = r.PublishedContent %}{%- capture rk -%}{{ x.kind }}{%- endcapture -%}{%- for pair in rks -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == rk -%}{%- assign rl = kv[1] -%}{%- endif -%}{%- endfor -%}{%- capture dk -%}{{ x.discipline }}{%- endcapture -%}{%- for pair in discs -%}{%- assign kv = pair | split: ":" -%}{%- if kv[0] == dk -%}{%- assign dl = kv[1] -%}{%- endif -%}{%- endfor -%}<a class="role" href="{{ PathBase }}/{{ r.RoutePath }}"><span><h3>{{ r.PrimaryField }}</h3><span class="muted" style="font-size:.92rem">{{ x.summary }}</span></span><span><span class="tag">{{ dl }}</span> <span class="tag l">{{ rl }}</span></span><span class="muted">{{ x.location }}</span><i class="bi bi-arrow-up-right go" aria-hidden="true"></i></a>{% endfor %}</div>
<div class="vals" style="margin-top:56px">
<div class="card"><i class="bi bi-calendar-heart" aria-hidden="true"></i><h3>Four weeks off</h3><p class="muted" style="margin:0">Paid leave from the first year, plus the week between the holidays.</p></div>
<div class="card"><i class="bi bi-cup-hot" aria-hidden="true"></i><h3>Meeting-free Fridays</h3><p class="muted" style="margin:0">Fridays are for focused work and the weekly portal updates.</p></div>
<div class="card"><i class="bi bi-book" aria-hidden="true"></i><h3>Learning budget</h3><p class="muted" style="margin:0">$2,000 a year for courses, books and one conference.</p></div>
</div>
<p class="disc">There are no application forms on this site. A real studio would list an email address or link to its hiring tool.</p>
</div></div>
