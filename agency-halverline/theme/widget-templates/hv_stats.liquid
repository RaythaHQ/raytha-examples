<section class="sec"><div class="wrap"><div class="art" style="grid-template-columns:1fr 1.3fr;gap:56px;align-items:start"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2 style="margin:10px 0 16px">{{ widget.settings.headline }}</h2><div class="prose muted">{{ widget.settings.body }}</div></div><div class="stats" style="grid-template-columns:1fr 1fr;gap:34px 24px">{% for it in widget.settings.items %}<div><b>{{ it.value }}</b><span>{{ it.label }}</span></div>{% endfor %}</div></div></div></section>
