<section class="sec alt"><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2>{% if widget.settings.intro != blank %}<p>{{ widget.settings.intro }}</p>{% endif %}</div></div><div class="steps">{% for it in widget.settings.items %}<div class="card"><h3>{{ it.title }}</h3><p class="muted" style="margin:8px 0 0">{{ it.text }}</p></div>{% endfor %}</div></div></section>
