<section class="sec tight"><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2></div></div><div class="grid g3">{% for it in widget.settings.items %}<div class="card pad"><span style="width:48px;height:48px;border-radius:14px;background:var(--lilac);display:grid;place-items:center;font-size:1.3rem" aria-hidden="true"><i class="bi bi-{{ it.icon }}"></i></span><h3 style="margin:14px 0 6px">{{ it.name }}</h3><p style="margin:0 0 6px"><a href="mailto:{{ it.email }}">{{ it.email }}</a></p><p class="muted" style="margin:0;font-size:.94rem">{{ it.note }}</p></div>{% endfor %}</div></div></section>
