<section class="sec alt"><div class="wrap"><div class="shead"><div><span class="kicker">{{ widget.settings.kicker }}</span><h2>{{ widget.settings.headline }}</h2></div></div><div class="vals">{% for it in widget.settings.items %}<div class="card"><i class="bi bi-{{ it.icon }}" aria-hidden="true"></i><h3>{{ it.title }}</h3><p class="muted" style="margin:0">{{ it.text }}</p></div>{% endfor %}</div></div></section>
