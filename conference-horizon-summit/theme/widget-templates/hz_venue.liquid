<section class="section-tight">
  <div class="wrap venue-grid">
    <div class="venue-map glass reveal" aria-label="Stylised map of the venue area">
      <svg viewBox="0 0 600 480" xmlns="http://www.w3.org/2000/svg" role="img">
        <defs>
          <linearGradient id="river" x1="0" x2="1"><stop offset="0" stop-color="#22d3ee" stop-opacity=".6"/><stop offset="1" stop-color="#8b5cf6" stop-opacity=".6"/></linearGradient>
          <radialGradient id="glow"><stop offset="0" stop-color="#ec4899" stop-opacity=".9"/><stop offset="1" stop-color="#ec4899" stop-opacity="0"/></radialGradient>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="rgba(255,255,255,.06)"/></pattern>
        </defs>
        <rect width="600" height="480" fill="url(#grid)"/>
        <g stroke="rgba(255,255,255,.14)" stroke-width="10" fill="none" stroke-linecap="round">
          <path d="M-10 120 L610 160"/><path d="M120 -10 L180 490"/><path d="M420 -10 L380 490"/><path d="M-10 330 L610 300"/>
        </g>
        <g stroke="rgba(255,255,255,.07)" stroke-width="4" fill="none"><path d="M-10 230 L610 225"/><path d="M280 -10 L270 490"/><path d="M520 -10 L500 490"/><path d="M40 -10 L60 490"/></g>
        <path d="M-20 420 C 120 380, 200 460, 320 420 S 520 370, 620 400" stroke="url(#river)" stroke-width="26" fill="none" stroke-linecap="round"/>
        <text x="40" y="455" fill="rgba(255,255,255,.45)" font-family="monospace" font-size="12" letter-spacing="3">LADY BIRD LAKE</text>
        <text x="200" y="112" fill="rgba(255,255,255,.4)" font-family="monospace" font-size="11" letter-spacing="2" transform="rotate(3.7 200 112)">AIRPORT BLVD</text>
        <rect x="440" y="250" width="60" height="38" rx="6" fill="rgba(34,211,238,.18)" stroke="#22d3ee"/><text x="470" y="274" fill="#a5f3fc" font-family="monospace" font-size="10" text-anchor="middle">HOTEL</text>
        <rect x="200" y="250" width="60" height="38" rx="6" fill="rgba(163,230,53,.15)" stroke="#a3e635"/><text x="230" y="274" fill="#d9f99d" font-family="monospace" font-size="10" text-anchor="middle">HOTEL</text>
        <circle cx="330" cy="200" r="90" fill="url(#glow)"><animate attributeName="r" values="70;100;70" dur="4s" repeatCount="indefinite"/></circle>
        <circle cx="330" cy="200" r="14" fill="#fff"/><circle cx="330" cy="200" r="7" fill="#ec4899"/>
        <rect x="350" y="168" width="172" height="34" rx="17" fill="rgba(7,7,26,.85)" stroke="rgba(255,255,255,.2)"/>
        <text x="436" y="190" fill="#fff" font-family="sans-serif" font-weight="700" font-size="13" text-anchor="middle">Mueller Commons</text>
      </svg>
    </div>
    <div class="reveal">
      <span class="eyebrow">The venue</span>
      <h2 style="font-size:clamp(2rem,4vw,3.2rem);margin:.8rem 0 1rem">{{ widget.settings.name }}</h2>
      <p class="mono muted" style="white-space:pre-line">{{ widget.settings.address }}</p>
      <div class="prose">{{ widget.settings.body }}</div>
      <div class="venue-facts">
        {% for f in widget.settings.facts %}<div><span class="mono">{{ f.label }}</span><strong>{{ f.value }}</strong></div>{% endfor %}
      </div>
    </div>
  </div>
</section>
