<section class="section" id="program">
  <div class="wrap about-grid">
    <div class="reveal">
      {% if widget.settings.eyebrow %}<span class="eyebrow">{{ widget.settings.eyebrow }}</span>{% endif %}
      <h2 class="about-h">{{ widget.settings.headline }}</h2>
    </div>
    <div class="reveal" style="transition-delay:.1s">
      <p class="about-body">{{ widget.settings.body }}</p>
      <div class="stats">
        {% for s in widget.settings.stats %}
        <div class="stat"><b class="grad-text">{{ s.value }}</b><span>{{ s.label }}</span></div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
