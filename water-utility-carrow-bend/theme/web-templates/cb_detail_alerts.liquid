{%- assign x=Target.PublishedContent -%}<div class="phead"><div class="wrap"><ol class="crumbs"><li><a href="{{ PathBase }}/">Home</a></li><li><a href="{{ PathBase }}/alerts">Alerts</a></li></ol><span class="pill {{ x.status }}">{{ x.status }}</span><h1>{{ Target.PrimaryField }}</h1><p class="lede">{{ x.summary }}</p><p>{{ x.area }} · {{ x.alert_type }} · {{ x.timing_label }}</p></div></div><section class="sec"><div class="wrap grid2"><div class="prose">{{ x.body }}</div><aside class="card accent"><h3>What to do</h3><p>{{ x.what_to_do }}</p><p><a class="btn" href="{{ PathBase }}/report-a-problem">Report a problem</a></p></aside></div></section>
