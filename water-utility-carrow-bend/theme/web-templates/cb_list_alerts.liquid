<div class="phead"><div class="wrap"><p class="kick">Outages · boil notices · planned work</p><h1>Service alerts</h1><p class="lede">Active first in the story data, dated and area-specific. Resolved alerts stay published so residents can check what happened.</p></div></div><section class="sec"><div class="wrap">{% for i in Target.Items %}{%- assign x=i.PublishedContent -%}<a class="listrow" href="{{ PathBase }}/{{ i.RoutePath }}"><div><span class="pill {{ x.status }}">{{ x.status }}</span><br><small>{{ x.timing_label }}</small></div><div><b>{{ i.PrimaryField }}</b><br>{{ x.area }} · {{ x.alert_type }}<p>{{ x.summary }}</p></div><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""></div></a>{% endfor %}</div></section>
