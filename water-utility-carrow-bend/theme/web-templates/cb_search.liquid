{%- assign q=QueryParams.q | strip | remove: "'" | truncate: 60,"" -%}<div class="phead"><div class="wrap"><h1>Search Carrow Bend Water</h1><form action="{{ PathBase }}/search" role="search" style="display:flex;gap:10px;margin-top:16px;max-width:640px"><input name="q" value="{{ q }}" aria-label="Search"><button class="btn">Search</button></form></div></div><section class="sec"><div class="wrap">{% if q != "" %}{%- capture f -%}contains(title,'{{ q }}') or contains(summary,'{{ q }}'){%- endcapture -%}{%- assign r=get_content_items(ContentType="alerts",Filter=f,PageSize=12)-%}<h2>Alerts</h2><p>{{ r.TotalCount }} result(s)</p>{% for p in r.Items %}<p><a href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b></a> — {{ p.PublishedContent.summary }}</p>{% endfor %}{%- assign r2=get_content_items(ContentType="guides",Filter=f,PageSize=12)-%}<h2>Save-water guides</h2>{% for p in r2.Items %}<p><a href="{{ PathBase }}/{{ p.RoutePath }}"><b>{{ p.PrimaryField }}</b></a> — {{ p.PublishedContent.summary }}</p>{% endfor %}{% endif %}</div></section>
