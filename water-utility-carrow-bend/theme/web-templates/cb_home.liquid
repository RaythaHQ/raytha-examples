{%- assign alerts = get_content_items(ContentType="alerts", OrderBy="sort_order asc", PageSize=3) -%}
{%- assign quals = get_content_items(ContentType="quality", OrderBy="sort_order asc", PageSize=2) -%}
{%- assign meets = get_content_items(ContentType="meetings", OrderBy="meeting_date desc", PageSize=2) -%}
{%- assign guides = get_content_items(ContentType="guides", OrderBy="sort_order asc", PageSize=3) -%}
<section class="hero"><div class="wrap"><p class="kick" style="color:#8fd8ec">Carrow Bend Water &amp; Sewer District · Ossel River</p><h1>Check the water<br>before you call.</h1><p class="lede">Pay a bill, see if your street is under a notice, read this quarter's quality results, start service at a new address, or check what a thousand gallons actually costs — without creating an account first.</p><p><a class="btn amber" href="{{ PathBase }}/pay-bill">Pay a bill →</a> <a class="btn light" href="{{ PathBase }}/alerts">Service alerts</a></p>
<div class="status"><div class="stat"><b>Normal</b><span>System status today (story)</span></div><div class="stat"><b>1 active</b><span>Boil notice · 2 blocks</span></div><div class="stat"><b>7.1 pH</b><span>Latest quality snapshot</span></div><div class="stat"><b>$6.40</b><span>Per 1,000 gal, first tier</span></div></div></div></section>
<section class="sec" style="padding-top:22px"><div class="wrap"><div class="actions">
<a class="action" href="{{ PathBase }}/pay-bill"><b>💧 Pay a bill</b><p>Ways to pay, late fees, and help if a bill looks wrong. Demo only — nothing is charged.</p></a>
<a class="action" href="{{ PathBase }}/report-a-problem"><b>🚨 Report a problem</b><p>No water, low pressure, discolored water, or a leak in the street.</p></a>
<a class="action" href="{{ PathBase }}/start-stop-service"><b>🔑 Start / stop service</b><p>Moving in, moving out, or transferring a house in Carrow Bend.</p></a>
<a class="action" href="{{ PathBase }}/rates-and-fees"><b>📋 Rates &amp; fees</b><p>Every tier, tap fee and deposit — in a table, not a PDF you have to hunt for.</p></a>
</div></div></section>
<section class="sec white"><div class="wrap"><p class="kick">Service alerts</p><h2>What's happening on your street</h2><p class="lede">Alerts are dated, mapped to an area, and marked resolved when crews clear them — not buried in a social feed.</p>
{% for a in alerts.Items %}{%- assign x=a.PublishedContent -%}<a class="listrow" href="{{ PathBase }}/{{ a.RoutePath }}"><div><span class="pill {{ x.status }}">{{ x.status }}</span><br><small>{{ x.timing_label }}</small></div><div><b>{{ a.PrimaryField }}</b><br>{{ x.area }} · {{ x.alert_type }}<p>{{ x.summary }}</p></div><div><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""></div></a>{% endfor %}<p><a href="{{ PathBase }}/alerts">All alerts →</a></p></div></section>
<section class="sec"><div class="wrap grid2"><div><p class="kick">Water quality</p><h2>Results, in plain language</h2>{% for q in quals.Items %}{%- assign x=q.PublishedContent -%}<article class="card" style="margin-bottom:14px"><h3><a href="{{ PathBase }}/{{ q.RoutePath }}">{{ q.PrimaryField }}</a></h3><p>{{ x.period }} · {{ x.source }}</p><p>{{ x.summary }}</p><p><b>Key results:</b> {{ x.key_results }}</p></article>{% endfor %}</div><aside class="card accent"><h3>Next board meeting</h3>{% for m in meets.Items %}{%- assign x=m.PublishedContent -%}<p><b><a href="{{ PathBase }}/{{ m.RoutePath }}">{{ m.PrimaryField }}</a></b><br>{{ x.date_label }} · {{ x.location }}<br>{{ x.summary }}</p>{% endfor %}<p><a class="btn" href="{{ PathBase }}/board-meetings">Agendas &amp; minutes</a></p></aside></div></section>
<section class="sec white"><div class="wrap"><p class="kick">Save water</p><h2>Small leaks, real money</h2><div class="cards">{% for g in guides.Items %}{%- assign x=g.PublishedContent -%}<article class="card"><img src="{{ x.image.Value | attachment_redirect_url }}" alt=""><p class="pill">{{ x.topic }}</p><h3><a href="{{ PathBase }}/{{ g.RoutePath }}">{{ g.PrimaryField }}</a></h3><p>{{ x.summary }}</p><p><b>{{ x.savings_label }}</b> · {{ x.difficulty }}</p></article>{% endfor %}</div></div></section>
